# test/slt_proc/strings/776_patindex_quotename_ascii_26.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (26)

query ITTT
SELECT ASCII('Z'), CHAR(90), QUOTENAME('tbl_col_26'), REPLACE(CONCAT('L', SPACE(4), 'R'), ' ', '_');
----
90 Z [tbl_col_26] L____R

query II
SELECT PATINDEX('%TARGET_Z%', 'pre_26_TARGET_Z_post'), LEN(LTRIM(RTRIM('   tbl_col_26   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_776 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_776 @s = 'Zbc_XYZ26', @code = @out_c OUTPUT;
----
ZBC yz26 90
