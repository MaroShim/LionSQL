# test/slt_proc/strings/756_patindex_quotename_ascii_06.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (6)

query ITTT
SELECT ASCII('F'), CHAR(70), QUOTENAME('tbl_col_06'), REPLACE(CONCAT('L', SPACE(2), 'R'), ' ', '_');
----
70 F [tbl_col_06] L__R

query II
SELECT PATINDEX('%TARGET_F%', 'pre_06_TARGET_F_post'), LEN(LTRIM(RTRIM('   tbl_col_06   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_756 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_756 @s = 'Fbc_XYZ6', @code = @out_c OUTPUT;
----
FBC xyz6 70
