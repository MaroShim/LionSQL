# test/slt_proc/strings/053_stuff_replicate_agg_07.slt
# T-SQL STUFF, REPLICATE, CONCAT_WS, and STRING_AGG (7)

query TTT
SELECT STUFF('BATCH_JOB_RUN', 7, 3, 'TASK'), REPLICATE('+', 4), CONCAT_WS('.', 'v1', 'v2', 'v3');
----
BATCH_TASK_RUN ++++ v1.v2.v3

statement ok
CREATE TABLE sagg_53 (id INT PRIMARY KEY, label VARCHAR(30));

statement ok
INSERT INTO sagg_53 VALUES (1, 'v1'), (2, 'v2'), (3, 'v3');

query T
SELECT STRING_AGG(label, '.') FROM sagg_53;
----
v1.v2.v3

statement ok
DROP TABLE sagg_53;
