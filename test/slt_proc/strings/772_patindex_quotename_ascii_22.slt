# test/slt_proc/strings/772_patindex_quotename_ascii_22.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (22)

query ITTT
SELECT ASCII('V'), CHAR(86), QUOTENAME('tbl_col_22'), REPLACE(CONCAT('L', SPACE(6), 'R'), ' ', '_');
----
86 V [tbl_col_22] L______R

query II
SELECT PATINDEX('%TARGET_V%', 'pre_22_TARGET_V_post'), LEN(LTRIM(RTRIM('   tbl_col_22   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_772 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_772 @s = 'Vbc_XYZ22', @code = @out_c OUTPUT;
----
VBC yz22 86
