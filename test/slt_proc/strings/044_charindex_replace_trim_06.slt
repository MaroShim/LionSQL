# test/slt_proc/strings/044_charindex_replace_trim_06.slt
# T-SQL CHARINDEX, REPLACE, and TRIM family (6)

query I
SELECT CHARINDEX('btree', 'secondary_btree_index');
----
11

query I
SELECT CHARINDEX('nonexistent_token', 'secondary_btree_index');
----
0

query T
SELECT TRIM('secondary_covering_index');
----
secondary_covering_index

statement ok
CREATE PROCEDURE sp_replace_token_44 @src VARCHAR(100), @old VARCHAR(50), @new VARCHAR(50)
AS
BEGIN
    DECLARE @pos INT = CHARINDEX(@old, @src);
    SELECT @pos, TRIM(REPLACE(@src, @old, @new));
END;

query IT
EXEC sp_replace_token_44 'secondary_btree_index', 'btree', 'covering';
----
11 secondary_covering_index
