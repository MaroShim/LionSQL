# test/slt_proc/strings/770_patindex_quotename_ascii_20.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (20)

query ITTT
SELECT ASCII('T'), CHAR(84), QUOTENAME('tbl_col_20'), REPLACE(CONCAT('L', SPACE(4), 'R'), ' ', '_');
----
84 T [tbl_col_20] L____R

query II
SELECT PATINDEX('%TARGET_T%', 'pre_20_TARGET_T_post'), LEN(LTRIM(RTRIM('   tbl_col_20   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_770 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_770 @s = 'Tbc_XYZ20', @code = @out_c OUTPUT;
----
TBC yz20 84
