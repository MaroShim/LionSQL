# test/slt_proc/strings/754_patindex_quotename_ascii_04.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (4)

query ITTT
SELECT ASCII('D'), CHAR(68), QUOTENAME('tbl_col_04'), REPLACE(CONCAT('L', SPACE(6), 'R'), ' ', '_');
----
68 D [tbl_col_04] L______R

query II
SELECT PATINDEX('%TARGET_D%', 'pre_04_TARGET_D_post'), LEN(LTRIM(RTRIM('   tbl_col_04   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_754 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_754 @s = 'Dbc_XYZ4', @code = @out_c OUTPUT;
----
DBC xyz4 68
