HEAD_TOK102_TAIL 201KOT AB3AB3AB3AB3 TOK102

query II
SELECT CHARINDEX('TOK102', 'HEAD_TOK102_TAIL'), LEN('HEAD_TOK102_TAIL');
----
6 16

