# test/slt_proc/strings/049_stuff_replicate_agg_03.slt
# T-SQL STUFF, REPLICATE, CONCAT_WS, and STRING_AGG (3)

query TTT
SELECT STUFF('PRD-0000-END', 5, 4, '9876'), REPLICATE('A', 5), CONCAT_WS('-', 'Tier1', 'Tier2', 'Tier3');
----
PRD-9876-END AAAAA Tier1-Tier2-Tier3

statement ok
CREATE TABLE sagg_49 (id INT PRIMARY KEY, label VARCHAR(30));

statement ok
INSERT INTO sagg_49 VALUES (1, 'Tier1'), (2, 'Tier2'), (3, 'Tier3');

query T
SELECT STRING_AGG(label, '-') FROM sagg_49;
----
Tier1-Tier2-Tier3

statement ok
DROP TABLE sagg_49;
