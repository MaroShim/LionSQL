# test/slt_proc/strings/762_patindex_quotename_ascii_12.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (12)

query ITTT
SELECT ASCII('L'), CHAR(76), QUOTENAME('tbl_col_12'), REPLACE(CONCAT('L', SPACE(2), 'R'), ' ', '_');
----
76 L [tbl_col_12] L__R

query II
SELECT PATINDEX('%TARGET_L%', 'pre_12_TARGET_L_post'), LEN(LTRIM(RTRIM('   tbl_col_12   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_762 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_762 @s = 'Lbc_XYZ12', @code = @out_c OUTPUT;
----
LBC yz12 76
