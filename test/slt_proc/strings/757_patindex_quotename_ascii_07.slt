# test/slt_proc/strings/757_patindex_quotename_ascii_07.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (7)

query ITTT
SELECT ASCII('G'), CHAR(71), QUOTENAME('tbl_col_07'), REPLACE(CONCAT('L', SPACE(3), 'R'), ' ', '_');
----
71 G [tbl_col_07] L___R

query II
SELECT PATINDEX('%TARGET_G%', 'pre_07_TARGET_G_post'), LEN(LTRIM(RTRIM('   tbl_col_07   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_757 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_757 @s = 'Gbc_XYZ7', @code = @out_c OUTPUT;
----
GBC xyz7 71
