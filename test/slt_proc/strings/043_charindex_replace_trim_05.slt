# test/slt_proc/strings/043_charindex_replace_trim_05.slt
# T-SQL CHARINDEX, REPLACE, and TRIM family (5)

query I
SELECT CHARINDEX('isolation', 'snapshot_isolation_level');
----
10

query I
SELECT CHARINDEX('nonexistent_token', 'snapshot_isolation_level');
----
0

query T
SELECT TRIM('snapshot_mvcc_level');
----
snapshot_mvcc_level

statement ok
CREATE PROCEDURE sp_replace_token_43 @src VARCHAR(100), @old VARCHAR(50), @new VARCHAR(50)
AS
BEGIN
    DECLARE @pos INT = CHARINDEX(@old, @src);
    SELECT @pos, TRIM(REPLACE(@src, @old, @new));
END;

query IT
EXEC sp_replace_token_43 'snapshot_isolation_level', 'isolation', 'mvcc';
----
10 snapshot_mvcc_level
