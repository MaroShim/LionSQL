HEAD_TOK010_TAIL 010KOT AB1AB1AB1AB1 TOK010

query II
SELECT CHARINDEX('TOK010', 'HEAD_TOK010_TAIL'), LEN('HEAD_TOK010_TAIL');
----
6 16

