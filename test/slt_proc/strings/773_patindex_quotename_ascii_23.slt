# test/slt_proc/strings/773_patindex_quotename_ascii_23.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (23)

query ITTT
SELECT ASCII('W'), CHAR(87), QUOTENAME('tbl_col_23'), REPLACE(CONCAT('L', SPACE(7), 'R'), ' ', '_');
----
87 W [tbl_col_23] L_______R

query II
SELECT PATINDEX('%TARGET_W%', 'pre_23_TARGET_W_post'), LEN(LTRIM(RTRIM('   tbl_col_23   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_773 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_773 @s = 'Wbc_XYZ23', @code = @out_c OUTPUT;
----
WBC yz23 87
