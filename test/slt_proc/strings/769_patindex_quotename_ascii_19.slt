# test/slt_proc/strings/769_patindex_quotename_ascii_19.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (19)

query ITTT
SELECT ASCII('S'), CHAR(83), QUOTENAME('tbl_col_19'), REPLACE(CONCAT('L', SPACE(3), 'R'), ' ', '_');
----
83 S [tbl_col_19] L___R

query II
SELECT PATINDEX('%TARGET_S%', 'pre_19_TARGET_S_post'), LEN(LTRIM(RTRIM('   tbl_col_19   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_769 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_769 @s = 'Sbc_XYZ19', @code = @out_c OUTPUT;
----
SBC yz19 83
