# test/slt_proc/strings/751_patindex_quotename_ascii_01.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (1)

query ITTT
SELECT ASCII('A'), CHAR(65), QUOTENAME('tbl_col_01'), REPLACE(CONCAT('L', SPACE(3), 'R'), ' ', '_');
----
65 A [tbl_col_01] L___R

query II
SELECT PATINDEX('%TARGET_A%', 'pre_01_TARGET_A_post'), LEN(LTRIM(RTRIM('   tbl_col_01   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_751 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_751 @s = 'Abc_XYZ1', @code = @out_c OUTPUT;
----
ABC xyz1 65
