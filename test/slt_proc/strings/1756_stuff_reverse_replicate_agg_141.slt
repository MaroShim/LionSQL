# T-SQL STUFF, REVERSE, REPLICATE, CHARINDEX, SUBSTRING, STRING_AGG (141)

query TTTT
SELECT STUFF('HEAD_XXXX_TAIL', 6, 4, 'TOK141'), REVERSE('TOK141'), REPLICATE('AB6', 3), SUBSTRING('HEAD_TOK141_TAIL', 6, 6);
----
HEAD_TOK141_TAIL 141KOT AB6AB6AB6 TOK141

query II
SELECT CHARINDEX('TOK141', 'HEAD_TOK141_TAIL'), LEN('HEAD_TOK141_TAIL');
----
6 16

