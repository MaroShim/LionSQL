# T-SQL STUFF, REVERSE, REPLICATE, CHARINDEX, SUBSTRING, STRING_AGG (50)

query TTTT
SELECT STUFF('HEAD_XXXX_TAIL', 6, 4, 'TOK050'), REVERSE('TOK050'), REPLICATE('AB5', 4), SUBSTRING('HEAD_TOK050_TAIL', 6, 6);
----
HEAD_TOK050_TAIL 050KOT AB5AB5AB5AB5 TOK050

query II
SELECT CHARINDEX('TOK050', 'HEAD_TOK050_TAIL'), LEN('HEAD_TOK050_TAIL');
----
6 16

