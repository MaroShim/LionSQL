# test/slt_proc/strings/778_patindex_quotename_ascii_28.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (28)

query ITTT
SELECT ASCII('B'), CHAR(66), QUOTENAME('tbl_col_28'), REPLACE(CONCAT('L', SPACE(6), 'R'), ' ', '_');
----
66 B [tbl_col_28] L______R

query II
SELECT PATINDEX('%TARGET_B%', 'pre_28_TARGET_B_post'), LEN(LTRIM(RTRIM('   tbl_col_28   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_778 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_778 @s = 'Bbc_XYZ28', @code = @out_c OUTPUT;
----
BBC yz28 66
