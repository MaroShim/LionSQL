# test/slt_proc/strings/777_patindex_quotename_ascii_27.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (27)

query ITTT
SELECT ASCII('A'), CHAR(65), QUOTENAME('tbl_col_27'), REPLACE(CONCAT('L', SPACE(5), 'R'), ' ', '_');
----
65 A [tbl_col_27] L_____R

query II
SELECT PATINDEX('%TARGET_A%', 'pre_27_TARGET_A_post'), LEN(LTRIM(RTRIM('   tbl_col_27   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_777 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_777 @s = 'Abc_XYZ27', @code = @out_c OUTPUT;
----
ABC yz27 65
