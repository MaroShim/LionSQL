# test/slt_proc/strings/763_patindex_quotename_ascii_13.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (13)

query ITTT
SELECT ASCII('M'), CHAR(77), QUOTENAME('tbl_col_13'), REPLACE(CONCAT('L', SPACE(3), 'R'), ' ', '_');
----
77 M [tbl_col_13] L___R

query II
SELECT PATINDEX('%TARGET_M%', 'pre_13_TARGET_M_post'), LEN(LTRIM(RTRIM('   tbl_col_13   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_763 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_763 @s = 'Mbc_XYZ13', @code = @out_c OUTPUT;
----
MBC yz13 77
