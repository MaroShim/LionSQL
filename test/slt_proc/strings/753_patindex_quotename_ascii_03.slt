# test/slt_proc/strings/753_patindex_quotename_ascii_03.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (3)

query ITTT
SELECT ASCII('C'), CHAR(67), QUOTENAME('tbl_col_03'), REPLACE(CONCAT('L', SPACE(5), 'R'), ' ', '_');
----
67 C [tbl_col_03] L_____R

query II
SELECT PATINDEX('%TARGET_C%', 'pre_03_TARGET_C_post'), LEN(LTRIM(RTRIM('   tbl_col_03   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_753 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_753 @s = 'Cbc_XYZ3', @code = @out_c OUTPUT;
----
CBC xyz3 67
