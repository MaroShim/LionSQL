# T-SQL STUFF, REVERSE, REPLICATE, CHARINDEX, SUBSTRING, STRING_AGG (100)

query TTTT
SELECT STUFF('HEAD_XXXX_TAIL', 6, 4, 'TOK100'), REVERSE('TOK100'), REPLICATE('AB1', 2), SUBSTRING('HEAD_TOK100_TAIL', 6, 6);
----
HEAD_TOK100_TAIL 001KOT AB1AB1 TOK100

query II
SELECT CHARINDEX('TOK100', 'HEAD_TOK100_TAIL'), LEN('HEAD_TOK100_TAIL');
----
6 16

