# test/slt_proc/strings/761_patindex_quotename_ascii_11.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (11)

query ITTT
SELECT ASCII('K'), CHAR(75), QUOTENAME('tbl_col_11'), REPLACE(CONCAT('L', SPACE(7), 'R'), ' ', '_');
----
75 K [tbl_col_11] L_______R

query II
SELECT PATINDEX('%TARGET_K%', 'pre_11_TARGET_K_post'), LEN(LTRIM(RTRIM('   tbl_col_11   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_761 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_761 @s = 'Kbc_XYZ11', @code = @out_c OUTPUT;
----
KBC yz11 75
