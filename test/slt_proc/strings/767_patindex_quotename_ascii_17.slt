# test/slt_proc/strings/767_patindex_quotename_ascii_17.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (17)

query ITTT
SELECT ASCII('Q'), CHAR(81), QUOTENAME('tbl_col_17'), REPLACE(CONCAT('L', SPACE(7), 'R'), ' ', '_');
----
81 Q [tbl_col_17] L_______R

query II
SELECT PATINDEX('%TARGET_Q%', 'pre_17_TARGET_Q_post'), LEN(LTRIM(RTRIM('   tbl_col_17   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_767 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_767 @s = 'Qbc_XYZ17', @code = @out_c OUTPUT;
----
QBC yz17 81
