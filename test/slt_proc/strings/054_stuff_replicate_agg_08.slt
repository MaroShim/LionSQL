# test/slt_proc/strings/054_stuff_replicate_agg_08.slt
# T-SQL STUFF, REPLICATE, CONCAT_WS, and STRING_AGG (8)

query TTT
SELECT STUFF('INDEX_SCAN_OP', 7, 4, 'SEEK'), REPLICATE('=', 5), CONCAT_WS('+', 'CPU', 'RAM', 'DISK');
----
INDEX_SEEK_OP ===== CPU+RAM+DISK

statement ok
CREATE TABLE sagg_54 (id INT PRIMARY KEY, label VARCHAR(30));

statement ok
INSERT INTO sagg_54 VALUES (1, 'CPU'), (2, 'RAM'), (3, 'DISK');

query T
SELECT STRING_AGG(label, '+') FROM sagg_54;
----
CPU+RAM+DISK

statement ok
DROP TABLE sagg_54;
