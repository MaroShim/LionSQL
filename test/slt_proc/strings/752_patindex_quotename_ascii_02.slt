# test/slt_proc/strings/752_patindex_quotename_ascii_02.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (2)

query ITTT
SELECT ASCII('B'), CHAR(66), QUOTENAME('tbl_col_02'), REPLACE(CONCAT('L', SPACE(4), 'R'), ' ', '_');
----
66 B [tbl_col_02] L____R

query II
SELECT PATINDEX('%TARGET_B%', 'pre_02_TARGET_B_post'), LEN(LTRIM(RTRIM('   tbl_col_02   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_752 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_752 @s = 'Bbc_XYZ2', @code = @out_c OUTPUT;
----
BBC xyz2 66
