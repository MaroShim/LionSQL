# test/slt_proc/strings/1616_stuff_reverse_replicate_agg_001.slt
# T-SQL STUFF, REVERSE, REPLICATE, CHARINDEX, SUBSTRING, STRING_AGG (1)

query TTTT
SELECT STUFF('HEAD_XXXX_TAIL', 6, 4, 'TOK001'), REVERSE('TOK001'), REPLICATE('AB1', 3), SUBSTRING('HEAD_TOK001_TAIL', 6, 6);
----
HEAD_TOK001_TAIL 100KOT AB1AB1AB1 TOK001

query II
SELECT CHARINDEX('TOK001', 'HEAD_TOK001_TAIL'), LEN('HEAD_TOK001_TAIL');
----
6 16

statement ok
