# test/slt_proc/strings/758_patindex_quotename_ascii_08.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (8)

query ITTT
SELECT ASCII('H'), CHAR(72), QUOTENAME('tbl_col_08'), REPLACE(CONCAT('L', SPACE(4), 'R'), ' ', '_');
----
72 H [tbl_col_08] L____R

query II
SELECT PATINDEX('%TARGET_H%', 'pre_08_TARGET_H_post'), LEN(LTRIM(RTRIM('   tbl_col_08   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_758 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_758 @s = 'Hbc_XYZ8', @code = @out_c OUTPUT;
----
HBC xyz8 72
