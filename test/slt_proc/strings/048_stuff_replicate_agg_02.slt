# test/slt_proc/strings/048_stuff_replicate_agg_02.slt
# T-SQL STUFF, REPLICATE, CONCAT_WS, and STRING_AGG (2)

query TTT
SELECT STUFF('20260001', 5, 2, '11'), REPLICATE('0', 3), CONCAT_WS('|', 'Pending', 'Running', 'Done');
----
20261101 000 Pending|Running|Done

statement ok
CREATE TABLE sagg_48 (id INT PRIMARY KEY, label VARCHAR(30));

statement ok
INSERT INTO sagg_48 VALUES (1, 'Pending'), (2, 'Running'), (3, 'Done');

query T
SELECT STRING_AGG(label, '|') FROM sagg_48;
----
Pending|Running|Done

statement ok
DROP TABLE sagg_48;
