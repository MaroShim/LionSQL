# test/slt_proc/strings/765_patindex_quotename_ascii_15.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (15)

query ITTT
SELECT ASCII('O'), CHAR(79), QUOTENAME('tbl_col_15'), REPLACE(CONCAT('L', SPACE(5), 'R'), ' ', '_');
----
79 O [tbl_col_15] L_____R

query II
SELECT PATINDEX('%TARGET_O%', 'pre_15_TARGET_O_post'), LEN(LTRIM(RTRIM('   tbl_col_15   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_765 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_765 @s = 'Obc_XYZ15', @code = @out_c OUTPUT;
----
OBC yz15 79
