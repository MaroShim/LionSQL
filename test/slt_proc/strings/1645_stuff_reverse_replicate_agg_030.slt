----
HEAD_TOK030_TAIL 030KOT AB3AB3AB3AB3 TOK030

query II
SELECT CHARINDEX('TOK030', 'HEAD_TOK030_TAIL'), LEN('HEAD_TOK030_TAIL');
----
6 16

