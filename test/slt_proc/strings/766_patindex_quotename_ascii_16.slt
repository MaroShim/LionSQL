# test/slt_proc/strings/766_patindex_quotename_ascii_16.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (16)

query ITTT
SELECT ASCII('P'), CHAR(80), QUOTENAME('tbl_col_16'), REPLACE(CONCAT('L', SPACE(6), 'R'), ' ', '_');
----
80 P [tbl_col_16] L______R

query II
SELECT PATINDEX('%TARGET_P%', 'pre_16_TARGET_P_post'), LEN(LTRIM(RTRIM('   tbl_col_16   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_766 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_766 @s = 'Pbc_XYZ16', @code = @out_c OUTPUT;
----
PBC yz16 80
