# test/slt_proc/strings/047_stuff_replicate_agg_01.slt
# T-SQL STUFF, REPLICATE, CONCAT_WS, and STRING_AGG (1)

query TTT
SELECT STUFF('ABCDEFGH', 3, 2, '123'), REPLICATE('X', 4), CONCAT_WS(',', 'Seoul', 'Busan', 'Incheon');
----
AB123EFGH XXXX Seoul,Busan,Incheon

statement ok
CREATE TABLE sagg_47 (id INT PRIMARY KEY, label VARCHAR(30));

statement ok
INSERT INTO sagg_47 VALUES (1, 'Seoul'), (2, 'Busan'), (3, 'Incheon');

query T
SELECT STRING_AGG(label, ',') FROM sagg_47;
----
Seoul,Busan,Incheon

statement ok
DROP TABLE sagg_47;
