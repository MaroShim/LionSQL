# test/slt_proc/strings/038_slice_and_reverse_08.slt
# T-SQL LEFT/RIGHT/SUBSTRING/REVERSE/LEN on 'HighAvailability'

query TTTT
SELECT LEFT('HighAvailability', 4), RIGHT('HighAvailability', 12), SUBSTRING('HighAvailability', 5, 6), REVERSE('HighAvailability');
----
High Availability Availa ytilibaliavAhgiH

query TT
SELECT UPPER('High'), LOWER('Availability');
----
HIGH availability

query I
SELECT LEN('HighAvailability');
----
16

statement ok
CREATE PROCEDURE sp_str_slice_38 @in VARCHAR(50)
AS
BEGIN
    SELECT CONCAT(LEFT(@in, 4), '-', RIGHT(@in, 12), ':', CAST(LEN(@in) AS VARCHAR(10)));
END;

query T
EXEC sp_str_slice_38 'HighAvailability';
----
High-Availability:16
