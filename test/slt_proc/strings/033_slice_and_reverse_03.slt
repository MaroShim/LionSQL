# test/slt_proc/strings/033_slice_and_reverse_03.slt
# T-SQL LEFT/RIGHT/SUBSTRING/REVERSE/LEN on 'DatabaseEngine'

query TTTT
SELECT LEFT('DatabaseEngine', 8), RIGHT('DatabaseEngine', 6), SUBSTRING('DatabaseEngine', 9, 6), REVERSE('DatabaseEngine');
----
Database Engine Engine enignEesabataD

query TT
SELECT UPPER('Database'), LOWER('Engine');
----
DATABASE engine

query I
SELECT LEN('DatabaseEngine');
----
14

statement ok
CREATE PROCEDURE sp_str_slice_33 @in VARCHAR(50)
AS
BEGIN
    SELECT CONCAT(LEFT(@in, 8), '-', RIGHT(@in, 6), ':', CAST(LEN(@in) AS VARCHAR(10)));
END;

query T
EXEC sp_str_slice_33 'DatabaseEngine';
----
Database-Engine:14
