# test/slt_proc/strings/034_slice_and_reverse_04.slt
# T-SQL LEFT/RIGHT/SUBSTRING/REVERSE/LEN on 'StoredProcedure'

query TTTT
SELECT LEFT('StoredProcedure', 6), RIGHT('StoredProcedure', 9), SUBSTRING('StoredProcedure', 7, 4), REVERSE('StoredProcedure');
----
Stored Procedure Proc erudecorPderotS

query TT
SELECT UPPER('Stored'), LOWER('Procedure');
----
STORED procedure

query I
SELECT LEN('StoredProcedure');
----
15

statement ok
CREATE PROCEDURE sp_str_slice_34 @in VARCHAR(50)
AS
BEGIN
    SELECT CONCAT(LEFT(@in, 6), '-', RIGHT(@in, 9), ':', CAST(LEN(@in) AS VARCHAR(10)));
END;

query T
EXEC sp_str_slice_34 'StoredProcedure';
----
Stored-Procedure:15
