# test/slt_proc/strings/775_patindex_quotename_ascii_25.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (25)

query ITTT
SELECT ASCII('Y'), CHAR(89), QUOTENAME('tbl_col_25'), REPLACE(CONCAT('L', SPACE(3), 'R'), ' ', '_');
----
89 Y [tbl_col_25] L___R

query II
SELECT PATINDEX('%TARGET_Y%', 'pre_25_TARGET_Y_post'), LEN(LTRIM(RTRIM('   tbl_col_25   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_775 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_775 @s = 'Ybc_XYZ25', @code = @out_c OUTPUT;
----
YBC yz25 89
