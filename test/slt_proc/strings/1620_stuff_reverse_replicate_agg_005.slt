----
HEAD_TOK005_TAIL 500KOT AB5AB5AB5 TOK005

query II
SELECT CHARINDEX('TOK005', 'HEAD_TOK005_TAIL'), LEN('HEAD_TOK005_TAIL');
----
6 16

