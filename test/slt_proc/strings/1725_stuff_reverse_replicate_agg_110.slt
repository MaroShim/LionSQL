HEAD_TOK110_TAIL 011KOT AB2AB2AB2AB2 TOK110

query II
SELECT CHARINDEX('TOK110', 'HEAD_TOK110_TAIL'), LEN('HEAD_TOK110_TAIL');
----
6 16

