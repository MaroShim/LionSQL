# test/slt_proc/strings/040_charindex_replace_trim_02.slt
# T-SQL CHARINDEX, REPLACE, and TRIM family (2)

query I
SELECT CHARINDEX('server', 'microsoft_sql_server_tds');
----
15

query I
SELECT CHARINDEX('nonexistent_token', 'microsoft_sql_server_tds');
----
0

query T
SELECT TRIM('microsoft_sql_engine_tds');
----
microsoft_sql_engine_tds

statement ok
CREATE PROCEDURE sp_replace_token_40 @src VARCHAR(100), @old VARCHAR(50), @new VARCHAR(50)
AS
BEGIN
    DECLARE @pos INT = CHARINDEX(@old, @src);
    SELECT @pos, TRIM(REPLACE(@src, @old, @new));
END;

query IT
EXEC sp_replace_token_40 'microsoft_sql_server_tds', 'server', 'engine';
----
15 microsoft_sql_engine_tds
