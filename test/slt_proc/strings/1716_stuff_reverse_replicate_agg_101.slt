# test/slt_proc/strings/1716_stuff_reverse_replicate_agg_101.slt
# T-SQL STUFF, REVERSE, REPLICATE, CHARINDEX, SUBSTRING, STRING_AGG (101)

query TTTT
SELECT STUFF('HEAD_XXXX_TAIL', 6, 4, 'TOK101'), REVERSE('TOK101'), REPLICATE('AB2', 3), SUBSTRING('HEAD_TOK101_TAIL', 6, 6);
----
HEAD_TOK101_TAIL 101KOT AB2AB2AB2 TOK101

query II
SELECT CHARINDEX('TOK101', 'HEAD_TOK101_TAIL'), LEN('HEAD_TOK101_TAIL');
----
6 16

statement ok
