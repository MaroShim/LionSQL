# test/slt_proc/strings/1617_stuff_reverse_replicate_agg_002.slt
# T-SQL STUFF, REVERSE, REPLICATE, CHARINDEX, SUBSTRING, STRING_AGG (2)

query TTTT
SELECT STUFF('HEAD_XXXX_TAIL', 6, 4, 'TOK002'), REVERSE('TOK002'), REPLICATE('AB2', 4), SUBSTRING('HEAD_TOK002_TAIL', 6, 6);
----
HEAD_TOK002_TAIL 200KOT AB2AB2AB2AB2 TOK002

query II
SELECT CHARINDEX('TOK002', 'HEAD_TOK002_TAIL'), LEN('HEAD_TOK002_TAIL');
----
6 16

