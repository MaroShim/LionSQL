# test/slt_proc/strings/755_patindex_quotename_ascii_05.slt
# T-SQL PATINDEX, QUOTENAME, ASCII, CHAR, SPACE, LTRIM, RTRIM (5)

query ITTT
SELECT ASCII('E'), CHAR(69), QUOTENAME('tbl_col_05'), REPLACE(CONCAT('L', SPACE(7), 'R'), ' ', '_');
----
69 E [tbl_col_05] L_______R

query II
SELECT PATINDEX('%TARGET_E%', 'pre_05_TARGET_E_post'), LEN(LTRIM(RTRIM('   tbl_col_05   ')));
----
8 10

statement ok
CREATE PROCEDURE sp_str_adv_755 @s VARCHAR(100), @code INT OUTPUT
AS
BEGIN
    SET @code = ASCII(LEFT(@s, 1));
    SELECT UPPER(LEFT(@s, 3)), LOWER(RIGHT(@s, 4)), @code;
END;

query TTI
DECLARE @out_c INT;
EXEC sp_str_adv_755 @s = 'Ebc_XYZ5', @code = @out_c OUTPUT;
----
EBC xyz5 69
