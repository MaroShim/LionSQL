CREATE TABLE jdbc_json_t (id INT PRIMARY KEY, doc NVARCHAR(4000));

statement ok
INSERT INTO jdbc_json_t VALUES (1, N'{"key1":"value1","num":42,"arr":[10,20,30]}');

query TTTT
