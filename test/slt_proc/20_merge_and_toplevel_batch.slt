# test/slt_proc/20_merge_and_toplevel_batch.slt
# MERGE (WHEN MATCHED / NOT MATCHED) and top-level DECLARE/WHILE/IF batches

statement ok
CREATE TABLE merge_tgt (id INT PRIMARY KEY, qty INT);

statement ok
INSERT INTO merge_tgt VALUES (1, 10), (2, 20);

statement ok
CREATE TABLE merge_src (id INT PRIMARY KEY, qty INT);

statement ok
INSERT INTO merge_src VALUES (2, 5), (3, 7);

statement ok
MERGE merge_tgt AS t
USING merge_src AS s ON t.id = s.id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (id, qty) VALUES (s.id, s.qty);

query II
SELECT id, qty FROM merge_tgt ORDER BY id;
----
1 10
2 25
3 7

statement ok
DROP TABLE merge_tgt;

statement ok
DROP TABLE merge_src;

query I
DECLARE @i INT = 0;
DECLARE @s INT = 0;
WHILE @i < 5
BEGIN
    SET @i = @i + 1;
    SET @s = @s + @i;
END;
SELECT @s;
----
15

query T
DECLARE @n INT = 7;
DECLARE @r VARCHAR(10);
IF @n % 2 = 0
    SET @r = 'even';
ELSE
    SET @r = 'odd';
SELECT @r;
----
odd
