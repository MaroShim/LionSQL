# test/slt_proc/datetime/086_datetime_calc_06.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (6)

query IIIT
SELECT YEAR('2021-06-07'), MONTH('2021-06-07'), DAY('2021-06-07'), DATENAME(month, '2021-06-07');
----
2021 6 7 June

query TT
SELECT EOMONTH('2021-06-07'), CONVERT(VARCHAR(10), DATEADD(day, 24, '2026-01-01'), 120);
----
2021-06-30 2026-01-25

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-01-25'), ISDATE('2021-06-07'), ISDATE('bad-date-6');
----
24 1 0
