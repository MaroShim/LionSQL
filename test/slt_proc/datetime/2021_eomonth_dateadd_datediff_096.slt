# test/slt_proc/datetime/2021_eomonth_dateadd_datediff_096.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (96)

query TTI
SELECT CAST(EOMONTH('2024-12-17') AS VARCHAR(10)), CAST(DATEADD(day, 24, '2024-12-17') AS VARCHAR(10)), DATEDIFF(day, '2024-12-17', '2025-01-10');
----
2024-12-31 2025-01-10 24

query IIII
SELECT YEAR('2025-01-10'), MONTH('2025-01-10'), DAY('2025-01-10'), DAY(EOMONTH('2024-12-17'));
----
2025 1 10 31

statement ok
CREATE TABLE dt_log_2021 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2021 VALUES (1, '2024-12-17'), (2, '2025-01-10');

query II
SELECT id, DATEDIFF(day, '2024-12-17', ev_date) FROM dt_log_2021 ORDER BY id;
----
1 0
2 24

statement ok
DROP TABLE dt_log_2021;
