# test/slt_proc/datetime/2046_eomonth_dateadd_datediff_121.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (121)

query TTI
SELECT CAST(EOMONTH('2022-01-07') AS VARCHAR(10)), CAST(DATEADD(day, 24, '2022-01-07') AS VARCHAR(10)), DATEDIFF(day, '2022-01-07', '2022-01-31');
----
2022-01-31 2022-01-31 24

query IIII
SELECT YEAR('2022-01-31'), MONTH('2022-01-31'), DAY('2022-01-31'), DAY(EOMONTH('2022-01-07'));
----
2022 1 31 31

statement ok
CREATE TABLE dt_log_2046 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2046 VALUES (1, '2022-01-07'), (2, '2022-01-31');

query II
SELECT id, DATEDIFF(day, '2022-01-07', ev_date) FROM dt_log_2046 ORDER BY id;
----
1 0
2 24

statement ok
DROP TABLE dt_log_2046;
