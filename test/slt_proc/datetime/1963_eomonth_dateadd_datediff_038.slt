# test/slt_proc/datetime/1963_eomonth_dateadd_datediff_038.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (38)

query TTI
SELECT CAST(EOMONTH('2020-02-21') AS VARCHAR(10)), CAST(DATEADD(day, 16, '2020-02-21') AS VARCHAR(10)), DATEDIFF(day, '2020-02-21', '2020-03-08');
----
2020-02-29 2020-03-08 16

query IIII
SELECT YEAR('2020-03-08'), MONTH('2020-03-08'), DAY('2020-03-08'), DAY(EOMONTH('2020-02-21'));
----
2020 3 8 29

statement ok
CREATE TABLE dt_log_1963 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1963 VALUES (1, '2020-02-21'), (2, '2020-03-08');

query II
SELECT id, DATEDIFF(day, '2020-02-21', ev_date) FROM dt_log_1963 ORDER BY id;
----
1 0
2 16

statement ok
DROP TABLE dt_log_1963;
