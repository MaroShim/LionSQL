# test/slt_proc/datetime/2054_eomonth_dateadd_datediff_129.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (129)

query TTI
SELECT CAST(EOMONTH('2021-09-23') AS VARCHAR(10)), CAST(DATEADD(day, 7, '2021-09-23') AS VARCHAR(10)), DATEDIFF(day, '2021-09-23', '2021-09-30');
----
2021-09-30 2021-09-30 7

query IIII
SELECT YEAR('2021-09-30'), MONTH('2021-09-30'), DAY('2021-09-30'), DAY(EOMONTH('2021-09-23'));
----
2021 9 30 30

statement ok
CREATE TABLE dt_log_2054 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2054 VALUES (1, '2021-09-23'), (2, '2021-09-30');

query II
SELECT id, DATEDIFF(day, '2021-09-23', ev_date) FROM dt_log_2054 ORDER BY id;
----
1 0
2 7

statement ok
DROP TABLE dt_log_2054;
