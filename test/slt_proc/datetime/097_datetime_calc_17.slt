# test/slt_proc/datetime/097_datetime_calc_17.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (17)

query IIIT
SELECT YEAR('2026-05-18'), MONTH('2026-05-18'), DAY('2026-05-18'), DATENAME(month, '2026-05-18');
----
2026 5 18 May

query TT
SELECT EOMONTH('2026-05-18'), CONVERT(VARCHAR(10), DATEADD(day, 68, '2026-01-01'), 120);
----
2026-05-31 2026-03-10

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-10'), ISDATE('2026-05-18'), ISDATE('bad-date-17');
----
68 1 0
