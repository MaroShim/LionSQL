# test/slt_proc/datetime/811_datefromparts_datepart_01.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (1)

query TII
SELECT CAST(DATEFROMPARTS(2021, 1, 4) AS VARCHAR(10)), DATEPART(quarter, '2021-01-04'), DATEPART(dayofyear, '2021-01-04');
----
2021-01-04 1 4

query III
SELECT DATEDIFF(year, '2015-01-01', '2021-01-04'), DATEDIFF(month, '2021-01-01', '2021-01-04'), IIF('2021-01-04' >= '2020-01-01', 1, 0);
----
6 0 1

statement ok
CREATE PROCEDURE sp_dt_check_811 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_811 '2021-01-04', @q_out OUTPUT;
----
2021 1 4 1
