# test/slt_proc/datetime/818_datefromparts_datepart_08.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (8)

query TII
SELECT CAST(DATEFROMPARTS(2020, 8, 25) AS VARCHAR(10)), DATEPART(quarter, '2020-08-25'), DATEPART(dayofyear, '2020-08-25');
----
2020-08-25 3 238

query III
SELECT DATEDIFF(year, '2015-01-01', '2020-08-25'), DATEDIFF(month, '2020-01-01', '2020-08-25'), IIF('2020-08-25' >= '2020-01-01', 1, 0);
----
5 7 1

statement ok
CREATE PROCEDURE sp_dt_check_818 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_818 '2020-08-25', @q_out OUTPUT;
----
2020 8 25 3
