# test/slt_proc/datetime/2018_eomonth_dateadd_datediff_093.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (93)

query TTI
SELECT CAST(EOMONTH('2021-09-11') AS VARCHAR(10)), CAST(DATEADD(day, 21, '2021-09-11') AS VARCHAR(10)), DATEDIFF(day, '2021-09-11', '2021-10-02');
----
2021-09-30 2021-10-02 21

query IIII
SELECT YEAR('2021-10-02'), MONTH('2021-10-02'), DAY('2021-10-02'), DAY(EOMONTH('2021-09-11'));
----
2021 10 2 30

statement ok
CREATE TABLE dt_log_2018 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2018 VALUES (1, '2021-09-11'), (2, '2021-10-02');

query II
SELECT id, DATEDIFF(day, '2021-09-11', ev_date) FROM dt_log_2018 ORDER BY id;
----
1 0
2 21

statement ok
DROP TABLE dt_log_2018;
