# test/slt_proc/datetime/2043_eomonth_dateadd_datediff_118.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (118)

query TTI
SELECT CAST(EOMONTH('2019-10-21') AS VARCHAR(10)), CAST(DATEADD(day, 21, '2019-10-21') AS VARCHAR(10)), DATEDIFF(day, '2019-10-21', '2019-11-11');
----
2019-10-31 2019-11-11 21

query IIII
SELECT YEAR('2019-11-11'), MONTH('2019-11-11'), DAY('2019-11-11'), DAY(EOMONTH('2019-10-21'));
----
2019 11 11 31

statement ok
CREATE TABLE dt_log_2043 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2043 VALUES (1, '2019-10-21'), (2, '2019-11-11');

query II
SELECT id, DATEDIFF(day, '2019-10-21', ev_date) FROM dt_log_2043 ORDER BY id;
----
1 0
2 21

statement ok
DROP TABLE dt_log_2043;
