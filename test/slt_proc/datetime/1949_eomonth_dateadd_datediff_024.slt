# test/slt_proc/datetime/1949_eomonth_dateadd_datediff_024.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (24)

query TTI
SELECT CAST(EOMONTH('2024-12-13') AS VARCHAR(10)), CAST(DATEADD(day, 27, '2024-12-13') AS VARCHAR(10)), DATEDIFF(day, '2024-12-13', '2025-01-09');
----
2024-12-31 2025-01-09 27

query IIII
SELECT YEAR('2025-01-09'), MONTH('2025-01-09'), DAY('2025-01-09'), DAY(EOMONTH('2024-12-13'));
----
2025 1 9 31

statement ok
CREATE TABLE dt_log_1949 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1949 VALUES (1, '2024-12-13'), (2, '2025-01-09');

query II
SELECT id, DATEDIFF(day, '2024-12-13', ev_date) FROM dt_log_1949 ORDER BY id;
----
1 0
2 27

statement ok
DROP TABLE dt_log_1949;
