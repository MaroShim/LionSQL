# test/slt_proc/datetime/1992_eomonth_dateadd_datediff_067.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (67)

query TTI
SELECT CAST(EOMONTH('2022-07-19') AS VARCHAR(10)), CAST(DATEADD(day, 20, '2022-07-19') AS VARCHAR(10)), DATEDIFF(day, '2022-07-19', '2022-08-08');
----
2022-07-31 2022-08-08 20

query IIII
SELECT YEAR('2022-08-08'), MONTH('2022-08-08'), DAY('2022-08-08'), DAY(EOMONTH('2022-07-19'));
----
2022 8 8 31

statement ok
CREATE TABLE dt_log_1992 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1992 VALUES (1, '2022-07-19'), (2, '2022-08-08');

query II
SELECT id, DATEDIFF(day, '2022-07-19', ev_date) FROM dt_log_1992 ORDER BY id;
----
1 0
2 20

statement ok
DROP TABLE dt_log_1992;
