# test/slt_proc/datetime/813_datefromparts_datepart_03.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (3)

query TII
SELECT CAST(DATEFROMPARTS(2023, 3, 10) AS VARCHAR(10)), DATEPART(quarter, '2023-03-10'), DATEPART(dayofyear, '2023-03-10');
----
2023-03-10 1 69

query III
SELECT DATEDIFF(year, '2015-01-01', '2023-03-10'), DATEDIFF(month, '2023-01-01', '2023-03-10'), IIF('2023-03-10' >= '2020-01-01', 1, 0);
----
8 2 1

statement ok
CREATE PROCEDURE sp_dt_check_813 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_813 '2023-03-10', @q_out OUTPUT;
----
2023 3 10 1
