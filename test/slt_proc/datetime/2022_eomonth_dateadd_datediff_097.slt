# test/slt_proc/datetime/2022_eomonth_dateadd_datediff_097.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (97)

query TTI
SELECT CAST(EOMONTH('2025-01-19') AS VARCHAR(10)), CAST(DATEADD(day, 25, '2025-01-19') AS VARCHAR(10)), DATEDIFF(day, '2025-01-19', '2025-02-13');
----
2025-01-31 2025-02-13 25

query IIII
SELECT YEAR('2025-02-13'), MONTH('2025-02-13'), DAY('2025-02-13'), DAY(EOMONTH('2025-01-19'));
----
2025 2 13 31

statement ok
CREATE TABLE dt_log_2022 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2022 VALUES (1, '2025-01-19'), (2, '2025-02-13');

query II
SELECT id, DATEDIFF(day, '2025-01-19', ev_date) FROM dt_log_2022 ORDER BY id;
----
1 0
2 25

statement ok
DROP TABLE dt_log_2022;
