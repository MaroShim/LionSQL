# test/slt_proc/datetime/1993_eomonth_dateadd_datediff_068.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (68)

query TTI
SELECT CAST(EOMONTH('2023-08-21') AS VARCHAR(10)), CAST(DATEADD(day, 21, '2023-08-21') AS VARCHAR(10)), DATEDIFF(day, '2023-08-21', '2023-09-11');
----
2023-08-31 2023-09-11 21

query IIII
SELECT YEAR('2023-09-11'), MONTH('2023-09-11'), DAY('2023-09-11'), DAY(EOMONTH('2023-08-21'));
----
2023 9 11 31

statement ok
CREATE TABLE dt_log_1993 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1993 VALUES (1, '2023-08-21'), (2, '2023-09-11');

query II
SELECT id, DATEDIFF(day, '2023-08-21', ev_date) FROM dt_log_1993 ORDER BY id;
----
1 0
2 21

statement ok
DROP TABLE dt_log_1993;
