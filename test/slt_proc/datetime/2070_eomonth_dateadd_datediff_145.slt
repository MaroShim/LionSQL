# test/slt_proc/datetime/2070_eomonth_dateadd_datediff_145.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (145)

query TTI
SELECT CAST(EOMONTH('2019-01-15') AS VARCHAR(10)), CAST(DATEADD(day, 23, '2019-01-15') AS VARCHAR(10)), DATEDIFF(day, '2019-01-15', '2019-02-07');
----
2019-01-31 2019-02-07 23

query IIII
SELECT YEAR('2019-02-07'), MONTH('2019-02-07'), DAY('2019-02-07'), DAY(EOMONTH('2019-01-15'));
----
2019 2 7 31

statement ok
CREATE TABLE dt_log_2070 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2070 VALUES (1, '2019-01-15'), (2, '2019-02-07');

query II
SELECT id, DATEDIFF(day, '2019-01-15', ev_date) FROM dt_log_2070 ORDER BY id;
----
1 0
2 23

statement ok
DROP TABLE dt_log_2070;
