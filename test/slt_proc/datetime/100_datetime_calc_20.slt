# test/slt_proc/datetime/100_datetime_calc_20.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (20)

query IIIT
SELECT YEAR('2023-08-01'), MONTH('2023-08-01'), DAY('2023-08-01'), DATENAME(month, '2023-08-01');
----
2023 8 1 August

query TT
SELECT EOMONTH('2023-08-01'), CONVERT(VARCHAR(10), DATEADD(day, 80, '2026-01-01'), 120);
----
2023-08-31 2026-03-22

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-22'), ISDATE('2023-08-01'), ISDATE('bad-date-20');
----
80 1 0
