# test/slt_proc/datetime/2040_eomonth_dateadd_datediff_115.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (115)

query TTI
SELECT CAST(EOMONTH('2025-07-15') AS VARCHAR(10)), CAST(DATEADD(day, 18, '2025-07-15') AS VARCHAR(10)), DATEDIFF(day, '2025-07-15', '2025-08-02');
----
2025-07-31 2025-08-02 18

query IIII
SELECT YEAR('2025-08-02'), MONTH('2025-08-02'), DAY('2025-08-02'), DAY(EOMONTH('2025-07-15'));
----
2025 8 2 31

statement ok
CREATE TABLE dt_log_2040 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2040 VALUES (1, '2025-07-15'), (2, '2025-08-02');

query II
SELECT id, DATEDIFF(day, '2025-07-15', ev_date) FROM dt_log_2040 ORDER BY id;
----
1 0
2 18

statement ok
DROP TABLE dt_log_2040;
