# test/slt_proc/datetime/2075_eomonth_dateadd_datediff_150.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (150)

query TTI
SELECT CAST(EOMONTH('2024-06-05') AS VARCHAR(10)), CAST(DATEADD(day, 3, '2024-06-05') AS VARCHAR(10)), DATEDIFF(day, '2024-06-05', '2024-06-08');
----
2024-06-30 2024-06-08 3

query IIII
SELECT YEAR('2024-06-08'), MONTH('2024-06-08'), DAY('2024-06-08'), DAY(EOMONTH('2024-06-05'));
----
2024 6 8 30

statement ok
CREATE TABLE dt_log_2075 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2075 VALUES (1, '2024-06-05'), (2, '2024-06-08');

query II
SELECT id, DATEDIFF(day, '2024-06-05', ev_date) FROM dt_log_2075 ORDER BY id;
----
1 0
2 3

statement ok
DROP TABLE dt_log_2075;
