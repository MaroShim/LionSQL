# test/slt_proc/datetime/2059_eomonth_dateadd_datediff_134.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (134)

query TTI
SELECT CAST(EOMONTH('2026-02-13') AS VARCHAR(10)), CAST(DATEADD(day, 12, '2026-02-13') AS VARCHAR(10)), DATEDIFF(day, '2026-02-13', '2026-02-25');
----
2026-02-28 2026-02-25 12

query IIII
SELECT YEAR('2026-02-25'), MONTH('2026-02-25'), DAY('2026-02-25'), DAY(EOMONTH('2026-02-13'));
----
2026 2 25 28

statement ok
CREATE TABLE dt_log_2059 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2059 VALUES (1, '2026-02-13'), (2, '2026-02-25');

query II
SELECT id, DATEDIFF(day, '2026-02-13', ev_date) FROM dt_log_2059 ORDER BY id;
----
1 0
2 12

statement ok
DROP TABLE dt_log_2059;
