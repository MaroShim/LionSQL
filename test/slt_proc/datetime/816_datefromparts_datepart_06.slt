# test/slt_proc/datetime/816_datefromparts_datepart_06.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (6)

query TII
SELECT CAST(DATEFROMPARTS(2026, 6, 19) AS VARCHAR(10)), DATEPART(quarter, '2026-06-19'), DATEPART(dayofyear, '2026-06-19');
----
2026-06-19 2 170

query III
SELECT DATEDIFF(year, '2015-01-01', '2026-06-19'), DATEDIFF(month, '2026-01-01', '2026-06-19'), IIF('2026-06-19' >= '2020-01-01', 1, 0);
----
11 5 1

statement ok
CREATE PROCEDURE sp_dt_check_816 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_816 '2026-06-19', @q_out OUTPUT;
----
2026 6 19 2
