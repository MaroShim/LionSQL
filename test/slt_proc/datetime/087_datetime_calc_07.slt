# test/slt_proc/datetime/087_datetime_calc_07.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (7)

query IIIT
SELECT YEAR('2022-07-08'), MONTH('2022-07-08'), DAY('2022-07-08'), DATENAME(month, '2022-07-08');
----
2022 7 8 July

query TT
SELECT EOMONTH('2022-07-08'), CONVERT(VARCHAR(10), DATEADD(day, 28, '2026-01-01'), 120);
----
2022-07-31 2026-01-29

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-01-29'), ISDATE('2022-07-08'), ISDATE('bad-date-7');
----
28 1 0
