# test/slt_proc/datetime/2066_eomonth_dateadd_datediff_141.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (141)

query TTI
SELECT CAST(EOMONTH('2024-09-07') AS VARCHAR(10)), CAST(DATEADD(day, 19, '2024-09-07') AS VARCHAR(10)), DATEDIFF(day, '2024-09-07', '2024-09-26');
----
2024-09-30 2024-09-26 19

query IIII
SELECT YEAR('2024-09-26'), MONTH('2024-09-26'), DAY('2024-09-26'), DAY(EOMONTH('2024-09-07'));
----
2024 9 26 30

statement ok
CREATE TABLE dt_log_2066 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2066 VALUES (1, '2024-09-07'), (2, '2024-09-26');

query II
SELECT id, DATEDIFF(day, '2024-09-07', ev_date) FROM dt_log_2066 ORDER BY id;
----
1 0
2 19

statement ok
DROP TABLE dt_log_2066;
