# test/slt_proc/datetime/812_datefromparts_datepart_02.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (2)

query TII
SELECT CAST(DATEFROMPARTS(2022, 2, 7) AS VARCHAR(10)), DATEPART(quarter, '2022-02-07'), DATEPART(dayofyear, '2022-02-07');
----
2022-02-07 1 38

query III
SELECT DATEDIFF(year, '2015-01-01', '2022-02-07'), DATEDIFF(month, '2022-01-01', '2022-02-07'), IIF('2022-02-07' >= '2020-01-01', 1, 0);
----
7 1 1

statement ok
CREATE PROCEDURE sp_dt_check_812 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_812 '2022-02-07', @q_out OUTPUT;
----
2022 2 7 1
