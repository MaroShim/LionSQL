# test/slt_proc/datetime/085_datetime_calc_05.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (5)

query IIIT
SELECT YEAR('2026-05-06'), MONTH('2026-05-06'), DAY('2026-05-06'), DATENAME(month, '2026-05-06');
----
2026 5 6 May

query TT
SELECT EOMONTH('2026-05-06'), CONVERT(VARCHAR(10), DATEADD(day, 20, '2026-01-01'), 120);
----
2026-05-31 2026-01-21

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-01-21'), ISDATE('2026-05-06'), ISDATE('bad-date-5');
----
20 1 0
