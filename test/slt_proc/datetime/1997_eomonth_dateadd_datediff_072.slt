# test/slt_proc/datetime/1997_eomonth_dateadd_datediff_072.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (72)

query TTI
SELECT CAST(EOMONTH('2018-12-09') AS VARCHAR(10)), CAST(DATEADD(day, 25, '2018-12-09') AS VARCHAR(10)), DATEDIFF(day, '2018-12-09', '2019-01-03');
----
2018-12-31 2019-01-03 25

query IIII
SELECT YEAR('2019-01-03'), MONTH('2019-01-03'), DAY('2019-01-03'), DAY(EOMONTH('2018-12-09'));
----
2019 1 3 31

statement ok
CREATE TABLE dt_log_1997 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1997 VALUES (1, '2018-12-09'), (2, '2019-01-03');

query II
SELECT id, DATEDIFF(day, '2018-12-09', ev_date) FROM dt_log_1997 ORDER BY id;
----
1 0
2 25

statement ok
DROP TABLE dt_log_1997;
