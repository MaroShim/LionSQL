# test/slt_proc/datetime/2009_eomonth_dateadd_datediff_084.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (84)

query TTI
SELECT CAST(EOMONTH('2021-12-13') AS VARCHAR(10)), CAST(DATEADD(day, 12, '2021-12-13') AS VARCHAR(10)), DATEDIFF(day, '2021-12-13', '2021-12-25');
----
2021-12-31 2021-12-25 12

query IIII
SELECT YEAR('2021-12-25'), MONTH('2021-12-25'), DAY('2021-12-25'), DAY(EOMONTH('2021-12-13'));
----
2021 12 25 31

statement ok
CREATE TABLE dt_log_2009 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2009 VALUES (1, '2021-12-13'), (2, '2021-12-25');

query II
SELECT id, DATEDIFF(day, '2021-12-13', ev_date) FROM dt_log_2009 ORDER BY id;
----
1 0
2 12

statement ok
DROP TABLE dt_log_2009;
