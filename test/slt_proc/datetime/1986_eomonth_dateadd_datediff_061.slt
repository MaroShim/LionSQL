# test/slt_proc/datetime/1986_eomonth_dateadd_datediff_061.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (61)

query TTI
SELECT CAST(EOMONTH('2025-01-07') AS VARCHAR(10)), CAST(DATEADD(day, 14, '2025-01-07') AS VARCHAR(10)), DATEDIFF(day, '2025-01-07', '2025-01-21');
----
2025-01-31 2025-01-21 14

query IIII
SELECT YEAR('2025-01-21'), MONTH('2025-01-21'), DAY('2025-01-21'), DAY(EOMONTH('2025-01-07'));
----
2025 1 21 31

statement ok
CREATE TABLE dt_log_1986 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1986 VALUES (1, '2025-01-07'), (2, '2025-01-21');

query II
SELECT id, DATEDIFF(day, '2025-01-07', ev_date) FROM dt_log_1986 ORDER BY id;
----
1 0
2 14

statement ok
DROP TABLE dt_log_1986;
