# test/slt_proc/datetime/081_datetime_calc_01.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (1)

query IIIT
SELECT YEAR('2022-01-02'), MONTH('2022-01-02'), DAY('2022-01-02'), DATENAME(month, '2022-01-02');
----
2022 1 2 January

query TT
SELECT EOMONTH('2022-01-02'), CONVERT(VARCHAR(10), DATEADD(day, 4, '2026-01-01'), 120);
----
2022-01-31 2026-01-05

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-01-05'), ISDATE('2022-01-02'), ISDATE('bad-date-1');
----
4 1 0
