# test/slt_proc/datetime/2002_eomonth_dateadd_datediff_077.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (77)

query TTI
SELECT CAST(EOMONTH('2023-05-19') AS VARCHAR(10)), CAST(DATEADD(day, 5, '2023-05-19') AS VARCHAR(10)), DATEDIFF(day, '2023-05-19', '2023-05-24');
----
2023-05-31 2023-05-24 5

query IIII
SELECT YEAR('2023-05-24'), MONTH('2023-05-24'), DAY('2023-05-24'), DAY(EOMONTH('2023-05-19'));
----
2023 5 24 31

statement ok
CREATE TABLE dt_log_2002 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2002 VALUES (1, '2023-05-19'), (2, '2023-05-24');

query II
SELECT id, DATEDIFF(day, '2023-05-19', ev_date) FROM dt_log_2002 ORDER BY id;
----
1 0
2 5

statement ok
DROP TABLE dt_log_2002;
