# test/slt_proc/datetime/096_datetime_calc_16.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (16)

query IIIT
SELECT YEAR('2025-04-17'), MONTH('2025-04-17'), DAY('2025-04-17'), DATENAME(month, '2025-04-17');
----
2025 4 17 April

query TT
SELECT EOMONTH('2025-04-17'), CONVERT(VARCHAR(10), DATEADD(day, 64, '2026-01-01'), 120);
----
2025-04-30 2026-03-06

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-06'), ISDATE('2025-04-17'), ISDATE('bad-date-16');
----
64 1 0
