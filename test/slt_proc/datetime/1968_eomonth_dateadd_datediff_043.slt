# test/slt_proc/datetime/1968_eomonth_dateadd_datediff_043.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (43)

query TTI
SELECT CAST(EOMONTH('2025-07-11') AS VARCHAR(10)), CAST(DATEADD(day, 21, '2025-07-11') AS VARCHAR(10)), DATEDIFF(day, '2025-07-11', '2025-08-01');
----
2025-07-31 2025-08-01 21

query IIII
SELECT YEAR('2025-08-01'), MONTH('2025-08-01'), DAY('2025-08-01'), DAY(EOMONTH('2025-07-11'));
----
2025 8 1 31

statement ok
CREATE TABLE dt_log_1968 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1968 VALUES (1, '2025-07-11'), (2, '2025-08-01');

query II
SELECT id, DATEDIFF(day, '2025-07-11', ev_date) FROM dt_log_1968 ORDER BY id;
----
1 0
2 21

statement ok
DROP TABLE dt_log_1968;
