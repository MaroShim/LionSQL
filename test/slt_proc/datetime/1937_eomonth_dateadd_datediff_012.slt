# test/slt_proc/datetime/1937_eomonth_dateadd_datediff_012.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (12)

query TTI
SELECT CAST(EOMONTH('2021-12-09') AS VARCHAR(10)), CAST(DATEADD(day, 15, '2021-12-09') AS VARCHAR(10)), DATEDIFF(day, '2021-12-09', '2021-12-24');
----
2021-12-31 2021-12-24 15

query IIII
SELECT YEAR('2021-12-24'), MONTH('2021-12-24'), DAY('2021-12-24'), DAY(EOMONTH('2021-12-09'));
----
2021 12 24 31

statement ok
CREATE TABLE dt_log_1937 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1937 VALUES (1, '2021-12-09'), (2, '2021-12-24');

query II
SELECT id, DATEDIFF(day, '2021-12-09', ev_date) FROM dt_log_1937 ORDER BY id;
----
1 0
2 15

statement ok
DROP TABLE dt_log_1937;
