# test/slt_proc/datetime/1942_eomonth_dateadd_datediff_017.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (17)

query TTI
SELECT CAST(EOMONTH('2026-05-19') AS VARCHAR(10)), CAST(DATEADD(day, 20, '2026-05-19') AS VARCHAR(10)), DATEDIFF(day, '2026-05-19', '2026-06-08');
----
2026-05-31 2026-06-08 20

query IIII
SELECT YEAR('2026-06-08'), MONTH('2026-06-08'), DAY('2026-06-08'), DAY(EOMONTH('2026-05-19'));
----
2026 6 8 31

statement ok
CREATE TABLE dt_log_1942 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1942 VALUES (1, '2026-05-19'), (2, '2026-06-08');

query II
SELECT id, DATEDIFF(day, '2026-05-19', ev_date) FROM dt_log_1942 ORDER BY id;
----
1 0
2 20

statement ok
DROP TABLE dt_log_1942;
