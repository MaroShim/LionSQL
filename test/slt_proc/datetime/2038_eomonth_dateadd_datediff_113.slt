# test/slt_proc/datetime/2038_eomonth_dateadd_datediff_113.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (113)

query TTI
SELECT CAST(EOMONTH('2023-05-11') AS VARCHAR(10)), CAST(DATEADD(day, 16, '2023-05-11') AS VARCHAR(10)), DATEDIFF(day, '2023-05-11', '2023-05-27');
----
2023-05-31 2023-05-27 16

query IIII
SELECT YEAR('2023-05-27'), MONTH('2023-05-27'), DAY('2023-05-27'), DAY(EOMONTH('2023-05-11'));
----
2023 5 27 31

statement ok
CREATE TABLE dt_log_2038 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2038 VALUES (1, '2023-05-11'), (2, '2023-05-27');

query II
SELECT id, DATEDIFF(day, '2023-05-11', ev_date) FROM dt_log_2038 ORDER BY id;
----
1 0
2 16

statement ok
DROP TABLE dt_log_2038;
