# test/slt_proc/datetime/1938_eomonth_dateadd_datediff_013.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (13)

query TTI
SELECT CAST(EOMONTH('2022-01-11') AS VARCHAR(10)), CAST(DATEADD(day, 16, '2022-01-11') AS VARCHAR(10)), DATEDIFF(day, '2022-01-11', '2022-01-27');
----
2022-01-31 2022-01-27 16

query IIII
SELECT YEAR('2022-01-27'), MONTH('2022-01-27'), DAY('2022-01-27'), DAY(EOMONTH('2022-01-11'));
----
2022 1 27 31

statement ok
CREATE TABLE dt_log_1938 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1938 VALUES (1, '2022-01-11'), (2, '2022-01-27');

query II
SELECT id, DATEDIFF(day, '2022-01-11', ev_date) FROM dt_log_1938 ORDER BY id;
----
1 0
2 16

statement ok
DROP TABLE dt_log_1938;
