# test/slt_proc/datetime/1939_eomonth_dateadd_datediff_014.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (14)

query TTI
SELECT CAST(EOMONTH('2023-02-13') AS VARCHAR(10)), CAST(DATEADD(day, 17, '2023-02-13') AS VARCHAR(10)), DATEDIFF(day, '2023-02-13', '2023-03-02');
----
2023-02-28 2023-03-02 17

query IIII
SELECT YEAR('2023-03-02'), MONTH('2023-03-02'), DAY('2023-03-02'), DAY(EOMONTH('2023-02-13'));
----
2023 3 2 28

statement ok
CREATE TABLE dt_log_1939 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1939 VALUES (1, '2023-02-13'), (2, '2023-03-02');

query II
SELECT id, DATEDIFF(day, '2023-02-13', ev_date) FROM dt_log_1939 ORDER BY id;
----
1 0
2 17

statement ok
DROP TABLE dt_log_1939;
