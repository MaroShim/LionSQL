# test/slt_proc/datetime/2032_eomonth_dateadd_datediff_107.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (107)

query TTI
SELECT CAST(EOMONTH('2026-11-19') AS VARCHAR(10)), CAST(DATEADD(day, 10, '2026-11-19') AS VARCHAR(10)), DATEDIFF(day, '2026-11-19', '2026-11-29');
----
2026-11-30 2026-11-29 10

query IIII
SELECT YEAR('2026-11-29'), MONTH('2026-11-29'), DAY('2026-11-29'), DAY(EOMONTH('2026-11-19'));
----
2026 11 29 30

statement ok
CREATE TABLE dt_log_2032 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2032 VALUES (1, '2026-11-19'), (2, '2026-11-29');

query II
SELECT id, DATEDIFF(day, '2026-11-19', ev_date) FROM dt_log_2032 ORDER BY id;
----
1 0
2 10

statement ok
DROP TABLE dt_log_2032;
