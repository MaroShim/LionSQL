# test/slt_proc/datetime/2047_eomonth_dateadd_datediff_122.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (122)

query TTI
SELECT CAST(EOMONTH('2023-02-09') AS VARCHAR(10)), CAST(DATEADD(day, 25, '2023-02-09') AS VARCHAR(10)), DATEDIFF(day, '2023-02-09', '2023-03-06');
----
2023-02-28 2023-03-06 25

query IIII
SELECT YEAR('2023-03-06'), MONTH('2023-03-06'), DAY('2023-03-06'), DAY(EOMONTH('2023-02-09'));
----
2023 3 6 28

statement ok
CREATE TABLE dt_log_2047 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2047 VALUES (1, '2023-02-09'), (2, '2023-03-06');

query II
SELECT id, DATEDIFF(day, '2023-02-09', ev_date) FROM dt_log_2047 ORDER BY id;
----
1 0
2 25

statement ok
DROP TABLE dt_log_2047;
