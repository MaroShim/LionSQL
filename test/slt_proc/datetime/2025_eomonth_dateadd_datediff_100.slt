# test/slt_proc/datetime/2025_eomonth_dateadd_datediff_100.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (100)

query TTI
SELECT CAST(EOMONTH('2019-04-05') AS VARCHAR(10)), CAST(DATEADD(day, 3, '2019-04-05') AS VARCHAR(10)), DATEDIFF(day, '2019-04-05', '2019-04-08');
----
2019-04-30 2019-04-08 3

query IIII
SELECT YEAR('2019-04-08'), MONTH('2019-04-08'), DAY('2019-04-08'), DAY(EOMONTH('2019-04-05'));
----
2019 4 8 30

statement ok
CREATE TABLE dt_log_2025 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2025 VALUES (1, '2019-04-05'), (2, '2019-04-08');

query II
SELECT id, DATEDIFF(day, '2019-04-05', ev_date) FROM dt_log_2025 ORDER BY id;
----
1 0
2 3

statement ok
DROP TABLE dt_log_2025;
