# test/slt_proc/datetime/2023_eomonth_dateadd_datediff_098.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (98)

query TTI
SELECT CAST(EOMONTH('2026-02-21') AS VARCHAR(10)), CAST(DATEADD(day, 26, '2026-02-21') AS VARCHAR(10)), DATEDIFF(day, '2026-02-21', '2026-03-19');
----
2026-02-28 2026-03-19 26

query IIII
SELECT YEAR('2026-03-19'), MONTH('2026-03-19'), DAY('2026-03-19'), DAY(EOMONTH('2026-02-21'));
----
2026 3 19 28

statement ok
CREATE TABLE dt_log_2023 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2023 VALUES (1, '2026-02-21'), (2, '2026-03-19');

query II
SELECT id, DATEDIFF(day, '2026-02-21', ev_date) FROM dt_log_2023 ORDER BY id;
----
1 0
2 26

statement ok
DROP TABLE dt_log_2023;
