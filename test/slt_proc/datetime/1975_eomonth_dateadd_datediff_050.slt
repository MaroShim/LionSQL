# test/slt_proc/datetime/1975_eomonth_dateadd_datediff_050.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (50)

query TTI
SELECT CAST(EOMONTH('2023-02-05') AS VARCHAR(10)), CAST(DATEADD(day, 3, '2023-02-05') AS VARCHAR(10)), DATEDIFF(day, '2023-02-05', '2023-02-08');
----
2023-02-28 2023-02-08 3

query IIII
SELECT YEAR('2023-02-08'), MONTH('2023-02-08'), DAY('2023-02-08'), DAY(EOMONTH('2023-02-05'));
----
2023 2 8 28

statement ok
CREATE TABLE dt_log_1975 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1975 VALUES (1, '2023-02-05'), (2, '2023-02-08');

query II
SELECT id, DATEDIFF(day, '2023-02-05', ev_date) FROM dt_log_1975 ORDER BY id;
----
1 0
2 3

statement ok
DROP TABLE dt_log_1975;
