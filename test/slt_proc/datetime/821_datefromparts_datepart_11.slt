# test/slt_proc/datetime/821_datefromparts_datepart_11.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (11)

query TII
SELECT CAST(DATEFROMPARTS(2023, 11, 9) AS VARCHAR(10)), DATEPART(quarter, '2023-11-09'), DATEPART(dayofyear, '2023-11-09');
----
2023-11-09 4 313

query III
SELECT DATEDIFF(year, '2015-01-01', '2023-11-09'), DATEDIFF(month, '2023-01-01', '2023-11-09'), IIF('2023-11-09' >= '2020-01-01', 1, 0);
----
8 10 1

statement ok
CREATE PROCEDURE sp_dt_check_821 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_821 '2023-11-09', @q_out OUTPUT;
----
2023 11 9 4
