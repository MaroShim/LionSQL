# test/slt_proc/datetime/1943_eomonth_dateadd_datediff_018.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (18)

query TTI
SELECT CAST(EOMONTH('2018-06-21') AS VARCHAR(10)), CAST(DATEADD(day, 21, '2018-06-21') AS VARCHAR(10)), DATEDIFF(day, '2018-06-21', '2018-07-12');
----
2018-06-30 2018-07-12 21

query IIII
SELECT YEAR('2018-07-12'), MONTH('2018-07-12'), DAY('2018-07-12'), DAY(EOMONTH('2018-06-21'));
----
2018 7 12 30

statement ok
CREATE TABLE dt_log_1943 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1943 VALUES (1, '2018-06-21'), (2, '2018-07-12');

query II
SELECT id, DATEDIFF(day, '2018-06-21', ev_date) FROM dt_log_1943 ORDER BY id;
----
1 0
2 21

statement ok
DROP TABLE dt_log_1943;
