# test/slt_proc/datetime/1952_eomonth_dateadd_datediff_027.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (27)

query TTI
SELECT CAST(EOMONTH('2018-03-19') AS VARCHAR(10)), CAST(DATEADD(day, 5, '2018-03-19') AS VARCHAR(10)), DATEDIFF(day, '2018-03-19', '2018-03-24');
----
2018-03-31 2018-03-24 5

query IIII
SELECT YEAR('2018-03-24'), MONTH('2018-03-24'), DAY('2018-03-24'), DAY(EOMONTH('2018-03-19'));
----
2018 3 24 31

statement ok
CREATE TABLE dt_log_1952 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1952 VALUES (1, '2018-03-19'), (2, '2018-03-24');

query II
SELECT id, DATEDIFF(day, '2018-03-19', ev_date) FROM dt_log_1952 ORDER BY id;
----
1 0
2 5

statement ok
DROP TABLE dt_log_1952;
