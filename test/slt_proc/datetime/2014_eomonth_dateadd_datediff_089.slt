# test/slt_proc/datetime/2014_eomonth_dateadd_datediff_089.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (89)

query TTI
SELECT CAST(EOMONTH('2026-05-23') AS VARCHAR(10)), CAST(DATEADD(day, 17, '2026-05-23') AS VARCHAR(10)), DATEDIFF(day, '2026-05-23', '2026-06-09');
----
2026-05-31 2026-06-09 17

query IIII
SELECT YEAR('2026-06-09'), MONTH('2026-06-09'), DAY('2026-06-09'), DAY(EOMONTH('2026-05-23'));
----
2026 6 9 31

statement ok
CREATE TABLE dt_log_2014 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2014 VALUES (1, '2026-05-23'), (2, '2026-06-09');

query II
SELECT id, DATEDIFF(day, '2026-05-23', ev_date) FROM dt_log_2014 ORDER BY id;
----
1 0
2 17

statement ok
DROP TABLE dt_log_2014;
