# test/slt_proc/datetime/2024_eomonth_dateadd_datediff_099.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (99)

query TTI
SELECT CAST(EOMONTH('2018-03-23') AS VARCHAR(10)), CAST(DATEADD(day, 27, '2018-03-23') AS VARCHAR(10)), DATEDIFF(day, '2018-03-23', '2018-04-19');
----
2018-03-31 2018-04-19 27

query IIII
SELECT YEAR('2018-04-19'), MONTH('2018-04-19'), DAY('2018-04-19'), DAY(EOMONTH('2018-03-23'));
----
2018 4 19 31

statement ok
CREATE TABLE dt_log_2024 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2024 VALUES (1, '2018-03-23'), (2, '2018-04-19');

query II
SELECT id, DATEDIFF(day, '2018-03-23', ev_date) FROM dt_log_2024 ORDER BY id;
----
1 0
2 27

statement ok
DROP TABLE dt_log_2024;
