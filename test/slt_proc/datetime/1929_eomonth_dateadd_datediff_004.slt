# test/slt_proc/datetime/1929_eomonth_dateadd_datediff_004.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (4)

query TTI
SELECT CAST(EOMONTH('2022-04-13') AS VARCHAR(10)), CAST(DATEADD(day, 7, '2022-04-13') AS VARCHAR(10)), DATEDIFF(day, '2022-04-13', '2022-04-20');
----
2022-04-30 2022-04-20 7

query IIII
SELECT YEAR('2022-04-20'), MONTH('2022-04-20'), DAY('2022-04-20'), DAY(EOMONTH('2022-04-13'));
----
2022 4 20 30

statement ok
CREATE TABLE dt_log_1929 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1929 VALUES (1, '2022-04-13'), (2, '2022-04-20');

query II
SELECT id, DATEDIFF(day, '2022-04-13', ev_date) FROM dt_log_1929 ORDER BY id;
----
1 0
2 7

statement ok
DROP TABLE dt_log_1929;
