# test/slt_proc/datetime/2012_eomonth_dateadd_datediff_087.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (87)

query TTI
SELECT CAST(EOMONTH('2024-03-19') AS VARCHAR(10)), CAST(DATEADD(day, 15, '2024-03-19') AS VARCHAR(10)), DATEDIFF(day, '2024-03-19', '2024-04-03');
----
2024-03-31 2024-04-03 15

query IIII
SELECT YEAR('2024-04-03'), MONTH('2024-04-03'), DAY('2024-04-03'), DAY(EOMONTH('2024-03-19'));
----
2024 4 3 31

statement ok
CREATE TABLE dt_log_2012 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2012 VALUES (1, '2024-03-19'), (2, '2024-04-03');

query II
SELECT id, DATEDIFF(day, '2024-03-19', ev_date) FROM dt_log_2012 ORDER BY id;
----
1 0
2 15

statement ok
DROP TABLE dt_log_2012;
