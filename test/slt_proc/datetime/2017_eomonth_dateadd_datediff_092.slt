# test/slt_proc/datetime/2017_eomonth_dateadd_datediff_092.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (92)

query TTI
SELECT CAST(EOMONTH('2020-08-09') AS VARCHAR(10)), CAST(DATEADD(day, 20, '2020-08-09') AS VARCHAR(10)), DATEDIFF(day, '2020-08-09', '2020-08-29');
----
2020-08-31 2020-08-29 20

query IIII
SELECT YEAR('2020-08-29'), MONTH('2020-08-29'), DAY('2020-08-29'), DAY(EOMONTH('2020-08-09'));
----
2020 8 29 31

statement ok
CREATE TABLE dt_log_2017 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2017 VALUES (1, '2020-08-09'), (2, '2020-08-29');

query II
SELECT id, DATEDIFF(day, '2020-08-09', ev_date) FROM dt_log_2017 ORDER BY id;
----
1 0
2 20

statement ok
DROP TABLE dt_log_2017;
