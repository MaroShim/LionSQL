# test/slt_proc/datetime/1957_eomonth_dateadd_datediff_032.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (32)

query TTI
SELECT CAST(EOMONTH('2023-08-09') AS VARCHAR(10)), CAST(DATEADD(day, 10, '2023-08-09') AS VARCHAR(10)), DATEDIFF(day, '2023-08-09', '2023-08-19');
----
2023-08-31 2023-08-19 10

query IIII
SELECT YEAR('2023-08-19'), MONTH('2023-08-19'), DAY('2023-08-19'), DAY(EOMONTH('2023-08-09'));
----
2023 8 19 31

statement ok
CREATE TABLE dt_log_1957 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1957 VALUES (1, '2023-08-09'), (2, '2023-08-19');

query II
SELECT id, DATEDIFF(day, '2023-08-09', ev_date) FROM dt_log_1957 ORDER BY id;
----
1 0
2 10

statement ok
DROP TABLE dt_log_1957;
