# test/slt_proc/datetime/1947_eomonth_dateadd_datediff_022.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (22)

query TTI
SELECT CAST(EOMONTH('2022-10-09') AS VARCHAR(10)), CAST(DATEADD(day, 25, '2022-10-09') AS VARCHAR(10)), DATEDIFF(day, '2022-10-09', '2022-11-03');
----
2022-10-31 2022-11-03 25

query IIII
SELECT YEAR('2022-11-03'), MONTH('2022-11-03'), DAY('2022-11-03'), DAY(EOMONTH('2022-10-09'));
----
2022 11 3 31

statement ok
CREATE TABLE dt_log_1947 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1947 VALUES (1, '2022-10-09'), (2, '2022-11-03');

query II
SELECT id, DATEDIFF(day, '2022-10-09', ev_date) FROM dt_log_1947 ORDER BY id;
----
1 0
2 25

statement ok
DROP TABLE dt_log_1947;
