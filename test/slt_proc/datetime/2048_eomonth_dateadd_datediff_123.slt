# test/slt_proc/datetime/2048_eomonth_dateadd_datediff_123.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (123)

query TTI
SELECT CAST(EOMONTH('2024-03-11') AS VARCHAR(10)), CAST(DATEADD(day, 26, '2024-03-11') AS VARCHAR(10)), DATEDIFF(day, '2024-03-11', '2024-04-06');
----
2024-03-31 2024-04-06 26

query IIII
SELECT YEAR('2024-04-06'), MONTH('2024-04-06'), DAY('2024-04-06'), DAY(EOMONTH('2024-03-11'));
----
2024 4 6 31

statement ok
CREATE TABLE dt_log_2048 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2048 VALUES (1, '2024-03-11'), (2, '2024-04-06');

query II
SELECT id, DATEDIFF(day, '2024-03-11', ev_date) FROM dt_log_2048 ORDER BY id;
----
1 0
2 26

statement ok
DROP TABLE dt_log_2048;
