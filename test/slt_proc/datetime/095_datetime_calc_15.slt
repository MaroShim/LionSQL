# test/slt_proc/datetime/095_datetime_calc_15.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (15)

query IIIT
SELECT YEAR('2024-03-16'), MONTH('2024-03-16'), DAY('2024-03-16'), DATENAME(month, '2024-03-16');
----
2024 3 16 March

query TT
SELECT EOMONTH('2024-03-16'), CONVERT(VARCHAR(10), DATEADD(day, 60, '2026-01-01'), 120);
----
2024-03-31 2026-03-02

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-02'), ISDATE('2024-03-16'), ISDATE('bad-date-15');
----
60 1 0
