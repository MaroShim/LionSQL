# test/slt_proc/datetime/101_datetime_calc_21.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (21)

query IIIT
SELECT YEAR('2024-09-02'), MONTH('2024-09-02'), DAY('2024-09-02'), DATENAME(month, '2024-09-02');
----
2024 9 2 September

query TT
SELECT EOMONTH('2024-09-02'), CONVERT(VARCHAR(10), DATEADD(day, 84, '2026-01-01'), 120);
----
2024-09-30 2026-03-26

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-26'), ISDATE('2024-09-02'), ISDATE('bad-date-21');
----
84 1 0
