# test/slt_proc/datetime/815_datefromparts_datepart_05.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (5)

query TII
SELECT CAST(DATEFROMPARTS(2025, 5, 16) AS VARCHAR(10)), DATEPART(quarter, '2025-05-16'), DATEPART(dayofyear, '2025-05-16');
----
2025-05-16 2 136

query III
SELECT DATEDIFF(year, '2015-01-01', '2025-05-16'), DATEDIFF(month, '2025-01-01', '2025-05-16'), IIF('2025-05-16' >= '2020-01-01', 1, 0);
----
10 4 1

statement ok
CREATE PROCEDURE sp_dt_check_815 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_815 '2025-05-16', @q_out OUTPUT;
----
2025 5 16 2
