# test/slt_proc/datetime/826_datefromparts_datepart_16.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (16)

query TII
SELECT CAST(DATEFROMPARTS(2020, 4, 24) AS VARCHAR(10)), DATEPART(quarter, '2020-04-24'), DATEPART(dayofyear, '2020-04-24');
----
2020-04-24 2 115

query III
SELECT DATEDIFF(year, '2015-01-01', '2020-04-24'), DATEDIFF(month, '2020-01-01', '2020-04-24'), IIF('2020-04-24' >= '2020-01-01', 1, 0);
----
5 3 1

statement ok
CREATE PROCEDURE sp_dt_check_826 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_826 '2020-04-24', @q_out OUTPUT;
----
2020 4 24 2
