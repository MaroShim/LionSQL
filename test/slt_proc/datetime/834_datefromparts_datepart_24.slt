# test/slt_proc/datetime/834_datefromparts_datepart_24.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (24)

query TII
SELECT CAST(DATEFROMPARTS(2020, 12, 23) AS VARCHAR(10)), DATEPART(quarter, '2020-12-23'), DATEPART(dayofyear, '2020-12-23');
----
2020-12-23 4 358

query III
SELECT DATEDIFF(year, '2015-01-01', '2020-12-23'), DATEDIFF(month, '2020-01-01', '2020-12-23'), IIF('2020-12-23' >= '2020-01-01', 1, 0);
----
5 11 1

statement ok
CREATE PROCEDURE sp_dt_check_834 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_834 '2020-12-23', @q_out OUTPUT;
----
2020 12 23 4
