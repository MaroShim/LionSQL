# test/slt_proc/datetime/1982_eomonth_dateadd_datediff_057.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (57)

query TTI
SELECT CAST(EOMONTH('2021-09-19') AS VARCHAR(10)), CAST(DATEADD(day, 10, '2021-09-19') AS VARCHAR(10)), DATEDIFF(day, '2021-09-19', '2021-09-29');
----
2021-09-30 2021-09-29 10

query IIII
SELECT YEAR('2021-09-29'), MONTH('2021-09-29'), DAY('2021-09-29'), DAY(EOMONTH('2021-09-19'));
----
2021 9 29 30

statement ok
CREATE TABLE dt_log_1982 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1982 VALUES (1, '2021-09-19'), (2, '2021-09-29');

query II
SELECT id, DATEDIFF(day, '2021-09-19', ev_date) FROM dt_log_1982 ORDER BY id;
----
1 0
2 10

statement ok
DROP TABLE dt_log_1982;
