# test/slt_proc/datetime/1995_eomonth_dateadd_datediff_070.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (70)

query TTI
SELECT CAST(EOMONTH('2025-10-05') AS VARCHAR(10)), CAST(DATEADD(day, 23, '2025-10-05') AS VARCHAR(10)), DATEDIFF(day, '2025-10-05', '2025-10-28');
----
2025-10-31 2025-10-28 23

query IIII
SELECT YEAR('2025-10-28'), MONTH('2025-10-28'), DAY('2025-10-28'), DAY(EOMONTH('2025-10-05'));
----
2025 10 28 31

statement ok
CREATE TABLE dt_log_1995 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1995 VALUES (1, '2025-10-05'), (2, '2025-10-28');

query II
SELECT id, DATEDIFF(day, '2025-10-05', ev_date) FROM dt_log_1995 ORDER BY id;
----
1 0
2 23

statement ok
DROP TABLE dt_log_1995;
