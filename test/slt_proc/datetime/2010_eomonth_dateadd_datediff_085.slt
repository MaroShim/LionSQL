# test/slt_proc/datetime/2010_eomonth_dateadd_datediff_085.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (85)

query TTI
SELECT CAST(EOMONTH('2022-01-15') AS VARCHAR(10)), CAST(DATEADD(day, 13, '2022-01-15') AS VARCHAR(10)), DATEDIFF(day, '2022-01-15', '2022-01-28');
----
2022-01-31 2022-01-28 13

query IIII
SELECT YEAR('2022-01-28'), MONTH('2022-01-28'), DAY('2022-01-28'), DAY(EOMONTH('2022-01-15'));
----
2022 1 28 31

statement ok
CREATE TABLE dt_log_2010 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2010 VALUES (1, '2022-01-15'), (2, '2022-01-28');

query II
SELECT id, DATEDIFF(day, '2022-01-15', ev_date) FROM dt_log_2010 ORDER BY id;
----
1 0
2 13

statement ok
DROP TABLE dt_log_2010;
