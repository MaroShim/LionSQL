# test/slt_proc/datetime/084_datetime_calc_04.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (4)

query IIIT
SELECT YEAR('2025-04-05'), MONTH('2025-04-05'), DAY('2025-04-05'), DATENAME(month, '2025-04-05');
----
2025 4 5 April

query TT
SELECT EOMONTH('2025-04-05'), CONVERT(VARCHAR(10), DATEADD(day, 16, '2026-01-01'), 120);
----
2025-04-30 2026-01-17

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-01-17'), ISDATE('2025-04-05'), ISDATE('bad-date-4');
----
16 1 0
