# test/slt_proc/datetime/2055_eomonth_dateadd_datediff_130.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (130)

query TTI
SELECT CAST(EOMONTH('2022-10-05') AS VARCHAR(10)), CAST(DATEADD(day, 8, '2022-10-05') AS VARCHAR(10)), DATEDIFF(day, '2022-10-05', '2022-10-13');
----
2022-10-31 2022-10-13 8

query IIII
SELECT YEAR('2022-10-13'), MONTH('2022-10-13'), DAY('2022-10-13'), DAY(EOMONTH('2022-10-05'));
----
2022 10 13 31

statement ok
CREATE TABLE dt_log_2055 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2055 VALUES (1, '2022-10-05'), (2, '2022-10-13');

query II
SELECT id, DATEDIFF(day, '2022-10-05', ev_date) FROM dt_log_2055 ORDER BY id;
----
1 0
2 8

statement ok
DROP TABLE dt_log_2055;
