# test/slt_proc/datetime/1960_eomonth_dateadd_datediff_035.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (35)

query TTI
SELECT CAST(EOMONTH('2026-11-15') AS VARCHAR(10)), CAST(DATEADD(day, 13, '2026-11-15') AS VARCHAR(10)), DATEDIFF(day, '2026-11-15', '2026-11-28');
----
2026-11-30 2026-11-28 13

query IIII
SELECT YEAR('2026-11-28'), MONTH('2026-11-28'), DAY('2026-11-28'), DAY(EOMONTH('2026-11-15'));
----
2026 11 28 30

statement ok
CREATE TABLE dt_log_1960 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1960 VALUES (1, '2026-11-15'), (2, '2026-11-28');

query II
SELECT id, DATEDIFF(day, '2026-11-15', ev_date) FROM dt_log_1960 ORDER BY id;
----
1 0
2 13

statement ok
DROP TABLE dt_log_1960;
