# test/slt_proc/datetime/2050_eomonth_dateadd_datediff_125.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (125)

query TTI
SELECT CAST(EOMONTH('2026-05-15') AS VARCHAR(10)), CAST(DATEADD(day, 3, '2026-05-15') AS VARCHAR(10)), DATEDIFF(day, '2026-05-15', '2026-05-18');
----
2026-05-31 2026-05-18 3

query IIII
SELECT YEAR('2026-05-18'), MONTH('2026-05-18'), DAY('2026-05-18'), DAY(EOMONTH('2026-05-15'));
----
2026 5 18 31

statement ok
CREATE TABLE dt_log_2050 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2050 VALUES (1, '2026-05-15'), (2, '2026-05-18');

query II
SELECT id, DATEDIFF(day, '2026-05-15', ev_date) FROM dt_log_2050 ORDER BY id;
----
1 0
2 3

statement ok
DROP TABLE dt_log_2050;
