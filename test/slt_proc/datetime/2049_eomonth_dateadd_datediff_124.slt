# test/slt_proc/datetime/2049_eomonth_dateadd_datediff_124.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (124)

query TTI
SELECT CAST(EOMONTH('2025-04-13') AS VARCHAR(10)), CAST(DATEADD(day, 27, '2025-04-13') AS VARCHAR(10)), DATEDIFF(day, '2025-04-13', '2025-05-10');
----
2025-04-30 2025-05-10 27

query IIII
SELECT YEAR('2025-05-10'), MONTH('2025-05-10'), DAY('2025-05-10'), DAY(EOMONTH('2025-04-13'));
----
2025 5 10 30

statement ok
CREATE TABLE dt_log_2049 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2049 VALUES (1, '2025-04-13'), (2, '2025-05-10');

query II
SELECT id, DATEDIFF(day, '2025-04-13', ev_date) FROM dt_log_2049 ORDER BY id;
----
1 0
2 27

statement ok
DROP TABLE dt_log_2049;
