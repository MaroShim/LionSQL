# test/slt_proc/datetime/2071_eomonth_dateadd_datediff_146.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (146)

query TTI
SELECT CAST(EOMONTH('2020-02-17') AS VARCHAR(10)), CAST(DATEADD(day, 24, '2020-02-17') AS VARCHAR(10)), DATEDIFF(day, '2020-02-17', '2020-03-12');
----
2020-02-29 2020-03-12 24

query IIII
SELECT YEAR('2020-03-12'), MONTH('2020-03-12'), DAY('2020-03-12'), DAY(EOMONTH('2020-02-17'));
----
2020 3 12 29

statement ok
CREATE TABLE dt_log_2071 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2071 VALUES (1, '2020-02-17'), (2, '2020-03-12');

query II
SELECT id, DATEDIFF(day, '2020-02-17', ev_date) FROM dt_log_2071 ORDER BY id;
----
1 0
2 24

statement ok
DROP TABLE dt_log_2071;
