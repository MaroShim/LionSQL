# test/slt_proc/datetime/1972_eomonth_dateadd_datediff_047.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (47)

query TTI
SELECT CAST(EOMONTH('2020-11-19') AS VARCHAR(10)), CAST(DATEADD(day, 25, '2020-11-19') AS VARCHAR(10)), DATEDIFF(day, '2020-11-19', '2020-12-14');
----
2020-11-30 2020-12-14 25

query IIII
SELECT YEAR('2020-12-14'), MONTH('2020-12-14'), DAY('2020-12-14'), DAY(EOMONTH('2020-11-19'));
----
2020 12 14 30

statement ok
CREATE TABLE dt_log_1972 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1972 VALUES (1, '2020-11-19'), (2, '2020-12-14');

query II
SELECT id, DATEDIFF(day, '2020-11-19', ev_date) FROM dt_log_1972 ORDER BY id;
----
1 0
2 25

statement ok
DROP TABLE dt_log_1972;
