# test/slt_proc/datetime/2005_eomonth_dateadd_datediff_080.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (80)

query TTI
SELECT CAST(EOMONTH('2026-08-05') AS VARCHAR(10)), CAST(DATEADD(day, 8, '2026-08-05') AS VARCHAR(10)), DATEDIFF(day, '2026-08-05', '2026-08-13');
----
2026-08-31 2026-08-13 8

query IIII
SELECT YEAR('2026-08-13'), MONTH('2026-08-13'), DAY('2026-08-13'), DAY(EOMONTH('2026-08-05'));
----
2026 8 13 31

statement ok
CREATE TABLE dt_log_2005 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2005 VALUES (1, '2026-08-05'), (2, '2026-08-13');

query II
SELECT id, DATEDIFF(day, '2026-08-05', ev_date) FROM dt_log_2005 ORDER BY id;
----
1 0
2 8

statement ok
DROP TABLE dt_log_2005;
