# test/slt_proc/datetime/829_datefromparts_datepart_19.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (19)

query TII
SELECT CAST(DATEFROMPARTS(2023, 7, 8) AS VARCHAR(10)), DATEPART(quarter, '2023-07-08'), DATEPART(dayofyear, '2023-07-08');
----
2023-07-08 3 189

query III
SELECT DATEDIFF(year, '2015-01-01', '2023-07-08'), DATEDIFF(month, '2023-01-01', '2023-07-08'), IIF('2023-07-08' >= '2020-01-01', 1, 0);
----
8 6 1

statement ok
CREATE PROCEDURE sp_dt_check_829 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_829 '2023-07-08', @q_out OUTPUT;
----
2023 7 8 3
