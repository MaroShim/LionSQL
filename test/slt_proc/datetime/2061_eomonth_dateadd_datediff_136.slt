# test/slt_proc/datetime/2061_eomonth_dateadd_datediff_136.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (136)

query TTI
SELECT CAST(EOMONTH('2019-04-17') AS VARCHAR(10)), CAST(DATEADD(day, 14, '2019-04-17') AS VARCHAR(10)), DATEDIFF(day, '2019-04-17', '2019-05-01');
----
2019-04-30 2019-05-01 14

query IIII
SELECT YEAR('2019-05-01'), MONTH('2019-05-01'), DAY('2019-05-01'), DAY(EOMONTH('2019-04-17'));
----
2019 5 1 30

statement ok
CREATE TABLE dt_log_2061 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2061 VALUES (1, '2019-04-17'), (2, '2019-05-01');

query II
SELECT id, DATEDIFF(day, '2019-04-17', ev_date) FROM dt_log_2061 ORDER BY id;
----
1 0
2 14

statement ok
DROP TABLE dt_log_2061;
