# test/slt_proc/datetime/2026_eomonth_dateadd_datediff_101.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (101)

query TTI
SELECT CAST(EOMONTH('2020-05-07') AS VARCHAR(10)), CAST(DATEADD(day, 4, '2020-05-07') AS VARCHAR(10)), DATEDIFF(day, '2020-05-07', '2020-05-11');
----
2020-05-31 2020-05-11 4

query IIII
SELECT YEAR('2020-05-11'), MONTH('2020-05-11'), DAY('2020-05-11'), DAY(EOMONTH('2020-05-07'));
----
2020 5 11 31

statement ok
CREATE TABLE dt_log_2026 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2026 VALUES (1, '2020-05-07'), (2, '2020-05-11');

query II
SELECT id, DATEDIFF(day, '2020-05-07', ev_date) FROM dt_log_2026 ORDER BY id;
----
1 0
2 4

statement ok
DROP TABLE dt_log_2026;
