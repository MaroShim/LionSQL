# test/slt_proc/datetime/2052_eomonth_dateadd_datediff_127.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (127)

query TTI
SELECT CAST(EOMONTH('2019-07-19') AS VARCHAR(10)), CAST(DATEADD(day, 5, '2019-07-19') AS VARCHAR(10)), DATEDIFF(day, '2019-07-19', '2019-07-24');
----
2019-07-31 2019-07-24 5

query IIII
SELECT YEAR('2019-07-24'), MONTH('2019-07-24'), DAY('2019-07-24'), DAY(EOMONTH('2019-07-19'));
----
2019 7 24 31

statement ok
CREATE TABLE dt_log_2052 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2052 VALUES (1, '2019-07-19'), (2, '2019-07-24');

query II
SELECT id, DATEDIFF(day, '2019-07-19', ev_date) FROM dt_log_2052 ORDER BY id;
----
1 0
2 5

statement ok
DROP TABLE dt_log_2052;
