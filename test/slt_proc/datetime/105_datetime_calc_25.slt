# test/slt_proc/datetime/105_datetime_calc_25.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (25)

query IIIT
SELECT YEAR('2022-01-06'), MONTH('2022-01-06'), DAY('2022-01-06'), DATENAME(month, '2022-01-06');
----
2022 1 6 January

query TT
SELECT EOMONTH('2022-01-06'), CONVERT(VARCHAR(10), DATEADD(day, 100, '2026-01-01'), 120);
----
2022-01-31 2026-04-11

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-04-11'), ISDATE('2022-01-06'), ISDATE('bad-date-25');
----
100 1 0
