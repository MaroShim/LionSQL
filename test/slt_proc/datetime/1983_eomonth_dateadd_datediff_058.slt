# test/slt_proc/datetime/1983_eomonth_dateadd_datediff_058.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (58)

query TTI
SELECT CAST(EOMONTH('2022-10-21') AS VARCHAR(10)), CAST(DATEADD(day, 11, '2022-10-21') AS VARCHAR(10)), DATEDIFF(day, '2022-10-21', '2022-11-01');
----
2022-10-31 2022-11-01 11

query IIII
SELECT YEAR('2022-11-01'), MONTH('2022-11-01'), DAY('2022-11-01'), DAY(EOMONTH('2022-10-21'));
----
2022 11 1 31

statement ok
CREATE TABLE dt_log_1983 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1983 VALUES (1, '2022-10-21'), (2, '2022-11-01');

query II
SELECT id, DATEDIFF(day, '2022-10-21', ev_date) FROM dt_log_1983 ORDER BY id;
----
1 0
2 11

statement ok
DROP TABLE dt_log_1983;
