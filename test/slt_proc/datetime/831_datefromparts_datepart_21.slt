# test/slt_proc/datetime/831_datefromparts_datepart_21.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (21)

query TII
SELECT CAST(DATEFROMPARTS(2025, 9, 14) AS VARCHAR(10)), DATEPART(quarter, '2025-09-14'), DATEPART(dayofyear, '2025-09-14');
----
2025-09-14 3 257

query III
SELECT DATEDIFF(year, '2015-01-01', '2025-09-14'), DATEDIFF(month, '2025-01-01', '2025-09-14'), IIF('2025-09-14' >= '2020-01-01', 1, 0);
----
10 8 1

statement ok
CREATE PROCEDURE sp_dt_check_831 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_831 '2025-09-14', @q_out OUTPUT;
----
2025 9 14 3
