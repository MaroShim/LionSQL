# test/slt_proc/datetime/2027_eomonth_dateadd_datediff_102.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (102)

query TTI
SELECT CAST(EOMONTH('2021-06-09') AS VARCHAR(10)), CAST(DATEADD(day, 5, '2021-06-09') AS VARCHAR(10)), DATEDIFF(day, '2021-06-09', '2021-06-14');
----
2021-06-30 2021-06-14 5

query IIII
SELECT YEAR('2021-06-14'), MONTH('2021-06-14'), DAY('2021-06-14'), DAY(EOMONTH('2021-06-09'));
----
2021 6 14 30

statement ok
CREATE TABLE dt_log_2027 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2027 VALUES (1, '2021-06-09'), (2, '2021-06-14');

query II
SELECT id, DATEDIFF(day, '2021-06-09', ev_date) FROM dt_log_2027 ORDER BY id;
----
1 0
2 5

statement ok
DROP TABLE dt_log_2027;
