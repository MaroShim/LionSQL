# test/slt_proc/datetime/089_datetime_calc_09.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (9)

query IIIT
SELECT YEAR('2024-09-10'), MONTH('2024-09-10'), DAY('2024-09-10'), DATENAME(month, '2024-09-10');
----
2024 9 10 September

query TT
SELECT EOMONTH('2024-09-10'), CONVERT(VARCHAR(10), DATEADD(day, 36, '2026-01-01'), 120);
----
2024-09-30 2026-02-06

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-02-06'), ISDATE('2024-09-10'), ISDATE('bad-date-9');
----
36 1 0
