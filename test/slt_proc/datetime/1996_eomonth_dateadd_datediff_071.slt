# test/slt_proc/datetime/1996_eomonth_dateadd_datediff_071.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (71)

query TTI
SELECT CAST(EOMONTH('2026-11-07') AS VARCHAR(10)), CAST(DATEADD(day, 24, '2026-11-07') AS VARCHAR(10)), DATEDIFF(day, '2026-11-07', '2026-12-01');
----
2026-11-30 2026-12-01 24

query IIII
SELECT YEAR('2026-12-01'), MONTH('2026-12-01'), DAY('2026-12-01'), DAY(EOMONTH('2026-11-07'));
----
2026 12 1 30

statement ok
CREATE TABLE dt_log_1996 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1996 VALUES (1, '2026-11-07'), (2, '2026-12-01');

query II
SELECT id, DATEDIFF(day, '2026-11-07', ev_date) FROM dt_log_1996 ORDER BY id;
----
1 0
2 24

statement ok
DROP TABLE dt_log_1996;
