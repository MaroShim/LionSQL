# test/slt_proc/datetime/1934_eomonth_dateadd_datediff_009.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (9)

query TTI
SELECT CAST(EOMONTH('2018-09-23') AS VARCHAR(10)), CAST(DATEADD(day, 12, '2018-09-23') AS VARCHAR(10)), DATEDIFF(day, '2018-09-23', '2018-10-05');
----
2018-09-30 2018-10-05 12

query IIII
SELECT YEAR('2018-10-05'), MONTH('2018-10-05'), DAY('2018-10-05'), DAY(EOMONTH('2018-09-23'));
----
2018 10 5 30

statement ok
CREATE TABLE dt_log_1934 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1934 VALUES (1, '2018-09-23'), (2, '2018-10-05');

query II
SELECT id, DATEDIFF(day, '2018-09-23', ev_date) FROM dt_log_1934 ORDER BY id;
----
1 0
2 12

statement ok
DROP TABLE dt_log_1934;
