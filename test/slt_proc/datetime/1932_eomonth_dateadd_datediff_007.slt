# test/slt_proc/datetime/1932_eomonth_dateadd_datediff_007.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (7)

query TTI
SELECT CAST(EOMONTH('2025-07-19') AS VARCHAR(10)), CAST(DATEADD(day, 10, '2025-07-19') AS VARCHAR(10)), DATEDIFF(day, '2025-07-19', '2025-07-29');
----
2025-07-31 2025-07-29 10

query IIII
SELECT YEAR('2025-07-29'), MONTH('2025-07-29'), DAY('2025-07-29'), DAY(EOMONTH('2025-07-19'));
----
2025 7 29 31

statement ok
CREATE TABLE dt_log_1932 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1932 VALUES (1, '2025-07-19'), (2, '2025-07-29');

query II
SELECT id, DATEDIFF(day, '2025-07-19', ev_date) FROM dt_log_1932 ORDER BY id;
----
1 0
2 10

statement ok
DROP TABLE dt_log_1932;
