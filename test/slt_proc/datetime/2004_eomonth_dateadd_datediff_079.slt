# test/slt_proc/datetime/2004_eomonth_dateadd_datediff_079.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (79)

query TTI
SELECT CAST(EOMONTH('2025-07-23') AS VARCHAR(10)), CAST(DATEADD(day, 7, '2025-07-23') AS VARCHAR(10)), DATEDIFF(day, '2025-07-23', '2025-07-30');
----
2025-07-31 2025-07-30 7

query IIII
SELECT YEAR('2025-07-30'), MONTH('2025-07-30'), DAY('2025-07-30'), DAY(EOMONTH('2025-07-23'));
----
2025 7 30 31

statement ok
CREATE TABLE dt_log_2004 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2004 VALUES (1, '2025-07-23'), (2, '2025-07-30');

query II
SELECT id, DATEDIFF(day, '2025-07-23', ev_date) FROM dt_log_2004 ORDER BY id;
----
1 0
2 7

statement ok
DROP TABLE dt_log_2004;
