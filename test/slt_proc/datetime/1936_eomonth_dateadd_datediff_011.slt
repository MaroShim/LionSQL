# test/slt_proc/datetime/1936_eomonth_dateadd_datediff_011.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (11)

query TTI
SELECT CAST(EOMONTH('2020-11-07') AS VARCHAR(10)), CAST(DATEADD(day, 14, '2020-11-07') AS VARCHAR(10)), DATEDIFF(day, '2020-11-07', '2020-11-21');
----
2020-11-30 2020-11-21 14

query IIII
SELECT YEAR('2020-11-21'), MONTH('2020-11-21'), DAY('2020-11-21'), DAY(EOMONTH('2020-11-07'));
----
2020 11 21 30

statement ok
CREATE TABLE dt_log_1936 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1936 VALUES (1, '2020-11-07'), (2, '2020-11-21');

query II
SELECT id, DATEDIFF(day, '2020-11-07', ev_date) FROM dt_log_1936 ORDER BY id;
----
1 0
2 14

statement ok
DROP TABLE dt_log_1936;
