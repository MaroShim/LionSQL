# test/slt_proc/datetime/1954_eomonth_dateadd_datediff_029.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (29)

query TTI
SELECT CAST(EOMONTH('2020-05-23') AS VARCHAR(10)), CAST(DATEADD(day, 7, '2020-05-23') AS VARCHAR(10)), DATEDIFF(day, '2020-05-23', '2020-05-30');
----
2020-05-31 2020-05-30 7

query IIII
SELECT YEAR('2020-05-30'), MONTH('2020-05-30'), DAY('2020-05-30'), DAY(EOMONTH('2020-05-23'));
----
2020 5 30 31

statement ok
CREATE TABLE dt_log_1954 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1954 VALUES (1, '2020-05-23'), (2, '2020-05-30');

query II
SELECT id, DATEDIFF(day, '2020-05-23', ev_date) FROM dt_log_1954 ORDER BY id;
----
1 0
2 7

statement ok
DROP TABLE dt_log_1954;
