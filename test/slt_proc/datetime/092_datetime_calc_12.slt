# test/slt_proc/datetime/092_datetime_calc_12.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (12)

query IIIT
SELECT YEAR('2021-12-13'), MONTH('2021-12-13'), DAY('2021-12-13'), DATENAME(month, '2021-12-13');
----
2021 12 13 December

query TT
SELECT EOMONTH('2021-12-13'), CONVERT(VARCHAR(10), DATEADD(day, 48, '2026-01-01'), 120);
----
2021-12-31 2026-02-18

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-02-18'), ISDATE('2021-12-13'), ISDATE('bad-date-12');
----
48 1 0
