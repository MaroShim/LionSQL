# test/slt_proc/datetime/102_datetime_calc_22.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (22)

query IIIT
SELECT YEAR('2025-10-03'), MONTH('2025-10-03'), DAY('2025-10-03'), DATENAME(month, '2025-10-03');
----
2025 10 3 October

query TT
SELECT EOMONTH('2025-10-03'), CONVERT(VARCHAR(10), DATEADD(day, 88, '2026-01-01'), 120);
----
2025-10-31 2026-03-30

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-30'), ISDATE('2025-10-03'), ISDATE('bad-date-22');
----
88 1 0
