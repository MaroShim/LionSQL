# test/slt_proc/datetime/2015_eomonth_dateadd_datediff_090.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (90)

query TTI
SELECT CAST(EOMONTH('2018-06-05') AS VARCHAR(10)), CAST(DATEADD(day, 18, '2018-06-05') AS VARCHAR(10)), DATEDIFF(day, '2018-06-05', '2018-06-23');
----
2018-06-30 2018-06-23 18

query IIII
SELECT YEAR('2018-06-23'), MONTH('2018-06-23'), DAY('2018-06-23'), DAY(EOMONTH('2018-06-05'));
----
2018 6 23 30

statement ok
CREATE TABLE dt_log_2015 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2015 VALUES (1, '2018-06-05'), (2, '2018-06-23');

query II
SELECT id, DATEDIFF(day, '2018-06-05', ev_date) FROM dt_log_2015 ORDER BY id;
----
1 0
2 18

statement ok
DROP TABLE dt_log_2015;
