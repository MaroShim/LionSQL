# test/slt_proc/datetime/1940_eomonth_dateadd_datediff_015.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (15)

query TTI
SELECT CAST(EOMONTH('2024-03-15') AS VARCHAR(10)), CAST(DATEADD(day, 18, '2024-03-15') AS VARCHAR(10)), DATEDIFF(day, '2024-03-15', '2024-04-02');
----
2024-03-31 2024-04-02 18

query IIII
SELECT YEAR('2024-04-02'), MONTH('2024-04-02'), DAY('2024-04-02'), DAY(EOMONTH('2024-03-15'));
----
2024 4 2 31

statement ok
CREATE TABLE dt_log_1940 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1940 VALUES (1, '2024-03-15'), (2, '2024-04-02');

query II
SELECT id, DATEDIFF(day, '2024-03-15', ev_date) FROM dt_log_1940 ORDER BY id;
----
1 0
2 18

statement ok
DROP TABLE dt_log_1940;
