# test/slt_proc/datetime/1946_eomonth_dateadd_datediff_021.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (21)

query TTI
SELECT CAST(EOMONTH('2021-09-07') AS VARCHAR(10)), CAST(DATEADD(day, 24, '2021-09-07') AS VARCHAR(10)), DATEDIFF(day, '2021-09-07', '2021-10-01');
----
2021-09-30 2021-10-01 24

query IIII
SELECT YEAR('2021-10-01'), MONTH('2021-10-01'), DAY('2021-10-01'), DAY(EOMONTH('2021-09-07'));
----
2021 10 1 30

statement ok
CREATE TABLE dt_log_1946 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1946 VALUES (1, '2021-09-07'), (2, '2021-10-01');

query II
SELECT id, DATEDIFF(day, '2021-09-07', ev_date) FROM dt_log_1946 ORDER BY id;
----
1 0
2 24

statement ok
DROP TABLE dt_log_1946;
