# test/slt_proc/datetime/1933_eomonth_dateadd_datediff_008.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (8)

query TTI
SELECT CAST(EOMONTH('2026-08-21') AS VARCHAR(10)), CAST(DATEADD(day, 11, '2026-08-21') AS VARCHAR(10)), DATEDIFF(day, '2026-08-21', '2026-09-01');
----
2026-08-31 2026-09-01 11

query IIII
SELECT YEAR('2026-09-01'), MONTH('2026-09-01'), DAY('2026-09-01'), DAY(EOMONTH('2026-08-21'));
----
2026 9 1 31

statement ok
CREATE TABLE dt_log_1933 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1933 VALUES (1, '2026-08-21'), (2, '2026-09-01');

query II
SELECT id, DATEDIFF(day, '2026-08-21', ev_date) FROM dt_log_1933 ORDER BY id;
----
1 0
2 11

statement ok
DROP TABLE dt_log_1933;
