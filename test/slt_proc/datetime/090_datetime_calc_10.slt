# test/slt_proc/datetime/090_datetime_calc_10.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (10)

query IIIT
SELECT YEAR('2025-10-11'), MONTH('2025-10-11'), DAY('2025-10-11'), DATENAME(month, '2025-10-11');
----
2025 10 11 October

query TT
SELECT EOMONTH('2025-10-11'), CONVERT(VARCHAR(10), DATEADD(day, 40, '2026-01-01'), 120);
----
2025-10-31 2026-02-10

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-02-10'), ISDATE('2025-10-11'), ISDATE('bad-date-10');
----
40 1 0
