# test/slt_proc/datetime/1976_eomonth_dateadd_datediff_051.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (51)

query TTI
SELECT CAST(EOMONTH('2024-03-07') AS VARCHAR(10)), CAST(DATEADD(day, 4, '2024-03-07') AS VARCHAR(10)), DATEDIFF(day, '2024-03-07', '2024-03-11');
----
2024-03-31 2024-03-11 4

query IIII
SELECT YEAR('2024-03-11'), MONTH('2024-03-11'), DAY('2024-03-11'), DAY(EOMONTH('2024-03-07'));
----
2024 3 11 31

statement ok
CREATE TABLE dt_log_1976 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1976 VALUES (1, '2024-03-07'), (2, '2024-03-11');

query II
SELECT id, DATEDIFF(day, '2024-03-07', ev_date) FROM dt_log_1976 ORDER BY id;
----
1 0
2 4

statement ok
DROP TABLE dt_log_1976;
