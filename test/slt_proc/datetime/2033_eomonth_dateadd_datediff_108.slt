# test/slt_proc/datetime/2033_eomonth_dateadd_datediff_108.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (108)

query TTI
SELECT CAST(EOMONTH('2018-12-21') AS VARCHAR(10)), CAST(DATEADD(day, 11, '2018-12-21') AS VARCHAR(10)), DATEDIFF(day, '2018-12-21', '2019-01-01');
----
2018-12-31 2019-01-01 11

query IIII
SELECT YEAR('2019-01-01'), MONTH('2019-01-01'), DAY('2019-01-01'), DAY(EOMONTH('2018-12-21'));
----
2019 1 1 31

statement ok
CREATE TABLE dt_log_2033 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2033 VALUES (1, '2018-12-21'), (2, '2019-01-01');

query II
SELECT id, DATEDIFF(day, '2018-12-21', ev_date) FROM dt_log_2033 ORDER BY id;
----
1 0
2 11

statement ok
DROP TABLE dt_log_2033;
