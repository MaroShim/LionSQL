# test/slt_proc/datetime/1967_eomonth_dateadd_datediff_042.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (42)

query TTI
SELECT CAST(EOMONTH('2024-06-09') AS VARCHAR(10)), CAST(DATEADD(day, 20, '2024-06-09') AS VARCHAR(10)), DATEDIFF(day, '2024-06-09', '2024-06-29');
----
2024-06-30 2024-06-29 20

query IIII
SELECT YEAR('2024-06-29'), MONTH('2024-06-29'), DAY('2024-06-29'), DAY(EOMONTH('2024-06-09'));
----
2024 6 29 30

statement ok
CREATE TABLE dt_log_1967 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1967 VALUES (1, '2024-06-09'), (2, '2024-06-29');

query II
SELECT id, DATEDIFF(day, '2024-06-09', ev_date) FROM dt_log_1967 ORDER BY id;
----
1 0
2 20

statement ok
DROP TABLE dt_log_1967;
