# test/slt_proc/datetime/2042_eomonth_dateadd_datediff_117.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (117)

query TTI
SELECT CAST(EOMONTH('2018-09-19') AS VARCHAR(10)), CAST(DATEADD(day, 20, '2018-09-19') AS VARCHAR(10)), DATEDIFF(day, '2018-09-19', '2018-10-09');
----
2018-09-30 2018-10-09 20

query IIII
SELECT YEAR('2018-10-09'), MONTH('2018-10-09'), DAY('2018-10-09'), DAY(EOMONTH('2018-09-19'));
----
2018 10 9 30

statement ok
CREATE TABLE dt_log_2042 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2042 VALUES (1, '2018-09-19'), (2, '2018-10-09');

query II
SELECT id, DATEDIFF(day, '2018-09-19', ev_date) FROM dt_log_2042 ORDER BY id;
----
1 0
2 20

statement ok
DROP TABLE dt_log_2042;
