# test/slt_proc/datetime/1988_eomonth_dateadd_datediff_063.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (63)

query TTI
SELECT CAST(EOMONTH('2018-03-11') AS VARCHAR(10)), CAST(DATEADD(day, 16, '2018-03-11') AS VARCHAR(10)), DATEDIFF(day, '2018-03-11', '2018-03-27');
----
2018-03-31 2018-03-27 16

query IIII
SELECT YEAR('2018-03-27'), MONTH('2018-03-27'), DAY('2018-03-27'), DAY(EOMONTH('2018-03-11'));
----
2018 3 27 31

statement ok
CREATE TABLE dt_log_1988 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1988 VALUES (1, '2018-03-11'), (2, '2018-03-27');

query II
SELECT id, DATEDIFF(day, '2018-03-11', ev_date) FROM dt_log_1988 ORDER BY id;
----
1 0
2 16

statement ok
DROP TABLE dt_log_1988;
