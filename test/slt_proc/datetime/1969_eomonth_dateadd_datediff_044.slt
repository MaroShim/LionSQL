# test/slt_proc/datetime/1969_eomonth_dateadd_datediff_044.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (44)

query TTI
SELECT CAST(EOMONTH('2026-08-13') AS VARCHAR(10)), CAST(DATEADD(day, 22, '2026-08-13') AS VARCHAR(10)), DATEDIFF(day, '2026-08-13', '2026-09-04');
----
2026-08-31 2026-09-04 22

query IIII
SELECT YEAR('2026-09-04'), MONTH('2026-09-04'), DAY('2026-09-04'), DAY(EOMONTH('2026-08-13'));
----
2026 9 4 31

statement ok
CREATE TABLE dt_log_1969 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1969 VALUES (1, '2026-08-13'), (2, '2026-09-04');

query II
SELECT id, DATEDIFF(day, '2026-08-13', ev_date) FROM dt_log_1969 ORDER BY id;
----
1 0
2 22

statement ok
DROP TABLE dt_log_1969;
