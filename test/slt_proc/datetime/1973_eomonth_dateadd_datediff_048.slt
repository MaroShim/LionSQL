# test/slt_proc/datetime/1973_eomonth_dateadd_datediff_048.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (48)

query TTI
SELECT CAST(EOMONTH('2021-12-21') AS VARCHAR(10)), CAST(DATEADD(day, 26, '2021-12-21') AS VARCHAR(10)), DATEDIFF(day, '2021-12-21', '2022-01-16');
----
2021-12-31 2022-01-16 26

query IIII
SELECT YEAR('2022-01-16'), MONTH('2022-01-16'), DAY('2022-01-16'), DAY(EOMONTH('2021-12-21'));
----
2022 1 16 31

statement ok
CREATE TABLE dt_log_1973 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1973 VALUES (1, '2021-12-21'), (2, '2022-01-16');

query II
SELECT id, DATEDIFF(day, '2021-12-21', ev_date) FROM dt_log_1973 ORDER BY id;
----
1 0
2 26

statement ok
DROP TABLE dt_log_1973;
