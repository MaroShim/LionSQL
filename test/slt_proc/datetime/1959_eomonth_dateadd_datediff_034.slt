# test/slt_proc/datetime/1959_eomonth_dateadd_datediff_034.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (34)

query TTI
SELECT CAST(EOMONTH('2025-10-13') AS VARCHAR(10)), CAST(DATEADD(day, 12, '2025-10-13') AS VARCHAR(10)), DATEDIFF(day, '2025-10-13', '2025-10-25');
----
2025-10-31 2025-10-25 12

query IIII
SELECT YEAR('2025-10-25'), MONTH('2025-10-25'), DAY('2025-10-25'), DAY(EOMONTH('2025-10-13'));
----
2025 10 25 31

statement ok
CREATE TABLE dt_log_1959 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1959 VALUES (1, '2025-10-13'), (2, '2025-10-25');

query II
SELECT id, DATEDIFF(day, '2025-10-13', ev_date) FROM dt_log_1959 ORDER BY id;
----
1 0
2 12

statement ok
DROP TABLE dt_log_1959;
