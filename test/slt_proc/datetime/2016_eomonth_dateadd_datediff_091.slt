# test/slt_proc/datetime/2016_eomonth_dateadd_datediff_091.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (91)

query TTI
SELECT CAST(EOMONTH('2019-07-07') AS VARCHAR(10)), CAST(DATEADD(day, 19, '2019-07-07') AS VARCHAR(10)), DATEDIFF(day, '2019-07-07', '2019-07-26');
----
2019-07-31 2019-07-26 19

query IIII
SELECT YEAR('2019-07-26'), MONTH('2019-07-26'), DAY('2019-07-26'), DAY(EOMONTH('2019-07-07'));
----
2019 7 26 31

statement ok
CREATE TABLE dt_log_2016 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2016 VALUES (1, '2019-07-07'), (2, '2019-07-26');

query II
SELECT id, DATEDIFF(day, '2019-07-07', ev_date) FROM dt_log_2016 ORDER BY id;
----
1 0
2 19

statement ok
DROP TABLE dt_log_2016;
