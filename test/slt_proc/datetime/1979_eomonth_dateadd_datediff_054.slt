# test/slt_proc/datetime/1979_eomonth_dateadd_datediff_054.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (54)

query TTI
SELECT CAST(EOMONTH('2018-06-13') AS VARCHAR(10)), CAST(DATEADD(day, 7, '2018-06-13') AS VARCHAR(10)), DATEDIFF(day, '2018-06-13', '2018-06-20');
----
2018-06-30 2018-06-20 7

query IIII
SELECT YEAR('2018-06-20'), MONTH('2018-06-20'), DAY('2018-06-20'), DAY(EOMONTH('2018-06-13'));
----
2018 6 20 30

statement ok
CREATE TABLE dt_log_1979 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1979 VALUES (1, '2018-06-13'), (2, '2018-06-20');

query II
SELECT id, DATEDIFF(day, '2018-06-13', ev_date) FROM dt_log_1979 ORDER BY id;
----
1 0
2 7

statement ok
DROP TABLE dt_log_1979;
