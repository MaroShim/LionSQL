# test/slt_proc/datetime/2065_eomonth_dateadd_datediff_140.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (140)

query TTI
SELECT CAST(EOMONTH('2023-08-05') AS VARCHAR(10)), CAST(DATEADD(day, 18, '2023-08-05') AS VARCHAR(10)), DATEDIFF(day, '2023-08-05', '2023-08-23');
----
2023-08-31 2023-08-23 18

query IIII
SELECT YEAR('2023-08-23'), MONTH('2023-08-23'), DAY('2023-08-23'), DAY(EOMONTH('2023-08-05'));
----
2023 8 23 31

statement ok
CREATE TABLE dt_log_2065 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2065 VALUES (1, '2023-08-05'), (2, '2023-08-23');

query II
SELECT id, DATEDIFF(day, '2023-08-05', ev_date) FROM dt_log_2065 ORDER BY id;
----
1 0
2 18

statement ok
DROP TABLE dt_log_2065;
