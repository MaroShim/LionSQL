# test/slt_proc/datetime/1926_eomonth_dateadd_datediff_001.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (1)

query TTI
SELECT CAST(EOMONTH('2019-01-07') AS VARCHAR(10)), CAST(DATEADD(day, 4, '2019-01-07') AS VARCHAR(10)), DATEDIFF(day, '2019-01-07', '2019-01-11');
----
2019-01-31 2019-01-11 4

query IIII
SELECT YEAR('2019-01-11'), MONTH('2019-01-11'), DAY('2019-01-11'), DAY(EOMONTH('2019-01-07'));
----
2019 1 11 31

statement ok
CREATE TABLE dt_log_1926 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1926 VALUES (1, '2019-01-07'), (2, '2019-01-11');

query II
SELECT id, DATEDIFF(day, '2019-01-07', ev_date) FROM dt_log_1926 ORDER BY id;
----
1 0
2 4

statement ok
DROP TABLE dt_log_1926;
