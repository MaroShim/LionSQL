# test/slt_proc/datetime/1958_eomonth_dateadd_datediff_033.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (33)

query TTI
SELECT CAST(EOMONTH('2024-09-11') AS VARCHAR(10)), CAST(DATEADD(day, 11, '2024-09-11') AS VARCHAR(10)), DATEDIFF(day, '2024-09-11', '2024-09-22');
----
2024-09-30 2024-09-22 11

query IIII
SELECT YEAR('2024-09-22'), MONTH('2024-09-22'), DAY('2024-09-22'), DAY(EOMONTH('2024-09-11'));
----
2024 9 22 30

statement ok
CREATE TABLE dt_log_1958 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1958 VALUES (1, '2024-09-11'), (2, '2024-09-22');

query II
SELECT id, DATEDIFF(day, '2024-09-11', ev_date) FROM dt_log_1958 ORDER BY id;
----
1 0
2 11

statement ok
DROP TABLE dt_log_1958;
