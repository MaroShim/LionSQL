# test/slt_proc/datetime/2031_eomonth_dateadd_datediff_106.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (106)

query TTI
SELECT CAST(EOMONTH('2025-10-17') AS VARCHAR(10)), CAST(DATEADD(day, 9, '2025-10-17') AS VARCHAR(10)), DATEDIFF(day, '2025-10-17', '2025-10-26');
----
2025-10-31 2025-10-26 9

query IIII
SELECT YEAR('2025-10-26'), MONTH('2025-10-26'), DAY('2025-10-26'), DAY(EOMONTH('2025-10-17'));
----
2025 10 26 31

statement ok
CREATE TABLE dt_log_2031 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2031 VALUES (1, '2025-10-17'), (2, '2025-10-26');

query II
SELECT id, DATEDIFF(day, '2025-10-17', ev_date) FROM dt_log_2031 ORDER BY id;
----
1 0
2 9

statement ok
DROP TABLE dt_log_2031;
