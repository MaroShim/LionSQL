# test/slt_proc/datetime/2034_eomonth_dateadd_datediff_109.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (109)

query TTI
SELECT CAST(EOMONTH('2019-01-23') AS VARCHAR(10)), CAST(DATEADD(day, 12, '2019-01-23') AS VARCHAR(10)), DATEDIFF(day, '2019-01-23', '2019-02-04');
----
2019-01-31 2019-02-04 12

query IIII
SELECT YEAR('2019-02-04'), MONTH('2019-02-04'), DAY('2019-02-04'), DAY(EOMONTH('2019-01-23'));
----
2019 2 4 31

statement ok
CREATE TABLE dt_log_2034 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2034 VALUES (1, '2019-01-23'), (2, '2019-02-04');

query II
SELECT id, DATEDIFF(day, '2019-01-23', ev_date) FROM dt_log_2034 ORDER BY id;
----
1 0
2 12

statement ok
DROP TABLE dt_log_2034;
