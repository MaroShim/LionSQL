# test/slt_proc/datetime/091_datetime_calc_11.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (11)

query IIIT
SELECT YEAR('2026-11-12'), MONTH('2026-11-12'), DAY('2026-11-12'), DATENAME(month, '2026-11-12');
----
2026 11 12 November

query TT
SELECT EOMONTH('2026-11-12'), CONVERT(VARCHAR(10), DATEADD(day, 44, '2026-01-01'), 120);
----
2026-11-30 2026-02-14

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-02-14'), ISDATE('2026-11-12'), ISDATE('bad-date-11');
----
44 1 0
