# test/slt_proc/datetime/1970_eomonth_dateadd_datediff_045.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (45)

query TTI
SELECT CAST(EOMONTH('2018-09-15') AS VARCHAR(10)), CAST(DATEADD(day, 23, '2018-09-15') AS VARCHAR(10)), DATEDIFF(day, '2018-09-15', '2018-10-08');
----
2018-09-30 2018-10-08 23

query IIII
SELECT YEAR('2018-10-08'), MONTH('2018-10-08'), DAY('2018-10-08'), DAY(EOMONTH('2018-09-15'));
----
2018 10 8 30

statement ok
CREATE TABLE dt_log_1970 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1970 VALUES (1, '2018-09-15'), (2, '2018-10-08');

query II
SELECT id, DATEDIFF(day, '2018-09-15', ev_date) FROM dt_log_1970 ORDER BY id;
----
1 0
2 23

statement ok
DROP TABLE dt_log_1970;
