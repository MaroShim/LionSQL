# test/slt_proc/datetime/2062_eomonth_dateadd_datediff_137.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (137)

query TTI
SELECT CAST(EOMONTH('2020-05-19') AS VARCHAR(10)), CAST(DATEADD(day, 15, '2020-05-19') AS VARCHAR(10)), DATEDIFF(day, '2020-05-19', '2020-06-03');
----
2020-05-31 2020-06-03 15

query IIII
SELECT YEAR('2020-06-03'), MONTH('2020-06-03'), DAY('2020-06-03'), DAY(EOMONTH('2020-05-19'));
----
2020 6 3 31

statement ok
CREATE TABLE dt_log_2062 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2062 VALUES (1, '2020-05-19'), (2, '2020-06-03');

query II
SELECT id, DATEDIFF(day, '2020-05-19', ev_date) FROM dt_log_2062 ORDER BY id;
----
1 0
2 15

statement ok
DROP TABLE dt_log_2062;
