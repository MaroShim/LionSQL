# test/slt_proc/datetime/1962_eomonth_dateadd_datediff_037.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (37)

query TTI
SELECT CAST(EOMONTH('2019-01-19') AS VARCHAR(10)), CAST(DATEADD(day, 15, '2019-01-19') AS VARCHAR(10)), DATEDIFF(day, '2019-01-19', '2019-02-03');
----
2019-01-31 2019-02-03 15

query IIII
SELECT YEAR('2019-02-03'), MONTH('2019-02-03'), DAY('2019-02-03'), DAY(EOMONTH('2019-01-19'));
----
2019 2 3 31

statement ok
CREATE TABLE dt_log_1962 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1962 VALUES (1, '2019-01-19'), (2, '2019-02-03');

query II
SELECT id, DATEDIFF(day, '2019-01-19', ev_date) FROM dt_log_1962 ORDER BY id;
----
1 0
2 15

statement ok
DROP TABLE dt_log_1962;
