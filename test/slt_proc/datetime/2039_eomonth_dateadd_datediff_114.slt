# test/slt_proc/datetime/2039_eomonth_dateadd_datediff_114.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (114)

query TTI
SELECT CAST(EOMONTH('2024-06-13') AS VARCHAR(10)), CAST(DATEADD(day, 17, '2024-06-13') AS VARCHAR(10)), DATEDIFF(day, '2024-06-13', '2024-06-30');
----
2024-06-30 2024-06-30 17

query IIII
SELECT YEAR('2024-06-30'), MONTH('2024-06-30'), DAY('2024-06-30'), DAY(EOMONTH('2024-06-13'));
----
2024 6 30 30

statement ok
CREATE TABLE dt_log_2039 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2039 VALUES (1, '2024-06-13'), (2, '2024-06-30');

query II
SELECT id, DATEDIFF(day, '2024-06-13', ev_date) FROM dt_log_2039 ORDER BY id;
----
1 0
2 17

statement ok
DROP TABLE dt_log_2039;
