# test/slt_proc/datetime/832_datefromparts_datepart_22.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (22)

query TII
SELECT CAST(DATEFROMPARTS(2026, 10, 17) AS VARCHAR(10)), DATEPART(quarter, '2026-10-17'), DATEPART(dayofyear, '2026-10-17');
----
2026-10-17 4 290

query III
SELECT DATEDIFF(year, '2015-01-01', '2026-10-17'), DATEDIFF(month, '2026-01-01', '2026-10-17'), IIF('2026-10-17' >= '2020-01-01', 1, 0);
----
11 9 1

statement ok
CREATE PROCEDURE sp_dt_check_832 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_832 '2026-10-17', @q_out OUTPUT;
----
2026 10 17 4
