# test/slt_proc/datetime/835_datefromparts_datepart_25.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (25)

query TII
SELECT CAST(DATEFROMPARTS(2021, 1, 1) AS VARCHAR(10)), DATEPART(quarter, '2021-01-01'), DATEPART(dayofyear, '2021-01-01');
----
2021-01-01 1 1

query III
SELECT DATEDIFF(year, '2015-01-01', '2021-01-01'), DATEDIFF(month, '2021-01-01', '2021-01-01'), IIF('2021-01-01' >= '2020-01-01', 1, 0);
----
6 0 1

statement ok
CREATE PROCEDURE sp_dt_check_835 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_835 '2021-01-01', @q_out OUTPUT;
----
2021 1 1 1
