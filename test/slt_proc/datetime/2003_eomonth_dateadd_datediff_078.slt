# test/slt_proc/datetime/2003_eomonth_dateadd_datediff_078.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (78)

query TTI
SELECT CAST(EOMONTH('2024-06-21') AS VARCHAR(10)), CAST(DATEADD(day, 6, '2024-06-21') AS VARCHAR(10)), DATEDIFF(day, '2024-06-21', '2024-06-27');
----
2024-06-30 2024-06-27 6

query IIII
SELECT YEAR('2024-06-27'), MONTH('2024-06-27'), DAY('2024-06-27'), DAY(EOMONTH('2024-06-21'));
----
2024 6 27 30

statement ok
CREATE TABLE dt_log_2003 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2003 VALUES (1, '2024-06-21'), (2, '2024-06-27');

query II
SELECT id, DATEDIFF(day, '2024-06-21', ev_date) FROM dt_log_2003 ORDER BY id;
----
1 0
2 6

statement ok
DROP TABLE dt_log_2003;
