# test/slt_proc/datetime/1981_eomonth_dateadd_datediff_056.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (56)

query TTI
SELECT CAST(EOMONTH('2020-08-17') AS VARCHAR(10)), CAST(DATEADD(day, 9, '2020-08-17') AS VARCHAR(10)), DATEDIFF(day, '2020-08-17', '2020-08-26');
----
2020-08-31 2020-08-26 9

query IIII
SELECT YEAR('2020-08-26'), MONTH('2020-08-26'), DAY('2020-08-26'), DAY(EOMONTH('2020-08-17'));
----
2020 8 26 31

statement ok
CREATE TABLE dt_log_1981 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1981 VALUES (1, '2020-08-17'), (2, '2020-08-26');

query II
SELECT id, DATEDIFF(day, '2020-08-17', ev_date) FROM dt_log_1981 ORDER BY id;
----
1 0
2 9

statement ok
DROP TABLE dt_log_1981;
