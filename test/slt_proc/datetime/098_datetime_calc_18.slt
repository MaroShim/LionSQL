# test/slt_proc/datetime/098_datetime_calc_18.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (18)

query IIIT
SELECT YEAR('2021-06-19'), MONTH('2021-06-19'), DAY('2021-06-19'), DATENAME(month, '2021-06-19');
----
2021 6 19 June

query TT
SELECT EOMONTH('2021-06-19'), CONVERT(VARCHAR(10), DATEADD(day, 72, '2026-01-01'), 120);
----
2021-06-30 2026-03-14

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-14'), ISDATE('2021-06-19'), ISDATE('bad-date-18');
----
72 1 0
