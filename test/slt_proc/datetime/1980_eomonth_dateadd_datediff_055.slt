# test/slt_proc/datetime/1980_eomonth_dateadd_datediff_055.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (55)

query TTI
SELECT CAST(EOMONTH('2019-07-15') AS VARCHAR(10)), CAST(DATEADD(day, 8, '2019-07-15') AS VARCHAR(10)), DATEDIFF(day, '2019-07-15', '2019-07-23');
----
2019-07-31 2019-07-23 8

query IIII
SELECT YEAR('2019-07-23'), MONTH('2019-07-23'), DAY('2019-07-23'), DAY(EOMONTH('2019-07-15'));
----
2019 7 23 31

statement ok
CREATE TABLE dt_log_1980 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1980 VALUES (1, '2019-07-15'), (2, '2019-07-23');

query II
SELECT id, DATEDIFF(day, '2019-07-15', ev_date) FROM dt_log_1980 ORDER BY id;
----
1 0
2 8

statement ok
DROP TABLE dt_log_1980;
