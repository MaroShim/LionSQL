# test/slt_proc/datetime/1987_eomonth_dateadd_datediff_062.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (62)

query TTI
SELECT CAST(EOMONTH('2026-02-09') AS VARCHAR(10)), CAST(DATEADD(day, 15, '2026-02-09') AS VARCHAR(10)), DATEDIFF(day, '2026-02-09', '2026-02-24');
----
2026-02-28 2026-02-24 15

query IIII
SELECT YEAR('2026-02-24'), MONTH('2026-02-24'), DAY('2026-02-24'), DAY(EOMONTH('2026-02-09'));
----
2026 2 24 28

statement ok
CREATE TABLE dt_log_1987 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1987 VALUES (1, '2026-02-09'), (2, '2026-02-24');

query II
SELECT id, DATEDIFF(day, '2026-02-09', ev_date) FROM dt_log_1987 ORDER BY id;
----
1 0
2 15

statement ok
DROP TABLE dt_log_1987;
