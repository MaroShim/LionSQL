# test/slt_proc/datetime/099_datetime_calc_19.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (19)

query IIIT
SELECT YEAR('2022-07-20'), MONTH('2022-07-20'), DAY('2022-07-20'), DATENAME(month, '2022-07-20');
----
2022 7 20 July

query TT
SELECT EOMONTH('2022-07-20'), CONVERT(VARCHAR(10), DATEADD(day, 76, '2026-01-01'), 120);
----
2022-07-31 2026-03-18

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-03-18'), ISDATE('2022-07-20'), ISDATE('bad-date-19');
----
76 1 0
