# test/slt_proc/datetime/1930_eomonth_dateadd_datediff_005.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (5)

query TTI
SELECT CAST(EOMONTH('2023-05-15') AS VARCHAR(10)), CAST(DATEADD(day, 8, '2023-05-15') AS VARCHAR(10)), DATEDIFF(day, '2023-05-15', '2023-05-23');
----
2023-05-31 2023-05-23 8

query IIII
SELECT YEAR('2023-05-23'), MONTH('2023-05-23'), DAY('2023-05-23'), DAY(EOMONTH('2023-05-15'));
----
2023 5 23 31

statement ok
CREATE TABLE dt_log_1930 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1930 VALUES (1, '2023-05-15'), (2, '2023-05-23');

query II
SELECT id, DATEDIFF(day, '2023-05-15', ev_date) FROM dt_log_1930 ORDER BY id;
----
1 0
2 8

statement ok
DROP TABLE dt_log_1930;
