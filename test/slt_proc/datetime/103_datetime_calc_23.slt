# test/slt_proc/datetime/103_datetime_calc_23.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (23)

query IIIT
SELECT YEAR('2026-11-04'), MONTH('2026-11-04'), DAY('2026-11-04'), DATENAME(month, '2026-11-04');
----
2026 11 4 November

query TT
SELECT EOMONTH('2026-11-04'), CONVERT(VARCHAR(10), DATEADD(day, 92, '2026-01-01'), 120);
----
2026-11-30 2026-04-03

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-04-03'), ISDATE('2026-11-04'), ISDATE('bad-date-23');
----
92 1 0
