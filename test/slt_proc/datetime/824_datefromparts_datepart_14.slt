# test/slt_proc/datetime/824_datefromparts_datepart_14.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (14)

query TII
SELECT CAST(DATEFROMPARTS(2026, 2, 18) AS VARCHAR(10)), DATEPART(quarter, '2026-02-18'), DATEPART(dayofyear, '2026-02-18');
----
2026-02-18 1 49

query III
SELECT DATEDIFF(year, '2015-01-01', '2026-02-18'), DATEDIFF(month, '2026-01-01', '2026-02-18'), IIF('2026-02-18' >= '2020-01-01', 1, 0);
----
11 1 1

statement ok
CREATE PROCEDURE sp_dt_check_824 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_824 '2026-02-18', @q_out OUTPUT;
----
2026 2 18 1
