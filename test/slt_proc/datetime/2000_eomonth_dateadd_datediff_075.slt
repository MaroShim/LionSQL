# test/slt_proc/datetime/2000_eomonth_dateadd_datediff_075.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (75)

query TTI
SELECT CAST(EOMONTH('2021-03-15') AS VARCHAR(10)), CAST(DATEADD(day, 3, '2021-03-15') AS VARCHAR(10)), DATEDIFF(day, '2021-03-15', '2021-03-18');
----
2021-03-31 2021-03-18 3

query IIII
SELECT YEAR('2021-03-18'), MONTH('2021-03-18'), DAY('2021-03-18'), DAY(EOMONTH('2021-03-15'));
----
2021 3 18 31

statement ok
CREATE TABLE dt_log_2000 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2000 VALUES (1, '2021-03-15'), (2, '2021-03-18');

query II
SELECT id, DATEDIFF(day, '2021-03-15', ev_date) FROM dt_log_2000 ORDER BY id;
----
1 0
2 3

statement ok
DROP TABLE dt_log_2000;
