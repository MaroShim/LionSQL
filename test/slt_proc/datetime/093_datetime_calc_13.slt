# test/slt_proc/datetime/093_datetime_calc_13.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (13)

query IIIT
SELECT YEAR('2022-01-14'), MONTH('2022-01-14'), DAY('2022-01-14'), DATENAME(month, '2022-01-14');
----
2022 1 14 January

query TT
SELECT EOMONTH('2022-01-14'), CONVERT(VARCHAR(10), DATEADD(day, 52, '2026-01-01'), 120);
----
2022-01-31 2026-02-22

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-02-22'), ISDATE('2022-01-14'), ISDATE('bad-date-13');
----
52 1 0
