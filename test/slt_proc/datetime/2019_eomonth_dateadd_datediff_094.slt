# test/slt_proc/datetime/2019_eomonth_dateadd_datediff_094.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (94)

query TTI
SELECT CAST(EOMONTH('2022-10-13') AS VARCHAR(10)), CAST(DATEADD(day, 22, '2022-10-13') AS VARCHAR(10)), DATEDIFF(day, '2022-10-13', '2022-11-04');
----
2022-10-31 2022-11-04 22

query IIII
SELECT YEAR('2022-11-04'), MONTH('2022-11-04'), DAY('2022-11-04'), DAY(EOMONTH('2022-10-13'));
----
2022 11 4 31

statement ok
CREATE TABLE dt_log_2019 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2019 VALUES (1, '2022-10-13'), (2, '2022-11-04');

query II
SELECT id, DATEDIFF(day, '2022-10-13', ev_date) FROM dt_log_2019 ORDER BY id;
----
1 0
2 22

statement ok
DROP TABLE dt_log_2019;
