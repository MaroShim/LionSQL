# test/slt_proc/datetime/1985_eomonth_dateadd_datediff_060.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (60)

query TTI
SELECT CAST(EOMONTH('2024-12-05') AS VARCHAR(10)), CAST(DATEADD(day, 13, '2024-12-05') AS VARCHAR(10)), DATEDIFF(day, '2024-12-05', '2024-12-18');
----
2024-12-31 2024-12-18 13

query IIII
SELECT YEAR('2024-12-18'), MONTH('2024-12-18'), DAY('2024-12-18'), DAY(EOMONTH('2024-12-05'));
----
2024 12 18 31

statement ok
CREATE TABLE dt_log_1985 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1985 VALUES (1, '2024-12-05'), (2, '2024-12-18');

query II
SELECT id, DATEDIFF(day, '2024-12-05', ev_date) FROM dt_log_1985 ORDER BY id;
----
1 0
2 13

statement ok
DROP TABLE dt_log_1985;
