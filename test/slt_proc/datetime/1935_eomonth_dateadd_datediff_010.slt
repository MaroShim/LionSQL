# test/slt_proc/datetime/1935_eomonth_dateadd_datediff_010.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (10)

query TTI
SELECT CAST(EOMONTH('2019-10-05') AS VARCHAR(10)), CAST(DATEADD(day, 13, '2019-10-05') AS VARCHAR(10)), DATEDIFF(day, '2019-10-05', '2019-10-18');
----
2019-10-31 2019-10-18 13

query IIII
SELECT YEAR('2019-10-18'), MONTH('2019-10-18'), DAY('2019-10-18'), DAY(EOMONTH('2019-10-05'));
----
2019 10 18 31

statement ok
CREATE TABLE dt_log_1935 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1935 VALUES (1, '2019-10-05'), (2, '2019-10-18');

query II
SELECT id, DATEDIFF(day, '2019-10-05', ev_date) FROM dt_log_1935 ORDER BY id;
----
1 0
2 13

statement ok
DROP TABLE dt_log_1935;
