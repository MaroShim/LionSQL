# test/slt_proc/datetime/1955_eomonth_dateadd_datediff_030.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (30)

query TTI
SELECT CAST(EOMONTH('2021-06-05') AS VARCHAR(10)), CAST(DATEADD(day, 8, '2021-06-05') AS VARCHAR(10)), DATEDIFF(day, '2021-06-05', '2021-06-13');
----
2021-06-30 2021-06-13 8

query IIII
SELECT YEAR('2021-06-13'), MONTH('2021-06-13'), DAY('2021-06-13'), DAY(EOMONTH('2021-06-05'));
----
2021 6 13 30

statement ok
CREATE TABLE dt_log_1955 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1955 VALUES (1, '2021-06-05'), (2, '2021-06-13');

query II
SELECT id, DATEDIFF(day, '2021-06-05', ev_date) FROM dt_log_1955 ORDER BY id;
----
1 0
2 8

statement ok
DROP TABLE dt_log_1955;
