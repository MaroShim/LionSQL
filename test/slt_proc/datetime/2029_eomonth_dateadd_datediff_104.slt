# test/slt_proc/datetime/2029_eomonth_dateadd_datediff_104.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (104)

query TTI
SELECT CAST(EOMONTH('2023-08-13') AS VARCHAR(10)), CAST(DATEADD(day, 7, '2023-08-13') AS VARCHAR(10)), DATEDIFF(day, '2023-08-13', '2023-08-20');
----
2023-08-31 2023-08-20 7

query IIII
SELECT YEAR('2023-08-20'), MONTH('2023-08-20'), DAY('2023-08-20'), DAY(EOMONTH('2023-08-13'));
----
2023 8 20 31

statement ok
CREATE TABLE dt_log_2029 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2029 VALUES (1, '2023-08-13'), (2, '2023-08-20');

query II
SELECT id, DATEDIFF(day, '2023-08-13', ev_date) FROM dt_log_2029 ORDER BY id;
----
1 0
2 7

statement ok
DROP TABLE dt_log_2029;
