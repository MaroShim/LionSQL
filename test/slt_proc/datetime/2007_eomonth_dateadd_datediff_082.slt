# test/slt_proc/datetime/2007_eomonth_dateadd_datediff_082.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (82)

query TTI
SELECT CAST(EOMONTH('2019-10-09') AS VARCHAR(10)), CAST(DATEADD(day, 10, '2019-10-09') AS VARCHAR(10)), DATEDIFF(day, '2019-10-09', '2019-10-19');
----
2019-10-31 2019-10-19 10

query IIII
SELECT YEAR('2019-10-19'), MONTH('2019-10-19'), DAY('2019-10-19'), DAY(EOMONTH('2019-10-09'));
----
2019 10 19 31

statement ok
CREATE TABLE dt_log_2007 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2007 VALUES (1, '2019-10-09'), (2, '2019-10-19');

query II
SELECT id, DATEDIFF(day, '2019-10-09', ev_date) FROM dt_log_2007 ORDER BY id;
----
1 0
2 10

statement ok
DROP TABLE dt_log_2007;
