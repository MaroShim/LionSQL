# test/slt_proc/datetime/1931_eomonth_dateadd_datediff_006.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (6)

query TTI
SELECT CAST(EOMONTH('2024-06-17') AS VARCHAR(10)), CAST(DATEADD(day, 9, '2024-06-17') AS VARCHAR(10)), DATEDIFF(day, '2024-06-17', '2024-06-26');
----
2024-06-30 2024-06-26 9

query IIII
SELECT YEAR('2024-06-26'), MONTH('2024-06-26'), DAY('2024-06-26'), DAY(EOMONTH('2024-06-17'));
----
2024 6 26 30

statement ok
CREATE TABLE dt_log_1931 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1931 VALUES (1, '2024-06-17'), (2, '2024-06-26');

query II
SELECT id, DATEDIFF(day, '2024-06-17', ev_date) FROM dt_log_1931 ORDER BY id;
----
1 0
2 9

statement ok
DROP TABLE dt_log_1931;
