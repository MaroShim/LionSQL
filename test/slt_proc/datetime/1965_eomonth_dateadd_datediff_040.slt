# test/slt_proc/datetime/1965_eomonth_dateadd_datediff_040.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (40)

query TTI
SELECT CAST(EOMONTH('2022-04-05') AS VARCHAR(10)), CAST(DATEADD(day, 18, '2022-04-05') AS VARCHAR(10)), DATEDIFF(day, '2022-04-05', '2022-04-23');
----
2022-04-30 2022-04-23 18

query IIII
SELECT YEAR('2022-04-23'), MONTH('2022-04-23'), DAY('2022-04-23'), DAY(EOMONTH('2022-04-05'));
----
2022 4 23 30

statement ok
CREATE TABLE dt_log_1965 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1965 VALUES (1, '2022-04-05'), (2, '2022-04-23');

query II
SELECT id, DATEDIFF(day, '2022-04-05', ev_date) FROM dt_log_1965 ORDER BY id;
----
1 0
2 18

statement ok
DROP TABLE dt_log_1965;
