# test/slt_proc/datetime/2035_eomonth_dateadd_datediff_110.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (110)

query TTI
SELECT CAST(EOMONTH('2020-02-05') AS VARCHAR(10)), CAST(DATEADD(day, 13, '2020-02-05') AS VARCHAR(10)), DATEDIFF(day, '2020-02-05', '2020-02-18');
----
2020-02-29 2020-02-18 13

query IIII
SELECT YEAR('2020-02-18'), MONTH('2020-02-18'), DAY('2020-02-18'), DAY(EOMONTH('2020-02-05'));
----
2020 2 18 29

statement ok
CREATE TABLE dt_log_2035 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2035 VALUES (1, '2020-02-05'), (2, '2020-02-18');

query II
SELECT id, DATEDIFF(day, '2020-02-05', ev_date) FROM dt_log_2035 ORDER BY id;
----
1 0
2 13

statement ok
DROP TABLE dt_log_2035;
