# test/slt_proc/datetime/2020_eomonth_dateadd_datediff_095.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (95)

query TTI
SELECT CAST(EOMONTH('2023-11-15') AS VARCHAR(10)), CAST(DATEADD(day, 23, '2023-11-15') AS VARCHAR(10)), DATEDIFF(day, '2023-11-15', '2023-12-08');
----
2023-11-30 2023-12-08 23

query IIII
SELECT YEAR('2023-12-08'), MONTH('2023-12-08'), DAY('2023-12-08'), DAY(EOMONTH('2023-11-15'));
----
2023 12 8 30

statement ok
CREATE TABLE dt_log_2020 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2020 VALUES (1, '2023-11-15'), (2, '2023-12-08');

query II
SELECT id, DATEDIFF(day, '2023-11-15', ev_date) FROM dt_log_2020 ORDER BY id;
----
1 0
2 23

statement ok
DROP TABLE dt_log_2020;
