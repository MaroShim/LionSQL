# test/slt_proc/datetime/2041_eomonth_dateadd_datediff_116.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (116)

query TTI
SELECT CAST(EOMONTH('2026-08-17') AS VARCHAR(10)), CAST(DATEADD(day, 19, '2026-08-17') AS VARCHAR(10)), DATEDIFF(day, '2026-08-17', '2026-09-05');
----
2026-08-31 2026-09-05 19

query IIII
SELECT YEAR('2026-09-05'), MONTH('2026-09-05'), DAY('2026-09-05'), DAY(EOMONTH('2026-08-17'));
----
2026 9 5 31

statement ok
CREATE TABLE dt_log_2041 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2041 VALUES (1, '2026-08-17'), (2, '2026-09-05');

query II
SELECT id, DATEDIFF(day, '2026-08-17', ev_date) FROM dt_log_2041 ORDER BY id;
----
1 0
2 19

statement ok
DROP TABLE dt_log_2041;
