# test/slt_proc/datetime/083_datetime_calc_03.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (3)

query IIIT
SELECT YEAR('2024-03-04'), MONTH('2024-03-04'), DAY('2024-03-04'), DATENAME(month, '2024-03-04');
----
2024 3 4 March

query TT
SELECT EOMONTH('2024-03-04'), CONVERT(VARCHAR(10), DATEADD(day, 12, '2026-01-01'), 120);
----
2024-03-31 2026-01-13

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-01-13'), ISDATE('2024-03-04'), ISDATE('bad-date-3');
----
12 1 0
