# test/slt_proc/datetime/088_datetime_calc_08.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (8)

query IIIT
SELECT YEAR('2023-08-09'), MONTH('2023-08-09'), DAY('2023-08-09'), DATENAME(month, '2023-08-09');
----
2023 8 9 August

query TT
SELECT EOMONTH('2023-08-09'), CONVERT(VARCHAR(10), DATEADD(day, 32, '2026-01-01'), 120);
----
2023-08-31 2026-02-02

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-02-02'), ISDATE('2023-08-09'), ISDATE('bad-date-8');
----
32 1 0
