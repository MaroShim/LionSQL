# test/slt_proc/datetime/2036_eomonth_dateadd_datediff_111.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (111)

query TTI
SELECT CAST(EOMONTH('2021-03-07') AS VARCHAR(10)), CAST(DATEADD(day, 14, '2021-03-07') AS VARCHAR(10)), DATEDIFF(day, '2021-03-07', '2021-03-21');
----
2021-03-31 2021-03-21 14

query IIII
SELECT YEAR('2021-03-21'), MONTH('2021-03-21'), DAY('2021-03-21'), DAY(EOMONTH('2021-03-07'));
----
2021 3 21 31

statement ok
CREATE TABLE dt_log_2036 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2036 VALUES (1, '2021-03-07'), (2, '2021-03-21');

query II
SELECT id, DATEDIFF(day, '2021-03-07', ev_date) FROM dt_log_2036 ORDER BY id;
----
1 0
2 14

statement ok
DROP TABLE dt_log_2036;
