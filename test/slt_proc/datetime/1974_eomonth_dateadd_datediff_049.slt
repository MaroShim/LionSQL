# test/slt_proc/datetime/1974_eomonth_dateadd_datediff_049.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (49)

query TTI
SELECT CAST(EOMONTH('2022-01-23') AS VARCHAR(10)), CAST(DATEADD(day, 27, '2022-01-23') AS VARCHAR(10)), DATEDIFF(day, '2022-01-23', '2022-02-19');
----
2022-01-31 2022-02-19 27

query IIII
SELECT YEAR('2022-02-19'), MONTH('2022-02-19'), DAY('2022-02-19'), DAY(EOMONTH('2022-01-23'));
----
2022 2 19 31

statement ok
CREATE TABLE dt_log_1974 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1974 VALUES (1, '2022-01-23'), (2, '2022-02-19');

query II
SELECT id, DATEDIFF(day, '2022-01-23', ev_date) FROM dt_log_1974 ORDER BY id;
----
1 0
2 27

statement ok
DROP TABLE dt_log_1974;
