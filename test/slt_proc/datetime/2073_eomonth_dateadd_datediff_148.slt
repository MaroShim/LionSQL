# test/slt_proc/datetime/2073_eomonth_dateadd_datediff_148.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (148)

query TTI
SELECT CAST(EOMONTH('2022-04-21') AS VARCHAR(10)), CAST(DATEADD(day, 26, '2022-04-21') AS VARCHAR(10)), DATEDIFF(day, '2022-04-21', '2022-05-17');
----
2022-04-30 2022-05-17 26

query IIII
SELECT YEAR('2022-05-17'), MONTH('2022-05-17'), DAY('2022-05-17'), DAY(EOMONTH('2022-04-21'));
----
2022 5 17 30

statement ok
CREATE TABLE dt_log_2073 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2073 VALUES (1, '2022-04-21'), (2, '2022-05-17');

query II
SELECT id, DATEDIFF(day, '2022-04-21', ev_date) FROM dt_log_2073 ORDER BY id;
----
1 0
2 26

statement ok
DROP TABLE dt_log_2073;
