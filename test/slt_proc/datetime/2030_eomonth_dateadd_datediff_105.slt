# test/slt_proc/datetime/2030_eomonth_dateadd_datediff_105.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (105)

query TTI
SELECT CAST(EOMONTH('2024-09-15') AS VARCHAR(10)), CAST(DATEADD(day, 8, '2024-09-15') AS VARCHAR(10)), DATEDIFF(day, '2024-09-15', '2024-09-23');
----
2024-09-30 2024-09-23 8

query IIII
SELECT YEAR('2024-09-23'), MONTH('2024-09-23'), DAY('2024-09-23'), DAY(EOMONTH('2024-09-15'));
----
2024 9 23 30

statement ok
CREATE TABLE dt_log_2030 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2030 VALUES (1, '2024-09-15'), (2, '2024-09-23');

query II
SELECT id, DATEDIFF(day, '2024-09-15', ev_date) FROM dt_log_2030 ORDER BY id;
----
1 0
2 8

statement ok
DROP TABLE dt_log_2030;
