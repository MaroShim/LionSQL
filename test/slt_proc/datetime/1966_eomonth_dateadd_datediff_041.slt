# test/slt_proc/datetime/1966_eomonth_dateadd_datediff_041.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (41)

query TTI
SELECT CAST(EOMONTH('2023-05-07') AS VARCHAR(10)), CAST(DATEADD(day, 19, '2023-05-07') AS VARCHAR(10)), DATEDIFF(day, '2023-05-07', '2023-05-26');
----
2023-05-31 2023-05-26 19

query IIII
SELECT YEAR('2023-05-26'), MONTH('2023-05-26'), DAY('2023-05-26'), DAY(EOMONTH('2023-05-07'));
----
2023 5 26 31

statement ok
CREATE TABLE dt_log_1966 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1966 VALUES (1, '2023-05-07'), (2, '2023-05-26');

query II
SELECT id, DATEDIFF(day, '2023-05-07', ev_date) FROM dt_log_1966 ORDER BY id;
----
1 0
2 19

statement ok
DROP TABLE dt_log_1966;
