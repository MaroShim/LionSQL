# test/slt_proc/datetime/819_datefromparts_datepart_09.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (9)

query TII
SELECT CAST(DATEFROMPARTS(2021, 9, 3) AS VARCHAR(10)), DATEPART(quarter, '2021-09-03'), DATEPART(dayofyear, '2021-09-03');
----
2021-09-03 3 246

query III
SELECT DATEDIFF(year, '2015-01-01', '2021-09-03'), DATEDIFF(month, '2021-01-01', '2021-09-03'), IIF('2021-09-03' >= '2020-01-01', 1, 0);
----
6 8 1

statement ok
CREATE PROCEDURE sp_dt_check_819 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_819 '2021-09-03', @q_out OUTPUT;
----
2021 9 3 3
