# test/slt_proc/datetime/1956_eomonth_dateadd_datediff_031.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (31)

query TTI
SELECT CAST(EOMONTH('2022-07-07') AS VARCHAR(10)), CAST(DATEADD(day, 9, '2022-07-07') AS VARCHAR(10)), DATEDIFF(day, '2022-07-07', '2022-07-16');
----
2022-07-31 2022-07-16 9

query IIII
SELECT YEAR('2022-07-16'), MONTH('2022-07-16'), DAY('2022-07-16'), DAY(EOMONTH('2022-07-07'));
----
2022 7 16 31

statement ok
CREATE TABLE dt_log_1956 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1956 VALUES (1, '2022-07-07'), (2, '2022-07-16');

query II
SELECT id, DATEDIFF(day, '2022-07-07', ev_date) FROM dt_log_1956 ORDER BY id;
----
1 0
2 9

statement ok
DROP TABLE dt_log_1956;
