# test/slt_proc/datetime/2067_eomonth_dateadd_datediff_142.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (142)

query TTI
SELECT CAST(EOMONTH('2025-10-09') AS VARCHAR(10)), CAST(DATEADD(day, 20, '2025-10-09') AS VARCHAR(10)), DATEDIFF(day, '2025-10-09', '2025-10-29');
----
2025-10-31 2025-10-29 20

query IIII
SELECT YEAR('2025-10-29'), MONTH('2025-10-29'), DAY('2025-10-29'), DAY(EOMONTH('2025-10-09'));
----
2025 10 29 31

statement ok
CREATE TABLE dt_log_2067 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2067 VALUES (1, '2025-10-09'), (2, '2025-10-29');

query II
SELECT id, DATEDIFF(day, '2025-10-09', ev_date) FROM dt_log_2067 ORDER BY id;
----
1 0
2 20

statement ok
DROP TABLE dt_log_2067;
