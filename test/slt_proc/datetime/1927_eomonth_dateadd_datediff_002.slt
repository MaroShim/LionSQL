# test/slt_proc/datetime/1927_eomonth_dateadd_datediff_002.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (2)

query TTI
SELECT CAST(EOMONTH('2020-02-09') AS VARCHAR(10)), CAST(DATEADD(day, 5, '2020-02-09') AS VARCHAR(10)), DATEDIFF(day, '2020-02-09', '2020-02-14');
----
2020-02-29 2020-02-14 5

query IIII
SELECT YEAR('2020-02-14'), MONTH('2020-02-14'), DAY('2020-02-14'), DAY(EOMONTH('2020-02-09'));
----
2020 2 14 29

statement ok
CREATE TABLE dt_log_1927 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1927 VALUES (1, '2020-02-09'), (2, '2020-02-14');

query II
SELECT id, DATEDIFF(day, '2020-02-09', ev_date) FROM dt_log_1927 ORDER BY id;
----
1 0
2 5

statement ok
DROP TABLE dt_log_1927;
