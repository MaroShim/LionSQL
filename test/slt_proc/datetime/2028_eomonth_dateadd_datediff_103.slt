# test/slt_proc/datetime/2028_eomonth_dateadd_datediff_103.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (103)

query TTI
SELECT CAST(EOMONTH('2022-07-11') AS VARCHAR(10)), CAST(DATEADD(day, 6, '2022-07-11') AS VARCHAR(10)), DATEDIFF(day, '2022-07-11', '2022-07-17');
----
2022-07-31 2022-07-17 6

query IIII
SELECT YEAR('2022-07-17'), MONTH('2022-07-17'), DAY('2022-07-17'), DAY(EOMONTH('2022-07-11'));
----
2022 7 17 31

statement ok
CREATE TABLE dt_log_2028 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2028 VALUES (1, '2022-07-11'), (2, '2022-07-17');

query II
SELECT id, DATEDIFF(day, '2022-07-11', ev_date) FROM dt_log_2028 ORDER BY id;
----
1 0
2 6

statement ok
DROP TABLE dt_log_2028;
