# test/slt_proc/datetime/1990_eomonth_dateadd_datediff_065.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (65)

query TTI
SELECT CAST(EOMONTH('2020-05-15') AS VARCHAR(10)), CAST(DATEADD(day, 18, '2020-05-15') AS VARCHAR(10)), DATEDIFF(day, '2020-05-15', '2020-06-02');
----
2020-05-31 2020-06-02 18

query IIII
SELECT YEAR('2020-06-02'), MONTH('2020-06-02'), DAY('2020-06-02'), DAY(EOMONTH('2020-05-15'));
----
2020 6 2 31

statement ok
CREATE TABLE dt_log_1990 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1990 VALUES (1, '2020-05-15'), (2, '2020-06-02');

query II
SELECT id, DATEDIFF(day, '2020-05-15', ev_date) FROM dt_log_1990 ORDER BY id;
----
1 0
2 18

statement ok
DROP TABLE dt_log_1990;
