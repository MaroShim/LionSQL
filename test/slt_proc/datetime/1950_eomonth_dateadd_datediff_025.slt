# test/slt_proc/datetime/1950_eomonth_dateadd_datediff_025.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (25)

query TTI
SELECT CAST(EOMONTH('2025-01-15') AS VARCHAR(10)), CAST(DATEADD(day, 3, '2025-01-15') AS VARCHAR(10)), DATEDIFF(day, '2025-01-15', '2025-01-18');
----
2025-01-31 2025-01-18 3

query IIII
SELECT YEAR('2025-01-18'), MONTH('2025-01-18'), DAY('2025-01-18'), DAY(EOMONTH('2025-01-15'));
----
2025 1 18 31

statement ok
CREATE TABLE dt_log_1950 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1950 VALUES (1, '2025-01-15'), (2, '2025-01-18');

query II
SELECT id, DATEDIFF(day, '2025-01-15', ev_date) FROM dt_log_1950 ORDER BY id;
----
1 0
2 3

statement ok
DROP TABLE dt_log_1950;
