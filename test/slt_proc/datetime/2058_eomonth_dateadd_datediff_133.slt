# test/slt_proc/datetime/2058_eomonth_dateadd_datediff_133.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (133)

query TTI
SELECT CAST(EOMONTH('2025-01-11') AS VARCHAR(10)), CAST(DATEADD(day, 11, '2025-01-11') AS VARCHAR(10)), DATEDIFF(day, '2025-01-11', '2025-01-22');
----
2025-01-31 2025-01-22 11

query IIII
SELECT YEAR('2025-01-22'), MONTH('2025-01-22'), DAY('2025-01-22'), DAY(EOMONTH('2025-01-11'));
----
2025 1 22 31

statement ok
CREATE TABLE dt_log_2058 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2058 VALUES (1, '2025-01-11'), (2, '2025-01-22');

query II
SELECT id, DATEDIFF(day, '2025-01-11', ev_date) FROM dt_log_2058 ORDER BY id;
----
1 0
2 11

statement ok
DROP TABLE dt_log_2058;
