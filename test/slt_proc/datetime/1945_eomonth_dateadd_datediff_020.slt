# test/slt_proc/datetime/1945_eomonth_dateadd_datediff_020.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (20)

query TTI
SELECT CAST(EOMONTH('2020-08-05') AS VARCHAR(10)), CAST(DATEADD(day, 23, '2020-08-05') AS VARCHAR(10)), DATEDIFF(day, '2020-08-05', '2020-08-28');
----
2020-08-31 2020-08-28 23

query IIII
SELECT YEAR('2020-08-28'), MONTH('2020-08-28'), DAY('2020-08-28'), DAY(EOMONTH('2020-08-05'));
----
2020 8 28 31

statement ok
CREATE TABLE dt_log_1945 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1945 VALUES (1, '2020-08-05'), (2, '2020-08-28');

query II
SELECT id, DATEDIFF(day, '2020-08-05', ev_date) FROM dt_log_1945 ORDER BY id;
----
1 0
2 23

statement ok
DROP TABLE dt_log_1945;
