# test/slt_proc/datetime/1951_eomonth_dateadd_datediff_026.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (26)

query TTI
SELECT CAST(EOMONTH('2026-02-17') AS VARCHAR(10)), CAST(DATEADD(day, 4, '2026-02-17') AS VARCHAR(10)), DATEDIFF(day, '2026-02-17', '2026-02-21');
----
2026-02-28 2026-02-21 4

query IIII
SELECT YEAR('2026-02-21'), MONTH('2026-02-21'), DAY('2026-02-21'), DAY(EOMONTH('2026-02-17'));
----
2026 2 21 28

statement ok
CREATE TABLE dt_log_1951 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1951 VALUES (1, '2026-02-17'), (2, '2026-02-21');

query II
SELECT id, DATEDIFF(day, '2026-02-17', ev_date) FROM dt_log_1951 ORDER BY id;
----
1 0
2 4

statement ok
DROP TABLE dt_log_1951;
