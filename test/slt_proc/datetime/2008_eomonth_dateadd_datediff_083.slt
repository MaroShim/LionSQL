# test/slt_proc/datetime/2008_eomonth_dateadd_datediff_083.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (83)

query TTI
SELECT CAST(EOMONTH('2020-11-11') AS VARCHAR(10)), CAST(DATEADD(day, 11, '2020-11-11') AS VARCHAR(10)), DATEDIFF(day, '2020-11-11', '2020-11-22');
----
2020-11-30 2020-11-22 11

query IIII
SELECT YEAR('2020-11-22'), MONTH('2020-11-22'), DAY('2020-11-22'), DAY(EOMONTH('2020-11-11'));
----
2020 11 22 30

statement ok
CREATE TABLE dt_log_2008 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2008 VALUES (1, '2020-11-11'), (2, '2020-11-22');

query II
SELECT id, DATEDIFF(day, '2020-11-11', ev_date) FROM dt_log_2008 ORDER BY id;
----
1 0
2 11

statement ok
DROP TABLE dt_log_2008;
