# test/slt_proc/datetime/1928_eomonth_dateadd_datediff_003.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (3)

query TTI
SELECT CAST(EOMONTH('2021-03-11') AS VARCHAR(10)), CAST(DATEADD(day, 6, '2021-03-11') AS VARCHAR(10)), DATEDIFF(day, '2021-03-11', '2021-03-17');
----
2021-03-31 2021-03-17 6

query IIII
SELECT YEAR('2021-03-17'), MONTH('2021-03-17'), DAY('2021-03-17'), DAY(EOMONTH('2021-03-11'));
----
2021 3 17 31

statement ok
CREATE TABLE dt_log_1928 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1928 VALUES (1, '2021-03-11'), (2, '2021-03-17');

query II
SELECT id, DATEDIFF(day, '2021-03-11', ev_date) FROM dt_log_1928 ORDER BY id;
----
1 0
2 6

statement ok
DROP TABLE dt_log_1928;
