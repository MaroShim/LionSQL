# test/slt_proc/datetime/082_datetime_calc_02.slt
# T-SQL YEAR/MONTH/DAY/DATENAME/EOMONTH/DATEADD/DATEDIFF (2)

query IIIT
SELECT YEAR('2023-02-03'), MONTH('2023-02-03'), DAY('2023-02-03'), DATENAME(month, '2023-02-03');
----
2023 2 3 February

query TT
SELECT EOMONTH('2023-02-03'), CONVERT(VARCHAR(10), DATEADD(day, 8, '2026-01-01'), 120);
----
2023-02-28 2026-01-09

query III
SELECT DATEDIFF(day, '2026-01-01', '2026-01-09'), ISDATE('2023-02-03'), ISDATE('bad-date-2');
----
8 1 0
