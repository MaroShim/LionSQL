# test/slt_proc/datetime/2060_eomonth_dateadd_datediff_135.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (135)

query TTI
SELECT CAST(EOMONTH('2018-03-15') AS VARCHAR(10)), CAST(DATEADD(day, 13, '2018-03-15') AS VARCHAR(10)), DATEDIFF(day, '2018-03-15', '2018-03-28');
----
2018-03-31 2018-03-28 13

query IIII
SELECT YEAR('2018-03-28'), MONTH('2018-03-28'), DAY('2018-03-28'), DAY(EOMONTH('2018-03-15'));
----
2018 3 28 31

statement ok
CREATE TABLE dt_log_2060 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2060 VALUES (1, '2018-03-15'), (2, '2018-03-28');

query II
SELECT id, DATEDIFF(day, '2018-03-15', ev_date) FROM dt_log_2060 ORDER BY id;
----
1 0
2 13

statement ok
DROP TABLE dt_log_2060;
