# test/slt_proc/datetime/830_datefromparts_datepart_20.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (20)

query TII
SELECT CAST(DATEFROMPARTS(2024, 8, 11) AS VARCHAR(10)), DATEPART(quarter, '2024-08-11'), DATEPART(dayofyear, '2024-08-11');
----
2024-08-11 3 224

query III
SELECT DATEDIFF(year, '2015-01-01', '2024-08-11'), DATEDIFF(month, '2024-01-01', '2024-08-11'), IIF('2024-08-11' >= '2020-01-01', 1, 0);
----
9 7 1

statement ok
CREATE PROCEDURE sp_dt_check_830 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_830 '2024-08-11', @q_out OUTPUT;
----
2024 8 11 3
