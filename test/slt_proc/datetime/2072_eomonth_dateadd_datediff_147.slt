# test/slt_proc/datetime/2072_eomonth_dateadd_datediff_147.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (147)

query TTI
SELECT CAST(EOMONTH('2021-03-19') AS VARCHAR(10)), CAST(DATEADD(day, 25, '2021-03-19') AS VARCHAR(10)), DATEDIFF(day, '2021-03-19', '2021-04-13');
----
2021-03-31 2021-04-13 25

query IIII
SELECT YEAR('2021-04-13'), MONTH('2021-04-13'), DAY('2021-04-13'), DAY(EOMONTH('2021-03-19'));
----
2021 4 13 31

statement ok
CREATE TABLE dt_log_2072 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_2072 VALUES (1, '2021-03-19'), (2, '2021-04-13');

query II
SELECT id, DATEDIFF(day, '2021-03-19', ev_date) FROM dt_log_2072 ORDER BY id;
----
1 0
2 25

statement ok
DROP TABLE dt_log_2072;
