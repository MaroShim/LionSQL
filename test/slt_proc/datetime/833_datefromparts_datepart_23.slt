# test/slt_proc/datetime/833_datefromparts_datepart_23.slt
# T-SQL DATEFROMPARTS, DATEPART(quarter/dayofyear), DATEDIFF month/year (23)

query TII
SELECT CAST(DATEFROMPARTS(2027, 11, 20) AS VARCHAR(10)), DATEPART(quarter, '2027-11-20'), DATEPART(dayofyear, '2027-11-20');
----
2027-11-20 4 324

query III
SELECT DATEDIFF(year, '2015-01-01', '2027-11-20'), DATEDIFF(month, '2027-01-01', '2027-11-20'), IIF('2027-11-20' >= '2020-01-01', 1, 0);
----
12 10 1

statement ok
CREATE PROCEDURE sp_dt_check_833 @dt VARCHAR(20), @q INT OUTPUT
AS
BEGIN
    SET @q = DATEPART(quarter, @dt);
    SELECT YEAR(@dt), MONTH(@dt), DAY(@dt), @q;
END;

query IIII
DECLARE @q_out INT;
EXEC sp_dt_check_833 '2027-11-20', @q_out OUTPUT;
----
2027 11 20 4
