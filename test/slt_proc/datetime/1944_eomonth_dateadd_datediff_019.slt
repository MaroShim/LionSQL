# test/slt_proc/datetime/1944_eomonth_dateadd_datediff_019.slt
# T-SQL EOMONTH, DATEADD(day), DATEDIFF(day), YEAR/MONTH/DAY (19)

query TTI
SELECT CAST(EOMONTH('2019-07-23') AS VARCHAR(10)), CAST(DATEADD(day, 22, '2019-07-23') AS VARCHAR(10)), DATEDIFF(day, '2019-07-23', '2019-08-14');
----
2019-07-31 2019-08-14 22

query IIII
SELECT YEAR('2019-08-14'), MONTH('2019-08-14'), DAY('2019-08-14'), DAY(EOMONTH('2019-07-23'));
----
2019 8 14 31

statement ok
CREATE TABLE dt_log_1944 (id INT PRIMARY KEY, ev_date VARCHAR(20));

statement ok
INSERT INTO dt_log_1944 VALUES (1, '2019-07-23'), (2, '2019-08-14');

query II
SELECT id, DATEDIFF(day, '2019-07-23', ev_date) FROM dt_log_1944 ORDER BY id;
----
1 0
2 22

statement ok
DROP TABLE dt_log_1944;
