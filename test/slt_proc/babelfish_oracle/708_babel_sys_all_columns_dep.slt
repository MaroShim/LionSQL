statement ok
CREATE PROCEDURE sys_all_columns_dep_vu_prepare_proc1
AS
    SELECT name, is_nullable, column_id 
    FROM sys.all_columns 
    WHERE name in ('sac_int_col1', 'sac_text_col_not_null1') ORDER BY name;

