query TT
SELECT [primary],
    CASE
        WHEN [primary] = 1 THEN 'One'
        WHEN [primary] = 2 THEN 'Two'
        ELSE 'Other'
    END AS PrimaryDescription
FROM babel_5422_table;
----
1 One
2 Two
3 Other

query T
SELECT Name
FROM babel_5422_table
WHERE [primary] IN (SELECT [primary] FROM babel_5422_table2);
