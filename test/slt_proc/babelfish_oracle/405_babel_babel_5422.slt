statement ok
CREATE PROCEDURE babel_5422_proc
    @PrimaryKey INT
AS
BEGIN
    SELECT [primary], Name
    FROM babel_5422_table
    WHERE [primary] = @PrimaryKey;
END

query TT
EXEC babel_5422_proc 2;
----
2 Jane

statement ok
CREATE FUNCTION babel_5422_func
    (@PrimaryKey INT)
RETURNS TABLE
AS
RETURN(
    SELECT [primary], Name
    FROM babel_5422_table
    WHERE [primary] = @PrimaryKey
)

