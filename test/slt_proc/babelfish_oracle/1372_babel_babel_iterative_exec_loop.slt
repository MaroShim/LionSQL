DECLARE @Counter1 INT 
DECLARE @Counter2 INT 
SET @Counter1 = 1
SET @Counter2 = 10
WHILE ( @Counter1 <= 5)
BEGIN
	SELECT @Counter1
	WHILE ( @Counter2 < 13)
	BEGIN
		SELECT @Counter2
		SET @Counter2  = @Counter2  + 1
	END
	SET @Counter1  = @Counter1  + 1
END

