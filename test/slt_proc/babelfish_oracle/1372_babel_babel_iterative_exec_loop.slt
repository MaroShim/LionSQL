statement ok
DECLARE @Counter INT
SET @Counter=1
WHILE ( @Counter <= 10)
BEGIN
	SELECT @Counter
	SET @Counter  = @Counter  + 1
END

statement ok
DECLARE @Counter INT 
SET @Counter=1
WHILE ( @Counter <= 10)
BEGIN
	if @Counter / 2 = 1
	BEGIN
		SET @Counter  = @Counter  + 1
		CONTINUE
	END
	SELECT @Counter 
	SET @Counter  = @Counter  + 1
END

