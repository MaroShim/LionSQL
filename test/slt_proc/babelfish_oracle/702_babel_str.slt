statement ok
CREATE VIEW str_v1 AS
SELECT 
    ID,
    NumberValue,
    Length,
    Decimal,
    STR(NumberValue, Length, Decimal) AS FormattedValue,
    ExpectedOutput,
    CASE 
        WHEN STR(NumberValue, Length, Decimal) = ExpectedOutput THEN 'Pass'
        ELSE 'Fail'
    END AS TestResult
FROM str_t1;

statement ok
CREATE VIEW str_v2 AS
SELECT 
    ID,
    NumberValue,
    Length,
    Decimal,
    STR(NumberValue, Length, Decimal) AS FormattedValue,
    ExpectedOutput,
    CASE 
        WHEN STR(NumberValue, Length, Decimal) = ExpectedOutput THEN 'Pass'
        ELSE 'Fail'
    END AS TestResult
FROM str_t2;

statement ok
CREATE FUNCTION str_fn_formatnumber
(
    @Number DECIMAL(18,6),
    @MinWidth INT,
    @MaxWidth INT,
    @Decimals INT
)
RETURNS VARCHAR(100)
AS
BEGIN
    DECLARE @Result VARCHAR(100);
    DECLARE @CurrentWidth INT = @MinWidth;
    WHILE @CurrentWidth <= @MaxWidth
    BEGIN
        SET @Result = STR(@Number, @CurrentWidth, @Decimals);
        IF @Result NOT LIKE '*%'
            BREAK;
        SET @CurrentWidth = @CurrentWidth + 1;
    END
    RETURN @Result;
END;

statement ok
CREATE FUNCTION str_fn_formatcalculation
(
    @Value1 DECIMAL(18,6),
    @Value2 DECIMAL(18,6),
    @Operation CHAR(1)
)
RETURNS TABLE
AS
RETURN
(
    SELECT
        CASE @Operation
            WHEN '+' THEN STR(@Value1 + @Value2, 20, 2)
            WHEN '-' THEN STR(@Value1 - @Value2, 20, 2)
            WHEN '*' THEN STR(@Value1 * @Value2, 20, 2)
            WHEN '/' THEN STR(@Value1 / NULLIF(@Value2, 0), 20, 4)
            ELSE NULL
        END AS Result
);

statement ok
CREATE PROCEDURE str_sp_formatnumber
    @Number DECIMAL(18,6),
    @MinDecimals INT = 0,
    @MaxDecimals INT = 6
AS
BEGIN
    DECLARE @CurrentDecimals INT = @MinDecimals;
    WHILE @CurrentDecimals <= @MaxDecimals
    BEGIN
        SELECT 
            @CurrentDecimals AS Decimals,
            STR(@Number, 20, @CurrentDecimals) AS FormattedValue;
        SET @CurrentDecimals = @CurrentDecimals + 1;
    END
END;

statement ok
CREATE PROCEDURE str_sp_compareformats
    @Number DECIMAL(18,6)
AS
BEGIN
    SELECT 
        'Default' AS Format,
        STR(@Number) AS Result
    UNION ALL
    SELECT 
        '10,2',
        STR(@Number, 10, 2)
    UNION ALL
    SELECT
        '15,4',
        STR(@Number, 15, 4)
    UNION ALL
    SELECT
        '20,6',
        STR(@Number, 20, 6)
    ORDER BY Format;
END;

statement ok
CREATE TABLE str_computed_t1 (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    NumberValue DECIMAL(18,6),
    DefaultFormat AS STR(NumberValue) PERSISTED,
    Format102 AS STR(NumberValue, 10, 2) PERSISTED,
    Format154 AS STR(NumberValue, 15, 4) PERSISTED,
    IsOverflow AS CASE WHEN STR(NumberValue, 5, 2) LIKE '*%' THEN 1 ELSE 0 END PERSISTED
);

