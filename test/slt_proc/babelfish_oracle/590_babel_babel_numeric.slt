CREATE TABLE decimal_test (
    id INT,
    value1 DECIMAL(10,2),
    value2 DECIMAL(15,4),
    category INT
)

statement ok
INSERT INTO decimal_test VALUES
(1, 123.45, 123.4567, 1),
(1, 234.56, 234.5678, 1),
(2, 345.67, 345.6789, 2),
(2, 456.78, 456.7890, 2),
(3, 567.89, 567.8901, 1)

statement ok
SELECT
    AVG(value1) as avg_value1,
    AVG(value2) as avg_value2,
    AVG(value1) * 1.000 as avg_value1_mul
INTO avg_results
FROM decimal_test
GROUP BY id

query TTTT
select
    COLUMN_NAME,
    NUMERIC_PRECISION,
    NUMERIC_PRECISION_RADIX,
    NUMERIC_SCALE
from information_schema.columns
where
table_name IN ('avg_results')
ORDER BY COLUMN_NAME;
----
_row_id 32 2 0
avg_value1 NULL NULL NULL
avg_value1_mul 53 2 NULL
avg_value2 NULL NULL NULL

statement ok
SELECT
    SUM(value1) as sum_value1,
    SUM(value2) as sum_value2,
    SUM(value2) / 1.0000 as sum_value2_div
INTO sum_results
FROM decimal_test
GROUP BY category

