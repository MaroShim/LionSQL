statement ok
SELECT
    MAX(value1) - MIN(value1) as value1_range,
    MAX(value2) - MIN(value2) as value2_range,
    MAX(value2) * MIN(value2) as value2_product
INTO range_results
FROM decimal_test
GROUP BY id

