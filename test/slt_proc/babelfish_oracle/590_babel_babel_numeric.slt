CREATE TABLE BABEL_6081_t2 (id NUMERIC(4, 2));

statement ok
INSERT INTO BABEL_6081_t2 VALUES (1.0)

statement ok
WITH 
cte1 AS ( 
    SELECT id, CAST(id AS INT) AS int_id 
    FROM BABEL_6081_t2 
), 
cte2 AS ( 
    SELECT DISTINCT int_id 
    FROM cte1 
) 
SELECT 
    c1.id * avg(c2.int_id) AS product 
    INTO 
        BABEL_6081_t3 
FROM cte1 c1 
JOIN cte2 c2 ON c1.int_id = c2.int_id 
GROUP BY c1.id; 

