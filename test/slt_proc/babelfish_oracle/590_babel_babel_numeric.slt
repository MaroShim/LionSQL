statement ok
SELECT
    COUNT(*) as count,
    SUM(value1) as sum1,
    AVG(value1) as avg1,
    MIN(value1) as min1,
    MAX(value1) as max1,
    COUNT(*) * AVG(value1) * 1.0000 as count_mul
INTO multi_agg_results
FROM decimal_test
GROUP BY category

