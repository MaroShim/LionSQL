statement ok
SELECT
    SUM(value1)/COUNT(*) as manual_avg1,
    AVG(value1) as builtin_avg1,
    SUM(value2)/COUNT(*) as manual_avg2,
    AVG(value2) as builtin_avg2
INTO precision_test
FROM decimal_test
GROUP BY id

