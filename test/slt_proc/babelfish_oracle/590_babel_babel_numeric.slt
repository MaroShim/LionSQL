statement ok
SELECT
    SUM(value1 * value2) as product_sum,
    AVG(value1 * value2) as product_avg,
    SUM(value1) * SUM(value2) / 1.0000 as product_sum_div
INTO calc_results
FROM decimal_test
GROUP BY id

