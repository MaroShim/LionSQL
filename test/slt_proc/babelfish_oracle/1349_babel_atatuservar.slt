create function f1_del_atatuservar(@@p1 int)
returns int
as
begin
	declare @@tv table(a int)
    insert @@tv values(@@p1)
    update @@tv set a = a + 1
    insert @@tv values(@@p1)
    update @@tv set a = a + 1
    delete @@tv where a = 124
    return (select sum(a) from @@tv)
end

