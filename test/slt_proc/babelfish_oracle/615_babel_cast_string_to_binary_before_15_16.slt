# test/slt_proc/babelfish_oracle/615_babel_cast_string_to_binary_before_15_16.slt
# Babelfish Oracle Suite harvested from test/babelfish/raw/cast_string_to_binary-before-15_16-vu-prepare.sql, test/babelfish/raw/cast_string_to_binary-before-15_16-vu-verify.sql, test/babelfish/raw/cast_string_to_binary-before-15_16-vu-cleanup.sql

statement ok
CREATE SCHEMA test_str_bin_conversion;

statement ok
CREATE TABLE test_str_bin_conversion.string_to_varbinary_test (
    id INT IDENTITY(1,1) PRIMARY KEY,
    c CHAR(13),
    n NCHAR(13),
    v VARCHAR(13),
    nv NVARCHAR(13)
);

statement ok
INSERT INTO test_str_bin_conversion.string_to_varbinary_test (c, n, v, nv) VALUES
('Hello, World!', N'Hello, World!', 'Hello, World!', N'Hello, World!'),
('abc', N'abc', 'abc', N'abc'),
('1234567890123', N'1234567890123', '1234567890123', N'1234567890123'),
('é', N'é', 'é', N'é'),
('', N'', '', N''),                  -- Empty
(' ', N' ', ' ', N' '),              -- Space
('😀', N'😀', '😀', N'😀'),         -- Emoji
('中文', N'中文', '中文', N'中文'),  -- Chinese characters
('ÿ', N'ÿ', 'ÿ', N'ÿ'),              -- Latin-1 extended
('A', N'A', 'A', N'A'),
('Z', N'Z', 'Z', N'Z'),
('a', N'a', 'a', N'a'),
('z', N'z', 'z', N'z'),
('...', N'...', '...', N'...'),
('DEADBEEF', N'DEADBEEF', 'DEADBEEF', N'DEADBEEF'),
('CAFEBABE', N'CAFEBABE', 'CAFEBABE', N'CAFEBABE'),
('𝄞', N'𝄞', '𝄞', N'𝄞'),             -- Musical symbol (surrogate pair)
(REPLICATE('A',13), REPLICATE(N'A',13), REPLICATE('A',13), REPLICATE(N'A',13)),
(REPLICATE(' ',13), REPLICATE(N' ',13), REPLICATE(' ',13), REPLICATE(N' ',13)),
('0123456789', N'0123456789', '0123456789', N'0123456789'),
('...', N'...', '...', N'...'),
('𝕬𝕭𝕮', N'𝕬𝕭𝕮', '𝕬𝕭𝕮', N'𝕬𝕭𝕮'), -- Gothic math bold
('foo\nbar', N'foo'+NCHAR(10)+'bar', 'foo\nbar', N'foo'+NCHAR(10)+'bar'), -- With newline
('tab'+CHAR(9)+'end', N'tab'+NCHAR(9)+'end', 'tab'+CHAR(9)+'end', N'tab'+NCHAR(9)+'end') -- With tab
;

statement ok
INSERT INTO test_str_bin_conversion.string_to_varbinary_test (c, n, v, nv) VALUES
(CHAR(0), NCHAR(0), CHAR(0), NCHAR(0)) -- Null character
;

statement ok
INSERT INTO test_str_bin_conversion.string_to_varbinary_test (c, n, v, nv) VALUES
('TES'+CHAR(0)+'T', N'TES'+NCHAR(0)+'T', 'TES'+CHAR(0)+'T', N'TES'+NCHAR(0)+'T'); -- Null in middle
;

statement ok
CREATE VIEW test_str_bin_conversion.v_varbinary_cast
AS
	SELECT id,
		CAST(c AS VARBINARY(20)) AS s_char13,
		CAST(v AS VARBINARY(20)) AS s_varchar13,
		CAST(n AS VARBINARY(20)) AS s_nchar13,
		CAST(nv AS VARBINARY(20)) AS s_nvarchar13
	FROM test_str_bin_conversion.string_to_varbinary_test;

statement ok
CREATE VIEW test_str_bin_conversion.v_binary_cast
AS
	SELECT id,
		CAST(c AS BINARY(20)) AS s_char13,
		CAST(v AS BINARY(20)) AS s_varchar13,
		CAST(n AS BINARY(20)) AS s_nchar13,
		CAST(nv AS BINARY(20)) AS s_nvarchar13
	FROM test_str_bin_conversion.string_to_varbinary_test;

statement ok
CREATE PROCEDURE test_str_bin_conversion.p_varbinary_try_cast
AS
BEGIN
	SELECT id,
		TRY_CAST(c AS VARBINARY(20)) AS s_char13,
		TRY_CAST(v AS VARBINARY(20)) AS s_varchar13,
		TRY_CAST(n AS VARBINARY(20)) AS s_nchar13,
		TRY_CAST(nv AS VARBINARY(20)) AS s_nvarchar13
	FROM test_str_bin_conversion.string_to_varbinary_test;
END

statement ok
CREATE PROCEDURE test_str_bin_conversion.p_binary_try_cast
