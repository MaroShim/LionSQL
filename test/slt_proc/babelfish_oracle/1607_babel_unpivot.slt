SELECT customer_id, turnover, quarter 
FROM customer_turnover 
UNPIVOT (turnover FOR quarter IN (q1, q2, q3, q4)) AS t 
WHERE turnover > ( 
    SELECT AVG(turnover) 
    FROM customer_turnover 
    UNPIVOT (turnover FOR quarter IN (q1, q2, q3, q4)) AS t2 
    WHERE t2.quarter = t.quarter 
);
