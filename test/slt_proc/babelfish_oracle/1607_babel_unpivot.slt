query TTTT
SELECT 
    customer_type,
    quarter,
    COUNT(*) as transaction_count,
    SUM(turnover) as total_turnover 
FROM customer_turnover 
UNPIVOT (turnover FOR quarter IN (q1, q2, q3, q4)) AS unpvt 
GROUP BY customer_type, quarter 
HAVING COUNT(*) > 1 AND SUM(turnover) > 500;
