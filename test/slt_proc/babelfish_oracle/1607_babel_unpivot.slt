    LEFT JOIN customer_info c ON t.customer_id = c.customer_id 
) AS ct 
UNPIVOT ( turnover FOR quarter IN (q3, q1, q2, q4)) AS u 
LEFT JOIN customer_info c2 ON u.customer_id = c2.customer_id;
