query TTT
SELECT customer_id, turnover, quarter FROM customer_turnover 
UNPIVOT (turnover FOR quarter IN (q1, q2, q3, q4)) AS unpvt;
----
3 0 q2
3 400 q3
3 150 q4
1 100 q1
1 200 q2
1 100 q3
1 400 q4
2 150 q1
2 250 q2
2 200 q3

