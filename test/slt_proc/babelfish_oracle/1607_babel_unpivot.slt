DECLARE @sales_data TABLE (
    id INT,
    region VARCHAR(20),
    jan_rev MONEY,
    feb_rev MONEY
);
INSERT INTO @sales_data VALUES
(1, 'North', $1000.00, 0),
(2, 'South', $800, NULL);
SELECT id, region, revenue, month 
FROM @sales_data 
UNPIVOT ( revenue FOR month IN (jan_rev, feb_rev)) AS unpvt;
