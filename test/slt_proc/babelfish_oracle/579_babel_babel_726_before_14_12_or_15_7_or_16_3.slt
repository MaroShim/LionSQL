CREATE FUNCTION babel_726_vu_prepare_f1() RETURNS NVARCHAR(4000) AS
BEGIN
    DECLARE @ans NVARCHAR(4000)
    SELECT @ans = COALESCE(CAST('x'AS VARBINARY), CAST('x' AS NVARCHAR(4000)), 'x')
    RETURN @ans
END

