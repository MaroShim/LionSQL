statement ok
DROP TABLE IF EXISTS IP_address

statement ok
CREATE TABLE IP_address
(
 c1 int IDENTITY(1, 1)
,string varchar(50) 
,is_valid bit
)

statement ok
SELECT * FROM IP_address
WHERE 
    string LIKE '_%._%._%._%'
  AND
    string NOT LIKE '%.%.%.%.%'
  AND
    string NOT LIKE '%[^0-9.]%'
  AND
    string NOT LIKE '%[0-9][0-9][0-9][0-9]%'
  AND
    string NOT LIKE '%[3-9][0-9][0-9]%'
  AND
    string NOT LIKE '%2[6-9][0-9]%'
  AND
    string NOT LIKE '%25[6-9]%'
ORDER BY c1

statement ok
SELECT * FROM IP_address
WHERE NOT(
    string LIKE '_%._%._%._%'
  AND
    string NOT LIKE '%.%.%.%.%'
  AND
    string NOT LIKE '%[^0-9.]%'
  AND
    string NOT LIKE '%[0-9][0-9][0-9][0-9]%'
  AND
    string NOT LIKE '%[3-9][0-9][0-9]%'
  AND
    string NOT LIKE '%2[6-9][0-9]%'
  AND
    string NOT LIKE '%25[6-9]%')
ORDER BY c1

statement ok
drop table IP_address

