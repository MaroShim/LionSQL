CREATE TABLE patindex_datatype_t1 (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    CharField CHAR(20),
    VarcharField VARCHAR(50),
    NcharField NCHAR(20),
    NvarcharField NVARCHAR(50),
    TextField TEXT
);

