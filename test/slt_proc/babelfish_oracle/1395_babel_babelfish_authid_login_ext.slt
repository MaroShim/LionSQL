CREATE PROC babelfish_authid_login_ext_vu_prepare_proc
AS
SELECT rolname, is_disabled, type, default_database_name 
FROM sys.babelfish_authid_login_ext
WHERE rolname LIKE '%babelfish_authid_login_ext_vu_prepare%'
