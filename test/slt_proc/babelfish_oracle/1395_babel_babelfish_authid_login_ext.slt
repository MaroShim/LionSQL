CREATE FUNCTION babelfish_authid_login_ext_vu_prepare_func()
RETURNS INT
AS
BEGIN
RETURN (SELECT COUNT(*) FROM sys.babelfish_authid_login_ext WHERE rolname LIKE '%babelfish_authid_login_ext_vu_prepare%')
END

