statement ok
CREATE FUNCTION like_in_function (@id INT, @cmp_string VARCHAR(30))
RETURNS INT
AS
BEGIN
    DECLARE @result INT
    SELECT @result = CASE 
            WHEN ( OBJECT_NAME(@id) LIKE @cmp_string ) THEN 1
            ELSE 0
            END
    RETURN @result;
END;

