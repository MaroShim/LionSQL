statement ok
CREATE PROCEDURE my_test1 AS
BEGIN
	DECLARE @a INT
	SET @a = 1
	SELECT @a
	RETURN
	SELECT @a + 1
END

statement ok
CREATE PROCEDURE my_test2 AS
BEGIN
	DECLARE @a INT
	SET @a = 1
	WHILE ( @a < 3 )
	BEGIN
		SELECT @a
		RETURN
		SET @a = @a + 1
	END
END

