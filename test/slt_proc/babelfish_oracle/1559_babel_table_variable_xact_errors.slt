CREATE PROCEDURE tv_function_1
AS
BEGIN TRY
    DECLARE @tv TABLE(c1 INT PRIMARY KEY, c2 INT)
    INSERT INTO @tv VALUES(1, 10), (2, 20), (3, 30)
    INSERT INTO @tv VALUES(3, 30) -- duplicate key, fail while table and index are open
END TRY
BEGIN CATCH
    INSERT INTO @tv VALUES(3, 30) -- duplicate key, fail while table and index are open
    SELECT * FROM @tv
END CATCH;

