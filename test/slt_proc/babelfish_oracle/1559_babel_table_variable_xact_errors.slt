CREATE PROC table_variable_throw_proc1 AS
BEGIN
    DECLARE @tv TABLE (a INT PRIMARY KEY, b CHAR(8))
    INSERT INTO @tv VALUES (1, 'First');
    SELECT * FROM @tv;
    THROW 51000, 'Throw error', 1;
    INSERT INTO @tv VALUES (2, 'Second');
END

