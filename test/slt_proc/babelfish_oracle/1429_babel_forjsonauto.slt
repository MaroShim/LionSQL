query T
SELECT category, SUM(quantity) as total_quantity, AVG(price) as avg_price FROM forjson_test_groupby GROUP BY category FOR JSON AUTO;
----
[{"avg_price":"2.1250","category":"Fruit","total_quantity":25}]

query T
SELECT category, COUNT(*) as product_count, SUM(quantity) as total_quantity FROM forjson_test_groupby GROUP BY category
HAVING SUM(quantity) > 20 FOR JSON AUTO;
----
[{"category":"Fruit","product_count":2,"total_quantity":25}]

query T
SELECT category, 
       COUNT(*) as product_count, 
       SUM(quantity) as total_quantity,
       MAX(price) as max_price,
       MIN(price) as min_price
FROM forjson_test_groupby
GROUP BY category
ORDER BY SUM(quantity * price) DESC
FOR JSON AUTO;
----
[{"category":"Fruit","max_price":"2.50","min_price":"1.75","product_count":2,"total_quantity":25}]

query T
SELECT id, 
       value,
       ROW_NUMBER() OVER(ORDER BY value) as row_num,
       RANK() OVER(ORDER BY value) as rank_val
FROM forjson_test_orderby
ORDER BY id
FOR JSON AUTO;
----
[{"id":1,"rank_val":3,"row_num":3,"value":20},{"id":2,"rank_val":1,"row_num":1,"value":10},{"id":3,"rank_val":5,"row_num":5,"value":30},{"id":4,"rank_val":2,"row_num":2,"value":15},{"id":5,"rank_val":4,"row_num":4,"value":25}]

