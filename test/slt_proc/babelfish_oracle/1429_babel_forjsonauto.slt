query T
SELECT n1.id as "outer.id", 
       n1.data as "outer.data", 
       n2.id as "inner.id", 
       n2.ref_id as "inner.ref_id" 
FROM forjson_test_nested_1 n1 
LEFT JOIN forjson_test_nested_2 n2 ON n1.id = n2.id 
FOR JSON AUTO, INCLUDE_NULL_VALUES;
