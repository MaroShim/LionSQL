# test/slt_proc/babelfish_oracle/714_babel_sys_eomonth.slt
# Babelfish Oracle Suite harvested from test/babelfish/raw/functions/sys-eomonth-vu-prepare.sql, test/babelfish/raw/functions/sys-eomonth-vu-verify.sql, test/babelfish/raw/functions/sys-eomonth-vu-cleanup.sql

statement ok
CREATE TABLE EOMONTH_DatesTable (
    Id INT PRIMARY KEY,
    DateValue DATE NOT NULL
);

statement ok
INSERT INTO EOMONTH_DatesTable (Id, DateValue)
VALUES (1, '1996-01-24'),
       (2, '2000-06-15'),
       (3, '2022-04-30');

statement ok
CREATE PROCEDURE GetEndOfMonthDate_EOMONTH
    @Id INT
AS
BEGIN
    SELECT EOMONTH(DateValue) AS EndOfMonth
    FROM EOMONTH_DatesTable
    WHERE Id = @Id;
END;

statement ok
CREATE VIEW EOMONTH_EndOfMonthView AS
    SELECT Id, DateValue, EOMONTH(DateValue) AS EndOfMonth
    FROM EOMONTH_DatesTable

statement ok
CREATE VIEW EOMONTH_EndOfNextMonthView AS
     SELECT Id, DateValue, EOMONTH(DateValue, 1) AS EndOfNextMonth
     FROM EOMONTH_DatesTable

statement ok
CREATE PROCEDURE GetEndOfNextMonthDate_EOMONTH
     @Id INT
 AS
 BEGIN
     SELECT EOMONTH(DateValue, 1) AS EndOfNextMonth
     FROM EOMONTH_DatesTable
     WHERE Id = @Id;
 END;

query TTT
SELECT * FROM EOMONTH_EndOfMonthView ORDER BY DateValue ASC;
----
1 1996-01-24 1996-01-31
2 2000-06-15 2000-06-30
3 2022-04-30 2022-04-30

query T
EXEC GetEndOfMonthDate_EOMONTH 1;
----
1996-01-31

query TTT
SELECT * FROM EOMONTH_EndOfNextMonthView ORDER BY DateValue ASC;
----
1 1996-01-24 1996-02-29
2 2000-06-15 2000-07-31
3 2022-04-30 2022-05-31

query T
EXEC GetEndOfNextMonthDate_EOMONTH 1;
----
1996-02-29

