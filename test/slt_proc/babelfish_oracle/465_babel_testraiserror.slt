statement ok
DECLARE @msg_id INT;
DECLARE @severity INT;
DECLARE @state INT;
SET @msg_id = 51000;
SET @severity = 0;
SET @state = 1;
RAISERROR(@msg_id, @severity, @state) WITH LOG, NOWAIT, SETERROR;

statement ok
