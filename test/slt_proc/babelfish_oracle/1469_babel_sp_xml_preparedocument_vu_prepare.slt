(3, N'<config><value>Mixed αβγ</value></config>', N'Greek')

statement ok
CREATE VIEW NVarcharXMLView_babel_1168 AS
SELECT id, xml_data, category
FROM NVarcharXMLSource_babel_1168
WHERE xml_data LIKE N'%<%>%'

