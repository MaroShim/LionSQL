CREATE TABLE XMLMetadata_babel_1168 (
    xml_id INT,
    created_date DATETIME,
    xml_type VARCHAR(20)
)
INSERT INTO XMLMetadata_babel_1168 VALUES 
(1, '2023-01-01', 'Config'),
