# test/slt_proc/babelfish_oracle/487_babel_babel_error_handling.slt
# Babelfish Oracle Suite harvested from test/babelfish/raw/babel_error_handling.sql

statement ok
CREATE TABLE t1 ( a int primary key );

statement ok
INSERT INTO t1 VALUES (1);

statement ok
CREATE PROCEDURE proc_insert1 @a int AS
BEGIN
INSERT INTO t1 VALUES (@a);
IF @@error = 2627
    PRINT 'DUPLICATE KEY DETECTED';
IF @@error = 0
    PRINT 'INSERTED @a'
INSERT INTO t1 VALUES (@a+1);
IF @@error = 2627
    PRINT 'DUPLICATE KEY DETECTED @a+1';
IF @@error = 0
    PRINT 'INSERTED @a+1';
END

query T
SELECT * FROM t1 ORDER BY a;
----
1

query T
SELECT * FROM t1 ORDER BY a;
----
1

statement ok
DROP TABLE t1;

statement ok
DROP PROCEDURE proc_insert1;

