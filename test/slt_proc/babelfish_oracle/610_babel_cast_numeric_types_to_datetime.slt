CREATE FUNCTION dbo.datetime_vu_prepare_function (@par SMALLMONEY)
RETURNS DATETIME AS
BEGIN
    Declare @res datetime
	SELECT @res = (SELECT CAST(@par AS DATETIME))
    RETURN  @res
END;

