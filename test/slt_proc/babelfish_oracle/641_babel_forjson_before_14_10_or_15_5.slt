statement ok
CREATE VIEW forjson_vu_v_nulls AS
SELECT (
	SELECT value
	FROM forjson_vu_t_values
	FOR JSON PATH
) c1

statement ok
CREATE VIEW forjson_vu_v_order_by AS
SELECT (
	SELECT Id,
		   Age,
		   Country
	FROM forjson_vu_t_countries
	ORDER BY Age
	FOR JSON PATH
) C1

