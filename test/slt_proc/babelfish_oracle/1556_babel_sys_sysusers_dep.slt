CREATE VIEW sysusers_dep_vu_prepare_view
AS
SELECT name, hasdbaccess, islogin, isntname, issqluser, issqlrole
FROM sys.sysusers
WHERE name LIKE '%sysusers_dep_vu_prepare_%' OR name = 'dbo' or name = 'guest'
ORDER BY name offset 0 rows

