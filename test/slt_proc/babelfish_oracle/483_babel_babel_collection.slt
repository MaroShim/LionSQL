statement ok
create table testing1(col nvarchar(60)); -- expect this to fail in the Postgres dialect

query T
select cast(
    case
        when cast(sys.SERVERPROPERTY('BabelfishVersion') as varchar(20)) LIKE '_._._'
             THEN 'valid'
    else 'invalid'
    end as sys.varchar(20));
----
invalid

