query TTTTTT
SELECT 
    CAST(c.relname AS VARCHAR(64)) AS tableName,
    CAST(i.conname AS VARCHAR(64)) AS constraintName
FROM pg_constraint i
    JOIN pg_class c ON (c.oid = i.conrelid)
WHERE
    c.relname like '%babel_2047%'
ORDER BY
    tableName ASC, constraintName ASC;
----
