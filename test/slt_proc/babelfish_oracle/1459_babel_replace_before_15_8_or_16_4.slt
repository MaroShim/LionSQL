declare @string1 nvarchar(30) = N'比尔·拉',@string2 nvarchar(30) = N'斯', @pat nvarchar(10) = N'尔'
select REPLACE(@string1, @pat, @string2)

query T
SELECT replace(NULL, 'acs', 'scd')
----
NULL

query T
SELECT replace('scd', NULL, 'scd')
----
NULL

query T
