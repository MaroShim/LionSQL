statement ok
CREATE PROCEDURE ascii_function_text_validator
    @InputText TEXT,
    @ExpectedASCII INT
AS
BEGIN
    IF ASCII(CAST(@InputText AS TEXT)) = @ExpectedASCII
        SELECT 'Pass' AS Result;
    ELSE
        SELECT 'Fail' AS Result;
END;

