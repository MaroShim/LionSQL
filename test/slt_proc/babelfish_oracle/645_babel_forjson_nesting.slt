    [Id] int,
    [name] varchar(50),
    [price] varchar (25)
);

statement ok
CREATE TABLE forjson_nesting_vu_t_orders (
    [Id] int,
    [userid] int,
    [productid] int,
    [quantity] int,
    [orderdate] Date
);

