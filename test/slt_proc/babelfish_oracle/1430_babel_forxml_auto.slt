    CustomerID NCHAR(5) PRIMARY KEY,
    CompanyName NVARCHAR(100),
    ContactName NVARCHAR(100),
    ContactTitle NVARCHAR(50),
    Region NVARCHAR(50),
    Country NVARCHAR(50),
    Phone NVARCHAR(20),
    IsActive BIT DEFAULT 1
);

