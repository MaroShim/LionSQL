CREATE PROCEDURE BABEL_BINARY_vu_prepare_p10 AS 
BEGIN
    DECLARE @abc VARCHAR(30), @def NVARCHAR(30);
    SET @abc = '0x1234ABCD';
    SET @def = '5678EF';
    SELECT 
