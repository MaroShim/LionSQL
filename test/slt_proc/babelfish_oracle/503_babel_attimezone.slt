DECLARE @lvDate DATETIME, @lvDateUTC DATETIME
SET @lvDate = '2021-01-01'
SET @lvDateUTC = @lvDate AT TIME ZONE  'US Eastern Standard Time' AT TIME ZONE 'UTC'
SELECT @lvDate, @lvDateUTC

