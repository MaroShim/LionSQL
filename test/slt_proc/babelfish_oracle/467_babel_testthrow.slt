# test/slt_proc/babelfish_oracle/467_babel_testthrow.slt
# Babelfish Oracle Suite harvested from test/babelfish/raw/errorHandling/TestThrow.sql

statement ok
CREATE TABLE throwTable (a INT);

statement ok
CREATE PROC throwProc1 AS
BEGIN
	INSERT INTO throwTable VALUES (1);
	THROW 51000, 'Throw error', 1;
	INSERT INTO throwTable VALUES (2);
END

statement ok
CREATE PROC throwProc2 AS
BEGIN
	INSERT INTO throwTable VALUES (111);
	EXEC throwProc1;
	INSERT INTO throwTable VALUES (222);
END

statement ok
CREATE PROC reThrowProc1 AS
BEGIN
	BEGIN TRY
		INSERT INTO throwTable VALUES (1);
		THROW 51000, 'Throw error', 1;
		INSERT INTO throwTable VALUES (2);
	END TRY
	BEGIN CATCH
		THROW;
		SELECT 'THROW SHOULD NOT CONTINUE'
	END CATCH
END

statement ok
CREATE PROC reThrowProc2 AS
BEGIN
	INSERT INTO throwTable VALUES (111);
	EXEC reThrowProc1;
	INSERT INTO throwTable VALUES (222);
END

statement ok
BEGIN TRY
	BEGIN TRY
		PRINT 100/0;
	END TRY
	BEGIN CATCH
		THROW 50000, 'Throw error', 1;
	END CATCH
END TRY
BEGIN CATCH
	THROW;
	SELECT 'THROW SHOULD NOT CONTINUE'
END CATCH

