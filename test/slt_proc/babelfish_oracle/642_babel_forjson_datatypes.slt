CREATE VIEW forjson_datatypes_vu_v_numerics AS
SELECT
(
    SELECT abigint, adecimal, aint, anumeric, asmallint, atinyint 
    FROM forjson_datatypes_vu_t_exact_numerics
    FOR JSON PATH
) as c1;

