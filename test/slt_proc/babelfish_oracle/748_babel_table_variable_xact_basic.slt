INSERT INTO @tv5 VALUES(1, 2)
BEGIN TRANSACTION
    UPDATE @tv5 SET c1 = 10 WHERE c1 = 1
    UPDATE @tv5 SET c1 = 100 WHERE c1 = 10
ROLLBACK
SELECT * FROM @tv5                              -- should see (100, 2)

