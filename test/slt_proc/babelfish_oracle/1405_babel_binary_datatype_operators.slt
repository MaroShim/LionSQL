statement ok
INSERT INTO binary_datatype_operators_test_table (col1, col2) VALUES
    (0x121212, 0x121212), -- col1 = col2
    (0x111111, 0x121212), -- col1 < col2
    (0x121212, 0x111111); -- col1 > col2

