# Babelfish Oracle Suite harvested from test/babelfish/raw/xml/openxml_without_with_clause-vu-prepare.sql, test/babelfish/raw/xml/openxml_without_with_clause-vu-verify.sql, test/babelfish/raw/xml/openxml_without_with_clause-vu-cleanup.sql

statement ok
CREATE PROCEDURE openxml_without_with_dep_proc1(@xml nvarchar(max)) 
AS 
BEGIN
    DECLARE @handle INT;
    EXEC sp_xml_preparedocument @handle OUTPUT, @xml;
    SELECT 
        id, parentid, nodetype, localname, prefix, namespaceuri, datatype, prev, text
    FROM OPENXML(@handle, '/') ORDER BY id;
    EXEC sp_xml_removedocument @handle;
END 

statement ok
CREATE PROCEDURE openxml_without_with_dep_proc2(@xml nvarchar(max)) 
AS 
BEGIN
    DECLARE @handle INT;
    EXEC sp_xml_preparedocument @handle OUTPUT, @xml;
    SELECT 
        id, parentid, nodetype, localname, prefix, namespaceuri, datatype, prev, text
    FROM OPENXML(@handle, '/', 1) ORDER BY id;
    EXEC sp_xml_removedocument @handle;
END 

