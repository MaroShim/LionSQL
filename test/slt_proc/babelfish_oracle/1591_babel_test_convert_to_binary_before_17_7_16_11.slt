    EmployeeID INT,
    FirstName NVARCHAR(50),
    LastName NVARCHAR(50),
    Salary DECIMAL(15,2),
    HireDate DATETIME,
    Department VARCHAR(50),
    EncryptedData VARBINARY(MAX)
);

