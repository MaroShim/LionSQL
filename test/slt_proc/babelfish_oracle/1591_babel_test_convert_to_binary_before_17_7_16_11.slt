statement ok
CREATE TRIGGER tr_DocumentBinaryValidation
ON Documents
AFTER INSERT, UPDATE
AS
BEGIN
    SELECT 
        DocID,
        DocName,
        CONVERT(BINARY(50), DocContent) as ConvertedContent
    FROM inserted;
END;

