CREATE PROCEDURE BABEL_3702_vu_prepare_p21
AS
BEGIN
    DECLARE @json_text NVARCHAR(MAX)
    SET @json_text = N'
        {
            "name": "Spider-Man",
            "vitals": {
                "species": "Human",
                "height": {
                    "measure": 178,
                    "unit": "cm"
                }
            },
            "current_team": null,
            "aliases": ["Bag-Man","Black Marvel","Peter Palmer"],
            "is_good": true,
            "created": 1962
        }
    '
    SELECT * FROM OPENJSON(@json_text)
    ORDER BY [type]
END;

