END

statement ok
CREATE PROCEDURE exec_tvf_named_args_out @x INT, @y INT OUTPUT
AS
BEGIN
	SET @y = @x * 10
END

statement ok
CREATE PROCEDURE exec_tvf_named_args_def @a INT, @b INT = 100
AS
BEGIN
	SELECT @a + @b AS total
END

query T
