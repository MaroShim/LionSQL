CREATE TABLE [dbo].[test_isnull_table](
       [id] [bigint] IDENTITY(1,1) NOT NULL,
       [my_varchar_data] [varchar](20) NULL,
       [my_computed_column] AS isnull([my_varchar_data],[id])) 

statement ok
