CREATE PROCEDURE [dbo].[test_isnull_proc1]
AS
select
  ISNULL(NULL, NULL),
  ISNULL(NULL, 'Unassigned'),
  ISNULL([my_varchar_data], 'Unassigned'),
  ISNULL('Unassigned', 1),
  ISNULL ('', 5)
from [dbo].[test_isnull_table] where isnull([my_varchar_data],[id]) = 1;

