DECLARE @batch VARCHAR(500);
SET @batch = 'insert into t1 values(1); rollback tran; begin tran;'
EXEC sp_prepare @handle OUT, NULL, @batch
EXEC sp_execute @handle
EXEC sp_execute @handle
EXEC SP_UNPREPARE @handle;
COMMIT;
SELECT COUNT(*) FROM t1;
