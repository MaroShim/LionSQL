ALTER VIEW dbo.order_summary AS
SELECT 
    order_id,
    total_amount,
    dbo.calculate_tax(total_amount) AS tax_amount,
    total_amount + dbo.calculate_tax(total_amount) AS total_with_tax
FROM 
    orders;

