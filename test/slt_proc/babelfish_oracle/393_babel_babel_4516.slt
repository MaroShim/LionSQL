CREATE PROC [db1_SCHEMA_2].[babel_user_ext] AS
BEGIN 
	SELECT rolname, login_name, type, orig_username, database_name
	FROM sys.babelfish_authid_user_ext
	WHERE orig_username LIKE 'DB1_User_%'
	ORDER BY rolname, orig_username
END

