    CharCol CHAR(10),
    VarcharCol VARCHAR(50),
    NCharCol NCHAR(10),
    NVarcharCol NVARCHAR(50),
    TextCol TEXT,
    NTextCol NTEXT,
    ExpectedValue INT,
    Description VARCHAR(100)
);

