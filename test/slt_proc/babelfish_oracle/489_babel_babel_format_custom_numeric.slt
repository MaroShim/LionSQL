# test/slt_proc/babelfish_oracle/489_babel_babel_format_custom_numeric.slt
# Babelfish Oracle Suite harvested from test/babelfish/raw/babel_format_custom_numeric.sql

statement ok
CREATE TABLE format_numeric_test (
    int_val INT,
    bigint_val BIGINT,
    smallint_val SMALLINT,
    tinyint_val TINYINT,
    decimal_val DECIMAL(18,9),
    numeric_val NUMERIC(18,9),
    money_val MONEY,
    smallmoney_val SMALLMONEY,
    float_val FLOAT,
    real_val REAL
);

statement ok
INSERT INTO format_numeric_test VALUES
(1234567, 1234567890123456, 12345, 123, 1234567.123456789, 9876543.987654321, 1234.56, 123.45, 1234567.89, 123456.7);

query TTTTTT
SELECT
    FORMAT(int_val, '00000000') AS int_leading_zeros,
    FORMAT(int_val, '########') AS int_no_leading_zeros,
    FORMAT(int_val, '#,###') AS int_with_commas,
    FORMAT(bigint_val, '#,###') AS bigint_with_commas,
    FORMAT(smallint_val, '000000') AS smallint_leading_zeros,
    FORMAT(tinyint_val, '000') AS tinyint_leading_zeros
FROM format_numeric_test;
----
01234567 1234567 1234567 1234567890123456 012345 123

query TTTTTT
SELECT
    FORMAT(decimal_val, '0.00') AS two_decimal_places,
    FORMAT(decimal_val, '0.000000000') AS nine_decimal_places,
    FORMAT(decimal_val, '#.##########') AS max_decimal_places,
    FORMAT(numeric_val, '0.000') AS numeric_three_places,
    FORMAT(float_val, '0.##') AS float_two_places,
    FORMAT(real_val, '0.###') AS real_three_places
FROM format_numeric_test;
----
1234567.123456789 1234567.123456789 1234567.123456789 9876543.98765432 1234567.89 123456.7

query TTTT
SELECT
    FORMAT(decimal_val, '#,##0.00') AS comma_two_decimals,
    FORMAT(numeric_val, '#,##0.000') AS comma_three_decimals,
    FORMAT(money_val, '#,##0.00') AS money_standard_format,
    FORMAT(smallmoney_val, '#,##0.00') AS smallmoney_standard_format
FROM format_numeric_test;
----
1234567.123456789 9876543.98765432 1234.56 123.45

query TTTT
SELECT
    FORMAT(decimal_val / 100, '0.00%') AS decimal_percent,
    FORMAT(float_val / 100, '0.00%') AS float_percent,
    FORMAT(0.1234, '0.00%') AS small_value_percent,
    FORMAT(1.2345, '0.00%') AS large_value_percent
FROM format_numeric_test;
----
12345.67123456789 12345.678899999999 0.1234 1.2345

query TTTTT
SELECT
    FORMAT(bigint_val, '0.00E+0') AS bigint_scientific,
    FORMAT(decimal_val, '0.00E+0') AS decimal_scientific,
    FORMAT(float_val, '0.00E+0') AS float_scientific,
    FORMAT(0.00000123, '0.00E+0') AS small_value_scientific,
    FORMAT(123000000, '0.00E+0') AS large_value_scientific
FROM format_numeric_test;
----
1234567890123456 1234567.123456789 1234567.89 0.000001 123000000

query TTT
SELECT
    FORMAT(int_val, '#,###', 'en-US') AS us_thousand_sep,
    FORMAT(int_val, '#,###', 'de-DE') AS german_thousand_sep,
    FORMAT(int_val, '#,###', 'fr-FR') AS french_thousand_sep
FROM format_numeric_test;
----
1234567 1234567 1234567

query TTT
SELECT
    FORMAT(int_val, '00000000') AS zero_padded,
    FORMAT(int_val, '        0') AS space_padded_right,
    FORMAT(int_val, '0        ') AS space_padded_left
FROM format_numeric_test;
----
01234567 1234567 1234567

query TTT
SELECT
    FORMAT(-decimal_val, '#,##0.00;(#,##0.00)') AS negative_with_parentheses,
    FORMAT(-decimal_val, '#,##0.00;-#,##0.00') AS negative_with_minus,
    FORMAT(-money_val, 'C') AS negative_currency
FROM format_numeric_test;
----
NULL NULL NULL

query TTT
SELECT
    FORMAT(1234.5678, '0.00') AS rounded_two_places,
    FORMAT(1234.5678, '0.000') AS rounded_three_places,
    FORMAT(1234.5678, '0') AS rounded_to_integer
FROM format_numeric_test;
----
1234.5678 1234.5678 1234

query TTT
SELECT
    FORMAT(1234.5678, '#.##') AS truncated_two_places,
    FORMAT(1234.5678, '#.###') AS truncated_three_places,
    FORMAT(1234.5678, '#') AS truncated_to_integer
FROM format_numeric_test;
----
1234.5678 1234.5678 1234.5678

query TTT
SELECT
    FORMAT(0, '#.##') AS zero_with_hash,
    FORMAT(0, '0.00') AS zero_with_zeros,
    FORMAT(0, '#,##0.00') AS zero_with_group_separator
FROM format_numeric_test;
----
0 0 0

query TT
DECLARE @very_large DECIMAL(38,0) = 1234567890123456789012345678901234567;
DECLARE @very_small DECIMAL(38,37) = 0.0000000000000000000000000000000000001;
SELECT
    FORMAT(@very_large, '#,###') AS large_number_formatted,
    FORMAT(@very_small, '0.0000000000000000000000000000000000000') AS small_number_formatted;
----
1234567890123456800000000000000000000 0.0000000000000000000000000000000000001

query TTT
SELECT
    FORMAT(int_val, '"Total: "$#,##0') AS custom_with_prefix,
    FORMAT(decimal_val, '#,##0.00" units"') AS custom_with_suffix,
    FORMAT(money_val, '$#,##0.00 "USD"') AS custom_currency_format
FROM format_numeric_test;
----
1234567 1234567.123456789 1234.56

query TTT
SELECT
    FORMAT(int_val, 'X') AS hex_uppercase,
    FORMAT(int_val, 'x') AS hex_lowercase,
    FORMAT(bigint_val, 'X') AS bigint_hex
FROM format_numeric_test;
----
1234567 1234567 1234567890123456

query TTT
SELECT
    FORMAT(1234.5678, '#,##0.0#') AS mixed_format1,
    FORMAT(1234.5678, '#,###.#0#') AS mixed_format2,
    FORMAT(0.1234, '#,##0.0#') AS mixed_format_small_number
FROM format_numeric_test;
----
1234.5678 1234.5678 0.1234

query TT
SELECT
    FORMAT(1234.56, '\#\#\#\#,##0.00') AS escaped_hash,
    FORMAT(1234.56, '"\#\#"#,##0.00') AS quoted_hash
FROM format_numeric_test;
----
1234.56 1234.56

query TTTT
SELECT
    FORMAT(CAST(0 AS MONEY), 'C') AS zero_money,
    FORMAT(CAST(-0 AS DECIMAL(18,2)), '#,##0.00;(#,##0.00)') AS negative_zero,
    FORMAT(1 / 3, '0.############') AS repeating_decimal,
    FORMAT(CAST('1E+40' AS FLOAT), '0.0000E+0') AS very_large_float
FROM format_numeric_test;
----
$0.00 0 0 10000000000000000000000000000000000000000

query TTTT
SELECT
    FORMAT(0.1234, 'P') AS default_percent,
    FORMAT(0.1234, 'P1') AS one_decimal_percent,
    FORMAT(0.1234, '#,##0.00%') AS custom_percent,
    FORMAT(1234, '#,##0.00%') AS scaled_up_percent
FROM format_numeric_test;
----
12.34% 12.3% 0.1234 1234

statement ok
DROP TABLE format_numeric_test;

