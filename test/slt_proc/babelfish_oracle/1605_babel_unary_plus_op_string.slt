create procedure p1_unary_plus_op_string 
as
declare @v varchar(20) = ' test'
declare @i int = 1
declare @d datetime='2024-Jan-01 01:02:03' 
declare @dc decimal(10,4)=1
select 'proc '+'line1'
select 'proc '++'line2'
