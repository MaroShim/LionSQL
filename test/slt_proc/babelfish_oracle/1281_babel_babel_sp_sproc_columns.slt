CREATE FUNCTION babel_sp_sproc_columns_vu_prepare_s1.positive_or_negative (
@long DECIMAL(9,6)
)
RETURNS CHAR(4) AS
BEGIN
DECLARE @return_value CHAR(10);
SET @return_value = 'zero';
    IF (@long > 0.00) SET @return_value = 'positive';
    IF (@long < 0.00) SET @return_value = 'negative';
    RETURN @return_value
END;

