    ID INT PRIMARY KEY,
    Email EmailAddress,
    Phone PhoneNumber,
    Name FullName,
    Desc1 Description,
    Desc2 Unicode_Description,
    Code ShortCode,
    Details LongText,
    UCode UnicodeCode
);

