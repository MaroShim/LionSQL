query TTT
SELECT *
FROM (
    SELECT 
        'dt_' + CAST(id AS VARCHAR(10)) AS pivot_col,
        CAST(dt_col AS BINARY(8)) AS binary_val
    FROM test_datetime_binary
    WHERE dt_col IS NOT NULL
) AS source_table
PIVOT (
    MAX(binary_val)
    FOR pivot_col IN ([dt_1], [dt_2], [dt_3])
) AS pivot_table;
