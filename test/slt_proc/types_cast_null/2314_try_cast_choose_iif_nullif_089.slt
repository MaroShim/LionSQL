# test/slt_proc/types_cast_null/2314_try_cast_choose_iif_nullif_089.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (89)

query ITIT
SELECT TRY_CAST('1164' AS INT),
       ISNULL(TRY_CAST('not_an_int_89' AS INT), -999),
       ISNULL(NULLIF(1164, 1164), 89),
       CHOOSE(3, 'OPT_A_89', 'OPT_B_89', 'OPT_C_89');
----
1164 -999 89 OPT_C_89

query TT
SELECT IIF(1164 > 50, 'LARGE_89', 'SMALL_89'),
       COALESCE(NULL, NULL, 'FALLBACK_89');
----
LARGE_89 FALLBACK_89

statement ok
CREATE TABLE tc_tbl_2314 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2314 VALUES
(1, '1164', 10),
(2, 'bad_89', 445);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2314
ORDER BY id;
----
1 1164
2 445

statement ok
DROP TABLE tc_tbl_2314;
