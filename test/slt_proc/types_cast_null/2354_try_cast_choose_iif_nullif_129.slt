# test/slt_proc/types_cast_null/2354_try_cast_choose_iif_nullif_129.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (129)

query ITIT
SELECT TRY_CAST('1684' AS INT),
       ISNULL(TRY_CAST('not_an_int_129' AS INT), -999),
       ISNULL(NULLIF(1684, 1684), 129),
       CHOOSE(1, 'OPT_A_129', 'OPT_B_129', 'OPT_C_129');
----
1684 -999 129 OPT_A_129

query TT
SELECT IIF(1684 > 50, 'LARGE_129', 'SMALL_129'),
       COALESCE(NULL, NULL, 'FALLBACK_129');
----
LARGE_129 FALLBACK_129

statement ok
CREATE TABLE tc_tbl_2354 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2354 VALUES
(1, '1684', 10),
(2, 'bad_129', 645);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2354
ORDER BY id;
----
1 1684
2 645

statement ok
DROP TABLE tc_tbl_2354;
