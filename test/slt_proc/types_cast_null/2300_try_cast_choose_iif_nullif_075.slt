# test/slt_proc/types_cast_null/2300_try_cast_choose_iif_nullif_075.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (75)

query ITIT
SELECT TRY_CAST('982' AS INT),
       ISNULL(TRY_CAST('not_an_int_75' AS INT), -999),
       ISNULL(NULLIF(982, 982), 75),
       CHOOSE(1, 'OPT_A_75', 'OPT_B_75', 'OPT_C_75');
----
982 -999 75 OPT_A_75

query TT
SELECT IIF(982 > 50, 'LARGE_75', 'SMALL_75'),
       COALESCE(NULL, NULL, 'FALLBACK_75');
----
LARGE_75 FALLBACK_75

statement ok
CREATE TABLE tc_tbl_2300 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2300 VALUES
(1, '982', 10),
(2, 'bad_75', 375);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2300
ORDER BY id;
----
1 982
2 375

statement ok
DROP TABLE tc_tbl_2300;
