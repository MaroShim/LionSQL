# test/slt_proc/types_cast_null/2371_try_cast_choose_iif_nullif_146.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (146)

query ITIT
SELECT TRY_CAST('1905' AS INT),
       ISNULL(TRY_CAST('not_an_int_146' AS INT), -999),
       ISNULL(NULLIF(1905, 1905), 146),
       CHOOSE(3, 'OPT_A_146', 'OPT_B_146', 'OPT_C_146');
----
1905 -999 146 OPT_C_146

query TT
SELECT IIF(1905 > 50, 'LARGE_146', 'SMALL_146'),
       COALESCE(NULL, NULL, 'FALLBACK_146');
----
LARGE_146 FALLBACK_146

statement ok
CREATE TABLE tc_tbl_2371 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2371 VALUES
(1, '1905', 10),
(2, 'bad_146', 730);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2371
ORDER BY id;
----
1 1905
2 730

statement ok
DROP TABLE tc_tbl_2371;
