# test/slt_proc/types_cast_null/130_cast_null_3vl_05.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (5)

query ITI
SELECT CAST('196' AS INT) + 5, CAST(196 AS VARCHAR(20)), TRY_CAST('196' AS INT);
----
201 196 196

query IIT
SELECT ISNUMERIC('196'), ISNUMERIC('err_5z'), ISNULL(CAST(TRY_CAST('err_5z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(2, 'Alpha_5', 'Beta_5', 'Gamma_5', 'Delta_5'), IIF(196 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_5'), COALESCE(NULL, NULL, 'COAL_5');
----
Beta_5 YES DEF_5 COAL_5

query II
SELECT ISNULL(NULLIF(196, 196), -1), NULLIF(196, 0);
----
-1 196
