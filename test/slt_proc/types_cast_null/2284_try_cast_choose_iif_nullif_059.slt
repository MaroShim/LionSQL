# test/slt_proc/types_cast_null/2284_try_cast_choose_iif_nullif_059.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (59)

query ITIT
SELECT TRY_CAST('774' AS INT),
       ISNULL(TRY_CAST('not_an_int_59' AS INT), -999),
       ISNULL(NULLIF(774, 774), 59),
       CHOOSE(3, 'OPT_A_59', 'OPT_B_59', 'OPT_C_59');
----
774 -999 59 OPT_C_59

query TT
SELECT IIF(774 > 50, 'LARGE_59', 'SMALL_59'),
       COALESCE(NULL, NULL, 'FALLBACK_59');
----
LARGE_59 FALLBACK_59

statement ok
CREATE TABLE tc_tbl_2284 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2284 VALUES
(1, '774', 10),
(2, 'bad_59', 295);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2284
ORDER BY id;
----
1 774
2 295

statement ok
DROP TABLE tc_tbl_2284;
