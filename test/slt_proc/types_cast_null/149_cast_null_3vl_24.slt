# test/slt_proc/types_cast_null/149_cast_null_3vl_24.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (24)

query ITI
SELECT CAST('899' AS INT) + 24, CAST(899 AS VARCHAR(20)), TRY_CAST('899' AS INT);
----
923 899 899

query IIT
SELECT ISNUMERIC('899'), ISNUMERIC('err_24z'), ISNULL(CAST(TRY_CAST('err_24z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(1, 'Alpha_24', 'Beta_24', 'Gamma_24', 'Delta_24'), IIF(899 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_24'), COALESCE(NULL, NULL, 'COAL_24');
----
Alpha_24 YES DEF_24 COAL_24

query II
SELECT ISNULL(NULLIF(899, 899), -1), NULLIF(899, 0);
----
-1 899
