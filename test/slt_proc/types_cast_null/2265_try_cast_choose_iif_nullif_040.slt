# test/slt_proc/types_cast_null/2265_try_cast_choose_iif_nullif_040.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (40)

query ITIT
SELECT TRY_CAST('527' AS INT),
       ISNULL(TRY_CAST('not_an_int_40' AS INT), -999),
       ISNULL(NULLIF(527, 527), 40),
       CHOOSE(2, 'OPT_A_40', 'OPT_B_40', 'OPT_C_40');
----
527 -999 40 OPT_B_40

query TT
SELECT IIF(527 > 50, 'LARGE_40', 'SMALL_40'),
       COALESCE(NULL, NULL, 'FALLBACK_40');
----
LARGE_40 FALLBACK_40

statement ok
CREATE TABLE tc_tbl_2265 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2265 VALUES
(1, '527', 10),
(2, 'bad_40', 200);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2265
ORDER BY id;
----
1 527
2 200

statement ok
DROP TABLE tc_tbl_2265;
