# test/slt_proc/types_cast_null/131_cast_null_3vl_06.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (6)

query ITI
SELECT CAST('233' AS INT) + 6, CAST(233 AS VARCHAR(20)), TRY_CAST('233' AS INT);
----
239 233 233

query IIT
SELECT ISNUMERIC('233'), ISNUMERIC('err_6z'), ISNULL(CAST(TRY_CAST('err_6z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(3, 'Alpha_6', 'Beta_6', 'Gamma_6', 'Delta_6'), IIF(233 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_6'), COALESCE(NULL, NULL, 'COAL_6');
----
Gamma_6 YES DEF_6 COAL_6

query II
SELECT ISNULL(NULLIF(233, 233), -1), NULLIF(233, 0);
----
-1 233
