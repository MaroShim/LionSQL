# test/slt_proc/types_cast_null/2324_try_cast_choose_iif_nullif_099.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (99)

query ITIT
SELECT TRY_CAST('1294' AS INT),
       ISNULL(TRY_CAST('not_an_int_99' AS INT), -999),
       ISNULL(NULLIF(1294, 1294), 99),
       CHOOSE(1, 'OPT_A_99', 'OPT_B_99', 'OPT_C_99');
----
1294 -999 99 OPT_A_99

query TT
SELECT IIF(1294 > 50, 'LARGE_99', 'SMALL_99'),
       COALESCE(NULL, NULL, 'FALLBACK_99');
----
LARGE_99 FALLBACK_99

statement ok
CREATE TABLE tc_tbl_2324 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2324 VALUES
(1, '1294', 10),
(2, 'bad_99', 495);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2324
ORDER BY id;
----
1 1294
2 495

statement ok
DROP TABLE tc_tbl_2324;
