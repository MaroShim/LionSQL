# test/slt_proc/types_cast_null/2299_try_cast_choose_iif_nullif_074.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (74)

query ITIT
SELECT TRY_CAST('969' AS INT),
       ISNULL(TRY_CAST('not_an_int_74' AS INT), -999),
       ISNULL(NULLIF(969, 969), 74),
       CHOOSE(3, 'OPT_A_74', 'OPT_B_74', 'OPT_C_74');
----
969 -999 74 OPT_C_74

query TT
SELECT IIF(969 > 50, 'LARGE_74', 'SMALL_74'),
       COALESCE(NULL, NULL, 'FALLBACK_74');
----
LARGE_74 FALLBACK_74

statement ok
CREATE TABLE tc_tbl_2299 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2299 VALUES
(1, '969', 10),
(2, 'bad_74', 370);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2299
ORDER BY id;
----
1 969
2 370

statement ok
DROP TABLE tc_tbl_2299;
