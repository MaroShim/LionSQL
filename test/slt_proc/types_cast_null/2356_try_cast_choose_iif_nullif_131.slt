# test/slt_proc/types_cast_null/2356_try_cast_choose_iif_nullif_131.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (131)

query ITIT
SELECT TRY_CAST('1710' AS INT),
       ISNULL(TRY_CAST('not_an_int_131' AS INT), -999),
       ISNULL(NULLIF(1710, 1710), 131),
       CHOOSE(3, 'OPT_A_131', 'OPT_B_131', 'OPT_C_131');
----
1710 -999 131 OPT_C_131

query TT
SELECT IIF(1710 > 50, 'LARGE_131', 'SMALL_131'),
       COALESCE(NULL, NULL, 'FALLBACK_131');
----
LARGE_131 FALLBACK_131

statement ok
CREATE TABLE tc_tbl_2356 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2356 VALUES
(1, '1710', 10),
(2, 'bad_131', 655);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2356
ORDER BY id;
----
1 1710
2 655

statement ok
DROP TABLE tc_tbl_2356;
