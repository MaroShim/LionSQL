# test/slt_proc/types_cast_null/2247_try_cast_choose_iif_nullif_022.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (22)

query ITIT
SELECT TRY_CAST('293' AS INT),
       ISNULL(TRY_CAST('not_an_int_22' AS INT), -999),
       ISNULL(NULLIF(293, 293), 22),
       CHOOSE(2, 'OPT_A_22', 'OPT_B_22', 'OPT_C_22');
----
293 -999 22 OPT_B_22

query TT
SELECT IIF(293 > 50, 'LARGE_22', 'SMALL_22'),
       COALESCE(NULL, NULL, 'FALLBACK_22');
----
LARGE_22 FALLBACK_22

statement ok
CREATE TABLE tc_tbl_2247 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2247 VALUES
(1, '293', 10),
(2, 'bad_22', 110);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2247
ORDER BY id;
----
1 293
2 110

statement ok
DROP TABLE tc_tbl_2247;
