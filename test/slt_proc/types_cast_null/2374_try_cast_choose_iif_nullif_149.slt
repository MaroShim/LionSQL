# test/slt_proc/types_cast_null/2374_try_cast_choose_iif_nullif_149.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (149)

query ITIT
SELECT TRY_CAST('1944' AS INT),
       ISNULL(TRY_CAST('not_an_int_149' AS INT), -999),
       ISNULL(NULLIF(1944, 1944), 149),
       CHOOSE(3, 'OPT_A_149', 'OPT_B_149', 'OPT_C_149');
----
1944 -999 149 OPT_C_149

query TT
SELECT IIF(1944 > 50, 'LARGE_149', 'SMALL_149'),
       COALESCE(NULL, NULL, 'FALLBACK_149');
----
LARGE_149 FALLBACK_149

statement ok
CREATE TABLE tc_tbl_2374 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2374 VALUES
(1, '1944', 10),
(2, 'bad_149', 745);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2374
ORDER BY id;
----
1 1944
2 745

statement ok
DROP TABLE tc_tbl_2374;
