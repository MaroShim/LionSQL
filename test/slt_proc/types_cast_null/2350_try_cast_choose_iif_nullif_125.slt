# test/slt_proc/types_cast_null/2350_try_cast_choose_iif_nullif_125.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (125)

query ITIT
SELECT TRY_CAST('1632' AS INT),
       ISNULL(TRY_CAST('not_an_int_125' AS INT), -999),
       ISNULL(NULLIF(1632, 1632), 125),
       CHOOSE(3, 'OPT_A_125', 'OPT_B_125', 'OPT_C_125');
----
1632 -999 125 OPT_C_125

query TT
SELECT IIF(1632 > 50, 'LARGE_125', 'SMALL_125'),
       COALESCE(NULL, NULL, 'FALLBACK_125');
----
LARGE_125 FALLBACK_125

statement ok
CREATE TABLE tc_tbl_2350 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2350 VALUES
(1, '1632', 10),
(2, 'bad_125', 625);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2350
ORDER BY id;
----
1 1632
2 625

statement ok
DROP TABLE tc_tbl_2350;
