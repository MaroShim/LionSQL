# test/slt_proc/types_cast_null/2249_try_cast_choose_iif_nullif_024.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (24)

query ITIT
SELECT TRY_CAST('319' AS INT),
       ISNULL(TRY_CAST('not_an_int_24' AS INT), -999),
       ISNULL(NULLIF(319, 319), 24),
       CHOOSE(1, 'OPT_A_24', 'OPT_B_24', 'OPT_C_24');
----
319 -999 24 OPT_A_24

query TT
SELECT IIF(319 > 50, 'LARGE_24', 'SMALL_24'),
       COALESCE(NULL, NULL, 'FALLBACK_24');
----
LARGE_24 FALLBACK_24

statement ok
CREATE TABLE tc_tbl_2249 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2249 VALUES
(1, '319', 10),
(2, 'bad_24', 120);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2249
ORDER BY id;
----
1 319
2 120

statement ok
DROP TABLE tc_tbl_2249;
