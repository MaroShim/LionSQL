# test/slt_proc/types_cast_null/2370_try_cast_choose_iif_nullif_145.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (145)

query ITIT
SELECT TRY_CAST('1892' AS INT),
       ISNULL(TRY_CAST('not_an_int_145' AS INT), -999),
       ISNULL(NULLIF(1892, 1892), 145),
       CHOOSE(2, 'OPT_A_145', 'OPT_B_145', 'OPT_C_145');
----
1892 -999 145 OPT_B_145

query TT
SELECT IIF(1892 > 50, 'LARGE_145', 'SMALL_145'),
       COALESCE(NULL, NULL, 'FALLBACK_145');
----
LARGE_145 FALLBACK_145

statement ok
CREATE TABLE tc_tbl_2370 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2370 VALUES
(1, '1892', 10),
(2, 'bad_145', 725);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2370
ORDER BY id;
----
1 1892
2 725

statement ok
DROP TABLE tc_tbl_2370;
