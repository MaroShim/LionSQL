# test/slt_proc/types_cast_null/2336_try_cast_choose_iif_nullif_111.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (111)

query ITIT
SELECT TRY_CAST('1450' AS INT),
       ISNULL(TRY_CAST('not_an_int_111' AS INT), -999),
       ISNULL(NULLIF(1450, 1450), 111),
       CHOOSE(1, 'OPT_A_111', 'OPT_B_111', 'OPT_C_111');
----
1450 -999 111 OPT_A_111

query TT
SELECT IIF(1450 > 50, 'LARGE_111', 'SMALL_111'),
       COALESCE(NULL, NULL, 'FALLBACK_111');
----
LARGE_111 FALLBACK_111

statement ok
CREATE TABLE tc_tbl_2336 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2336 VALUES
(1, '1450', 10),
(2, 'bad_111', 555);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2336
ORDER BY id;
----
1 1450
2 555

statement ok
DROP TABLE tc_tbl_2336;
