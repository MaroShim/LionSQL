# test/slt_proc/types_cast_null/864_case_3vl_greatest_least_04.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (4)

query II
SELECT GREATEST(16, 38, 59), LEAST(16, 38, 59);
----
59 16

statement ok
CREATE TABLE t_null_864 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_864 VALUES
(1, 16, 'LOW'),
(2, NULL, 'MISSING'),
(3, 59, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 38 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_4')
FROM t_null_864
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_4

query I
SELECT COUNT(*) FROM t_null_864 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_864;
