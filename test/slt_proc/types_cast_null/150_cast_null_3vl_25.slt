# test/slt_proc/types_cast_null/150_cast_null_3vl_25.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (25)

query ITI
SELECT CAST('936' AS INT) + 25, CAST(936 AS VARCHAR(20)), TRY_CAST('936' AS INT);
----
961 936 936

query IIT
SELECT ISNUMERIC('936'), ISNUMERIC('err_25z'), ISNULL(CAST(TRY_CAST('err_25z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(2, 'Alpha_25', 'Beta_25', 'Gamma_25', 'Delta_25'), IIF(936 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_25'), COALESCE(NULL, NULL, 'COAL_25');
----
Beta_25 YES DEF_25 COAL_25

query II
SELECT ISNULL(NULLIF(936, 936), -1), NULLIF(936, 0);
----
-1 936
