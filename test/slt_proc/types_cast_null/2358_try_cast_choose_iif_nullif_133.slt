# test/slt_proc/types_cast_null/2358_try_cast_choose_iif_nullif_133.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (133)

query ITIT
SELECT TRY_CAST('1736' AS INT),
       ISNULL(TRY_CAST('not_an_int_133' AS INT), -999),
       ISNULL(NULLIF(1736, 1736), 133),
       CHOOSE(2, 'OPT_A_133', 'OPT_B_133', 'OPT_C_133');
----
1736 -999 133 OPT_B_133

query TT
SELECT IIF(1736 > 50, 'LARGE_133', 'SMALL_133'),
       COALESCE(NULL, NULL, 'FALLBACK_133');
----
LARGE_133 FALLBACK_133

statement ok
CREATE TABLE tc_tbl_2358 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2358 VALUES
(1, '1736', 10),
(2, 'bad_133', 665);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2358
ORDER BY id;
----
1 1736
2 665

statement ok
DROP TABLE tc_tbl_2358;
