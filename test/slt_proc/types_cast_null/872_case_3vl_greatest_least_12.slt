# test/slt_proc/types_cast_null/872_case_3vl_greatest_least_12.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (12)

query II
SELECT GREATEST(48, 110, 179), LEAST(48, 110, 179);
----
179 48

statement ok
CREATE TABLE t_null_872 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_872 VALUES
(1, 48, 'LOW'),
(2, NULL, 'MISSING'),
(3, 179, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 110 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_12')
FROM t_null_872
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_12

query I
SELECT COUNT(*) FROM t_null_872 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_872;
