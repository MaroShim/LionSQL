# test/slt_proc/types_cast_null/138_cast_null_3vl_13.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (13)

query ITI
SELECT CAST('492' AS INT) + 13, CAST(492 AS VARCHAR(20)), TRY_CAST('492' AS INT);
----
505 492 492

query IIT
SELECT ISNUMERIC('492'), ISNUMERIC('err_13z'), ISNULL(CAST(TRY_CAST('err_13z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(2, 'Alpha_13', 'Beta_13', 'Gamma_13', 'Delta_13'), IIF(492 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_13'), COALESCE(NULL, NULL, 'COAL_13');
----
Beta_13 YES DEF_13 COAL_13

query II
SELECT ISNULL(NULLIF(492, 492), -1), NULLIF(492, 0);
----
-1 492
