# test/slt_proc/types_cast_null/2256_try_cast_choose_iif_nullif_031.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (31)

query ITIT
SELECT TRY_CAST('410' AS INT),
       ISNULL(TRY_CAST('not_an_int_31' AS INT), -999),
       ISNULL(NULLIF(410, 410), 31),
       CHOOSE(2, 'OPT_A_31', 'OPT_B_31', 'OPT_C_31');
----
410 -999 31 OPT_B_31

query TT
SELECT IIF(410 > 50, 'LARGE_31', 'SMALL_31'),
       COALESCE(NULL, NULL, 'FALLBACK_31');
----
LARGE_31 FALLBACK_31

statement ok
CREATE TABLE tc_tbl_2256 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2256 VALUES
(1, '410', 10),
(2, 'bad_31', 155);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2256
ORDER BY id;
----
1 410
2 155

statement ok
DROP TABLE tc_tbl_2256;
