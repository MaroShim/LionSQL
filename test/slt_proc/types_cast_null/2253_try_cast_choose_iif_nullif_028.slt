# test/slt_proc/types_cast_null/2253_try_cast_choose_iif_nullif_028.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (28)

query ITIT
SELECT TRY_CAST('371' AS INT),
       ISNULL(TRY_CAST('not_an_int_28' AS INT), -999),
       ISNULL(NULLIF(371, 371), 28),
       CHOOSE(2, 'OPT_A_28', 'OPT_B_28', 'OPT_C_28');
----
371 -999 28 OPT_B_28

query TT
SELECT IIF(371 > 50, 'LARGE_28', 'SMALL_28'),
       COALESCE(NULL, NULL, 'FALLBACK_28');
----
LARGE_28 FALLBACK_28

statement ok
CREATE TABLE tc_tbl_2253 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2253 VALUES
(1, '371', 10),
(2, 'bad_28', 140);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2253
ORDER BY id;
----
1 371
2 140

statement ok
DROP TABLE tc_tbl_2253;
