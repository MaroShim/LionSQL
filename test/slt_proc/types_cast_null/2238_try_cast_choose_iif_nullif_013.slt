# test/slt_proc/types_cast_null/2238_try_cast_choose_iif_nullif_013.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (13)

query ITIT
SELECT TRY_CAST('176' AS INT),
       ISNULL(TRY_CAST('not_an_int_13' AS INT), -999),
       ISNULL(NULLIF(176, 176), 13),
       CHOOSE(2, 'OPT_A_13', 'OPT_B_13', 'OPT_C_13');
----
176 -999 13 OPT_B_13

query TT
SELECT IIF(176 > 50, 'LARGE_13', 'SMALL_13'),
       COALESCE(NULL, NULL, 'FALLBACK_13');
----
LARGE_13 FALLBACK_13

statement ok
CREATE TABLE tc_tbl_2238 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2238 VALUES
(1, '176', 10),
(2, 'bad_13', 65);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2238
ORDER BY id;
----
1 176
2 65

statement ok
DROP TABLE tc_tbl_2238;
