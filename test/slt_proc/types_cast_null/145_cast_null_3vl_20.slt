# test/slt_proc/types_cast_null/145_cast_null_3vl_20.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (20)

query ITI
SELECT CAST('751' AS INT) + 20, CAST(751 AS VARCHAR(20)), TRY_CAST('751' AS INT);
----
771 751 751

query IIT
SELECT ISNUMERIC('751'), ISNUMERIC('err_20z'), ISNULL(CAST(TRY_CAST('err_20z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(1, 'Alpha_20', 'Beta_20', 'Gamma_20', 'Delta_20'), IIF(751 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_20'), COALESCE(NULL, NULL, 'COAL_20');
----
Alpha_20 YES DEF_20 COAL_20

query II
SELECT ISNULL(NULLIF(751, 751), -1), NULLIF(751, 0);
----
-1 751
