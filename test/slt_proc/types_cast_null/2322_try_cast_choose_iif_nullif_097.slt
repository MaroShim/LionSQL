# test/slt_proc/types_cast_null/2322_try_cast_choose_iif_nullif_097.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (97)

query ITIT
SELECT TRY_CAST('1268' AS INT),
       ISNULL(TRY_CAST('not_an_int_97' AS INT), -999),
       ISNULL(NULLIF(1268, 1268), 97),
       CHOOSE(2, 'OPT_A_97', 'OPT_B_97', 'OPT_C_97');
----
1268 -999 97 OPT_B_97

query TT
SELECT IIF(1268 > 50, 'LARGE_97', 'SMALL_97'),
       COALESCE(NULL, NULL, 'FALLBACK_97');
----
LARGE_97 FALLBACK_97

statement ok
CREATE TABLE tc_tbl_2322 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2322 VALUES
(1, '1268', 10),
(2, 'bad_97', 485);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2322
ORDER BY id;
----
1 1268
2 485

statement ok
DROP TABLE tc_tbl_2322;
