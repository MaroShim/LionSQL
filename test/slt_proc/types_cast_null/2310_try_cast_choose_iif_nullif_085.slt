# test/slt_proc/types_cast_null/2310_try_cast_choose_iif_nullif_085.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (85)

query ITIT
SELECT TRY_CAST('1112' AS INT),
       ISNULL(TRY_CAST('not_an_int_85' AS INT), -999),
       ISNULL(NULLIF(1112, 1112), 85),
       CHOOSE(2, 'OPT_A_85', 'OPT_B_85', 'OPT_C_85');
----
1112 -999 85 OPT_B_85

query TT
SELECT IIF(1112 > 50, 'LARGE_85', 'SMALL_85'),
       COALESCE(NULL, NULL, 'FALLBACK_85');
----
LARGE_85 FALLBACK_85

statement ok
CREATE TABLE tc_tbl_2310 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2310 VALUES
(1, '1112', 10),
(2, 'bad_85', 425);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2310
ORDER BY id;
----
1 1112
2 425

statement ok
DROP TABLE tc_tbl_2310;
