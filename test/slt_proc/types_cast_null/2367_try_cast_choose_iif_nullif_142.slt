# test/slt_proc/types_cast_null/2367_try_cast_choose_iif_nullif_142.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (142)

query ITIT
SELECT TRY_CAST('1853' AS INT),
       ISNULL(TRY_CAST('not_an_int_142' AS INT), -999),
       ISNULL(NULLIF(1853, 1853), 142),
       CHOOSE(2, 'OPT_A_142', 'OPT_B_142', 'OPT_C_142');
----
1853 -999 142 OPT_B_142

query TT
SELECT IIF(1853 > 50, 'LARGE_142', 'SMALL_142'),
       COALESCE(NULL, NULL, 'FALLBACK_142');
----
LARGE_142 FALLBACK_142

statement ok
CREATE TABLE tc_tbl_2367 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2367 VALUES
(1, '1853', 10),
(2, 'bad_142', 710);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2367
ORDER BY id;
----
1 1853
2 710

statement ok
DROP TABLE tc_tbl_2367;
