# test/slt_proc/types_cast_null/2266_try_cast_choose_iif_nullif_041.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (41)

query ITIT
SELECT TRY_CAST('540' AS INT),
       ISNULL(TRY_CAST('not_an_int_41' AS INT), -999),
       ISNULL(NULLIF(540, 540), 41),
       CHOOSE(3, 'OPT_A_41', 'OPT_B_41', 'OPT_C_41');
----
540 -999 41 OPT_C_41

query TT
SELECT IIF(540 > 50, 'LARGE_41', 'SMALL_41'),
       COALESCE(NULL, NULL, 'FALLBACK_41');
----
LARGE_41 FALLBACK_41

statement ok
CREATE TABLE tc_tbl_2266 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2266 VALUES
(1, '540', 10),
(2, 'bad_41', 205);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2266
ORDER BY id;
----
1 540
2 205

statement ok
DROP TABLE tc_tbl_2266;
