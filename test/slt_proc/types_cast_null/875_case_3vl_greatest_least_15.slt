# test/slt_proc/types_cast_null/875_case_3vl_greatest_least_15.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (15)

query II
SELECT GREATEST(60, 137, 224), LEAST(60, 137, 224);
----
224 60

statement ok
CREATE TABLE t_null_875 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_875 VALUES
(1, 60, 'LOW'),
(2, NULL, 'MISSING'),
(3, 224, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 137 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_15')
FROM t_null_875
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_15

query I
SELECT COUNT(*) FROM t_null_875 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_875;
