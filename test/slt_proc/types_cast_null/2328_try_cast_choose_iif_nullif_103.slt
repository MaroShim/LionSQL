# test/slt_proc/types_cast_null/2328_try_cast_choose_iif_nullif_103.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (103)

query ITIT
SELECT TRY_CAST('1346' AS INT),
       ISNULL(TRY_CAST('not_an_int_103' AS INT), -999),
       ISNULL(NULLIF(1346, 1346), 103),
       CHOOSE(2, 'OPT_A_103', 'OPT_B_103', 'OPT_C_103');
----
1346 -999 103 OPT_B_103

query TT
SELECT IIF(1346 > 50, 'LARGE_103', 'SMALL_103'),
       COALESCE(NULL, NULL, 'FALLBACK_103');
----
LARGE_103 FALLBACK_103

statement ok
CREATE TABLE tc_tbl_2328 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2328 VALUES
(1, '1346', 10),
(2, 'bad_103', 515);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2328
ORDER BY id;
----
1 1346
2 515

statement ok
DROP TABLE tc_tbl_2328;
