# test/slt_proc/types_cast_null/880_case_3vl_greatest_least_20.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (20)

query II
SELECT GREATEST(80, 182, 299), LEAST(80, 182, 299);
----
299 80

statement ok
CREATE TABLE t_null_880 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_880 VALUES
(1, 80, 'LOW'),
(2, NULL, 'MISSING'),
(3, 299, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 182 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_20')
FROM t_null_880
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_20

query I
SELECT COUNT(*) FROM t_null_880 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_880;
