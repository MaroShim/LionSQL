# test/slt_proc/types_cast_null/2376_try_cast_choose_iif_nullif_151.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (151)

query ITIT
SELECT TRY_CAST('1970' AS INT),
       ISNULL(TRY_CAST('not_an_int_151' AS INT), -999),
       ISNULL(NULLIF(1970, 1970), 151),
       CHOOSE(2, 'OPT_A_151', 'OPT_B_151', 'OPT_C_151');
----
1970 -999 151 OPT_B_151

query TT
SELECT IIF(1970 > 50, 'LARGE_151', 'SMALL_151'),
       COALESCE(NULL, NULL, 'FALLBACK_151');
----
LARGE_151 FALLBACK_151

statement ok
CREATE TABLE tc_tbl_2376 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2376 VALUES
(1, '1970', 10),
(2, 'bad_151', 755);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2376
ORDER BY id;
----
1 1970
2 755

statement ok
DROP TABLE tc_tbl_2376;
