# test/slt_proc/types_cast_null/2229_try_cast_choose_iif_nullif_004.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (4)

query ITIT
SELECT TRY_CAST('59' AS INT),
       ISNULL(TRY_CAST('not_an_int_4' AS INT), -999),
       ISNULL(NULLIF(59, 59), 4),
       CHOOSE(2, 'OPT_A_4', 'OPT_B_4', 'OPT_C_4');
----
59 -999 4 OPT_B_4

query TT
SELECT IIF(59 > 50, 'LARGE_4', 'SMALL_4'),
       COALESCE(NULL, NULL, 'FALLBACK_4');
----
LARGE_4 FALLBACK_4

statement ok
CREATE TABLE tc_tbl_2229 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2229 VALUES
(1, '59', 10),
(2, 'bad_4', 20);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2229
ORDER BY id;
----
1 59
2 20

statement ok
DROP TABLE tc_tbl_2229;
