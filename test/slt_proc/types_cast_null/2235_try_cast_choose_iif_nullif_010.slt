# test/slt_proc/types_cast_null/2235_try_cast_choose_iif_nullif_010.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (10)

query ITIT
SELECT TRY_CAST('137' AS INT),
       ISNULL(TRY_CAST('not_an_int_10' AS INT), -999),
       ISNULL(NULLIF(137, 137), 10),
       CHOOSE(2, 'OPT_A_10', 'OPT_B_10', 'OPT_C_10');
----
137 -999 10 OPT_B_10

query TT
SELECT IIF(137 > 50, 'LARGE_10', 'SMALL_10'),
       COALESCE(NULL, NULL, 'FALLBACK_10');
----
LARGE_10 FALLBACK_10

statement ok
CREATE TABLE tc_tbl_2235 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2235 VALUES
(1, '137', 10),
(2, 'bad_10', 50);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2235
ORDER BY id;
----
1 137
2 50

statement ok
DROP TABLE tc_tbl_2235;
