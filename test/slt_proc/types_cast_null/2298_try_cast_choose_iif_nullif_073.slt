# test/slt_proc/types_cast_null/2298_try_cast_choose_iif_nullif_073.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (73)

query ITIT
SELECT TRY_CAST('956' AS INT),
       ISNULL(TRY_CAST('not_an_int_73' AS INT), -999),
       ISNULL(NULLIF(956, 956), 73),
       CHOOSE(2, 'OPT_A_73', 'OPT_B_73', 'OPT_C_73');
----
956 -999 73 OPT_B_73

query TT
SELECT IIF(956 > 50, 'LARGE_73', 'SMALL_73'),
       COALESCE(NULL, NULL, 'FALLBACK_73');
----
LARGE_73 FALLBACK_73

statement ok
CREATE TABLE tc_tbl_2298 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2298 VALUES
(1, '956', 10),
(2, 'bad_73', 365);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2298
ORDER BY id;
----
1 956
2 365

statement ok
DROP TABLE tc_tbl_2298;
