# test/slt_proc/types_cast_null/2264_try_cast_choose_iif_nullif_039.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (39)

query ITIT
SELECT TRY_CAST('514' AS INT),
       ISNULL(TRY_CAST('not_an_int_39' AS INT), -999),
       ISNULL(NULLIF(514, 514), 39),
       CHOOSE(1, 'OPT_A_39', 'OPT_B_39', 'OPT_C_39');
----
514 -999 39 OPT_A_39

query TT
SELECT IIF(514 > 50, 'LARGE_39', 'SMALL_39'),
       COALESCE(NULL, NULL, 'FALLBACK_39');
----
LARGE_39 FALLBACK_39

statement ok
CREATE TABLE tc_tbl_2264 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2264 VALUES
(1, '514', 10),
(2, 'bad_39', 195);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2264
ORDER BY id;
----
1 514
2 195

statement ok
DROP TABLE tc_tbl_2264;
