# test/slt_proc/types_cast_null/129_cast_null_3vl_04.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (4)

query ITI
SELECT CAST('159' AS INT) + 4, CAST(159 AS VARCHAR(20)), TRY_CAST('159' AS INT);
----
163 159 159

query IIT
SELECT ISNUMERIC('159'), ISNUMERIC('err_4z'), ISNULL(CAST(TRY_CAST('err_4z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(1, 'Alpha_4', 'Beta_4', 'Gamma_4', 'Delta_4'), IIF(159 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_4'), COALESCE(NULL, NULL, 'COAL_4');
----
Alpha_4 YES DEF_4 COAL_4

query II
SELECT ISNULL(NULLIF(159, 159), -1), NULLIF(159, 0);
----
-1 159
