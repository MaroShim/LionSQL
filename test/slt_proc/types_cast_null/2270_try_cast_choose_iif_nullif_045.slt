# test/slt_proc/types_cast_null/2270_try_cast_choose_iif_nullif_045.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (45)

query ITIT
SELECT TRY_CAST('592' AS INT),
       ISNULL(TRY_CAST('not_an_int_45' AS INT), -999),
       ISNULL(NULLIF(592, 592), 45),
       CHOOSE(1, 'OPT_A_45', 'OPT_B_45', 'OPT_C_45');
----
592 -999 45 OPT_A_45

query TT
SELECT IIF(592 > 50, 'LARGE_45', 'SMALL_45'),
       COALESCE(NULL, NULL, 'FALLBACK_45');
----
LARGE_45 FALLBACK_45

statement ok
CREATE TABLE tc_tbl_2270 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2270 VALUES
(1, '592', 10),
(2, 'bad_45', 225);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2270
ORDER BY id;
----
1 592
2 225

statement ok
DROP TABLE tc_tbl_2270;
