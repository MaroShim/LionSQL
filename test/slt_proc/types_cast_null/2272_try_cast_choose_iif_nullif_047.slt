# test/slt_proc/types_cast_null/2272_try_cast_choose_iif_nullif_047.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (47)

query ITIT
SELECT TRY_CAST('618' AS INT),
       ISNULL(TRY_CAST('not_an_int_47' AS INT), -999),
       ISNULL(NULLIF(618, 618), 47),
       CHOOSE(3, 'OPT_A_47', 'OPT_B_47', 'OPT_C_47');
----
618 -999 47 OPT_C_47

query TT
SELECT IIF(618 > 50, 'LARGE_47', 'SMALL_47'),
       COALESCE(NULL, NULL, 'FALLBACK_47');
----
LARGE_47 FALLBACK_47

statement ok
CREATE TABLE tc_tbl_2272 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2272 VALUES
(1, '618', 10),
(2, 'bad_47', 235);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2272
ORDER BY id;
----
1 618
2 235

statement ok
DROP TABLE tc_tbl_2272;
