# test/slt_proc/types_cast_null/2340_try_cast_choose_iif_nullif_115.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (115)

query ITIT
SELECT TRY_CAST('1502' AS INT),
       ISNULL(TRY_CAST('not_an_int_115' AS INT), -999),
       ISNULL(NULLIF(1502, 1502), 115),
       CHOOSE(2, 'OPT_A_115', 'OPT_B_115', 'OPT_C_115');
----
1502 -999 115 OPT_B_115

query TT
SELECT IIF(1502 > 50, 'LARGE_115', 'SMALL_115'),
       COALESCE(NULL, NULL, 'FALLBACK_115');
----
LARGE_115 FALLBACK_115

statement ok
CREATE TABLE tc_tbl_2340 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2340 VALUES
(1, '1502', 10),
(2, 'bad_115', 575);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2340
ORDER BY id;
----
1 1502
2 575

statement ok
DROP TABLE tc_tbl_2340;
