# test/slt_proc/types_cast_null/871_case_3vl_greatest_least_11.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (11)

query II
SELECT GREATEST(44, 101, 164), LEAST(44, 101, 164);
----
164 44

statement ok
CREATE TABLE t_null_871 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_871 VALUES
(1, 44, 'LOW'),
(2, NULL, 'MISSING'),
(3, 164, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 101 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_11')
FROM t_null_871
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_11

query I
SELECT COUNT(*) FROM t_null_871 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_871;
