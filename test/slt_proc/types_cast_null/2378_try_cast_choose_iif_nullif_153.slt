# test/slt_proc/types_cast_null/2378_try_cast_choose_iif_nullif_153.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (153)

query ITIT
SELECT TRY_CAST('1996' AS INT),
       ISNULL(TRY_CAST('not_an_int_153' AS INT), -999),
       ISNULL(NULLIF(1996, 1996), 153),
       CHOOSE(1, 'OPT_A_153', 'OPT_B_153', 'OPT_C_153');
----
1996 -999 153 OPT_A_153

query TT
SELECT IIF(1996 > 50, 'LARGE_153', 'SMALL_153'),
       COALESCE(NULL, NULL, 'FALLBACK_153');
----
LARGE_153 FALLBACK_153

statement ok
CREATE TABLE tc_tbl_2378 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2378 VALUES
(1, '1996', 10),
(2, 'bad_153', 765);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2378
ORDER BY id;
----
1 1996
2 765

statement ok
DROP TABLE tc_tbl_2378;
