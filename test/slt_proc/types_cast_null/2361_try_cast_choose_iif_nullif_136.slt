# test/slt_proc/types_cast_null/2361_try_cast_choose_iif_nullif_136.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (136)

query ITIT
SELECT TRY_CAST('1775' AS INT),
       ISNULL(TRY_CAST('not_an_int_136' AS INT), -999),
       ISNULL(NULLIF(1775, 1775), 136),
       CHOOSE(2, 'OPT_A_136', 'OPT_B_136', 'OPT_C_136');
----
1775 -999 136 OPT_B_136

query TT
SELECT IIF(1775 > 50, 'LARGE_136', 'SMALL_136'),
       COALESCE(NULL, NULL, 'FALLBACK_136');
----
LARGE_136 FALLBACK_136

statement ok
CREATE TABLE tc_tbl_2361 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2361 VALUES
(1, '1775', 10),
(2, 'bad_136', 680);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2361
ORDER BY id;
----
1 1775
2 680

statement ok
DROP TABLE tc_tbl_2361;
