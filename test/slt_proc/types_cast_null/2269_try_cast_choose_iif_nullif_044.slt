# test/slt_proc/types_cast_null/2269_try_cast_choose_iif_nullif_044.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (44)

query ITIT
SELECT TRY_CAST('579' AS INT),
       ISNULL(TRY_CAST('not_an_int_44' AS INT), -999),
       ISNULL(NULLIF(579, 579), 44),
       CHOOSE(3, 'OPT_A_44', 'OPT_B_44', 'OPT_C_44');
----
579 -999 44 OPT_C_44

query TT
SELECT IIF(579 > 50, 'LARGE_44', 'SMALL_44'),
       COALESCE(NULL, NULL, 'FALLBACK_44');
----
LARGE_44 FALLBACK_44

statement ok
CREATE TABLE tc_tbl_2269 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2269 VALUES
(1, '579', 10),
(2, 'bad_44', 220);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2269
ORDER BY id;
----
1 579
2 220

statement ok
DROP TABLE tc_tbl_2269;
