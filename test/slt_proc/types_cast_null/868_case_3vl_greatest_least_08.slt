# test/slt_proc/types_cast_null/868_case_3vl_greatest_least_08.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (8)

query II
SELECT GREATEST(32, 74, 119), LEAST(32, 74, 119);
----
119 32

statement ok
CREATE TABLE t_null_868 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_868 VALUES
(1, 32, 'LOW'),
(2, NULL, 'MISSING'),
(3, 119, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 74 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_8')
FROM t_null_868
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_8

query I
SELECT COUNT(*) FROM t_null_868 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_868;
