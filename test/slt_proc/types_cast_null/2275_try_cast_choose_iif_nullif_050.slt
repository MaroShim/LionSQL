# test/slt_proc/types_cast_null/2275_try_cast_choose_iif_nullif_050.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (50)

query ITIT
SELECT TRY_CAST('657' AS INT),
       ISNULL(TRY_CAST('not_an_int_50' AS INT), -999),
       ISNULL(NULLIF(657, 657), 50),
       CHOOSE(3, 'OPT_A_50', 'OPT_B_50', 'OPT_C_50');
----
657 -999 50 OPT_C_50

query TT
SELECT IIF(657 > 50, 'LARGE_50', 'SMALL_50'),
       COALESCE(NULL, NULL, 'FALLBACK_50');
----
LARGE_50 FALLBACK_50

statement ok
CREATE TABLE tc_tbl_2275 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2275 VALUES
(1, '657', 10),
(2, 'bad_50', 250);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2275
ORDER BY id;
----
1 657
2 250

statement ok
DROP TABLE tc_tbl_2275;
