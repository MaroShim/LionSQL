# test/slt_proc/types_cast_null/866_case_3vl_greatest_least_06.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (6)

query II
SELECT GREATEST(24, 56, 89), LEAST(24, 56, 89);
----
89 24

statement ok
CREATE TABLE t_null_866 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_866 VALUES
(1, 24, 'LOW'),
(2, NULL, 'MISSING'),
(3, 89, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 56 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_6')
FROM t_null_866
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_6

query I
SELECT COUNT(*) FROM t_null_866 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_866;
