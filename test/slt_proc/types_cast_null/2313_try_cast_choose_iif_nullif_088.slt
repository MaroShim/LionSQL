# test/slt_proc/types_cast_null/2313_try_cast_choose_iif_nullif_088.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (88)

query ITIT
SELECT TRY_CAST('1151' AS INT),
       ISNULL(TRY_CAST('not_an_int_88' AS INT), -999),
       ISNULL(NULLIF(1151, 1151), 88),
       CHOOSE(2, 'OPT_A_88', 'OPT_B_88', 'OPT_C_88');
----
1151 -999 88 OPT_B_88

query TT
SELECT IIF(1151 > 50, 'LARGE_88', 'SMALL_88'),
       COALESCE(NULL, NULL, 'FALLBACK_88');
----
LARGE_88 FALLBACK_88

statement ok
CREATE TABLE tc_tbl_2313 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2313 VALUES
(1, '1151', 10),
(2, 'bad_88', 440);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2313
ORDER BY id;
----
1 1151
2 440

statement ok
DROP TABLE tc_tbl_2313;
