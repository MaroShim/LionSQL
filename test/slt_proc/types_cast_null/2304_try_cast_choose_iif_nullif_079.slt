# test/slt_proc/types_cast_null/2304_try_cast_choose_iif_nullif_079.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (79)

query ITIT
SELECT TRY_CAST('1034' AS INT),
       ISNULL(TRY_CAST('not_an_int_79' AS INT), -999),
       ISNULL(NULLIF(1034, 1034), 79),
       CHOOSE(2, 'OPT_A_79', 'OPT_B_79', 'OPT_C_79');
----
1034 -999 79 OPT_B_79

query TT
SELECT IIF(1034 > 50, 'LARGE_79', 'SMALL_79'),
       COALESCE(NULL, NULL, 'FALLBACK_79');
----
LARGE_79 FALLBACK_79

statement ok
CREATE TABLE tc_tbl_2304 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2304 VALUES
(1, '1034', 10),
(2, 'bad_79', 395);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2304
ORDER BY id;
----
1 1034
2 395

statement ok
DROP TABLE tc_tbl_2304;
