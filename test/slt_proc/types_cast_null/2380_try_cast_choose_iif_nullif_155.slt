# test/slt_proc/types_cast_null/2380_try_cast_choose_iif_nullif_155.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (155)

query ITIT
SELECT TRY_CAST('2022' AS INT),
       ISNULL(TRY_CAST('not_an_int_155' AS INT), -999),
       ISNULL(NULLIF(2022, 2022), 155),
       CHOOSE(3, 'OPT_A_155', 'OPT_B_155', 'OPT_C_155');
----
2022 -999 155 OPT_C_155

query TT
SELECT IIF(2022 > 50, 'LARGE_155', 'SMALL_155'),
       COALESCE(NULL, NULL, 'FALLBACK_155');
----
LARGE_155 FALLBACK_155

statement ok
CREATE TABLE tc_tbl_2380 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2380 VALUES
(1, '2022', 10),
(2, 'bad_155', 775);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2380
ORDER BY id;
----
1 2022
2 775

statement ok
DROP TABLE tc_tbl_2380;
