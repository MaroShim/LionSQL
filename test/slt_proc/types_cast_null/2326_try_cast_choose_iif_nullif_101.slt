# test/slt_proc/types_cast_null/2326_try_cast_choose_iif_nullif_101.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (101)

query ITIT
SELECT TRY_CAST('1320' AS INT),
       ISNULL(TRY_CAST('not_an_int_101' AS INT), -999),
       ISNULL(NULLIF(1320, 1320), 101),
       CHOOSE(3, 'OPT_A_101', 'OPT_B_101', 'OPT_C_101');
----
1320 -999 101 OPT_C_101

query TT
SELECT IIF(1320 > 50, 'LARGE_101', 'SMALL_101'),
       COALESCE(NULL, NULL, 'FALLBACK_101');
----
LARGE_101 FALLBACK_101

statement ok
CREATE TABLE tc_tbl_2326 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2326 VALUES
(1, '1320', 10),
(2, 'bad_101', 505);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2326
ORDER BY id;
----
1 1320
2 505

statement ok
DROP TABLE tc_tbl_2326;
