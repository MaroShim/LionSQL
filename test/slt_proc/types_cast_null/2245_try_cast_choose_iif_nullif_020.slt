# test/slt_proc/types_cast_null/2245_try_cast_choose_iif_nullif_020.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (20)

query ITIT
SELECT TRY_CAST('267' AS INT),
       ISNULL(TRY_CAST('not_an_int_20' AS INT), -999),
       ISNULL(NULLIF(267, 267), 20),
       CHOOSE(3, 'OPT_A_20', 'OPT_B_20', 'OPT_C_20');
----
267 -999 20 OPT_C_20

query TT
SELECT IIF(267 > 50, 'LARGE_20', 'SMALL_20'),
       COALESCE(NULL, NULL, 'FALLBACK_20');
----
LARGE_20 FALLBACK_20

statement ok
CREATE TABLE tc_tbl_2245 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2245 VALUES
(1, '267', 10),
(2, 'bad_20', 100);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2245
ORDER BY id;
----
1 267
2 100

statement ok
DROP TABLE tc_tbl_2245;
