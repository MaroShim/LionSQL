# test/slt_proc/types_cast_null/2261_try_cast_choose_iif_nullif_036.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (36)

query ITIT
SELECT TRY_CAST('475' AS INT),
       ISNULL(TRY_CAST('not_an_int_36' AS INT), -999),
       ISNULL(NULLIF(475, 475), 36),
       CHOOSE(1, 'OPT_A_36', 'OPT_B_36', 'OPT_C_36');
----
475 -999 36 OPT_A_36

query TT
SELECT IIF(475 > 50, 'LARGE_36', 'SMALL_36'),
       COALESCE(NULL, NULL, 'FALLBACK_36');
----
LARGE_36 FALLBACK_36

statement ok
CREATE TABLE tc_tbl_2261 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2261 VALUES
(1, '475', 10),
(2, 'bad_36', 180);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2261
ORDER BY id;
----
1 475
2 180

statement ok
DROP TABLE tc_tbl_2261;
