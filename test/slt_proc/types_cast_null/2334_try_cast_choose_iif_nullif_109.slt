# test/slt_proc/types_cast_null/2334_try_cast_choose_iif_nullif_109.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (109)

query ITIT
SELECT TRY_CAST('1424' AS INT),
       ISNULL(TRY_CAST('not_an_int_109' AS INT), -999),
       ISNULL(NULLIF(1424, 1424), 109),
       CHOOSE(2, 'OPT_A_109', 'OPT_B_109', 'OPT_C_109');
----
1424 -999 109 OPT_B_109

query TT
SELECT IIF(1424 > 50, 'LARGE_109', 'SMALL_109'),
       COALESCE(NULL, NULL, 'FALLBACK_109');
----
LARGE_109 FALLBACK_109

statement ok
CREATE TABLE tc_tbl_2334 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2334 VALUES
(1, '1424', 10),
(2, 'bad_109', 545);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2334
ORDER BY id;
----
1 1424
2 545

statement ok
DROP TABLE tc_tbl_2334;
