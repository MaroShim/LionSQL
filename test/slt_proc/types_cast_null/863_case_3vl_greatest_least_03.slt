# test/slt_proc/types_cast_null/863_case_3vl_greatest_least_03.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (3)

query II
SELECT GREATEST(12, 29, 44), LEAST(12, 29, 44);
----
44 12

statement ok
CREATE TABLE t_null_863 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_863 VALUES
(1, 12, 'LOW'),
(2, NULL, 'MISSING'),
(3, 44, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 29 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_3')
FROM t_null_863
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_3

query I
SELECT COUNT(*) FROM t_null_863 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_863;
