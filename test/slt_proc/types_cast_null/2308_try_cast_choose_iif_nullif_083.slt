# test/slt_proc/types_cast_null/2308_try_cast_choose_iif_nullif_083.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (83)

query ITIT
SELECT TRY_CAST('1086' AS INT),
       ISNULL(TRY_CAST('not_an_int_83' AS INT), -999),
       ISNULL(NULLIF(1086, 1086), 83),
       CHOOSE(3, 'OPT_A_83', 'OPT_B_83', 'OPT_C_83');
----
1086 -999 83 OPT_C_83

query TT
SELECT IIF(1086 > 50, 'LARGE_83', 'SMALL_83'),
       COALESCE(NULL, NULL, 'FALLBACK_83');
----
LARGE_83 FALLBACK_83

statement ok
CREATE TABLE tc_tbl_2308 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2308 VALUES
(1, '1086', 10),
(2, 'bad_83', 415);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2308
ORDER BY id;
----
1 1086
2 415

statement ok
DROP TABLE tc_tbl_2308;
