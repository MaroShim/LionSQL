# test/slt_proc/types_cast_null/2232_try_cast_choose_iif_nullif_007.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (7)

query ITIT
SELECT TRY_CAST('98' AS INT),
       ISNULL(TRY_CAST('not_an_int_7' AS INT), -999),
       ISNULL(NULLIF(98, 98), 7),
       CHOOSE(2, 'OPT_A_7', 'OPT_B_7', 'OPT_C_7');
----
98 -999 7 OPT_B_7

query TT
SELECT IIF(98 > 50, 'LARGE_7', 'SMALL_7'),
       COALESCE(NULL, NULL, 'FALLBACK_7');
----
LARGE_7 FALLBACK_7

statement ok
CREATE TABLE tc_tbl_2232 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2232 VALUES
(1, '98', 10),
(2, 'bad_7', 35);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2232
ORDER BY id;
----
1 98
2 35

statement ok
DROP TABLE tc_tbl_2232;
