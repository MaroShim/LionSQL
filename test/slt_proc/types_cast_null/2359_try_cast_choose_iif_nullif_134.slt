# test/slt_proc/types_cast_null/2359_try_cast_choose_iif_nullif_134.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (134)

query ITIT
SELECT TRY_CAST('1749' AS INT),
       ISNULL(TRY_CAST('not_an_int_134' AS INT), -999),
       ISNULL(NULLIF(1749, 1749), 134),
       CHOOSE(3, 'OPT_A_134', 'OPT_B_134', 'OPT_C_134');
----
1749 -999 134 OPT_C_134

query TT
SELECT IIF(1749 > 50, 'LARGE_134', 'SMALL_134'),
       COALESCE(NULL, NULL, 'FALLBACK_134');
----
LARGE_134 FALLBACK_134

statement ok
CREATE TABLE tc_tbl_2359 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2359 VALUES
(1, '1749', 10),
(2, 'bad_134', 670);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2359
ORDER BY id;
----
1 1749
2 670

statement ok
DROP TABLE tc_tbl_2359;
