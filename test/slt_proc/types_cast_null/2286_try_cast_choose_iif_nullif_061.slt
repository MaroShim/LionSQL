# test/slt_proc/types_cast_null/2286_try_cast_choose_iif_nullif_061.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (61)

query ITIT
SELECT TRY_CAST('800' AS INT),
       ISNULL(TRY_CAST('not_an_int_61' AS INT), -999),
       ISNULL(NULLIF(800, 800), 61),
       CHOOSE(2, 'OPT_A_61', 'OPT_B_61', 'OPT_C_61');
----
800 -999 61 OPT_B_61

query TT
SELECT IIF(800 > 50, 'LARGE_61', 'SMALL_61'),
       COALESCE(NULL, NULL, 'FALLBACK_61');
----
LARGE_61 FALLBACK_61

statement ok
CREATE TABLE tc_tbl_2286 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2286 VALUES
(1, '800', 10),
(2, 'bad_61', 305);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2286
ORDER BY id;
----
1 800
2 305

statement ok
DROP TABLE tc_tbl_2286;
