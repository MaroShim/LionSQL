# test/slt_proc/types_cast_null/873_case_3vl_greatest_least_13.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (13)

query II
SELECT GREATEST(52, 119, 194), LEAST(52, 119, 194);
----
194 52

statement ok
CREATE TABLE t_null_873 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_873 VALUES
(1, 52, 'LOW'),
(2, NULL, 'MISSING'),
(3, 194, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 119 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_13')
FROM t_null_873
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_13

query I
SELECT COUNT(*) FROM t_null_873 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_873;
