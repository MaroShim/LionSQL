# test/slt_proc/types_cast_null/2258_try_cast_choose_iif_nullif_033.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (33)

query ITIT
SELECT TRY_CAST('436' AS INT),
       ISNULL(TRY_CAST('not_an_int_33' AS INT), -999),
       ISNULL(NULLIF(436, 436), 33),
       CHOOSE(1, 'OPT_A_33', 'OPT_B_33', 'OPT_C_33');
----
436 -999 33 OPT_A_33

query TT
SELECT IIF(436 > 50, 'LARGE_33', 'SMALL_33'),
       COALESCE(NULL, NULL, 'FALLBACK_33');
----
LARGE_33 FALLBACK_33

statement ok
CREATE TABLE tc_tbl_2258 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2258 VALUES
(1, '436', 10),
(2, 'bad_33', 165);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2258
ORDER BY id;
----
1 436
2 165

statement ok
DROP TABLE tc_tbl_2258;
