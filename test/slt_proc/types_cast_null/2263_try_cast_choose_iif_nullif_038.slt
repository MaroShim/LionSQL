# test/slt_proc/types_cast_null/2263_try_cast_choose_iif_nullif_038.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (38)

query ITIT
SELECT TRY_CAST('501' AS INT),
       ISNULL(TRY_CAST('not_an_int_38' AS INT), -999),
       ISNULL(NULLIF(501, 501), 38),
       CHOOSE(3, 'OPT_A_38', 'OPT_B_38', 'OPT_C_38');
----
501 -999 38 OPT_C_38

query TT
SELECT IIF(501 > 50, 'LARGE_38', 'SMALL_38'),
       COALESCE(NULL, NULL, 'FALLBACK_38');
----
LARGE_38 FALLBACK_38

statement ok
CREATE TABLE tc_tbl_2263 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2263 VALUES
(1, '501', 10),
(2, 'bad_38', 190);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2263
ORDER BY id;
----
1 501
2 190

statement ok
DROP TABLE tc_tbl_2263;
