# test/slt_proc/types_cast_null/2239_try_cast_choose_iif_nullif_014.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (14)

query ITIT
SELECT TRY_CAST('189' AS INT),
       ISNULL(TRY_CAST('not_an_int_14' AS INT), -999),
       ISNULL(NULLIF(189, 189), 14),
       CHOOSE(3, 'OPT_A_14', 'OPT_B_14', 'OPT_C_14');
----
189 -999 14 OPT_C_14

query TT
SELECT IIF(189 > 50, 'LARGE_14', 'SMALL_14'),
       COALESCE(NULL, NULL, 'FALLBACK_14');
----
LARGE_14 FALLBACK_14

statement ok
CREATE TABLE tc_tbl_2239 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2239 VALUES
(1, '189', 10),
(2, 'bad_14', 70);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2239
ORDER BY id;
----
1 189
2 70

statement ok
DROP TABLE tc_tbl_2239;
