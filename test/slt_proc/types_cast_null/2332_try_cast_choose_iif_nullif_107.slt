# test/slt_proc/types_cast_null/2332_try_cast_choose_iif_nullif_107.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (107)

query ITIT
SELECT TRY_CAST('1398' AS INT),
       ISNULL(TRY_CAST('not_an_int_107' AS INT), -999),
       ISNULL(NULLIF(1398, 1398), 107),
       CHOOSE(3, 'OPT_A_107', 'OPT_B_107', 'OPT_C_107');
----
1398 -999 107 OPT_C_107

query TT
SELECT IIF(1398 > 50, 'LARGE_107', 'SMALL_107'),
       COALESCE(NULL, NULL, 'FALLBACK_107');
----
LARGE_107 FALLBACK_107

statement ok
CREATE TABLE tc_tbl_2332 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2332 VALUES
(1, '1398', 10),
(2, 'bad_107', 535);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2332
ORDER BY id;
----
1 1398
2 535

statement ok
DROP TABLE tc_tbl_2332;
