# test/slt_proc/types_cast_null/861_case_3vl_greatest_least_01.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (1)

query II
SELECT GREATEST(4, 11, 14), LEAST(4, 11, 14);
----
14 4

statement ok
CREATE TABLE t_null_861 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_861 VALUES
(1, 4, 'LOW'),
(2, NULL, 'MISSING'),
(3, 14, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 11 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_1')
FROM t_null_861
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_1

query I
SELECT COUNT(*) FROM t_null_861 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_861;
