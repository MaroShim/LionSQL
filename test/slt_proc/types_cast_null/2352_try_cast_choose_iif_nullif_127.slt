# test/slt_proc/types_cast_null/2352_try_cast_choose_iif_nullif_127.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (127)

query ITIT
SELECT TRY_CAST('1658' AS INT),
       ISNULL(TRY_CAST('not_an_int_127' AS INT), -999),
       ISNULL(NULLIF(1658, 1658), 127),
       CHOOSE(2, 'OPT_A_127', 'OPT_B_127', 'OPT_C_127');
----
1658 -999 127 OPT_B_127

query TT
SELECT IIF(1658 > 50, 'LARGE_127', 'SMALL_127'),
       COALESCE(NULL, NULL, 'FALLBACK_127');
----
LARGE_127 FALLBACK_127

statement ok
CREATE TABLE tc_tbl_2352 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2352 VALUES
(1, '1658', 10),
(2, 'bad_127', 635);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2352
ORDER BY id;
----
1 1658
2 635

statement ok
DROP TABLE tc_tbl_2352;
