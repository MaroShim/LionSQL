# test/slt_proc/types_cast_null/2257_try_cast_choose_iif_nullif_032.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (32)

query ITIT
SELECT TRY_CAST('423' AS INT),
       ISNULL(TRY_CAST('not_an_int_32' AS INT), -999),
       ISNULL(NULLIF(423, 423), 32),
       CHOOSE(3, 'OPT_A_32', 'OPT_B_32', 'OPT_C_32');
----
423 -999 32 OPT_C_32

query TT
SELECT IIF(423 > 50, 'LARGE_32', 'SMALL_32'),
       COALESCE(NULL, NULL, 'FALLBACK_32');
----
LARGE_32 FALLBACK_32

statement ok
CREATE TABLE tc_tbl_2257 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2257 VALUES
(1, '423', 10),
(2, 'bad_32', 160);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2257
ORDER BY id;
----
1 423
2 160

statement ok
DROP TABLE tc_tbl_2257;
