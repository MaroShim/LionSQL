# test/slt_proc/types_cast_null/2373_try_cast_choose_iif_nullif_148.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (148)

query ITIT
SELECT TRY_CAST('1931' AS INT),
       ISNULL(TRY_CAST('not_an_int_148' AS INT), -999),
       ISNULL(NULLIF(1931, 1931), 148),
       CHOOSE(2, 'OPT_A_148', 'OPT_B_148', 'OPT_C_148');
----
1931 -999 148 OPT_B_148

query TT
SELECT IIF(1931 > 50, 'LARGE_148', 'SMALL_148'),
       COALESCE(NULL, NULL, 'FALLBACK_148');
----
LARGE_148 FALLBACK_148

statement ok
CREATE TABLE tc_tbl_2373 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2373 VALUES
(1, '1931', 10),
(2, 'bad_148', 740);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2373
ORDER BY id;
----
1 1931
2 740

statement ok
DROP TABLE tc_tbl_2373;
