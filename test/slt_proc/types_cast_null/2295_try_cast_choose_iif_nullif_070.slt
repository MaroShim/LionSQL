# test/slt_proc/types_cast_null/2295_try_cast_choose_iif_nullif_070.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (70)

query ITIT
SELECT TRY_CAST('917' AS INT),
       ISNULL(TRY_CAST('not_an_int_70' AS INT), -999),
       ISNULL(NULLIF(917, 917), 70),
       CHOOSE(2, 'OPT_A_70', 'OPT_B_70', 'OPT_C_70');
----
917 -999 70 OPT_B_70

query TT
SELECT IIF(917 > 50, 'LARGE_70', 'SMALL_70'),
       COALESCE(NULL, NULL, 'FALLBACK_70');
----
LARGE_70 FALLBACK_70

statement ok
CREATE TABLE tc_tbl_2295 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2295 VALUES
(1, '917', 10),
(2, 'bad_70', 350);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2295
ORDER BY id;
----
1 917
2 350

statement ok
DROP TABLE tc_tbl_2295;
