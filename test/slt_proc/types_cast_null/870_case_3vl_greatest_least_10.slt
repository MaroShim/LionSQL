# test/slt_proc/types_cast_null/870_case_3vl_greatest_least_10.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (10)

query II
SELECT GREATEST(40, 92, 149), LEAST(40, 92, 149);
----
149 40

statement ok
CREATE TABLE t_null_870 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_870 VALUES
(1, 40, 'LOW'),
(2, NULL, 'MISSING'),
(3, 149, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 92 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_10')
FROM t_null_870
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_10

query I
SELECT COUNT(*) FROM t_null_870 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_870;
