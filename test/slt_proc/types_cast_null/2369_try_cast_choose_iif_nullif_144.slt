# test/slt_proc/types_cast_null/2369_try_cast_choose_iif_nullif_144.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (144)

query ITIT
SELECT TRY_CAST('1879' AS INT),
       ISNULL(TRY_CAST('not_an_int_144' AS INT), -999),
       ISNULL(NULLIF(1879, 1879), 144),
       CHOOSE(1, 'OPT_A_144', 'OPT_B_144', 'OPT_C_144');
----
1879 -999 144 OPT_A_144

query TT
SELECT IIF(1879 > 50, 'LARGE_144', 'SMALL_144'),
       COALESCE(NULL, NULL, 'FALLBACK_144');
----
LARGE_144 FALLBACK_144

statement ok
CREATE TABLE tc_tbl_2369 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2369 VALUES
(1, '1879', 10),
(2, 'bad_144', 720);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2369
ORDER BY id;
----
1 1879
2 720

statement ok
DROP TABLE tc_tbl_2369;
