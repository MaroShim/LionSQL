# test/slt_proc/types_cast_null/2303_try_cast_choose_iif_nullif_078.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (78)

query ITIT
SELECT TRY_CAST('1021' AS INT),
       ISNULL(TRY_CAST('not_an_int_78' AS INT), -999),
       ISNULL(NULLIF(1021, 1021), 78),
       CHOOSE(1, 'OPT_A_78', 'OPT_B_78', 'OPT_C_78');
----
1021 -999 78 OPT_A_78

query TT
SELECT IIF(1021 > 50, 'LARGE_78', 'SMALL_78'),
       COALESCE(NULL, NULL, 'FALLBACK_78');
----
LARGE_78 FALLBACK_78

statement ok
CREATE TABLE tc_tbl_2303 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2303 VALUES
(1, '1021', 10),
(2, 'bad_78', 390);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2303
ORDER BY id;
----
1 1021
2 390

statement ok
DROP TABLE tc_tbl_2303;
