# test/slt_proc/types_cast_null/2379_try_cast_choose_iif_nullif_154.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (154)

query ITIT
SELECT TRY_CAST('2009' AS INT),
       ISNULL(TRY_CAST('not_an_int_154' AS INT), -999),
       ISNULL(NULLIF(2009, 2009), 154),
       CHOOSE(2, 'OPT_A_154', 'OPT_B_154', 'OPT_C_154');
----
2009 -999 154 OPT_B_154

query TT
SELECT IIF(2009 > 50, 'LARGE_154', 'SMALL_154'),
       COALESCE(NULL, NULL, 'FALLBACK_154');
----
LARGE_154 FALLBACK_154

statement ok
CREATE TABLE tc_tbl_2379 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2379 VALUES
(1, '2009', 10),
(2, 'bad_154', 770);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2379
ORDER BY id;
----
1 2009
2 770

statement ok
DROP TABLE tc_tbl_2379;
