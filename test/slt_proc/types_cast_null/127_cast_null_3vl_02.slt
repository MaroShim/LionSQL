# test/slt_proc/types_cast_null/127_cast_null_3vl_02.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (2)

query ITI
SELECT CAST('85' AS INT) + 2, CAST(85 AS VARCHAR(20)), TRY_CAST('85' AS INT);
----
87 85 85

query IIT
SELECT ISNUMERIC('85'), ISNUMERIC('err_2z'), ISNULL(CAST(TRY_CAST('err_2z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(3, 'Alpha_2', 'Beta_2', 'Gamma_2', 'Delta_2'), IIF(85 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_2'), COALESCE(NULL, NULL, 'COAL_2');
----
Gamma_2 YES DEF_2 COAL_2

query II
SELECT ISNULL(NULLIF(85, 85), -1), NULLIF(85, 0);
----
-1 85
