# test/slt_proc/types_cast_null/2364_try_cast_choose_iif_nullif_139.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (139)

query ITIT
SELECT TRY_CAST('1814' AS INT),
       ISNULL(TRY_CAST('not_an_int_139' AS INT), -999),
       ISNULL(NULLIF(1814, 1814), 139),
       CHOOSE(2, 'OPT_A_139', 'OPT_B_139', 'OPT_C_139');
----
1814 -999 139 OPT_B_139

query TT
SELECT IIF(1814 > 50, 'LARGE_139', 'SMALL_139'),
       COALESCE(NULL, NULL, 'FALLBACK_139');
----
LARGE_139 FALLBACK_139

statement ok
CREATE TABLE tc_tbl_2364 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2364 VALUES
(1, '1814', 10),
(2, 'bad_139', 695);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2364
ORDER BY id;
----
1 1814
2 695

statement ok
DROP TABLE tc_tbl_2364;
