# test/slt_proc/types_cast_null/2273_try_cast_choose_iif_nullif_048.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (48)

query ITIT
SELECT TRY_CAST('631' AS INT),
       ISNULL(TRY_CAST('not_an_int_48' AS INT), -999),
       ISNULL(NULLIF(631, 631), 48),
       CHOOSE(1, 'OPT_A_48', 'OPT_B_48', 'OPT_C_48');
----
631 -999 48 OPT_A_48

query TT
SELECT IIF(631 > 50, 'LARGE_48', 'SMALL_48'),
       COALESCE(NULL, NULL, 'FALLBACK_48');
----
LARGE_48 FALLBACK_48

statement ok
CREATE TABLE tc_tbl_2273 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2273 VALUES
(1, '631', 10),
(2, 'bad_48', 240);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2273
ORDER BY id;
----
1 631
2 240

statement ok
DROP TABLE tc_tbl_2273;
