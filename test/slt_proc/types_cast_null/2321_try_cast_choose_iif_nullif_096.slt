# test/slt_proc/types_cast_null/2321_try_cast_choose_iif_nullif_096.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (96)

query ITIT
SELECT TRY_CAST('1255' AS INT),
       ISNULL(TRY_CAST('not_an_int_96' AS INT), -999),
       ISNULL(NULLIF(1255, 1255), 96),
       CHOOSE(1, 'OPT_A_96', 'OPT_B_96', 'OPT_C_96');
----
1255 -999 96 OPT_A_96

query TT
SELECT IIF(1255 > 50, 'LARGE_96', 'SMALL_96'),
       COALESCE(NULL, NULL, 'FALLBACK_96');
----
LARGE_96 FALLBACK_96

statement ok
CREATE TABLE tc_tbl_2321 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2321 VALUES
(1, '1255', 10),
(2, 'bad_96', 480);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2321
ORDER BY id;
----
1 1255
2 480

statement ok
DROP TABLE tc_tbl_2321;
