# test/slt_proc/types_cast_null/2283_try_cast_choose_iif_nullif_058.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (58)

query ITIT
SELECT TRY_CAST('761' AS INT),
       ISNULL(TRY_CAST('not_an_int_58' AS INT), -999),
       ISNULL(NULLIF(761, 761), 58),
       CHOOSE(2, 'OPT_A_58', 'OPT_B_58', 'OPT_C_58');
----
761 -999 58 OPT_B_58

query TT
SELECT IIF(761 > 50, 'LARGE_58', 'SMALL_58'),
       COALESCE(NULL, NULL, 'FALLBACK_58');
----
LARGE_58 FALLBACK_58

statement ok
CREATE TABLE tc_tbl_2283 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2283 VALUES
(1, '761', 10),
(2, 'bad_58', 290);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2283
ORDER BY id;
----
1 761
2 290

statement ok
DROP TABLE tc_tbl_2283;
