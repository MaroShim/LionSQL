# test/slt_proc/types_cast_null/2331_try_cast_choose_iif_nullif_106.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (106)

query ITIT
SELECT TRY_CAST('1385' AS INT),
       ISNULL(TRY_CAST('not_an_int_106' AS INT), -999),
       ISNULL(NULLIF(1385, 1385), 106),
       CHOOSE(2, 'OPT_A_106', 'OPT_B_106', 'OPT_C_106');
----
1385 -999 106 OPT_B_106

query TT
SELECT IIF(1385 > 50, 'LARGE_106', 'SMALL_106'),
       COALESCE(NULL, NULL, 'FALLBACK_106');
----
LARGE_106 FALLBACK_106

statement ok
CREATE TABLE tc_tbl_2331 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2331 VALUES
(1, '1385', 10),
(2, 'bad_106', 530);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2331
ORDER BY id;
----
1 1385
2 530

statement ok
DROP TABLE tc_tbl_2331;
