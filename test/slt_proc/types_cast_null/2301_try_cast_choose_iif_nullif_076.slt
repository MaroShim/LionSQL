# test/slt_proc/types_cast_null/2301_try_cast_choose_iif_nullif_076.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (76)

query ITIT
SELECT TRY_CAST('995' AS INT),
       ISNULL(TRY_CAST('not_an_int_76' AS INT), -999),
       ISNULL(NULLIF(995, 995), 76),
       CHOOSE(2, 'OPT_A_76', 'OPT_B_76', 'OPT_C_76');
----
995 -999 76 OPT_B_76

query TT
SELECT IIF(995 > 50, 'LARGE_76', 'SMALL_76'),
       COALESCE(NULL, NULL, 'FALLBACK_76');
----
LARGE_76 FALLBACK_76

statement ok
CREATE TABLE tc_tbl_2301 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2301 VALUES
(1, '995', 10),
(2, 'bad_76', 380);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2301
ORDER BY id;
----
1 995
2 380

statement ok
DROP TABLE tc_tbl_2301;
