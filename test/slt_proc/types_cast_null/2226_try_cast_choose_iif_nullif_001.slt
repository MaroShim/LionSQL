# test/slt_proc/types_cast_null/2226_try_cast_choose_iif_nullif_001.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (1)

query ITIT
SELECT TRY_CAST('20' AS INT),
       ISNULL(TRY_CAST('not_an_int_1' AS INT), -999),
       ISNULL(NULLIF(20, 20), 1),
       CHOOSE(2, 'OPT_A_1', 'OPT_B_1', 'OPT_C_1');
----
20 -999 1 OPT_B_1

query TT
SELECT IIF(20 > 50, 'LARGE_1', 'SMALL_1'),
       COALESCE(NULL, NULL, 'FALLBACK_1');
----
SMALL_1 FALLBACK_1

statement ok
CREATE TABLE tc_tbl_2226 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2226 VALUES
(1, '20', 10),
(2, 'bad_1', 5);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2226
ORDER BY id;
----
1 20
2 5

statement ok
DROP TABLE tc_tbl_2226;
