# test/slt_proc/types_cast_null/869_case_3vl_greatest_least_09.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (9)

query II
SELECT GREATEST(36, 83, 134), LEAST(36, 83, 134);
----
134 36

statement ok
CREATE TABLE t_null_869 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_869 VALUES
(1, 36, 'LOW'),
(2, NULL, 'MISSING'),
(3, 134, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 83 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_9')
FROM t_null_869
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_9

query I
SELECT COUNT(*) FROM t_null_869 WHERE a IS NOT NULL;
----
2

statement ok
