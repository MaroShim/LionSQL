# test/slt_proc/types_cast_null/147_cast_null_3vl_22.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (22)

query ITI
SELECT CAST('825' AS INT) + 22, CAST(825 AS VARCHAR(20)), TRY_CAST('825' AS INT);
----
847 825 825

query IIT
SELECT ISNUMERIC('825'), ISNUMERIC('err_22z'), ISNULL(CAST(TRY_CAST('err_22z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(3, 'Alpha_22', 'Beta_22', 'Gamma_22', 'Delta_22'), IIF(825 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_22'), COALESCE(NULL, NULL, 'COAL_22');
----
Gamma_22 YES DEF_22 COAL_22

query II
SELECT ISNULL(NULLIF(825, 825), -1), NULLIF(825, 0);
----
-1 825
