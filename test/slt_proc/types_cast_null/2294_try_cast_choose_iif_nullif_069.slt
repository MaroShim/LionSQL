# test/slt_proc/types_cast_null/2294_try_cast_choose_iif_nullif_069.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (69)

query ITIT
SELECT TRY_CAST('904' AS INT),
       ISNULL(TRY_CAST('not_an_int_69' AS INT), -999),
       ISNULL(NULLIF(904, 904), 69),
       CHOOSE(1, 'OPT_A_69', 'OPT_B_69', 'OPT_C_69');
----
904 -999 69 OPT_A_69

query TT
SELECT IIF(904 > 50, 'LARGE_69', 'SMALL_69'),
       COALESCE(NULL, NULL, 'FALLBACK_69');
----
LARGE_69 FALLBACK_69

statement ok
CREATE TABLE tc_tbl_2294 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2294 VALUES
(1, '904', 10),
(2, 'bad_69', 345);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2294
ORDER BY id;
----
1 904
2 345

statement ok
DROP TABLE tc_tbl_2294;
