# test/slt_proc/types_cast_null/133_cast_null_3vl_08.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (8)

query ITI
SELECT CAST('307' AS INT) + 8, CAST(307 AS VARCHAR(20)), TRY_CAST('307' AS INT);
----
315 307 307

query IIT
SELECT ISNUMERIC('307'), ISNUMERIC('err_8z'), ISNULL(CAST(TRY_CAST('err_8z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(1, 'Alpha_8', 'Beta_8', 'Gamma_8', 'Delta_8'), IIF(307 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_8'), COALESCE(NULL, NULL, 'COAL_8');
----
Alpha_8 YES DEF_8 COAL_8

query II
SELECT ISNULL(NULLIF(307, 307), -1), NULLIF(307, 0);
----
-1 307
