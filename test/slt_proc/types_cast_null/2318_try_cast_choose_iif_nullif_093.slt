# test/slt_proc/types_cast_null/2318_try_cast_choose_iif_nullif_093.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (93)

query ITIT
SELECT TRY_CAST('1216' AS INT),
       ISNULL(TRY_CAST('not_an_int_93' AS INT), -999),
       ISNULL(NULLIF(1216, 1216), 93),
       CHOOSE(1, 'OPT_A_93', 'OPT_B_93', 'OPT_C_93');
----
1216 -999 93 OPT_A_93

query TT
SELECT IIF(1216 > 50, 'LARGE_93', 'SMALL_93'),
       COALESCE(NULL, NULL, 'FALLBACK_93');
----
LARGE_93 FALLBACK_93

statement ok
CREATE TABLE tc_tbl_2318 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2318 VALUES
(1, '1216', 10),
(2, 'bad_93', 465);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2318
ORDER BY id;
----
1 1216
2 465

statement ok
DROP TABLE tc_tbl_2318;
