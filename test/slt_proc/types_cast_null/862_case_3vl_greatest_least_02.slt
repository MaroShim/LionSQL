# test/slt_proc/types_cast_null/862_case_3vl_greatest_least_02.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (2)

query II
SELECT GREATEST(8, 20, 29), LEAST(8, 20, 29);
----
29 8

statement ok
CREATE TABLE t_null_862 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_862 VALUES
(1, 8, 'LOW'),
(2, NULL, 'MISSING'),
(3, 29, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 20 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_2')
FROM t_null_862
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_2

query I
SELECT COUNT(*) FROM t_null_862 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_862;
