# test/slt_proc/types_cast_null/137_cast_null_3vl_12.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (12)

query ITI
SELECT CAST('455' AS INT) + 12, CAST(455 AS VARCHAR(20)), TRY_CAST('455' AS INT);
----
467 455 455

query IIT
SELECT ISNUMERIC('455'), ISNUMERIC('err_12z'), ISNULL(CAST(TRY_CAST('err_12z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(1, 'Alpha_12', 'Beta_12', 'Gamma_12', 'Delta_12'), IIF(455 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_12'), COALESCE(NULL, NULL, 'COAL_12');
----
Alpha_12 YES DEF_12 COAL_12

query II
SELECT ISNULL(NULLIF(455, 455), -1), NULLIF(455, 0);
----
-1 455
