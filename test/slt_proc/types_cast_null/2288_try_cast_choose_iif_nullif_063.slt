# test/slt_proc/types_cast_null/2288_try_cast_choose_iif_nullif_063.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (63)

query ITIT
SELECT TRY_CAST('826' AS INT),
       ISNULL(TRY_CAST('not_an_int_63' AS INT), -999),
       ISNULL(NULLIF(826, 826), 63),
       CHOOSE(1, 'OPT_A_63', 'OPT_B_63', 'OPT_C_63');
----
826 -999 63 OPT_A_63

query TT
SELECT IIF(826 > 50, 'LARGE_63', 'SMALL_63'),
       COALESCE(NULL, NULL, 'FALLBACK_63');
----
LARGE_63 FALLBACK_63

statement ok
CREATE TABLE tc_tbl_2288 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2288 VALUES
(1, '826', 10),
(2, 'bad_63', 315);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2288
ORDER BY id;
----
1 826
2 315

statement ok
DROP TABLE tc_tbl_2288;
