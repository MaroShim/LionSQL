# test/slt_proc/types_cast_null/2267_try_cast_choose_iif_nullif_042.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (42)

query ITIT
SELECT TRY_CAST('553' AS INT),
       ISNULL(TRY_CAST('not_an_int_42' AS INT), -999),
       ISNULL(NULLIF(553, 553), 42),
       CHOOSE(1, 'OPT_A_42', 'OPT_B_42', 'OPT_C_42');
----
553 -999 42 OPT_A_42

query TT
SELECT IIF(553 > 50, 'LARGE_42', 'SMALL_42'),
       COALESCE(NULL, NULL, 'FALLBACK_42');
----
LARGE_42 FALLBACK_42

statement ok
CREATE TABLE tc_tbl_2267 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2267 VALUES
(1, '553', 10),
(2, 'bad_42', 210);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2267
ORDER BY id;
----
1 553
2 210

statement ok
DROP TABLE tc_tbl_2267;
