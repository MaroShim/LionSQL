# test/slt_proc/types_cast_null/135_cast_null_3vl_10.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (10)

query ITI
SELECT CAST('381' AS INT) + 10, CAST(381 AS VARCHAR(20)), TRY_CAST('381' AS INT);
----
391 381 381

query IIT
SELECT ISNUMERIC('381'), ISNUMERIC('err_10z'), ISNULL(CAST(TRY_CAST('err_10z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(3, 'Alpha_10', 'Beta_10', 'Gamma_10', 'Delta_10'), IIF(381 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_10'), COALESCE(NULL, NULL, 'COAL_10');
----
Gamma_10 YES DEF_10 COAL_10

query II
SELECT ISNULL(NULLIF(381, 381), -1), NULLIF(381, 0);
----
-1 381
