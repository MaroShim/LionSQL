# test/slt_proc/types_cast_null/2244_try_cast_choose_iif_nullif_019.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (19)

query ITIT
SELECT TRY_CAST('254' AS INT),
       ISNULL(TRY_CAST('not_an_int_19' AS INT), -999),
       ISNULL(NULLIF(254, 254), 19),
       CHOOSE(2, 'OPT_A_19', 'OPT_B_19', 'OPT_C_19');
----
254 -999 19 OPT_B_19

query TT
SELECT IIF(254 > 50, 'LARGE_19', 'SMALL_19'),
       COALESCE(NULL, NULL, 'FALLBACK_19');
----
LARGE_19 FALLBACK_19

statement ok
CREATE TABLE tc_tbl_2244 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2244 VALUES
(1, '254', 10),
(2, 'bad_19', 95);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2244
ORDER BY id;
----
1 254
2 95

statement ok
DROP TABLE tc_tbl_2244;
