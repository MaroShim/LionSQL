# test/slt_proc/types_cast_null/2344_try_cast_choose_iif_nullif_119.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (119)

query ITIT
SELECT TRY_CAST('1554' AS INT),
       ISNULL(TRY_CAST('not_an_int_119' AS INT), -999),
       ISNULL(NULLIF(1554, 1554), 119),
       CHOOSE(3, 'OPT_A_119', 'OPT_B_119', 'OPT_C_119');
----
1554 -999 119 OPT_C_119

query TT
SELECT IIF(1554 > 50, 'LARGE_119', 'SMALL_119'),
       COALESCE(NULL, NULL, 'FALLBACK_119');
----
LARGE_119 FALLBACK_119

statement ok
CREATE TABLE tc_tbl_2344 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2344 VALUES
(1, '1554', 10),
(2, 'bad_119', 595);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2344
ORDER BY id;
----
1 1554
2 595

statement ok
DROP TABLE tc_tbl_2344;
