# test/slt_proc/types_cast_null/2339_try_cast_choose_iif_nullif_114.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (114)

query ITIT
SELECT TRY_CAST('1489' AS INT),
       ISNULL(TRY_CAST('not_an_int_114' AS INT), -999),
       ISNULL(NULLIF(1489, 1489), 114),
       CHOOSE(1, 'OPT_A_114', 'OPT_B_114', 'OPT_C_114');
----
1489 -999 114 OPT_A_114

query TT
SELECT IIF(1489 > 50, 'LARGE_114', 'SMALL_114'),
       COALESCE(NULL, NULL, 'FALLBACK_114');
----
LARGE_114 FALLBACK_114

statement ok
CREATE TABLE tc_tbl_2339 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2339 VALUES
(1, '1489', 10),
(2, 'bad_114', 570);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2339
ORDER BY id;
----
1 1489
2 570

statement ok
DROP TABLE tc_tbl_2339;
