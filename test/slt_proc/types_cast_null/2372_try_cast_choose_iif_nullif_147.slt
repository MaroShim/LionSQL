# test/slt_proc/types_cast_null/2372_try_cast_choose_iif_nullif_147.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (147)

query ITIT
SELECT TRY_CAST('1918' AS INT),
       ISNULL(TRY_CAST('not_an_int_147' AS INT), -999),
       ISNULL(NULLIF(1918, 1918), 147),
       CHOOSE(1, 'OPT_A_147', 'OPT_B_147', 'OPT_C_147');
----
1918 -999 147 OPT_A_147

query TT
SELECT IIF(1918 > 50, 'LARGE_147', 'SMALL_147'),
       COALESCE(NULL, NULL, 'FALLBACK_147');
----
LARGE_147 FALLBACK_147

statement ok
CREATE TABLE tc_tbl_2372 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2372 VALUES
(1, '1918', 10),
(2, 'bad_147', 735);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2372
ORDER BY id;
----
1 1918
2 735

statement ok
DROP TABLE tc_tbl_2372;
