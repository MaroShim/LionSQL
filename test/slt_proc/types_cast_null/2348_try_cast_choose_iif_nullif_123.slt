# test/slt_proc/types_cast_null/2348_try_cast_choose_iif_nullif_123.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (123)

query ITIT
SELECT TRY_CAST('1606' AS INT),
       ISNULL(TRY_CAST('not_an_int_123' AS INT), -999),
       ISNULL(NULLIF(1606, 1606), 123),
       CHOOSE(1, 'OPT_A_123', 'OPT_B_123', 'OPT_C_123');
----
1606 -999 123 OPT_A_123

query TT
SELECT IIF(1606 > 50, 'LARGE_123', 'SMALL_123'),
       COALESCE(NULL, NULL, 'FALLBACK_123');
----
LARGE_123 FALLBACK_123

statement ok
CREATE TABLE tc_tbl_2348 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2348 VALUES
(1, '1606', 10),
(2, 'bad_123', 615);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2348
ORDER BY id;
----
1 1606
2 615

statement ok
DROP TABLE tc_tbl_2348;
