# test/slt_proc/types_cast_null/2362_try_cast_choose_iif_nullif_137.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (137)

query ITIT
SELECT TRY_CAST('1788' AS INT),
       ISNULL(TRY_CAST('not_an_int_137' AS INT), -999),
       ISNULL(NULLIF(1788, 1788), 137),
       CHOOSE(3, 'OPT_A_137', 'OPT_B_137', 'OPT_C_137');
----
1788 -999 137 OPT_C_137

query TT
SELECT IIF(1788 > 50, 'LARGE_137', 'SMALL_137'),
       COALESCE(NULL, NULL, 'FALLBACK_137');
----
LARGE_137 FALLBACK_137

statement ok
CREATE TABLE tc_tbl_2362 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2362 VALUES
(1, '1788', 10),
(2, 'bad_137', 685);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2362
ORDER BY id;
----
1 1788
2 685

statement ok
DROP TABLE tc_tbl_2362;
