# test/slt_proc/types_cast_null/2338_try_cast_choose_iif_nullif_113.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (113)

query ITIT
SELECT TRY_CAST('1476' AS INT),
       ISNULL(TRY_CAST('not_an_int_113' AS INT), -999),
       ISNULL(NULLIF(1476, 1476), 113),
       CHOOSE(3, 'OPT_A_113', 'OPT_B_113', 'OPT_C_113');
----
1476 -999 113 OPT_C_113

query TT
SELECT IIF(1476 > 50, 'LARGE_113', 'SMALL_113'),
       COALESCE(NULL, NULL, 'FALLBACK_113');
----
LARGE_113 FALLBACK_113

statement ok
CREATE TABLE tc_tbl_2338 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2338 VALUES
(1, '1476', 10),
(2, 'bad_113', 565);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2338
ORDER BY id;
----
1 1476
2 565

statement ok
DROP TABLE tc_tbl_2338;
