# test/slt_proc/types_cast_null/2297_try_cast_choose_iif_nullif_072.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (72)

query ITIT
SELECT TRY_CAST('943' AS INT),
       ISNULL(TRY_CAST('not_an_int_72' AS INT), -999),
       ISNULL(NULLIF(943, 943), 72),
       CHOOSE(1, 'OPT_A_72', 'OPT_B_72', 'OPT_C_72');
----
943 -999 72 OPT_A_72

query TT
SELECT IIF(943 > 50, 'LARGE_72', 'SMALL_72'),
       COALESCE(NULL, NULL, 'FALLBACK_72');
----
LARGE_72 FALLBACK_72

statement ok
CREATE TABLE tc_tbl_2297 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2297 VALUES
(1, '943', 10),
(2, 'bad_72', 360);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2297
ORDER BY id;
----
1 943
2 360

statement ok
DROP TABLE tc_tbl_2297;
