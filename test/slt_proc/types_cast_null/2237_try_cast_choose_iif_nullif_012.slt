# test/slt_proc/types_cast_null/2237_try_cast_choose_iif_nullif_012.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (12)

query ITIT
SELECT TRY_CAST('163' AS INT),
       ISNULL(TRY_CAST('not_an_int_12' AS INT), -999),
       ISNULL(NULLIF(163, 163), 12),
       CHOOSE(1, 'OPT_A_12', 'OPT_B_12', 'OPT_C_12');
----
163 -999 12 OPT_A_12

query TT
SELECT IIF(163 > 50, 'LARGE_12', 'SMALL_12'),
       COALESCE(NULL, NULL, 'FALLBACK_12');
----
LARGE_12 FALLBACK_12

statement ok
CREATE TABLE tc_tbl_2237 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2237 VALUES
(1, '163', 10),
(2, 'bad_12', 60);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2237
ORDER BY id;
----
1 163
2 60

statement ok
DROP TABLE tc_tbl_2237;
