# test/slt_proc/types_cast_null/882_case_3vl_greatest_least_22.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (22)

query II
SELECT GREATEST(88, 200, 329), LEAST(88, 200, 329);
----
329 88

statement ok
CREATE TABLE t_null_882 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_882 VALUES
(1, 88, 'LOW'),
(2, NULL, 'MISSING'),
(3, 329, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 200 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_22')
FROM t_null_882
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_22

query I
SELECT COUNT(*) FROM t_null_882 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_882;
