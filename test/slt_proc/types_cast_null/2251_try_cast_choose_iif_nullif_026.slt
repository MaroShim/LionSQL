# test/slt_proc/types_cast_null/2251_try_cast_choose_iif_nullif_026.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (26)

query ITIT
SELECT TRY_CAST('345' AS INT),
       ISNULL(TRY_CAST('not_an_int_26' AS INT), -999),
       ISNULL(NULLIF(345, 345), 26),
       CHOOSE(3, 'OPT_A_26', 'OPT_B_26', 'OPT_C_26');
----
345 -999 26 OPT_C_26

query TT
SELECT IIF(345 > 50, 'LARGE_26', 'SMALL_26'),
       COALESCE(NULL, NULL, 'FALLBACK_26');
----
LARGE_26 FALLBACK_26

statement ok
CREATE TABLE tc_tbl_2251 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2251 VALUES
(1, '345', 10),
(2, 'bad_26', 130);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2251
ORDER BY id;
----
1 345
2 130

statement ok
DROP TABLE tc_tbl_2251;
