# test/slt_proc/types_cast_null/2280_try_cast_choose_iif_nullif_055.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (55)

query ITIT
SELECT TRY_CAST('722' AS INT),
       ISNULL(TRY_CAST('not_an_int_55' AS INT), -999),
       ISNULL(NULLIF(722, 722), 55),
       CHOOSE(2, 'OPT_A_55', 'OPT_B_55', 'OPT_C_55');
----
722 -999 55 OPT_B_55

query TT
SELECT IIF(722 > 50, 'LARGE_55', 'SMALL_55'),
       COALESCE(NULL, NULL, 'FALLBACK_55');
----
LARGE_55 FALLBACK_55

statement ok
CREATE TABLE tc_tbl_2280 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2280 VALUES
(1, '722', 10),
(2, 'bad_55', 275);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2280
ORDER BY id;
----
1 722
2 275

statement ok
DROP TABLE tc_tbl_2280;
