# test/slt_proc/types_cast_null/128_cast_null_3vl_03.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (3)

query ITI
SELECT CAST('122' AS INT) + 3, CAST(122 AS VARCHAR(20)), TRY_CAST('122' AS INT);
----
125 122 122

query IIT
SELECT ISNUMERIC('122'), ISNUMERIC('err_3z'), ISNULL(CAST(TRY_CAST('err_3z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(4, 'Alpha_3', 'Beta_3', 'Gamma_3', 'Delta_3'), IIF(122 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_3'), COALESCE(NULL, NULL, 'COAL_3');
----
Delta_3 YES DEF_3 COAL_3

query II
SELECT ISNULL(NULLIF(122, 122), -1), NULLIF(122, 0);
----
-1 122
