# test/slt_proc/types_cast_null/2351_try_cast_choose_iif_nullif_126.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (126)

query ITIT
SELECT TRY_CAST('1645' AS INT),
       ISNULL(TRY_CAST('not_an_int_126' AS INT), -999),
       ISNULL(NULLIF(1645, 1645), 126),
       CHOOSE(1, 'OPT_A_126', 'OPT_B_126', 'OPT_C_126');
----
1645 -999 126 OPT_A_126

query TT
SELECT IIF(1645 > 50, 'LARGE_126', 'SMALL_126'),
       COALESCE(NULL, NULL, 'FALLBACK_126');
----
LARGE_126 FALLBACK_126

statement ok
CREATE TABLE tc_tbl_2351 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2351 VALUES
(1, '1645', 10),
(2, 'bad_126', 630);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2351
ORDER BY id;
----
1 1645
2 630

statement ok
DROP TABLE tc_tbl_2351;
