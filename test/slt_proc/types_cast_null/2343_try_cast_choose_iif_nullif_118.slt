# test/slt_proc/types_cast_null/2343_try_cast_choose_iif_nullif_118.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (118)

query ITIT
SELECT TRY_CAST('1541' AS INT),
       ISNULL(TRY_CAST('not_an_int_118' AS INT), -999),
       ISNULL(NULLIF(1541, 1541), 118),
       CHOOSE(2, 'OPT_A_118', 'OPT_B_118', 'OPT_C_118');
----
1541 -999 118 OPT_B_118

query TT
SELECT IIF(1541 > 50, 'LARGE_118', 'SMALL_118'),
       COALESCE(NULL, NULL, 'FALLBACK_118');
----
LARGE_118 FALLBACK_118

statement ok
CREATE TABLE tc_tbl_2343 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2343 VALUES
(1, '1541', 10),
(2, 'bad_118', 590);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2343
ORDER BY id;
----
1 1541
2 590

statement ok
DROP TABLE tc_tbl_2343;
