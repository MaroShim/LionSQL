# test/slt_proc/types_cast_null/2230_try_cast_choose_iif_nullif_005.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (5)

query ITIT
SELECT TRY_CAST('72' AS INT),
       ISNULL(TRY_CAST('not_an_int_5' AS INT), -999),
       ISNULL(NULLIF(72, 72), 5),
       CHOOSE(3, 'OPT_A_5', 'OPT_B_5', 'OPT_C_5');
----
72 -999 5 OPT_C_5

query TT
SELECT IIF(72 > 50, 'LARGE_5', 'SMALL_5'),
       COALESCE(NULL, NULL, 'FALLBACK_5');
----
LARGE_5 FALLBACK_5

statement ok
CREATE TABLE tc_tbl_2230 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2230 VALUES
(1, '72', 10),
(2, 'bad_5', 25);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2230
ORDER BY id;
----
1 72
2 25

statement ok
DROP TABLE tc_tbl_2230;
