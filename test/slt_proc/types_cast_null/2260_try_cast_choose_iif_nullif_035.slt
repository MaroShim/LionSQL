# test/slt_proc/types_cast_null/2260_try_cast_choose_iif_nullif_035.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (35)

query ITIT
SELECT TRY_CAST('462' AS INT),
       ISNULL(TRY_CAST('not_an_int_35' AS INT), -999),
       ISNULL(NULLIF(462, 462), 35),
       CHOOSE(3, 'OPT_A_35', 'OPT_B_35', 'OPT_C_35');
----
462 -999 35 OPT_C_35

query TT
SELECT IIF(462 > 50, 'LARGE_35', 'SMALL_35'),
       COALESCE(NULL, NULL, 'FALLBACK_35');
----
LARGE_35 FALLBACK_35

statement ok
CREATE TABLE tc_tbl_2260 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2260 VALUES
(1, '462', 10),
(2, 'bad_35', 175);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2260
ORDER BY id;
----
1 462
2 175

statement ok
DROP TABLE tc_tbl_2260;
