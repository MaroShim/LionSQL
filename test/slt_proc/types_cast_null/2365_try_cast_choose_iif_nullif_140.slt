# test/slt_proc/types_cast_null/2365_try_cast_choose_iif_nullif_140.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (140)

query ITIT
SELECT TRY_CAST('1827' AS INT),
       ISNULL(TRY_CAST('not_an_int_140' AS INT), -999),
       ISNULL(NULLIF(1827, 1827), 140),
       CHOOSE(3, 'OPT_A_140', 'OPT_B_140', 'OPT_C_140');
----
1827 -999 140 OPT_C_140

query TT
SELECT IIF(1827 > 50, 'LARGE_140', 'SMALL_140'),
       COALESCE(NULL, NULL, 'FALLBACK_140');
----
LARGE_140 FALLBACK_140

statement ok
CREATE TABLE tc_tbl_2365 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2365 VALUES
(1, '1827', 10),
(2, 'bad_140', 700);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2365
ORDER BY id;
----
1 1827
2 700

statement ok
DROP TABLE tc_tbl_2365;
