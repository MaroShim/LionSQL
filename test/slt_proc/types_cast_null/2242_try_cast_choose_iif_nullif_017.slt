# test/slt_proc/types_cast_null/2242_try_cast_choose_iif_nullif_017.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (17)

query ITIT
SELECT TRY_CAST('228' AS INT),
       ISNULL(TRY_CAST('not_an_int_17' AS INT), -999),
       ISNULL(NULLIF(228, 228), 17),
       CHOOSE(3, 'OPT_A_17', 'OPT_B_17', 'OPT_C_17');
----
228 -999 17 OPT_C_17

query TT
SELECT IIF(228 > 50, 'LARGE_17', 'SMALL_17'),
       COALESCE(NULL, NULL, 'FALLBACK_17');
----
LARGE_17 FALLBACK_17

statement ok
CREATE TABLE tc_tbl_2242 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2242 VALUES
(1, '228', 10),
(2, 'bad_17', 85);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2242
ORDER BY id;
----
1 228
2 85

statement ok
DROP TABLE tc_tbl_2242;
