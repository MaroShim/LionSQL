# test/slt_proc/types_cast_null/2311_try_cast_choose_iif_nullif_086.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (86)

query ITIT
SELECT TRY_CAST('1125' AS INT),
       ISNULL(TRY_CAST('not_an_int_86' AS INT), -999),
       ISNULL(NULLIF(1125, 1125), 86),
       CHOOSE(3, 'OPT_A_86', 'OPT_B_86', 'OPT_C_86');
----
1125 -999 86 OPT_C_86

query TT
SELECT IIF(1125 > 50, 'LARGE_86', 'SMALL_86'),
       COALESCE(NULL, NULL, 'FALLBACK_86');
----
LARGE_86 FALLBACK_86

statement ok
CREATE TABLE tc_tbl_2311 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2311 VALUES
(1, '1125', 10),
(2, 'bad_86', 430);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2311
ORDER BY id;
----
1 1125
2 430

statement ok
DROP TABLE tc_tbl_2311;
