# test/slt_proc/types_cast_null/2278_try_cast_choose_iif_nullif_053.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (53)

query ITIT
SELECT TRY_CAST('696' AS INT),
       ISNULL(TRY_CAST('not_an_int_53' AS INT), -999),
       ISNULL(NULLIF(696, 696), 53),
       CHOOSE(3, 'OPT_A_53', 'OPT_B_53', 'OPT_C_53');
----
696 -999 53 OPT_C_53

query TT
SELECT IIF(696 > 50, 'LARGE_53', 'SMALL_53'),
       COALESCE(NULL, NULL, 'FALLBACK_53');
----
LARGE_53 FALLBACK_53

statement ok
CREATE TABLE tc_tbl_2278 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2278 VALUES
(1, '696', 10),
(2, 'bad_53', 265);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2278
ORDER BY id;
----
1 696
2 265

statement ok
DROP TABLE tc_tbl_2278;
