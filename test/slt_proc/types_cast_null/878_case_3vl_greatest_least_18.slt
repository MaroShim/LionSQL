# test/slt_proc/types_cast_null/878_case_3vl_greatest_least_18.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (18)

query II
SELECT GREATEST(72, 164, 269), LEAST(72, 164, 269);
----
269 72

statement ok
CREATE TABLE t_null_878 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_878 VALUES
(1, 72, 'LOW'),
(2, NULL, 'MISSING'),
(3, 269, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 164 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_18')
FROM t_null_878
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_18

query I
SELECT COUNT(*) FROM t_null_878 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_878;
