# test/slt_proc/types_cast_null/139_cast_null_3vl_14.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (14)

query ITI
SELECT CAST('529' AS INT) + 14, CAST(529 AS VARCHAR(20)), TRY_CAST('529' AS INT);
----
543 529 529

query IIT
SELECT ISNUMERIC('529'), ISNUMERIC('err_14z'), ISNULL(CAST(TRY_CAST('err_14z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(3, 'Alpha_14', 'Beta_14', 'Gamma_14', 'Delta_14'), IIF(529 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_14'), COALESCE(NULL, NULL, 'COAL_14');
----
Gamma_14 YES DEF_14 COAL_14

query II
SELECT ISNULL(NULLIF(529, 529), -1), NULLIF(529, 0);
----
-1 529
