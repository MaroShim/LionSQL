# test/slt_proc/types_cast_null/2329_try_cast_choose_iif_nullif_104.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (104)

query ITIT
SELECT TRY_CAST('1359' AS INT),
       ISNULL(TRY_CAST('not_an_int_104' AS INT), -999),
       ISNULL(NULLIF(1359, 1359), 104),
       CHOOSE(3, 'OPT_A_104', 'OPT_B_104', 'OPT_C_104');
----
1359 -999 104 OPT_C_104

query TT
SELECT IIF(1359 > 50, 'LARGE_104', 'SMALL_104'),
       COALESCE(NULL, NULL, 'FALLBACK_104');
----
LARGE_104 FALLBACK_104

statement ok
CREATE TABLE tc_tbl_2329 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2329 VALUES
(1, '1359', 10),
(2, 'bad_104', 520);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2329
ORDER BY id;
----
1 1359
2 520

statement ok
DROP TABLE tc_tbl_2329;
