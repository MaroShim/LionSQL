# test/slt_proc/types_cast_null/867_case_3vl_greatest_least_07.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (7)

query II
SELECT GREATEST(28, 65, 104), LEAST(28, 65, 104);
----
104 28

statement ok
CREATE TABLE t_null_867 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_867 VALUES
(1, 28, 'LOW'),
(2, NULL, 'MISSING'),
(3, 104, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 65 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_7')
FROM t_null_867
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_7

query I
SELECT COUNT(*) FROM t_null_867 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_867;
