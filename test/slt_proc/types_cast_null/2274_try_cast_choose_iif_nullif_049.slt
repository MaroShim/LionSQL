# test/slt_proc/types_cast_null/2274_try_cast_choose_iif_nullif_049.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (49)

query ITIT
SELECT TRY_CAST('644' AS INT),
       ISNULL(TRY_CAST('not_an_int_49' AS INT), -999),
       ISNULL(NULLIF(644, 644), 49),
       CHOOSE(2, 'OPT_A_49', 'OPT_B_49', 'OPT_C_49');
----
644 -999 49 OPT_B_49

query TT
SELECT IIF(644 > 50, 'LARGE_49', 'SMALL_49'),
       COALESCE(NULL, NULL, 'FALLBACK_49');
----
LARGE_49 FALLBACK_49

statement ok
CREATE TABLE tc_tbl_2274 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2274 VALUES
(1, '644', 10),
(2, 'bad_49', 245);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2274
ORDER BY id;
----
1 644
2 245

statement ok
DROP TABLE tc_tbl_2274;
