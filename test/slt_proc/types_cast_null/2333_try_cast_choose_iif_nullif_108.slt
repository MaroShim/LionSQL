# test/slt_proc/types_cast_null/2333_try_cast_choose_iif_nullif_108.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (108)

query ITIT
SELECT TRY_CAST('1411' AS INT),
       ISNULL(TRY_CAST('not_an_int_108' AS INT), -999),
       ISNULL(NULLIF(1411, 1411), 108),
       CHOOSE(1, 'OPT_A_108', 'OPT_B_108', 'OPT_C_108');
----
1411 -999 108 OPT_A_108

query TT
SELECT IIF(1411 > 50, 'LARGE_108', 'SMALL_108'),
       COALESCE(NULL, NULL, 'FALLBACK_108');
----
LARGE_108 FALLBACK_108

statement ok
CREATE TABLE tc_tbl_2333 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2333 VALUES
(1, '1411', 10),
(2, 'bad_108', 540);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2333
ORDER BY id;
----
1 1411
2 540

statement ok
DROP TABLE tc_tbl_2333;
