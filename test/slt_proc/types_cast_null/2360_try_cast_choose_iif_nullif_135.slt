# test/slt_proc/types_cast_null/2360_try_cast_choose_iif_nullif_135.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (135)

query ITIT
SELECT TRY_CAST('1762' AS INT),
       ISNULL(TRY_CAST('not_an_int_135' AS INT), -999),
       ISNULL(NULLIF(1762, 1762), 135),
       CHOOSE(1, 'OPT_A_135', 'OPT_B_135', 'OPT_C_135');
----
1762 -999 135 OPT_A_135

query TT
SELECT IIF(1762 > 50, 'LARGE_135', 'SMALL_135'),
       COALESCE(NULL, NULL, 'FALLBACK_135');
----
LARGE_135 FALLBACK_135

statement ok
CREATE TABLE tc_tbl_2360 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2360 VALUES
(1, '1762', 10),
(2, 'bad_135', 675);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2360
ORDER BY id;
----
1 1762
2 675

statement ok
DROP TABLE tc_tbl_2360;
