# test/slt_proc/types_cast_null/881_case_3vl_greatest_least_21.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (21)

query II
SELECT GREATEST(84, 191, 314), LEAST(84, 191, 314);
----
314 84

statement ok
CREATE TABLE t_null_881 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_881 VALUES
(1, 84, 'LOW'),
(2, NULL, 'MISSING'),
(3, 314, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 191 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_21')
FROM t_null_881
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_21

query I
SELECT COUNT(*) FROM t_null_881 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_881;
