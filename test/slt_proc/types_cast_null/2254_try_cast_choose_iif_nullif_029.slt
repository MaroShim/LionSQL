# test/slt_proc/types_cast_null/2254_try_cast_choose_iif_nullif_029.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (29)

query ITIT
SELECT TRY_CAST('384' AS INT),
       ISNULL(TRY_CAST('not_an_int_29' AS INT), -999),
       ISNULL(NULLIF(384, 384), 29),
       CHOOSE(3, 'OPT_A_29', 'OPT_B_29', 'OPT_C_29');
----
384 -999 29 OPT_C_29

query TT
SELECT IIF(384 > 50, 'LARGE_29', 'SMALL_29'),
       COALESCE(NULL, NULL, 'FALLBACK_29');
----
LARGE_29 FALLBACK_29

statement ok
CREATE TABLE tc_tbl_2254 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2254 VALUES
(1, '384', 10),
(2, 'bad_29', 145);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2254
ORDER BY id;
----
1 384
2 145

statement ok
DROP TABLE tc_tbl_2254;
