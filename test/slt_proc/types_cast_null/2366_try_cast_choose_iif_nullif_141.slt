# test/slt_proc/types_cast_null/2366_try_cast_choose_iif_nullif_141.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (141)

query ITIT
SELECT TRY_CAST('1840' AS INT),
       ISNULL(TRY_CAST('not_an_int_141' AS INT), -999),
       ISNULL(NULLIF(1840, 1840), 141),
       CHOOSE(1, 'OPT_A_141', 'OPT_B_141', 'OPT_C_141');
----
1840 -999 141 OPT_A_141

query TT
SELECT IIF(1840 > 50, 'LARGE_141', 'SMALL_141'),
       COALESCE(NULL, NULL, 'FALLBACK_141');
----
LARGE_141 FALLBACK_141

statement ok
CREATE TABLE tc_tbl_2366 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2366 VALUES
(1, '1840', 10),
(2, 'bad_141', 705);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2366
ORDER BY id;
----
1 1840
2 705

statement ok
DROP TABLE tc_tbl_2366;
