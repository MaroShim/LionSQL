# test/slt_proc/types_cast_null/2342_try_cast_choose_iif_nullif_117.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (117)

query ITIT
SELECT TRY_CAST('1528' AS INT),
       ISNULL(TRY_CAST('not_an_int_117' AS INT), -999),
       ISNULL(NULLIF(1528, 1528), 117),
       CHOOSE(1, 'OPT_A_117', 'OPT_B_117', 'OPT_C_117');
----
1528 -999 117 OPT_A_117

query TT
SELECT IIF(1528 > 50, 'LARGE_117', 'SMALL_117'),
       COALESCE(NULL, NULL, 'FALLBACK_117');
----
LARGE_117 FALLBACK_117

statement ok
CREATE TABLE tc_tbl_2342 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2342 VALUES
(1, '1528', 10),
(2, 'bad_117', 585);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2342
ORDER BY id;
----
1 1528
2 585

statement ok
DROP TABLE tc_tbl_2342;
