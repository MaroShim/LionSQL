# test/slt_proc/types_cast_null/874_case_3vl_greatest_least_14.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (14)

query II
SELECT GREATEST(56, 128, 209), LEAST(56, 128, 209);
----
209 56

statement ok
CREATE TABLE t_null_874 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_874 VALUES
(1, 56, 'LOW'),
(2, NULL, 'MISSING'),
(3, 209, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 128 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_14')
FROM t_null_874
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_14

query I
SELECT COUNT(*) FROM t_null_874 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_874;
