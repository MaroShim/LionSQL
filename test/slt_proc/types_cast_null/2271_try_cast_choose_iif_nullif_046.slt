# test/slt_proc/types_cast_null/2271_try_cast_choose_iif_nullif_046.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (46)

query ITIT
SELECT TRY_CAST('605' AS INT),
       ISNULL(TRY_CAST('not_an_int_46' AS INT), -999),
       ISNULL(NULLIF(605, 605), 46),
       CHOOSE(2, 'OPT_A_46', 'OPT_B_46', 'OPT_C_46');
----
605 -999 46 OPT_B_46

query TT
SELECT IIF(605 > 50, 'LARGE_46', 'SMALL_46'),
       COALESCE(NULL, NULL, 'FALLBACK_46');
----
LARGE_46 FALLBACK_46

statement ok
CREATE TABLE tc_tbl_2271 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2271 VALUES
(1, '605', 10),
(2, 'bad_46', 230);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2271
ORDER BY id;
----
1 605
2 230

statement ok
DROP TABLE tc_tbl_2271;
