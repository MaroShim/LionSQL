# test/slt_proc/types_cast_null/2296_try_cast_choose_iif_nullif_071.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (71)

query ITIT
SELECT TRY_CAST('930' AS INT),
       ISNULL(TRY_CAST('not_an_int_71' AS INT), -999),
       ISNULL(NULLIF(930, 930), 71),
       CHOOSE(3, 'OPT_A_71', 'OPT_B_71', 'OPT_C_71');
----
930 -999 71 OPT_C_71

query TT
SELECT IIF(930 > 50, 'LARGE_71', 'SMALL_71'),
       COALESCE(NULL, NULL, 'FALLBACK_71');
----
LARGE_71 FALLBACK_71

statement ok
CREATE TABLE tc_tbl_2296 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2296 VALUES
(1, '930', 10),
(2, 'bad_71', 355);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2296
ORDER BY id;
----
1 930
2 355

statement ok
DROP TABLE tc_tbl_2296;
