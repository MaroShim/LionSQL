# test/slt_proc/types_cast_null/143_cast_null_3vl_18.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (18)

query ITI
SELECT CAST('677' AS INT) + 18, CAST(677 AS VARCHAR(20)), TRY_CAST('677' AS INT);
----
695 677 677

query IIT
SELECT ISNUMERIC('677'), ISNUMERIC('err_18z'), ISNULL(CAST(TRY_CAST('err_18z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(3, 'Alpha_18', 'Beta_18', 'Gamma_18', 'Delta_18'), IIF(677 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_18'), COALESCE(NULL, NULL, 'COAL_18');
----
Gamma_18 YES DEF_18 COAL_18

query II
SELECT ISNULL(NULLIF(677, 677), -1), NULLIF(677, 0);
----
-1 677
