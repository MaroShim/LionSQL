# test/slt_proc/types_cast_null/2363_try_cast_choose_iif_nullif_138.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (138)

query ITIT
SELECT TRY_CAST('1801' AS INT),
       ISNULL(TRY_CAST('not_an_int_138' AS INT), -999),
       ISNULL(NULLIF(1801, 1801), 138),
       CHOOSE(1, 'OPT_A_138', 'OPT_B_138', 'OPT_C_138');
----
1801 -999 138 OPT_A_138

query TT
SELECT IIF(1801 > 50, 'LARGE_138', 'SMALL_138'),
       COALESCE(NULL, NULL, 'FALLBACK_138');
----
LARGE_138 FALLBACK_138

statement ok
CREATE TABLE tc_tbl_2363 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2363 VALUES
(1, '1801', 10),
(2, 'bad_138', 690);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2363
ORDER BY id;
----
1 1801
2 690

statement ok
DROP TABLE tc_tbl_2363;
