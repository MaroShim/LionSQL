# test/slt_proc/types_cast_null/2325_try_cast_choose_iif_nullif_100.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (100)

query ITIT
SELECT TRY_CAST('1307' AS INT),
       ISNULL(TRY_CAST('not_an_int_100' AS INT), -999),
       ISNULL(NULLIF(1307, 1307), 100),
       CHOOSE(2, 'OPT_A_100', 'OPT_B_100', 'OPT_C_100');
----
1307 -999 100 OPT_B_100

query TT
SELECT IIF(1307 > 50, 'LARGE_100', 'SMALL_100'),
       COALESCE(NULL, NULL, 'FALLBACK_100');
----
LARGE_100 FALLBACK_100

statement ok
CREATE TABLE tc_tbl_2325 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2325 VALUES
(1, '1307', 10),
(2, 'bad_100', 500);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2325
ORDER BY id;
----
1 1307
2 500

statement ok
DROP TABLE tc_tbl_2325;
