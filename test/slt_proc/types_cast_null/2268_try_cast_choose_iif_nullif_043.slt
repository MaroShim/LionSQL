# test/slt_proc/types_cast_null/2268_try_cast_choose_iif_nullif_043.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (43)

query ITIT
SELECT TRY_CAST('566' AS INT),
       ISNULL(TRY_CAST('not_an_int_43' AS INT), -999),
       ISNULL(NULLIF(566, 566), 43),
       CHOOSE(2, 'OPT_A_43', 'OPT_B_43', 'OPT_C_43');
----
566 -999 43 OPT_B_43

query TT
SELECT IIF(566 > 50, 'LARGE_43', 'SMALL_43'),
       COALESCE(NULL, NULL, 'FALLBACK_43');
----
LARGE_43 FALLBACK_43

statement ok
CREATE TABLE tc_tbl_2268 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2268 VALUES
(1, '566', 10),
(2, 'bad_43', 215);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2268
ORDER BY id;
----
1 566
2 215

statement ok
DROP TABLE tc_tbl_2268;
