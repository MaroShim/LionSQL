# test/slt_proc/types_cast_null/2327_try_cast_choose_iif_nullif_102.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (102)

query ITIT
SELECT TRY_CAST('1333' AS INT),
       ISNULL(TRY_CAST('not_an_int_102' AS INT), -999),
       ISNULL(NULLIF(1333, 1333), 102),
       CHOOSE(1, 'OPT_A_102', 'OPT_B_102', 'OPT_C_102');
----
1333 -999 102 OPT_A_102

query TT
SELECT IIF(1333 > 50, 'LARGE_102', 'SMALL_102'),
       COALESCE(NULL, NULL, 'FALLBACK_102');
----
LARGE_102 FALLBACK_102

statement ok
CREATE TABLE tc_tbl_2327 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2327 VALUES
(1, '1333', 10),
(2, 'bad_102', 510);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2327
ORDER BY id;
----
1 1333
2 510

statement ok
DROP TABLE tc_tbl_2327;
