# test/slt_proc/types_cast_null/126_cast_null_3vl_01.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (1)

query ITI
SELECT CAST('48' AS INT) + 1, CAST(48 AS VARCHAR(20)), TRY_CAST('48' AS INT);
----
49 48 48

query IIT
SELECT ISNUMERIC('48'), ISNUMERIC('err_1z'), ISNULL(CAST(TRY_CAST('err_1z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(2, 'Alpha_1', 'Beta_1', 'Gamma_1', 'Delta_1'), IIF(48 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_1'), COALESCE(NULL, NULL, 'COAL_1');
----
Beta_1 YES DEF_1 COAL_1

query II
SELECT ISNULL(NULLIF(48, 48), -1), NULLIF(48, 0);
----
-1 48
