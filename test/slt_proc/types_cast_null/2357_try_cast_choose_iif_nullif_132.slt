# test/slt_proc/types_cast_null/2357_try_cast_choose_iif_nullif_132.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (132)

query ITIT
SELECT TRY_CAST('1723' AS INT),
       ISNULL(TRY_CAST('not_an_int_132' AS INT), -999),
       ISNULL(NULLIF(1723, 1723), 132),
       CHOOSE(1, 'OPT_A_132', 'OPT_B_132', 'OPT_C_132');
----
1723 -999 132 OPT_A_132

query TT
SELECT IIF(1723 > 50, 'LARGE_132', 'SMALL_132'),
       COALESCE(NULL, NULL, 'FALLBACK_132');
----
LARGE_132 FALLBACK_132

statement ok
CREATE TABLE tc_tbl_2357 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2357 VALUES
(1, '1723', 10),
(2, 'bad_132', 660);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2357
ORDER BY id;
----
1 1723
2 660

statement ok
DROP TABLE tc_tbl_2357;
