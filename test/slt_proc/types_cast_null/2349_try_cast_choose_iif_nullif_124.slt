# test/slt_proc/types_cast_null/2349_try_cast_choose_iif_nullif_124.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (124)

query ITIT
SELECT TRY_CAST('1619' AS INT),
       ISNULL(TRY_CAST('not_an_int_124' AS INT), -999),
       ISNULL(NULLIF(1619, 1619), 124),
       CHOOSE(2, 'OPT_A_124', 'OPT_B_124', 'OPT_C_124');
----
1619 -999 124 OPT_B_124

query TT
SELECT IIF(1619 > 50, 'LARGE_124', 'SMALL_124'),
       COALESCE(NULL, NULL, 'FALLBACK_124');
----
LARGE_124 FALLBACK_124

statement ok
CREATE TABLE tc_tbl_2349 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2349 VALUES
(1, '1619', 10),
(2, 'bad_124', 620);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2349
ORDER BY id;
----
1 1619
2 620

statement ok
DROP TABLE tc_tbl_2349;
