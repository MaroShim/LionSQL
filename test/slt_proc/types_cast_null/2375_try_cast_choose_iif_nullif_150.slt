# test/slt_proc/types_cast_null/2375_try_cast_choose_iif_nullif_150.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (150)

query ITIT
SELECT TRY_CAST('1957' AS INT),
       ISNULL(TRY_CAST('not_an_int_150' AS INT), -999),
       ISNULL(NULLIF(1957, 1957), 150),
       CHOOSE(1, 'OPT_A_150', 'OPT_B_150', 'OPT_C_150');
----
1957 -999 150 OPT_A_150

query TT
SELECT IIF(1957 > 50, 'LARGE_150', 'SMALL_150'),
       COALESCE(NULL, NULL, 'FALLBACK_150');
----
LARGE_150 FALLBACK_150

statement ok
CREATE TABLE tc_tbl_2375 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2375 VALUES
(1, '1957', 10),
(2, 'bad_150', 750);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2375
ORDER BY id;
----
1 1957
2 750

statement ok
DROP TABLE tc_tbl_2375;
