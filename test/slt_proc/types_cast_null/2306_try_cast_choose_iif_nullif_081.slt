# test/slt_proc/types_cast_null/2306_try_cast_choose_iif_nullif_081.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (81)

query ITIT
SELECT TRY_CAST('1060' AS INT),
       ISNULL(TRY_CAST('not_an_int_81' AS INT), -999),
       ISNULL(NULLIF(1060, 1060), 81),
       CHOOSE(1, 'OPT_A_81', 'OPT_B_81', 'OPT_C_81');
----
1060 -999 81 OPT_A_81

query TT
SELECT IIF(1060 > 50, 'LARGE_81', 'SMALL_81'),
       COALESCE(NULL, NULL, 'FALLBACK_81');
----
LARGE_81 FALLBACK_81

statement ok
CREATE TABLE tc_tbl_2306 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2306 VALUES
(1, '1060', 10),
(2, 'bad_81', 405);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2306
ORDER BY id;
----
1 1060
2 405

statement ok
DROP TABLE tc_tbl_2306;
