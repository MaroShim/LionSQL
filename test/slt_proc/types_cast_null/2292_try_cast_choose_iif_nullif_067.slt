# test/slt_proc/types_cast_null/2292_try_cast_choose_iif_nullif_067.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (67)

query ITIT
SELECT TRY_CAST('878' AS INT),
       ISNULL(TRY_CAST('not_an_int_67' AS INT), -999),
       ISNULL(NULLIF(878, 878), 67),
       CHOOSE(2, 'OPT_A_67', 'OPT_B_67', 'OPT_C_67');
----
878 -999 67 OPT_B_67

query TT
SELECT IIF(878 > 50, 'LARGE_67', 'SMALL_67'),
       COALESCE(NULL, NULL, 'FALLBACK_67');
----
LARGE_67 FALLBACK_67

statement ok
CREATE TABLE tc_tbl_2292 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2292 VALUES
(1, '878', 10),
(2, 'bad_67', 335);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2292
ORDER BY id;
----
1 878
2 335

statement ok
DROP TABLE tc_tbl_2292;
