# test/slt_proc/types_cast_null/876_case_3vl_greatest_least_16.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (16)

query II
SELECT GREATEST(64, 146, 239), LEAST(64, 146, 239);
----
239 64

statement ok
CREATE TABLE t_null_876 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_876 VALUES
(1, 64, 'LOW'),
(2, NULL, 'MISSING'),
(3, 239, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 146 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_16')
FROM t_null_876
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_16

query I
SELECT COUNT(*) FROM t_null_876 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_876;
