# test/slt_proc/types_cast_null/2345_try_cast_choose_iif_nullif_120.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (120)

query ITIT
SELECT TRY_CAST('1567' AS INT),
       ISNULL(TRY_CAST('not_an_int_120' AS INT), -999),
       ISNULL(NULLIF(1567, 1567), 120),
       CHOOSE(1, 'OPT_A_120', 'OPT_B_120', 'OPT_C_120');
----
1567 -999 120 OPT_A_120

query TT
SELECT IIF(1567 > 50, 'LARGE_120', 'SMALL_120'),
       COALESCE(NULL, NULL, 'FALLBACK_120');
----
LARGE_120 FALLBACK_120

statement ok
CREATE TABLE tc_tbl_2345 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2345 VALUES
(1, '1567', 10),
(2, 'bad_120', 600);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2345
ORDER BY id;
----
1 1567
2 600

statement ok
DROP TABLE tc_tbl_2345;
