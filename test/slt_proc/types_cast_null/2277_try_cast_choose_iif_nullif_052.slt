# test/slt_proc/types_cast_null/2277_try_cast_choose_iif_nullif_052.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (52)

query ITIT
SELECT TRY_CAST('683' AS INT),
       ISNULL(TRY_CAST('not_an_int_52' AS INT), -999),
       ISNULL(NULLIF(683, 683), 52),
       CHOOSE(2, 'OPT_A_52', 'OPT_B_52', 'OPT_C_52');
----
683 -999 52 OPT_B_52

query TT
SELECT IIF(683 > 50, 'LARGE_52', 'SMALL_52'),
       COALESCE(NULL, NULL, 'FALLBACK_52');
----
LARGE_52 FALLBACK_52

statement ok
CREATE TABLE tc_tbl_2277 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2277 VALUES
(1, '683', 10),
(2, 'bad_52', 260);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2277
ORDER BY id;
----
1 683
2 260

statement ok
DROP TABLE tc_tbl_2277;
