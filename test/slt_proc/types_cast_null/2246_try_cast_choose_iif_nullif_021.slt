# test/slt_proc/types_cast_null/2246_try_cast_choose_iif_nullif_021.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (21)

query ITIT
SELECT TRY_CAST('280' AS INT),
       ISNULL(TRY_CAST('not_an_int_21' AS INT), -999),
       ISNULL(NULLIF(280, 280), 21),
       CHOOSE(1, 'OPT_A_21', 'OPT_B_21', 'OPT_C_21');
----
280 -999 21 OPT_A_21

query TT
SELECT IIF(280 > 50, 'LARGE_21', 'SMALL_21'),
       COALESCE(NULL, NULL, 'FALLBACK_21');
----
LARGE_21 FALLBACK_21

statement ok
CREATE TABLE tc_tbl_2246 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2246 VALUES
(1, '280', 10),
(2, 'bad_21', 105);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2246
ORDER BY id;
----
1 280
2 105

statement ok
DROP TABLE tc_tbl_2246;
