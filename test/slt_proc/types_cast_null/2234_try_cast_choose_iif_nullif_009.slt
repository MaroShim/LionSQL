# test/slt_proc/types_cast_null/2234_try_cast_choose_iif_nullif_009.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (9)

query ITIT
SELECT TRY_CAST('124' AS INT),
       ISNULL(TRY_CAST('not_an_int_9' AS INT), -999),
       ISNULL(NULLIF(124, 124), 9),
       CHOOSE(1, 'OPT_A_9', 'OPT_B_9', 'OPT_C_9');
----
124 -999 9 OPT_A_9

query TT
SELECT IIF(124 > 50, 'LARGE_9', 'SMALL_9'),
       COALESCE(NULL, NULL, 'FALLBACK_9');
----
LARGE_9 FALLBACK_9

statement ok
CREATE TABLE tc_tbl_2234 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2234 VALUES
(1, '124', 10),
(2, 'bad_9', 45);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2234
ORDER BY id;
----
1 124
2 45

statement ok
DROP TABLE tc_tbl_2234;
