# test/slt_proc/types_cast_null/2252_try_cast_choose_iif_nullif_027.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (27)

query ITIT
SELECT TRY_CAST('358' AS INT),
       ISNULL(TRY_CAST('not_an_int_27' AS INT), -999),
       ISNULL(NULLIF(358, 358), 27),
       CHOOSE(1, 'OPT_A_27', 'OPT_B_27', 'OPT_C_27');
----
358 -999 27 OPT_A_27

query TT
SELECT IIF(358 > 50, 'LARGE_27', 'SMALL_27'),
       COALESCE(NULL, NULL, 'FALLBACK_27');
----
LARGE_27 FALLBACK_27

statement ok
CREATE TABLE tc_tbl_2252 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2252 VALUES
(1, '358', 10),
(2, 'bad_27', 135);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2252
ORDER BY id;
----
1 358
2 135

statement ok
DROP TABLE tc_tbl_2252;
