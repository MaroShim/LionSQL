# test/slt_proc/types_cast_null/2290_try_cast_choose_iif_nullif_065.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (65)

query ITIT
SELECT TRY_CAST('852' AS INT),
       ISNULL(TRY_CAST('not_an_int_65' AS INT), -999),
       ISNULL(NULLIF(852, 852), 65),
       CHOOSE(3, 'OPT_A_65', 'OPT_B_65', 'OPT_C_65');
----
852 -999 65 OPT_C_65

query TT
SELECT IIF(852 > 50, 'LARGE_65', 'SMALL_65'),
       COALESCE(NULL, NULL, 'FALLBACK_65');
----
LARGE_65 FALLBACK_65

statement ok
CREATE TABLE tc_tbl_2290 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2290 VALUES
(1, '852', 10),
(2, 'bad_65', 325);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2290
ORDER BY id;
----
1 852
2 325

statement ok
DROP TABLE tc_tbl_2290;
