# test/slt_proc/types_cast_null/2330_try_cast_choose_iif_nullif_105.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (105)

query ITIT
SELECT TRY_CAST('1372' AS INT),
       ISNULL(TRY_CAST('not_an_int_105' AS INT), -999),
       ISNULL(NULLIF(1372, 1372), 105),
       CHOOSE(1, 'OPT_A_105', 'OPT_B_105', 'OPT_C_105');
----
1372 -999 105 OPT_A_105

query TT
SELECT IIF(1372 > 50, 'LARGE_105', 'SMALL_105'),
       COALESCE(NULL, NULL, 'FALLBACK_105');
----
LARGE_105 FALLBACK_105

statement ok
CREATE TABLE tc_tbl_2330 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2330 VALUES
(1, '1372', 10),
(2, 'bad_105', 525);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2330
ORDER BY id;
----
1 1372
2 525

statement ok
DROP TABLE tc_tbl_2330;
