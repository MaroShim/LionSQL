# test/slt_proc/types_cast_null/865_case_3vl_greatest_least_05.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (5)

query II
SELECT GREATEST(20, 47, 74), LEAST(20, 47, 74);
----
74 20

statement ok
CREATE TABLE t_null_865 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_865 VALUES
(1, 20, 'LOW'),
(2, NULL, 'MISSING'),
(3, 74, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 47 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_5')
FROM t_null_865
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_5

query I
SELECT COUNT(*) FROM t_null_865 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_865;
