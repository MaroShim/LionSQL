# test/slt_proc/types_cast_null/136_cast_null_3vl_11.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (11)

query ITI
SELECT CAST('418' AS INT) + 11, CAST(418 AS VARCHAR(20)), TRY_CAST('418' AS INT);
----
429 418 418

query IIT
SELECT ISNUMERIC('418'), ISNUMERIC('err_11z'), ISNULL(CAST(TRY_CAST('err_11z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(4, 'Alpha_11', 'Beta_11', 'Gamma_11', 'Delta_11'), IIF(418 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_11'), COALESCE(NULL, NULL, 'COAL_11');
----
Delta_11 YES DEF_11 COAL_11

query II
SELECT ISNULL(NULLIF(418, 418), -1), NULLIF(418, 0);
----
-1 418
