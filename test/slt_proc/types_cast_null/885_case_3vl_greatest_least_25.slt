# test/slt_proc/types_cast_null/885_case_3vl_greatest_least_25.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (25)

query II
SELECT GREATEST(100, 227, 374), LEAST(100, 227, 374);
----
374 100

statement ok
CREATE TABLE t_null_885 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_885 VALUES
(1, 100, 'LOW'),
(2, NULL, 'MISSING'),
(3, 374, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 227 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_25')
FROM t_null_885
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_25

query I
SELECT COUNT(*) FROM t_null_885 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_885;
