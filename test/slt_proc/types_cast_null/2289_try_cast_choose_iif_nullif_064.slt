# test/slt_proc/types_cast_null/2289_try_cast_choose_iif_nullif_064.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (64)

query ITIT
SELECT TRY_CAST('839' AS INT),
       ISNULL(TRY_CAST('not_an_int_64' AS INT), -999),
       ISNULL(NULLIF(839, 839), 64),
       CHOOSE(2, 'OPT_A_64', 'OPT_B_64', 'OPT_C_64');
----
839 -999 64 OPT_B_64

query TT
SELECT IIF(839 > 50, 'LARGE_64', 'SMALL_64'),
       COALESCE(NULL, NULL, 'FALLBACK_64');
----
LARGE_64 FALLBACK_64

statement ok
CREATE TABLE tc_tbl_2289 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2289 VALUES
(1, '839', 10),
(2, 'bad_64', 320);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2289
ORDER BY id;
----
1 839
2 320

statement ok
DROP TABLE tc_tbl_2289;
