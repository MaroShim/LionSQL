# test/slt_proc/types_cast_null/883_case_3vl_greatest_least_23.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (23)

query II
SELECT GREATEST(92, 209, 344), LEAST(92, 209, 344);
----
344 92

statement ok
CREATE TABLE t_null_883 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_883 VALUES
(1, 92, 'LOW'),
(2, NULL, 'MISSING'),
(3, 344, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 209 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_23')
FROM t_null_883
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_23

query I
SELECT COUNT(*) FROM t_null_883 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_883;
