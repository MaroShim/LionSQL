# test/slt_proc/types_cast_null/877_case_3vl_greatest_least_17.slt
# T-SQL searched/simple CASE, GREATEST, LEAST, and 3VL NULL predicates (17)

query II
SELECT GREATEST(68, 155, 254), LEAST(68, 155, 254);
----
254 68

statement ok
CREATE TABLE t_null_877 (id INT PRIMARY KEY, a INT, b VARCHAR(20));

statement ok
INSERT INTO t_null_877 VALUES
(1, 68, 'LOW'),
(2, NULL, 'MISSING'),
(3, 254, NULL);

query ITT
SELECT id,
       CASE WHEN a IS NULL THEN 'IS_NULL' WHEN a >= 155 THEN 'HIGH' ELSE 'NORMAL' END,
       COALESCE(b, 'DEFAULT_17')
FROM t_null_877
ORDER BY id;
----
1 NORMAL LOW
2 IS_NULL MISSING
3 HIGH DEFAULT_17

query I
SELECT COUNT(*) FROM t_null_877 WHERE a IS NOT NULL;
----
2

statement ok
DROP TABLE t_null_877;
