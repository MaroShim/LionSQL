# test/slt_proc/types_cast_null/2320_try_cast_choose_iif_nullif_095.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (95)

query ITIT
SELECT TRY_CAST('1242' AS INT),
       ISNULL(TRY_CAST('not_an_int_95' AS INT), -999),
       ISNULL(NULLIF(1242, 1242), 95),
       CHOOSE(3, 'OPT_A_95', 'OPT_B_95', 'OPT_C_95');
----
1242 -999 95 OPT_C_95

query TT
SELECT IIF(1242 > 50, 'LARGE_95', 'SMALL_95'),
       COALESCE(NULL, NULL, 'FALLBACK_95');
----
LARGE_95 FALLBACK_95

statement ok
CREATE TABLE tc_tbl_2320 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2320 VALUES
(1, '1242', 10),
(2, 'bad_95', 475);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2320
ORDER BY id;
----
1 1242
2 475

statement ok
DROP TABLE tc_tbl_2320;
