# test/slt_proc/types_cast_null/144_cast_null_3vl_19.slt
# T-SQL CAST, TRY_CAST, ISNUMERIC, CHOOSE, IIF, COALESCE, NULLIF (19)

query ITI
SELECT CAST('714' AS INT) + 19, CAST(714 AS VARCHAR(20)), TRY_CAST('714' AS INT);
----
733 714 714

query IIT
SELECT ISNUMERIC('714'), ISNUMERIC('err_19z'), ISNULL(CAST(TRY_CAST('err_19z' AS INT) AS VARCHAR(20)), 'NULL_VAL');
----
1 0 NULL_VAL

query TTTT
SELECT CHOOSE(4, 'Alpha_19', 'Beta_19', 'Gamma_19', 'Delta_19'), IIF(714 > 10, 'YES', 'NO'), ISNULL(NULL, 'DEF_19'), COALESCE(NULL, NULL, 'COAL_19');
----
Delta_19 YES DEF_19 COAL_19

query II
SELECT ISNULL(NULLIF(714, 714), -1), NULLIF(714, 0);
----
-1 714
