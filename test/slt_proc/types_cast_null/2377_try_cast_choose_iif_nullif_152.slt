# test/slt_proc/types_cast_null/2377_try_cast_choose_iif_nullif_152.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (152)

query ITIT
SELECT TRY_CAST('1983' AS INT),
       ISNULL(TRY_CAST('not_an_int_152' AS INT), -999),
       ISNULL(NULLIF(1983, 1983), 152),
       CHOOSE(3, 'OPT_A_152', 'OPT_B_152', 'OPT_C_152');
----
1983 -999 152 OPT_C_152

query TT
SELECT IIF(1983 > 50, 'LARGE_152', 'SMALL_152'),
       COALESCE(NULL, NULL, 'FALLBACK_152');
----
LARGE_152 FALLBACK_152

statement ok
CREATE TABLE tc_tbl_2377 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2377 VALUES
(1, '1983', 10),
(2, 'bad_152', 760);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2377
ORDER BY id;
----
1 1983
2 760

statement ok
DROP TABLE tc_tbl_2377;
