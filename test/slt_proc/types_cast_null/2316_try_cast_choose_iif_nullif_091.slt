# test/slt_proc/types_cast_null/2316_try_cast_choose_iif_nullif_091.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (91)

query ITIT
SELECT TRY_CAST('1190' AS INT),
       ISNULL(TRY_CAST('not_an_int_91' AS INT), -999),
       ISNULL(NULLIF(1190, 1190), 91),
       CHOOSE(2, 'OPT_A_91', 'OPT_B_91', 'OPT_C_91');
----
1190 -999 91 OPT_B_91

query TT
SELECT IIF(1190 > 50, 'LARGE_91', 'SMALL_91'),
       COALESCE(NULL, NULL, 'FALLBACK_91');
----
LARGE_91 FALLBACK_91

statement ok
CREATE TABLE tc_tbl_2316 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2316 VALUES
(1, '1190', 10),
(2, 'bad_91', 455);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2316
ORDER BY id;
----
1 1190
2 455

statement ok
DROP TABLE tc_tbl_2316;
