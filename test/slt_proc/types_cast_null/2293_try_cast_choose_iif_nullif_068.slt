# test/slt_proc/types_cast_null/2293_try_cast_choose_iif_nullif_068.slt
# T-SQL TRY_CAST, TRY_CONVERT, CHOOSE, IIF, ISNULL, NULLIF, COALESCE (68)

query ITIT
SELECT TRY_CAST('891' AS INT),
       ISNULL(TRY_CAST('not_an_int_68' AS INT), -999),
       ISNULL(NULLIF(891, 891), 68),
       CHOOSE(3, 'OPT_A_68', 'OPT_B_68', 'OPT_C_68');
----
891 -999 68 OPT_C_68

query TT
SELECT IIF(891 > 50, 'LARGE_68', 'SMALL_68'),
       COALESCE(NULL, NULL, 'FALLBACK_68');
----
LARGE_68 FALLBACK_68

statement ok
CREATE TABLE tc_tbl_2293 (id INT PRIMARY KEY, raw_val VARCHAR(30), backup_val INT);

statement ok
INSERT INTO tc_tbl_2293 VALUES
(1, '891', 10),
(2, 'bad_68', 340);

query II
SELECT id, COALESCE(TRY_CAST(raw_val AS INT), backup_val)
FROM tc_tbl_2293
ORDER BY id;
----
1 891
2 340

statement ok
DROP TABLE tc_tbl_2293;
