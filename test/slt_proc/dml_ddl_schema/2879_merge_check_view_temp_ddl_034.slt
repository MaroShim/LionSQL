# test/slt_proc/dml_ddl_schema/2879_merge_check_view_temp_ddl_034.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (34)

statement ok
CREATE TABLE inv_main_2879 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 170 CHECK (qty >= 170)
);

statement ok
INSERT INTO inv_main_2879 (item_id, sku, qty) VALUES (1, 'SKU_A_34', 180), (2, 'SKU_B_34', 195);

statement error
INSERT INTO inv_main_2879 (item_id, sku, qty) VALUES (9, 'SKU_BAD_34', 169);

statement ok
INSERT INTO inv_main_2879 (item_id, sku) VALUES (3, 'SKU_DEF_34');

statement ok
CREATE TABLE #inv_delta_2879 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2879 VALUES (2, 'SKU_B_34', 5), (4, 'SKU_D_34', 210);

statement ok
MERGE inv_main_2879 AS t
USING #inv_delta_2879 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2879 AS
SELECT item_id, sku, qty FROM inv_main_2879 WHERE qty > 170;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2879 ORDER BY item_id;
----
1 SKU_A_34 180
2 SKU_B_34 200
4 SKU_D_34 210

statement ok
ALTER TABLE inv_main_2879 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_34';

query IT
SELECT item_id, wh_code FROM inv_main_2879 WHERE item_id = 3;
----
3 WH_34

statement ok
DROP VIEW vw_inv_2879;

statement ok
DROP TABLE #inv_delta_2879;

statement ok
DROP TABLE inv_main_2879;
