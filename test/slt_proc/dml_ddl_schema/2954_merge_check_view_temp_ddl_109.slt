# test/slt_proc/dml_ddl_schema/2954_merge_check_view_temp_ddl_109.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (109)

statement ok
CREATE TABLE inv_main_2954 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 545 CHECK (qty >= 545)
);

statement ok
INSERT INTO inv_main_2954 (item_id, sku, qty) VALUES (1, 'SKU_A_109', 555), (2, 'SKU_B_109', 570);

statement error
INSERT INTO inv_main_2954 (item_id, sku, qty) VALUES (9, 'SKU_BAD_109', 544);

statement ok
INSERT INTO inv_main_2954 (item_id, sku) VALUES (3, 'SKU_DEF_109');

statement ok
CREATE TABLE #inv_delta_2954 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2954 VALUES (2, 'SKU_B_109', 5), (4, 'SKU_D_109', 585);

statement ok
MERGE inv_main_2954 AS t
USING #inv_delta_2954 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2954 AS
SELECT item_id, sku, qty FROM inv_main_2954 WHERE qty > 545;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2954 ORDER BY item_id;
----
1 SKU_A_109 555
2 SKU_B_109 575
4 SKU_D_109 585

statement ok
ALTER TABLE inv_main_2954 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_109';

query IT
SELECT item_id, wh_code FROM inv_main_2954 WHERE item_id = 3;
----
3 WH_109

statement ok
DROP VIEW vw_inv_2954;

statement ok
DROP TABLE #inv_delta_2954;

statement ok
DROP TABLE inv_main_2954;
