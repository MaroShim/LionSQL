# test/slt_proc/dml_ddl_schema/244_merge_constraints_views_ddl_14.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (14)

statement ok
CREATE TABLE m_tgt_244 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1400 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_244 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_244 (sku, code, qty) VALUES (1, 'A_14', 70), (2, 'B_14', 140);

statement ok
INSERT INTO m_src_244 VALUES (2, 'B_14', 28), (3, 'C_14', 210);

statement error
INSERT INTO m_tgt_244 (sku, code, qty) VALUES (9, 'NEG_14', -5);

statement ok
MERGE m_tgt_244 AS t
USING m_src_244 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_244 ORDER BY sku;
----
1 A_14 70
2 B_14 168
3 C_14 210

query II
SELECT TOP 2 sku, qty FROM m_tgt_244 ORDER BY sku DESC;
----
3 210
2 168

statement ok
ALTER TABLE m_tgt_244 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_244 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_244;

statement ok
DROP TABLE m_tgt_244;
