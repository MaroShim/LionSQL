# test/slt_proc/dml_ddl_schema/2867_merge_check_view_temp_ddl_022.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (22)

statement ok
CREATE TABLE inv_main_2867 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 110 CHECK (qty >= 110)
);

statement ok
INSERT INTO inv_main_2867 (item_id, sku, qty) VALUES (1, 'SKU_A_22', 120), (2, 'SKU_B_22', 135);

statement error
INSERT INTO inv_main_2867 (item_id, sku, qty) VALUES (9, 'SKU_BAD_22', 109);

statement ok
INSERT INTO inv_main_2867 (item_id, sku) VALUES (3, 'SKU_DEF_22');

statement ok
CREATE TABLE #inv_delta_2867 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2867 VALUES (2, 'SKU_B_22', 5), (4, 'SKU_D_22', 150);

statement ok
MERGE inv_main_2867 AS t
USING #inv_delta_2867 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2867 AS
SELECT item_id, sku, qty FROM inv_main_2867 WHERE qty > 110;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2867 ORDER BY item_id;
----
1 SKU_A_22 120
2 SKU_B_22 140
4 SKU_D_22 150

statement ok
ALTER TABLE inv_main_2867 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_22';

query IT
SELECT item_id, wh_code FROM inv_main_2867 WHERE item_id = 3;
----
3 WH_22

statement ok
DROP VIEW vw_inv_2867;

statement ok
DROP TABLE #inv_delta_2867;

statement ok
DROP TABLE inv_main_2867;
