# test/slt_proc/dml_ddl_schema/2989_merge_check_view_temp_ddl_144.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (144)

statement ok
CREATE TABLE inv_main_2989 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 720 CHECK (qty >= 720)
);

statement ok
INSERT INTO inv_main_2989 (item_id, sku, qty) VALUES (1, 'SKU_A_144', 730), (2, 'SKU_B_144', 745);

statement error
INSERT INTO inv_main_2989 (item_id, sku, qty) VALUES (9, 'SKU_BAD_144', 719);

statement ok
INSERT INTO inv_main_2989 (item_id, sku) VALUES (3, 'SKU_DEF_144');

statement ok
CREATE TABLE #inv_delta_2989 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2989 VALUES (2, 'SKU_B_144', 5), (4, 'SKU_D_144', 760);

statement ok
MERGE inv_main_2989 AS t
USING #inv_delta_2989 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2989 AS
SELECT item_id, sku, qty FROM inv_main_2989 WHERE qty > 720;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2989 ORDER BY item_id;
----
1 SKU_A_144 730
2 SKU_B_144 750
4 SKU_D_144 760

statement ok
ALTER TABLE inv_main_2989 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_144';

query IT
SELECT item_id, wh_code FROM inv_main_2989 WHERE item_id = 3;
----
3 WH_144

statement ok
DROP VIEW vw_inv_2989;

statement ok
DROP TABLE #inv_delta_2989;

statement ok
DROP TABLE inv_main_2989;
