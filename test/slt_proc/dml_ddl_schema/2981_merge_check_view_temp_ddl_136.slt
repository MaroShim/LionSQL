# test/slt_proc/dml_ddl_schema/2981_merge_check_view_temp_ddl_136.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (136)

statement ok
CREATE TABLE inv_main_2981 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 680 CHECK (qty >= 680)
);

statement ok
INSERT INTO inv_main_2981 (item_id, sku, qty) VALUES (1, 'SKU_A_136', 690), (2, 'SKU_B_136', 705);

statement error
INSERT INTO inv_main_2981 (item_id, sku, qty) VALUES (9, 'SKU_BAD_136', 679);

statement ok
INSERT INTO inv_main_2981 (item_id, sku) VALUES (3, 'SKU_DEF_136');

statement ok
CREATE TABLE #inv_delta_2981 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2981 VALUES (2, 'SKU_B_136', 5), (4, 'SKU_D_136', 720);

statement ok
MERGE inv_main_2981 AS t
USING #inv_delta_2981 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2981 AS
SELECT item_id, sku, qty FROM inv_main_2981 WHERE qty > 680;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2981 ORDER BY item_id;
----
1 SKU_A_136 690
2 SKU_B_136 710
4 SKU_D_136 720

statement ok
ALTER TABLE inv_main_2981 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_136';

query IT
SELECT item_id, wh_code FROM inv_main_2981 WHERE item_id = 3;
----
3 WH_136

statement ok
DROP VIEW vw_inv_2981;

statement ok
DROP TABLE #inv_delta_2981;

statement ok
DROP TABLE inv_main_2981;
