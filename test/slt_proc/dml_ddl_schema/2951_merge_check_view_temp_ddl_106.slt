# test/slt_proc/dml_ddl_schema/2951_merge_check_view_temp_ddl_106.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (106)

statement ok
CREATE TABLE inv_main_2951 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 530 CHECK (qty >= 530)
);

statement ok
INSERT INTO inv_main_2951 (item_id, sku, qty) VALUES (1, 'SKU_A_106', 540), (2, 'SKU_B_106', 555);

statement error
INSERT INTO inv_main_2951 (item_id, sku, qty) VALUES (9, 'SKU_BAD_106', 529);

statement ok
INSERT INTO inv_main_2951 (item_id, sku) VALUES (3, 'SKU_DEF_106');

statement ok
CREATE TABLE #inv_delta_2951 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2951 VALUES (2, 'SKU_B_106', 5), (4, 'SKU_D_106', 570);

statement ok
MERGE inv_main_2951 AS t
USING #inv_delta_2951 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2951 AS
SELECT item_id, sku, qty FROM inv_main_2951 WHERE qty > 530;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2951 ORDER BY item_id;
----
1 SKU_A_106 540
2 SKU_B_106 560
4 SKU_D_106 570

statement ok
ALTER TABLE inv_main_2951 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_106';

query IT
SELECT item_id, wh_code FROM inv_main_2951 WHERE item_id = 3;
----
3 WH_106

statement ok
DROP VIEW vw_inv_2951;

statement ok
DROP TABLE #inv_delta_2951;

statement ok
DROP TABLE inv_main_2951;
