# test/slt_proc/dml_ddl_schema/2958_merge_check_view_temp_ddl_113.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (113)

statement ok
CREATE TABLE inv_main_2958 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 565 CHECK (qty >= 565)
);

statement ok
INSERT INTO inv_main_2958 (item_id, sku, qty) VALUES (1, 'SKU_A_113', 575), (2, 'SKU_B_113', 590);

statement error
INSERT INTO inv_main_2958 (item_id, sku, qty) VALUES (9, 'SKU_BAD_113', 564);

statement ok
INSERT INTO inv_main_2958 (item_id, sku) VALUES (3, 'SKU_DEF_113');

statement ok
CREATE TABLE #inv_delta_2958 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2958 VALUES (2, 'SKU_B_113', 5), (4, 'SKU_D_113', 605);

statement ok
MERGE inv_main_2958 AS t
USING #inv_delta_2958 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2958 AS
SELECT item_id, sku, qty FROM inv_main_2958 WHERE qty > 565;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2958 ORDER BY item_id;
----
1 SKU_A_113 575
2 SKU_B_113 595
4 SKU_D_113 605

statement ok
ALTER TABLE inv_main_2958 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_113';

query IT
SELECT item_id, wh_code FROM inv_main_2958 WHERE item_id = 3;
----
3 WH_113

statement ok
DROP VIEW vw_inv_2958;

statement ok
DROP TABLE #inv_delta_2958;

statement ok
DROP TABLE inv_main_2958;
