# test/slt_proc/dml_ddl_schema/2910_merge_check_view_temp_ddl_065.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (65)

statement ok
CREATE TABLE inv_main_2910 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 325 CHECK (qty >= 325)
);

statement ok
INSERT INTO inv_main_2910 (item_id, sku, qty) VALUES (1, 'SKU_A_65', 335), (2, 'SKU_B_65', 350);

statement error
INSERT INTO inv_main_2910 (item_id, sku, qty) VALUES (9, 'SKU_BAD_65', 324);

statement ok
INSERT INTO inv_main_2910 (item_id, sku) VALUES (3, 'SKU_DEF_65');

statement ok
CREATE TABLE #inv_delta_2910 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2910 VALUES (2, 'SKU_B_65', 5), (4, 'SKU_D_65', 365);

statement ok
MERGE inv_main_2910 AS t
USING #inv_delta_2910 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2910 AS
SELECT item_id, sku, qty FROM inv_main_2910 WHERE qty > 325;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2910 ORDER BY item_id;
----
1 SKU_A_65 335
2 SKU_B_65 355
4 SKU_D_65 365

statement ok
ALTER TABLE inv_main_2910 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_65';

query IT
SELECT item_id, wh_code FROM inv_main_2910 WHERE item_id = 3;
----
3 WH_65

statement ok
DROP VIEW vw_inv_2910;

statement ok
DROP TABLE #inv_delta_2910;

statement ok
DROP TABLE inv_main_2910;
