# test/slt_proc/dml_ddl_schema/2959_merge_check_view_temp_ddl_114.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (114)

statement ok
CREATE TABLE inv_main_2959 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 570 CHECK (qty >= 570)
);

statement ok
INSERT INTO inv_main_2959 (item_id, sku, qty) VALUES (1, 'SKU_A_114', 580), (2, 'SKU_B_114', 595);

statement error
INSERT INTO inv_main_2959 (item_id, sku, qty) VALUES (9, 'SKU_BAD_114', 569);

statement ok
INSERT INTO inv_main_2959 (item_id, sku) VALUES (3, 'SKU_DEF_114');

statement ok
CREATE TABLE #inv_delta_2959 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2959 VALUES (2, 'SKU_B_114', 5), (4, 'SKU_D_114', 610);

statement ok
MERGE inv_main_2959 AS t
USING #inv_delta_2959 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2959 AS
SELECT item_id, sku, qty FROM inv_main_2959 WHERE qty > 570;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2959 ORDER BY item_id;
----
1 SKU_A_114 580
2 SKU_B_114 600
4 SKU_D_114 610

statement ok
ALTER TABLE inv_main_2959 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_114';

query IT
SELECT item_id, wh_code FROM inv_main_2959 WHERE item_id = 3;
----
3 WH_114

statement ok
DROP VIEW vw_inv_2959;

statement ok
DROP TABLE #inv_delta_2959;

statement ok
DROP TABLE inv_main_2959;
