# test/slt_proc/dml_ddl_schema/2855_merge_check_view_temp_ddl_010.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (10)

statement ok
CREATE TABLE inv_main_2855 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 50 CHECK (qty >= 50)
);

statement ok
INSERT INTO inv_main_2855 (item_id, sku, qty) VALUES (1, 'SKU_A_10', 60), (2, 'SKU_B_10', 75);

statement error
INSERT INTO inv_main_2855 (item_id, sku, qty) VALUES (9, 'SKU_BAD_10', 49);

statement ok
INSERT INTO inv_main_2855 (item_id, sku) VALUES (3, 'SKU_DEF_10');

statement ok
CREATE TABLE #inv_delta_2855 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2855 VALUES (2, 'SKU_B_10', 5), (4, 'SKU_D_10', 90);

statement ok
MERGE inv_main_2855 AS t
USING #inv_delta_2855 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2855 AS
SELECT item_id, sku, qty FROM inv_main_2855 WHERE qty > 50;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2855 ORDER BY item_id;
----
1 SKU_A_10 60
2 SKU_B_10 80
4 SKU_D_10 90

statement ok
ALTER TABLE inv_main_2855 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_10';

query IT
SELECT item_id, wh_code FROM inv_main_2855 WHERE item_id = 3;
----
3 WH_10

statement ok
DROP VIEW vw_inv_2855;

statement ok
DROP TABLE #inv_delta_2855;

statement ok
DROP TABLE inv_main_2855;
