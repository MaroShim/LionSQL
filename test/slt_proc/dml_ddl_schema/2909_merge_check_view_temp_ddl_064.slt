# test/slt_proc/dml_ddl_schema/2909_merge_check_view_temp_ddl_064.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (64)

statement ok
CREATE TABLE inv_main_2909 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 320 CHECK (qty >= 320)
);

statement ok
INSERT INTO inv_main_2909 (item_id, sku, qty) VALUES (1, 'SKU_A_64', 330), (2, 'SKU_B_64', 345);

statement error
INSERT INTO inv_main_2909 (item_id, sku, qty) VALUES (9, 'SKU_BAD_64', 319);

statement ok
INSERT INTO inv_main_2909 (item_id, sku) VALUES (3, 'SKU_DEF_64');

statement ok
CREATE TABLE #inv_delta_2909 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2909 VALUES (2, 'SKU_B_64', 5), (4, 'SKU_D_64', 360);

statement ok
MERGE inv_main_2909 AS t
USING #inv_delta_2909 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2909 AS
SELECT item_id, sku, qty FROM inv_main_2909 WHERE qty > 320;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2909 ORDER BY item_id;
----
1 SKU_A_64 330
2 SKU_B_64 350
4 SKU_D_64 360

statement ok
ALTER TABLE inv_main_2909 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_64';

query IT
SELECT item_id, wh_code FROM inv_main_2909 WHERE item_id = 3;
----
3 WH_64

statement ok
DROP VIEW vw_inv_2909;

statement ok
DROP TABLE #inv_delta_2909;

statement ok
DROP TABLE inv_main_2909;
