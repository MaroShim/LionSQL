# test/slt_proc/dml_ddl_schema/2966_merge_check_view_temp_ddl_121.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (121)

statement ok
CREATE TABLE inv_main_2966 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 605 CHECK (qty >= 605)
);

statement ok
INSERT INTO inv_main_2966 (item_id, sku, qty) VALUES (1, 'SKU_A_121', 615), (2, 'SKU_B_121', 630);

statement error
INSERT INTO inv_main_2966 (item_id, sku, qty) VALUES (9, 'SKU_BAD_121', 604);

statement ok
INSERT INTO inv_main_2966 (item_id, sku) VALUES (3, 'SKU_DEF_121');

statement ok
CREATE TABLE #inv_delta_2966 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2966 VALUES (2, 'SKU_B_121', 5), (4, 'SKU_D_121', 645);

statement ok
MERGE inv_main_2966 AS t
USING #inv_delta_2966 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2966 AS
SELECT item_id, sku, qty FROM inv_main_2966 WHERE qty > 605;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2966 ORDER BY item_id;
----
1 SKU_A_121 615
2 SKU_B_121 635
4 SKU_D_121 645

statement ok
ALTER TABLE inv_main_2966 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_121';

query IT
SELECT item_id, wh_code FROM inv_main_2966 WHERE item_id = 3;
----
3 WH_121

statement ok
DROP VIEW vw_inv_2966;

statement ok
DROP TABLE #inv_delta_2966;

statement ok
DROP TABLE inv_main_2966;
