# test/slt_proc/dml_ddl_schema/2964_merge_check_view_temp_ddl_119.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (119)

statement ok
CREATE TABLE inv_main_2964 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 595 CHECK (qty >= 595)
);

statement ok
INSERT INTO inv_main_2964 (item_id, sku, qty) VALUES (1, 'SKU_A_119', 605), (2, 'SKU_B_119', 620);

statement error
INSERT INTO inv_main_2964 (item_id, sku, qty) VALUES (9, 'SKU_BAD_119', 594);

statement ok
INSERT INTO inv_main_2964 (item_id, sku) VALUES (3, 'SKU_DEF_119');

statement ok
CREATE TABLE #inv_delta_2964 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2964 VALUES (2, 'SKU_B_119', 5), (4, 'SKU_D_119', 635);

statement ok
MERGE inv_main_2964 AS t
USING #inv_delta_2964 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2964 AS
SELECT item_id, sku, qty FROM inv_main_2964 WHERE qty > 595;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2964 ORDER BY item_id;
----
1 SKU_A_119 605
2 SKU_B_119 625
4 SKU_D_119 635

statement ok
ALTER TABLE inv_main_2964 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_119';

query IT
SELECT item_id, wh_code FROM inv_main_2964 WHERE item_id = 3;
----
3 WH_119

statement ok
DROP VIEW vw_inv_2964;

statement ok
DROP TABLE #inv_delta_2964;

statement ok
DROP TABLE inv_main_2964;
