# test/slt_proc/dml_ddl_schema/2921_merge_check_view_temp_ddl_076.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (76)

statement ok
CREATE TABLE inv_main_2921 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 380 CHECK (qty >= 380)
);

statement ok
INSERT INTO inv_main_2921 (item_id, sku, qty) VALUES (1, 'SKU_A_76', 390), (2, 'SKU_B_76', 405);

statement error
INSERT INTO inv_main_2921 (item_id, sku, qty) VALUES (9, 'SKU_BAD_76', 379);

statement ok
INSERT INTO inv_main_2921 (item_id, sku) VALUES (3, 'SKU_DEF_76');

statement ok
CREATE TABLE #inv_delta_2921 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2921 VALUES (2, 'SKU_B_76', 5), (4, 'SKU_D_76', 420);

statement ok
MERGE inv_main_2921 AS t
USING #inv_delta_2921 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2921 AS
SELECT item_id, sku, qty FROM inv_main_2921 WHERE qty > 380;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2921 ORDER BY item_id;
----
1 SKU_A_76 390
2 SKU_B_76 410
4 SKU_D_76 420

statement ok
ALTER TABLE inv_main_2921 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_76';

query IT
SELECT item_id, wh_code FROM inv_main_2921 WHERE item_id = 3;
----
3 WH_76

statement ok
DROP VIEW vw_inv_2921;

statement ok
DROP TABLE #inv_delta_2921;

statement ok
DROP TABLE inv_main_2921;
