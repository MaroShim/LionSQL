# test/slt_proc/dml_ddl_schema/2906_merge_check_view_temp_ddl_061.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (61)

statement ok
CREATE TABLE inv_main_2906 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 305 CHECK (qty >= 305)
);

statement ok
INSERT INTO inv_main_2906 (item_id, sku, qty) VALUES (1, 'SKU_A_61', 315), (2, 'SKU_B_61', 330);

statement error
INSERT INTO inv_main_2906 (item_id, sku, qty) VALUES (9, 'SKU_BAD_61', 304);

statement ok
INSERT INTO inv_main_2906 (item_id, sku) VALUES (3, 'SKU_DEF_61');

statement ok
CREATE TABLE #inv_delta_2906 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2906 VALUES (2, 'SKU_B_61', 5), (4, 'SKU_D_61', 345);

statement ok
MERGE inv_main_2906 AS t
USING #inv_delta_2906 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2906 AS
SELECT item_id, sku, qty FROM inv_main_2906 WHERE qty > 305;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2906 ORDER BY item_id;
----
1 SKU_A_61 315
2 SKU_B_61 335
4 SKU_D_61 345

statement ok
ALTER TABLE inv_main_2906 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_61';

query IT
SELECT item_id, wh_code FROM inv_main_2906 WHERE item_id = 3;
----
3 WH_61

statement ok
DROP VIEW vw_inv_2906;

statement ok
DROP TABLE #inv_delta_2906;

statement ok
DROP TABLE inv_main_2906;
