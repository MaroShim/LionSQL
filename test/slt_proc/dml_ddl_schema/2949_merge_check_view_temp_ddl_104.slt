# test/slt_proc/dml_ddl_schema/2949_merge_check_view_temp_ddl_104.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (104)

statement ok
CREATE TABLE inv_main_2949 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 520 CHECK (qty >= 520)
);

statement ok
INSERT INTO inv_main_2949 (item_id, sku, qty) VALUES (1, 'SKU_A_104', 530), (2, 'SKU_B_104', 545);

statement error
INSERT INTO inv_main_2949 (item_id, sku, qty) VALUES (9, 'SKU_BAD_104', 519);

statement ok
INSERT INTO inv_main_2949 (item_id, sku) VALUES (3, 'SKU_DEF_104');

statement ok
CREATE TABLE #inv_delta_2949 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2949 VALUES (2, 'SKU_B_104', 5), (4, 'SKU_D_104', 560);

statement ok
MERGE inv_main_2949 AS t
USING #inv_delta_2949 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2949 AS
SELECT item_id, sku, qty FROM inv_main_2949 WHERE qty > 520;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2949 ORDER BY item_id;
----
1 SKU_A_104 530
2 SKU_B_104 550
4 SKU_D_104 560

statement ok
ALTER TABLE inv_main_2949 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_104';

query IT
SELECT item_id, wh_code FROM inv_main_2949 WHERE item_id = 3;
----
3 WH_104

statement ok
DROP VIEW vw_inv_2949;

statement ok
DROP TABLE #inv_delta_2949;

statement ok
DROP TABLE inv_main_2949;
