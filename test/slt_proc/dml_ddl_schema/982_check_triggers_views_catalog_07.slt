# test/slt_proc/dml_ddl_schema/982_check_triggers_views_catalog_07.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (7)

statement ok
CREATE TABLE acct_982 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 70 CHECK (balance >= 70)
);

statement ok
CREATE VIEW vw_acct_high_982 AS
SELECT id, owner, balance FROM acct_982 WHERE balance > 70;

statement ok
INSERT INTO acct_982 (id, owner, balance) VALUES (1, 'UserA_7', 120), (2, 'UserB_7', 190);

statement error
INSERT INTO acct_982 (id, owner, balance) VALUES (3, 'BadUser_7', 65);

statement error
UPDATE acct_982 SET balance = 65 WHERE id = 1;

statement ok
INSERT INTO acct_982 (id, owner) VALUES (4, 'DefaultUser_7');

query ITI
SELECT id, owner, balance FROM acct_982 ORDER BY id;
----
1 UserA_7 120
2 UserB_7 190
4 DefaultUser_7 70

query II
SELECT id, balance FROM vw_acct_high_982 ORDER BY id;
----
1 120
2 190

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_982';
----
vw_acct_high_982

statement ok
DROP VIEW vw_acct_high_982;

statement ok
DROP TABLE acct_982;
