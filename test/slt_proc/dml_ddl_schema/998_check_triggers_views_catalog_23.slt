# test/slt_proc/dml_ddl_schema/998_check_triggers_views_catalog_23.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (23)

statement ok
CREATE TABLE acct_998 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 230 CHECK (balance >= 230)
);

statement ok
CREATE VIEW vw_acct_high_998 AS
SELECT id, owner, balance FROM acct_998 WHERE balance > 230;

statement ok
INSERT INTO acct_998 (id, owner, balance) VALUES (1, 'UserA_23', 280), (2, 'UserB_23', 350);

statement error
INSERT INTO acct_998 (id, owner, balance) VALUES (3, 'BadUser_23', 225);

statement error
UPDATE acct_998 SET balance = 225 WHERE id = 1;

statement ok
INSERT INTO acct_998 (id, owner) VALUES (4, 'DefaultUser_23');

query ITI
SELECT id, owner, balance FROM acct_998 ORDER BY id;
----
1 UserA_23 280
2 UserB_23 350
4 DefaultUser_23 230

query II
SELECT id, balance FROM vw_acct_high_998 ORDER BY id;
----
1 280
2 350

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_998';
----
vw_acct_high_998

statement ok
DROP VIEW vw_acct_high_998;

statement ok
DROP TABLE acct_998;
