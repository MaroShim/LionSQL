# test/slt_proc/dml_ddl_schema/240_merge_constraints_views_ddl_10.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (10)

statement ok
CREATE TABLE m_tgt_240 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1000 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_240 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_240 (sku, code, qty) VALUES (1, 'A_10', 50), (2, 'B_10', 100);

statement ok
INSERT INTO m_src_240 VALUES (2, 'B_10', 20), (3, 'C_10', 150);

statement error
INSERT INTO m_tgt_240 (sku, code, qty) VALUES (9, 'NEG_10', -5);

statement ok
MERGE m_tgt_240 AS t
USING m_src_240 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_240 ORDER BY sku;
----
1 A_10 50
2 B_10 120
3 C_10 150

query II
SELECT TOP 2 sku, qty FROM m_tgt_240 ORDER BY sku DESC;
----
3 150
2 120

statement ok
ALTER TABLE m_tgt_240 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_240 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_240;

statement ok
DROP TABLE m_tgt_240;
