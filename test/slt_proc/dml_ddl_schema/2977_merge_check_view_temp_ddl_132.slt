# test/slt_proc/dml_ddl_schema/2977_merge_check_view_temp_ddl_132.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (132)

statement ok
CREATE TABLE inv_main_2977 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 660 CHECK (qty >= 660)
);

statement ok
INSERT INTO inv_main_2977 (item_id, sku, qty) VALUES (1, 'SKU_A_132', 670), (2, 'SKU_B_132', 685);

statement error
INSERT INTO inv_main_2977 (item_id, sku, qty) VALUES (9, 'SKU_BAD_132', 659);

statement ok
INSERT INTO inv_main_2977 (item_id, sku) VALUES (3, 'SKU_DEF_132');

statement ok
CREATE TABLE #inv_delta_2977 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2977 VALUES (2, 'SKU_B_132', 5), (4, 'SKU_D_132', 700);

statement ok
MERGE inv_main_2977 AS t
USING #inv_delta_2977 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2977 AS
SELECT item_id, sku, qty FROM inv_main_2977 WHERE qty > 660;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2977 ORDER BY item_id;
----
1 SKU_A_132 670
2 SKU_B_132 690
4 SKU_D_132 700

statement ok
ALTER TABLE inv_main_2977 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_132';

query IT
SELECT item_id, wh_code FROM inv_main_2977 WHERE item_id = 3;
----
3 WH_132

statement ok
DROP VIEW vw_inv_2977;

statement ok
DROP TABLE #inv_delta_2977;

statement ok
DROP TABLE inv_main_2977;
