# test/slt_proc/dml_ddl_schema/2888_merge_check_view_temp_ddl_043.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (43)

statement ok
CREATE TABLE inv_main_2888 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 215 CHECK (qty >= 215)
);

statement ok
INSERT INTO inv_main_2888 (item_id, sku, qty) VALUES (1, 'SKU_A_43', 225), (2, 'SKU_B_43', 240);

statement error
INSERT INTO inv_main_2888 (item_id, sku, qty) VALUES (9, 'SKU_BAD_43', 214);

statement ok
INSERT INTO inv_main_2888 (item_id, sku) VALUES (3, 'SKU_DEF_43');

statement ok
CREATE TABLE #inv_delta_2888 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2888 VALUES (2, 'SKU_B_43', 5), (4, 'SKU_D_43', 255);

statement ok
MERGE inv_main_2888 AS t
USING #inv_delta_2888 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2888 AS
SELECT item_id, sku, qty FROM inv_main_2888 WHERE qty > 215;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2888 ORDER BY item_id;
----
1 SKU_A_43 225
2 SKU_B_43 245
4 SKU_D_43 255

statement ok
ALTER TABLE inv_main_2888 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_43';

query IT
SELECT item_id, wh_code FROM inv_main_2888 WHERE item_id = 3;
----
3 WH_43

statement ok
DROP VIEW vw_inv_2888;

statement ok
DROP TABLE #inv_delta_2888;

statement ok
DROP TABLE inv_main_2888;
