# test/slt_proc/dml_ddl_schema/2892_merge_check_view_temp_ddl_047.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (47)

statement ok
CREATE TABLE inv_main_2892 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 235 CHECK (qty >= 235)
);

statement ok
INSERT INTO inv_main_2892 (item_id, sku, qty) VALUES (1, 'SKU_A_47', 245), (2, 'SKU_B_47', 260);

statement error
INSERT INTO inv_main_2892 (item_id, sku, qty) VALUES (9, 'SKU_BAD_47', 234);

statement ok
INSERT INTO inv_main_2892 (item_id, sku) VALUES (3, 'SKU_DEF_47');

statement ok
CREATE TABLE #inv_delta_2892 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2892 VALUES (2, 'SKU_B_47', 5), (4, 'SKU_D_47', 275);

statement ok
MERGE inv_main_2892 AS t
USING #inv_delta_2892 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2892 AS
SELECT item_id, sku, qty FROM inv_main_2892 WHERE qty > 235;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2892 ORDER BY item_id;
----
1 SKU_A_47 245
2 SKU_B_47 265
4 SKU_D_47 275

statement ok
ALTER TABLE inv_main_2892 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_47';

query IT
SELECT item_id, wh_code FROM inv_main_2892 WHERE item_id = 3;
----
3 WH_47

statement ok
DROP VIEW vw_inv_2892;

statement ok
DROP TABLE #inv_delta_2892;

statement ok
DROP TABLE inv_main_2892;
