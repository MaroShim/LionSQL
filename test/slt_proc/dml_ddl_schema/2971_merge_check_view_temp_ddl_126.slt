# test/slt_proc/dml_ddl_schema/2971_merge_check_view_temp_ddl_126.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (126)

statement ok
CREATE TABLE inv_main_2971 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 630 CHECK (qty >= 630)
);

statement ok
INSERT INTO inv_main_2971 (item_id, sku, qty) VALUES (1, 'SKU_A_126', 640), (2, 'SKU_B_126', 655);

statement error
INSERT INTO inv_main_2971 (item_id, sku, qty) VALUES (9, 'SKU_BAD_126', 629);

statement ok
INSERT INTO inv_main_2971 (item_id, sku) VALUES (3, 'SKU_DEF_126');

statement ok
CREATE TABLE #inv_delta_2971 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2971 VALUES (2, 'SKU_B_126', 5), (4, 'SKU_D_126', 670);

statement ok
MERGE inv_main_2971 AS t
USING #inv_delta_2971 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2971 AS
SELECT item_id, sku, qty FROM inv_main_2971 WHERE qty > 630;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2971 ORDER BY item_id;
----
1 SKU_A_126 640
2 SKU_B_126 660
4 SKU_D_126 670

statement ok
ALTER TABLE inv_main_2971 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_126';

query IT
SELECT item_id, wh_code FROM inv_main_2971 WHERE item_id = 3;
----
3 WH_126

statement ok
DROP VIEW vw_inv_2971;

statement ok
DROP TABLE #inv_delta_2971;

statement ok
DROP TABLE inv_main_2971;
