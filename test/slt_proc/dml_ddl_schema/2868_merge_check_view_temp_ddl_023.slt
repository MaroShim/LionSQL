# test/slt_proc/dml_ddl_schema/2868_merge_check_view_temp_ddl_023.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (23)

statement ok
CREATE TABLE inv_main_2868 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 115 CHECK (qty >= 115)
);

statement ok
INSERT INTO inv_main_2868 (item_id, sku, qty) VALUES (1, 'SKU_A_23', 125), (2, 'SKU_B_23', 140);

statement error
INSERT INTO inv_main_2868 (item_id, sku, qty) VALUES (9, 'SKU_BAD_23', 114);

statement ok
INSERT INTO inv_main_2868 (item_id, sku) VALUES (3, 'SKU_DEF_23');

statement ok
CREATE TABLE #inv_delta_2868 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2868 VALUES (2, 'SKU_B_23', 5), (4, 'SKU_D_23', 155);

statement ok
MERGE inv_main_2868 AS t
USING #inv_delta_2868 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2868 AS
SELECT item_id, sku, qty FROM inv_main_2868 WHERE qty > 115;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2868 ORDER BY item_id;
----
1 SKU_A_23 125
2 SKU_B_23 145
4 SKU_D_23 155

statement ok
ALTER TABLE inv_main_2868 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_23';

query IT
SELECT item_id, wh_code FROM inv_main_2868 WHERE item_id = 3;
----
3 WH_23

statement ok
DROP VIEW vw_inv_2868;

statement ok
DROP TABLE #inv_delta_2868;

statement ok
DROP TABLE inv_main_2868;
