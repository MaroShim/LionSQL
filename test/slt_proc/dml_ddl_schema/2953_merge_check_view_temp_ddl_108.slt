# test/slt_proc/dml_ddl_schema/2953_merge_check_view_temp_ddl_108.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (108)

statement ok
CREATE TABLE inv_main_2953 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 540 CHECK (qty >= 540)
);

statement ok
INSERT INTO inv_main_2953 (item_id, sku, qty) VALUES (1, 'SKU_A_108', 550), (2, 'SKU_B_108', 565);

statement error
INSERT INTO inv_main_2953 (item_id, sku, qty) VALUES (9, 'SKU_BAD_108', 539);

statement ok
INSERT INTO inv_main_2953 (item_id, sku) VALUES (3, 'SKU_DEF_108');

statement ok
CREATE TABLE #inv_delta_2953 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2953 VALUES (2, 'SKU_B_108', 5), (4, 'SKU_D_108', 580);

statement ok
MERGE inv_main_2953 AS t
USING #inv_delta_2953 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2953 AS
SELECT item_id, sku, qty FROM inv_main_2953 WHERE qty > 540;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2953 ORDER BY item_id;
----
1 SKU_A_108 550
2 SKU_B_108 570
4 SKU_D_108 580

statement ok
ALTER TABLE inv_main_2953 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_108';

query IT
SELECT item_id, wh_code FROM inv_main_2953 WHERE item_id = 3;
----
3 WH_108

statement ok
DROP VIEW vw_inv_2953;

statement ok
DROP TABLE #inv_delta_2953;

statement ok
DROP TABLE inv_main_2953;
