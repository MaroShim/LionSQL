# test/slt_proc/dml_ddl_schema/985_check_triggers_views_catalog_10.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (10)

statement ok
CREATE TABLE acct_985 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 100 CHECK (balance >= 100)
);

statement ok
CREATE VIEW vw_acct_high_985 AS
SELECT id, owner, balance FROM acct_985 WHERE balance > 100;

statement ok
INSERT INTO acct_985 (id, owner, balance) VALUES (1, 'UserA_10', 150), (2, 'UserB_10', 220);

statement error
INSERT INTO acct_985 (id, owner, balance) VALUES (3, 'BadUser_10', 95);

statement error
UPDATE acct_985 SET balance = 95 WHERE id = 1;

statement ok
INSERT INTO acct_985 (id, owner) VALUES (4, 'DefaultUser_10');

query ITI
SELECT id, owner, balance FROM acct_985 ORDER BY id;
----
1 UserA_10 150
2 UserB_10 220
4 DefaultUser_10 100

query II
SELECT id, balance FROM vw_acct_high_985 ORDER BY id;
----
1 150
2 220

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_985';
----
vw_acct_high_985

statement ok
DROP VIEW vw_acct_high_985;

statement ok
DROP TABLE acct_985;
