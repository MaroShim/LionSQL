# test/slt_proc/dml_ddl_schema/2911_merge_check_view_temp_ddl_066.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (66)

statement ok
CREATE TABLE inv_main_2911 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 330 CHECK (qty >= 330)
);

statement ok
INSERT INTO inv_main_2911 (item_id, sku, qty) VALUES (1, 'SKU_A_66', 340), (2, 'SKU_B_66', 355);

statement error
INSERT INTO inv_main_2911 (item_id, sku, qty) VALUES (9, 'SKU_BAD_66', 329);

statement ok
INSERT INTO inv_main_2911 (item_id, sku) VALUES (3, 'SKU_DEF_66');

statement ok
CREATE TABLE #inv_delta_2911 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2911 VALUES (2, 'SKU_B_66', 5), (4, 'SKU_D_66', 370);

statement ok
MERGE inv_main_2911 AS t
USING #inv_delta_2911 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2911 AS
SELECT item_id, sku, qty FROM inv_main_2911 WHERE qty > 330;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2911 ORDER BY item_id;
----
1 SKU_A_66 340
2 SKU_B_66 360
4 SKU_D_66 370

statement ok
ALTER TABLE inv_main_2911 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_66';

query IT
SELECT item_id, wh_code FROM inv_main_2911 WHERE item_id = 3;
----
3 WH_66

statement ok
DROP VIEW vw_inv_2911;

statement ok
DROP TABLE #inv_delta_2911;

statement ok
DROP TABLE inv_main_2911;
