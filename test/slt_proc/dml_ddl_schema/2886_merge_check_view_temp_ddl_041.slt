# test/slt_proc/dml_ddl_schema/2886_merge_check_view_temp_ddl_041.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (41)

statement ok
CREATE TABLE inv_main_2886 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 205 CHECK (qty >= 205)
);

statement ok
INSERT INTO inv_main_2886 (item_id, sku, qty) VALUES (1, 'SKU_A_41', 215), (2, 'SKU_B_41', 230);

statement error
INSERT INTO inv_main_2886 (item_id, sku, qty) VALUES (9, 'SKU_BAD_41', 204);

statement ok
INSERT INTO inv_main_2886 (item_id, sku) VALUES (3, 'SKU_DEF_41');

statement ok
CREATE TABLE #inv_delta_2886 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2886 VALUES (2, 'SKU_B_41', 5), (4, 'SKU_D_41', 245);

statement ok
MERGE inv_main_2886 AS t
USING #inv_delta_2886 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2886 AS
SELECT item_id, sku, qty FROM inv_main_2886 WHERE qty > 205;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2886 ORDER BY item_id;
----
1 SKU_A_41 215
2 SKU_B_41 235
4 SKU_D_41 245

statement ok
ALTER TABLE inv_main_2886 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_41';

query IT
SELECT item_id, wh_code FROM inv_main_2886 WHERE item_id = 3;
----
3 WH_41

statement ok
DROP VIEW vw_inv_2886;

statement ok
DROP TABLE #inv_delta_2886;

statement ok
DROP TABLE inv_main_2886;
