# test/slt_proc/dml_ddl_schema/2890_merge_check_view_temp_ddl_045.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (45)

statement ok
CREATE TABLE inv_main_2890 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 225 CHECK (qty >= 225)
);

statement ok
INSERT INTO inv_main_2890 (item_id, sku, qty) VALUES (1, 'SKU_A_45', 235), (2, 'SKU_B_45', 250);

statement error
INSERT INTO inv_main_2890 (item_id, sku, qty) VALUES (9, 'SKU_BAD_45', 224);

statement ok
INSERT INTO inv_main_2890 (item_id, sku) VALUES (3, 'SKU_DEF_45');

statement ok
CREATE TABLE #inv_delta_2890 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2890 VALUES (2, 'SKU_B_45', 5), (4, 'SKU_D_45', 265);

statement ok
MERGE inv_main_2890 AS t
USING #inv_delta_2890 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2890 AS
SELECT item_id, sku, qty FROM inv_main_2890 WHERE qty > 225;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2890 ORDER BY item_id;
----
1 SKU_A_45 235
2 SKU_B_45 255
4 SKU_D_45 265

statement ok
ALTER TABLE inv_main_2890 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_45';

query IT
SELECT item_id, wh_code FROM inv_main_2890 WHERE item_id = 3;
----
3 WH_45

statement ok
DROP VIEW vw_inv_2890;

statement ok
DROP TABLE #inv_delta_2890;

statement ok
DROP TABLE inv_main_2890;
