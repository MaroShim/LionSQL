# test/slt_proc/dml_ddl_schema/2875_merge_check_view_temp_ddl_030.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (30)

statement ok
CREATE TABLE inv_main_2875 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 150 CHECK (qty >= 150)
);

statement ok
INSERT INTO inv_main_2875 (item_id, sku, qty) VALUES (1, 'SKU_A_30', 160), (2, 'SKU_B_30', 175);

statement error
INSERT INTO inv_main_2875 (item_id, sku, qty) VALUES (9, 'SKU_BAD_30', 149);

statement ok
INSERT INTO inv_main_2875 (item_id, sku) VALUES (3, 'SKU_DEF_30');

statement ok
CREATE TABLE #inv_delta_2875 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2875 VALUES (2, 'SKU_B_30', 5), (4, 'SKU_D_30', 190);

statement ok
MERGE inv_main_2875 AS t
USING #inv_delta_2875 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2875 AS
SELECT item_id, sku, qty FROM inv_main_2875 WHERE qty > 150;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2875 ORDER BY item_id;
----
1 SKU_A_30 160
2 SKU_B_30 180
4 SKU_D_30 190

statement ok
ALTER TABLE inv_main_2875 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_30';

query IT
SELECT item_id, wh_code FROM inv_main_2875 WHERE item_id = 3;
----
3 WH_30

statement ok
DROP VIEW vw_inv_2875;

statement ok
DROP TABLE #inv_delta_2875;

statement ok
DROP TABLE inv_main_2875;
