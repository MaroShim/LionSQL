# test/slt_proc/dml_ddl_schema/242_merge_constraints_views_ddl_12.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (12)

statement ok
CREATE TABLE m_tgt_242 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1200 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_242 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_242 (sku, code, qty) VALUES (1, 'A_12', 60), (2, 'B_12', 120);

statement ok
INSERT INTO m_src_242 VALUES (2, 'B_12', 24), (3, 'C_12', 180);

statement error
INSERT INTO m_tgt_242 (sku, code, qty) VALUES (9, 'NEG_12', -5);

statement ok
MERGE m_tgt_242 AS t
USING m_src_242 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_242 ORDER BY sku;
----
1 A_12 60
2 B_12 144
3 C_12 180

query II
SELECT TOP 2 sku, qty FROM m_tgt_242 ORDER BY sku DESC;
----
3 180
2 144

statement ok
ALTER TABLE m_tgt_242 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_242 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_242;

statement ok
DROP TABLE m_tgt_242;
