# test/slt_proc/dml_ddl_schema/2946_merge_check_view_temp_ddl_101.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (101)

statement ok
CREATE TABLE inv_main_2946 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 505 CHECK (qty >= 505)
);

statement ok
INSERT INTO inv_main_2946 (item_id, sku, qty) VALUES (1, 'SKU_A_101', 515), (2, 'SKU_B_101', 530);

statement error
INSERT INTO inv_main_2946 (item_id, sku, qty) VALUES (9, 'SKU_BAD_101', 504);

statement ok
INSERT INTO inv_main_2946 (item_id, sku) VALUES (3, 'SKU_DEF_101');

statement ok
CREATE TABLE #inv_delta_2946 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2946 VALUES (2, 'SKU_B_101', 5), (4, 'SKU_D_101', 545);

statement ok
MERGE inv_main_2946 AS t
USING #inv_delta_2946 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2946 AS
SELECT item_id, sku, qty FROM inv_main_2946 WHERE qty > 505;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2946 ORDER BY item_id;
----
1 SKU_A_101 515
2 SKU_B_101 535
4 SKU_D_101 545

statement ok
ALTER TABLE inv_main_2946 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_101';

query IT
SELECT item_id, wh_code FROM inv_main_2946 WHERE item_id = 3;
----
3 WH_101

statement ok
DROP VIEW vw_inv_2946;

statement ok
DROP TABLE #inv_delta_2946;

statement ok
DROP TABLE inv_main_2946;
