# test/slt_proc/dml_ddl_schema/2917_merge_check_view_temp_ddl_072.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (72)

statement ok
CREATE TABLE inv_main_2917 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 360 CHECK (qty >= 360)
);

statement ok
INSERT INTO inv_main_2917 (item_id, sku, qty) VALUES (1, 'SKU_A_72', 370), (2, 'SKU_B_72', 385);

statement error
INSERT INTO inv_main_2917 (item_id, sku, qty) VALUES (9, 'SKU_BAD_72', 359);

statement ok
INSERT INTO inv_main_2917 (item_id, sku) VALUES (3, 'SKU_DEF_72');

statement ok
CREATE TABLE #inv_delta_2917 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2917 VALUES (2, 'SKU_B_72', 5), (4, 'SKU_D_72', 400);

statement ok
MERGE inv_main_2917 AS t
USING #inv_delta_2917 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2917 AS
SELECT item_id, sku, qty FROM inv_main_2917 WHERE qty > 360;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2917 ORDER BY item_id;
----
1 SKU_A_72 370
2 SKU_B_72 390
4 SKU_D_72 400

statement ok
ALTER TABLE inv_main_2917 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_72';

query IT
SELECT item_id, wh_code FROM inv_main_2917 WHERE item_id = 3;
----
3 WH_72

statement ok
DROP VIEW vw_inv_2917;

statement ok
DROP TABLE #inv_delta_2917;

statement ok
DROP TABLE inv_main_2917;
