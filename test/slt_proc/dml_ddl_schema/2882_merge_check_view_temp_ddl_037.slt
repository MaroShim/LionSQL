# test/slt_proc/dml_ddl_schema/2882_merge_check_view_temp_ddl_037.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (37)

statement ok
CREATE TABLE inv_main_2882 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 185 CHECK (qty >= 185)
);

statement ok
INSERT INTO inv_main_2882 (item_id, sku, qty) VALUES (1, 'SKU_A_37', 195), (2, 'SKU_B_37', 210);

statement error
INSERT INTO inv_main_2882 (item_id, sku, qty) VALUES (9, 'SKU_BAD_37', 184);

statement ok
INSERT INTO inv_main_2882 (item_id, sku) VALUES (3, 'SKU_DEF_37');

statement ok
CREATE TABLE #inv_delta_2882 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2882 VALUES (2, 'SKU_B_37', 5), (4, 'SKU_D_37', 225);

statement ok
MERGE inv_main_2882 AS t
USING #inv_delta_2882 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2882 AS
SELECT item_id, sku, qty FROM inv_main_2882 WHERE qty > 185;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2882 ORDER BY item_id;
----
1 SKU_A_37 195
2 SKU_B_37 215
4 SKU_D_37 225

statement ok
ALTER TABLE inv_main_2882 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_37';

query IT
SELECT item_id, wh_code FROM inv_main_2882 WHERE item_id = 3;
----
3 WH_37

statement ok
DROP VIEW vw_inv_2882;

statement ok
DROP TABLE #inv_delta_2882;

statement ok
DROP TABLE inv_main_2882;
