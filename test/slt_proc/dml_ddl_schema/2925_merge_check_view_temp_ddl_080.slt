# test/slt_proc/dml_ddl_schema/2925_merge_check_view_temp_ddl_080.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (80)

statement ok
CREATE TABLE inv_main_2925 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 400 CHECK (qty >= 400)
);

statement ok
INSERT INTO inv_main_2925 (item_id, sku, qty) VALUES (1, 'SKU_A_80', 410), (2, 'SKU_B_80', 425);

statement error
INSERT INTO inv_main_2925 (item_id, sku, qty) VALUES (9, 'SKU_BAD_80', 399);

statement ok
INSERT INTO inv_main_2925 (item_id, sku) VALUES (3, 'SKU_DEF_80');

statement ok
CREATE TABLE #inv_delta_2925 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2925 VALUES (2, 'SKU_B_80', 5), (4, 'SKU_D_80', 440);

statement ok
MERGE inv_main_2925 AS t
USING #inv_delta_2925 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2925 AS
SELECT item_id, sku, qty FROM inv_main_2925 WHERE qty > 400;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2925 ORDER BY item_id;
----
1 SKU_A_80 410
2 SKU_B_80 430
4 SKU_D_80 440

statement ok
ALTER TABLE inv_main_2925 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_80';

query IT
SELECT item_id, wh_code FROM inv_main_2925 WHERE item_id = 3;
----
3 WH_80

statement ok
DROP VIEW vw_inv_2925;

statement ok
DROP TABLE #inv_delta_2925;

statement ok
DROP TABLE inv_main_2925;
