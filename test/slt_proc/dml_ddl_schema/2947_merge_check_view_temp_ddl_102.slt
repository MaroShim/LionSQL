# test/slt_proc/dml_ddl_schema/2947_merge_check_view_temp_ddl_102.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (102)

statement ok
CREATE TABLE inv_main_2947 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 510 CHECK (qty >= 510)
);

statement ok
INSERT INTO inv_main_2947 (item_id, sku, qty) VALUES (1, 'SKU_A_102', 520), (2, 'SKU_B_102', 535);

statement error
INSERT INTO inv_main_2947 (item_id, sku, qty) VALUES (9, 'SKU_BAD_102', 509);

statement ok
INSERT INTO inv_main_2947 (item_id, sku) VALUES (3, 'SKU_DEF_102');

statement ok
CREATE TABLE #inv_delta_2947 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2947 VALUES (2, 'SKU_B_102', 5), (4, 'SKU_D_102', 550);

statement ok
MERGE inv_main_2947 AS t
USING #inv_delta_2947 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2947 AS
SELECT item_id, sku, qty FROM inv_main_2947 WHERE qty > 510;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2947 ORDER BY item_id;
----
1 SKU_A_102 520
2 SKU_B_102 540
4 SKU_D_102 550

statement ok
ALTER TABLE inv_main_2947 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_102';

query IT
SELECT item_id, wh_code FROM inv_main_2947 WHERE item_id = 3;
----
3 WH_102

statement ok
DROP VIEW vw_inv_2947;

statement ok
DROP TABLE #inv_delta_2947;

statement ok
DROP TABLE inv_main_2947;
