# test/slt_proc/dml_ddl_schema/2924_merge_check_view_temp_ddl_079.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (79)

statement ok
CREATE TABLE inv_main_2924 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 395 CHECK (qty >= 395)
);

statement ok
INSERT INTO inv_main_2924 (item_id, sku, qty) VALUES (1, 'SKU_A_79', 405), (2, 'SKU_B_79', 420);

statement error
INSERT INTO inv_main_2924 (item_id, sku, qty) VALUES (9, 'SKU_BAD_79', 394);

statement ok
INSERT INTO inv_main_2924 (item_id, sku) VALUES (3, 'SKU_DEF_79');

statement ok
CREATE TABLE #inv_delta_2924 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2924 VALUES (2, 'SKU_B_79', 5), (4, 'SKU_D_79', 435);

statement ok
MERGE inv_main_2924 AS t
USING #inv_delta_2924 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2924 AS
SELECT item_id, sku, qty FROM inv_main_2924 WHERE qty > 395;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2924 ORDER BY item_id;
----
1 SKU_A_79 405
2 SKU_B_79 425
4 SKU_D_79 435

statement ok
ALTER TABLE inv_main_2924 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_79';

query IT
SELECT item_id, wh_code FROM inv_main_2924 WHERE item_id = 3;
----
3 WH_79

statement ok
DROP VIEW vw_inv_2924;

statement ok
DROP TABLE #inv_delta_2924;

statement ok
DROP TABLE inv_main_2924;
