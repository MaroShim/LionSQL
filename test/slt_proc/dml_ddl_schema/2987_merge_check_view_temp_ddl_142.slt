# test/slt_proc/dml_ddl_schema/2987_merge_check_view_temp_ddl_142.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (142)

statement ok
CREATE TABLE inv_main_2987 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 710 CHECK (qty >= 710)
);

statement ok
INSERT INTO inv_main_2987 (item_id, sku, qty) VALUES (1, 'SKU_A_142', 720), (2, 'SKU_B_142', 735);

statement error
INSERT INTO inv_main_2987 (item_id, sku, qty) VALUES (9, 'SKU_BAD_142', 709);

statement ok
INSERT INTO inv_main_2987 (item_id, sku) VALUES (3, 'SKU_DEF_142');

statement ok
CREATE TABLE #inv_delta_2987 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2987 VALUES (2, 'SKU_B_142', 5), (4, 'SKU_D_142', 750);

statement ok
MERGE inv_main_2987 AS t
USING #inv_delta_2987 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2987 AS
SELECT item_id, sku, qty FROM inv_main_2987 WHERE qty > 710;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2987 ORDER BY item_id;
----
1 SKU_A_142 720
2 SKU_B_142 740
4 SKU_D_142 750

statement ok
ALTER TABLE inv_main_2987 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_142';

query IT
SELECT item_id, wh_code FROM inv_main_2987 WHERE item_id = 3;
----
3 WH_142

statement ok
DROP VIEW vw_inv_2987;

statement ok
DROP TABLE #inv_delta_2987;

statement ok
DROP TABLE inv_main_2987;
