# test/slt_proc/dml_ddl_schema/2905_merge_check_view_temp_ddl_060.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (60)

statement ok
CREATE TABLE inv_main_2905 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 300 CHECK (qty >= 300)
);

statement ok
INSERT INTO inv_main_2905 (item_id, sku, qty) VALUES (1, 'SKU_A_60', 310), (2, 'SKU_B_60', 325);

statement error
INSERT INTO inv_main_2905 (item_id, sku, qty) VALUES (9, 'SKU_BAD_60', 299);

statement ok
INSERT INTO inv_main_2905 (item_id, sku) VALUES (3, 'SKU_DEF_60');

statement ok
CREATE TABLE #inv_delta_2905 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2905 VALUES (2, 'SKU_B_60', 5), (4, 'SKU_D_60', 340);

statement ok
MERGE inv_main_2905 AS t
USING #inv_delta_2905 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2905 AS
SELECT item_id, sku, qty FROM inv_main_2905 WHERE qty > 300;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2905 ORDER BY item_id;
----
1 SKU_A_60 310
2 SKU_B_60 330
4 SKU_D_60 340

statement ok
ALTER TABLE inv_main_2905 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_60';

query IT
SELECT item_id, wh_code FROM inv_main_2905 WHERE item_id = 3;
----
3 WH_60

statement ok
DROP VIEW vw_inv_2905;

statement ok
DROP TABLE #inv_delta_2905;

statement ok
DROP TABLE inv_main_2905;
