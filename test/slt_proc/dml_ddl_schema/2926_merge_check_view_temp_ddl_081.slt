# test/slt_proc/dml_ddl_schema/2926_merge_check_view_temp_ddl_081.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (81)

statement ok
CREATE TABLE inv_main_2926 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 405 CHECK (qty >= 405)
);

statement ok
INSERT INTO inv_main_2926 (item_id, sku, qty) VALUES (1, 'SKU_A_81', 415), (2, 'SKU_B_81', 430);

statement error
INSERT INTO inv_main_2926 (item_id, sku, qty) VALUES (9, 'SKU_BAD_81', 404);

statement ok
INSERT INTO inv_main_2926 (item_id, sku) VALUES (3, 'SKU_DEF_81');

statement ok
CREATE TABLE #inv_delta_2926 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2926 VALUES (2, 'SKU_B_81', 5), (4, 'SKU_D_81', 445);

statement ok
MERGE inv_main_2926 AS t
USING #inv_delta_2926 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2926 AS
SELECT item_id, sku, qty FROM inv_main_2926 WHERE qty > 405;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2926 ORDER BY item_id;
----
1 SKU_A_81 415
2 SKU_B_81 435
4 SKU_D_81 445

statement ok
ALTER TABLE inv_main_2926 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_81';

query IT
SELECT item_id, wh_code FROM inv_main_2926 WHERE item_id = 3;
----
3 WH_81

statement ok
DROP VIEW vw_inv_2926;

statement ok
DROP TABLE #inv_delta_2926;

statement ok
DROP TABLE inv_main_2926;
