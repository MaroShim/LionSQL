# test/slt_proc/dml_ddl_schema/2863_merge_check_view_temp_ddl_018.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (18)

statement ok
CREATE TABLE inv_main_2863 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 90 CHECK (qty >= 90)
);

statement ok
INSERT INTO inv_main_2863 (item_id, sku, qty) VALUES (1, 'SKU_A_18', 100), (2, 'SKU_B_18', 115);

statement error
INSERT INTO inv_main_2863 (item_id, sku, qty) VALUES (9, 'SKU_BAD_18', 89);

statement ok
INSERT INTO inv_main_2863 (item_id, sku) VALUES (3, 'SKU_DEF_18');

statement ok
CREATE TABLE #inv_delta_2863 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2863 VALUES (2, 'SKU_B_18', 5), (4, 'SKU_D_18', 130);

statement ok
MERGE inv_main_2863 AS t
USING #inv_delta_2863 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2863 AS
SELECT item_id, sku, qty FROM inv_main_2863 WHERE qty > 90;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2863 ORDER BY item_id;
----
1 SKU_A_18 100
2 SKU_B_18 120
4 SKU_D_18 130

statement ok
ALTER TABLE inv_main_2863 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_18';

query IT
SELECT item_id, wh_code FROM inv_main_2863 WHERE item_id = 3;
----
3 WH_18

statement ok
DROP VIEW vw_inv_2863;

statement ok
DROP TABLE #inv_delta_2863;

statement ok
DROP TABLE inv_main_2863;
