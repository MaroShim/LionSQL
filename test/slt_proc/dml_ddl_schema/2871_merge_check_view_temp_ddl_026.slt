# test/slt_proc/dml_ddl_schema/2871_merge_check_view_temp_ddl_026.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (26)

statement ok
CREATE TABLE inv_main_2871 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 130 CHECK (qty >= 130)
);

statement ok
INSERT INTO inv_main_2871 (item_id, sku, qty) VALUES (1, 'SKU_A_26', 140), (2, 'SKU_B_26', 155);

statement error
INSERT INTO inv_main_2871 (item_id, sku, qty) VALUES (9, 'SKU_BAD_26', 129);

statement ok
INSERT INTO inv_main_2871 (item_id, sku) VALUES (3, 'SKU_DEF_26');

statement ok
CREATE TABLE #inv_delta_2871 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2871 VALUES (2, 'SKU_B_26', 5), (4, 'SKU_D_26', 170);

statement ok
MERGE inv_main_2871 AS t
USING #inv_delta_2871 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2871 AS
SELECT item_id, sku, qty FROM inv_main_2871 WHERE qty > 130;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2871 ORDER BY item_id;
----
1 SKU_A_26 140
2 SKU_B_26 160
4 SKU_D_26 170

statement ok
ALTER TABLE inv_main_2871 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_26';

query IT
SELECT item_id, wh_code FROM inv_main_2871 WHERE item_id = 3;
----
3 WH_26

statement ok
DROP VIEW vw_inv_2871;

statement ok
DROP TABLE #inv_delta_2871;

statement ok
DROP TABLE inv_main_2871;
