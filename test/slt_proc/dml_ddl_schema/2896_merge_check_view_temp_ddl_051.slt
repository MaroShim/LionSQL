# test/slt_proc/dml_ddl_schema/2896_merge_check_view_temp_ddl_051.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (51)

statement ok
CREATE TABLE inv_main_2896 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 255 CHECK (qty >= 255)
);

statement ok
INSERT INTO inv_main_2896 (item_id, sku, qty) VALUES (1, 'SKU_A_51', 265), (2, 'SKU_B_51', 280);

statement error
INSERT INTO inv_main_2896 (item_id, sku, qty) VALUES (9, 'SKU_BAD_51', 254);

statement ok
INSERT INTO inv_main_2896 (item_id, sku) VALUES (3, 'SKU_DEF_51');

statement ok
CREATE TABLE #inv_delta_2896 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2896 VALUES (2, 'SKU_B_51', 5), (4, 'SKU_D_51', 295);

statement ok
MERGE inv_main_2896 AS t
USING #inv_delta_2896 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2896 AS
SELECT item_id, sku, qty FROM inv_main_2896 WHERE qty > 255;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2896 ORDER BY item_id;
----
1 SKU_A_51 265
2 SKU_B_51 285
4 SKU_D_51 295

statement ok
ALTER TABLE inv_main_2896 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_51';

query IT
SELECT item_id, wh_code FROM inv_main_2896 WHERE item_id = 3;
----
3 WH_51

statement ok
DROP VIEW vw_inv_2896;

statement ok
DROP TABLE #inv_delta_2896;

statement ok
DROP TABLE inv_main_2896;
