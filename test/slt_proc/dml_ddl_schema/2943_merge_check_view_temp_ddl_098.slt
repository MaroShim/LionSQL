# test/slt_proc/dml_ddl_schema/2943_merge_check_view_temp_ddl_098.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (98)

statement ok
CREATE TABLE inv_main_2943 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 490 CHECK (qty >= 490)
);

statement ok
INSERT INTO inv_main_2943 (item_id, sku, qty) VALUES (1, 'SKU_A_98', 500), (2, 'SKU_B_98', 515);

statement error
INSERT INTO inv_main_2943 (item_id, sku, qty) VALUES (9, 'SKU_BAD_98', 489);

statement ok
INSERT INTO inv_main_2943 (item_id, sku) VALUES (3, 'SKU_DEF_98');

statement ok
CREATE TABLE #inv_delta_2943 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2943 VALUES (2, 'SKU_B_98', 5), (4, 'SKU_D_98', 530);

statement ok
MERGE inv_main_2943 AS t
USING #inv_delta_2943 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2943 AS
SELECT item_id, sku, qty FROM inv_main_2943 WHERE qty > 490;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2943 ORDER BY item_id;
----
1 SKU_A_98 500
2 SKU_B_98 520
4 SKU_D_98 530

statement ok
ALTER TABLE inv_main_2943 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_98';

query IT
SELECT item_id, wh_code FROM inv_main_2943 WHERE item_id = 3;
----
3 WH_98

statement ok
DROP VIEW vw_inv_2943;

statement ok
DROP TABLE #inv_delta_2943;

statement ok
DROP TABLE inv_main_2943;
