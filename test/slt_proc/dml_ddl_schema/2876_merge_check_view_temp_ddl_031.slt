# test/slt_proc/dml_ddl_schema/2876_merge_check_view_temp_ddl_031.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (31)

statement ok
CREATE TABLE inv_main_2876 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 155 CHECK (qty >= 155)
);

statement ok
INSERT INTO inv_main_2876 (item_id, sku, qty) VALUES (1, 'SKU_A_31', 165), (2, 'SKU_B_31', 180);

statement error
INSERT INTO inv_main_2876 (item_id, sku, qty) VALUES (9, 'SKU_BAD_31', 154);

statement ok
INSERT INTO inv_main_2876 (item_id, sku) VALUES (3, 'SKU_DEF_31');

statement ok
CREATE TABLE #inv_delta_2876 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2876 VALUES (2, 'SKU_B_31', 5), (4, 'SKU_D_31', 195);

statement ok
MERGE inv_main_2876 AS t
USING #inv_delta_2876 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2876 AS
SELECT item_id, sku, qty FROM inv_main_2876 WHERE qty > 155;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2876 ORDER BY item_id;
----
1 SKU_A_31 165
2 SKU_B_31 185
4 SKU_D_31 195

statement ok
ALTER TABLE inv_main_2876 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_31';

query IT
SELECT item_id, wh_code FROM inv_main_2876 WHERE item_id = 3;
----
3 WH_31

statement ok
DROP VIEW vw_inv_2876;

statement ok
DROP TABLE #inv_delta_2876;

statement ok
DROP TABLE inv_main_2876;
