# test/slt_proc/dml_ddl_schema/2941_merge_check_view_temp_ddl_096.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (96)

statement ok
CREATE TABLE inv_main_2941 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 480 CHECK (qty >= 480)
);

statement ok
INSERT INTO inv_main_2941 (item_id, sku, qty) VALUES (1, 'SKU_A_96', 490), (2, 'SKU_B_96', 505);

statement error
INSERT INTO inv_main_2941 (item_id, sku, qty) VALUES (9, 'SKU_BAD_96', 479);

statement ok
INSERT INTO inv_main_2941 (item_id, sku) VALUES (3, 'SKU_DEF_96');

statement ok
CREATE TABLE #inv_delta_2941 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2941 VALUES (2, 'SKU_B_96', 5), (4, 'SKU_D_96', 520);

statement ok
MERGE inv_main_2941 AS t
USING #inv_delta_2941 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2941 AS
SELECT item_id, sku, qty FROM inv_main_2941 WHERE qty > 480;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2941 ORDER BY item_id;
----
1 SKU_A_96 490
2 SKU_B_96 510
4 SKU_D_96 520

statement ok
ALTER TABLE inv_main_2941 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_96';

query IT
SELECT item_id, wh_code FROM inv_main_2941 WHERE item_id = 3;
----
3 WH_96

statement ok
DROP VIEW vw_inv_2941;

statement ok
DROP TABLE #inv_delta_2941;

statement ok
DROP TABLE inv_main_2941;
