# test/slt_proc/dml_ddl_schema/2931_merge_check_view_temp_ddl_086.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (86)

statement ok
CREATE TABLE inv_main_2931 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 430 CHECK (qty >= 430)
);

statement ok
INSERT INTO inv_main_2931 (item_id, sku, qty) VALUES (1, 'SKU_A_86', 440), (2, 'SKU_B_86', 455);

statement error
INSERT INTO inv_main_2931 (item_id, sku, qty) VALUES (9, 'SKU_BAD_86', 429);

statement ok
INSERT INTO inv_main_2931 (item_id, sku) VALUES (3, 'SKU_DEF_86');

statement ok
CREATE TABLE #inv_delta_2931 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2931 VALUES (2, 'SKU_B_86', 5), (4, 'SKU_D_86', 470);

statement ok
MERGE inv_main_2931 AS t
USING #inv_delta_2931 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2931 AS
SELECT item_id, sku, qty FROM inv_main_2931 WHERE qty > 430;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2931 ORDER BY item_id;
----
1 SKU_A_86 440
2 SKU_B_86 460
4 SKU_D_86 470

statement ok
ALTER TABLE inv_main_2931 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_86';

query IT
SELECT item_id, wh_code FROM inv_main_2931 WHERE item_id = 3;
----
3 WH_86

statement ok
DROP VIEW vw_inv_2931;

statement ok
DROP TABLE #inv_delta_2931;

statement ok
DROP TABLE inv_main_2931;
