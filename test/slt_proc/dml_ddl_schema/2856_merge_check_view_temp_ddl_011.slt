# test/slt_proc/dml_ddl_schema/2856_merge_check_view_temp_ddl_011.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (11)

statement ok
CREATE TABLE inv_main_2856 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 55 CHECK (qty >= 55)
);

statement ok
INSERT INTO inv_main_2856 (item_id, sku, qty) VALUES (1, 'SKU_A_11', 65), (2, 'SKU_B_11', 80);

statement error
INSERT INTO inv_main_2856 (item_id, sku, qty) VALUES (9, 'SKU_BAD_11', 54);

statement ok
INSERT INTO inv_main_2856 (item_id, sku) VALUES (3, 'SKU_DEF_11');

statement ok
CREATE TABLE #inv_delta_2856 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2856 VALUES (2, 'SKU_B_11', 5), (4, 'SKU_D_11', 95);

statement ok
MERGE inv_main_2856 AS t
USING #inv_delta_2856 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2856 AS
SELECT item_id, sku, qty FROM inv_main_2856 WHERE qty > 55;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2856 ORDER BY item_id;
----
1 SKU_A_11 65
2 SKU_B_11 85
4 SKU_D_11 95

statement ok
ALTER TABLE inv_main_2856 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_11';

query IT
SELECT item_id, wh_code FROM inv_main_2856 WHERE item_id = 3;
----
3 WH_11

statement ok
DROP VIEW vw_inv_2856;

statement ok
DROP TABLE #inv_delta_2856;

statement ok
DROP TABLE inv_main_2856;
