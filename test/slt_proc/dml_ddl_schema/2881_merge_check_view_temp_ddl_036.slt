# test/slt_proc/dml_ddl_schema/2881_merge_check_view_temp_ddl_036.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (36)

statement ok
CREATE TABLE inv_main_2881 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 180 CHECK (qty >= 180)
);

statement ok
INSERT INTO inv_main_2881 (item_id, sku, qty) VALUES (1, 'SKU_A_36', 190), (2, 'SKU_B_36', 205);

statement error
INSERT INTO inv_main_2881 (item_id, sku, qty) VALUES (9, 'SKU_BAD_36', 179);

statement ok
INSERT INTO inv_main_2881 (item_id, sku) VALUES (3, 'SKU_DEF_36');

statement ok
CREATE TABLE #inv_delta_2881 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2881 VALUES (2, 'SKU_B_36', 5), (4, 'SKU_D_36', 220);

statement ok
MERGE inv_main_2881 AS t
USING #inv_delta_2881 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2881 AS
SELECT item_id, sku, qty FROM inv_main_2881 WHERE qty > 180;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2881 ORDER BY item_id;
----
1 SKU_A_36 190
2 SKU_B_36 210
4 SKU_D_36 220

statement ok
ALTER TABLE inv_main_2881 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_36';

query IT
SELECT item_id, wh_code FROM inv_main_2881 WHERE item_id = 3;
----
3 WH_36

statement ok
DROP VIEW vw_inv_2881;

statement ok
DROP TABLE #inv_delta_2881;

statement ok
DROP TABLE inv_main_2881;
