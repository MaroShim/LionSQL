# test/slt_proc/dml_ddl_schema/2869_merge_check_view_temp_ddl_024.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (24)

statement ok
CREATE TABLE inv_main_2869 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 120 CHECK (qty >= 120)
);

statement ok
INSERT INTO inv_main_2869 (item_id, sku, qty) VALUES (1, 'SKU_A_24', 130), (2, 'SKU_B_24', 145);

statement error
INSERT INTO inv_main_2869 (item_id, sku, qty) VALUES (9, 'SKU_BAD_24', 119);

statement ok
INSERT INTO inv_main_2869 (item_id, sku) VALUES (3, 'SKU_DEF_24');

statement ok
CREATE TABLE #inv_delta_2869 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2869 VALUES (2, 'SKU_B_24', 5), (4, 'SKU_D_24', 160);

statement ok
MERGE inv_main_2869 AS t
USING #inv_delta_2869 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2869 AS
SELECT item_id, sku, qty FROM inv_main_2869 WHERE qty > 120;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2869 ORDER BY item_id;
----
1 SKU_A_24 130
2 SKU_B_24 150
4 SKU_D_24 160

statement ok
ALTER TABLE inv_main_2869 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_24';

query IT
SELECT item_id, wh_code FROM inv_main_2869 WHERE item_id = 3;
----
3 WH_24

statement ok
DROP VIEW vw_inv_2869;

statement ok
DROP TABLE #inv_delta_2869;

statement ok
DROP TABLE inv_main_2869;
