# test/slt_proc/dml_ddl_schema/2898_merge_check_view_temp_ddl_053.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (53)

statement ok
CREATE TABLE inv_main_2898 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 265 CHECK (qty >= 265)
);

statement ok
INSERT INTO inv_main_2898 (item_id, sku, qty) VALUES (1, 'SKU_A_53', 275), (2, 'SKU_B_53', 290);

statement error
INSERT INTO inv_main_2898 (item_id, sku, qty) VALUES (9, 'SKU_BAD_53', 264);

statement ok
INSERT INTO inv_main_2898 (item_id, sku) VALUES (3, 'SKU_DEF_53');

statement ok
CREATE TABLE #inv_delta_2898 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2898 VALUES (2, 'SKU_B_53', 5), (4, 'SKU_D_53', 305);

statement ok
MERGE inv_main_2898 AS t
USING #inv_delta_2898 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2898 AS
SELECT item_id, sku, qty FROM inv_main_2898 WHERE qty > 265;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2898 ORDER BY item_id;
----
1 SKU_A_53 275
2 SKU_B_53 295
4 SKU_D_53 305

statement ok
ALTER TABLE inv_main_2898 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_53';

query IT
SELECT item_id, wh_code FROM inv_main_2898 WHERE item_id = 3;
----
3 WH_53

statement ok
DROP VIEW vw_inv_2898;

statement ok
DROP TABLE #inv_delta_2898;

statement ok
DROP TABLE inv_main_2898;
