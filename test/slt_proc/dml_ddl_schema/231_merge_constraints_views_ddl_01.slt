# test/slt_proc/dml_ddl_schema/231_merge_constraints_views_ddl_01.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (1)

statement ok
CREATE TABLE m_tgt_231 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 100 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_231 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_231 (sku, code, qty) VALUES (1, 'A_1', 5), (2, 'B_1', 10);

statement ok
INSERT INTO m_src_231 VALUES (2, 'B_1', 2), (3, 'C_1', 15);

statement error
INSERT INTO m_tgt_231 (sku, code, qty) VALUES (9, 'NEG_1', -5);

statement ok
MERGE m_tgt_231 AS t
USING m_src_231 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_231 ORDER BY sku;
----
1 A_1 5
2 B_1 12
3 C_1 15

query II
SELECT TOP 2 sku, qty FROM m_tgt_231 ORDER BY sku DESC;
----
3 15
2 12

statement ok
ALTER TABLE m_tgt_231 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_231 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_231;

statement ok
DROP TABLE m_tgt_231;
