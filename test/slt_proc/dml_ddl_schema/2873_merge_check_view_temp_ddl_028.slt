# test/slt_proc/dml_ddl_schema/2873_merge_check_view_temp_ddl_028.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (28)

statement ok
CREATE TABLE inv_main_2873 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 140 CHECK (qty >= 140)
);

statement ok
INSERT INTO inv_main_2873 (item_id, sku, qty) VALUES (1, 'SKU_A_28', 150), (2, 'SKU_B_28', 165);

statement error
INSERT INTO inv_main_2873 (item_id, sku, qty) VALUES (9, 'SKU_BAD_28', 139);

statement ok
INSERT INTO inv_main_2873 (item_id, sku) VALUES (3, 'SKU_DEF_28');

statement ok
CREATE TABLE #inv_delta_2873 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2873 VALUES (2, 'SKU_B_28', 5), (4, 'SKU_D_28', 180);

statement ok
MERGE inv_main_2873 AS t
USING #inv_delta_2873 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2873 AS
SELECT item_id, sku, qty FROM inv_main_2873 WHERE qty > 140;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2873 ORDER BY item_id;
----
1 SKU_A_28 150
2 SKU_B_28 170
4 SKU_D_28 180

statement ok
ALTER TABLE inv_main_2873 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_28';

query IT
SELECT item_id, wh_code FROM inv_main_2873 WHERE item_id = 3;
----
3 WH_28

statement ok
DROP VIEW vw_inv_2873;

statement ok
DROP TABLE #inv_delta_2873;

statement ok
DROP TABLE inv_main_2873;
