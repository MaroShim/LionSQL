# test/slt_proc/dml_ddl_schema/2960_merge_check_view_temp_ddl_115.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (115)

statement ok
CREATE TABLE inv_main_2960 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 575 CHECK (qty >= 575)
);

statement ok
INSERT INTO inv_main_2960 (item_id, sku, qty) VALUES (1, 'SKU_A_115', 585), (2, 'SKU_B_115', 600);

statement error
INSERT INTO inv_main_2960 (item_id, sku, qty) VALUES (9, 'SKU_BAD_115', 574);

statement ok
INSERT INTO inv_main_2960 (item_id, sku) VALUES (3, 'SKU_DEF_115');

statement ok
CREATE TABLE #inv_delta_2960 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2960 VALUES (2, 'SKU_B_115', 5), (4, 'SKU_D_115', 615);

statement ok
MERGE inv_main_2960 AS t
USING #inv_delta_2960 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2960 AS
SELECT item_id, sku, qty FROM inv_main_2960 WHERE qty > 575;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2960 ORDER BY item_id;
----
1 SKU_A_115 585
2 SKU_B_115 605
4 SKU_D_115 615

statement ok
ALTER TABLE inv_main_2960 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_115';

query IT
SELECT item_id, wh_code FROM inv_main_2960 WHERE item_id = 3;
----
3 WH_115

statement ok
DROP VIEW vw_inv_2960;

statement ok
DROP TABLE #inv_delta_2960;

statement ok
DROP TABLE inv_main_2960;
