# test/slt_proc/dml_ddl_schema/248_merge_constraints_views_ddl_18.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (18)

statement ok
CREATE TABLE m_tgt_248 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1800 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_248 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_248 (sku, code, qty) VALUES (1, 'A_18', 90), (2, 'B_18', 180);

statement ok
INSERT INTO m_src_248 VALUES (2, 'B_18', 36), (3, 'C_18', 270);

statement error
INSERT INTO m_tgt_248 (sku, code, qty) VALUES (9, 'NEG_18', -5);

statement ok
MERGE m_tgt_248 AS t
USING m_src_248 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_248 ORDER BY sku;
----
1 A_18 90
2 B_18 216
3 C_18 270

query II
SELECT TOP 2 sku, qty FROM m_tgt_248 ORDER BY sku DESC;
----
3 270
2 216

statement ok
ALTER TABLE m_tgt_248 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_248 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_248;

statement ok
DROP TABLE m_tgt_248;
