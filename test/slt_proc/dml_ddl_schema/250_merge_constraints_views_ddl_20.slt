# test/slt_proc/dml_ddl_schema/250_merge_constraints_views_ddl_20.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (20)

statement ok
CREATE TABLE m_tgt_250 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 2000 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_250 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_250 (sku, code, qty) VALUES (1, 'A_20', 100), (2, 'B_20', 200);

statement ok
INSERT INTO m_src_250 VALUES (2, 'B_20', 40), (3, 'C_20', 300);

statement error
INSERT INTO m_tgt_250 (sku, code, qty) VALUES (9, 'NEG_20', -5);

statement ok
MERGE m_tgt_250 AS t
USING m_src_250 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_250 ORDER BY sku;
----
1 A_20 100
2 B_20 240
3 C_20 300

query II
SELECT TOP 2 sku, qty FROM m_tgt_250 ORDER BY sku DESC;
----
3 300
2 240

statement ok
ALTER TABLE m_tgt_250 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_250 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_250;

statement ok
DROP TABLE m_tgt_250;
