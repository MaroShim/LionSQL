# test/slt_proc/dml_ddl_schema/2846_merge_check_view_temp_ddl_001.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (1)

statement ok
CREATE TABLE inv_main_2846 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 5 CHECK (qty >= 5)
);

statement ok
INSERT INTO inv_main_2846 (item_id, sku, qty) VALUES (1, 'SKU_A_1', 15), (2, 'SKU_B_1', 30);

statement error
INSERT INTO inv_main_2846 (item_id, sku, qty) VALUES (9, 'SKU_BAD_1', 4);

statement ok
INSERT INTO inv_main_2846 (item_id, sku) VALUES (3, 'SKU_DEF_1');

statement ok
CREATE TABLE #inv_delta_2846 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2846 VALUES (2, 'SKU_B_1', 5), (4, 'SKU_D_1', 45);

statement ok
MERGE inv_main_2846 AS t
USING #inv_delta_2846 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2846 AS
SELECT item_id, sku, qty FROM inv_main_2846 WHERE qty > 5;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2846 ORDER BY item_id;
----
1 SKU_A_1 15
2 SKU_B_1 35
4 SKU_D_1 45

statement ok
ALTER TABLE inv_main_2846 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_1';

query IT
SELECT item_id, wh_code FROM inv_main_2846 WHERE item_id = 3;
----
3 WH_1

statement ok
DROP VIEW vw_inv_2846;

statement ok
DROP TABLE #inv_delta_2846;

statement ok
DROP TABLE inv_main_2846;
