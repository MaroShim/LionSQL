# test/slt_proc/dml_ddl_schema/239_merge_constraints_views_ddl_09.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (9)

statement ok
CREATE TABLE m_tgt_239 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 900 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_239 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_239 (sku, code, qty) VALUES (1, 'A_9', 45), (2, 'B_9', 90);

statement ok
INSERT INTO m_src_239 VALUES (2, 'B_9', 18), (3, 'C_9', 135);

statement error
INSERT INTO m_tgt_239 (sku, code, qty) VALUES (9, 'NEG_9', -5);

statement ok
MERGE m_tgt_239 AS t
USING m_src_239 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_239 ORDER BY sku;
----
1 A_9 45
2 B_9 108
3 C_9 135

query II
SELECT TOP 2 sku, qty FROM m_tgt_239 ORDER BY sku DESC;
----
3 135
2 108

statement ok
ALTER TABLE m_tgt_239 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_239 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_239;

statement ok
DROP TABLE m_tgt_239;
