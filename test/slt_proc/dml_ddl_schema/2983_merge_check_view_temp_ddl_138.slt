# test/slt_proc/dml_ddl_schema/2983_merge_check_view_temp_ddl_138.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (138)

statement ok
CREATE TABLE inv_main_2983 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 690 CHECK (qty >= 690)
);

statement ok
INSERT INTO inv_main_2983 (item_id, sku, qty) VALUES (1, 'SKU_A_138', 700), (2, 'SKU_B_138', 715);

statement error
INSERT INTO inv_main_2983 (item_id, sku, qty) VALUES (9, 'SKU_BAD_138', 689);

statement ok
INSERT INTO inv_main_2983 (item_id, sku) VALUES (3, 'SKU_DEF_138');

statement ok
CREATE TABLE #inv_delta_2983 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2983 VALUES (2, 'SKU_B_138', 5), (4, 'SKU_D_138', 730);

statement ok
MERGE inv_main_2983 AS t
USING #inv_delta_2983 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2983 AS
SELECT item_id, sku, qty FROM inv_main_2983 WHERE qty > 690;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2983 ORDER BY item_id;
----
1 SKU_A_138 700
2 SKU_B_138 720
4 SKU_D_138 730

statement ok
ALTER TABLE inv_main_2983 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_138';

query IT
SELECT item_id, wh_code FROM inv_main_2983 WHERE item_id = 3;
----
3 WH_138

statement ok
DROP VIEW vw_inv_2983;

statement ok
DROP TABLE #inv_delta_2983;

statement ok
DROP TABLE inv_main_2983;
