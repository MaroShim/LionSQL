# test/slt_proc/dml_ddl_schema/3000_merge_check_view_temp_ddl_155.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (155)

statement ok
CREATE TABLE inv_main_3000 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 775 CHECK (qty >= 775)
);

statement ok
INSERT INTO inv_main_3000 (item_id, sku, qty) VALUES (1, 'SKU_A_155', 785), (2, 'SKU_B_155', 800);

statement error
INSERT INTO inv_main_3000 (item_id, sku, qty) VALUES (9, 'SKU_BAD_155', 774);

statement ok
INSERT INTO inv_main_3000 (item_id, sku) VALUES (3, 'SKU_DEF_155');

statement ok
CREATE TABLE #inv_delta_3000 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_3000 VALUES (2, 'SKU_B_155', 5), (4, 'SKU_D_155', 815);

statement ok
MERGE inv_main_3000 AS t
USING #inv_delta_3000 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_3000 AS
SELECT item_id, sku, qty FROM inv_main_3000 WHERE qty > 775;

query ITI
SELECT item_id, sku, qty FROM vw_inv_3000 ORDER BY item_id;
----
1 SKU_A_155 785
2 SKU_B_155 805
4 SKU_D_155 815

statement ok
ALTER TABLE inv_main_3000 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_155';

query IT
SELECT item_id, wh_code FROM inv_main_3000 WHERE item_id = 3;
----
3 WH_155

statement ok
DROP VIEW vw_inv_3000;

statement ok
DROP TABLE #inv_delta_3000;

statement ok
DROP TABLE inv_main_3000;
