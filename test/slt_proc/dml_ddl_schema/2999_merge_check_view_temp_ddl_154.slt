# test/slt_proc/dml_ddl_schema/2999_merge_check_view_temp_ddl_154.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (154)

statement ok
CREATE TABLE inv_main_2999 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 770 CHECK (qty >= 770)
);

statement ok
INSERT INTO inv_main_2999 (item_id, sku, qty) VALUES (1, 'SKU_A_154', 780), (2, 'SKU_B_154', 795);

statement error
INSERT INTO inv_main_2999 (item_id, sku, qty) VALUES (9, 'SKU_BAD_154', 769);

statement ok
INSERT INTO inv_main_2999 (item_id, sku) VALUES (3, 'SKU_DEF_154');

statement ok
CREATE TABLE #inv_delta_2999 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2999 VALUES (2, 'SKU_B_154', 5), (4, 'SKU_D_154', 810);

statement ok
MERGE inv_main_2999 AS t
USING #inv_delta_2999 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2999 AS
SELECT item_id, sku, qty FROM inv_main_2999 WHERE qty > 770;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2999 ORDER BY item_id;
----
1 SKU_A_154 780
2 SKU_B_154 800
4 SKU_D_154 810

statement ok
ALTER TABLE inv_main_2999 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_154';

query IT
SELECT item_id, wh_code FROM inv_main_2999 WHERE item_id = 3;
----
3 WH_154

statement ok
DROP VIEW vw_inv_2999;

statement ok
DROP TABLE #inv_delta_2999;

statement ok
DROP TABLE inv_main_2999;
