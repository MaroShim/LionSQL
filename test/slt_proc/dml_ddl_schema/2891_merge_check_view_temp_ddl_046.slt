# test/slt_proc/dml_ddl_schema/2891_merge_check_view_temp_ddl_046.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (46)

statement ok
CREATE TABLE inv_main_2891 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 230 CHECK (qty >= 230)
);

statement ok
INSERT INTO inv_main_2891 (item_id, sku, qty) VALUES (1, 'SKU_A_46', 240), (2, 'SKU_B_46', 255);

statement error
INSERT INTO inv_main_2891 (item_id, sku, qty) VALUES (9, 'SKU_BAD_46', 229);

statement ok
INSERT INTO inv_main_2891 (item_id, sku) VALUES (3, 'SKU_DEF_46');

statement ok
CREATE TABLE #inv_delta_2891 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2891 VALUES (2, 'SKU_B_46', 5), (4, 'SKU_D_46', 270);

statement ok
MERGE inv_main_2891 AS t
USING #inv_delta_2891 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2891 AS
SELECT item_id, sku, qty FROM inv_main_2891 WHERE qty > 230;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2891 ORDER BY item_id;
----
1 SKU_A_46 240
2 SKU_B_46 260
4 SKU_D_46 270

statement ok
ALTER TABLE inv_main_2891 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_46';

query IT
SELECT item_id, wh_code FROM inv_main_2891 WHERE item_id = 3;
----
3 WH_46

statement ok
DROP VIEW vw_inv_2891;

statement ok
DROP TABLE #inv_delta_2891;

statement ok
DROP TABLE inv_main_2891;
