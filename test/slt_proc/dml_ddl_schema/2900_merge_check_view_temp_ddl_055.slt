# test/slt_proc/dml_ddl_schema/2900_merge_check_view_temp_ddl_055.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (55)

statement ok
CREATE TABLE inv_main_2900 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 275 CHECK (qty >= 275)
);

statement ok
INSERT INTO inv_main_2900 (item_id, sku, qty) VALUES (1, 'SKU_A_55', 285), (2, 'SKU_B_55', 300);

statement error
INSERT INTO inv_main_2900 (item_id, sku, qty) VALUES (9, 'SKU_BAD_55', 274);

statement ok
INSERT INTO inv_main_2900 (item_id, sku) VALUES (3, 'SKU_DEF_55');

statement ok
CREATE TABLE #inv_delta_2900 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2900 VALUES (2, 'SKU_B_55', 5), (4, 'SKU_D_55', 315);

statement ok
MERGE inv_main_2900 AS t
USING #inv_delta_2900 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2900 AS
SELECT item_id, sku, qty FROM inv_main_2900 WHERE qty > 275;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2900 ORDER BY item_id;
----
1 SKU_A_55 285
2 SKU_B_55 305
4 SKU_D_55 315

statement ok
ALTER TABLE inv_main_2900 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_55';

query IT
SELECT item_id, wh_code FROM inv_main_2900 WHERE item_id = 3;
----
3 WH_55

statement ok
DROP VIEW vw_inv_2900;

statement ok
DROP TABLE #inv_delta_2900;

statement ok
DROP TABLE inv_main_2900;
