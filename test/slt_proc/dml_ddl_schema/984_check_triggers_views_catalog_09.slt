# test/slt_proc/dml_ddl_schema/984_check_triggers_views_catalog_09.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (9)

statement ok
CREATE TABLE acct_984 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 90 CHECK (balance >= 90)
);

statement ok
CREATE VIEW vw_acct_high_984 AS
SELECT id, owner, balance FROM acct_984 WHERE balance > 90;

statement ok
INSERT INTO acct_984 (id, owner, balance) VALUES (1, 'UserA_9', 140), (2, 'UserB_9', 210);

statement error
INSERT INTO acct_984 (id, owner, balance) VALUES (3, 'BadUser_9', 85);

statement error
UPDATE acct_984 SET balance = 85 WHERE id = 1;

statement ok
INSERT INTO acct_984 (id, owner) VALUES (4, 'DefaultUser_9');

query ITI
SELECT id, owner, balance FROM acct_984 ORDER BY id;
----
1 UserA_9 140
2 UserB_9 210
4 DefaultUser_9 90

query II
SELECT id, balance FROM vw_acct_high_984 ORDER BY id;
----
1 140
2 210

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_984';
----
vw_acct_high_984

statement ok
DROP VIEW vw_acct_high_984;

statement ok
DROP TABLE acct_984;
