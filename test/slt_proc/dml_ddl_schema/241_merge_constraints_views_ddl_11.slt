# test/slt_proc/dml_ddl_schema/241_merge_constraints_views_ddl_11.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (11)

statement ok
CREATE TABLE m_tgt_241 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1100 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_241 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_241 (sku, code, qty) VALUES (1, 'A_11', 55), (2, 'B_11', 110);

statement ok
INSERT INTO m_src_241 VALUES (2, 'B_11', 22), (3, 'C_11', 165);

statement error
INSERT INTO m_tgt_241 (sku, code, qty) VALUES (9, 'NEG_11', -5);

statement ok
MERGE m_tgt_241 AS t
USING m_src_241 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_241 ORDER BY sku;
----
1 A_11 55
2 B_11 132
3 C_11 165

query II
SELECT TOP 2 sku, qty FROM m_tgt_241 ORDER BY sku DESC;
----
3 165
2 132

statement ok
ALTER TABLE m_tgt_241 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_241 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_241;

statement ok
DROP TABLE m_tgt_241;
