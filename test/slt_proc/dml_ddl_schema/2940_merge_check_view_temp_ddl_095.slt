# test/slt_proc/dml_ddl_schema/2940_merge_check_view_temp_ddl_095.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (95)

statement ok
CREATE TABLE inv_main_2940 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 475 CHECK (qty >= 475)
);

statement ok
INSERT INTO inv_main_2940 (item_id, sku, qty) VALUES (1, 'SKU_A_95', 485), (2, 'SKU_B_95', 500);

statement error
INSERT INTO inv_main_2940 (item_id, sku, qty) VALUES (9, 'SKU_BAD_95', 474);

statement ok
INSERT INTO inv_main_2940 (item_id, sku) VALUES (3, 'SKU_DEF_95');

statement ok
CREATE TABLE #inv_delta_2940 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2940 VALUES (2, 'SKU_B_95', 5), (4, 'SKU_D_95', 515);

statement ok
MERGE inv_main_2940 AS t
USING #inv_delta_2940 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2940 AS
SELECT item_id, sku, qty FROM inv_main_2940 WHERE qty > 475;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2940 ORDER BY item_id;
----
1 SKU_A_95 485
2 SKU_B_95 505
4 SKU_D_95 515

statement ok
ALTER TABLE inv_main_2940 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_95';

query IT
SELECT item_id, wh_code FROM inv_main_2940 WHERE item_id = 3;
----
3 WH_95

statement ok
DROP VIEW vw_inv_2940;

statement ok
DROP TABLE #inv_delta_2940;

statement ok
DROP TABLE inv_main_2940;
