# test/slt_proc/dml_ddl_schema/2919_merge_check_view_temp_ddl_074.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (74)

statement ok
CREATE TABLE inv_main_2919 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 370 CHECK (qty >= 370)
);

statement ok
INSERT INTO inv_main_2919 (item_id, sku, qty) VALUES (1, 'SKU_A_74', 380), (2, 'SKU_B_74', 395);

statement error
INSERT INTO inv_main_2919 (item_id, sku, qty) VALUES (9, 'SKU_BAD_74', 369);

statement ok
INSERT INTO inv_main_2919 (item_id, sku) VALUES (3, 'SKU_DEF_74');

statement ok
CREATE TABLE #inv_delta_2919 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2919 VALUES (2, 'SKU_B_74', 5), (4, 'SKU_D_74', 410);

statement ok
MERGE inv_main_2919 AS t
USING #inv_delta_2919 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2919 AS
SELECT item_id, sku, qty FROM inv_main_2919 WHERE qty > 370;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2919 ORDER BY item_id;
----
1 SKU_A_74 380
2 SKU_B_74 400
4 SKU_D_74 410

statement ok
ALTER TABLE inv_main_2919 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_74';

query IT
SELECT item_id, wh_code FROM inv_main_2919 WHERE item_id = 3;
----
3 WH_74

statement ok
DROP VIEW vw_inv_2919;

statement ok
DROP TABLE #inv_delta_2919;

statement ok
DROP TABLE inv_main_2919;
