# test/slt_proc/dml_ddl_schema/2986_merge_check_view_temp_ddl_141.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (141)

statement ok
CREATE TABLE inv_main_2986 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 705 CHECK (qty >= 705)
);

statement ok
INSERT INTO inv_main_2986 (item_id, sku, qty) VALUES (1, 'SKU_A_141', 715), (2, 'SKU_B_141', 730);

statement error
INSERT INTO inv_main_2986 (item_id, sku, qty) VALUES (9, 'SKU_BAD_141', 704);

statement ok
INSERT INTO inv_main_2986 (item_id, sku) VALUES (3, 'SKU_DEF_141');

statement ok
CREATE TABLE #inv_delta_2986 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2986 VALUES (2, 'SKU_B_141', 5), (4, 'SKU_D_141', 745);

statement ok
MERGE inv_main_2986 AS t
USING #inv_delta_2986 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2986 AS
SELECT item_id, sku, qty FROM inv_main_2986 WHERE qty > 705;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2986 ORDER BY item_id;
----
1 SKU_A_141 715
2 SKU_B_141 735
4 SKU_D_141 745

statement ok
ALTER TABLE inv_main_2986 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_141';

query IT
SELECT item_id, wh_code FROM inv_main_2986 WHERE item_id = 3;
----
3 WH_141

statement ok
DROP VIEW vw_inv_2986;

statement ok
DROP TABLE #inv_delta_2986;

statement ok
DROP TABLE inv_main_2986;
