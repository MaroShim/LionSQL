# test/slt_proc/dml_ddl_schema/2993_merge_check_view_temp_ddl_148.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (148)

statement ok
CREATE TABLE inv_main_2993 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 740 CHECK (qty >= 740)
);

statement ok
INSERT INTO inv_main_2993 (item_id, sku, qty) VALUES (1, 'SKU_A_148', 750), (2, 'SKU_B_148', 765);

statement error
INSERT INTO inv_main_2993 (item_id, sku, qty) VALUES (9, 'SKU_BAD_148', 739);

statement ok
INSERT INTO inv_main_2993 (item_id, sku) VALUES (3, 'SKU_DEF_148');

statement ok
CREATE TABLE #inv_delta_2993 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2993 VALUES (2, 'SKU_B_148', 5), (4, 'SKU_D_148', 780);

statement ok
MERGE inv_main_2993 AS t
USING #inv_delta_2993 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2993 AS
SELECT item_id, sku, qty FROM inv_main_2993 WHERE qty > 740;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2993 ORDER BY item_id;
----
1 SKU_A_148 750
2 SKU_B_148 770
4 SKU_D_148 780

statement ok
ALTER TABLE inv_main_2993 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_148';

query IT
SELECT item_id, wh_code FROM inv_main_2993 WHERE item_id = 3;
----
3 WH_148

statement ok
DROP VIEW vw_inv_2993;

statement ok
DROP TABLE #inv_delta_2993;

statement ok
DROP TABLE inv_main_2993;
