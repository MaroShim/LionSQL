# test/slt_proc/dml_ddl_schema/996_check_triggers_views_catalog_21.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (21)

statement ok
CREATE TABLE acct_996 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 210 CHECK (balance >= 210)
);

statement ok
CREATE VIEW vw_acct_high_996 AS
SELECT id, owner, balance FROM acct_996 WHERE balance > 210;

statement ok
INSERT INTO acct_996 (id, owner, balance) VALUES (1, 'UserA_21', 260), (2, 'UserB_21', 330);

statement error
INSERT INTO acct_996 (id, owner, balance) VALUES (3, 'BadUser_21', 205);

statement error
UPDATE acct_996 SET balance = 205 WHERE id = 1;

statement ok
INSERT INTO acct_996 (id, owner) VALUES (4, 'DefaultUser_21');

query ITI
SELECT id, owner, balance FROM acct_996 ORDER BY id;
----
1 UserA_21 260
2 UserB_21 330
4 DefaultUser_21 210

query II
SELECT id, balance FROM vw_acct_high_996 ORDER BY id;
----
1 260
2 330

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_996';
----
vw_acct_high_996

statement ok
DROP VIEW vw_acct_high_996;

statement ok
DROP TABLE acct_996;
