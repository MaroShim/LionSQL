# test/slt_proc/dml_ddl_schema/2914_merge_check_view_temp_ddl_069.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (69)

statement ok
CREATE TABLE inv_main_2914 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 345 CHECK (qty >= 345)
);

statement ok
INSERT INTO inv_main_2914 (item_id, sku, qty) VALUES (1, 'SKU_A_69', 355), (2, 'SKU_B_69', 370);

statement error
INSERT INTO inv_main_2914 (item_id, sku, qty) VALUES (9, 'SKU_BAD_69', 344);

statement ok
INSERT INTO inv_main_2914 (item_id, sku) VALUES (3, 'SKU_DEF_69');

statement ok
CREATE TABLE #inv_delta_2914 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2914 VALUES (2, 'SKU_B_69', 5), (4, 'SKU_D_69', 385);

statement ok
MERGE inv_main_2914 AS t
USING #inv_delta_2914 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2914 AS
SELECT item_id, sku, qty FROM inv_main_2914 WHERE qty > 345;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2914 ORDER BY item_id;
----
1 SKU_A_69 355
2 SKU_B_69 375
4 SKU_D_69 385

statement ok
ALTER TABLE inv_main_2914 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_69';

query IT
SELECT item_id, wh_code FROM inv_main_2914 WHERE item_id = 3;
----
3 WH_69

statement ok
DROP VIEW vw_inv_2914;

statement ok
DROP TABLE #inv_delta_2914;

statement ok
DROP TABLE inv_main_2914;
