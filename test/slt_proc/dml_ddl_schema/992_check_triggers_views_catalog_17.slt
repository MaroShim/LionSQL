# test/slt_proc/dml_ddl_schema/992_check_triggers_views_catalog_17.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (17)

statement ok
CREATE TABLE acct_992 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 170 CHECK (balance >= 170)
);

statement ok
CREATE VIEW vw_acct_high_992 AS
SELECT id, owner, balance FROM acct_992 WHERE balance > 170;

statement ok
INSERT INTO acct_992 (id, owner, balance) VALUES (1, 'UserA_17', 220), (2, 'UserB_17', 290);

statement error
INSERT INTO acct_992 (id, owner, balance) VALUES (3, 'BadUser_17', 165);

statement error
UPDATE acct_992 SET balance = 165 WHERE id = 1;

statement ok
INSERT INTO acct_992 (id, owner) VALUES (4, 'DefaultUser_17');

query ITI
SELECT id, owner, balance FROM acct_992 ORDER BY id;
----
1 UserA_17 220
2 UserB_17 290
4 DefaultUser_17 170

query II
SELECT id, balance FROM vw_acct_high_992 ORDER BY id;
----
1 220
2 290

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_992';
----
vw_acct_high_992

statement ok
DROP VIEW vw_acct_high_992;

statement ok
DROP TABLE acct_992;
