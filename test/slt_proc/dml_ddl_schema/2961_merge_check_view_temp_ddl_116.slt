# test/slt_proc/dml_ddl_schema/2961_merge_check_view_temp_ddl_116.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (116)

statement ok
CREATE TABLE inv_main_2961 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 580 CHECK (qty >= 580)
);

statement ok
INSERT INTO inv_main_2961 (item_id, sku, qty) VALUES (1, 'SKU_A_116', 590), (2, 'SKU_B_116', 605);

statement error
INSERT INTO inv_main_2961 (item_id, sku, qty) VALUES (9, 'SKU_BAD_116', 579);

statement ok
INSERT INTO inv_main_2961 (item_id, sku) VALUES (3, 'SKU_DEF_116');

statement ok
CREATE TABLE #inv_delta_2961 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2961 VALUES (2, 'SKU_B_116', 5), (4, 'SKU_D_116', 620);

statement ok
MERGE inv_main_2961 AS t
USING #inv_delta_2961 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2961 AS
SELECT item_id, sku, qty FROM inv_main_2961 WHERE qty > 580;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2961 ORDER BY item_id;
----
1 SKU_A_116 590
2 SKU_B_116 610
4 SKU_D_116 620

statement ok
ALTER TABLE inv_main_2961 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_116';

query IT
SELECT item_id, wh_code FROM inv_main_2961 WHERE item_id = 3;
----
3 WH_116

statement ok
DROP VIEW vw_inv_2961;

statement ok
DROP TABLE #inv_delta_2961;

statement ok
DROP TABLE inv_main_2961;
