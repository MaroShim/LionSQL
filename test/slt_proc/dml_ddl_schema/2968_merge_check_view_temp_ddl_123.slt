# test/slt_proc/dml_ddl_schema/2968_merge_check_view_temp_ddl_123.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (123)

statement ok
CREATE TABLE inv_main_2968 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 615 CHECK (qty >= 615)
);

statement ok
INSERT INTO inv_main_2968 (item_id, sku, qty) VALUES (1, 'SKU_A_123', 625), (2, 'SKU_B_123', 640);

statement error
INSERT INTO inv_main_2968 (item_id, sku, qty) VALUES (9, 'SKU_BAD_123', 614);

statement ok
INSERT INTO inv_main_2968 (item_id, sku) VALUES (3, 'SKU_DEF_123');

statement ok
CREATE TABLE #inv_delta_2968 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2968 VALUES (2, 'SKU_B_123', 5), (4, 'SKU_D_123', 655);

statement ok
MERGE inv_main_2968 AS t
USING #inv_delta_2968 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2968 AS
SELECT item_id, sku, qty FROM inv_main_2968 WHERE qty > 615;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2968 ORDER BY item_id;
----
1 SKU_A_123 625
2 SKU_B_123 645
4 SKU_D_123 655

statement ok
ALTER TABLE inv_main_2968 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_123';

query IT
SELECT item_id, wh_code FROM inv_main_2968 WHERE item_id = 3;
----
3 WH_123

statement ok
DROP VIEW vw_inv_2968;

statement ok
DROP TABLE #inv_delta_2968;

statement ok
DROP TABLE inv_main_2968;
