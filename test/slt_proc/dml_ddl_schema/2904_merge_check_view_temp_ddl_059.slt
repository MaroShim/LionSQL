# test/slt_proc/dml_ddl_schema/2904_merge_check_view_temp_ddl_059.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (59)

statement ok
CREATE TABLE inv_main_2904 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 295 CHECK (qty >= 295)
);

statement ok
INSERT INTO inv_main_2904 (item_id, sku, qty) VALUES (1, 'SKU_A_59', 305), (2, 'SKU_B_59', 320);

statement error
INSERT INTO inv_main_2904 (item_id, sku, qty) VALUES (9, 'SKU_BAD_59', 294);

statement ok
INSERT INTO inv_main_2904 (item_id, sku) VALUES (3, 'SKU_DEF_59');

statement ok
CREATE TABLE #inv_delta_2904 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2904 VALUES (2, 'SKU_B_59', 5), (4, 'SKU_D_59', 335);

statement ok
MERGE inv_main_2904 AS t
USING #inv_delta_2904 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2904 AS
SELECT item_id, sku, qty FROM inv_main_2904 WHERE qty > 295;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2904 ORDER BY item_id;
----
1 SKU_A_59 305
2 SKU_B_59 325
4 SKU_D_59 335

statement ok
ALTER TABLE inv_main_2904 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_59';

query IT
SELECT item_id, wh_code FROM inv_main_2904 WHERE item_id = 3;
----
3 WH_59

statement ok
DROP VIEW vw_inv_2904;

statement ok
DROP TABLE #inv_delta_2904;

statement ok
DROP TABLE inv_main_2904;
