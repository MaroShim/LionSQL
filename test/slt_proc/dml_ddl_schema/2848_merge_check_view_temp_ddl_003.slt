# test/slt_proc/dml_ddl_schema/2848_merge_check_view_temp_ddl_003.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (3)

statement ok
CREATE TABLE inv_main_2848 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 15 CHECK (qty >= 15)
);

statement ok
INSERT INTO inv_main_2848 (item_id, sku, qty) VALUES (1, 'SKU_A_3', 25), (2, 'SKU_B_3', 40);

statement error
INSERT INTO inv_main_2848 (item_id, sku, qty) VALUES (9, 'SKU_BAD_3', 14);

statement ok
INSERT INTO inv_main_2848 (item_id, sku) VALUES (3, 'SKU_DEF_3');

statement ok
CREATE TABLE #inv_delta_2848 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2848 VALUES (2, 'SKU_B_3', 5), (4, 'SKU_D_3', 55);

statement ok
MERGE inv_main_2848 AS t
USING #inv_delta_2848 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2848 AS
SELECT item_id, sku, qty FROM inv_main_2848 WHERE qty > 15;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2848 ORDER BY item_id;
----
1 SKU_A_3 25
2 SKU_B_3 45
4 SKU_D_3 55

statement ok
ALTER TABLE inv_main_2848 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_3';

query IT
SELECT item_id, wh_code FROM inv_main_2848 WHERE item_id = 3;
----
3 WH_3

statement ok
DROP VIEW vw_inv_2848;

statement ok
DROP TABLE #inv_delta_2848;

statement ok
DROP TABLE inv_main_2848;
