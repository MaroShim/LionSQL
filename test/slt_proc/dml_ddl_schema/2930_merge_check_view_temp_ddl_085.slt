# test/slt_proc/dml_ddl_schema/2930_merge_check_view_temp_ddl_085.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (85)

statement ok
CREATE TABLE inv_main_2930 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 425 CHECK (qty >= 425)
);

statement ok
INSERT INTO inv_main_2930 (item_id, sku, qty) VALUES (1, 'SKU_A_85', 435), (2, 'SKU_B_85', 450);

statement error
INSERT INTO inv_main_2930 (item_id, sku, qty) VALUES (9, 'SKU_BAD_85', 424);

statement ok
INSERT INTO inv_main_2930 (item_id, sku) VALUES (3, 'SKU_DEF_85');

statement ok
CREATE TABLE #inv_delta_2930 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2930 VALUES (2, 'SKU_B_85', 5), (4, 'SKU_D_85', 465);

statement ok
MERGE inv_main_2930 AS t
USING #inv_delta_2930 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2930 AS
SELECT item_id, sku, qty FROM inv_main_2930 WHERE qty > 425;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2930 ORDER BY item_id;
----
1 SKU_A_85 435
2 SKU_B_85 455
4 SKU_D_85 465

statement ok
ALTER TABLE inv_main_2930 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_85';

query IT
SELECT item_id, wh_code FROM inv_main_2930 WHERE item_id = 3;
----
3 WH_85

statement ok
DROP VIEW vw_inv_2930;

statement ok
DROP TABLE #inv_delta_2930;

statement ok
DROP TABLE inv_main_2930;
