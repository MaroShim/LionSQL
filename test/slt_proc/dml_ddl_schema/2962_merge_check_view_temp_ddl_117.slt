# test/slt_proc/dml_ddl_schema/2962_merge_check_view_temp_ddl_117.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (117)

statement ok
CREATE TABLE inv_main_2962 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 585 CHECK (qty >= 585)
);

statement ok
INSERT INTO inv_main_2962 (item_id, sku, qty) VALUES (1, 'SKU_A_117', 595), (2, 'SKU_B_117', 610);

statement error
INSERT INTO inv_main_2962 (item_id, sku, qty) VALUES (9, 'SKU_BAD_117', 584);

statement ok
INSERT INTO inv_main_2962 (item_id, sku) VALUES (3, 'SKU_DEF_117');

statement ok
CREATE TABLE #inv_delta_2962 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2962 VALUES (2, 'SKU_B_117', 5), (4, 'SKU_D_117', 625);

statement ok
MERGE inv_main_2962 AS t
USING #inv_delta_2962 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2962 AS
SELECT item_id, sku, qty FROM inv_main_2962 WHERE qty > 585;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2962 ORDER BY item_id;
----
1 SKU_A_117 595
2 SKU_B_117 615
4 SKU_D_117 625

statement ok
ALTER TABLE inv_main_2962 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_117';

query IT
SELECT item_id, wh_code FROM inv_main_2962 WHERE item_id = 3;
----
3 WH_117

statement ok
DROP VIEW vw_inv_2962;

statement ok
DROP TABLE #inv_delta_2962;

statement ok
DROP TABLE inv_main_2962;
