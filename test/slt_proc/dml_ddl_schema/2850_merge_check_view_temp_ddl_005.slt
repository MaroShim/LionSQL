# test/slt_proc/dml_ddl_schema/2850_merge_check_view_temp_ddl_005.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (5)

statement ok
CREATE TABLE inv_main_2850 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 25 CHECK (qty >= 25)
);

statement ok
INSERT INTO inv_main_2850 (item_id, sku, qty) VALUES (1, 'SKU_A_5', 35), (2, 'SKU_B_5', 50);

statement error
INSERT INTO inv_main_2850 (item_id, sku, qty) VALUES (9, 'SKU_BAD_5', 24);

statement ok
INSERT INTO inv_main_2850 (item_id, sku) VALUES (3, 'SKU_DEF_5');

statement ok
CREATE TABLE #inv_delta_2850 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2850 VALUES (2, 'SKU_B_5', 5), (4, 'SKU_D_5', 65);

statement ok
MERGE inv_main_2850 AS t
USING #inv_delta_2850 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2850 AS
SELECT item_id, sku, qty FROM inv_main_2850 WHERE qty > 25;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2850 ORDER BY item_id;
----
1 SKU_A_5 35
2 SKU_B_5 55
4 SKU_D_5 65

statement ok
ALTER TABLE inv_main_2850 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_5';

query IT
SELECT item_id, wh_code FROM inv_main_2850 WHERE item_id = 3;
----
3 WH_5

statement ok
DROP VIEW vw_inv_2850;

statement ok
DROP TABLE #inv_delta_2850;

statement ok
DROP TABLE inv_main_2850;
