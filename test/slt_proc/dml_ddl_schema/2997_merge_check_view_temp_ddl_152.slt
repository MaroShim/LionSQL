# test/slt_proc/dml_ddl_schema/2997_merge_check_view_temp_ddl_152.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (152)

statement ok
CREATE TABLE inv_main_2997 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 760 CHECK (qty >= 760)
);

statement ok
INSERT INTO inv_main_2997 (item_id, sku, qty) VALUES (1, 'SKU_A_152', 770), (2, 'SKU_B_152', 785);

statement error
INSERT INTO inv_main_2997 (item_id, sku, qty) VALUES (9, 'SKU_BAD_152', 759);

statement ok
INSERT INTO inv_main_2997 (item_id, sku) VALUES (3, 'SKU_DEF_152');

statement ok
CREATE TABLE #inv_delta_2997 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2997 VALUES (2, 'SKU_B_152', 5), (4, 'SKU_D_152', 800);

statement ok
MERGE inv_main_2997 AS t
USING #inv_delta_2997 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2997 AS
SELECT item_id, sku, qty FROM inv_main_2997 WHERE qty > 760;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2997 ORDER BY item_id;
----
1 SKU_A_152 770
2 SKU_B_152 790
4 SKU_D_152 800

statement ok
ALTER TABLE inv_main_2997 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_152';

query IT
SELECT item_id, wh_code FROM inv_main_2997 WHERE item_id = 3;
----
3 WH_152

statement ok
DROP VIEW vw_inv_2997;

statement ok
DROP TABLE #inv_delta_2997;

statement ok
DROP TABLE inv_main_2997;
