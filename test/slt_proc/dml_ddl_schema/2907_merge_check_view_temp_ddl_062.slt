# test/slt_proc/dml_ddl_schema/2907_merge_check_view_temp_ddl_062.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (62)

statement ok
CREATE TABLE inv_main_2907 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 310 CHECK (qty >= 310)
);

statement ok
INSERT INTO inv_main_2907 (item_id, sku, qty) VALUES (1, 'SKU_A_62', 320), (2, 'SKU_B_62', 335);

statement error
INSERT INTO inv_main_2907 (item_id, sku, qty) VALUES (9, 'SKU_BAD_62', 309);

statement ok
INSERT INTO inv_main_2907 (item_id, sku) VALUES (3, 'SKU_DEF_62');

statement ok
CREATE TABLE #inv_delta_2907 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2907 VALUES (2, 'SKU_B_62', 5), (4, 'SKU_D_62', 350);

statement ok
MERGE inv_main_2907 AS t
USING #inv_delta_2907 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2907 AS
SELECT item_id, sku, qty FROM inv_main_2907 WHERE qty > 310;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2907 ORDER BY item_id;
----
1 SKU_A_62 320
2 SKU_B_62 340
4 SKU_D_62 350

statement ok
ALTER TABLE inv_main_2907 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_62';

query IT
SELECT item_id, wh_code FROM inv_main_2907 WHERE item_id = 3;
----
3 WH_62

statement ok
DROP VIEW vw_inv_2907;

statement ok
DROP TABLE #inv_delta_2907;

statement ok
DROP TABLE inv_main_2907;
