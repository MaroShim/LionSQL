# test/slt_proc/dml_ddl_schema/2927_merge_check_view_temp_ddl_082.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (82)

statement ok
CREATE TABLE inv_main_2927 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 410 CHECK (qty >= 410)
);

statement ok
INSERT INTO inv_main_2927 (item_id, sku, qty) VALUES (1, 'SKU_A_82', 420), (2, 'SKU_B_82', 435);

statement error
INSERT INTO inv_main_2927 (item_id, sku, qty) VALUES (9, 'SKU_BAD_82', 409);

statement ok
INSERT INTO inv_main_2927 (item_id, sku) VALUES (3, 'SKU_DEF_82');

statement ok
CREATE TABLE #inv_delta_2927 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2927 VALUES (2, 'SKU_B_82', 5), (4, 'SKU_D_82', 450);

statement ok
MERGE inv_main_2927 AS t
USING #inv_delta_2927 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2927 AS
SELECT item_id, sku, qty FROM inv_main_2927 WHERE qty > 410;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2927 ORDER BY item_id;
----
1 SKU_A_82 420
2 SKU_B_82 440
4 SKU_D_82 450

statement ok
ALTER TABLE inv_main_2927 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_82';

query IT
SELECT item_id, wh_code FROM inv_main_2927 WHERE item_id = 3;
----
3 WH_82

statement ok
DROP VIEW vw_inv_2927;

statement ok
DROP TABLE #inv_delta_2927;

statement ok
DROP TABLE inv_main_2927;
