# test/slt_proc/dml_ddl_schema/2944_merge_check_view_temp_ddl_099.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (99)

statement ok
CREATE TABLE inv_main_2944 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 495 CHECK (qty >= 495)
);

statement ok
INSERT INTO inv_main_2944 (item_id, sku, qty) VALUES (1, 'SKU_A_99', 505), (2, 'SKU_B_99', 520);

statement error
INSERT INTO inv_main_2944 (item_id, sku, qty) VALUES (9, 'SKU_BAD_99', 494);

statement ok
INSERT INTO inv_main_2944 (item_id, sku) VALUES (3, 'SKU_DEF_99');

statement ok
CREATE TABLE #inv_delta_2944 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2944 VALUES (2, 'SKU_B_99', 5), (4, 'SKU_D_99', 535);

statement ok
MERGE inv_main_2944 AS t
USING #inv_delta_2944 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2944 AS
SELECT item_id, sku, qty FROM inv_main_2944 WHERE qty > 495;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2944 ORDER BY item_id;
----
1 SKU_A_99 505
2 SKU_B_99 525
4 SKU_D_99 535

statement ok
ALTER TABLE inv_main_2944 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_99';

query IT
SELECT item_id, wh_code FROM inv_main_2944 WHERE item_id = 3;
----
3 WH_99

statement ok
DROP VIEW vw_inv_2944;

statement ok
DROP TABLE #inv_delta_2944;

statement ok
DROP TABLE inv_main_2944;
