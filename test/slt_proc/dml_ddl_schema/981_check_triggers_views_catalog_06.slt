# test/slt_proc/dml_ddl_schema/981_check_triggers_views_catalog_06.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (6)

statement ok
CREATE TABLE acct_981 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 60 CHECK (balance >= 60)
);

statement ok
CREATE VIEW vw_acct_high_981 AS
SELECT id, owner, balance FROM acct_981 WHERE balance > 60;

statement ok
INSERT INTO acct_981 (id, owner, balance) VALUES (1, 'UserA_6', 110), (2, 'UserB_6', 180);

statement error
INSERT INTO acct_981 (id, owner, balance) VALUES (3, 'BadUser_6', 55);

statement error
UPDATE acct_981 SET balance = 55 WHERE id = 1;

statement ok
INSERT INTO acct_981 (id, owner) VALUES (4, 'DefaultUser_6');

query ITI
SELECT id, owner, balance FROM acct_981 ORDER BY id;
----
1 UserA_6 110
2 UserB_6 180
4 DefaultUser_6 60

query II
SELECT id, balance FROM vw_acct_high_981 ORDER BY id;
----
1 110
2 180

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_981';
----
vw_acct_high_981

statement ok
DROP VIEW vw_acct_high_981;

statement ok
DROP TABLE acct_981;
