# test/slt_proc/dml_ddl_schema/233_merge_constraints_views_ddl_03.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (3)

statement ok
CREATE TABLE m_tgt_233 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 300 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_233 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_233 (sku, code, qty) VALUES (1, 'A_3', 15), (2, 'B_3', 30);

statement ok
INSERT INTO m_src_233 VALUES (2, 'B_3', 6), (3, 'C_3', 45);

statement error
INSERT INTO m_tgt_233 (sku, code, qty) VALUES (9, 'NEG_3', -5);

statement ok
MERGE m_tgt_233 AS t
USING m_src_233 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_233 ORDER BY sku;
----
1 A_3 15
2 B_3 36
3 C_3 45

query II
SELECT TOP 2 sku, qty FROM m_tgt_233 ORDER BY sku DESC;
----
3 45
2 36

statement ok
ALTER TABLE m_tgt_233 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_233 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_233;

statement ok
DROP TABLE m_tgt_233;
