# test/slt_proc/dml_ddl_schema/2979_merge_check_view_temp_ddl_134.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (134)

statement ok
CREATE TABLE inv_main_2979 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 670 CHECK (qty >= 670)
);

statement ok
INSERT INTO inv_main_2979 (item_id, sku, qty) VALUES (1, 'SKU_A_134', 680), (2, 'SKU_B_134', 695);

statement error
INSERT INTO inv_main_2979 (item_id, sku, qty) VALUES (9, 'SKU_BAD_134', 669);

statement ok
INSERT INTO inv_main_2979 (item_id, sku) VALUES (3, 'SKU_DEF_134');

statement ok
CREATE TABLE #inv_delta_2979 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2979 VALUES (2, 'SKU_B_134', 5), (4, 'SKU_D_134', 710);

statement ok
MERGE inv_main_2979 AS t
USING #inv_delta_2979 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2979 AS
SELECT item_id, sku, qty FROM inv_main_2979 WHERE qty > 670;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2979 ORDER BY item_id;
----
1 SKU_A_134 680
2 SKU_B_134 700
4 SKU_D_134 710

statement ok
ALTER TABLE inv_main_2979 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_134';

query IT
SELECT item_id, wh_code FROM inv_main_2979 WHERE item_id = 3;
----
3 WH_134

statement ok
DROP VIEW vw_inv_2979;

statement ok
DROP TABLE #inv_delta_2979;

statement ok
DROP TABLE inv_main_2979;
