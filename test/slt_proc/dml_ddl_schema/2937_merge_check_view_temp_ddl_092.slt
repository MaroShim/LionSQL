# test/slt_proc/dml_ddl_schema/2937_merge_check_view_temp_ddl_092.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (92)

statement ok
CREATE TABLE inv_main_2937 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 460 CHECK (qty >= 460)
);

statement ok
INSERT INTO inv_main_2937 (item_id, sku, qty) VALUES (1, 'SKU_A_92', 470), (2, 'SKU_B_92', 485);

statement error
INSERT INTO inv_main_2937 (item_id, sku, qty) VALUES (9, 'SKU_BAD_92', 459);

statement ok
INSERT INTO inv_main_2937 (item_id, sku) VALUES (3, 'SKU_DEF_92');

statement ok
CREATE TABLE #inv_delta_2937 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2937 VALUES (2, 'SKU_B_92', 5), (4, 'SKU_D_92', 500);

statement ok
MERGE inv_main_2937 AS t
USING #inv_delta_2937 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2937 AS
SELECT item_id, sku, qty FROM inv_main_2937 WHERE qty > 460;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2937 ORDER BY item_id;
----
1 SKU_A_92 470
2 SKU_B_92 490
4 SKU_D_92 500

statement ok
ALTER TABLE inv_main_2937 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_92';

query IT
SELECT item_id, wh_code FROM inv_main_2937 WHERE item_id = 3;
----
3 WH_92

statement ok
DROP VIEW vw_inv_2937;

statement ok
DROP TABLE #inv_delta_2937;

statement ok
DROP TABLE inv_main_2937;
