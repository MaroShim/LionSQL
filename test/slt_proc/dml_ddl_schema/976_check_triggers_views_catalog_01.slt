# test/slt_proc/dml_ddl_schema/976_check_triggers_views_catalog_01.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (1)

statement ok
CREATE TABLE acct_976 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 10 CHECK (balance >= 10)
);

statement ok
CREATE VIEW vw_acct_high_976 AS
SELECT id, owner, balance FROM acct_976 WHERE balance > 10;

statement ok
INSERT INTO acct_976 (id, owner, balance) VALUES (1, 'UserA_1', 60), (2, 'UserB_1', 130);

statement error
INSERT INTO acct_976 (id, owner, balance) VALUES (3, 'BadUser_1', 5);

statement error
UPDATE acct_976 SET balance = 5 WHERE id = 1;

statement ok
INSERT INTO acct_976 (id, owner) VALUES (4, 'DefaultUser_1');

query ITI
SELECT id, owner, balance FROM acct_976 ORDER BY id;
----
1 UserA_1 60
2 UserB_1 130
4 DefaultUser_1 10

query II
SELECT id, balance FROM vw_acct_high_976 ORDER BY id;
----
1 60
2 130

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_976';
----
vw_acct_high_976

statement ok
DROP VIEW vw_acct_high_976;

statement ok
DROP TABLE acct_976;
