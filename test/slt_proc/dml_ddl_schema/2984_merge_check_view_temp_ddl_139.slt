# test/slt_proc/dml_ddl_schema/2984_merge_check_view_temp_ddl_139.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (139)

statement ok
CREATE TABLE inv_main_2984 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 695 CHECK (qty >= 695)
);

statement ok
INSERT INTO inv_main_2984 (item_id, sku, qty) VALUES (1, 'SKU_A_139', 705), (2, 'SKU_B_139', 720);

statement error
INSERT INTO inv_main_2984 (item_id, sku, qty) VALUES (9, 'SKU_BAD_139', 694);

statement ok
INSERT INTO inv_main_2984 (item_id, sku) VALUES (3, 'SKU_DEF_139');

statement ok
CREATE TABLE #inv_delta_2984 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2984 VALUES (2, 'SKU_B_139', 5), (4, 'SKU_D_139', 735);

statement ok
MERGE inv_main_2984 AS t
USING #inv_delta_2984 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2984 AS
SELECT item_id, sku, qty FROM inv_main_2984 WHERE qty > 695;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2984 ORDER BY item_id;
----
1 SKU_A_139 705
2 SKU_B_139 725
4 SKU_D_139 735

statement ok
ALTER TABLE inv_main_2984 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_139';

query IT
SELECT item_id, wh_code FROM inv_main_2984 WHERE item_id = 3;
----
3 WH_139

statement ok
DROP VIEW vw_inv_2984;

statement ok
DROP TABLE #inv_delta_2984;

statement ok
DROP TABLE inv_main_2984;
