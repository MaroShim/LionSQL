# test/slt_proc/dml_ddl_schema/2880_merge_check_view_temp_ddl_035.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (35)

statement ok
CREATE TABLE inv_main_2880 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 175 CHECK (qty >= 175)
);

statement ok
INSERT INTO inv_main_2880 (item_id, sku, qty) VALUES (1, 'SKU_A_35', 185), (2, 'SKU_B_35', 200);

statement error
INSERT INTO inv_main_2880 (item_id, sku, qty) VALUES (9, 'SKU_BAD_35', 174);

statement ok
INSERT INTO inv_main_2880 (item_id, sku) VALUES (3, 'SKU_DEF_35');

statement ok
CREATE TABLE #inv_delta_2880 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2880 VALUES (2, 'SKU_B_35', 5), (4, 'SKU_D_35', 215);

statement ok
MERGE inv_main_2880 AS t
USING #inv_delta_2880 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2880 AS
SELECT item_id, sku, qty FROM inv_main_2880 WHERE qty > 175;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2880 ORDER BY item_id;
----
1 SKU_A_35 185
2 SKU_B_35 205
4 SKU_D_35 215

statement ok
ALTER TABLE inv_main_2880 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_35';

query IT
SELECT item_id, wh_code FROM inv_main_2880 WHERE item_id = 3;
----
3 WH_35

statement ok
DROP VIEW vw_inv_2880;

statement ok
DROP TABLE #inv_delta_2880;

statement ok
DROP TABLE inv_main_2880;
