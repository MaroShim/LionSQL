# test/slt_proc/dml_ddl_schema/2903_merge_check_view_temp_ddl_058.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (58)

statement ok
CREATE TABLE inv_main_2903 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 290 CHECK (qty >= 290)
);

statement ok
INSERT INTO inv_main_2903 (item_id, sku, qty) VALUES (1, 'SKU_A_58', 300), (2, 'SKU_B_58', 315);

statement error
INSERT INTO inv_main_2903 (item_id, sku, qty) VALUES (9, 'SKU_BAD_58', 289);

statement ok
INSERT INTO inv_main_2903 (item_id, sku) VALUES (3, 'SKU_DEF_58');

statement ok
CREATE TABLE #inv_delta_2903 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2903 VALUES (2, 'SKU_B_58', 5), (4, 'SKU_D_58', 330);

statement ok
MERGE inv_main_2903 AS t
USING #inv_delta_2903 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2903 AS
SELECT item_id, sku, qty FROM inv_main_2903 WHERE qty > 290;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2903 ORDER BY item_id;
----
1 SKU_A_58 300
2 SKU_B_58 320
4 SKU_D_58 330

statement ok
ALTER TABLE inv_main_2903 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_58';

query IT
SELECT item_id, wh_code FROM inv_main_2903 WHERE item_id = 3;
----
3 WH_58

statement ok
DROP VIEW vw_inv_2903;

statement ok
DROP TABLE #inv_delta_2903;

statement ok
DROP TABLE inv_main_2903;
