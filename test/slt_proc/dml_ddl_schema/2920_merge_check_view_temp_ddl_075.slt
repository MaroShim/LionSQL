# test/slt_proc/dml_ddl_schema/2920_merge_check_view_temp_ddl_075.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (75)

statement ok
CREATE TABLE inv_main_2920 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 375 CHECK (qty >= 375)
);

statement ok
INSERT INTO inv_main_2920 (item_id, sku, qty) VALUES (1, 'SKU_A_75', 385), (2, 'SKU_B_75', 400);

statement error
INSERT INTO inv_main_2920 (item_id, sku, qty) VALUES (9, 'SKU_BAD_75', 374);

statement ok
INSERT INTO inv_main_2920 (item_id, sku) VALUES (3, 'SKU_DEF_75');

statement ok
CREATE TABLE #inv_delta_2920 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2920 VALUES (2, 'SKU_B_75', 5), (4, 'SKU_D_75', 415);

statement ok
MERGE inv_main_2920 AS t
USING #inv_delta_2920 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2920 AS
SELECT item_id, sku, qty FROM inv_main_2920 WHERE qty > 375;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2920 ORDER BY item_id;
----
1 SKU_A_75 385
2 SKU_B_75 405
4 SKU_D_75 415

statement ok
ALTER TABLE inv_main_2920 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_75';

query IT
SELECT item_id, wh_code FROM inv_main_2920 WHERE item_id = 3;
----
3 WH_75

statement ok
DROP VIEW vw_inv_2920;

statement ok
DROP TABLE #inv_delta_2920;

statement ok
DROP TABLE inv_main_2920;
