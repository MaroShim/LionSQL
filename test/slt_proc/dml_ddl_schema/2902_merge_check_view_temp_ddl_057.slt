# test/slt_proc/dml_ddl_schema/2902_merge_check_view_temp_ddl_057.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (57)

statement ok
CREATE TABLE inv_main_2902 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 285 CHECK (qty >= 285)
);

statement ok
INSERT INTO inv_main_2902 (item_id, sku, qty) VALUES (1, 'SKU_A_57', 295), (2, 'SKU_B_57', 310);

statement error
INSERT INTO inv_main_2902 (item_id, sku, qty) VALUES (9, 'SKU_BAD_57', 284);

statement ok
INSERT INTO inv_main_2902 (item_id, sku) VALUES (3, 'SKU_DEF_57');

statement ok
CREATE TABLE #inv_delta_2902 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2902 VALUES (2, 'SKU_B_57', 5), (4, 'SKU_D_57', 325);

statement ok
MERGE inv_main_2902 AS t
USING #inv_delta_2902 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2902 AS
SELECT item_id, sku, qty FROM inv_main_2902 WHERE qty > 285;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2902 ORDER BY item_id;
----
1 SKU_A_57 295
2 SKU_B_57 315
4 SKU_D_57 325

statement ok
ALTER TABLE inv_main_2902 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_57';

query IT
SELECT item_id, wh_code FROM inv_main_2902 WHERE item_id = 3;
----
3 WH_57

statement ok
DROP VIEW vw_inv_2902;

statement ok
DROP TABLE #inv_delta_2902;

statement ok
DROP TABLE inv_main_2902;
