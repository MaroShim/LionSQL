# test/slt_proc/dml_ddl_schema/2874_merge_check_view_temp_ddl_029.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (29)

statement ok
CREATE TABLE inv_main_2874 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 145 CHECK (qty >= 145)
);

statement ok
INSERT INTO inv_main_2874 (item_id, sku, qty) VALUES (1, 'SKU_A_29', 155), (2, 'SKU_B_29', 170);

statement error
INSERT INTO inv_main_2874 (item_id, sku, qty) VALUES (9, 'SKU_BAD_29', 144);

statement ok
INSERT INTO inv_main_2874 (item_id, sku) VALUES (3, 'SKU_DEF_29');

statement ok
CREATE TABLE #inv_delta_2874 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2874 VALUES (2, 'SKU_B_29', 5), (4, 'SKU_D_29', 185);

statement ok
MERGE inv_main_2874 AS t
USING #inv_delta_2874 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2874 AS
SELECT item_id, sku, qty FROM inv_main_2874 WHERE qty > 145;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2874 ORDER BY item_id;
----
1 SKU_A_29 155
2 SKU_B_29 175
4 SKU_D_29 185

statement ok
ALTER TABLE inv_main_2874 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_29';

query IT
SELECT item_id, wh_code FROM inv_main_2874 WHERE item_id = 3;
----
3 WH_29

statement ok
DROP VIEW vw_inv_2874;

statement ok
DROP TABLE #inv_delta_2874;

statement ok
DROP TABLE inv_main_2874;
