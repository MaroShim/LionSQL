# test/slt_proc/dml_ddl_schema/2982_merge_check_view_temp_ddl_137.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (137)

statement ok
CREATE TABLE inv_main_2982 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 685 CHECK (qty >= 685)
);

statement ok
INSERT INTO inv_main_2982 (item_id, sku, qty) VALUES (1, 'SKU_A_137', 695), (2, 'SKU_B_137', 710);

statement error
INSERT INTO inv_main_2982 (item_id, sku, qty) VALUES (9, 'SKU_BAD_137', 684);

statement ok
INSERT INTO inv_main_2982 (item_id, sku) VALUES (3, 'SKU_DEF_137');

statement ok
CREATE TABLE #inv_delta_2982 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2982 VALUES (2, 'SKU_B_137', 5), (4, 'SKU_D_137', 725);

statement ok
MERGE inv_main_2982 AS t
USING #inv_delta_2982 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2982 AS
SELECT item_id, sku, qty FROM inv_main_2982 WHERE qty > 685;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2982 ORDER BY item_id;
----
1 SKU_A_137 695
2 SKU_B_137 715
4 SKU_D_137 725

statement ok
ALTER TABLE inv_main_2982 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_137';

query IT
SELECT item_id, wh_code FROM inv_main_2982 WHERE item_id = 3;
----
3 WH_137

statement ok
DROP VIEW vw_inv_2982;

statement ok
DROP TABLE #inv_delta_2982;

statement ok
DROP TABLE inv_main_2982;
