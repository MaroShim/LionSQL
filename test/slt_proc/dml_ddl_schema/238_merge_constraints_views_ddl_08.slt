# test/slt_proc/dml_ddl_schema/238_merge_constraints_views_ddl_08.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (8)

statement ok
CREATE TABLE m_tgt_238 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 800 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_238 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_238 (sku, code, qty) VALUES (1, 'A_8', 40), (2, 'B_8', 80);

statement ok
INSERT INTO m_src_238 VALUES (2, 'B_8', 16), (3, 'C_8', 120);

statement error
INSERT INTO m_tgt_238 (sku, code, qty) VALUES (9, 'NEG_8', -5);

statement ok
MERGE m_tgt_238 AS t
USING m_src_238 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_238 ORDER BY sku;
----
1 A_8 40
2 B_8 96
3 C_8 120

query II
SELECT TOP 2 sku, qty FROM m_tgt_238 ORDER BY sku DESC;
----
3 120
2 96

statement ok
ALTER TABLE m_tgt_238 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_238 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_238;

statement ok
DROP TABLE m_tgt_238;
