# test/slt_proc/dml_ddl_schema/988_check_triggers_views_catalog_13.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (13)

statement ok
CREATE TABLE acct_988 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 130 CHECK (balance >= 130)
);

statement ok
CREATE VIEW vw_acct_high_988 AS
SELECT id, owner, balance FROM acct_988 WHERE balance > 130;

statement ok
INSERT INTO acct_988 (id, owner, balance) VALUES (1, 'UserA_13', 180), (2, 'UserB_13', 250);

statement error
INSERT INTO acct_988 (id, owner, balance) VALUES (3, 'BadUser_13', 125);

statement error
UPDATE acct_988 SET balance = 125 WHERE id = 1;

statement ok
INSERT INTO acct_988 (id, owner) VALUES (4, 'DefaultUser_13');

query ITI
SELECT id, owner, balance FROM acct_988 ORDER BY id;
----
1 UserA_13 180
2 UserB_13 250
4 DefaultUser_13 130

query II
SELECT id, balance FROM vw_acct_high_988 ORDER BY id;
----
1 180
2 250

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_988';
----
vw_acct_high_988

statement ok
DROP VIEW vw_acct_high_988;

statement ok
DROP TABLE acct_988;
