# test/slt_proc/dml_ddl_schema/2901_merge_check_view_temp_ddl_056.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (56)

statement ok
CREATE TABLE inv_main_2901 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 280 CHECK (qty >= 280)
);

statement ok
INSERT INTO inv_main_2901 (item_id, sku, qty) VALUES (1, 'SKU_A_56', 290), (2, 'SKU_B_56', 305);

statement error
INSERT INTO inv_main_2901 (item_id, sku, qty) VALUES (9, 'SKU_BAD_56', 279);

statement ok
INSERT INTO inv_main_2901 (item_id, sku) VALUES (3, 'SKU_DEF_56');

statement ok
CREATE TABLE #inv_delta_2901 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2901 VALUES (2, 'SKU_B_56', 5), (4, 'SKU_D_56', 320);

statement ok
MERGE inv_main_2901 AS t
USING #inv_delta_2901 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2901 AS
SELECT item_id, sku, qty FROM inv_main_2901 WHERE qty > 280;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2901 ORDER BY item_id;
----
1 SKU_A_56 290
2 SKU_B_56 310
4 SKU_D_56 320

statement ok
ALTER TABLE inv_main_2901 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_56';

query IT
SELECT item_id, wh_code FROM inv_main_2901 WHERE item_id = 3;
----
3 WH_56

statement ok
DROP VIEW vw_inv_2901;

statement ok
DROP TABLE #inv_delta_2901;

statement ok
DROP TABLE inv_main_2901;
