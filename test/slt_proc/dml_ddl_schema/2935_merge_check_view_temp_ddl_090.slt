# test/slt_proc/dml_ddl_schema/2935_merge_check_view_temp_ddl_090.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (90)

statement ok
CREATE TABLE inv_main_2935 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 450 CHECK (qty >= 450)
);

statement ok
INSERT INTO inv_main_2935 (item_id, sku, qty) VALUES (1, 'SKU_A_90', 460), (2, 'SKU_B_90', 475);

statement error
INSERT INTO inv_main_2935 (item_id, sku, qty) VALUES (9, 'SKU_BAD_90', 449);

statement ok
INSERT INTO inv_main_2935 (item_id, sku) VALUES (3, 'SKU_DEF_90');

statement ok
CREATE TABLE #inv_delta_2935 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2935 VALUES (2, 'SKU_B_90', 5), (4, 'SKU_D_90', 490);

statement ok
MERGE inv_main_2935 AS t
USING #inv_delta_2935 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2935 AS
SELECT item_id, sku, qty FROM inv_main_2935 WHERE qty > 450;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2935 ORDER BY item_id;
----
1 SKU_A_90 460
2 SKU_B_90 480
4 SKU_D_90 490

statement ok
ALTER TABLE inv_main_2935 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_90';

query IT
SELECT item_id, wh_code FROM inv_main_2935 WHERE item_id = 3;
----
3 WH_90

statement ok
DROP VIEW vw_inv_2935;

statement ok
DROP TABLE #inv_delta_2935;

statement ok
DROP TABLE inv_main_2935;
