# test/slt_proc/dml_ddl_schema/2985_merge_check_view_temp_ddl_140.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (140)

statement ok
CREATE TABLE inv_main_2985 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 700 CHECK (qty >= 700)
);

statement ok
INSERT INTO inv_main_2985 (item_id, sku, qty) VALUES (1, 'SKU_A_140', 710), (2, 'SKU_B_140', 725);

statement error
INSERT INTO inv_main_2985 (item_id, sku, qty) VALUES (9, 'SKU_BAD_140', 699);

statement ok
INSERT INTO inv_main_2985 (item_id, sku) VALUES (3, 'SKU_DEF_140');

statement ok
CREATE TABLE #inv_delta_2985 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2985 VALUES (2, 'SKU_B_140', 5), (4, 'SKU_D_140', 740);

statement ok
MERGE inv_main_2985 AS t
USING #inv_delta_2985 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2985 AS
SELECT item_id, sku, qty FROM inv_main_2985 WHERE qty > 700;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2985 ORDER BY item_id;
----
1 SKU_A_140 710
2 SKU_B_140 730
4 SKU_D_140 740

statement ok
ALTER TABLE inv_main_2985 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_140';

query IT
SELECT item_id, wh_code FROM inv_main_2985 WHERE item_id = 3;
----
3 WH_140

statement ok
DROP VIEW vw_inv_2985;

statement ok
DROP TABLE #inv_delta_2985;

statement ok
DROP TABLE inv_main_2985;
