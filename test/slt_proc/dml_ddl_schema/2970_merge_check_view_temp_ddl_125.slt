# test/slt_proc/dml_ddl_schema/2970_merge_check_view_temp_ddl_125.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (125)

statement ok
CREATE TABLE inv_main_2970 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 625 CHECK (qty >= 625)
);

statement ok
INSERT INTO inv_main_2970 (item_id, sku, qty) VALUES (1, 'SKU_A_125', 635), (2, 'SKU_B_125', 650);

statement error
INSERT INTO inv_main_2970 (item_id, sku, qty) VALUES (9, 'SKU_BAD_125', 624);

statement ok
INSERT INTO inv_main_2970 (item_id, sku) VALUES (3, 'SKU_DEF_125');

statement ok
CREATE TABLE #inv_delta_2970 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2970 VALUES (2, 'SKU_B_125', 5), (4, 'SKU_D_125', 665);

statement ok
MERGE inv_main_2970 AS t
USING #inv_delta_2970 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2970 AS
SELECT item_id, sku, qty FROM inv_main_2970 WHERE qty > 625;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2970 ORDER BY item_id;
----
1 SKU_A_125 635
2 SKU_B_125 655
4 SKU_D_125 665

statement ok
ALTER TABLE inv_main_2970 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_125';

query IT
SELECT item_id, wh_code FROM inv_main_2970 WHERE item_id = 3;
----
3 WH_125

statement ok
DROP VIEW vw_inv_2970;

statement ok
DROP TABLE #inv_delta_2970;

statement ok
DROP TABLE inv_main_2970;
