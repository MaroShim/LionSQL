# test/slt_proc/dml_ddl_schema/2976_merge_check_view_temp_ddl_131.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (131)

statement ok
CREATE TABLE inv_main_2976 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 655 CHECK (qty >= 655)
);

statement ok
INSERT INTO inv_main_2976 (item_id, sku, qty) VALUES (1, 'SKU_A_131', 665), (2, 'SKU_B_131', 680);

statement error
INSERT INTO inv_main_2976 (item_id, sku, qty) VALUES (9, 'SKU_BAD_131', 654);

statement ok
INSERT INTO inv_main_2976 (item_id, sku) VALUES (3, 'SKU_DEF_131');

statement ok
CREATE TABLE #inv_delta_2976 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2976 VALUES (2, 'SKU_B_131', 5), (4, 'SKU_D_131', 695);

statement ok
MERGE inv_main_2976 AS t
USING #inv_delta_2976 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2976 AS
SELECT item_id, sku, qty FROM inv_main_2976 WHERE qty > 655;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2976 ORDER BY item_id;
----
1 SKU_A_131 665
2 SKU_B_131 685
4 SKU_D_131 695

statement ok
ALTER TABLE inv_main_2976 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_131';

query IT
SELECT item_id, wh_code FROM inv_main_2976 WHERE item_id = 3;
----
3 WH_131

statement ok
DROP VIEW vw_inv_2976;

statement ok
DROP TABLE #inv_delta_2976;

statement ok
DROP TABLE inv_main_2976;
