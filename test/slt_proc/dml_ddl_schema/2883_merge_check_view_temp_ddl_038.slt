# test/slt_proc/dml_ddl_schema/2883_merge_check_view_temp_ddl_038.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (38)

statement ok
CREATE TABLE inv_main_2883 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 190 CHECK (qty >= 190)
);

statement ok
INSERT INTO inv_main_2883 (item_id, sku, qty) VALUES (1, 'SKU_A_38', 200), (2, 'SKU_B_38', 215);

statement error
INSERT INTO inv_main_2883 (item_id, sku, qty) VALUES (9, 'SKU_BAD_38', 189);

statement ok
INSERT INTO inv_main_2883 (item_id, sku) VALUES (3, 'SKU_DEF_38');

statement ok
CREATE TABLE #inv_delta_2883 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2883 VALUES (2, 'SKU_B_38', 5), (4, 'SKU_D_38', 230);

statement ok
MERGE inv_main_2883 AS t
USING #inv_delta_2883 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2883 AS
SELECT item_id, sku, qty FROM inv_main_2883 WHERE qty > 190;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2883 ORDER BY item_id;
----
1 SKU_A_38 200
2 SKU_B_38 220
4 SKU_D_38 230

statement ok
ALTER TABLE inv_main_2883 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_38';

query IT
SELECT item_id, wh_code FROM inv_main_2883 WHERE item_id = 3;
----
3 WH_38

statement ok
DROP VIEW vw_inv_2883;

statement ok
DROP TABLE #inv_delta_2883;

statement ok
DROP TABLE inv_main_2883;
