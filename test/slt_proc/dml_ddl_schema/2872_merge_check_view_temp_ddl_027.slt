# test/slt_proc/dml_ddl_schema/2872_merge_check_view_temp_ddl_027.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (27)

statement ok
CREATE TABLE inv_main_2872 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 135 CHECK (qty >= 135)
);

statement ok
INSERT INTO inv_main_2872 (item_id, sku, qty) VALUES (1, 'SKU_A_27', 145), (2, 'SKU_B_27', 160);

statement error
INSERT INTO inv_main_2872 (item_id, sku, qty) VALUES (9, 'SKU_BAD_27', 134);

statement ok
INSERT INTO inv_main_2872 (item_id, sku) VALUES (3, 'SKU_DEF_27');

statement ok
CREATE TABLE #inv_delta_2872 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2872 VALUES (2, 'SKU_B_27', 5), (4, 'SKU_D_27', 175);

statement ok
MERGE inv_main_2872 AS t
USING #inv_delta_2872 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2872 AS
SELECT item_id, sku, qty FROM inv_main_2872 WHERE qty > 135;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2872 ORDER BY item_id;
----
1 SKU_A_27 145
2 SKU_B_27 165
4 SKU_D_27 175

statement ok
ALTER TABLE inv_main_2872 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_27';

query IT
SELECT item_id, wh_code FROM inv_main_2872 WHERE item_id = 3;
----
3 WH_27

statement ok
DROP VIEW vw_inv_2872;

statement ok
DROP TABLE #inv_delta_2872;

statement ok
DROP TABLE inv_main_2872;
