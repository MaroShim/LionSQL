# test/slt_proc/dml_ddl_schema/2895_merge_check_view_temp_ddl_050.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (50)

statement ok
CREATE TABLE inv_main_2895 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 250 CHECK (qty >= 250)
);

statement ok
INSERT INTO inv_main_2895 (item_id, sku, qty) VALUES (1, 'SKU_A_50', 260), (2, 'SKU_B_50', 275);

statement error
INSERT INTO inv_main_2895 (item_id, sku, qty) VALUES (9, 'SKU_BAD_50', 249);

statement ok
INSERT INTO inv_main_2895 (item_id, sku) VALUES (3, 'SKU_DEF_50');

statement ok
CREATE TABLE #inv_delta_2895 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2895 VALUES (2, 'SKU_B_50', 5), (4, 'SKU_D_50', 290);

statement ok
MERGE inv_main_2895 AS t
USING #inv_delta_2895 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2895 AS
SELECT item_id, sku, qty FROM inv_main_2895 WHERE qty > 250;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2895 ORDER BY item_id;
----
1 SKU_A_50 260
2 SKU_B_50 280
4 SKU_D_50 290

statement ok
ALTER TABLE inv_main_2895 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_50';

query IT
SELECT item_id, wh_code FROM inv_main_2895 WHERE item_id = 3;
----
3 WH_50

statement ok
DROP VIEW vw_inv_2895;

statement ok
DROP TABLE #inv_delta_2895;

statement ok
DROP TABLE inv_main_2895;
