# test/slt_proc/dml_ddl_schema/2877_merge_check_view_temp_ddl_032.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (32)

statement ok
CREATE TABLE inv_main_2877 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 160 CHECK (qty >= 160)
);

statement ok
INSERT INTO inv_main_2877 (item_id, sku, qty) VALUES (1, 'SKU_A_32', 170), (2, 'SKU_B_32', 185);

statement error
INSERT INTO inv_main_2877 (item_id, sku, qty) VALUES (9, 'SKU_BAD_32', 159);

statement ok
INSERT INTO inv_main_2877 (item_id, sku) VALUES (3, 'SKU_DEF_32');

statement ok
CREATE TABLE #inv_delta_2877 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2877 VALUES (2, 'SKU_B_32', 5), (4, 'SKU_D_32', 200);

statement ok
MERGE inv_main_2877 AS t
USING #inv_delta_2877 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2877 AS
SELECT item_id, sku, qty FROM inv_main_2877 WHERE qty > 160;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2877 ORDER BY item_id;
----
1 SKU_A_32 170
2 SKU_B_32 190
4 SKU_D_32 200

statement ok
ALTER TABLE inv_main_2877 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_32';

query IT
SELECT item_id, wh_code FROM inv_main_2877 WHERE item_id = 3;
----
3 WH_32

statement ok
DROP VIEW vw_inv_2877;

statement ok
DROP TABLE #inv_delta_2877;

statement ok
DROP TABLE inv_main_2877;
