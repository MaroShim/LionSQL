# test/slt_proc/dml_ddl_schema/2992_merge_check_view_temp_ddl_147.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (147)

statement ok
CREATE TABLE inv_main_2992 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 735 CHECK (qty >= 735)
);

statement ok
INSERT INTO inv_main_2992 (item_id, sku, qty) VALUES (1, 'SKU_A_147', 745), (2, 'SKU_B_147', 760);

statement error
INSERT INTO inv_main_2992 (item_id, sku, qty) VALUES (9, 'SKU_BAD_147', 734);

statement ok
INSERT INTO inv_main_2992 (item_id, sku) VALUES (3, 'SKU_DEF_147');

statement ok
CREATE TABLE #inv_delta_2992 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2992 VALUES (2, 'SKU_B_147', 5), (4, 'SKU_D_147', 775);

statement ok
MERGE inv_main_2992 AS t
USING #inv_delta_2992 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2992 AS
SELECT item_id, sku, qty FROM inv_main_2992 WHERE qty > 735;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2992 ORDER BY item_id;
----
1 SKU_A_147 745
2 SKU_B_147 765
4 SKU_D_147 775

statement ok
ALTER TABLE inv_main_2992 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_147';

query IT
SELECT item_id, wh_code FROM inv_main_2992 WHERE item_id = 3;
----
3 WH_147

statement ok
DROP VIEW vw_inv_2992;

statement ok
DROP TABLE #inv_delta_2992;

statement ok
DROP TABLE inv_main_2992;
