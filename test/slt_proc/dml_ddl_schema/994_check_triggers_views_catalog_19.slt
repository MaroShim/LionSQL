# test/slt_proc/dml_ddl_schema/994_check_triggers_views_catalog_19.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (19)

statement ok
CREATE TABLE acct_994 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 190 CHECK (balance >= 190)
);

statement ok
CREATE VIEW vw_acct_high_994 AS
SELECT id, owner, balance FROM acct_994 WHERE balance > 190;

statement ok
INSERT INTO acct_994 (id, owner, balance) VALUES (1, 'UserA_19', 240), (2, 'UserB_19', 310);

statement error
INSERT INTO acct_994 (id, owner, balance) VALUES (3, 'BadUser_19', 185);

statement error
UPDATE acct_994 SET balance = 185 WHERE id = 1;

statement ok
INSERT INTO acct_994 (id, owner) VALUES (4, 'DefaultUser_19');

query ITI
SELECT id, owner, balance FROM acct_994 ORDER BY id;
----
1 UserA_19 240
2 UserB_19 310
4 DefaultUser_19 190

query II
SELECT id, balance FROM vw_acct_high_994 ORDER BY id;
----
1 240
2 310

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_994';
----
vw_acct_high_994

statement ok
DROP VIEW vw_acct_high_994;

statement ok
DROP TABLE acct_994;
