# test/slt_proc/dml_ddl_schema/2929_merge_check_view_temp_ddl_084.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (84)

statement ok
CREATE TABLE inv_main_2929 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 420 CHECK (qty >= 420)
);

statement ok
INSERT INTO inv_main_2929 (item_id, sku, qty) VALUES (1, 'SKU_A_84', 430), (2, 'SKU_B_84', 445);

statement error
INSERT INTO inv_main_2929 (item_id, sku, qty) VALUES (9, 'SKU_BAD_84', 419);

statement ok
INSERT INTO inv_main_2929 (item_id, sku) VALUES (3, 'SKU_DEF_84');

statement ok
CREATE TABLE #inv_delta_2929 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2929 VALUES (2, 'SKU_B_84', 5), (4, 'SKU_D_84', 460);

statement ok
MERGE inv_main_2929 AS t
USING #inv_delta_2929 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2929 AS
SELECT item_id, sku, qty FROM inv_main_2929 WHERE qty > 420;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2929 ORDER BY item_id;
----
1 SKU_A_84 430
2 SKU_B_84 450
4 SKU_D_84 460

statement ok
ALTER TABLE inv_main_2929 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_84';

query IT
SELECT item_id, wh_code FROM inv_main_2929 WHERE item_id = 3;
----
3 WH_84

statement ok
DROP VIEW vw_inv_2929;

statement ok
DROP TABLE #inv_delta_2929;

statement ok
DROP TABLE inv_main_2929;
