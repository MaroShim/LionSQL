# test/slt_proc/dml_ddl_schema/2857_merge_check_view_temp_ddl_012.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (12)

statement ok
CREATE TABLE inv_main_2857 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 60 CHECK (qty >= 60)
);

statement ok
INSERT INTO inv_main_2857 (item_id, sku, qty) VALUES (1, 'SKU_A_12', 70), (2, 'SKU_B_12', 85);

statement error
INSERT INTO inv_main_2857 (item_id, sku, qty) VALUES (9, 'SKU_BAD_12', 59);

statement ok
INSERT INTO inv_main_2857 (item_id, sku) VALUES (3, 'SKU_DEF_12');

statement ok
CREATE TABLE #inv_delta_2857 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2857 VALUES (2, 'SKU_B_12', 5), (4, 'SKU_D_12', 100);

statement ok
MERGE inv_main_2857 AS t
USING #inv_delta_2857 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2857 AS
SELECT item_id, sku, qty FROM inv_main_2857 WHERE qty > 60;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2857 ORDER BY item_id;
----
1 SKU_A_12 70
2 SKU_B_12 90
4 SKU_D_12 100

statement ok
ALTER TABLE inv_main_2857 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_12';

query IT
SELECT item_id, wh_code FROM inv_main_2857 WHERE item_id = 3;
----
3 WH_12

statement ok
DROP VIEW vw_inv_2857;

statement ok
DROP TABLE #inv_delta_2857;

statement ok
DROP TABLE inv_main_2857;
