# test/slt_proc/dml_ddl_schema/993_check_triggers_views_catalog_18.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (18)

statement ok
CREATE TABLE acct_993 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 180 CHECK (balance >= 180)
);

statement ok
CREATE VIEW vw_acct_high_993 AS
SELECT id, owner, balance FROM acct_993 WHERE balance > 180;

statement ok
INSERT INTO acct_993 (id, owner, balance) VALUES (1, 'UserA_18', 230), (2, 'UserB_18', 300);

statement error
INSERT INTO acct_993 (id, owner, balance) VALUES (3, 'BadUser_18', 175);

statement error
UPDATE acct_993 SET balance = 175 WHERE id = 1;

statement ok
INSERT INTO acct_993 (id, owner) VALUES (4, 'DefaultUser_18');

query ITI
SELECT id, owner, balance FROM acct_993 ORDER BY id;
----
1 UserA_18 230
2 UserB_18 300
4 DefaultUser_18 180

query II
SELECT id, balance FROM vw_acct_high_993 ORDER BY id;
----
1 230
2 300

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_993';
----
vw_acct_high_993

statement ok
DROP VIEW vw_acct_high_993;

statement ok
DROP TABLE acct_993;
