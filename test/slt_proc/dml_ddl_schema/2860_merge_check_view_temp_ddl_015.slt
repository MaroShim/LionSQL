# test/slt_proc/dml_ddl_schema/2860_merge_check_view_temp_ddl_015.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (15)

statement ok
CREATE TABLE inv_main_2860 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 75 CHECK (qty >= 75)
);

statement ok
INSERT INTO inv_main_2860 (item_id, sku, qty) VALUES (1, 'SKU_A_15', 85), (2, 'SKU_B_15', 100);

statement error
INSERT INTO inv_main_2860 (item_id, sku, qty) VALUES (9, 'SKU_BAD_15', 74);

statement ok
INSERT INTO inv_main_2860 (item_id, sku) VALUES (3, 'SKU_DEF_15');

statement ok
CREATE TABLE #inv_delta_2860 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2860 VALUES (2, 'SKU_B_15', 5), (4, 'SKU_D_15', 115);

statement ok
MERGE inv_main_2860 AS t
USING #inv_delta_2860 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2860 AS
SELECT item_id, sku, qty FROM inv_main_2860 WHERE qty > 75;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2860 ORDER BY item_id;
----
1 SKU_A_15 85
2 SKU_B_15 105
4 SKU_D_15 115

statement ok
ALTER TABLE inv_main_2860 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_15';

query IT
SELECT item_id, wh_code FROM inv_main_2860 WHERE item_id = 3;
----
3 WH_15

statement ok
DROP VIEW vw_inv_2860;

statement ok
DROP TABLE #inv_delta_2860;

statement ok
DROP TABLE inv_main_2860;
