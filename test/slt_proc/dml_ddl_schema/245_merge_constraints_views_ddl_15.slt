# test/slt_proc/dml_ddl_schema/245_merge_constraints_views_ddl_15.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (15)

statement ok
CREATE TABLE m_tgt_245 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1500 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_245 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_245 (sku, code, qty) VALUES (1, 'A_15', 75), (2, 'B_15', 150);

statement ok
INSERT INTO m_src_245 VALUES (2, 'B_15', 30), (3, 'C_15', 225);

statement error
INSERT INTO m_tgt_245 (sku, code, qty) VALUES (9, 'NEG_15', -5);

statement ok
MERGE m_tgt_245 AS t
USING m_src_245 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_245 ORDER BY sku;
----
1 A_15 75
2 B_15 180
3 C_15 225

query II
SELECT TOP 2 sku, qty FROM m_tgt_245 ORDER BY sku DESC;
----
3 225
2 180

statement ok
ALTER TABLE m_tgt_245 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_245 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_245;

statement ok
DROP TABLE m_tgt_245;
