# test/slt_proc/dml_ddl_schema/2938_merge_check_view_temp_ddl_093.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (93)

statement ok
CREATE TABLE inv_main_2938 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 465 CHECK (qty >= 465)
);

statement ok
INSERT INTO inv_main_2938 (item_id, sku, qty) VALUES (1, 'SKU_A_93', 475), (2, 'SKU_B_93', 490);

statement error
INSERT INTO inv_main_2938 (item_id, sku, qty) VALUES (9, 'SKU_BAD_93', 464);

statement ok
INSERT INTO inv_main_2938 (item_id, sku) VALUES (3, 'SKU_DEF_93');

statement ok
CREATE TABLE #inv_delta_2938 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2938 VALUES (2, 'SKU_B_93', 5), (4, 'SKU_D_93', 505);

statement ok
MERGE inv_main_2938 AS t
USING #inv_delta_2938 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2938 AS
SELECT item_id, sku, qty FROM inv_main_2938 WHERE qty > 465;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2938 ORDER BY item_id;
----
1 SKU_A_93 475
2 SKU_B_93 495
4 SKU_D_93 505

statement ok
ALTER TABLE inv_main_2938 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_93';

query IT
SELECT item_id, wh_code FROM inv_main_2938 WHERE item_id = 3;
----
3 WH_93

statement ok
DROP VIEW vw_inv_2938;

statement ok
DROP TABLE #inv_delta_2938;

statement ok
DROP TABLE inv_main_2938;
