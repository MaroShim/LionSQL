# test/slt_proc/dml_ddl_schema/2916_merge_check_view_temp_ddl_071.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (71)

statement ok
CREATE TABLE inv_main_2916 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 355 CHECK (qty >= 355)
);

statement ok
INSERT INTO inv_main_2916 (item_id, sku, qty) VALUES (1, 'SKU_A_71', 365), (2, 'SKU_B_71', 380);

statement error
INSERT INTO inv_main_2916 (item_id, sku, qty) VALUES (9, 'SKU_BAD_71', 354);

statement ok
INSERT INTO inv_main_2916 (item_id, sku) VALUES (3, 'SKU_DEF_71');

statement ok
CREATE TABLE #inv_delta_2916 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2916 VALUES (2, 'SKU_B_71', 5), (4, 'SKU_D_71', 395);

statement ok
MERGE inv_main_2916 AS t
USING #inv_delta_2916 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2916 AS
SELECT item_id, sku, qty FROM inv_main_2916 WHERE qty > 355;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2916 ORDER BY item_id;
----
1 SKU_A_71 365
2 SKU_B_71 385
4 SKU_D_71 395

statement ok
ALTER TABLE inv_main_2916 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_71';

query IT
SELECT item_id, wh_code FROM inv_main_2916 WHERE item_id = 3;
----
3 WH_71

statement ok
DROP VIEW vw_inv_2916;

statement ok
DROP TABLE #inv_delta_2916;

statement ok
DROP TABLE inv_main_2916;
