# test/slt_proc/dml_ddl_schema/987_check_triggers_views_catalog_12.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (12)

statement ok
CREATE TABLE acct_987 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 120 CHECK (balance >= 120)
);

statement ok
CREATE VIEW vw_acct_high_987 AS
SELECT id, owner, balance FROM acct_987 WHERE balance > 120;

statement ok
INSERT INTO acct_987 (id, owner, balance) VALUES (1, 'UserA_12', 170), (2, 'UserB_12', 240);

statement error
INSERT INTO acct_987 (id, owner, balance) VALUES (3, 'BadUser_12', 115);

statement error
UPDATE acct_987 SET balance = 115 WHERE id = 1;

statement ok
INSERT INTO acct_987 (id, owner) VALUES (4, 'DefaultUser_12');

query ITI
SELECT id, owner, balance FROM acct_987 ORDER BY id;
----
1 UserA_12 170
2 UserB_12 240
4 DefaultUser_12 120

query II
SELECT id, balance FROM vw_acct_high_987 ORDER BY id;
----
1 170
2 240

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_987';
----
vw_acct_high_987

statement ok
DROP VIEW vw_acct_high_987;

statement ok
DROP TABLE acct_987;
