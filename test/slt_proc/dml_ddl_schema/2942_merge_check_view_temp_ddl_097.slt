# test/slt_proc/dml_ddl_schema/2942_merge_check_view_temp_ddl_097.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (97)

statement ok
CREATE TABLE inv_main_2942 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 485 CHECK (qty >= 485)
);

statement ok
INSERT INTO inv_main_2942 (item_id, sku, qty) VALUES (1, 'SKU_A_97', 495), (2, 'SKU_B_97', 510);

statement error
INSERT INTO inv_main_2942 (item_id, sku, qty) VALUES (9, 'SKU_BAD_97', 484);

statement ok
INSERT INTO inv_main_2942 (item_id, sku) VALUES (3, 'SKU_DEF_97');

statement ok
CREATE TABLE #inv_delta_2942 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2942 VALUES (2, 'SKU_B_97', 5), (4, 'SKU_D_97', 525);

statement ok
MERGE inv_main_2942 AS t
USING #inv_delta_2942 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2942 AS
SELECT item_id, sku, qty FROM inv_main_2942 WHERE qty > 485;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2942 ORDER BY item_id;
----
1 SKU_A_97 495
2 SKU_B_97 515
4 SKU_D_97 525

statement ok
ALTER TABLE inv_main_2942 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_97';

query IT
SELECT item_id, wh_code FROM inv_main_2942 WHERE item_id = 3;
----
3 WH_97

statement ok
DROP VIEW vw_inv_2942;

statement ok
DROP TABLE #inv_delta_2942;

statement ok
DROP TABLE inv_main_2942;
