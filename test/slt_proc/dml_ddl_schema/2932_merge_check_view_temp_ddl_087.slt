# test/slt_proc/dml_ddl_schema/2932_merge_check_view_temp_ddl_087.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (87)

statement ok
CREATE TABLE inv_main_2932 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 435 CHECK (qty >= 435)
);

statement ok
INSERT INTO inv_main_2932 (item_id, sku, qty) VALUES (1, 'SKU_A_87', 445), (2, 'SKU_B_87', 460);

statement error
INSERT INTO inv_main_2932 (item_id, sku, qty) VALUES (9, 'SKU_BAD_87', 434);

statement ok
INSERT INTO inv_main_2932 (item_id, sku) VALUES (3, 'SKU_DEF_87');

statement ok
CREATE TABLE #inv_delta_2932 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2932 VALUES (2, 'SKU_B_87', 5), (4, 'SKU_D_87', 475);

statement ok
MERGE inv_main_2932 AS t
USING #inv_delta_2932 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2932 AS
SELECT item_id, sku, qty FROM inv_main_2932 WHERE qty > 435;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2932 ORDER BY item_id;
----
1 SKU_A_87 445
2 SKU_B_87 465
4 SKU_D_87 475

statement ok
ALTER TABLE inv_main_2932 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_87';

query IT
SELECT item_id, wh_code FROM inv_main_2932 WHERE item_id = 3;
----
3 WH_87

statement ok
DROP VIEW vw_inv_2932;

statement ok
DROP TABLE #inv_delta_2932;

statement ok
DROP TABLE inv_main_2932;
