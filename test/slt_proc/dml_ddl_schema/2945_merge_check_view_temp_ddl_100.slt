# test/slt_proc/dml_ddl_schema/2945_merge_check_view_temp_ddl_100.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (100)

statement ok
CREATE TABLE inv_main_2945 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 500 CHECK (qty >= 500)
);

statement ok
INSERT INTO inv_main_2945 (item_id, sku, qty) VALUES (1, 'SKU_A_100', 510), (2, 'SKU_B_100', 525);

statement error
INSERT INTO inv_main_2945 (item_id, sku, qty) VALUES (9, 'SKU_BAD_100', 499);

statement ok
INSERT INTO inv_main_2945 (item_id, sku) VALUES (3, 'SKU_DEF_100');

statement ok
CREATE TABLE #inv_delta_2945 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2945 VALUES (2, 'SKU_B_100', 5), (4, 'SKU_D_100', 540);

statement ok
MERGE inv_main_2945 AS t
USING #inv_delta_2945 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2945 AS
SELECT item_id, sku, qty FROM inv_main_2945 WHERE qty > 500;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2945 ORDER BY item_id;
----
1 SKU_A_100 510
2 SKU_B_100 530
4 SKU_D_100 540

statement ok
ALTER TABLE inv_main_2945 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_100';

query IT
SELECT item_id, wh_code FROM inv_main_2945 WHERE item_id = 3;
----
3 WH_100

statement ok
DROP VIEW vw_inv_2945;

statement ok
DROP TABLE #inv_delta_2945;

statement ok
DROP TABLE inv_main_2945;
