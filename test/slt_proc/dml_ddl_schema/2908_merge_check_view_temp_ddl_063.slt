# test/slt_proc/dml_ddl_schema/2908_merge_check_view_temp_ddl_063.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (63)

statement ok
CREATE TABLE inv_main_2908 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 315 CHECK (qty >= 315)
);

statement ok
INSERT INTO inv_main_2908 (item_id, sku, qty) VALUES (1, 'SKU_A_63', 325), (2, 'SKU_B_63', 340);

statement error
INSERT INTO inv_main_2908 (item_id, sku, qty) VALUES (9, 'SKU_BAD_63', 314);

statement ok
INSERT INTO inv_main_2908 (item_id, sku) VALUES (3, 'SKU_DEF_63');

statement ok
CREATE TABLE #inv_delta_2908 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2908 VALUES (2, 'SKU_B_63', 5), (4, 'SKU_D_63', 355);

statement ok
MERGE inv_main_2908 AS t
USING #inv_delta_2908 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2908 AS
SELECT item_id, sku, qty FROM inv_main_2908 WHERE qty > 315;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2908 ORDER BY item_id;
----
1 SKU_A_63 325
2 SKU_B_63 345
4 SKU_D_63 355

statement ok
ALTER TABLE inv_main_2908 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_63';

query IT
SELECT item_id, wh_code FROM inv_main_2908 WHERE item_id = 3;
----
3 WH_63

statement ok
DROP VIEW vw_inv_2908;

statement ok
DROP TABLE #inv_delta_2908;

statement ok
DROP TABLE inv_main_2908;
