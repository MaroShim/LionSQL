# test/slt_proc/dml_ddl_schema/247_merge_constraints_views_ddl_17.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (17)

statement ok
CREATE TABLE m_tgt_247 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1700 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_247 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_247 (sku, code, qty) VALUES (1, 'A_17', 85), (2, 'B_17', 170);

statement ok
INSERT INTO m_src_247 VALUES (2, 'B_17', 34), (3, 'C_17', 255);

statement error
INSERT INTO m_tgt_247 (sku, code, qty) VALUES (9, 'NEG_17', -5);

statement ok
MERGE m_tgt_247 AS t
USING m_src_247 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_247 ORDER BY sku;
----
1 A_17 85
2 B_17 204
3 C_17 255

query II
SELECT TOP 2 sku, qty FROM m_tgt_247 ORDER BY sku DESC;
----
3 255
2 204

statement ok
ALTER TABLE m_tgt_247 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_247 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_247;

statement ok
DROP TABLE m_tgt_247;
