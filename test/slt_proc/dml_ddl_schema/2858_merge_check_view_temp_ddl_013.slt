# test/slt_proc/dml_ddl_schema/2858_merge_check_view_temp_ddl_013.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (13)

statement ok
CREATE TABLE inv_main_2858 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 65 CHECK (qty >= 65)
);

statement ok
INSERT INTO inv_main_2858 (item_id, sku, qty) VALUES (1, 'SKU_A_13', 75), (2, 'SKU_B_13', 90);

statement error
INSERT INTO inv_main_2858 (item_id, sku, qty) VALUES (9, 'SKU_BAD_13', 64);

statement ok
INSERT INTO inv_main_2858 (item_id, sku) VALUES (3, 'SKU_DEF_13');

statement ok
CREATE TABLE #inv_delta_2858 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2858 VALUES (2, 'SKU_B_13', 5), (4, 'SKU_D_13', 105);

statement ok
MERGE inv_main_2858 AS t
USING #inv_delta_2858 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2858 AS
SELECT item_id, sku, qty FROM inv_main_2858 WHERE qty > 65;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2858 ORDER BY item_id;
----
1 SKU_A_13 75
2 SKU_B_13 95
4 SKU_D_13 105

statement ok
ALTER TABLE inv_main_2858 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_13';

query IT
SELECT item_id, wh_code FROM inv_main_2858 WHERE item_id = 3;
----
3 WH_13

statement ok
DROP VIEW vw_inv_2858;

statement ok
DROP TABLE #inv_delta_2858;

statement ok
DROP TABLE inv_main_2858;
