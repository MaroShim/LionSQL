# test/slt_proc/dml_ddl_schema/2994_merge_check_view_temp_ddl_149.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (149)

statement ok
CREATE TABLE inv_main_2994 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 745 CHECK (qty >= 745)
);

statement ok
INSERT INTO inv_main_2994 (item_id, sku, qty) VALUES (1, 'SKU_A_149', 755), (2, 'SKU_B_149', 770);

statement error
INSERT INTO inv_main_2994 (item_id, sku, qty) VALUES (9, 'SKU_BAD_149', 744);

statement ok
INSERT INTO inv_main_2994 (item_id, sku) VALUES (3, 'SKU_DEF_149');

statement ok
CREATE TABLE #inv_delta_2994 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2994 VALUES (2, 'SKU_B_149', 5), (4, 'SKU_D_149', 785);

statement ok
MERGE inv_main_2994 AS t
USING #inv_delta_2994 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2994 AS
SELECT item_id, sku, qty FROM inv_main_2994 WHERE qty > 745;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2994 ORDER BY item_id;
----
1 SKU_A_149 755
2 SKU_B_149 775
4 SKU_D_149 785

statement ok
ALTER TABLE inv_main_2994 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_149';

query IT
SELECT item_id, wh_code FROM inv_main_2994 WHERE item_id = 3;
----
3 WH_149

statement ok
DROP VIEW vw_inv_2994;

statement ok
DROP TABLE #inv_delta_2994;

statement ok
DROP TABLE inv_main_2994;
