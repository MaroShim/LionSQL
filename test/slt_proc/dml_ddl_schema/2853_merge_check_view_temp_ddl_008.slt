# test/slt_proc/dml_ddl_schema/2853_merge_check_view_temp_ddl_008.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (8)

statement ok
CREATE TABLE inv_main_2853 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 40 CHECK (qty >= 40)
);

statement ok
INSERT INTO inv_main_2853 (item_id, sku, qty) VALUES (1, 'SKU_A_8', 50), (2, 'SKU_B_8', 65);

statement error
INSERT INTO inv_main_2853 (item_id, sku, qty) VALUES (9, 'SKU_BAD_8', 39);

statement ok
INSERT INTO inv_main_2853 (item_id, sku) VALUES (3, 'SKU_DEF_8');

statement ok
CREATE TABLE #inv_delta_2853 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2853 VALUES (2, 'SKU_B_8', 5), (4, 'SKU_D_8', 80);

statement ok
MERGE inv_main_2853 AS t
USING #inv_delta_2853 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2853 AS
SELECT item_id, sku, qty FROM inv_main_2853 WHERE qty > 40;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2853 ORDER BY item_id;
----
1 SKU_A_8 50
2 SKU_B_8 70
4 SKU_D_8 80

statement ok
ALTER TABLE inv_main_2853 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_8';

query IT
SELECT item_id, wh_code FROM inv_main_2853 WHERE item_id = 3;
----
3 WH_8

statement ok
DROP VIEW vw_inv_2853;

statement ok
DROP TABLE #inv_delta_2853;

statement ok
DROP TABLE inv_main_2853;
