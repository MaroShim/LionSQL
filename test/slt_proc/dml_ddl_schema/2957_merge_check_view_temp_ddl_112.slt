# test/slt_proc/dml_ddl_schema/2957_merge_check_view_temp_ddl_112.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (112)

statement ok
CREATE TABLE inv_main_2957 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 560 CHECK (qty >= 560)
);

statement ok
INSERT INTO inv_main_2957 (item_id, sku, qty) VALUES (1, 'SKU_A_112', 570), (2, 'SKU_B_112', 585);

statement error
INSERT INTO inv_main_2957 (item_id, sku, qty) VALUES (9, 'SKU_BAD_112', 559);

statement ok
INSERT INTO inv_main_2957 (item_id, sku) VALUES (3, 'SKU_DEF_112');

statement ok
CREATE TABLE #inv_delta_2957 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2957 VALUES (2, 'SKU_B_112', 5), (4, 'SKU_D_112', 600);

statement ok
MERGE inv_main_2957 AS t
USING #inv_delta_2957 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2957 AS
SELECT item_id, sku, qty FROM inv_main_2957 WHERE qty > 560;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2957 ORDER BY item_id;
----
1 SKU_A_112 570
2 SKU_B_112 590
4 SKU_D_112 600

statement ok
ALTER TABLE inv_main_2957 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_112';

query IT
SELECT item_id, wh_code FROM inv_main_2957 WHERE item_id = 3;
----
3 WH_112

statement ok
DROP VIEW vw_inv_2957;

statement ok
DROP TABLE #inv_delta_2957;

statement ok
DROP TABLE inv_main_2957;
