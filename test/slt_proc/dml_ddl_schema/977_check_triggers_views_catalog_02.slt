# test/slt_proc/dml_ddl_schema/977_check_triggers_views_catalog_02.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (2)

statement ok
CREATE TABLE acct_977 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 20 CHECK (balance >= 20)
);

statement ok
CREATE VIEW vw_acct_high_977 AS
SELECT id, owner, balance FROM acct_977 WHERE balance > 20;

statement ok
INSERT INTO acct_977 (id, owner, balance) VALUES (1, 'UserA_2', 70), (2, 'UserB_2', 140);

statement error
INSERT INTO acct_977 (id, owner, balance) VALUES (3, 'BadUser_2', 15);

statement error
UPDATE acct_977 SET balance = 15 WHERE id = 1;

statement ok
INSERT INTO acct_977 (id, owner) VALUES (4, 'DefaultUser_2');

query ITI
SELECT id, owner, balance FROM acct_977 ORDER BY id;
----
1 UserA_2 70
2 UserB_2 140
4 DefaultUser_2 20

query II
SELECT id, balance FROM vw_acct_high_977 ORDER BY id;
----
1 70
2 140

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_977';
----
vw_acct_high_977

statement ok
DROP VIEW vw_acct_high_977;

statement ok
DROP TABLE acct_977;
