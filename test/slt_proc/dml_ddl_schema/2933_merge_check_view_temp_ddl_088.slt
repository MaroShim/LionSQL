# test/slt_proc/dml_ddl_schema/2933_merge_check_view_temp_ddl_088.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (88)

statement ok
CREATE TABLE inv_main_2933 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 440 CHECK (qty >= 440)
);

statement ok
INSERT INTO inv_main_2933 (item_id, sku, qty) VALUES (1, 'SKU_A_88', 450), (2, 'SKU_B_88', 465);

statement error
INSERT INTO inv_main_2933 (item_id, sku, qty) VALUES (9, 'SKU_BAD_88', 439);

statement ok
INSERT INTO inv_main_2933 (item_id, sku) VALUES (3, 'SKU_DEF_88');

statement ok
CREATE TABLE #inv_delta_2933 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2933 VALUES (2, 'SKU_B_88', 5), (4, 'SKU_D_88', 480);

statement ok
MERGE inv_main_2933 AS t
USING #inv_delta_2933 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2933 AS
SELECT item_id, sku, qty FROM inv_main_2933 WHERE qty > 440;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2933 ORDER BY item_id;
----
1 SKU_A_88 450
2 SKU_B_88 470
4 SKU_D_88 480

statement ok
ALTER TABLE inv_main_2933 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_88';

query IT
SELECT item_id, wh_code FROM inv_main_2933 WHERE item_id = 3;
----
3 WH_88

statement ok
DROP VIEW vw_inv_2933;

statement ok
DROP TABLE #inv_delta_2933;

statement ok
DROP TABLE inv_main_2933;
