# test/slt_proc/dml_ddl_schema/2859_merge_check_view_temp_ddl_014.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (14)

statement ok
CREATE TABLE inv_main_2859 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 70 CHECK (qty >= 70)
);

statement ok
INSERT INTO inv_main_2859 (item_id, sku, qty) VALUES (1, 'SKU_A_14', 80), (2, 'SKU_B_14', 95);

statement error
INSERT INTO inv_main_2859 (item_id, sku, qty) VALUES (9, 'SKU_BAD_14', 69);

statement ok
INSERT INTO inv_main_2859 (item_id, sku) VALUES (3, 'SKU_DEF_14');

statement ok
CREATE TABLE #inv_delta_2859 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2859 VALUES (2, 'SKU_B_14', 5), (4, 'SKU_D_14', 110);

statement ok
MERGE inv_main_2859 AS t
USING #inv_delta_2859 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2859 AS
SELECT item_id, sku, qty FROM inv_main_2859 WHERE qty > 70;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2859 ORDER BY item_id;
----
1 SKU_A_14 80
2 SKU_B_14 100
4 SKU_D_14 110

statement ok
ALTER TABLE inv_main_2859 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_14';

query IT
SELECT item_id, wh_code FROM inv_main_2859 WHERE item_id = 3;
----
3 WH_14

statement ok
DROP VIEW vw_inv_2859;

statement ok
DROP TABLE #inv_delta_2859;

statement ok
DROP TABLE inv_main_2859;
