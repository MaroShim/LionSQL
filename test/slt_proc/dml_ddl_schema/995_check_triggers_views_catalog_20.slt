# test/slt_proc/dml_ddl_schema/995_check_triggers_views_catalog_20.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (20)

statement ok
CREATE TABLE acct_995 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 200 CHECK (balance >= 200)
);

statement ok
CREATE VIEW vw_acct_high_995 AS
SELECT id, owner, balance FROM acct_995 WHERE balance > 200;

statement ok
INSERT INTO acct_995 (id, owner, balance) VALUES (1, 'UserA_20', 250), (2, 'UserB_20', 320);

statement error
INSERT INTO acct_995 (id, owner, balance) VALUES (3, 'BadUser_20', 195);

statement error
UPDATE acct_995 SET balance = 195 WHERE id = 1;

statement ok
INSERT INTO acct_995 (id, owner) VALUES (4, 'DefaultUser_20');

query ITI
SELECT id, owner, balance FROM acct_995 ORDER BY id;
----
1 UserA_20 250
2 UserB_20 320
4 DefaultUser_20 200

query II
SELECT id, balance FROM vw_acct_high_995 ORDER BY id;
----
1 250
2 320

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_995';
----
vw_acct_high_995

statement ok
DROP VIEW vw_acct_high_995;

statement ok
DROP TABLE acct_995;
