# test/slt_proc/dml_ddl_schema/2847_merge_check_view_temp_ddl_002.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (2)

statement ok
CREATE TABLE inv_main_2847 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 10 CHECK (qty >= 10)
);

statement ok
INSERT INTO inv_main_2847 (item_id, sku, qty) VALUES (1, 'SKU_A_2', 20), (2, 'SKU_B_2', 35);

statement error
INSERT INTO inv_main_2847 (item_id, sku, qty) VALUES (9, 'SKU_BAD_2', 9);

statement ok
INSERT INTO inv_main_2847 (item_id, sku) VALUES (3, 'SKU_DEF_2');

statement ok
CREATE TABLE #inv_delta_2847 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2847 VALUES (2, 'SKU_B_2', 5), (4, 'SKU_D_2', 50);

statement ok
MERGE inv_main_2847 AS t
USING #inv_delta_2847 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2847 AS
SELECT item_id, sku, qty FROM inv_main_2847 WHERE qty > 10;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2847 ORDER BY item_id;
----
1 SKU_A_2 20
2 SKU_B_2 40
4 SKU_D_2 50

statement ok
ALTER TABLE inv_main_2847 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_2';

query IT
SELECT item_id, wh_code FROM inv_main_2847 WHERE item_id = 3;
----
3 WH_2

statement ok
DROP VIEW vw_inv_2847;

statement ok
DROP TABLE #inv_delta_2847;

statement ok
DROP TABLE inv_main_2847;
