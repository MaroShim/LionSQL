# test/slt_proc/dml_ddl_schema/2862_merge_check_view_temp_ddl_017.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (17)

statement ok
CREATE TABLE inv_main_2862 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 85 CHECK (qty >= 85)
);

statement ok
INSERT INTO inv_main_2862 (item_id, sku, qty) VALUES (1, 'SKU_A_17', 95), (2, 'SKU_B_17', 110);

statement error
INSERT INTO inv_main_2862 (item_id, sku, qty) VALUES (9, 'SKU_BAD_17', 84);

statement ok
INSERT INTO inv_main_2862 (item_id, sku) VALUES (3, 'SKU_DEF_17');

statement ok
CREATE TABLE #inv_delta_2862 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2862 VALUES (2, 'SKU_B_17', 5), (4, 'SKU_D_17', 125);

statement ok
MERGE inv_main_2862 AS t
USING #inv_delta_2862 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2862 AS
SELECT item_id, sku, qty FROM inv_main_2862 WHERE qty > 85;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2862 ORDER BY item_id;
----
1 SKU_A_17 95
2 SKU_B_17 115
4 SKU_D_17 125

statement ok
ALTER TABLE inv_main_2862 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_17';

query IT
SELECT item_id, wh_code FROM inv_main_2862 WHERE item_id = 3;
----
3 WH_17

statement ok
DROP VIEW vw_inv_2862;

statement ok
DROP TABLE #inv_delta_2862;

statement ok
DROP TABLE inv_main_2862;
