# test/slt_proc/dml_ddl_schema/243_merge_constraints_views_ddl_13.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (13)

statement ok
CREATE TABLE m_tgt_243 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 1300 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_243 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_243 (sku, code, qty) VALUES (1, 'A_13', 65), (2, 'B_13', 130);

statement ok
INSERT INTO m_src_243 VALUES (2, 'B_13', 26), (3, 'C_13', 195);

statement error
INSERT INTO m_tgt_243 (sku, code, qty) VALUES (9, 'NEG_13', -5);

statement ok
MERGE m_tgt_243 AS t
USING m_src_243 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_243 ORDER BY sku;
----
1 A_13 65
2 B_13 156
3 C_13 195

query II
SELECT TOP 2 sku, qty FROM m_tgt_243 ORDER BY sku DESC;
----
3 195
2 156

statement ok
ALTER TABLE m_tgt_243 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_243 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_243;

statement ok
DROP TABLE m_tgt_243;
