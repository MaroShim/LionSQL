# test/slt_proc/dml_ddl_schema/2861_merge_check_view_temp_ddl_016.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (16)

statement ok
CREATE TABLE inv_main_2861 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 80 CHECK (qty >= 80)
);

statement ok
INSERT INTO inv_main_2861 (item_id, sku, qty) VALUES (1, 'SKU_A_16', 90), (2, 'SKU_B_16', 105);

statement error
INSERT INTO inv_main_2861 (item_id, sku, qty) VALUES (9, 'SKU_BAD_16', 79);

statement ok
INSERT INTO inv_main_2861 (item_id, sku) VALUES (3, 'SKU_DEF_16');

statement ok
CREATE TABLE #inv_delta_2861 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2861 VALUES (2, 'SKU_B_16', 5), (4, 'SKU_D_16', 120);

statement ok
MERGE inv_main_2861 AS t
USING #inv_delta_2861 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2861 AS
SELECT item_id, sku, qty FROM inv_main_2861 WHERE qty > 80;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2861 ORDER BY item_id;
----
1 SKU_A_16 90
2 SKU_B_16 110
4 SKU_D_16 120

statement ok
ALTER TABLE inv_main_2861 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_16';

query IT
SELECT item_id, wh_code FROM inv_main_2861 WHERE item_id = 3;
----
3 WH_16

statement ok
DROP VIEW vw_inv_2861;

statement ok
DROP TABLE #inv_delta_2861;

statement ok
DROP TABLE inv_main_2861;
