# test/slt_proc/dml_ddl_schema/2972_merge_check_view_temp_ddl_127.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (127)

statement ok
CREATE TABLE inv_main_2972 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 635 CHECK (qty >= 635)
);

statement ok
INSERT INTO inv_main_2972 (item_id, sku, qty) VALUES (1, 'SKU_A_127', 645), (2, 'SKU_B_127', 660);

statement error
INSERT INTO inv_main_2972 (item_id, sku, qty) VALUES (9, 'SKU_BAD_127', 634);

statement ok
INSERT INTO inv_main_2972 (item_id, sku) VALUES (3, 'SKU_DEF_127');

statement ok
CREATE TABLE #inv_delta_2972 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2972 VALUES (2, 'SKU_B_127', 5), (4, 'SKU_D_127', 675);

statement ok
MERGE inv_main_2972 AS t
USING #inv_delta_2972 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2972 AS
SELECT item_id, sku, qty FROM inv_main_2972 WHERE qty > 635;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2972 ORDER BY item_id;
----
1 SKU_A_127 645
2 SKU_B_127 665
4 SKU_D_127 675

statement ok
ALTER TABLE inv_main_2972 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_127';

query IT
SELECT item_id, wh_code FROM inv_main_2972 WHERE item_id = 3;
----
3 WH_127

statement ok
DROP VIEW vw_inv_2972;

statement ok
DROP TABLE #inv_delta_2972;

statement ok
DROP TABLE inv_main_2972;
