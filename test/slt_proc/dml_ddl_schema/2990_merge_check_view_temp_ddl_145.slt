# test/slt_proc/dml_ddl_schema/2990_merge_check_view_temp_ddl_145.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (145)

statement ok
CREATE TABLE inv_main_2990 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 725 CHECK (qty >= 725)
);

statement ok
INSERT INTO inv_main_2990 (item_id, sku, qty) VALUES (1, 'SKU_A_145', 735), (2, 'SKU_B_145', 750);

statement error
INSERT INTO inv_main_2990 (item_id, sku, qty) VALUES (9, 'SKU_BAD_145', 724);

statement ok
INSERT INTO inv_main_2990 (item_id, sku) VALUES (3, 'SKU_DEF_145');

statement ok
CREATE TABLE #inv_delta_2990 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2990 VALUES (2, 'SKU_B_145', 5), (4, 'SKU_D_145', 765);

statement ok
MERGE inv_main_2990 AS t
USING #inv_delta_2990 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2990 AS
SELECT item_id, sku, qty FROM inv_main_2990 WHERE qty > 725;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2990 ORDER BY item_id;
----
1 SKU_A_145 735
2 SKU_B_145 755
4 SKU_D_145 765

statement ok
ALTER TABLE inv_main_2990 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_145';

query IT
SELECT item_id, wh_code FROM inv_main_2990 WHERE item_id = 3;
----
3 WH_145

statement ok
DROP VIEW vw_inv_2990;

statement ok
DROP TABLE #inv_delta_2990;

statement ok
DROP TABLE inv_main_2990;
