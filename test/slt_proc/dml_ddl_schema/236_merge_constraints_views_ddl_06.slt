# test/slt_proc/dml_ddl_schema/236_merge_constraints_views_ddl_06.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (6)

statement ok
CREATE TABLE m_tgt_236 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 600 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_236 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_236 (sku, code, qty) VALUES (1, 'A_6', 30), (2, 'B_6', 60);

statement ok
INSERT INTO m_src_236 VALUES (2, 'B_6', 12), (3, 'C_6', 90);

statement error
INSERT INTO m_tgt_236 (sku, code, qty) VALUES (9, 'NEG_6', -5);

statement ok
MERGE m_tgt_236 AS t
USING m_src_236 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_236 ORDER BY sku;
----
1 A_6 30
2 B_6 72
3 C_6 90

query II
SELECT TOP 2 sku, qty FROM m_tgt_236 ORDER BY sku DESC;
----
3 90
2 72

statement ok
ALTER TABLE m_tgt_236 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_236 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_236;

statement ok
DROP TABLE m_tgt_236;
