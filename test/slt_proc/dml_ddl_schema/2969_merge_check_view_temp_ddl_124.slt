# test/slt_proc/dml_ddl_schema/2969_merge_check_view_temp_ddl_124.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (124)

statement ok
CREATE TABLE inv_main_2969 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 620 CHECK (qty >= 620)
);

statement ok
INSERT INTO inv_main_2969 (item_id, sku, qty) VALUES (1, 'SKU_A_124', 630), (2, 'SKU_B_124', 645);

statement error
INSERT INTO inv_main_2969 (item_id, sku, qty) VALUES (9, 'SKU_BAD_124', 619);

statement ok
INSERT INTO inv_main_2969 (item_id, sku) VALUES (3, 'SKU_DEF_124');

statement ok
CREATE TABLE #inv_delta_2969 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2969 VALUES (2, 'SKU_B_124', 5), (4, 'SKU_D_124', 660);

statement ok
MERGE inv_main_2969 AS t
USING #inv_delta_2969 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2969 AS
SELECT item_id, sku, qty FROM inv_main_2969 WHERE qty > 620;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2969 ORDER BY item_id;
----
1 SKU_A_124 630
2 SKU_B_124 650
4 SKU_D_124 660

statement ok
ALTER TABLE inv_main_2969 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_124';

query IT
SELECT item_id, wh_code FROM inv_main_2969 WHERE item_id = 3;
----
3 WH_124

statement ok
DROP VIEW vw_inv_2969;

statement ok
DROP TABLE #inv_delta_2969;

statement ok
DROP TABLE inv_main_2969;
