# test/slt_proc/dml_ddl_schema/2889_merge_check_view_temp_ddl_044.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (44)

statement ok
CREATE TABLE inv_main_2889 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 220 CHECK (qty >= 220)
);

statement ok
INSERT INTO inv_main_2889 (item_id, sku, qty) VALUES (1, 'SKU_A_44', 230), (2, 'SKU_B_44', 245);

statement error
INSERT INTO inv_main_2889 (item_id, sku, qty) VALUES (9, 'SKU_BAD_44', 219);

statement ok
INSERT INTO inv_main_2889 (item_id, sku) VALUES (3, 'SKU_DEF_44');

statement ok
CREATE TABLE #inv_delta_2889 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2889 VALUES (2, 'SKU_B_44', 5), (4, 'SKU_D_44', 260);

statement ok
MERGE inv_main_2889 AS t
USING #inv_delta_2889 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2889 AS
SELECT item_id, sku, qty FROM inv_main_2889 WHERE qty > 220;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2889 ORDER BY item_id;
----
1 SKU_A_44 230
2 SKU_B_44 250
4 SKU_D_44 260

statement ok
ALTER TABLE inv_main_2889 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_44';

query IT
SELECT item_id, wh_code FROM inv_main_2889 WHERE item_id = 3;
----
3 WH_44

statement ok
DROP VIEW vw_inv_2889;

statement ok
DROP TABLE #inv_delta_2889;

statement ok
DROP TABLE inv_main_2889;
