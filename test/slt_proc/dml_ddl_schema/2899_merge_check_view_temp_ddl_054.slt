# test/slt_proc/dml_ddl_schema/2899_merge_check_view_temp_ddl_054.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (54)

statement ok
CREATE TABLE inv_main_2899 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 270 CHECK (qty >= 270)
);

statement ok
INSERT INTO inv_main_2899 (item_id, sku, qty) VALUES (1, 'SKU_A_54', 280), (2, 'SKU_B_54', 295);

statement error
INSERT INTO inv_main_2899 (item_id, sku, qty) VALUES (9, 'SKU_BAD_54', 269);

statement ok
INSERT INTO inv_main_2899 (item_id, sku) VALUES (3, 'SKU_DEF_54');

statement ok
CREATE TABLE #inv_delta_2899 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2899 VALUES (2, 'SKU_B_54', 5), (4, 'SKU_D_54', 310);

statement ok
MERGE inv_main_2899 AS t
USING #inv_delta_2899 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2899 AS
SELECT item_id, sku, qty FROM inv_main_2899 WHERE qty > 270;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2899 ORDER BY item_id;
----
1 SKU_A_54 280
2 SKU_B_54 300
4 SKU_D_54 310

statement ok
ALTER TABLE inv_main_2899 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_54';

query IT
SELECT item_id, wh_code FROM inv_main_2899 WHERE item_id = 3;
----
3 WH_54

statement ok
DROP VIEW vw_inv_2899;

statement ok
DROP TABLE #inv_delta_2899;

statement ok
DROP TABLE inv_main_2899;
