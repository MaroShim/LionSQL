# test/slt_proc/dml_ddl_schema/2956_merge_check_view_temp_ddl_111.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (111)

statement ok
CREATE TABLE inv_main_2956 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 555 CHECK (qty >= 555)
);

statement ok
INSERT INTO inv_main_2956 (item_id, sku, qty) VALUES (1, 'SKU_A_111', 565), (2, 'SKU_B_111', 580);

statement error
INSERT INTO inv_main_2956 (item_id, sku, qty) VALUES (9, 'SKU_BAD_111', 554);

statement ok
INSERT INTO inv_main_2956 (item_id, sku) VALUES (3, 'SKU_DEF_111');

statement ok
CREATE TABLE #inv_delta_2956 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2956 VALUES (2, 'SKU_B_111', 5), (4, 'SKU_D_111', 595);

statement ok
MERGE inv_main_2956 AS t
USING #inv_delta_2956 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2956 AS
SELECT item_id, sku, qty FROM inv_main_2956 WHERE qty > 555;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2956 ORDER BY item_id;
----
1 SKU_A_111 565
2 SKU_B_111 585
4 SKU_D_111 595

statement ok
ALTER TABLE inv_main_2956 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_111';

query IT
SELECT item_id, wh_code FROM inv_main_2956 WHERE item_id = 3;
----
3 WH_111

statement ok
DROP VIEW vw_inv_2956;

statement ok
DROP TABLE #inv_delta_2956;

statement ok
DROP TABLE inv_main_2956;
