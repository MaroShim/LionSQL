# test/slt_proc/dml_ddl_schema/2923_merge_check_view_temp_ddl_078.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (78)

statement ok
CREATE TABLE inv_main_2923 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 390 CHECK (qty >= 390)
);

statement ok
INSERT INTO inv_main_2923 (item_id, sku, qty) VALUES (1, 'SKU_A_78', 400), (2, 'SKU_B_78', 415);

statement error
INSERT INTO inv_main_2923 (item_id, sku, qty) VALUES (9, 'SKU_BAD_78', 389);

statement ok
INSERT INTO inv_main_2923 (item_id, sku) VALUES (3, 'SKU_DEF_78');

statement ok
CREATE TABLE #inv_delta_2923 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2923 VALUES (2, 'SKU_B_78', 5), (4, 'SKU_D_78', 430);

statement ok
MERGE inv_main_2923 AS t
USING #inv_delta_2923 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2923 AS
SELECT item_id, sku, qty FROM inv_main_2923 WHERE qty > 390;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2923 ORDER BY item_id;
----
1 SKU_A_78 400
2 SKU_B_78 420
4 SKU_D_78 430

statement ok
ALTER TABLE inv_main_2923 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_78';

query IT
SELECT item_id, wh_code FROM inv_main_2923 WHERE item_id = 3;
----
3 WH_78

statement ok
DROP VIEW vw_inv_2923;

statement ok
DROP TABLE #inv_delta_2923;

statement ok
DROP TABLE inv_main_2923;
