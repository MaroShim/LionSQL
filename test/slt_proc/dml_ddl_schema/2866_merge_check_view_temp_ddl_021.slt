# test/slt_proc/dml_ddl_schema/2866_merge_check_view_temp_ddl_021.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (21)

statement ok
CREATE TABLE inv_main_2866 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 105 CHECK (qty >= 105)
);

statement ok
INSERT INTO inv_main_2866 (item_id, sku, qty) VALUES (1, 'SKU_A_21', 115), (2, 'SKU_B_21', 130);

statement error
INSERT INTO inv_main_2866 (item_id, sku, qty) VALUES (9, 'SKU_BAD_21', 104);

statement ok
INSERT INTO inv_main_2866 (item_id, sku) VALUES (3, 'SKU_DEF_21');

statement ok
CREATE TABLE #inv_delta_2866 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2866 VALUES (2, 'SKU_B_21', 5), (4, 'SKU_D_21', 145);

statement ok
MERGE inv_main_2866 AS t
USING #inv_delta_2866 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2866 AS
SELECT item_id, sku, qty FROM inv_main_2866 WHERE qty > 105;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2866 ORDER BY item_id;
----
1 SKU_A_21 115
2 SKU_B_21 135
4 SKU_D_21 145

statement ok
ALTER TABLE inv_main_2866 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_21';

query IT
SELECT item_id, wh_code FROM inv_main_2866 WHERE item_id = 3;
----
3 WH_21

statement ok
DROP VIEW vw_inv_2866;

statement ok
DROP TABLE #inv_delta_2866;

statement ok
DROP TABLE inv_main_2866;
