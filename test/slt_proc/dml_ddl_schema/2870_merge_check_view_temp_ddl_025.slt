# test/slt_proc/dml_ddl_schema/2870_merge_check_view_temp_ddl_025.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (25)

statement ok
CREATE TABLE inv_main_2870 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 125 CHECK (qty >= 125)
);

statement ok
INSERT INTO inv_main_2870 (item_id, sku, qty) VALUES (1, 'SKU_A_25', 135), (2, 'SKU_B_25', 150);

statement error
INSERT INTO inv_main_2870 (item_id, sku, qty) VALUES (9, 'SKU_BAD_25', 124);

statement ok
INSERT INTO inv_main_2870 (item_id, sku) VALUES (3, 'SKU_DEF_25');

statement ok
CREATE TABLE #inv_delta_2870 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2870 VALUES (2, 'SKU_B_25', 5), (4, 'SKU_D_25', 165);

statement ok
MERGE inv_main_2870 AS t
USING #inv_delta_2870 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2870 AS
SELECT item_id, sku, qty FROM inv_main_2870 WHERE qty > 125;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2870 ORDER BY item_id;
----
1 SKU_A_25 135
2 SKU_B_25 155
4 SKU_D_25 165

statement ok
ALTER TABLE inv_main_2870 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_25';

query IT
SELECT item_id, wh_code FROM inv_main_2870 WHERE item_id = 3;
----
3 WH_25

statement ok
DROP VIEW vw_inv_2870;

statement ok
DROP TABLE #inv_delta_2870;

statement ok
DROP TABLE inv_main_2870;
