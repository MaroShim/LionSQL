# test/slt_proc/dml_ddl_schema/237_merge_constraints_views_ddl_07.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (7)

statement ok
CREATE TABLE m_tgt_237 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 700 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_237 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_237 (sku, code, qty) VALUES (1, 'A_7', 35), (2, 'B_7', 70);

statement ok
INSERT INTO m_src_237 VALUES (2, 'B_7', 14), (3, 'C_7', 105);

statement error
INSERT INTO m_tgt_237 (sku, code, qty) VALUES (9, 'NEG_7', -5);

statement ok
MERGE m_tgt_237 AS t
USING m_src_237 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_237 ORDER BY sku;
----
1 A_7 35
2 B_7 84
3 C_7 105

query II
SELECT TOP 2 sku, qty FROM m_tgt_237 ORDER BY sku DESC;
----
3 105
2 84

statement ok
ALTER TABLE m_tgt_237 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_237 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_237;

statement ok
DROP TABLE m_tgt_237;
