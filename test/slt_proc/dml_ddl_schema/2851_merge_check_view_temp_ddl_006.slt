# test/slt_proc/dml_ddl_schema/2851_merge_check_view_temp_ddl_006.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (6)

statement ok
CREATE TABLE inv_main_2851 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 30 CHECK (qty >= 30)
);

statement ok
INSERT INTO inv_main_2851 (item_id, sku, qty) VALUES (1, 'SKU_A_6', 40), (2, 'SKU_B_6', 55);

statement error
INSERT INTO inv_main_2851 (item_id, sku, qty) VALUES (9, 'SKU_BAD_6', 29);

statement ok
INSERT INTO inv_main_2851 (item_id, sku) VALUES (3, 'SKU_DEF_6');

statement ok
CREATE TABLE #inv_delta_2851 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2851 VALUES (2, 'SKU_B_6', 5), (4, 'SKU_D_6', 70);

statement ok
MERGE inv_main_2851 AS t
USING #inv_delta_2851 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2851 AS
SELECT item_id, sku, qty FROM inv_main_2851 WHERE qty > 30;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2851 ORDER BY item_id;
----
1 SKU_A_6 40
2 SKU_B_6 60
4 SKU_D_6 70

statement ok
ALTER TABLE inv_main_2851 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_6';

query IT
SELECT item_id, wh_code FROM inv_main_2851 WHERE item_id = 3;
----
3 WH_6

statement ok
DROP VIEW vw_inv_2851;

statement ok
DROP TABLE #inv_delta_2851;

statement ok
DROP TABLE inv_main_2851;
