# test/slt_proc/dml_ddl_schema/1000_check_triggers_views_catalog_25.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (25)

statement ok
CREATE TABLE acct_1000 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 250 CHECK (balance >= 250)
);

statement ok
CREATE VIEW vw_acct_high_1000 AS
SELECT id, owner, balance FROM acct_1000 WHERE balance > 250;

statement ok
INSERT INTO acct_1000 (id, owner, balance) VALUES (1, 'UserA_25', 300), (2, 'UserB_25', 370);

statement error
INSERT INTO acct_1000 (id, owner, balance) VALUES (3, 'BadUser_25', 245);

statement error
UPDATE acct_1000 SET balance = 245 WHERE id = 1;

statement ok
INSERT INTO acct_1000 (id, owner) VALUES (4, 'DefaultUser_25');

query ITI
SELECT id, owner, balance FROM acct_1000 ORDER BY id;
----
1 UserA_25 300
2 UserB_25 370
4 DefaultUser_25 250

query II
SELECT id, balance FROM vw_acct_high_1000 ORDER BY id;
----
1 300
2 370

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_1000';
----
vw_acct_high_1000

statement ok
DROP VIEW vw_acct_high_1000;

statement ok
DROP TABLE acct_1000;
