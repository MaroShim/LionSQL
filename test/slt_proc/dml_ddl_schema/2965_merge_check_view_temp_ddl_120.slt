# test/slt_proc/dml_ddl_schema/2965_merge_check_view_temp_ddl_120.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (120)

statement ok
CREATE TABLE inv_main_2965 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 600 CHECK (qty >= 600)
);

statement ok
INSERT INTO inv_main_2965 (item_id, sku, qty) VALUES (1, 'SKU_A_120', 610), (2, 'SKU_B_120', 625);

statement error
INSERT INTO inv_main_2965 (item_id, sku, qty) VALUES (9, 'SKU_BAD_120', 599);

statement ok
INSERT INTO inv_main_2965 (item_id, sku) VALUES (3, 'SKU_DEF_120');

statement ok
CREATE TABLE #inv_delta_2965 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2965 VALUES (2, 'SKU_B_120', 5), (4, 'SKU_D_120', 640);

statement ok
MERGE inv_main_2965 AS t
USING #inv_delta_2965 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2965 AS
SELECT item_id, sku, qty FROM inv_main_2965 WHERE qty > 600;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2965 ORDER BY item_id;
----
1 SKU_A_120 610
2 SKU_B_120 630
4 SKU_D_120 640

statement ok
ALTER TABLE inv_main_2965 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_120';

query IT
SELECT item_id, wh_code FROM inv_main_2965 WHERE item_id = 3;
----
3 WH_120

statement ok
DROP VIEW vw_inv_2965;

statement ok
DROP TABLE #inv_delta_2965;

statement ok
DROP TABLE inv_main_2965;
