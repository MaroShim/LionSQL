# test/slt_proc/dml_ddl_schema/2915_merge_check_view_temp_ddl_070.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (70)

statement ok
CREATE TABLE inv_main_2915 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 350 CHECK (qty >= 350)
);

statement ok
INSERT INTO inv_main_2915 (item_id, sku, qty) VALUES (1, 'SKU_A_70', 360), (2, 'SKU_B_70', 375);

statement error
INSERT INTO inv_main_2915 (item_id, sku, qty) VALUES (9, 'SKU_BAD_70', 349);

statement ok
INSERT INTO inv_main_2915 (item_id, sku) VALUES (3, 'SKU_DEF_70');

statement ok
CREATE TABLE #inv_delta_2915 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2915 VALUES (2, 'SKU_B_70', 5), (4, 'SKU_D_70', 390);

statement ok
MERGE inv_main_2915 AS t
USING #inv_delta_2915 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2915 AS
SELECT item_id, sku, qty FROM inv_main_2915 WHERE qty > 350;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2915 ORDER BY item_id;
----
1 SKU_A_70 360
2 SKU_B_70 380
4 SKU_D_70 390

statement ok
ALTER TABLE inv_main_2915 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_70';

query IT
SELECT item_id, wh_code FROM inv_main_2915 WHERE item_id = 3;
----
3 WH_70

statement ok
DROP VIEW vw_inv_2915;

statement ok
DROP TABLE #inv_delta_2915;

statement ok
DROP TABLE inv_main_2915;
