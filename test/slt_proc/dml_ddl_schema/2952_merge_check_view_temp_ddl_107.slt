# test/slt_proc/dml_ddl_schema/2952_merge_check_view_temp_ddl_107.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (107)

statement ok
CREATE TABLE inv_main_2952 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 535 CHECK (qty >= 535)
);

statement ok
INSERT INTO inv_main_2952 (item_id, sku, qty) VALUES (1, 'SKU_A_107', 545), (2, 'SKU_B_107', 560);

statement error
INSERT INTO inv_main_2952 (item_id, sku, qty) VALUES (9, 'SKU_BAD_107', 534);

statement ok
INSERT INTO inv_main_2952 (item_id, sku) VALUES (3, 'SKU_DEF_107');

statement ok
CREATE TABLE #inv_delta_2952 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2952 VALUES (2, 'SKU_B_107', 5), (4, 'SKU_D_107', 575);

statement ok
MERGE inv_main_2952 AS t
USING #inv_delta_2952 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2952 AS
SELECT item_id, sku, qty FROM inv_main_2952 WHERE qty > 535;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2952 ORDER BY item_id;
----
1 SKU_A_107 545
2 SKU_B_107 565
4 SKU_D_107 575

statement ok
ALTER TABLE inv_main_2952 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_107';

query IT
SELECT item_id, wh_code FROM inv_main_2952 WHERE item_id = 3;
----
3 WH_107

statement ok
DROP VIEW vw_inv_2952;

statement ok
DROP TABLE #inv_delta_2952;

statement ok
DROP TABLE inv_main_2952;
