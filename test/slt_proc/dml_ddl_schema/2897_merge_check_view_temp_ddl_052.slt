# test/slt_proc/dml_ddl_schema/2897_merge_check_view_temp_ddl_052.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (52)

statement ok
CREATE TABLE inv_main_2897 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 260 CHECK (qty >= 260)
);

statement ok
INSERT INTO inv_main_2897 (item_id, sku, qty) VALUES (1, 'SKU_A_52', 270), (2, 'SKU_B_52', 285);

statement error
INSERT INTO inv_main_2897 (item_id, sku, qty) VALUES (9, 'SKU_BAD_52', 259);

statement ok
INSERT INTO inv_main_2897 (item_id, sku) VALUES (3, 'SKU_DEF_52');

statement ok
CREATE TABLE #inv_delta_2897 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2897 VALUES (2, 'SKU_B_52', 5), (4, 'SKU_D_52', 300);

statement ok
MERGE inv_main_2897 AS t
USING #inv_delta_2897 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2897 AS
SELECT item_id, sku, qty FROM inv_main_2897 WHERE qty > 260;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2897 ORDER BY item_id;
----
1 SKU_A_52 270
2 SKU_B_52 290
4 SKU_D_52 300

statement ok
ALTER TABLE inv_main_2897 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_52';

query IT
SELECT item_id, wh_code FROM inv_main_2897 WHERE item_id = 3;
----
3 WH_52

statement ok
DROP VIEW vw_inv_2897;

statement ok
DROP TABLE #inv_delta_2897;

statement ok
DROP TABLE inv_main_2897;
