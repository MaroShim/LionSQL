# test/slt_proc/dml_ddl_schema/2878_merge_check_view_temp_ddl_033.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (33)

statement ok
CREATE TABLE inv_main_2878 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 165 CHECK (qty >= 165)
);

statement ok
INSERT INTO inv_main_2878 (item_id, sku, qty) VALUES (1, 'SKU_A_33', 175), (2, 'SKU_B_33', 190);

statement error
INSERT INTO inv_main_2878 (item_id, sku, qty) VALUES (9, 'SKU_BAD_33', 164);

statement ok
INSERT INTO inv_main_2878 (item_id, sku) VALUES (3, 'SKU_DEF_33');

statement ok
CREATE TABLE #inv_delta_2878 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2878 VALUES (2, 'SKU_B_33', 5), (4, 'SKU_D_33', 205);

statement ok
MERGE inv_main_2878 AS t
USING #inv_delta_2878 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2878 AS
SELECT item_id, sku, qty FROM inv_main_2878 WHERE qty > 165;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2878 ORDER BY item_id;
----
1 SKU_A_33 175
2 SKU_B_33 195
4 SKU_D_33 205

statement ok
ALTER TABLE inv_main_2878 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_33';

query IT
SELECT item_id, wh_code FROM inv_main_2878 WHERE item_id = 3;
----
3 WH_33

statement ok
DROP VIEW vw_inv_2878;

statement ok
DROP TABLE #inv_delta_2878;

statement ok
DROP TABLE inv_main_2878;
