# test/slt_proc/dml_ddl_schema/2988_merge_check_view_temp_ddl_143.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (143)

statement ok
CREATE TABLE inv_main_2988 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 715 CHECK (qty >= 715)
);

statement ok
INSERT INTO inv_main_2988 (item_id, sku, qty) VALUES (1, 'SKU_A_143', 725), (2, 'SKU_B_143', 740);

statement error
INSERT INTO inv_main_2988 (item_id, sku, qty) VALUES (9, 'SKU_BAD_143', 714);

statement ok
INSERT INTO inv_main_2988 (item_id, sku) VALUES (3, 'SKU_DEF_143');

statement ok
CREATE TABLE #inv_delta_2988 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2988 VALUES (2, 'SKU_B_143', 5), (4, 'SKU_D_143', 755);

statement ok
MERGE inv_main_2988 AS t
USING #inv_delta_2988 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2988 AS
SELECT item_id, sku, qty FROM inv_main_2988 WHERE qty > 715;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2988 ORDER BY item_id;
----
1 SKU_A_143 725
2 SKU_B_143 745
4 SKU_D_143 755

statement ok
ALTER TABLE inv_main_2988 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_143';

query IT
SELECT item_id, wh_code FROM inv_main_2988 WHERE item_id = 3;
----
3 WH_143

statement ok
DROP VIEW vw_inv_2988;

statement ok
DROP TABLE #inv_delta_2988;

statement ok
DROP TABLE inv_main_2988;
