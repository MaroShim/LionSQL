# test/slt_proc/dml_ddl_schema/2913_merge_check_view_temp_ddl_068.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (68)

statement ok
CREATE TABLE inv_main_2913 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 340 CHECK (qty >= 340)
);

statement ok
INSERT INTO inv_main_2913 (item_id, sku, qty) VALUES (1, 'SKU_A_68', 350), (2, 'SKU_B_68', 365);

statement error
INSERT INTO inv_main_2913 (item_id, sku, qty) VALUES (9, 'SKU_BAD_68', 339);

statement ok
INSERT INTO inv_main_2913 (item_id, sku) VALUES (3, 'SKU_DEF_68');

statement ok
CREATE TABLE #inv_delta_2913 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2913 VALUES (2, 'SKU_B_68', 5), (4, 'SKU_D_68', 380);

statement ok
MERGE inv_main_2913 AS t
USING #inv_delta_2913 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2913 AS
SELECT item_id, sku, qty FROM inv_main_2913 WHERE qty > 340;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2913 ORDER BY item_id;
----
1 SKU_A_68 350
2 SKU_B_68 370
4 SKU_D_68 380

statement ok
ALTER TABLE inv_main_2913 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_68';

query IT
SELECT item_id, wh_code FROM inv_main_2913 WHERE item_id = 3;
----
3 WH_68

statement ok
DROP VIEW vw_inv_2913;

statement ok
DROP TABLE #inv_delta_2913;

statement ok
DROP TABLE inv_main_2913;
