# test/slt_proc/dml_ddl_schema/2995_merge_check_view_temp_ddl_150.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (150)

statement ok
CREATE TABLE inv_main_2995 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 750 CHECK (qty >= 750)
);

statement ok
INSERT INTO inv_main_2995 (item_id, sku, qty) VALUES (1, 'SKU_A_150', 760), (2, 'SKU_B_150', 775);

statement error
INSERT INTO inv_main_2995 (item_id, sku, qty) VALUES (9, 'SKU_BAD_150', 749);

statement ok
INSERT INTO inv_main_2995 (item_id, sku) VALUES (3, 'SKU_DEF_150');

statement ok
CREATE TABLE #inv_delta_2995 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2995 VALUES (2, 'SKU_B_150', 5), (4, 'SKU_D_150', 790);

statement ok
MERGE inv_main_2995 AS t
USING #inv_delta_2995 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2995 AS
SELECT item_id, sku, qty FROM inv_main_2995 WHERE qty > 750;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2995 ORDER BY item_id;
----
1 SKU_A_150 760
2 SKU_B_150 780
4 SKU_D_150 790

statement ok
ALTER TABLE inv_main_2995 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_150';

query IT
SELECT item_id, wh_code FROM inv_main_2995 WHERE item_id = 3;
----
3 WH_150

statement ok
DROP VIEW vw_inv_2995;

statement ok
DROP TABLE #inv_delta_2995;

statement ok
DROP TABLE inv_main_2995;
