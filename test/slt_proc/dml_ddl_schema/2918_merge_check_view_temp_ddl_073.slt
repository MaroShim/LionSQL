# test/slt_proc/dml_ddl_schema/2918_merge_check_view_temp_ddl_073.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (73)

statement ok
CREATE TABLE inv_main_2918 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 365 CHECK (qty >= 365)
);

statement ok
INSERT INTO inv_main_2918 (item_id, sku, qty) VALUES (1, 'SKU_A_73', 375), (2, 'SKU_B_73', 390);

statement error
INSERT INTO inv_main_2918 (item_id, sku, qty) VALUES (9, 'SKU_BAD_73', 364);

statement ok
INSERT INTO inv_main_2918 (item_id, sku) VALUES (3, 'SKU_DEF_73');

statement ok
CREATE TABLE #inv_delta_2918 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2918 VALUES (2, 'SKU_B_73', 5), (4, 'SKU_D_73', 405);

statement ok
MERGE inv_main_2918 AS t
USING #inv_delta_2918 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2918 AS
SELECT item_id, sku, qty FROM inv_main_2918 WHERE qty > 365;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2918 ORDER BY item_id;
----
1 SKU_A_73 375
2 SKU_B_73 395
4 SKU_D_73 405

statement ok
ALTER TABLE inv_main_2918 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_73';

query IT
SELECT item_id, wh_code FROM inv_main_2918 WHERE item_id = 3;
----
3 WH_73

statement ok
DROP VIEW vw_inv_2918;

statement ok
DROP TABLE #inv_delta_2918;

statement ok
DROP TABLE inv_main_2918;
