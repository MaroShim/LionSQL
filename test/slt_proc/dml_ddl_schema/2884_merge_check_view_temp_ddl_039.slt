# test/slt_proc/dml_ddl_schema/2884_merge_check_view_temp_ddl_039.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (39)

statement ok
CREATE TABLE inv_main_2884 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 195 CHECK (qty >= 195)
);

statement ok
INSERT INTO inv_main_2884 (item_id, sku, qty) VALUES (1, 'SKU_A_39', 205), (2, 'SKU_B_39', 220);

statement error
INSERT INTO inv_main_2884 (item_id, sku, qty) VALUES (9, 'SKU_BAD_39', 194);

statement ok
INSERT INTO inv_main_2884 (item_id, sku) VALUES (3, 'SKU_DEF_39');

statement ok
CREATE TABLE #inv_delta_2884 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2884 VALUES (2, 'SKU_B_39', 5), (4, 'SKU_D_39', 235);

statement ok
MERGE inv_main_2884 AS t
USING #inv_delta_2884 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2884 AS
SELECT item_id, sku, qty FROM inv_main_2884 WHERE qty > 195;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2884 ORDER BY item_id;
----
1 SKU_A_39 205
2 SKU_B_39 225
4 SKU_D_39 235

statement ok
ALTER TABLE inv_main_2884 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_39';

query IT
SELECT item_id, wh_code FROM inv_main_2884 WHERE item_id = 3;
----
3 WH_39

statement ok
DROP VIEW vw_inv_2884;

statement ok
DROP TABLE #inv_delta_2884;

statement ok
DROP TABLE inv_main_2884;
