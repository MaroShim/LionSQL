# test/slt_proc/dml_ddl_schema/2928_merge_check_view_temp_ddl_083.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (83)

statement ok
CREATE TABLE inv_main_2928 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 415 CHECK (qty >= 415)
);

statement ok
INSERT INTO inv_main_2928 (item_id, sku, qty) VALUES (1, 'SKU_A_83', 425), (2, 'SKU_B_83', 440);

statement error
INSERT INTO inv_main_2928 (item_id, sku, qty) VALUES (9, 'SKU_BAD_83', 414);

statement ok
INSERT INTO inv_main_2928 (item_id, sku) VALUES (3, 'SKU_DEF_83');

statement ok
CREATE TABLE #inv_delta_2928 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2928 VALUES (2, 'SKU_B_83', 5), (4, 'SKU_D_83', 455);

statement ok
MERGE inv_main_2928 AS t
USING #inv_delta_2928 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2928 AS
SELECT item_id, sku, qty FROM inv_main_2928 WHERE qty > 415;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2928 ORDER BY item_id;
----
1 SKU_A_83 425
2 SKU_B_83 445
4 SKU_D_83 455

statement ok
ALTER TABLE inv_main_2928 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_83';

query IT
SELECT item_id, wh_code FROM inv_main_2928 WHERE item_id = 3;
----
3 WH_83

statement ok
DROP VIEW vw_inv_2928;

statement ok
DROP TABLE #inv_delta_2928;

statement ok
DROP TABLE inv_main_2928;
