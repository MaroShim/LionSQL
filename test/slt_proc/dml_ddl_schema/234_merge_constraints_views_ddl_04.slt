# test/slt_proc/dml_ddl_schema/234_merge_constraints_views_ddl_04.slt
# T-SQL MERGE, TOP, OFFSET/FETCH, Constraints, Views, Tail DDL (4)

statement ok
CREATE TABLE m_tgt_234 (
    sku INT PRIMARY KEY,
    code VARCHAR(20) UNIQUE,
    qty INT DEFAULT 400 CHECK (qty >= 0)
);

statement ok
CREATE TABLE m_src_234 (sku INT PRIMARY KEY, code VARCHAR(20), qty INT);

statement ok
INSERT INTO m_tgt_234 (sku, code, qty) VALUES (1, 'A_4', 20), (2, 'B_4', 40);

statement ok
INSERT INTO m_src_234 VALUES (2, 'B_4', 8), (3, 'C_4', 60);

statement error
INSERT INTO m_tgt_234 (sku, code, qty) VALUES (9, 'NEG_4', -5);

statement ok
MERGE m_tgt_234 AS t
USING m_src_234 AS s ON t.sku = s.sku
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.qty
WHEN NOT MATCHED THEN INSERT (sku, code, qty) VALUES (s.sku, s.code, s.qty);

query ITI
SELECT sku, code, qty FROM m_tgt_234 ORDER BY sku;
----
1 A_4 20
2 B_4 48
3 C_4 60

query II
SELECT TOP 2 sku, qty FROM m_tgt_234 ORDER BY sku DESC;
----
3 60
2 48

statement ok
ALTER TABLE m_tgt_234 ADD COLUMN tag VARCHAR(20) DEFAULT 'OK';

query IT
SELECT sku, tag FROM m_tgt_234 WHERE sku = 1;
----
1 OK

statement ok
DROP TABLE m_src_234;

statement ok
DROP TABLE m_tgt_234;
