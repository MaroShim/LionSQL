# test/slt_proc/dml_ddl_schema/2998_merge_check_view_temp_ddl_153.slt
# T-SQL MERGE, CHECK/DEFAULT constraints, Views, #Temp tables, and Tail ALTER TABLE (153)

statement ok
CREATE TABLE inv_main_2998 (
    item_id INT PRIMARY KEY,
    sku VARCHAR(30) NOT NULL,
    qty INT DEFAULT 765 CHECK (qty >= 765)
);

statement ok
INSERT INTO inv_main_2998 (item_id, sku, qty) VALUES (1, 'SKU_A_153', 775), (2, 'SKU_B_153', 790);

statement error
INSERT INTO inv_main_2998 (item_id, sku, qty) VALUES (9, 'SKU_BAD_153', 764);

statement ok
INSERT INTO inv_main_2998 (item_id, sku) VALUES (3, 'SKU_DEF_153');

statement ok
CREATE TABLE #inv_delta_2998 (item_id INT PRIMARY KEY, sku VARCHAR(30), delta INT);

statement ok
INSERT INTO #inv_delta_2998 VALUES (2, 'SKU_B_153', 5), (4, 'SKU_D_153', 805);

statement ok
MERGE inv_main_2998 AS t
USING #inv_delta_2998 AS s ON t.item_id = s.item_id
WHEN MATCHED THEN UPDATE SET t.qty = t.qty + s.delta
WHEN NOT MATCHED THEN INSERT (item_id, sku, qty) VALUES (s.item_id, s.sku, s.delta);

statement ok
CREATE VIEW vw_inv_2998 AS
SELECT item_id, sku, qty FROM inv_main_2998 WHERE qty > 765;

query ITI
SELECT item_id, sku, qty FROM vw_inv_2998 ORDER BY item_id;
----
1 SKU_A_153 775
2 SKU_B_153 795
4 SKU_D_153 805

statement ok
ALTER TABLE inv_main_2998 ADD COLUMN wh_code VARCHAR(20) DEFAULT 'WH_153';

query IT
SELECT item_id, wh_code FROM inv_main_2998 WHERE item_id = 3;
----
3 WH_153

statement ok
DROP VIEW vw_inv_2998;

statement ok
DROP TABLE #inv_delta_2998;

statement ok
DROP TABLE inv_main_2998;
