# test/slt_proc/dml_ddl_schema/983_check_triggers_views_catalog_08.slt
# T-SQL CHECK constraint enforcement, AFTER INSERT trigger, Views, and deterministic catalog (8)

statement ok
CREATE TABLE acct_983 (
    id INT PRIMARY KEY,
    owner VARCHAR(30) NOT NULL,
    balance INT DEFAULT 80 CHECK (balance >= 80)
);

statement ok
CREATE VIEW vw_acct_high_983 AS
SELECT id, owner, balance FROM acct_983 WHERE balance > 80;

statement ok
INSERT INTO acct_983 (id, owner, balance) VALUES (1, 'UserA_8', 130), (2, 'UserB_8', 200);

statement error
INSERT INTO acct_983 (id, owner, balance) VALUES (3, 'BadUser_8', 75);

statement error
UPDATE acct_983 SET balance = 75 WHERE id = 1;

statement ok
INSERT INTO acct_983 (id, owner) VALUES (4, 'DefaultUser_8');

query ITI
SELECT id, owner, balance FROM acct_983 ORDER BY id;
----
1 UserA_8 130
2 UserB_8 200
4 DefaultUser_8 80

query II
SELECT id, balance FROM vw_acct_high_983 ORDER BY id;
----
1 130
2 200

query T
SELECT table_name FROM information_schema.views WHERE table_name = 'vw_acct_high_983';
----
vw_acct_high_983

statement ok
DROP VIEW vw_acct_high_983;

statement ok
DROP TABLE acct_983;
