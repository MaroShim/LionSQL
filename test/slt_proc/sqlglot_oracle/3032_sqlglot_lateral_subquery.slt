2 20 NULL 2

query TTTTTT
SELECT x.a, x.b, t.v, t.y, s.v, s.y FROM x OUTER APPLY (SELECT v, y FROM t) t(v, y) OUTER APPLY (SELECT v, y FROM t) s(v, y) LEFT JOIN z ON z.id = s.id
----
1 10 NULL 2 NULL 2
2 20 NULL 2 NULL 2

