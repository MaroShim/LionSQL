# test/slt_proc/27_output_params_and_rowcount.slt
# @@ROWCOUNT and procedure results derived from DML

statement ok
CREATE TABLE rc_t (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO rc_t VALUES (1, 10), (2, 20), (3, 30);

statement ok
CREATE PROCEDURE sp_bump @min INT
AS
BEGIN
    UPDATE rc_t SET v = v + 1 WHERE v >= @min;
    SELECT @@ROWCOUNT;
END;

query I
EXEC sp_bump 20;
----
2

query II
SELECT id, v FROM rc_t ORDER BY id;
----
1 10
2 21
3 31

statement ok
DROP TABLE rc_t;
