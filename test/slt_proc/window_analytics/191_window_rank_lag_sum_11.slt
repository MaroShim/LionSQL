# test/slt_proc/window_analytics/191_window_rank_lag_sum_11.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (11)

statement ok
CREATE TABLE win_t_191 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_191 VALUES (1, 'A', 111, 110), (2, 'A', 111, 220), (3, 'B', 91, 330), (4, 'B', 71, 110);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_191
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_191
ORDER BY id;
----
1 0 220 110
2 110 330 330
3 220 110 660
4 330 -1 770

statement ok
DROP TABLE win_t_191;
