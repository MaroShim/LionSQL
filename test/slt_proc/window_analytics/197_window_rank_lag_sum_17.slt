# test/slt_proc/window_analytics/197_window_rank_lag_sum_17.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (17)

statement ok
CREATE TABLE win_t_197 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_197 VALUES (1, 'A', 117, 170), (2, 'A', 117, 340), (3, 'B', 97, 510), (4, 'B', 77, 170);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_197
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_197
ORDER BY id;
----
1 0 340 170
2 170 510 510
3 340 170 1020
4 510 -1 1190

statement ok
DROP TABLE win_t_197;
