# test/slt_proc/window_analytics/2679_rank_denserank_lag_lead_139.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (139)

statement ok
CREATE TABLE win_scores_2679 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2679 VALUES
(1, 'D1', 1390),
(2, 'D1', 1390),
(3, 'D1', 3475);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1390) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2679
ORDER BY id;
----
1 1 1 1 -1390 1390
2 2 1 1 1390 2780
3 3 3 2 1390 6255

