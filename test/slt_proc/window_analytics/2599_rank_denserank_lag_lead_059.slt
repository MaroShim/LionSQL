# test/slt_proc/window_analytics/2599_rank_denserank_lag_lead_059.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (59)

statement ok
CREATE TABLE win_scores_2599 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2599 VALUES
(1, 'D1', 590),
(2, 'D1', 590),
(3, 'D1', 1475);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -590) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2599
ORDER BY id;
----
1 1 1 1 -590 590
2 2 1 1 590 1180
3 3 3 2 590 2655

statement ok
DROP TABLE win_scores_2599;
