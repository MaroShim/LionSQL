# test/slt_proc/window_analytics/2647_rank_denserank_lag_lead_107.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (107)

statement ok
CREATE TABLE win_scores_2647 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2647 VALUES
(1, 'D1', 1070),
(2, 'D1', 1070),
(3, 'D1', 2675);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1070) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2647
ORDER BY id;
----
1 1 1 1 -1070 1070
2 2 1 1 1070 2140
3 3 3 2 1070 4815

statement ok
DROP TABLE win_scores_2647;
