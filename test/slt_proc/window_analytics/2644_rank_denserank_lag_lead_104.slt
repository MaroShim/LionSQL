# test/slt_proc/window_analytics/2644_rank_denserank_lag_lead_104.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (104)

statement ok
CREATE TABLE win_scores_2644 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2644 VALUES
(1, 'D1', 1040),
(2, 'D1', 1040),
(3, 'D1', 2600);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1040) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2644
ORDER BY id;
----
1 1 1 1 -1040 1040
2 2 1 1 1040 2080
3 3 3 2 1040 4680

statement ok
DROP TABLE win_scores_2644;
