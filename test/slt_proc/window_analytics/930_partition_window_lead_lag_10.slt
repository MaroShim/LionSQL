# test/slt_proc/window_analytics/930_partition_window_lead_lag_10.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (10)

statement ok
CREATE TABLE w_part_930 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_930 VALUES
(1, 'G1', 100),
(2, 'G1', 200),
(3, 'G2', 150),
(4, 'G2', 300);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1000) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1000) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_930
ORDER BY id;
----
1 G1 1 -1000 200
2 G1 2 100 -1000
3 G2 1 -1000 300
4 G2 2 150 -1000

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_930
ORDER BY id;
----
1 100 2
2 300 2
3 150 2
4 450 2

statement ok
DROP TABLE w_part_930;
