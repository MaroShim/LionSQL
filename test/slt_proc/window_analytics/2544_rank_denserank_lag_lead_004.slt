# test/slt_proc/window_analytics/2544_rank_denserank_lag_lead_004.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (4)

statement ok
CREATE TABLE win_scores_2544 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2544 VALUES
(1, 'D1', 40),
(2, 'D1', 40),
(3, 'D1', 100);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -40) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2544
ORDER BY id;
----
1 1 1 1 -40 40
2 2 1 1 40 80
3 3 3 2 40 180

statement ok
DROP TABLE win_scores_2544;
