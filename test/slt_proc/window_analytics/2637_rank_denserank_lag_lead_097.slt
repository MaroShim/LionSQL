# test/slt_proc/window_analytics/2637_rank_denserank_lag_lead_097.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (97)

statement ok
CREATE TABLE win_scores_2637 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2637 VALUES
(1, 'D1', 970),
(2, 'D1', 970),
(3, 'D1', 2425);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -970) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2637
ORDER BY id;
----
1 1 1 1 -970 970
2 2 1 1 970 1940
3 3 3 2 970 4365

statement ok
DROP TABLE win_scores_2637;
