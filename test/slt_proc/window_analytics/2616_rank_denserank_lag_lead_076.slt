# test/slt_proc/window_analytics/2616_rank_denserank_lag_lead_076.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (76)

statement ok
CREATE TABLE win_scores_2616 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2616 VALUES
(1, 'D1', 760),
(2, 'D1', 760),
(3, 'D1', 1900);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -760) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2616
ORDER BY id;
----
1 1 1 1 -760 760
2 2 1 1 760 1520
3 3 3 2 760 3420

statement ok
DROP TABLE win_scores_2616;
