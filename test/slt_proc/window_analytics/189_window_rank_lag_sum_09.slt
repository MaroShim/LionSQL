# test/slt_proc/window_analytics/189_window_rank_lag_sum_09.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (9)

statement ok
CREATE TABLE win_t_189 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_189 VALUES (1, 'A', 109, 90), (2, 'A', 109, 180), (3, 'B', 89, 270), (4, 'B', 69, 90);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_189
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_189
ORDER BY id;
----
1 0 180 90
2 90 270 270
3 180 90 540
4 270 -1 630

statement ok
DROP TABLE win_t_189;
