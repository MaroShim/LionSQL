# test/slt_proc/window_analytics/2608_rank_denserank_lag_lead_068.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (68)

statement ok
CREATE TABLE win_scores_2608 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2608 VALUES
(1, 'D1', 680),
(2, 'D1', 680),
(3, 'D1', 1700);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -680) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2608
ORDER BY id;
----
1 1 1 1 -680 680
2 2 1 1 680 1360
3 3 3 2 680 3060

statement ok
DROP TABLE win_scores_2608;
