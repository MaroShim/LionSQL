# test/slt_proc/window_analytics/2586_rank_denserank_lag_lead_046.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (46)

statement ok
CREATE TABLE win_scores_2586 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2586 VALUES
(1, 'D1', 460),
(2, 'D1', 460),
(3, 'D1', 1150);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -460) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2586
ORDER BY id;
----
1 1 1 1 -460 460
2 2 1 1 460 920
3 3 3 2 460 2070

statement ok
DROP TABLE win_scores_2586;
