# test/slt_proc/window_analytics/926_partition_window_lead_lag_06.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (6)

statement ok
CREATE TABLE w_part_926 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_926 VALUES
(1, 'G1', 60),
(2, 'G1', 120),
(3, 'G2', 90),
(4, 'G2', 180);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -600) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -600) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_926
ORDER BY id;
----
1 G1 1 -600 120
2 G1 2 60 -600
3 G2 1 -600 180
4 G2 2 90 -600

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_926
ORDER BY id;
----
1 60 2
2 180 2
3 90 2
4 270 2

statement ok
DROP TABLE w_part_926;
