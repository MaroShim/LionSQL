# test/slt_proc/window_analytics/2641_rank_denserank_lag_lead_101.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (101)

statement ok
CREATE TABLE win_scores_2641 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2641 VALUES
(1, 'D1', 1010),
(2, 'D1', 1010),
(3, 'D1', 2525);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1010) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2641
ORDER BY id;
----
1 1 1 1 -1010 1010
2 2 1 1 1010 2020
3 3 3 2 1010 4545

statement ok
DROP TABLE win_scores_2641;
