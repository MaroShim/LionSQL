# test/slt_proc/window_analytics/2554_rank_denserank_lag_lead_014.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (14)

statement ok
CREATE TABLE win_scores_2554 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2554 VALUES
(1, 'D1', 140),
(2, 'D1', 140),
(3, 'D1', 350);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -140) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2554
ORDER BY id;
----
1 1 1 1 -140 140
2 2 1 1 140 280
3 3 3 2 140 630

statement ok
DROP TABLE win_scores_2554;
