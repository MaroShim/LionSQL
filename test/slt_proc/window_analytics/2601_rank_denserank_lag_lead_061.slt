# test/slt_proc/window_analytics/2601_rank_denserank_lag_lead_061.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (61)

statement ok
CREATE TABLE win_scores_2601 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2601 VALUES
(1, 'D1', 610),
(2, 'D1', 610),
(3, 'D1', 1525);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -610) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2601
ORDER BY id;
----
1 1 1 1 -610 610
2 2 1 1 610 1220
3 3 3 2 610 2745

statement ok
DROP TABLE win_scores_2601;
