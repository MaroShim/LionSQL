# test/slt_proc/window_analytics/937_partition_window_lead_lag_17.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (17)

statement ok
CREATE TABLE w_part_937 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_937 VALUES
(1, 'G1', 170),
(2, 'G1', 340),
(3, 'G2', 255),
(4, 'G2', 510);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1700) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1700) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_937
ORDER BY id;
----
1 G1 1 -1700 340
2 G1 2 170 -1700
3 G2 1 -1700 510
4 G2 2 255 -1700

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_937
ORDER BY id;
----
1 170 2
2 510 2
3 255 2
4 765 2

statement ok
DROP TABLE w_part_937;
