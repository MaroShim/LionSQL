# test/slt_proc/window_analytics/2646_rank_denserank_lag_lead_106.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (106)

statement ok
CREATE TABLE win_scores_2646 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2646 VALUES
(1, 'D1', 1060),
(2, 'D1', 1060),
(3, 'D1', 2650);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1060) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2646
ORDER BY id;
----
1 1 1 1 -1060 1060
2 2 1 1 1060 2120
3 3 3 2 1060 4770

statement ok
DROP TABLE win_scores_2646;
