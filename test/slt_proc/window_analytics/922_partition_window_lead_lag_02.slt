# test/slt_proc/window_analytics/922_partition_window_lead_lag_02.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (2)

statement ok
CREATE TABLE w_part_922 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_922 VALUES
(1, 'G1', 20),
(2, 'G1', 40),
(3, 'G2', 30),
(4, 'G2', 60);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -200) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -200) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_922
ORDER BY id;
----
1 G1 1 -200 40
2 G1 2 20 -200
3 G2 1 -200 60
4 G2 2 30 -200

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_922
ORDER BY id;
----
1 20 2
2 60 2
3 30 2
4 90 2

statement ok
DROP TABLE w_part_922;
