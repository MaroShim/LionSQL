# test/slt_proc/window_analytics/2629_rank_denserank_lag_lead_089.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (89)

statement ok
CREATE TABLE win_scores_2629 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2629 VALUES
(1, 'D1', 890),
(2, 'D1', 890),
(3, 'D1', 2225);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -890) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2629
ORDER BY id;
----
1 1 1 1 -890 890
2 2 1 1 890 1780
3 3 3 2 890 4005

statement ok
DROP TABLE win_scores_2629;
