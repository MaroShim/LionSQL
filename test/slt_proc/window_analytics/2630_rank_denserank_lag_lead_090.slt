# test/slt_proc/window_analytics/2630_rank_denserank_lag_lead_090.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (90)

statement ok
CREATE TABLE win_scores_2630 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2630 VALUES
(1, 'D1', 900),
(2, 'D1', 900),
(3, 'D1', 2250);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -900) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2630
ORDER BY id;
----
1 1 1 1 -900 900
2 2 1 1 900 1800
3 3 3 2 900 4050

statement ok
DROP TABLE win_scores_2630;
