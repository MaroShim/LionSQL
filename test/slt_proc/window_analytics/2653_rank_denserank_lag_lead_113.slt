# test/slt_proc/window_analytics/2653_rank_denserank_lag_lead_113.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (113)

statement ok
CREATE TABLE win_scores_2653 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2653 VALUES
(1, 'D1', 1130),
(2, 'D1', 1130),
(3, 'D1', 2825);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1130) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2653
ORDER BY id;
----
1 1 1 1 -1130 1130
2 2 1 1 1130 2260
3 3 3 2 1130 5085

statement ok
DROP TABLE win_scores_2653;
