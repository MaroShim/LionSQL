# test/slt_proc/window_analytics/921_partition_window_lead_lag_01.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (1)

statement ok
CREATE TABLE w_part_921 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_921 VALUES
(1, 'G1', 10),
(2, 'G1', 20),
(3, 'G2', 15),
(4, 'G2', 30);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -100) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -100) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_921
ORDER BY id;
----
1 G1 1 -100 20
2 G1 2 10 -100
3 G2 1 -100 30
4 G2 2 15 -100

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_921
ORDER BY id;
----
1 10 2
2 30 2
3 15 2
4 45 2

statement ok
DROP TABLE w_part_921;
