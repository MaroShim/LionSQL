# test/slt_proc/window_analytics/2545_rank_denserank_lag_lead_005.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (5)

statement ok
CREATE TABLE win_scores_2545 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2545 VALUES
(1, 'D1', 50),
(2, 'D1', 50),
(3, 'D1', 125);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -50) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2545
ORDER BY id;
----
1 1 1 1 -50 50
2 2 1 1 50 100
3 3 3 2 50 225

statement ok
DROP TABLE win_scores_2545;
