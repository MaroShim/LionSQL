# test/slt_proc/window_analytics/2551_rank_denserank_lag_lead_011.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (11)

statement ok
CREATE TABLE win_scores_2551 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2551 VALUES
(1, 'D1', 110),
(2, 'D1', 110),
(3, 'D1', 275);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -110) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2551
ORDER BY id;
----
1 1 1 1 -110 110
2 2 1 1 110 220
3 3 3 2 110 495

statement ok
DROP TABLE win_scores_2551;
