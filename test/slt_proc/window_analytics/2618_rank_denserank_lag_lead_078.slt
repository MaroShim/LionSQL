# test/slt_proc/window_analytics/2618_rank_denserank_lag_lead_078.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (78)

statement ok
CREATE TABLE win_scores_2618 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2618 VALUES
(1, 'D1', 780),
(2, 'D1', 780),
(3, 'D1', 1950);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -780) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2618
ORDER BY id;
----
1 1 1 1 -780 780
2 2 1 1 780 1560
3 3 3 2 780 3510

statement ok
DROP TABLE win_scores_2618;
