# test/slt_proc/window_analytics/933_partition_window_lead_lag_13.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (13)

statement ok
CREATE TABLE w_part_933 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_933 VALUES
(1, 'G1', 130),
(2, 'G1', 260),
(3, 'G2', 195),
(4, 'G2', 390);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1300) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1300) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_933
ORDER BY id;
----
1 G1 1 -1300 260
2 G1 2 130 -1300
3 G2 1 -1300 390
4 G2 2 195 -1300

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_933
ORDER BY id;
----
1 130 2
2 390 2
3 195 2
4 585 2

statement ok
DROP TABLE w_part_933;
