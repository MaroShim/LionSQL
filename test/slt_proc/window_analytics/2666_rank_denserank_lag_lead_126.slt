# test/slt_proc/window_analytics/2666_rank_denserank_lag_lead_126.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (126)

statement ok
CREATE TABLE win_scores_2666 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2666 VALUES
(1, 'D1', 1260),
(2, 'D1', 1260),
(3, 'D1', 3150);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1260) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2666
ORDER BY id;
----
1 1 1 1 -1260 1260
2 2 1 1 1260 2520
3 3 3 2 1260 5670

statement ok
DROP TABLE win_scores_2666;
