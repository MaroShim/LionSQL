# test/slt_proc/window_analytics/2625_rank_denserank_lag_lead_085.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (85)

statement ok
CREATE TABLE win_scores_2625 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2625 VALUES
(1, 'D1', 850),
(2, 'D1', 850),
(3, 'D1', 2125);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -850) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2625
ORDER BY id;
----
1 1 1 1 -850 850
2 2 1 1 850 1700
3 3 3 2 850 3825

statement ok
DROP TABLE win_scores_2625;
