# test/slt_proc/window_analytics/932_partition_window_lead_lag_12.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (12)

statement ok
CREATE TABLE w_part_932 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_932 VALUES
(1, 'G1', 120),
(2, 'G1', 240),
(3, 'G2', 180),
(4, 'G2', 360);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1200) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1200) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_932
ORDER BY id;
----
1 G1 1 -1200 240
2 G1 2 120 -1200
3 G2 1 -1200 360
4 G2 2 180 -1200

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_932
ORDER BY id;
----
1 120 2
2 360 2
3 180 2
4 540 2

statement ok
DROP TABLE w_part_932;
