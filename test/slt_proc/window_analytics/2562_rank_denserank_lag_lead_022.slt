# test/slt_proc/window_analytics/2562_rank_denserank_lag_lead_022.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (22)

statement ok
CREATE TABLE win_scores_2562 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2562 VALUES
(1, 'D1', 220),
(2, 'D1', 220),
(3, 'D1', 550);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -220) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2562
ORDER BY id;
----
1 1 1 1 -220 220
2 2 1 1 220 440
3 3 3 2 220 990

statement ok
DROP TABLE win_scores_2562;
