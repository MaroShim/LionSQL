# test/slt_proc/window_analytics/185_window_rank_lag_sum_05.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (5)

statement ok
CREATE TABLE win_t_185 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_185 VALUES (1, 'A', 105, 50), (2, 'A', 105, 100), (3, 'B', 85, 150), (4, 'B', 65, 50);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_185
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_185
ORDER BY id;
----
1 0 100 50
2 50 150 150
3 100 50 300
4 150 -1 350

statement ok
DROP TABLE win_t_185;
