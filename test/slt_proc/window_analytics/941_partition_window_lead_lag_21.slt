# test/slt_proc/window_analytics/941_partition_window_lead_lag_21.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (21)

statement ok
CREATE TABLE w_part_941 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_941 VALUES
(1, 'G1', 210),
(2, 'G1', 420),
(3, 'G2', 315),
(4, 'G2', 630);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -2100) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -2100) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_941
ORDER BY id;
----
1 G1 1 -2100 420
2 G1 2 210 -2100
3 G2 1 -2100 630
4 G2 2 315 -2100

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_941
ORDER BY id;
----
1 210 2
2 630 2
3 315 2
4 945 2

statement ok
DROP TABLE w_part_941;
