# test/slt_proc/window_analytics/2584_rank_denserank_lag_lead_044.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (44)

statement ok
CREATE TABLE win_scores_2584 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2584 VALUES
(1, 'D1', 440),
(2, 'D1', 440),
(3, 'D1', 1100);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -440) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2584
ORDER BY id;
----
1 1 1 1 -440 440
2 2 1 1 440 880
3 3 3 2 440 1980

statement ok
DROP TABLE win_scores_2584;
