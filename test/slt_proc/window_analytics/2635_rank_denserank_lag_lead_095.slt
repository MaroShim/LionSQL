# test/slt_proc/window_analytics/2635_rank_denserank_lag_lead_095.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (95)

statement ok
CREATE TABLE win_scores_2635 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2635 VALUES
(1, 'D1', 950),
(2, 'D1', 950),
(3, 'D1', 2375);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -950) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2635
ORDER BY id;
----
1 1 1 1 -950 950
2 2 1 1 950 1900
3 3 3 2 950 4275

statement ok
DROP TABLE win_scores_2635;
