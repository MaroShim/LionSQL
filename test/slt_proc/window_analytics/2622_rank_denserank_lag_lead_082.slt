# test/slt_proc/window_analytics/2622_rank_denserank_lag_lead_082.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (82)

statement ok
CREATE TABLE win_scores_2622 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2622 VALUES
(1, 'D1', 820),
(2, 'D1', 820),
(3, 'D1', 2050);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -820) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2622
ORDER BY id;
----
1 1 1 1 -820 820
2 2 1 1 820 1640
3 3 3 2 820 3690

statement ok
DROP TABLE win_scores_2622;
