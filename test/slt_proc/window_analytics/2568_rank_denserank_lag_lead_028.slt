# test/slt_proc/window_analytics/2568_rank_denserank_lag_lead_028.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (28)

statement ok
CREATE TABLE win_scores_2568 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2568 VALUES
(1, 'D1', 280),
(2, 'D1', 280),
(3, 'D1', 700);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -280) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2568
ORDER BY id;
----
1 1 1 1 -280 280
2 2 1 1 280 560
3 3 3 2 280 1260

statement ok
DROP TABLE win_scores_2568;
