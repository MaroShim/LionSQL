# test/slt_proc/window_analytics/2606_rank_denserank_lag_lead_066.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (66)

statement ok
CREATE TABLE win_scores_2606 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2606 VALUES
(1, 'D1', 660),
(2, 'D1', 660),
(3, 'D1', 1650);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -660) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2606
ORDER BY id;
----
1 1 1 1 -660 660
2 2 1 1 660 1320
3 3 3 2 660 2970

statement ok
DROP TABLE win_scores_2606;
