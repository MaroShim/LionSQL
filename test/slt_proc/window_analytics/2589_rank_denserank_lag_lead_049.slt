# test/slt_proc/window_analytics/2589_rank_denserank_lag_lead_049.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (49)

statement ok
CREATE TABLE win_scores_2589 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2589 VALUES
(1, 'D1', 490),
(2, 'D1', 490),
(3, 'D1', 1225);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -490) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2589
ORDER BY id;
----
1 1 1 1 -490 490
2 2 1 1 490 980
3 3 3 2 490 2205

statement ok
DROP TABLE win_scores_2589;
