# test/slt_proc/window_analytics/2559_rank_denserank_lag_lead_019.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (19)

statement ok
CREATE TABLE win_scores_2559 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2559 VALUES
(1, 'D1', 190),
(2, 'D1', 190),
(3, 'D1', 475);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -190) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2559
ORDER BY id;
----
1 1 1 1 -190 190
2 2 1 1 190 380
3 3 3 2 190 855

statement ok
DROP TABLE win_scores_2559;
