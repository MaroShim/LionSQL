# test/slt_proc/window_analytics/2688_rank_denserank_lag_lead_148.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (148)

statement ok
CREATE TABLE win_scores_2688 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2688 VALUES
(1, 'D1', 1480),
(2, 'D1', 1480),
(3, 'D1', 3700);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1480) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2688
ORDER BY id;
----
1 1 1 1 -1480 1480
2 2 1 1 1480 2960
3 3 3 2 1480 6660

statement ok
DROP TABLE win_scores_2688;
