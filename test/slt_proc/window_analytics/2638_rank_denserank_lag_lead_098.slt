# test/slt_proc/window_analytics/2638_rank_denserank_lag_lead_098.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (98)

statement ok
CREATE TABLE win_scores_2638 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2638 VALUES
(1, 'D1', 980),
(2, 'D1', 980),
(3, 'D1', 2450);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -980) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2638
ORDER BY id;
----
1 1 1 1 -980 980
2 2 1 1 980 1960
3 3 3 2 980 4410

statement ok
DROP TABLE win_scores_2638;
