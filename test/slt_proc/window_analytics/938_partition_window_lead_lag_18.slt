# test/slt_proc/window_analytics/938_partition_window_lead_lag_18.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (18)

statement ok
CREATE TABLE w_part_938 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_938 VALUES
(1, 'G1', 180),
(2, 'G1', 360),
(3, 'G2', 270),
(4, 'G2', 540);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1800) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1800) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_938
ORDER BY id;
----
1 G1 1 -1800 360
2 G1 2 180 -1800
3 G2 1 -1800 540
4 G2 2 270 -1800

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_938
ORDER BY id;
----
1 180 2
2 540 2
3 270 2
4 810 2

statement ok
DROP TABLE w_part_938;
