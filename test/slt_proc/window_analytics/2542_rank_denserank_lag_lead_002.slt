# test/slt_proc/window_analytics/2542_rank_denserank_lag_lead_002.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (2)

statement ok
CREATE TABLE win_scores_2542 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2542 VALUES
(1, 'D1', 20),
(2, 'D1', 20),
(3, 'D1', 50);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -20) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2542
ORDER BY id;
----
1 1 1 1 -20 20
2 2 1 1 20 40
3 3 3 2 20 90

statement ok
DROP TABLE win_scores_2542;
