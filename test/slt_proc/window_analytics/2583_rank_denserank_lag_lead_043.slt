# test/slt_proc/window_analytics/2583_rank_denserank_lag_lead_043.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (43)

statement ok
CREATE TABLE win_scores_2583 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2583 VALUES
(1, 'D1', 430),
(2, 'D1', 430),
(3, 'D1', 1075);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -430) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2583
ORDER BY id;
----
1 1 1 1 -430 430
2 2 1 1 430 860
3 3 3 2 430 1935

statement ok
DROP TABLE win_scores_2583;
