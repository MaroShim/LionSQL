# test/slt_proc/window_analytics/205_window_rank_lag_sum_25.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (25)

statement ok
CREATE TABLE win_t_205 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_205 VALUES (1, 'A', 125, 250), (2, 'A', 125, 500), (3, 'B', 105, 750), (4, 'B', 85, 250);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_205
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_205
ORDER BY id;
----
1 0 500 250
2 250 750 750
3 500 250 1500
4 750 -1 1750

statement ok
DROP TABLE win_t_205;
