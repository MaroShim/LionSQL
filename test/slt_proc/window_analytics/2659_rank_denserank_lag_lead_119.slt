# test/slt_proc/window_analytics/2659_rank_denserank_lag_lead_119.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (119)

statement ok
CREATE TABLE win_scores_2659 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2659 VALUES
(1, 'D1', 1190),
(2, 'D1', 1190),
(3, 'D1', 2975);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1190) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2659
ORDER BY id;
----
1 1 1 1 -1190 1190
2 2 1 1 1190 2380
3 3 3 2 1190 5355

statement ok
DROP TABLE win_scores_2659;
