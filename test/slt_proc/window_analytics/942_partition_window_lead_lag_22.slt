# test/slt_proc/window_analytics/942_partition_window_lead_lag_22.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (22)

statement ok
CREATE TABLE w_part_942 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_942 VALUES
(1, 'G1', 220),
(2, 'G1', 440),
(3, 'G2', 330),
(4, 'G2', 660);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -2200) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -2200) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_942
ORDER BY id;
----
1 G1 1 -2200 440
2 G1 2 220 -2200
3 G2 1 -2200 660
4 G2 2 330 -2200

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_942
ORDER BY id;
----
1 220 2
2 660 2
3 330 2
4 990 2

statement ok
DROP TABLE w_part_942;
