# test/slt_proc/window_analytics/2541_rank_denserank_lag_lead_001.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (1)

statement ok
CREATE TABLE win_scores_2541 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2541 VALUES
(1, 'D1', 10),
(2, 'D1', 10),
(3, 'D1', 25);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -10) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2541
ORDER BY id;
----
1 1 1 1 -10 10
2 2 1 1 10 20
3 3 3 2 10 45

statement ok
DROP TABLE win_scores_2541;
