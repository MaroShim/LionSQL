# test/slt_proc/window_analytics/927_partition_window_lead_lag_07.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (7)

statement ok
CREATE TABLE w_part_927 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_927 VALUES
(1, 'G1', 70),
(2, 'G1', 140),
(3, 'G2', 105),
(4, 'G2', 210);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -700) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -700) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_927
ORDER BY id;
----
1 G1 1 -700 140
2 G1 2 70 -700
3 G2 1 -700 210
4 G2 2 105 -700

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_927
ORDER BY id;
----
1 70 2
2 210 2
3 105 2
4 315 2

statement ok
DROP TABLE w_part_927;
