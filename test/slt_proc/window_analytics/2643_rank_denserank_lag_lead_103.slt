# test/slt_proc/window_analytics/2643_rank_denserank_lag_lead_103.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (103)

statement ok
CREATE TABLE win_scores_2643 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2643 VALUES
(1, 'D1', 1030),
(2, 'D1', 1030),
(3, 'D1', 2575);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1030) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2643
ORDER BY id;
----
1 1 1 1 -1030 1030
2 2 1 1 1030 2060
3 3 3 2 1030 4635

statement ok
DROP TABLE win_scores_2643;
