# test/slt_proc/window_analytics/2617_rank_denserank_lag_lead_077.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (77)

statement ok
CREATE TABLE win_scores_2617 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2617 VALUES
(1, 'D1', 770),
(2, 'D1', 770),
(3, 'D1', 1925);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -770) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2617
ORDER BY id;
----
1 1 1 1 -770 770
2 2 1 1 770 1540
3 3 3 2 770 3465

statement ok
DROP TABLE win_scores_2617;
