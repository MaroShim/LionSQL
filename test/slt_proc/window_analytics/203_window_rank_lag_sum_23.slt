# test/slt_proc/window_analytics/203_window_rank_lag_sum_23.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (23)

statement ok
CREATE TABLE win_t_203 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_203 VALUES (1, 'A', 123, 230), (2, 'A', 123, 460), (3, 'B', 103, 690), (4, 'B', 83, 230);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_203
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_203
ORDER BY id;
----
1 0 460 230
2 230 690 690
3 460 230 1380
4 690 -1 1610

statement ok
DROP TABLE win_t_203;
