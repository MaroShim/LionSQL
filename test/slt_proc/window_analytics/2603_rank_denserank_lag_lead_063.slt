# test/slt_proc/window_analytics/2603_rank_denserank_lag_lead_063.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (63)

statement ok
CREATE TABLE win_scores_2603 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2603 VALUES
(1, 'D1', 630),
(2, 'D1', 630),
(3, 'D1', 1575);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -630) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2603
ORDER BY id;
----
1 1 1 1 -630 630
2 2 1 1 630 1260
3 3 3 2 630 2835

statement ok
DROP TABLE win_scores_2603;
