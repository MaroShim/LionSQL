# test/slt_proc/window_analytics/2678_rank_denserank_lag_lead_138.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (138)

statement ok
CREATE TABLE win_scores_2678 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2678 VALUES
(1, 'D1', 1380),
(2, 'D1', 1380),
(3, 'D1', 3450);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1380) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2678
ORDER BY id;
----
1 1 1 1 -1380 1380
2 2 1 1 1380 2760
3 3 3 2 1380 6210

statement ok
