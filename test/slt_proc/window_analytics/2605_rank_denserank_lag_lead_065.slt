# test/slt_proc/window_analytics/2605_rank_denserank_lag_lead_065.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (65)

statement ok
CREATE TABLE win_scores_2605 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2605 VALUES
(1, 'D1', 650),
(2, 'D1', 650),
(3, 'D1', 1625);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -650) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2605
ORDER BY id;
----
1 1 1 1 -650 650
2 2 1 1 650 1300
3 3 3 2 650 2925

statement ok
DROP TABLE win_scores_2605;
