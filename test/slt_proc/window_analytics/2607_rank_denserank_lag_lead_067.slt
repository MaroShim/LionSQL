# test/slt_proc/window_analytics/2607_rank_denserank_lag_lead_067.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (67)

statement ok
CREATE TABLE win_scores_2607 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2607 VALUES
(1, 'D1', 670),
(2, 'D1', 670),
(3, 'D1', 1675);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -670) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2607
ORDER BY id;
----
1 1 1 1 -670 670
2 2 1 1 670 1340
3 3 3 2 670 3015

statement ok
DROP TABLE win_scores_2607;
