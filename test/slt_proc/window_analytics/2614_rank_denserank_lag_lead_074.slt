# test/slt_proc/window_analytics/2614_rank_denserank_lag_lead_074.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (74)

statement ok
CREATE TABLE win_scores_2614 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2614 VALUES
(1, 'D1', 740),
(2, 'D1', 740),
(3, 'D1', 1850);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -740) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2614
ORDER BY id;
----
1 1 1 1 -740 740
2 2 1 1 740 1480
3 3 3 2 740 3330

statement ok
DROP TABLE win_scores_2614;
