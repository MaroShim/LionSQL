# test/slt_proc/window_analytics/2549_rank_denserank_lag_lead_009.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (9)

statement ok
CREATE TABLE win_scores_2549 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2549 VALUES
(1, 'D1', 90),
(2, 'D1', 90),
(3, 'D1', 225);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -90) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2549
ORDER BY id;
----
1 1 1 1 -90 90
2 2 1 1 90 180
3 3 3 2 90 405

statement ok
DROP TABLE win_scores_2549;
