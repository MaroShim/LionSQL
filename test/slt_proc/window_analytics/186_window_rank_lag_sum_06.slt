# test/slt_proc/window_analytics/186_window_rank_lag_sum_06.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (6)

statement ok
CREATE TABLE win_t_186 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_186 VALUES (1, 'A', 106, 60), (2, 'A', 106, 120), (3, 'B', 86, 180), (4, 'B', 66, 60);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_186
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_186
ORDER BY id;
----
1 0 120 60
2 60 180 180
3 120 60 360
4 180 -1 420

statement ok
DROP TABLE win_t_186;
