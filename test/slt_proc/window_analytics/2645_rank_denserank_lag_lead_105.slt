# test/slt_proc/window_analytics/2645_rank_denserank_lag_lead_105.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (105)

statement ok
CREATE TABLE win_scores_2645 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2645 VALUES
(1, 'D1', 1050),
(2, 'D1', 1050),
(3, 'D1', 2625);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1050) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2645
ORDER BY id;
----
1 1 1 1 -1050 1050
2 2 1 1 1050 2100
3 3 3 2 1050 4725

statement ok
DROP TABLE win_scores_2645;
