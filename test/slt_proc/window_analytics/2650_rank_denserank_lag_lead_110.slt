# test/slt_proc/window_analytics/2650_rank_denserank_lag_lead_110.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (110)

statement ok
CREATE TABLE win_scores_2650 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2650 VALUES
(1, 'D1', 1100),
(2, 'D1', 1100),
(3, 'D1', 2750);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1100) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2650
ORDER BY id;
----
1 1 1 1 -1100 1100
2 2 1 1 1100 2200
3 3 3 2 1100 4950

statement ok
DROP TABLE win_scores_2650;
