# test/slt_proc/window_analytics/924_partition_window_lead_lag_04.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (4)

statement ok
CREATE TABLE w_part_924 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_924 VALUES
(1, 'G1', 40),
(2, 'G1', 80),
(3, 'G2', 60),
(4, 'G2', 120);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -400) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -400) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_924
ORDER BY id;
----
1 G1 1 -400 80
2 G1 2 40 -400
3 G2 1 -400 120
4 G2 2 60 -400

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_924
ORDER BY id;
----
1 40 2
2 120 2
3 60 2
4 180 2

statement ok
DROP TABLE w_part_924;
