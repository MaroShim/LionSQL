# test/slt_proc/window_analytics/2598_rank_denserank_lag_lead_058.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (58)

statement ok
CREATE TABLE win_scores_2598 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2598 VALUES
(1, 'D1', 580),
(2, 'D1', 580),
(3, 'D1', 1450);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -580) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2598
ORDER BY id;
----
1 1 1 1 -580 580
2 2 1 1 580 1160
3 3 3 2 580 2610

statement ok
DROP TABLE win_scores_2598;
