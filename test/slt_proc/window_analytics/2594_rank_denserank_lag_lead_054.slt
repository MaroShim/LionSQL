# test/slt_proc/window_analytics/2594_rank_denserank_lag_lead_054.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (54)

statement ok
CREATE TABLE win_scores_2594 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2594 VALUES
(1, 'D1', 540),
(2, 'D1', 540),
(3, 'D1', 1350);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -540) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2594
ORDER BY id;
----
1 1 1 1 -540 540
2 2 1 1 540 1080
3 3 3 2 540 2430

statement ok
DROP TABLE win_scores_2594;
