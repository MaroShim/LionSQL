# test/slt_proc/window_analytics/931_partition_window_lead_lag_11.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (11)

statement ok
CREATE TABLE w_part_931 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_931 VALUES
(1, 'G1', 110),
(2, 'G1', 220),
(3, 'G2', 165),
(4, 'G2', 330);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1100) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1100) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_931
ORDER BY id;
----
1 G1 1 -1100 220
2 G1 2 110 -1100
3 G2 1 -1100 330
4 G2 2 165 -1100

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_931
ORDER BY id;
----
1 110 2
2 330 2
3 165 2
4 495 2

statement ok
DROP TABLE w_part_931;
