# test/slt_proc/window_analytics/2587_rank_denserank_lag_lead_047.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (47)

statement ok
CREATE TABLE win_scores_2587 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2587 VALUES
(1, 'D1', 470),
(2, 'D1', 470),
(3, 'D1', 1175);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -470) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2587
ORDER BY id;
----
1 1 1 1 -470 470
2 2 1 1 470 940
3 3 3 2 470 2115

statement ok
DROP TABLE win_scores_2587;
