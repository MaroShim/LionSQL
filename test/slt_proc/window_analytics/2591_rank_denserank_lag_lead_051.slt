# test/slt_proc/window_analytics/2591_rank_denserank_lag_lead_051.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (51)

statement ok
CREATE TABLE win_scores_2591 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2591 VALUES
(1, 'D1', 510),
(2, 'D1', 510),
(3, 'D1', 1275);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -510) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2591
ORDER BY id;
----
1 1 1 1 -510 510
2 2 1 1 510 1020
3 3 3 2 510 2295

statement ok
DROP TABLE win_scores_2591;
