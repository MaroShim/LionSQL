# test/slt_proc/window_analytics/925_partition_window_lead_lag_05.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (5)

statement ok
CREATE TABLE w_part_925 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_925 VALUES
(1, 'G1', 50),
(2, 'G1', 100),
(3, 'G2', 75),
(4, 'G2', 150);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -500) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -500) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_925
ORDER BY id;
----
1 G1 1 -500 100
2 G1 2 50 -500
3 G2 1 -500 150
4 G2 2 75 -500

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_925
ORDER BY id;
----
1 50 2
2 150 2
3 75 2
4 225 2

statement ok
DROP TABLE w_part_925;
