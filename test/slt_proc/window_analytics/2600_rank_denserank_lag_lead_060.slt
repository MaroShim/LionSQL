# test/slt_proc/window_analytics/2600_rank_denserank_lag_lead_060.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (60)

statement ok
CREATE TABLE win_scores_2600 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2600 VALUES
(1, 'D1', 600),
(2, 'D1', 600),
(3, 'D1', 1500);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -600) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2600
ORDER BY id;
----
1 1 1 1 -600 600
2 2 1 1 600 1200
3 3 3 2 600 2700

statement ok
DROP TABLE win_scores_2600;
