# test/slt_proc/window_analytics/936_partition_window_lead_lag_16.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (16)

statement ok
CREATE TABLE w_part_936 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_936 VALUES
(1, 'G1', 160),
(2, 'G1', 320),
(3, 'G2', 240),
(4, 'G2', 480);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1600) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1600) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_936
ORDER BY id;
----
1 G1 1 -1600 320
2 G1 2 160 -1600
3 G2 1 -1600 480
4 G2 2 240 -1600

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_936
ORDER BY id;
----
1 160 2
2 480 2
3 240 2
4 720 2

statement ok
DROP TABLE w_part_936;
