# test/slt_proc/window_analytics/2662_rank_denserank_lag_lead_122.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (122)

statement ok
CREATE TABLE win_scores_2662 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2662 VALUES
(1, 'D1', 1220),
(2, 'D1', 1220),
(3, 'D1', 3050);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1220) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2662
ORDER BY id;
----
1 1 1 1 -1220 1220
2 2 1 1 1220 2440
3 3 3 2 1220 5490

statement ok
