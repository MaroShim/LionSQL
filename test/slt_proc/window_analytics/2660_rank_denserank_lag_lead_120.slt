# test/slt_proc/window_analytics/2660_rank_denserank_lag_lead_120.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (120)

statement ok
CREATE TABLE win_scores_2660 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2660 VALUES
(1, 'D1', 1200),
(2, 'D1', 1200),
(3, 'D1', 3000);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1200) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2660
ORDER BY id;
----
1 1 1 1 -1200 1200
2 2 1 1 1200 2400
3 3 3 2 1200 5400

statement ok
DROP TABLE win_scores_2660;
