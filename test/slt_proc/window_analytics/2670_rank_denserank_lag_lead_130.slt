# test/slt_proc/window_analytics/2670_rank_denserank_lag_lead_130.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (130)

statement ok
CREATE TABLE win_scores_2670 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2670 VALUES
(1, 'D1', 1300),
(2, 'D1', 1300),
(3, 'D1', 3250);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1300) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2670
ORDER BY id;
----
1 1 1 1 -1300 1300
2 2 1 1 1300 2600
3 3 3 2 1300 5850

statement ok
DROP TABLE win_scores_2670;
