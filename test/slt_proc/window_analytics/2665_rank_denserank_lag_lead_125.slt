# test/slt_proc/window_analytics/2665_rank_denserank_lag_lead_125.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (125)

statement ok
CREATE TABLE win_scores_2665 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2665 VALUES
(1, 'D1', 1250),
(2, 'D1', 1250),
(3, 'D1', 3125);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1250) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2665
ORDER BY id;
----
1 1 1 1 -1250 1250
2 2 1 1 1250 2500
3 3 3 2 1250 5625

statement ok
DROP TABLE win_scores_2665;
