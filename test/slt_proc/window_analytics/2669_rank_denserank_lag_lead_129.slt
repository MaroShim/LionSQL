# test/slt_proc/window_analytics/2669_rank_denserank_lag_lead_129.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (129)

statement ok
CREATE TABLE win_scores_2669 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2669 VALUES
(1, 'D1', 1290),
(2, 'D1', 1290),
(3, 'D1', 3225);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1290) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2669
ORDER BY id;
----
1 1 1 1 -1290 1290
2 2 1 1 1290 2580
3 3 3 2 1290 5805

