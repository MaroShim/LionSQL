# test/slt_proc/window_analytics/196_window_rank_lag_sum_16.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (16)

statement ok
CREATE TABLE win_t_196 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_196 VALUES (1, 'A', 116, 160), (2, 'A', 116, 320), (3, 'B', 96, 480), (4, 'B', 76, 160);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_196
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_196
ORDER BY id;
----
1 0 320 160
2 160 480 480
3 320 160 960
4 480 -1 1120

statement ok
DROP TABLE win_t_196;
