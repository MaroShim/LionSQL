# test/slt_proc/window_analytics/929_partition_window_lead_lag_09.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (9)

statement ok
CREATE TABLE w_part_929 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_929 VALUES
(1, 'G1', 90),
(2, 'G1', 180),
(3, 'G2', 135),
(4, 'G2', 270);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -900) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -900) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_929
ORDER BY id;
----
1 G1 1 -900 180
2 G1 2 90 -900
3 G2 1 -900 270
4 G2 2 135 -900

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_929
ORDER BY id;
----
1 90 2
2 270 2
3 135 2
4 405 2

statement ok
DROP TABLE w_part_929;
