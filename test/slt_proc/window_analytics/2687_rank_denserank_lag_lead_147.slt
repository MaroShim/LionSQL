# test/slt_proc/window_analytics/2687_rank_denserank_lag_lead_147.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (147)

statement ok
CREATE TABLE win_scores_2687 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2687 VALUES
(1, 'D1', 1470),
(2, 'D1', 1470),
(3, 'D1', 3675);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1470) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2687
ORDER BY id;
----
1 1 1 1 -1470 1470
2 2 1 1 1470 2940
3 3 3 2 1470 6615

statement ok
DROP TABLE win_scores_2687;
