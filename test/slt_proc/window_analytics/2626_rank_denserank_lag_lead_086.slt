# test/slt_proc/window_analytics/2626_rank_denserank_lag_lead_086.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (86)

statement ok
CREATE TABLE win_scores_2626 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2626 VALUES
(1, 'D1', 860),
(2, 'D1', 860),
(3, 'D1', 2150);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -860) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2626
ORDER BY id;
----
1 1 1 1 -860 860
2 2 1 1 860 1720
3 3 3 2 860 3870

statement ok
DROP TABLE win_scores_2626;
