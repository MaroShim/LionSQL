# test/slt_proc/window_analytics/2634_rank_denserank_lag_lead_094.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (94)

statement ok
CREATE TABLE win_scores_2634 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2634 VALUES
(1, 'D1', 940),
(2, 'D1', 940),
(3, 'D1', 2350);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -940) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2634
ORDER BY id;
----
1 1 1 1 -940 940
2 2 1 1 940 1880
3 3 3 2 940 4230

statement ok
DROP TABLE win_scores_2634;
