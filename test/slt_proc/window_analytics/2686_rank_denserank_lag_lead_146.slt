# test/slt_proc/window_analytics/2686_rank_denserank_lag_lead_146.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (146)

statement ok
CREATE TABLE win_scores_2686 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2686 VALUES
(1, 'D1', 1460),
(2, 'D1', 1460),
(3, 'D1', 3650);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1460) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2686
ORDER BY id;
----
1 1 1 1 -1460 1460
2 2 1 1 1460 2920
3 3 3 2 1460 6570

statement ok
DROP TABLE win_scores_2686;
