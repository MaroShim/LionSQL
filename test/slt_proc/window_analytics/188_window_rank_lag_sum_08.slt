# test/slt_proc/window_analytics/188_window_rank_lag_sum_08.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (8)

statement ok
CREATE TABLE win_t_188 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_188 VALUES (1, 'A', 108, 80), (2, 'A', 108, 160), (3, 'B', 88, 240), (4, 'B', 68, 80);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_188
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_188
ORDER BY id;
----
1 0 160 80
2 80 240 240
3 160 80 480
4 240 -1 560

statement ok
DROP TABLE win_t_188;
