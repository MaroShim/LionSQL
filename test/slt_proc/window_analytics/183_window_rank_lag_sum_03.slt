# test/slt_proc/window_analytics/183_window_rank_lag_sum_03.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (3)

statement ok
CREATE TABLE win_t_183 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_183 VALUES (1, 'A', 103, 30), (2, 'A', 103, 60), (3, 'B', 83, 90), (4, 'B', 63, 30);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_183
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_183
ORDER BY id;
----
1 0 60 30
2 30 90 90
3 60 30 180
4 90 -1 210

statement ok
DROP TABLE win_t_183;
