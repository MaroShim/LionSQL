# test/slt_proc/window_analytics/2543_rank_denserank_lag_lead_003.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (3)

statement ok
CREATE TABLE win_scores_2543 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2543 VALUES
(1, 'D1', 30),
(2, 'D1', 30),
(3, 'D1', 75);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -30) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2543
ORDER BY id;
----
1 1 1 1 -30 30
2 2 1 1 30 60
3 3 3 2 30 135

statement ok
DROP TABLE win_scores_2543;
