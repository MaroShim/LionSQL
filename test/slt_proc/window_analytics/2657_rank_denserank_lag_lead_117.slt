# test/slt_proc/window_analytics/2657_rank_denserank_lag_lead_117.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (117)

statement ok
CREATE TABLE win_scores_2657 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2657 VALUES
(1, 'D1', 1170),
(2, 'D1', 1170),
(3, 'D1', 2925);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1170) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2657
ORDER BY id;
----
1 1 1 1 -1170 1170
2 2 1 1 1170 2340
3 3 3 2 1170 5265

statement ok
