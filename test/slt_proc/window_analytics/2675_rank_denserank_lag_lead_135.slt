# test/slt_proc/window_analytics/2675_rank_denserank_lag_lead_135.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (135)

statement ok
CREATE TABLE win_scores_2675 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2675 VALUES
(1, 'D1', 1350),
(2, 'D1', 1350),
(3, 'D1', 3375);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1350) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2675
ORDER BY id;
----
1 1 1 1 -1350 1350
2 2 1 1 1350 2700
3 3 3 2 1350 6075

statement ok
DROP TABLE win_scores_2675;
