# test/slt_proc/window_analytics/2547_rank_denserank_lag_lead_007.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (7)

statement ok
CREATE TABLE win_scores_2547 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2547 VALUES
(1, 'D1', 70),
(2, 'D1', 70),
(3, 'D1', 175);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -70) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2547
ORDER BY id;
----
1 1 1 1 -70 70
2 2 1 1 70 140
3 3 3 2 70 315

statement ok
DROP TABLE win_scores_2547;
