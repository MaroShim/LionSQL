# test/slt_proc/window_analytics/190_window_rank_lag_sum_10.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (10)

statement ok
CREATE TABLE win_t_190 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_190 VALUES (1, 'A', 110, 100), (2, 'A', 110, 200), (3, 'B', 90, 300), (4, 'B', 70, 100);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_190
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_190
ORDER BY id;
----
1 0 200 100
2 100 300 300
3 200 100 600
4 300 -1 700

statement ok
DROP TABLE win_t_190;
