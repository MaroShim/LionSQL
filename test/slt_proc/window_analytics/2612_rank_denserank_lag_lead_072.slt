# test/slt_proc/window_analytics/2612_rank_denserank_lag_lead_072.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (72)

statement ok
CREATE TABLE win_scores_2612 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2612 VALUES
(1, 'D1', 720),
(2, 'D1', 720),
(3, 'D1', 1800);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -720) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2612
ORDER BY id;
----
1 1 1 1 -720 720
2 2 1 1 720 1440
3 3 3 2 720 3240

statement ok
DROP TABLE win_scores_2612;
