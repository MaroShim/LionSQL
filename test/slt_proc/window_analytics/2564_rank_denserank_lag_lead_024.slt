# test/slt_proc/window_analytics/2564_rank_denserank_lag_lead_024.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (24)

statement ok
CREATE TABLE win_scores_2564 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2564 VALUES
(1, 'D1', 240),
(2, 'D1', 240),
(3, 'D1', 600);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -240) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2564
ORDER BY id;
----
1 1 1 1 -240 240
2 2 1 1 240 480
3 3 3 2 240 1080

statement ok
DROP TABLE win_scores_2564;
