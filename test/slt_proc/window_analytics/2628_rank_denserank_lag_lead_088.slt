# test/slt_proc/window_analytics/2628_rank_denserank_lag_lead_088.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (88)

statement ok
CREATE TABLE win_scores_2628 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2628 VALUES
(1, 'D1', 880),
(2, 'D1', 880),
(3, 'D1', 2200);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -880) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2628
ORDER BY id;
----
1 1 1 1 -880 880
2 2 1 1 880 1760
3 3 3 2 880 3960

statement ok
DROP TABLE win_scores_2628;
