# test/slt_proc/window_analytics/939_partition_window_lead_lag_19.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (19)

statement ok
CREATE TABLE w_part_939 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_939 VALUES
(1, 'G1', 190),
(2, 'G1', 380),
(3, 'G2', 285),
(4, 'G2', 570);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1900) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1900) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_939
ORDER BY id;
----
1 G1 1 -1900 380
2 G1 2 190 -1900
3 G2 1 -1900 570
4 G2 2 285 -1900

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_939
ORDER BY id;
----
1 190 2
2 570 2
3 285 2
4 855 2

statement ok
DROP TABLE w_part_939;
