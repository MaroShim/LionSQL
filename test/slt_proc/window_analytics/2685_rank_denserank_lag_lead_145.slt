# test/slt_proc/window_analytics/2685_rank_denserank_lag_lead_145.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (145)

statement ok
CREATE TABLE win_scores_2685 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2685 VALUES
(1, 'D1', 1450),
(2, 'D1', 1450),
(3, 'D1', 3625);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1450) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2685
ORDER BY id;
----
1 1 1 1 -1450 1450
2 2 1 1 1450 2900
3 3 3 2 1450 6525

statement ok
DROP TABLE win_scores_2685;
