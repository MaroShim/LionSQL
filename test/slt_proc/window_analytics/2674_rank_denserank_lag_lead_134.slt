# test/slt_proc/window_analytics/2674_rank_denserank_lag_lead_134.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (134)

statement ok
CREATE TABLE win_scores_2674 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2674 VALUES
(1, 'D1', 1340),
(2, 'D1', 1340),
(3, 'D1', 3350);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1340) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2674
ORDER BY id;
----
1 1 1 1 -1340 1340
2 2 1 1 1340 2680
3 3 3 2 1340 6030

statement ok
DROP TABLE win_scores_2674;
