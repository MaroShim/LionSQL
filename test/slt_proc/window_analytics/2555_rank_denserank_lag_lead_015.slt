# test/slt_proc/window_analytics/2555_rank_denserank_lag_lead_015.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (15)

statement ok
CREATE TABLE win_scores_2555 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2555 VALUES
(1, 'D1', 150),
(2, 'D1', 150),
(3, 'D1', 375);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -150) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2555
ORDER BY id;
----
1 1 1 1 -150 150
2 2 1 1 150 300
3 3 3 2 150 675

statement ok
DROP TABLE win_scores_2555;
