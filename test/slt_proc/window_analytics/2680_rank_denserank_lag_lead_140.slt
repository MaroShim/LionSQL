# test/slt_proc/window_analytics/2680_rank_denserank_lag_lead_140.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (140)

statement ok
CREATE TABLE win_scores_2680 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2680 VALUES
(1, 'D1', 1400),
(2, 'D1', 1400),
(3, 'D1', 3500);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1400) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2680
ORDER BY id;
----
1 1 1 1 -1400 1400
2 2 1 1 1400 2800
3 3 3 2 1400 6300

statement ok
DROP TABLE win_scores_2680;
