# test/slt_proc/window_analytics/2574_rank_denserank_lag_lead_034.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (34)

statement ok
CREATE TABLE win_scores_2574 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2574 VALUES
(1, 'D1', 340),
(2, 'D1', 340),
(3, 'D1', 850);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -340) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2574
ORDER BY id;
----
1 1 1 1 -340 340
2 2 1 1 340 680
3 3 3 2 340 1530

statement ok
DROP TABLE win_scores_2574;
