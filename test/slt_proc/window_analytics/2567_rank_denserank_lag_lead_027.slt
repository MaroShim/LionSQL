# test/slt_proc/window_analytics/2567_rank_denserank_lag_lead_027.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (27)

statement ok
CREATE TABLE win_scores_2567 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2567 VALUES
(1, 'D1', 270),
(2, 'D1', 270),
(3, 'D1', 675);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -270) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2567
ORDER BY id;
----
1 1 1 1 -270 270
2 2 1 1 270 540
3 3 3 2 270 1215

statement ok
DROP TABLE win_scores_2567;
