# test/slt_proc/window_analytics/2652_rank_denserank_lag_lead_112.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (112)

statement ok
CREATE TABLE win_scores_2652 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2652 VALUES
(1, 'D1', 1120),
(2, 'D1', 1120),
(3, 'D1', 2800);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1120) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2652
ORDER BY id;
----
1 1 1 1 -1120 1120
2 2 1 1 1120 2240
3 3 3 2 1120 5040

statement ok
DROP TABLE win_scores_2652;
