# test/slt_proc/window_analytics/2668_rank_denserank_lag_lead_128.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (128)

statement ok
CREATE TABLE win_scores_2668 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2668 VALUES
(1, 'D1', 1280),
(2, 'D1', 1280),
(3, 'D1', 3200);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1280) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2668
ORDER BY id;
----
1 1 1 1 -1280 1280
2 2 1 1 1280 2560
3 3 3 2 1280 5760

statement ok
DROP TABLE win_scores_2668;
