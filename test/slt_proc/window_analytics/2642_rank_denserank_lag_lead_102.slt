# test/slt_proc/window_analytics/2642_rank_denserank_lag_lead_102.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (102)

statement ok
CREATE TABLE win_scores_2642 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2642 VALUES
(1, 'D1', 1020),
(2, 'D1', 1020),
(3, 'D1', 2550);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1020) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2642
ORDER BY id;
----
1 1 1 1 -1020 1020
2 2 1 1 1020 2040
3 3 3 2 1020 4590

statement ok
