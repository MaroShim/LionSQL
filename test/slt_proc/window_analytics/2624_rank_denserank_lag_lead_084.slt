# test/slt_proc/window_analytics/2624_rank_denserank_lag_lead_084.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (84)

statement ok
CREATE TABLE win_scores_2624 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2624 VALUES
(1, 'D1', 840),
(2, 'D1', 840),
(3, 'D1', 2100);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -840) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2624
ORDER BY id;
----
1 1 1 1 -840 840
2 2 1 1 840 1680
3 3 3 2 840 3780

statement ok
DROP TABLE win_scores_2624;
