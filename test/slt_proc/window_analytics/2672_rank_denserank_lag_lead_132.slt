# test/slt_proc/window_analytics/2672_rank_denserank_lag_lead_132.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (132)

statement ok
CREATE TABLE win_scores_2672 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2672 VALUES
(1, 'D1', 1320),
(2, 'D1', 1320),
(3, 'D1', 3300);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1320) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2672
ORDER BY id;
----
1 1 1 1 -1320 1320
2 2 1 1 1320 2640
3 3 3 2 1320 5940

statement ok
DROP TABLE win_scores_2672;
