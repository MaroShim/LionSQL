# test/slt_proc/window_analytics/2596_rank_denserank_lag_lead_056.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (56)

statement ok
CREATE TABLE win_scores_2596 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2596 VALUES
(1, 'D1', 560),
(2, 'D1', 560),
(3, 'D1', 1400);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -560) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2596
ORDER BY id;
----
1 1 1 1 -560 560
2 2 1 1 560 1120
3 3 3 2 560 2520

statement ok
DROP TABLE win_scores_2596;
