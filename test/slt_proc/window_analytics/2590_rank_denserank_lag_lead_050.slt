# test/slt_proc/window_analytics/2590_rank_denserank_lag_lead_050.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (50)

statement ok
CREATE TABLE win_scores_2590 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2590 VALUES
(1, 'D1', 500),
(2, 'D1', 500),
(3, 'D1', 1250);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -500) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2590
ORDER BY id;
----
1 1 1 1 -500 500
2 2 1 1 500 1000
3 3 3 2 500 2250

statement ok
DROP TABLE win_scores_2590;
