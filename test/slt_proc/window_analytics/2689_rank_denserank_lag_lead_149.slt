# test/slt_proc/window_analytics/2689_rank_denserank_lag_lead_149.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (149)

statement ok
CREATE TABLE win_scores_2689 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2689 VALUES
(1, 'D1', 1490),
(2, 'D1', 1490),
(3, 'D1', 3725);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1490) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2689
ORDER BY id;
----
1 1 1 1 -1490 1490
2 2 1 1 1490 2980
3 3 3 2 1490 6705

statement ok
DROP TABLE win_scores_2689;
