# test/slt_proc/window_analytics/182_window_rank_lag_sum_02.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (2)

statement ok
CREATE TABLE win_t_182 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_182 VALUES (1, 'A', 102, 20), (2, 'A', 102, 40), (3, 'B', 82, 60), (4, 'B', 62, 20);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_182
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_182
ORDER BY id;
----
1 0 40 20
2 20 60 60
3 40 20 120
4 60 -1 140

statement ok
DROP TABLE win_t_182;
