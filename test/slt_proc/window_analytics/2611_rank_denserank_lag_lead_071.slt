# test/slt_proc/window_analytics/2611_rank_denserank_lag_lead_071.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (71)

statement ok
CREATE TABLE win_scores_2611 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2611 VALUES
(1, 'D1', 710),
(2, 'D1', 710),
(3, 'D1', 1775);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -710) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2611
ORDER BY id;
----
1 1 1 1 -710 710
2 2 1 1 710 1420
3 3 3 2 710 3195

statement ok
DROP TABLE win_scores_2611;
