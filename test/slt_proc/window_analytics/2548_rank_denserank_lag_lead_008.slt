# test/slt_proc/window_analytics/2548_rank_denserank_lag_lead_008.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (8)

statement ok
CREATE TABLE win_scores_2548 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2548 VALUES
(1, 'D1', 80),
(2, 'D1', 80),
(3, 'D1', 200);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -80) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2548
ORDER BY id;
----
1 1 1 1 -80 80
2 2 1 1 80 160
3 3 3 2 80 360

statement ok
DROP TABLE win_scores_2548;
