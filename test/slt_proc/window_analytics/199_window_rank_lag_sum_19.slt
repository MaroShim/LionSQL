# test/slt_proc/window_analytics/199_window_rank_lag_sum_19.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (19)

statement ok
CREATE TABLE win_t_199 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_199 VALUES (1, 'A', 119, 190), (2, 'A', 119, 380), (3, 'B', 99, 570), (4, 'B', 79, 190);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_199
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_199
ORDER BY id;
----
1 0 380 190
2 190 570 570
3 380 190 1140
4 570 -1 1330

statement ok
DROP TABLE win_t_199;
