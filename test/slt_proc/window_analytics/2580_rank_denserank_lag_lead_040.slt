# test/slt_proc/window_analytics/2580_rank_denserank_lag_lead_040.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (40)

statement ok
CREATE TABLE win_scores_2580 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2580 VALUES
(1, 'D1', 400),
(2, 'D1', 400),
(3, 'D1', 1000);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -400) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2580
ORDER BY id;
----
1 1 1 1 -400 400
2 2 1 1 400 800
3 3 3 2 400 1800

statement ok
DROP TABLE win_scores_2580;
