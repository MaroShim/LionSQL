# test/slt_proc/window_analytics/2663_rank_denserank_lag_lead_123.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (123)

statement ok
CREATE TABLE win_scores_2663 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2663 VALUES
(1, 'D1', 1230),
(2, 'D1', 1230),
(3, 'D1', 3075);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1230) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2663
ORDER BY id;
----
1 1 1 1 -1230 1230
2 2 1 1 1230 2460
3 3 3 2 1230 5535

statement ok
