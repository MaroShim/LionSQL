# test/slt_proc/window_analytics/2690_rank_denserank_lag_lead_150.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (150)

statement ok
CREATE TABLE win_scores_2690 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2690 VALUES
(1, 'D1', 1500),
(2, 'D1', 1500),
(3, 'D1', 3750);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1500) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2690
ORDER BY id;
----
1 1 1 1 -1500 1500
2 2 1 1 1500 3000
3 3 3 2 1500 6750

statement ok
DROP TABLE win_scores_2690;
