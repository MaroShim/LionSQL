# test/slt_proc/window_analytics/201_window_rank_lag_sum_21.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (21)

statement ok
CREATE TABLE win_t_201 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_201 VALUES (1, 'A', 121, 210), (2, 'A', 121, 420), (3, 'B', 101, 630), (4, 'B', 81, 210);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_201
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_201
ORDER BY id;
----
1 0 420 210
2 210 630 630
3 420 210 1260
4 630 -1 1470

statement ok
DROP TABLE win_t_201;
