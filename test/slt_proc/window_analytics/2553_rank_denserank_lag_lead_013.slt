# test/slt_proc/window_analytics/2553_rank_denserank_lag_lead_013.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (13)

statement ok
CREATE TABLE win_scores_2553 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2553 VALUES
(1, 'D1', 130),
(2, 'D1', 130),
(3, 'D1', 325);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -130) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2553
ORDER BY id;
----
1 1 1 1 -130 130
2 2 1 1 130 260
3 3 3 2 130 585

statement ok
DROP TABLE win_scores_2553;
