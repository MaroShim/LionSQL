# test/slt_proc/window_analytics/2560_rank_denserank_lag_lead_020.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (20)

statement ok
CREATE TABLE win_scores_2560 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2560 VALUES
(1, 'D1', 200),
(2, 'D1', 200),
(3, 'D1', 500);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -200) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2560
ORDER BY id;
----
1 1 1 1 -200 200
2 2 1 1 200 400
3 3 3 2 200 900

statement ok
DROP TABLE win_scores_2560;
