# test/slt_proc/window_analytics/2602_rank_denserank_lag_lead_062.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (62)

statement ok
CREATE TABLE win_scores_2602 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2602 VALUES
(1, 'D1', 620),
(2, 'D1', 620),
(3, 'D1', 1550);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -620) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2602
ORDER BY id;
----
1 1 1 1 -620 620
2 2 1 1 620 1240
3 3 3 2 620 2790

statement ok
DROP TABLE win_scores_2602;
