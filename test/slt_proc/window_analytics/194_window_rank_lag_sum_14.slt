# test/slt_proc/window_analytics/194_window_rank_lag_sum_14.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (14)

statement ok
CREATE TABLE win_t_194 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_194 VALUES (1, 'A', 114, 140), (2, 'A', 114, 280), (3, 'B', 94, 420), (4, 'B', 74, 140);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_194
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_194
ORDER BY id;
----
1 0 280 140
2 140 420 420
3 280 140 840
4 420 -1 980

statement ok
DROP TABLE win_t_194;
