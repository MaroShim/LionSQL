# test/slt_proc/window_analytics/193_window_rank_lag_sum_13.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (13)

statement ok
CREATE TABLE win_t_193 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_193 VALUES (1, 'A', 113, 130), (2, 'A', 113, 260), (3, 'B', 93, 390), (4, 'B', 73, 130);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_193
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_193
ORDER BY id;
----
1 0 260 130
2 130 390 390
3 260 130 780
4 390 -1 910

statement ok
DROP TABLE win_t_193;
