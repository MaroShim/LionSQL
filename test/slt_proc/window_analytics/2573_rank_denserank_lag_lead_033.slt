# test/slt_proc/window_analytics/2573_rank_denserank_lag_lead_033.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (33)

statement ok
CREATE TABLE win_scores_2573 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2573 VALUES
(1, 'D1', 330),
(2, 'D1', 330),
(3, 'D1', 825);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -330) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2573
ORDER BY id;
----
1 1 1 1 -330 330
2 2 1 1 330 660
3 3 3 2 330 1485

statement ok
DROP TABLE win_scores_2573;
