# test/slt_proc/window_analytics/2597_rank_denserank_lag_lead_057.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (57)

statement ok
CREATE TABLE win_scores_2597 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2597 VALUES
(1, 'D1', 570),
(2, 'D1', 570),
(3, 'D1', 1425);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -570) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2597
ORDER BY id;
----
1 1 1 1 -570 570
2 2 1 1 570 1140
3 3 3 2 570 2565

statement ok
DROP TABLE win_scores_2597;
