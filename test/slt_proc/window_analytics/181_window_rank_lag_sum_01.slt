# test/slt_proc/window_analytics/181_window_rank_lag_sum_01.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (1)

statement ok
CREATE TABLE win_t_181 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_181 VALUES (1, 'A', 101, 10), (2, 'A', 101, 20), (3, 'B', 81, 30), (4, 'B', 61, 10);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_181
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_181
ORDER BY id;
----
1 0 20 10
2 10 30 30
3 20 10 60
4 30 -1 70

statement ok
DROP TABLE win_t_181;
