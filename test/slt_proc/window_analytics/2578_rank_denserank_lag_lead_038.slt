# test/slt_proc/window_analytics/2578_rank_denserank_lag_lead_038.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (38)

statement ok
CREATE TABLE win_scores_2578 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2578 VALUES
(1, 'D1', 380),
(2, 'D1', 380),
(3, 'D1', 950);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -380) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2578
ORDER BY id;
----
1 1 1 1 -380 380
2 2 1 1 380 760
3 3 3 2 380 1710

statement ok
DROP TABLE win_scores_2578;
