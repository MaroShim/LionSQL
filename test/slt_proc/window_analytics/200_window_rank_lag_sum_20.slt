# test/slt_proc/window_analytics/200_window_rank_lag_sum_20.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (20)

statement ok
CREATE TABLE win_t_200 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_200 VALUES (1, 'A', 120, 200), (2, 'A', 120, 400), (3, 'B', 100, 600), (4, 'B', 80, 200);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_200
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_200
ORDER BY id;
----
1 0 400 200
2 200 600 600
3 400 200 1200
4 600 -1 1400

statement ok
DROP TABLE win_t_200;
