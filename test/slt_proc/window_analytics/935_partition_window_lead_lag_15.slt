# test/slt_proc/window_analytics/935_partition_window_lead_lag_15.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (15)

statement ok
CREATE TABLE w_part_935 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_935 VALUES
(1, 'G1', 150),
(2, 'G1', 300),
(3, 'G2', 225),
(4, 'G2', 450);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -1500) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -1500) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_935
ORDER BY id;
----
1 G1 1 -1500 300
2 G1 2 150 -1500
3 G2 1 -1500 450
4 G2 2 225 -1500

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_935
ORDER BY id;
----
1 150 2
2 450 2
3 225 2
4 675 2

statement ok
DROP TABLE w_part_935;
