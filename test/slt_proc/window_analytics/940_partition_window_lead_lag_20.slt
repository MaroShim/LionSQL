# test/slt_proc/window_analytics/940_partition_window_lead_lag_20.slt
# T-SQL PARTITION BY windowing, ROW_NUMBER, SUM OVER, LEAD/LAG negative defaults (20)

statement ok
CREATE TABLE w_part_940 (id INT PRIMARY KEY, grp VARCHAR(10), amt INT);

statement ok
INSERT INTO w_part_940 VALUES
(1, 'G1', 200),
(2, 'G1', 400),
(3, 'G2', 300),
(4, 'G2', 600);

query ITIII
SELECT id, grp,
       ROW_NUMBER() OVER (PARTITION BY grp ORDER BY id),
       LAG(amt, 1, -2000) OVER (PARTITION BY grp ORDER BY id),
       LEAD(amt, 1, -2000) OVER (PARTITION BY grp ORDER BY id)
FROM w_part_940
ORDER BY id;
----
1 G1 1 -2000 400
2 G1 2 200 -2000
3 G2 1 -2000 600
4 G2 2 300 -2000

query III
SELECT id, SUM(amt) OVER (PARTITION BY grp ORDER BY id), COUNT(*) OVER (PARTITION BY grp)
FROM w_part_940
ORDER BY id;
----
1 200 2
2 600 2
3 300 2
4 900 2

statement ok
DROP TABLE w_part_940;
