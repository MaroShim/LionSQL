# test/slt_proc/window_analytics/2557_rank_denserank_lag_lead_017.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (17)

statement ok
CREATE TABLE win_scores_2557 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2557 VALUES
(1, 'D1', 170),
(2, 'D1', 170),
(3, 'D1', 425);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -170) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2557
ORDER BY id;
----
1 1 1 1 -170 170
2 2 1 1 170 340
3 3 3 2 170 765

statement ok
DROP TABLE win_scores_2557;
