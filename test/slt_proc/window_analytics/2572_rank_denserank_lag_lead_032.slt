# test/slt_proc/window_analytics/2572_rank_denserank_lag_lead_032.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (32)

statement ok
CREATE TABLE win_scores_2572 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2572 VALUES
(1, 'D1', 320),
(2, 'D1', 320),
(3, 'D1', 800);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -320) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2572
ORDER BY id;
----
1 1 1 1 -320 320
2 2 1 1 320 640
3 3 3 2 320 1440

statement ok
DROP TABLE win_scores_2572;
