# test/slt_proc/window_analytics/2656_rank_denserank_lag_lead_116.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (116)

statement ok
CREATE TABLE win_scores_2656 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2656 VALUES
(1, 'D1', 1160),
(2, 'D1', 1160),
(3, 'D1', 2900);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1160) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2656
ORDER BY id;
----
1 1 1 1 -1160 1160
2 2 1 1 1160 2320
3 3 3 2 1160 5220

statement ok
