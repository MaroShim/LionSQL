# test/slt_proc/window_analytics/187_window_rank_lag_sum_07.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (7)

statement ok
CREATE TABLE win_t_187 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_187 VALUES (1, 'A', 107, 70), (2, 'A', 107, 140), (3, 'B', 87, 210), (4, 'B', 67, 70);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_187
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_187
ORDER BY id;
----
1 0 140 70
2 70 210 210
3 140 70 420
4 210 -1 490

statement ok
DROP TABLE win_t_187;
