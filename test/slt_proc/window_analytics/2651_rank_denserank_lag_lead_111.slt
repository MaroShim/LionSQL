# test/slt_proc/window_analytics/2651_rank_denserank_lag_lead_111.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (111)

statement ok
CREATE TABLE win_scores_2651 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2651 VALUES
(1, 'D1', 1110),
(2, 'D1', 1110),
(3, 'D1', 2775);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1110) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2651
ORDER BY id;
----
1 1 1 1 -1110 1110
2 2 1 1 1110 2220
3 3 3 2 1110 4995

statement ok
DROP TABLE win_scores_2651;
