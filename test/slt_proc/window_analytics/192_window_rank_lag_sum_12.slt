# test/slt_proc/window_analytics/192_window_rank_lag_sum_12.slt
# T-SQL ROW_NUMBER, RANK, DENSE_RANK, LAG, LEAD, SUM OVER (12)

statement ok
CREATE TABLE win_t_192 (id INT PRIMARY KEY, dept VARCHAR(10), score INT, val INT);

statement ok
INSERT INTO win_t_192 VALUES (1, 'A', 112, 120), (2, 'A', 112, 240), (3, 'B', 92, 360), (4, 'B', 72, 120);

query IIII
SELECT id, ROW_NUMBER() OVER (ORDER BY id), RANK() OVER (ORDER BY score DESC), DENSE_RANK() OVER (ORDER BY score DESC)
FROM win_t_192
ORDER BY id;
----
1 1 1 1
2 2 1 1
3 3 3 2
4 4 4 3

query IIII
SELECT id, LAG(val, 1, 0) OVER (ORDER BY id), LEAD(val, 1, -1) OVER (ORDER BY id), SUM(val) OVER (ORDER BY id)
FROM win_t_192
ORDER BY id;
----
1 0 240 120
2 120 360 360
3 240 120 720
4 360 -1 840

statement ok
DROP TABLE win_t_192;
