# test/slt_proc/window_analytics/2604_rank_denserank_lag_lead_064.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (64)

statement ok
CREATE TABLE win_scores_2604 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2604 VALUES
(1, 'D1', 640),
(2, 'D1', 640),
(3, 'D1', 1600);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -640) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2604
ORDER BY id;
----
1 1 1 1 -640 640
2 2 1 1 640 1280
3 3 3 2 640 2880

statement ok
DROP TABLE win_scores_2604;
