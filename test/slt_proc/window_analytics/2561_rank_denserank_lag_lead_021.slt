# test/slt_proc/window_analytics/2561_rank_denserank_lag_lead_021.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (21)

statement ok
CREATE TABLE win_scores_2561 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2561 VALUES
(1, 'D1', 210),
(2, 'D1', 210),
(3, 'D1', 525);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -210) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2561
ORDER BY id;
----
1 1 1 1 -210 210
2 2 1 1 210 420
3 3 3 2 210 945

statement ok
DROP TABLE win_scores_2561;
