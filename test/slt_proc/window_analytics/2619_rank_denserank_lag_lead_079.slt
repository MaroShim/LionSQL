# test/slt_proc/window_analytics/2619_rank_denserank_lag_lead_079.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (79)

statement ok
CREATE TABLE win_scores_2619 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2619 VALUES
(1, 'D1', 790),
(2, 'D1', 790),
(3, 'D1', 1975);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -790) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2619
ORDER BY id;
----
1 1 1 1 -790 790
2 2 1 1 790 1580
3 3 3 2 790 3555

statement ok
DROP TABLE win_scores_2619;
