# test/slt_proc/window_analytics/2613_rank_denserank_lag_lead_073.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (73)

statement ok
CREATE TABLE win_scores_2613 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2613 VALUES
(1, 'D1', 730),
(2, 'D1', 730),
(3, 'D1', 1825);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -730) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2613
ORDER BY id;
----
1 1 1 1 -730 730
2 2 1 1 730 1460
3 3 3 2 730 3285

statement ok
DROP TABLE win_scores_2613;
