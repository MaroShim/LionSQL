# test/slt_proc/window_analytics/2621_rank_denserank_lag_lead_081.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (81)

statement ok
CREATE TABLE win_scores_2621 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2621 VALUES
(1, 'D1', 810),
(2, 'D1', 810),
(3, 'D1', 2025);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -810) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2621
ORDER BY id;
----
1 1 1 1 -810 810
2 2 1 1 810 1620
3 3 3 2 810 3645

statement ok
DROP TABLE win_scores_2621;
