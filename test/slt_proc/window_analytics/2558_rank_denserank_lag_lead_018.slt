# test/slt_proc/window_analytics/2558_rank_denserank_lag_lead_018.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (18)

statement ok
CREATE TABLE win_scores_2558 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2558 VALUES
(1, 'D1', 180),
(2, 'D1', 180),
(3, 'D1', 450);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -180) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2558
ORDER BY id;
----
1 1 1 1 -180 180
2 2 1 1 180 360
3 3 3 2 180 810

statement ok
DROP TABLE win_scores_2558;
