# test/slt_proc/window_analytics/2681_rank_denserank_lag_lead_141.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (141)

statement ok
CREATE TABLE win_scores_2681 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2681 VALUES
(1, 'D1', 1410),
(2, 'D1', 1410),
(3, 'D1', 3525);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -1410) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2681
ORDER BY id;
----
1 1 1 1 -1410 1410
2 2 1 1 1410 2820
3 3 3 2 1410 6345

statement ok
DROP TABLE win_scores_2681;
