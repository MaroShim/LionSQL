# test/slt_proc/window_analytics/2631_rank_denserank_lag_lead_091.slt
# T-SQL RANK, DENSE_RANK, ROW_NUMBER, LAG/LEAD with negative default, running SUM (91)

statement ok
CREATE TABLE win_scores_2631 (id INT PRIMARY KEY, dept VARCHAR(10), score INT);

statement ok
INSERT INTO win_scores_2631 VALUES
(1, 'D1', 910),
(2, 'D1', 910),
(3, 'D1', 2275);

query IIIIII
SELECT id,
       ROW_NUMBER() OVER (PARTITION BY dept ORDER BY score, id),
       RANK() OVER (PARTITION BY dept ORDER BY score),
       DENSE_RANK() OVER (PARTITION BY dept ORDER BY score),
       LAG(score, 1, -910) OVER (PARTITION BY dept ORDER BY id),
       SUM(score) OVER (PARTITION BY dept ORDER BY id)
FROM win_scores_2631
ORDER BY id;
----
1 1 1 1 -910 910
2 2 1 1 910 1820
3 3 3 2 910 4095

statement ok
DROP TABLE win_scores_2631;
