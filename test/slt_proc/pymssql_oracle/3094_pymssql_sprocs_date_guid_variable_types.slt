statement ok
CREATE PROCEDURE pymssqlTestDate @i date, @o date output AS BEGIN SET @o = @i; SELECT @o; END

query T
DECLARE @dt date; EXEC pymssqlTestDate '2026-03-31', @dt OUTPUT; SELECT @dt;
----
2026-03-31

