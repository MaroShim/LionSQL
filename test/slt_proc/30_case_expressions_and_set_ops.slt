# test/slt_proc/30_case_expressions_and_set_ops.slt
# CASE expressions and UNION ALL/EXCEPT/INTERSECT at top level

statement ok
CREATE PROCEDURE sp_grade @score INT
AS
BEGIN
    SELECT CASE WHEN @score >= 90 THEN 'A' WHEN @score >= 80 THEN 'B' ELSE 'C' END;
END;

query T
EXEC sp_grade 95;
----
A

query T
EXEC sp_grade 85;
----
B

query T
EXEC sp_grade 10;
----
C

query I
SELECT 1 UNION ALL SELECT 1 ORDER BY 1;
----
1
1

query I
SELECT 1 EXCEPT SELECT 2;
----
1

query I
SELECT 2 INTERSECT SELECT 2;
----
2

statement ok
CREATE PROCEDURE sp_setops
AS
BEGIN
    SELECT 1 AS v UNION SELECT 2 AS v UNION SELECT 2 AS v ORDER BY 1;
END;

query I
EXEC sp_setops;
----
1
2

statement ok
CREATE PROCEDURE sp_union_all @a INT, @b INT
AS
BEGIN
    SELECT @a AS v UNION ALL SELECT @b AS v ORDER BY 1;
END;

query I
EXEC sp_union_all 5, 5;
----
5
5

statement ok
DROP PROCEDURE sp_setops;

statement ok
DROP PROCEDURE sp_union_all;

query T
SELECT CASE 2 WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE 'many' END;
----
two

query I
SELECT CASE WHEN 1 = 2 THEN 10 END IS NULL;
----
1
