query ITI
SELECT 
    c.CustomerID,
    c.LastName,
    COUNT(h.SalesOrderID) AS TotalOrders
FROM [SalesLT].[Customer] c
INNER JOIN [SalesLT].[SalesOrderHeader] h ON c.CustomerID = h.CustomerID
GROUP BY c.CustomerID, c.LastName
ORDER BY c.CustomerID ASC;
----
1 Gee 1
2 Harris 1
3 Carreras 1

query TIIR
SELECT 
    h.SalesOrderNumber,
    d.SalesOrderDetailID,
    d.OrderQty,
    d.UnitPrice
FROM [SalesLT].[SalesOrderHeader] h
INNER JOIN [SalesLT].[SalesOrderDetail] d ON h.SalesOrderID = d.SalesOrderID
ORDER BY d.SalesOrderDetailID ASC;
----
SO71780 1 2 1200.000
SO71780 2 1 49.990
SO71781 3 1 1500.000
