# test/slt_proc/adventureworks_oracle/3102_adventureworks_orders_and_customers.slt
# Microsoft AdventureWorksLT Orders & Customers Business Suite

statement ok
CREATE TABLE [SalesLT].[Address] (
    [AddressID] INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [AddressLine1] VARCHAR(60) NOT NULL,
    [City] VARCHAR(30) NOT NULL,
    [StateProvince] VARCHAR(50) NOT NULL,
    [CountryRegion] VARCHAR(50) NOT NULL,
    [PostalCode] VARCHAR(15) NOT NULL
);

statement ok
CREATE TABLE [SalesLT].[Customer] (
    [CustomerID] INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [FirstName] VARCHAR(50) NOT NULL,
    [LastName] VARCHAR(50) NOT NULL,
    [CompanyName] VARCHAR(128) NULL,
    [EmailAddress] VARCHAR(50) NULL,
    [Phone] VARCHAR(25) NULL
);

statement ok
CREATE TABLE [SalesLT].[CustomerAddress] (
    [CustomerID] INT NOT NULL,
    [AddressID] INT NOT NULL,
    [AddressType] VARCHAR(50) NOT NULL,
    PRIMARY KEY ([CustomerID], [AddressID])
);

statement ok
CREATE TABLE [SalesLT].[Product] (
    [ProductID] INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [Name] VARCHAR(50) NOT NULL,
    [ProductNumber] VARCHAR(25) NOT NULL,
    [StandardCost] DECIMAL(18,4) NOT NULL,
    [ListPrice] DECIMAL(18,4) NOT NULL
);

statement ok
CREATE TABLE [SalesLT].[SalesOrderHeader] (
    [SalesOrderID] INT IDENTITY(1,1) NOT NULL PRIMARY KEY,
    [OrderDate] DATETIME NOT NULL,
    [SalesOrderNumber] VARCHAR(25) NOT NULL,
    [CustomerID] INT NOT NULL,
    [ShipToAddressID] INT NULL,
    [BillToAddressID] INT NULL,
    [TotalDue] DECIMAL(18,4) NOT NULL
);

statement ok
CREATE TABLE [SalesLT].[SalesOrderDetail] (
    [SalesOrderID] INT NOT NULL,
    [SalesOrderDetailID] INT IDENTITY(1,1) NOT NULL,
    [OrderQty] SMALLINT NOT NULL,
    [ProductID] INT NOT NULL,
    [UnitPrice] DECIMAL(18,4) NOT NULL,
    [LineTotal] DECIMAL(38,6) NOT NULL,
    PRIMARY KEY ([SalesOrderID], [SalesOrderDetailID])
);

