query TT
SELECT 
    p.Name AS ParentCategory,
    c.Name AS SubCategory
FROM [SalesLT].[ProductCategory] c
INNER JOIN [SalesLT].[ProductCategory] p ON c.ParentProductCategoryID = p.ProductCategoryID
ORDER BY c.Name ASC;
----
Bikes MountainBikes
Bikes RoadBikes
Bikes TouringBikes

query IT
WITH HighValueProducts AS (
    SELECT 
        ProductID,
        Name,
        ListPrice
    FROM [SalesLT].[Product]
    WHERE ListPrice > 1000.00
)
SELECT 
    ProductID,
    Name
FROM HighValueProducts
ORDER BY ProductID ASC;
----
1 Mountain-100
2 Road-150
3 Touring-1000
