# test/slt_proc/math_numeric/1866_sign_power_sqrt_divmod_096.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (96)

query IIIIII
SELECT SIGN(-96), SIGN(0), SIGN(96), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (1641 % 8);
----
-1 0 1 8 9 1

query III
SELECT (1641 / 8), ABS(-1641), (96 * 12 - 8);
----
205 1641 1144

statement ok
CREATE PROCEDURE sp_math_step_1866 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1866 @x = 1641, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
205 1
