# test/slt_proc/math_numeric/1845_sign_power_sqrt_divmod_075.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (75)

query IIIIII
SELECT SIGN(-75), SIGN(0), SIGN(75), CAST(SQRT(4) AS INT), CAST(POWER(2, 2) AS INT), (1284 % 8);
----
-1 0 1 2 4 4

query III
SELECT (1284 / 8), ABS(-1284), (75 * 12 - 8);
----
160 1284 892

statement ok
CREATE PROCEDURE sp_math_step_1845 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1845 @x = 1284, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
160 4
