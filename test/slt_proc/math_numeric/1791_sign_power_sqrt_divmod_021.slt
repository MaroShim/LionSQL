# test/slt_proc/math_numeric/1791_sign_power_sqrt_divmod_021.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (21)

query IIIIII
SELECT SIGN(-21), SIGN(0), SIGN(21), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (366 % 3);
----
-1 0 1 8 9 0

query III
SELECT (366 / 3), ABS(-366), (21 * 12 - 3);
----
122 366 249

statement ok
CREATE PROCEDURE sp_math_step_1791 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1791 @x = 366, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
122 0
