# test/slt_proc/math_numeric/1876_sign_power_sqrt_divmod_106.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (106)

query IIIIII
SELECT SIGN(-106), SIGN(0), SIGN(106), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (1811 % 4);
----
-1 0 1 3 27 3

query III
SELECT (1811 / 4), ABS(-1811), (106 * 12 - 4);
----
452 1811 1268

statement ok
CREATE PROCEDURE sp_math_step_1876 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1876 @x = 1811, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
452 3
