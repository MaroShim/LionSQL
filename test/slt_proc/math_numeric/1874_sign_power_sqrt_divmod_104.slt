# test/slt_proc/math_numeric/1874_sign_power_sqrt_divmod_104.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (104)

query IIIIII
SELECT SIGN(-104), SIGN(0), SIGN(104), CAST(SQRT(256) AS INT), CAST(POWER(6, 4) AS INT), (1777 % 9);
----
-1 0 1 16 1296 4

query III
SELECT (1777 / 9), ABS(-1777), (104 * 12 - 9);
----
197 1777 1239

statement ok
CREATE PROCEDURE sp_math_step_1874 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1874 @x = 1777, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
197 4
