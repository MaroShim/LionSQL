# test/slt_proc/math_numeric/1796_sign_power_sqrt_divmod_026.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (26)

query IIIIII
SELECT SIGN(-26), SIGN(0), SIGN(26), CAST(SQRT(169) AS INT), CAST(POWER(3, 4) AS INT), (451 % 8);
----
-1 0 1 13 81 3

query III
SELECT (451 / 8), ABS(-451), (26 * 12 - 8);
----
56 451 304

statement ok
CREATE PROCEDURE sp_math_step_1796 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1796 @x = 451, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
56 3
