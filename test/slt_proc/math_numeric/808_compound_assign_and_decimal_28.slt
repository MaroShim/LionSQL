# test/slt_proc/math_numeric/808_compound_assign_and_decimal_28.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (28)

statement ok
CREATE PROCEDURE sp_compound_math_808 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 89;
    SET @v *= 2;
    SET @v -= 35;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_808 280, @r OUTPUT;
SELECT @r;
----
703

query IIII
SELECT (253 & 115), (253 | 115), (253 ^ 115), ABS(-703);
----
113 255 142 703

statement ok
CREATE TABLE dec_t_808 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_808 VALUES (1, 280.25, 4), (2, 140.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_808 ORDER BY id;
----
1 1121
2 281

statement ok
DROP TABLE dec_t_808;
