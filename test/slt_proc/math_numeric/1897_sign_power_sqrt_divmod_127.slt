# test/slt_proc/math_numeric/1897_sign_power_sqrt_divmod_127.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (127)

query IIIIII
SELECT SIGN(-127), SIGN(0), SIGN(127), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (2168 % 4);
----
-1 0 1 9 64 0

query III
SELECT (2168 / 4), ABS(-2168), (127 * 12 - 4);
----
542 2168 1520

statement ok
CREATE PROCEDURE sp_math_step_1897 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1897 @x = 2168, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
542 0
