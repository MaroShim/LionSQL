# test/slt_proc/math_numeric/1783_sign_power_sqrt_divmod_013.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (13)

query IIIIII
SELECT SIGN(-13), SIGN(0), SIGN(13), CAST(SQRT(225) AS INT), CAST(POWER(5, 3) AS INT), (230 % 9);
----
-1 0 1 15 125 5

query III
SELECT (230 / 9), ABS(-230), (13 * 12 - 9);
----
25 230 147

statement ok
CREATE PROCEDURE sp_math_step_1783 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1783 @x = 230, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
25 5
