# test/slt_proc/math_numeric/1907_sign_power_sqrt_divmod_137.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (137)

query IIIIII
SELECT SIGN(-137), SIGN(0), SIGN(137), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (2338 % 7);
----
-1 0 1 4 256 0

query III
SELECT (2338 / 7), ABS(-2338), (137 * 12 - 7);
----
334 2338 1637

statement ok
CREATE PROCEDURE sp_math_step_1907 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1907 @x = 2338, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
334 0
