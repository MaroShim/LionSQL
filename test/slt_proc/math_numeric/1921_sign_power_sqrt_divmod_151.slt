# test/slt_proc/math_numeric/1921_sign_power_sqrt_divmod_151.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (151)

query IIIIII
SELECT SIGN(-151), SIGN(0), SIGN(151), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (2576 % 7);
----
-1 0 1 3 27 0

query III
SELECT (2576 / 7), ABS(-2576), (151 * 12 - 7);
----
368 2576 1805

statement ok
CREATE PROCEDURE sp_math_step_1921 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1921 @x = 2576, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
368 0
