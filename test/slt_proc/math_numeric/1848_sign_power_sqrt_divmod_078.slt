# test/slt_proc/math_numeric/1848_sign_power_sqrt_divmod_078.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (78)

query IIIIII
SELECT SIGN(-78), SIGN(0), SIGN(78), CAST(SQRT(25) AS INT), CAST(POWER(5, 2) AS INT), (1335 % 4);
----
-1 0 1 5 25 3

query III
SELECT (1335 / 4), ABS(-1335), (78 * 12 - 4);
----
333 1335 932

statement ok
CREATE PROCEDURE sp_math_step_1848 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1848 @x = 1335, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
333 3
