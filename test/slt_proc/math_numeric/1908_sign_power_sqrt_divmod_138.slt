# test/slt_proc/math_numeric/1908_sign_power_sqrt_divmod_138.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (138)

query IIIIII
SELECT SIGN(-138), SIGN(0), SIGN(138), CAST(SQRT(25) AS INT), CAST(POWER(5, 2) AS INT), (2355 % 8);
----
-1 0 1 5 25 3

query III
SELECT (2355 / 8), ABS(-2355), (138 * 12 - 8);
----
294 2355 1648

statement ok
CREATE PROCEDURE sp_math_step_1908 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1908 @x = 2355, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
294 3
