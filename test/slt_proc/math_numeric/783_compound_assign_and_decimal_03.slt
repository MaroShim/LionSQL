# test/slt_proc/math_numeric/783_compound_assign_and_decimal_03.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (3)

statement ok
CREATE PROCEDURE sp_compound_math_783 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 14;
    SET @v *= 5;
    SET @v -= 10;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_783 30, @r OUTPUT;
SELECT @r;
----
210

query IIII
SELECT (28 & 15), (28 | 15), (28 ^ 15), ABS(-210);
----
12 31 19 210

statement ok
CREATE TABLE dec_t_783 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_783 VALUES (1, 30.25, 4), (2, 15.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_783 ORDER BY id;
----
1 121
2 31

statement ok
DROP TABLE dec_t_783;
