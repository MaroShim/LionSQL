# test/slt_proc/math_numeric/072_numeric_and_bitwise_17.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (17)

query IIII
SELECT ABS(-228), SIGN(-228), CEILING(51.94), FLOOR(51.94);
----
228 -1 52 51

query RRR
SELECT POWER(4, 4), SQRT(289), ROUND(17.456, 2);
----
256.000 17.000 17.460

query III
SELECT 105 & 56, 105 | 56, 105 ^ 56;
----
40 121 81

statement ok
CREATE PROCEDURE sp_divmod_72 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_72 88, 19;
----
4 12 88
