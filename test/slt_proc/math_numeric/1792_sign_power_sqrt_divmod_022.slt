# test/slt_proc/math_numeric/1792_sign_power_sqrt_divmod_022.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (22)

query IIIIII
SELECT SIGN(-22), SIGN(0), SIGN(22), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (383 % 4);
----
-1 0 1 9 64 3

query III
SELECT (383 / 4), ABS(-383), (22 * 12 - 4);
----
95 383 260

statement ok
CREATE PROCEDURE sp_math_step_1792 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1792 @x = 383, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
95 3
