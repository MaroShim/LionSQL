# test/slt_proc/math_numeric/809_compound_assign_and_decimal_29.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (29)

statement ok
CREATE PROCEDURE sp_compound_math_809 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 92;
    SET @v *= 3;
    SET @v -= 36;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_809 290, @r OUTPUT;
SELECT @r;
----
1110

query IIII
SELECT (262 & 119), (262 | 119), (262 ^ 119), ABS(-1110);
----
6 375 369 1110

statement ok
CREATE TABLE dec_t_809 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_809 VALUES (1, 290.25, 4), (2, 145.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_809 ORDER BY id;
----
1 1161
2 291

statement ok
DROP TABLE dec_t_809;
