# test/slt_proc/math_numeric/1847_sign_power_sqrt_divmod_077.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (77)

query IIIIII
SELECT SIGN(-77), SIGN(0), SIGN(77), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (1318 % 3);
----
-1 0 1 4 256 1

query III
SELECT (1318 / 3), ABS(-1318), (77 * 12 - 3);
----
439 1318 921

statement ok
CREATE PROCEDURE sp_math_step_1847 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1847 @x = 1318, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
439 1
