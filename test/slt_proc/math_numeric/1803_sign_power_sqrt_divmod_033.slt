# test/slt_proc/math_numeric/1803_sign_power_sqrt_divmod_033.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (33)

query IIIIII
SELECT SIGN(-33), SIGN(0), SIGN(33), CAST(SQRT(25) AS INT), CAST(POWER(5, 2) AS INT), (570 % 8);
----
-1 0 1 5 25 2

query III
SELECT (570 / 8), ABS(-570), (33 * 12 - 8);
----
71 570 388

statement ok
CREATE PROCEDURE sp_math_step_1803 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1803 @x = 570, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
71 2
