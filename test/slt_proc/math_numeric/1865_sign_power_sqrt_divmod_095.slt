# test/slt_proc/math_numeric/1865_sign_power_sqrt_divmod_095.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (95)

query IIIIII
SELECT SIGN(-95), SIGN(0), SIGN(95), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (1624 % 7);
----
-1 0 1 7 16 0

query III
SELECT (1624 / 7), ABS(-1624), (95 * 12 - 7);
----
232 1624 1133

statement ok
CREATE PROCEDURE sp_math_step_1865 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1865 @x = 1624, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
232 0
