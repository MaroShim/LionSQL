# test/slt_proc/math_numeric/1780_sign_power_sqrt_divmod_010.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (10)

query IIIIII
SELECT SIGN(-10), SIGN(0), SIGN(10), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (179 % 6);
----
-1 0 1 12 8 5

query III
SELECT (179 / 6), ABS(-179), (10 * 12 - 6);
----
29 179 114

statement ok
CREATE PROCEDURE sp_math_step_1780 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1780 @x = 179, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
29 5
