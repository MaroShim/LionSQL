# test/slt_proc/math_numeric/791_compound_assign_and_decimal_11.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (11)

statement ok
CREATE PROCEDURE sp_compound_math_791 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 38;
    SET @v *= 5;
    SET @v -= 18;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_791 110, @r OUTPUT;
SELECT @r;
----
722

query IIII
SELECT (100 & 47), (100 | 47), (100 ^ 47), ABS(-722);
----
36 111 75 722

statement ok
CREATE TABLE dec_t_791 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_791 VALUES (1, 110.25, 4), (2, 55.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_791 ORDER BY id;
----
1 441
2 111

statement ok
DROP TABLE dec_t_791;
