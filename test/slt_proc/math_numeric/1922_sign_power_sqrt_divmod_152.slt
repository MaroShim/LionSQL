# test/slt_proc/math_numeric/1922_sign_power_sqrt_divmod_152.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (152)

query IIIIII
SELECT SIGN(-152), SIGN(0), SIGN(152), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (2593 % 8);
----
-1 0 1 4 256 1

query III
SELECT (2593 / 8), ABS(-2593), (152 * 12 - 8);
----
324 2593 1816

statement ok
CREATE PROCEDURE sp_math_step_1922 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1922 @x = 2593, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
324 1
