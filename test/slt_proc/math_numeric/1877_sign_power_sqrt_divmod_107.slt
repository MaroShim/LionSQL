# test/slt_proc/math_numeric/1877_sign_power_sqrt_divmod_107.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (107)

query IIIIII
SELECT SIGN(-107), SIGN(0), SIGN(107), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (1828 % 5);
----
-1 0 1 4 256 3

query III
SELECT (1828 / 5), ABS(-1828), (107 * 12 - 5);
----
365 1828 1279

statement ok
CREATE PROCEDURE sp_math_step_1877 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1877 @x = 1828, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
365 3
