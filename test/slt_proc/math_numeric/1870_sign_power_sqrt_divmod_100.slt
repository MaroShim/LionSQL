# test/slt_proc/math_numeric/1870_sign_power_sqrt_divmod_100.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (100)

query IIIIII
SELECT SIGN(-100), SIGN(0), SIGN(100), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (1709 % 5);
----
-1 0 1 12 8 4

query III
SELECT (1709 / 5), ABS(-1709), (100 * 12 - 5);
----
341 1709 1195

statement ok
CREATE PROCEDURE sp_math_step_1870 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1870 @x = 1709, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
341 4
