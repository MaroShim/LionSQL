# test/slt_proc/math_numeric/1775_sign_power_sqrt_divmod_005.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (5)

query IIIIII
SELECT SIGN(-5), SIGN(0), SIGN(5), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (94 % 8);
----
-1 0 1 7 16 6

query III
SELECT (94 / 8), ABS(-94), (5 * 12 - 8);
----
11 94 52

statement ok
CREATE PROCEDURE sp_math_step_1775 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1775 @x = 94, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
11 6
