# test/slt_proc/math_numeric/1839_sign_power_sqrt_divmod_069.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (69)

query IIIIII
SELECT SIGN(-69), SIGN(0), SIGN(69), CAST(SQRT(121) AS INT), CAST(POWER(6, 2) AS INT), (1182 % 9);
----
-1 0 1 11 36 3

query III
SELECT (1182 / 9), ABS(-1182), (69 * 12 - 9);
----
131 1182 819

statement ok
CREATE PROCEDURE sp_math_step_1839 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1839 @x = 1182, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
131 3
