# test/slt_proc/math_numeric/1885_sign_power_sqrt_divmod_115.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (115)

query IIIIII
SELECT SIGN(-115), SIGN(0), SIGN(115), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (1964 % 6);
----
-1 0 1 12 8 2

query III
SELECT (1964 / 6), ABS(-1964), (115 * 12 - 6);
----
327 1964 1374

statement ok
CREATE PROCEDURE sp_math_step_1885 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1885 @x = 1964, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
327 2
