# test/slt_proc/math_numeric/1815_sign_power_sqrt_divmod_045.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (45)

query IIIIII
SELECT SIGN(-45), SIGN(0), SIGN(45), CAST(SQRT(4) AS INT), CAST(POWER(2, 2) AS INT), (774 % 6);
----
-1 0 1 2 4 0

query III
SELECT (774 / 6), ABS(-774), (45 * 12 - 6);
----
129 774 534

statement ok
CREATE PROCEDURE sp_math_step_1815 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1815 @x = 774, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
129 0
