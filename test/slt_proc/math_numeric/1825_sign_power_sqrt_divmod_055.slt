# test/slt_proc/math_numeric/1825_sign_power_sqrt_divmod_055.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (55)

query IIIIII
SELECT SIGN(-55), SIGN(0), SIGN(55), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (944 % 9);
----
-1 0 1 12 8 8

query III
SELECT (944 / 9), ABS(-944), (55 * 12 - 9);
----
104 944 651

statement ok
CREATE PROCEDURE sp_math_step_1825 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1825 @x = 944, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
104 8
