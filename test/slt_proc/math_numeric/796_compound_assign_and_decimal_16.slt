# test/slt_proc/math_numeric/796_compound_assign_and_decimal_16.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (16)

statement ok
CREATE PROCEDURE sp_compound_math_796 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 53;
    SET @v *= 2;
    SET @v -= 23;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_796 160, @r OUTPUT;
SELECT @r;
----
403

query IIII
SELECT (145 & 67), (145 | 67), (145 ^ 67), ABS(-403);
----
1 211 210 403

statement ok
CREATE TABLE dec_t_796 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_796 VALUES (1, 160.25, 4), (2, 80.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_796 ORDER BY id;
----
1 641
2 161

statement ok
DROP TABLE dec_t_796;
