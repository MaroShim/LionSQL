# test/slt_proc/math_numeric/1858_sign_power_sqrt_divmod_088.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (88)

query IIIIII
SELECT SIGN(-88), SIGN(0), SIGN(88), CAST(SQRT(225) AS INT), CAST(POWER(5, 3) AS INT), (1505 % 7);
----
-1 0 1 15 125 0

query III
SELECT (1505 / 7), ABS(-1505), (88 * 12 - 7);
----
215 1505 1049

statement ok
CREATE PROCEDURE sp_math_step_1858 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1858 @x = 1505, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
215 0
