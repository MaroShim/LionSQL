# test/slt_proc/math_numeric/1893_sign_power_sqrt_divmod_123.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (123)

query IIIIII
SELECT SIGN(-123), SIGN(0), SIGN(123), CAST(SQRT(25) AS INT), CAST(POWER(5, 2) AS INT), (2100 % 7);
----
-1 0 1 5 25 0

query III
SELECT (2100 / 7), ABS(-2100), (123 * 12 - 7);
----
300 2100 1469

statement ok
CREATE PROCEDURE sp_math_step_1893 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1893 @x = 2100, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
300 0
