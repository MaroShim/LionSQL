# test/slt_proc/math_numeric/1804_sign_power_sqrt_divmod_034.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (34)

query IIIIII
SELECT SIGN(-34), SIGN(0), SIGN(34), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (587 % 9);
----
-1 0 1 6 216 2

query III
SELECT (587 / 9), ABS(-587), (34 * 12 - 9);
----
65 587 399

statement ok
CREATE PROCEDURE sp_math_step_1804 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1804 @x = 587, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
65 2
