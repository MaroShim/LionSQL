# test/slt_proc/math_numeric/1894_sign_power_sqrt_divmod_124.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (124)

query IIIIII
SELECT SIGN(-124), SIGN(0), SIGN(124), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (2117 % 8);
----
-1 0 1 6 216 5

query III
SELECT (2117 / 8), ABS(-2117), (124 * 12 - 8);
----
264 2117 1480

statement ok
CREATE PROCEDURE sp_math_step_1894 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1894 @x = 2117, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
264 5
