# test/slt_proc/math_numeric/1880_sign_power_sqrt_divmod_110.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (110)

query IIIIII
SELECT SIGN(-110), SIGN(0), SIGN(110), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (1879 % 8);
----
-1 0 1 7 16 7

query III
SELECT (1879 / 8), ABS(-1879), (110 * 12 - 8);
----
234 1879 1312

statement ok
CREATE PROCEDURE sp_math_step_1880 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1880 @x = 1879, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
234 7
