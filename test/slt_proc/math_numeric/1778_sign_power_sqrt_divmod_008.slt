# test/slt_proc/math_numeric/1778_sign_power_sqrt_divmod_008.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (8)

query IIIIII
SELECT SIGN(-8), SIGN(0), SIGN(8), CAST(SQRT(100) AS INT), CAST(POWER(5, 4) AS INT), (145 % 4);
----
-1 0 1 10 625 1

query III
SELECT (145 / 4), ABS(-145), (8 * 12 - 4);
----
36 145 92

statement ok
CREATE PROCEDURE sp_math_step_1778 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1778 @x = 145, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
36 1
