# test/slt_proc/math_numeric/1811_sign_power_sqrt_divmod_041.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (41)

query IIIIII
SELECT SIGN(-41), SIGN(0), SIGN(41), CAST(SQRT(169) AS INT), CAST(POWER(3, 4) AS INT), (706 % 9);
----
-1 0 1 13 81 4

query III
SELECT (706 / 9), ABS(-706), (41 * 12 - 9);
----
78 706 483

statement ok
CREATE PROCEDURE sp_math_step_1811 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1811 @x = 706, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
78 4
