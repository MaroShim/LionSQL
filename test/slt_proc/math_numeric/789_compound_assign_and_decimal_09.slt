# test/slt_proc/math_numeric/789_compound_assign_and_decimal_09.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (9)

statement ok
CREATE PROCEDURE sp_compound_math_789 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 32;
    SET @v *= 3;
    SET @v -= 16;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_789 90, @r OUTPUT;
SELECT @r;
----
350

query IIII
SELECT (82 & 39), (82 | 39), (82 ^ 39), ABS(-350);
----
2 119 117 350

statement ok
CREATE TABLE dec_t_789 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_789 VALUES (1, 90.25, 4), (2, 45.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_789 ORDER BY id;
----
1 361
2 91

statement ok
DROP TABLE dec_t_789;
