# test/slt_proc/math_numeric/785_compound_assign_and_decimal_05.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (5)

statement ok
CREATE PROCEDURE sp_compound_math_785 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 20;
    SET @v *= 3;
    SET @v -= 12;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_785 50, @r OUTPUT;
SELECT @r;
----
198

query IIII
SELECT (46 & 23), (46 | 23), (46 ^ 23), ABS(-198);
----
6 63 57 198

statement ok
CREATE TABLE dec_t_785 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_785 VALUES (1, 50.25, 4), (2, 25.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_785 ORDER BY id;
----
1 201
2 51

statement ok
DROP TABLE dec_t_785;
