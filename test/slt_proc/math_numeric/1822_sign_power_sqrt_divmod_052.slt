# test/slt_proc/math_numeric/1822_sign_power_sqrt_divmod_052.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (52)

query IIIIII
SELECT SIGN(-52), SIGN(0), SIGN(52), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (893 % 6);
----
-1 0 1 9 64 5

query III
SELECT (893 / 6), ABS(-893), (52 * 12 - 6);
----
148 893 618

statement ok
CREATE PROCEDURE sp_math_step_1822 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1822 @x = 893, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
148 5
