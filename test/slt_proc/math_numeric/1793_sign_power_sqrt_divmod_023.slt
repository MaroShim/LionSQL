# test/slt_proc/math_numeric/1793_sign_power_sqrt_divmod_023.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (23)

query IIIIII
SELECT SIGN(-23), SIGN(0), SIGN(23), CAST(SQRT(100) AS INT), CAST(POWER(5, 4) AS INT), (400 % 5);
----
-1 0 1 10 625 0

query III
SELECT (400 / 5), ABS(-400), (23 * 12 - 5);
----
80 400 271

statement ok
CREATE PROCEDURE sp_math_step_1793 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1793 @x = 400, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
80 0
