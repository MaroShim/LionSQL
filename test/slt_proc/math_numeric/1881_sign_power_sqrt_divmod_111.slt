# test/slt_proc/math_numeric/1881_sign_power_sqrt_divmod_111.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (111)

query IIIIII
SELECT SIGN(-111), SIGN(0), SIGN(111), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (1896 % 9);
----
-1 0 1 8 9 6

query III
SELECT (1896 / 9), ABS(-1896), (111 * 12 - 9);
----
210 1896 1323

statement ok
CREATE PROCEDURE sp_math_step_1881 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1881 @x = 1896, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
210 6
