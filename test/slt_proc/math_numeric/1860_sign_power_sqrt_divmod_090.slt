# test/slt_proc/math_numeric/1860_sign_power_sqrt_divmod_090.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (90)

query IIIIII
SELECT SIGN(-90), SIGN(0), SIGN(90), CAST(SQRT(4) AS INT), CAST(POWER(2, 2) AS INT), (1539 % 9);
----
-1 0 1 2 4 0

query III
SELECT (1539 / 9), ABS(-1539), (90 * 12 - 9);
----
171 1539 1071

statement ok
CREATE PROCEDURE sp_math_step_1860 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1860 @x = 1539, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
171 0
