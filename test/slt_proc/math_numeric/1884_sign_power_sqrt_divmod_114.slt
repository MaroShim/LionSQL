# test/slt_proc/math_numeric/1884_sign_power_sqrt_divmod_114.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (114)

query IIIIII
SELECT SIGN(-114), SIGN(0), SIGN(114), CAST(SQRT(121) AS INT), CAST(POWER(6, 2) AS INT), (1947 % 5);
----
-1 0 1 11 36 2

query III
SELECT (1947 / 5), ABS(-1947), (114 * 12 - 5);
----
389 1947 1363

statement ok
CREATE PROCEDURE sp_math_step_1884 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1884 @x = 1947, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
389 2
