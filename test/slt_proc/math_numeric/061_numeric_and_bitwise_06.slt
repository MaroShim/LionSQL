# test/slt_proc/math_numeric/061_numeric_and_bitwise_06.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (6)

query IIII
SELECT ABS(-85), SIGN(-85), CEILING(18.74), FLOOR(18.74);
----
85 -1 19 18

query RRR
SELECT POWER(3, 2), SQRT(36), ROUND(6.456, 2);
----
9.000 6.000 6.460

query III
SELECT 39 & 23, 39 | 23, 39 ^ 23;
----
7 55 48

statement ok
CREATE PROCEDURE sp_divmod_61 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_61 33, 8;
----
4 1 33
