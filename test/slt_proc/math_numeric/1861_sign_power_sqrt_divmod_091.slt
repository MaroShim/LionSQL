# test/slt_proc/math_numeric/1861_sign_power_sqrt_divmod_091.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (91)

query IIIIII
SELECT SIGN(-91), SIGN(0), SIGN(91), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (1556 % 3);
----
-1 0 1 3 27 2

query III
SELECT (1556 / 3), ABS(-1556), (91 * 12 - 3);
----
518 1556 1089

statement ok
CREATE PROCEDURE sp_math_step_1861 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1861 @x = 1556, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
518 2
