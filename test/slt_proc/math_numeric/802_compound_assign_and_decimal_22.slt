# test/slt_proc/math_numeric/802_compound_assign_and_decimal_22.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (22)

statement ok
CREATE PROCEDURE sp_compound_math_802 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 71;
    SET @v *= 4;
    SET @v -= 29;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_802 220, @r OUTPUT;
SELECT @r;
----
1135

query IIII
SELECT (199 & 91), (199 | 91), (199 ^ 91), ABS(-1135);
----
67 223 156 1135

statement ok
CREATE TABLE dec_t_802 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_802 VALUES (1, 220.25, 4), (2, 110.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_802 ORDER BY id;
----
1 881
2 221

statement ok
DROP TABLE dec_t_802;
