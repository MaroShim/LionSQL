# test/slt_proc/math_numeric/1782_sign_power_sqrt_divmod_012.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (12)

query IIIIII
SELECT SIGN(-12), SIGN(0), SIGN(12), CAST(SQRT(196) AS INT), CAST(POWER(4, 2) AS INT), (213 % 8);
----
-1 0 1 14 16 5

query III
SELECT (213 / 8), ABS(-213), (12 * 12 - 8);
----
26 213 136

statement ok
CREATE PROCEDURE sp_math_step_1782 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1782 @x = 213, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
26 5
