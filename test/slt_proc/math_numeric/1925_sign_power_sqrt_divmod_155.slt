# test/slt_proc/math_numeric/1925_sign_power_sqrt_divmod_155.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (155)

query IIIIII
SELECT SIGN(-155), SIGN(0), SIGN(155), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (2644 % 4);
----
-1 0 1 7 16 0

query III
SELECT (2644 / 4), ABS(-2644), (155 * 12 - 4);
----
661 2644 1856

statement ok
CREATE PROCEDURE sp_math_step_1925 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1925 @x = 2644, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
661 0
