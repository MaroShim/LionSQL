# test/slt_proc/math_numeric/1900_sign_power_sqrt_divmod_130.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (130)

query IIIIII
SELECT SIGN(-130), SIGN(0), SIGN(130), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (2219 % 7);
----
-1 0 1 12 8 0

query III
SELECT (2219 / 7), ABS(-2219), (130 * 12 - 7);
----
317 2219 1553

statement ok
CREATE PROCEDURE sp_math_step_1900 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1900 @x = 2219, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
317 0
