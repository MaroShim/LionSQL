# test/slt_proc/math_numeric/1801_sign_power_sqrt_divmod_031.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (31)

query IIIIII
SELECT SIGN(-31), SIGN(0), SIGN(31), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (536 % 6);
----
-1 0 1 3 27 2

query III
SELECT (536 / 6), ABS(-536), (31 * 12 - 6);
----
89 536 366

statement ok
CREATE PROCEDURE sp_math_step_1801 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1801 @x = 536, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
89 2
