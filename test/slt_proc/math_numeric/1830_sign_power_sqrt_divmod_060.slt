# test/slt_proc/math_numeric/1830_sign_power_sqrt_divmod_060.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (60)

query IIIIII
SELECT SIGN(-60), SIGN(0), SIGN(60), CAST(SQRT(4) AS INT), CAST(POWER(2, 2) AS INT), (1029 % 7);
----
-1 0 1 2 4 0

query III
SELECT (1029 / 7), ABS(-1029), (60 * 12 - 7);
----
147 1029 713

statement ok
CREATE PROCEDURE sp_math_step_1830 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1830 @x = 1029, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
147 0
