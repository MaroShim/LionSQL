# test/slt_proc/math_numeric/077_numeric_and_bitwise_22.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (22)

query IIII
SELECT ABS(-293), SIGN(-293), CEILING(66.54), FLOOR(66.54);
----
293 -1 67 66

query RRR
SELECT POWER(4, 3), SQRT(484), ROUND(22.456, 2);
----
64.000 22.000 22.460

query III
SELECT 135 & 71, 135 | 71, 135 ^ 71;
----
7 199 192

statement ok
CREATE PROCEDURE sp_divmod_77 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_77 113, 24;
----
4 17 113
