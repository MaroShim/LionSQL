# test/slt_proc/math_numeric/800_compound_assign_and_decimal_20.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (20)

statement ok
CREATE PROCEDURE sp_compound_math_800 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 65;
    SET @v *= 2;
    SET @v -= 27;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_800 200, @r OUTPUT;
SELECT @r;
----
503

query IIII
SELECT (181 & 83), (181 | 83), (181 ^ 83), ABS(-503);
----
17 247 230 503

statement ok
CREATE TABLE dec_t_800 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_800 VALUES (1, 200.25, 4), (2, 100.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_800 ORDER BY id;
----
1 801
2 201

statement ok
DROP TABLE dec_t_800;
