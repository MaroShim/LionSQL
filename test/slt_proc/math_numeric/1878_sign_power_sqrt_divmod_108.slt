# test/slt_proc/math_numeric/1878_sign_power_sqrt_divmod_108.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (108)

query IIIIII
SELECT SIGN(-108), SIGN(0), SIGN(108), CAST(SQRT(25) AS INT), CAST(POWER(5, 2) AS INT), (1845 % 6);
----
-1 0 1 5 25 3

query III
SELECT (1845 / 6), ABS(-1845), (108 * 12 - 6);
----
307 1845 1290

statement ok
CREATE PROCEDURE sp_math_step_1878 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1878 @x = 1845, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
307 3
