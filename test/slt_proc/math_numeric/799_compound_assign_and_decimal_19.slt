# test/slt_proc/math_numeric/799_compound_assign_and_decimal_19.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (19)

statement ok
CREATE PROCEDURE sp_compound_math_799 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 62;
    SET @v *= 5;
    SET @v -= 26;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_799 190, @r OUTPUT;
SELECT @r;
----
1234

query IIII
SELECT (172 & 79), (172 | 79), (172 ^ 79), ABS(-1234);
----
12 239 227 1234

statement ok
CREATE TABLE dec_t_799 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_799 VALUES (1, 190.25, 4), (2, 95.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_799 ORDER BY id;
----
1 761
2 191

statement ok
DROP TABLE dec_t_799;
