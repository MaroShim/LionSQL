# test/slt_proc/math_numeric/058_numeric_and_bitwise_03.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (3)

query IIII
SELECT ABS(-46), SIGN(-46), CEILING(9.44), FLOOR(9.44);
----
46 -1 10 9

query RRR
SELECT POWER(5, 2), SQRT(9), ROUND(3.456, 2);
----
25.000 3.000 3.460

query III
SELECT 21 & 14, 21 | 14, 21 ^ 14;
----
4 31 27

statement ok
CREATE PROCEDURE sp_divmod_58 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_58 18, 5;
----
3 3 18
