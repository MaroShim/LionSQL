# test/slt_proc/math_numeric/1853_sign_power_sqrt_divmod_083.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (83)

query IIIIII
SELECT SIGN(-83), SIGN(0), SIGN(83), CAST(SQRT(100) AS INT), CAST(POWER(5, 4) AS INT), (1420 % 9);
----
-1 0 1 10 625 7

query III
SELECT (1420 / 9), ABS(-1420), (83 * 12 - 9);
----
157 1420 987

statement ok
CREATE PROCEDURE sp_math_step_1853 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1853 @x = 1420, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
157 7
