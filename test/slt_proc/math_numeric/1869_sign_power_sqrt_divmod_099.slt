# test/slt_proc/math_numeric/1869_sign_power_sqrt_divmod_099.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (99)

query IIIIII
SELECT SIGN(-99), SIGN(0), SIGN(99), CAST(SQRT(121) AS INT), CAST(POWER(6, 2) AS INT), (1692 % 4);
----
-1 0 1 11 36 0

query III
SELECT (1692 / 4), ABS(-1692), (99 * 12 - 4);
----
423 1692 1184

statement ok
CREATE PROCEDURE sp_math_step_1869 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1869 @x = 1692, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
423 0
