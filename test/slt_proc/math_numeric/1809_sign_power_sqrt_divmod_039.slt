# test/slt_proc/math_numeric/1809_sign_power_sqrt_divmod_039.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (39)

query IIIIII
SELECT SIGN(-39), SIGN(0), SIGN(39), CAST(SQRT(121) AS INT), CAST(POWER(6, 2) AS INT), (672 % 7);
----
-1 0 1 11 36 0

query III
SELECT (672 / 7), ABS(-672), (39 * 12 - 7);
----
96 672 461

statement ok
CREATE PROCEDURE sp_math_step_1809 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1809 @x = 672, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
96 0
