# test/slt_proc/math_numeric/1890_sign_power_sqrt_divmod_120.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (120)

query IIIIII
SELECT SIGN(-120), SIGN(0), SIGN(120), CAST(SQRT(4) AS INT), CAST(POWER(2, 2) AS INT), (2049 % 4);
----
-1 0 1 2 4 1

query III
SELECT (2049 / 4), ABS(-2049), (120 * 12 - 4);
----
512 2049 1436

statement ok
CREATE PROCEDURE sp_math_step_1890 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1890 @x = 2049, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
512 1
