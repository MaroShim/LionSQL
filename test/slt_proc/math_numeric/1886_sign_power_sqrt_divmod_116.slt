# test/slt_proc/math_numeric/1886_sign_power_sqrt_divmod_116.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (116)

query IIIIII
SELECT SIGN(-116), SIGN(0), SIGN(116), CAST(SQRT(169) AS INT), CAST(POWER(3, 4) AS INT), (1981 % 7);
----
-1 0 1 13 81 0

query III
SELECT (1981 / 7), ABS(-1981), (116 * 12 - 7);
----
283 1981 1385

statement ok
CREATE PROCEDURE sp_math_step_1886 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1886 @x = 1981, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
283 0
