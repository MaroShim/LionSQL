# test/slt_proc/math_numeric/1895_sign_power_sqrt_divmod_125.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (125)

query IIIIII
SELECT SIGN(-125), SIGN(0), SIGN(125), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (2134 % 9);
----
-1 0 1 7 16 1

query III
SELECT (2134 / 9), ABS(-2134), (125 * 12 - 9);
----
237 2134 1491

statement ok
CREATE PROCEDURE sp_math_step_1895 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1895 @x = 2134, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
237 1
