# test/slt_proc/math_numeric/1834_sign_power_sqrt_divmod_064.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (64)

query IIIIII
SELECT SIGN(-64), SIGN(0), SIGN(64), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (1097 % 4);
----
-1 0 1 6 216 1

query III
SELECT (1097 / 4), ABS(-1097), (64 * 12 - 4);
----
274 1097 764

statement ok
CREATE PROCEDURE sp_math_step_1834 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1834 @x = 1097, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
274 1
