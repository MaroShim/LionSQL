# test/slt_proc/math_numeric/1835_sign_power_sqrt_divmod_065.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (65)

query IIIIII
SELECT SIGN(-65), SIGN(0), SIGN(65), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (1114 % 5);
----
-1 0 1 7 16 4

query III
SELECT (1114 / 5), ABS(-1114), (65 * 12 - 5);
----
222 1114 775

statement ok
CREATE PROCEDURE sp_math_step_1835 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1835 @x = 1114, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
222 4
