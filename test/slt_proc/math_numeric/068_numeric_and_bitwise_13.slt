# test/slt_proc/math_numeric/068_numeric_and_bitwise_13.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (13)

query IIII
SELECT ABS(-176), SIGN(-176), CEILING(39.54), FLOOR(39.54);
----
176 -1 40 39

query RRR
SELECT POWER(5, 3), SQRT(169), ROUND(13.456, 2);
----
125.000 13.000 13.460

query III
SELECT 81 & 44, 81 | 44, 81 ^ 44;
----
0 125 125

statement ok
CREATE PROCEDURE sp_divmod_68 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_68 68, 15;
----
4 8 68
