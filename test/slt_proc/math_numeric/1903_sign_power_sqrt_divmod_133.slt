# test/slt_proc/math_numeric/1903_sign_power_sqrt_divmod_133.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (133)

query IIIIII
SELECT SIGN(-133), SIGN(0), SIGN(133), CAST(SQRT(225) AS INT), CAST(POWER(5, 3) AS INT), (2270 % 3);
----
-1 0 1 15 125 2

query III
SELECT (2270 / 3), ABS(-2270), (133 * 12 - 3);
----
756 2270 1593

statement ok
CREATE PROCEDURE sp_math_step_1903 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1903 @x = 2270, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
756 2
