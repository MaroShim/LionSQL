# test/slt_proc/math_numeric/1790_sign_power_sqrt_divmod_020.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (20)

query IIIIII
SELECT SIGN(-20), SIGN(0), SIGN(20), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (349 % 9);
----
-1 0 1 7 16 7

query III
SELECT (349 / 9), ABS(-349), (20 * 12 - 9);
----
38 349 231

statement ok
CREATE PROCEDURE sp_math_step_1790 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1790 @x = 349, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
38 7
