# test/slt_proc/math_numeric/781_compound_assign_and_decimal_01.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (1)

statement ok
CREATE PROCEDURE sp_compound_math_781 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 8;
    SET @v *= 3;
    SET @v -= 8;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_781 10, @r OUTPUT;
SELECT @r;
----
46

query IIII
SELECT (10 & 7), (10 | 7), (10 ^ 7), ABS(-46);
----
2 15 13 46

statement ok
CREATE TABLE dec_t_781 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_781 VALUES (1, 10.25, 4), (2, 5.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_781 ORDER BY id;
----
1 41
2 11

statement ok
DROP TABLE dec_t_781;
