# test/slt_proc/math_numeric/060_numeric_and_bitwise_05.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (5)

query IIII
SELECT ABS(-72), SIGN(-72), CEILING(15.64), FLOOR(15.64);
----
72 -1 16 15

query RRR
SELECT POWER(2, 4), SQRT(25), ROUND(5.456, 2);
----
16.000 5.000 5.460

query III
SELECT 33 & 20, 33 | 20, 33 ^ 20;
----
0 53 53

statement ok
CREATE PROCEDURE sp_divmod_60 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_60 28, 7;
----
4 0 28
