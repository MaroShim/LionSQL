# test/slt_proc/math_numeric/1917_sign_power_sqrt_divmod_147.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (147)

query IIIIII
SELECT SIGN(-147), SIGN(0), SIGN(147), CAST(SQRT(196) AS INT), CAST(POWER(4, 2) AS INT), (2508 % 3);
----
-1 0 1 14 16 0

query III
SELECT (2508 / 3), ABS(-2508), (147 * 12 - 3);
----
836 2508 1761

statement ok
CREATE PROCEDURE sp_math_step_1917 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1917 @x = 2508, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
836 0
