# test/slt_proc/math_numeric/1785_sign_power_sqrt_divmod_015.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (15)

query IIIIII
SELECT SIGN(-15), SIGN(0), SIGN(15), CAST(SQRT(4) AS INT), CAST(POWER(2, 2) AS INT), (264 % 4);
----
-1 0 1 2 4 0

query III
SELECT (264 / 4), ABS(-264), (15 * 12 - 4);
----
66 264 176

statement ok
CREATE PROCEDURE sp_math_step_1785 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1785 @x = 264, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
66 0
