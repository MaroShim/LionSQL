# test/slt_proc/math_numeric/1837_sign_power_sqrt_divmod_067.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (67)

query IIIIII
SELECT SIGN(-67), SIGN(0), SIGN(67), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (1148 % 7);
----
-1 0 1 9 64 0

query III
SELECT (1148 / 7), ABS(-1148), (67 * 12 - 7);
----
164 1148 797

statement ok
CREATE PROCEDURE sp_math_step_1837 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1837 @x = 1148, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
164 0
