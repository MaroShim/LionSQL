# test/slt_proc/math_numeric/801_compound_assign_and_decimal_21.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (21)

statement ok
CREATE PROCEDURE sp_compound_math_801 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 68;
    SET @v *= 3;
    SET @v -= 28;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_801 210, @r OUTPUT;
SELECT @r;
----
806

query IIII
SELECT (190 & 87), (190 | 87), (190 ^ 87), ABS(-806);
----
22 255 233 806

statement ok
CREATE TABLE dec_t_801 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_801 VALUES (1, 210.25, 4), (2, 105.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_801 ORDER BY id;
----
1 841
2 211

statement ok
DROP TABLE dec_t_801;
