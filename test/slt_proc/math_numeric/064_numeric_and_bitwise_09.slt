# test/slt_proc/math_numeric/064_numeric_and_bitwise_09.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (9)

query IIII
SELECT ABS(-124), SIGN(-124), CEILING(27.14), FLOOR(27.14);
----
124 -1 28 27

query RRR
SELECT POWER(6, 2), SQRT(81), ROUND(9.456, 2);
----
36.000 9.000 9.460

query III
SELECT 57 & 32, 57 | 32, 57 ^ 32;
----
32 57 25

statement ok
CREATE PROCEDURE sp_divmod_64 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_64 48, 11;
----
4 4 48
