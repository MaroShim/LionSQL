# test/slt_proc/math_numeric/1889_sign_power_sqrt_divmod_119.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (119)

query IIIIII
SELECT SIGN(-119), SIGN(0), SIGN(119), CAST(SQRT(256) AS INT), CAST(POWER(6, 4) AS INT), (2032 % 3);
----
-1 0 1 16 1296 1

query III
SELECT (2032 / 3), ABS(-2032), (119 * 12 - 3);
----
677 2032 1425

statement ok
CREATE PROCEDURE sp_math_step_1889 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1889 @x = 2032, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
677 1
