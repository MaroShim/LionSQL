# test/slt_proc/math_numeric/1902_sign_power_sqrt_divmod_132.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (132)

query IIIIII
SELECT SIGN(-132), SIGN(0), SIGN(132), CAST(SQRT(196) AS INT), CAST(POWER(4, 2) AS INT), (2253 % 9);
----
-1 0 1 14 16 3

query III
SELECT (2253 / 9), ABS(-2253), (132 * 12 - 9);
----
250 2253 1575

statement ok
CREATE PROCEDURE sp_math_step_1902 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1902 @x = 2253, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
250 3
