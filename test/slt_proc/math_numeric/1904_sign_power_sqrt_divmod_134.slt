# test/slt_proc/math_numeric/1904_sign_power_sqrt_divmod_134.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (134)

query IIIIII
SELECT SIGN(-134), SIGN(0), SIGN(134), CAST(SQRT(256) AS INT), CAST(POWER(6, 4) AS INT), (2287 % 4);
----
-1 0 1 16 1296 3

query III
SELECT (2287 / 4), ABS(-2287), (134 * 12 - 4);
----
571 2287 1604

statement ok
CREATE PROCEDURE sp_math_step_1904 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1904 @x = 2287, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
571 3
