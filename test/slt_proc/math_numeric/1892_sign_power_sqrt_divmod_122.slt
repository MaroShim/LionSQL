# test/slt_proc/math_numeric/1892_sign_power_sqrt_divmod_122.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (122)

query IIIIII
SELECT SIGN(-122), SIGN(0), SIGN(122), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (2083 % 6);
----
-1 0 1 4 256 1

query III
SELECT (2083 / 6), ABS(-2083), (122 * 12 - 6);
----
347 2083 1458

statement ok
CREATE PROCEDURE sp_math_step_1892 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1892 @x = 2083, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
347 1
