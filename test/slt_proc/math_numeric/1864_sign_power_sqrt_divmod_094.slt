# test/slt_proc/math_numeric/1864_sign_power_sqrt_divmod_094.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (94)

query IIIIII
SELECT SIGN(-94), SIGN(0), SIGN(94), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (1607 % 6);
----
-1 0 1 6 216 5

query III
SELECT (1607 / 6), ABS(-1607), (94 * 12 - 6);
----
267 1607 1122

statement ok
CREATE PROCEDURE sp_math_step_1864 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1864 @x = 1607, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
267 5
