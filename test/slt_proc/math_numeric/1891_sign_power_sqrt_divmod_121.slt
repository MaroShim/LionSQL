# test/slt_proc/math_numeric/1891_sign_power_sqrt_divmod_121.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (121)

query IIIIII
SELECT SIGN(-121), SIGN(0), SIGN(121), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (2066 % 5);
----
-1 0 1 3 27 1

query III
SELECT (2066 / 5), ABS(-2066), (121 * 12 - 5);
----
413 2066 1447

statement ok
CREATE PROCEDURE sp_math_step_1891 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1891 @x = 2066, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
413 1
