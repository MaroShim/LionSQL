# test/slt_proc/math_numeric/797_compound_assign_and_decimal_17.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (17)

statement ok
CREATE PROCEDURE sp_compound_math_797 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 56;
    SET @v *= 3;
    SET @v -= 24;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_797 170, @r OUTPUT;
SELECT @r;
----
654

query IIII
SELECT (154 & 71), (154 | 71), (154 ^ 71), ABS(-654);
----
2 223 221 654

statement ok
CREATE TABLE dec_t_797 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_797 VALUES (1, 170.25, 4), (2, 85.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_797 ORDER BY id;
----
1 681
2 171

statement ok
DROP TABLE dec_t_797;
