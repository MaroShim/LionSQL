# test/slt_proc/math_numeric/1901_sign_power_sqrt_divmod_131.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (131)

query IIIIII
SELECT SIGN(-131), SIGN(0), SIGN(131), CAST(SQRT(169) AS INT), CAST(POWER(3, 4) AS INT), (2236 % 8);
----
-1 0 1 13 81 4

query III
SELECT (2236 / 8), ABS(-2236), (131 * 12 - 8);
----
279 2236 1564

statement ok
CREATE PROCEDURE sp_math_step_1901 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1901 @x = 2236, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
279 4
