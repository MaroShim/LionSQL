# test/slt_proc/math_numeric/1915_sign_power_sqrt_divmod_145.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (145)

query IIIIII
SELECT SIGN(-145), SIGN(0), SIGN(145), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (2474 % 8);
----
-1 0 1 12 8 2

query III
SELECT (2474 / 8), ABS(-2474), (145 * 12 - 8);
----
309 2474 1732

statement ok
CREATE PROCEDURE sp_math_step_1915 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1915 @x = 2474, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
309 2
