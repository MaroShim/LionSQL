# test/slt_proc/math_numeric/1787_sign_power_sqrt_divmod_017.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (17)

query IIIIII
SELECT SIGN(-17), SIGN(0), SIGN(17), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (298 % 6);
----
-1 0 1 4 256 4

query III
SELECT (298 / 6), ABS(-298), (17 * 12 - 6);
----
49 298 198

statement ok
CREATE PROCEDURE sp_math_step_1787 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1787 @x = 298, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
49 4
