# test/slt_proc/math_numeric/1812_sign_power_sqrt_divmod_042.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (42)

query IIIIII
SELECT SIGN(-42), SIGN(0), SIGN(42), CAST(SQRT(196) AS INT), CAST(POWER(4, 2) AS INT), (723 % 3);
----
-1 0 1 14 16 0

query III
SELECT (723 / 3), ABS(-723), (42 * 12 - 3);
----
241 723 501

statement ok
CREATE PROCEDURE sp_math_step_1812 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1812 @x = 723, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
241 0
