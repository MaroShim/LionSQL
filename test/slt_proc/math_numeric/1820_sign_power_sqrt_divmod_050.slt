# test/slt_proc/math_numeric/1820_sign_power_sqrt_divmod_050.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (50)

query IIIIII
SELECT SIGN(-50), SIGN(0), SIGN(50), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (859 % 4);
----
-1 0 1 7 16 3

query III
SELECT (859 / 4), ABS(-859), (50 * 12 - 4);
----
214 859 596

statement ok
CREATE PROCEDURE sp_math_step_1820 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1820 @x = 859, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
214 3
