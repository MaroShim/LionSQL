# test/slt_proc/math_numeric/1854_sign_power_sqrt_divmod_084.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (84)

query IIIIII
SELECT SIGN(-84), SIGN(0), SIGN(84), CAST(SQRT(121) AS INT), CAST(POWER(6, 2) AS INT), (1437 % 3);
----
-1 0 1 11 36 0

query III
SELECT (1437 / 3), ABS(-1437), (84 * 12 - 3);
----
479 1437 1005

statement ok
CREATE PROCEDURE sp_math_step_1854 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1854 @x = 1437, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
479 0
