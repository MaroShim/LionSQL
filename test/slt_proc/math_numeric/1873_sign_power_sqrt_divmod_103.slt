# test/slt_proc/math_numeric/1873_sign_power_sqrt_divmod_103.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (103)

query IIIIII
SELECT SIGN(-103), SIGN(0), SIGN(103), CAST(SQRT(225) AS INT), CAST(POWER(5, 3) AS INT), (1760 % 8);
----
-1 0 1 15 125 0

query III
SELECT (1760 / 8), ABS(-1760), (103 * 12 - 8);
----
220 1760 1228

statement ok
CREATE PROCEDURE sp_math_step_1873 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1873 @x = 1760, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
220 0
