# test/slt_proc/math_numeric/1813_sign_power_sqrt_divmod_043.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (43)

query IIIIII
SELECT SIGN(-43), SIGN(0), SIGN(43), CAST(SQRT(225) AS INT), CAST(POWER(5, 3) AS INT), (740 % 4);
----
-1 0 1 15 125 0

query III
SELECT (740 / 4), ABS(-740), (43 * 12 - 4);
----
185 740 512

statement ok
CREATE PROCEDURE sp_math_step_1813 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1813 @x = 740, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
185 0
