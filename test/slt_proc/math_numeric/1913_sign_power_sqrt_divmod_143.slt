# test/slt_proc/math_numeric/1913_sign_power_sqrt_divmod_143.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (143)

query IIIIII
SELECT SIGN(-143), SIGN(0), SIGN(143), CAST(SQRT(100) AS INT), CAST(POWER(5, 4) AS INT), (2440 % 6);
----
-1 0 1 10 625 4

query III
SELECT (2440 / 6), ABS(-2440), (143 * 12 - 6);
----
406 2440 1710

statement ok
CREATE PROCEDURE sp_math_step_1913 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1913 @x = 2440, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
406 4
