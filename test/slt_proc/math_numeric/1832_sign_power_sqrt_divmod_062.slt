# test/slt_proc/math_numeric/1832_sign_power_sqrt_divmod_062.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (62)

query IIIIII
SELECT SIGN(-62), SIGN(0), SIGN(62), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (1063 % 9);
----
-1 0 1 4 256 1

query III
SELECT (1063 / 9), ABS(-1063), (62 * 12 - 9);
----
118 1063 735

statement ok
CREATE PROCEDURE sp_math_step_1832 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1832 @x = 1063, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
118 1
