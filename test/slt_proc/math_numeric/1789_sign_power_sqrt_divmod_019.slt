# test/slt_proc/math_numeric/1789_sign_power_sqrt_divmod_019.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (19)

query IIIIII
SELECT SIGN(-19), SIGN(0), SIGN(19), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (332 % 8);
----
-1 0 1 6 216 4

query III
SELECT (332 / 8), ABS(-332), (19 * 12 - 8);
----
41 332 220

statement ok
CREATE PROCEDURE sp_math_step_1789 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1789 @x = 332, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
41 4
