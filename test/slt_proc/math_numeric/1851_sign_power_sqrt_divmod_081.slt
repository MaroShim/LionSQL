# test/slt_proc/math_numeric/1851_sign_power_sqrt_divmod_081.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (81)

query IIIIII
SELECT SIGN(-81), SIGN(0), SIGN(81), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (1386 % 7);
----
-1 0 1 8 9 0

query III
SELECT (1386 / 7), ABS(-1386), (81 * 12 - 7);
----
198 1386 965

statement ok
CREATE PROCEDURE sp_math_step_1851 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1851 @x = 1386, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
198 0
