# test/slt_proc/math_numeric/065_numeric_and_bitwise_10.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (10)

query IIII
SELECT ABS(-137), SIGN(-137), CEILING(30.24), FLOOR(30.24);
----
137 -1 31 30

query RRR
SELECT POWER(2, 3), SQRT(100), ROUND(10.456, 2);
----
8.000 10.000 10.460

query III
SELECT 63 & 35, 63 | 35, 63 ^ 35;
----
35 63 28

statement ok
CREATE PROCEDURE sp_divmod_65 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_65 53, 12;
----
4 5 53
