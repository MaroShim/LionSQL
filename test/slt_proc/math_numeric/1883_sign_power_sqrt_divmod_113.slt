# test/slt_proc/math_numeric/1883_sign_power_sqrt_divmod_113.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (113)

query IIIIII
SELECT SIGN(-113), SIGN(0), SIGN(113), CAST(SQRT(100) AS INT), CAST(POWER(5, 4) AS INT), (1930 % 4);
----
-1 0 1 10 625 2

query III
SELECT (1930 / 4), ABS(-1930), (113 * 12 - 4);
----
482 1930 1352

statement ok
CREATE PROCEDURE sp_math_step_1883 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1883 @x = 1930, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
482 2
