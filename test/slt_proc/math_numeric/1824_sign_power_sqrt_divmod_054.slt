# test/slt_proc/math_numeric/1824_sign_power_sqrt_divmod_054.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (54)

query IIIIII
SELECT SIGN(-54), SIGN(0), SIGN(54), CAST(SQRT(121) AS INT), CAST(POWER(6, 2) AS INT), (927 % 8);
----
-1 0 1 11 36 7

query III
SELECT (927 / 8), ABS(-927), (54 * 12 - 8);
----
115 927 640

statement ok
CREATE PROCEDURE sp_math_step_1824 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1824 @x = 927, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
115 7
