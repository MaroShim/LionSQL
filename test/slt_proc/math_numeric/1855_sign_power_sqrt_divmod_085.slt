# test/slt_proc/math_numeric/1855_sign_power_sqrt_divmod_085.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (85)

query IIIIII
SELECT SIGN(-85), SIGN(0), SIGN(85), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (1454 % 4);
----
-1 0 1 12 8 2

query III
SELECT (1454 / 4), ABS(-1454), (85 * 12 - 4);
----
363 1454 1016

statement ok
CREATE PROCEDURE sp_math_step_1855 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1855 @x = 1454, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
363 2
