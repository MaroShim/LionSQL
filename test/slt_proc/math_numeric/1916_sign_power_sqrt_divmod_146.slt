# test/slt_proc/math_numeric/1916_sign_power_sqrt_divmod_146.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (146)

query IIIIII
SELECT SIGN(-146), SIGN(0), SIGN(146), CAST(SQRT(169) AS INT), CAST(POWER(3, 4) AS INT), (2491 % 9);
----
-1 0 1 13 81 7

query III
SELECT (2491 / 9), ABS(-2491), (146 * 12 - 9);
----
276 2491 1743

statement ok
CREATE PROCEDURE sp_math_step_1916 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1916 @x = 2491, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
276 7
