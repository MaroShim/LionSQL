# test/slt_proc/math_numeric/1794_sign_power_sqrt_divmod_024.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (24)

query IIIIII
SELECT SIGN(-24), SIGN(0), SIGN(24), CAST(SQRT(121) AS INT), CAST(POWER(6, 2) AS INT), (417 % 6);
----
-1 0 1 11 36 3

query III
SELECT (417 / 6), ABS(-417), (24 * 12 - 6);
----
69 417 282

statement ok
CREATE PROCEDURE sp_math_step_1794 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1794 @x = 417, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
69 3
