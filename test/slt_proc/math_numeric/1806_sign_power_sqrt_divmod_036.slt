# test/slt_proc/math_numeric/1806_sign_power_sqrt_divmod_036.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (36)

query IIIIII
SELECT SIGN(-36), SIGN(0), SIGN(36), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (621 % 4);
----
-1 0 1 8 9 1

query III
SELECT (621 / 4), ABS(-621), (36 * 12 - 4);
----
155 621 428

statement ok
CREATE PROCEDURE sp_math_step_1806 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1806 @x = 621, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
155 1
