# test/slt_proc/math_numeric/1856_sign_power_sqrt_divmod_086.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (86)

query IIIIII
SELECT SIGN(-86), SIGN(0), SIGN(86), CAST(SQRT(169) AS INT), CAST(POWER(3, 4) AS INT), (1471 % 5);
----
-1 0 1 13 81 1

query III
SELECT (1471 / 5), ABS(-1471), (86 * 12 - 5);
----
294 1471 1027

statement ok
CREATE PROCEDURE sp_math_step_1856 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1856 @x = 1471, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
294 1
