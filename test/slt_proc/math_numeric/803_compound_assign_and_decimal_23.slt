# test/slt_proc/math_numeric/803_compound_assign_and_decimal_23.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (23)

statement ok
CREATE PROCEDURE sp_compound_math_803 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 74;
    SET @v *= 5;
    SET @v -= 30;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_803 230, @r OUTPUT;
SELECT @r;
----
1490

query IIII
SELECT (208 & 95), (208 | 95), (208 ^ 95), ABS(-1490);
----
80 223 143 1490

statement ok
CREATE TABLE dec_t_803 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_803 VALUES (1, 230.25, 4), (2, 115.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_803 ORDER BY id;
----
1 921
2 231

statement ok
DROP TABLE dec_t_803;
