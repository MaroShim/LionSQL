# test/slt_proc/math_numeric/1882_sign_power_sqrt_divmod_112.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (112)

query IIIIII
SELECT SIGN(-112), SIGN(0), SIGN(112), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (1913 % 3);
----
-1 0 1 9 64 2

query III
SELECT (1913 / 3), ABS(-1913), (112 * 12 - 3);
----
637 1913 1341

statement ok
CREATE PROCEDURE sp_math_step_1882 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1882 @x = 1913, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
637 2
