# test/slt_proc/math_numeric/1844_sign_power_sqrt_divmod_074.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (74)

query IIIIII
SELECT SIGN(-74), SIGN(0), SIGN(74), CAST(SQRT(256) AS INT), CAST(POWER(6, 4) AS INT), (1267 % 7);
----
-1 0 1 16 1296 0

query III
SELECT (1267 / 7), ABS(-1267), (74 * 12 - 7);
----
181 1267 881

statement ok
CREATE PROCEDURE sp_math_step_1844 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1844 @x = 1267, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
181 0
