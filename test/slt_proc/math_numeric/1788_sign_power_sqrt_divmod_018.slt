# test/slt_proc/math_numeric/1788_sign_power_sqrt_divmod_018.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (18)

query IIIIII
SELECT SIGN(-18), SIGN(0), SIGN(18), CAST(SQRT(25) AS INT), CAST(POWER(5, 2) AS INT), (315 % 7);
----
-1 0 1 5 25 0

query III
SELECT (315 / 7), ABS(-315), (18 * 12 - 7);
----
45 315 209

statement ok
CREATE PROCEDURE sp_math_step_1788 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1788 @x = 315, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
45 0
