# test/slt_proc/math_numeric/070_numeric_and_bitwise_15.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (15)

query IIII
SELECT ABS(-202), SIGN(-202), CEILING(45.74), FLOOR(45.74);
----
202 -1 46 45

query RRR
SELECT POWER(2, 2), SQRT(225), ROUND(15.456, 2);
----
4.000 15.000 15.460

query III
SELECT 93 & 50, 93 | 50, 93 ^ 50;
----
16 127 111

statement ok
CREATE PROCEDURE sp_divmod_70 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_70 78, 17;
----
4 10 78
