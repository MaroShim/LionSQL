# test/slt_proc/math_numeric/1919_sign_power_sqrt_divmod_149.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (149)

query IIIIII
SELECT SIGN(-149), SIGN(0), SIGN(149), CAST(SQRT(256) AS INT), CAST(POWER(6, 4) AS INT), (2542 % 5);
----
-1 0 1 16 1296 2

query III
SELECT (2542 / 5), ABS(-2542), (149 * 12 - 5);
----
508 2542 1783

statement ok
CREATE PROCEDURE sp_math_step_1919 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1919 @x = 2542, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
508 2
