# test/slt_proc/math_numeric/807_compound_assign_and_decimal_27.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (27)

statement ok
CREATE PROCEDURE sp_compound_math_807 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 86;
    SET @v *= 5;
    SET @v -= 34;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_807 270, @r OUTPUT;
SELECT @r;
----
1746

query IIII
SELECT (244 & 111), (244 | 111), (244 ^ 111), ABS(-1746);
----
100 255 155 1746

statement ok
CREATE TABLE dec_t_807 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_807 VALUES (1, 270.25, 4), (2, 135.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_807 ORDER BY id;
----
1 1081
2 271

statement ok
DROP TABLE dec_t_807;
