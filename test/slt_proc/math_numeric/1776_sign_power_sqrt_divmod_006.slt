# test/slt_proc/math_numeric/1776_sign_power_sqrt_divmod_006.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (6)

query IIIIII
SELECT SIGN(-6), SIGN(0), SIGN(6), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (111 % 9);
----
-1 0 1 8 9 3

query III
SELECT (111 / 9), ABS(-111), (6 * 12 - 9);
----
12 111 63

statement ok
CREATE PROCEDURE sp_math_step_1776 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1776 @x = 111, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
12 3
