# test/slt_proc/math_numeric/805_compound_assign_and_decimal_25.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (25)

statement ok
CREATE PROCEDURE sp_compound_math_805 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 80;
    SET @v *= 3;
    SET @v -= 32;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_805 250, @r OUTPUT;
SELECT @r;
----
958

query IIII
SELECT (226 & 103), (226 | 103), (226 ^ 103), ABS(-958);
----
98 231 133 958

statement ok
CREATE TABLE dec_t_805 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_805 VALUES (1, 250.25, 4), (2, 125.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_805 ORDER BY id;
----
1 1001
2 251

statement ok
DROP TABLE dec_t_805;
