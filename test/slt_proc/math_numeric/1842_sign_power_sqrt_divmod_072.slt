# test/slt_proc/math_numeric/1842_sign_power_sqrt_divmod_072.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (72)

query IIIIII
SELECT SIGN(-72), SIGN(0), SIGN(72), CAST(SQRT(196) AS INT), CAST(POWER(4, 2) AS INT), (1233 % 5);
----
-1 0 1 14 16 3

query III
SELECT (1233 / 5), ABS(-1233), (72 * 12 - 5);
----
246 1233 859

statement ok
CREATE PROCEDURE sp_math_step_1842 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1842 @x = 1233, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
246 3
