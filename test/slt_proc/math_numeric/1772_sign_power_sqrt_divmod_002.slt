# test/slt_proc/math_numeric/1772_sign_power_sqrt_divmod_002.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (2)

query IIIIII
SELECT SIGN(-2), SIGN(0), SIGN(2), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (43 % 5);
----
-1 0 1 4 256 3

query III
SELECT (43 / 5), ABS(-43), (2 * 12 - 5);
----
8 43 19

statement ok
CREATE PROCEDURE sp_math_step_1772 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1772 @x = 43, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
8 3
