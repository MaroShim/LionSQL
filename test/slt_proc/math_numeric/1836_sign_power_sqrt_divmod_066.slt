# test/slt_proc/math_numeric/1836_sign_power_sqrt_divmod_066.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (66)

query IIIIII
SELECT SIGN(-66), SIGN(0), SIGN(66), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (1131 % 6);
----
-1 0 1 8 9 3

query III
SELECT (1131 / 6), ABS(-1131), (66 * 12 - 6);
----
188 1131 786

statement ok
CREATE PROCEDURE sp_math_step_1836 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1836 @x = 1131, @y = 6, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
188 3
