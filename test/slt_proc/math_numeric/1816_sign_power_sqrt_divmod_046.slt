# test/slt_proc/math_numeric/1816_sign_power_sqrt_divmod_046.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (46)

query IIIIII
SELECT SIGN(-46), SIGN(0), SIGN(46), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (791 % 7);
----
-1 0 1 3 27 0

query III
SELECT (791 / 7), ABS(-791), (46 * 12 - 7);
----
113 791 545

statement ok
CREATE PROCEDURE sp_math_step_1816 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1816 @x = 791, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
113 0
