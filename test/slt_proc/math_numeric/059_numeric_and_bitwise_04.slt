# test/slt_proc/math_numeric/059_numeric_and_bitwise_04.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (4)

query IIII
SELECT ABS(-59), SIGN(-59), CEILING(12.54), FLOOR(12.54);
----
59 -1 13 12

query RRR
SELECT POWER(6, 3), SQRT(16), ROUND(4.456, 2);
----
216.000 4.000 4.460

query III
SELECT 27 & 17, 27 | 17, 27 ^ 17;
----
17 27 10

statement ok
CREATE PROCEDURE sp_divmod_59 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_59 23, 6;
----
3 5 23
