# test/slt_proc/math_numeric/1771_sign_power_sqrt_divmod_001.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (1)

query IIIIII
SELECT SIGN(-1), SIGN(0), SIGN(1), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (26 % 4);
----
-1 0 1 3 27 2

query III
SELECT (26 / 4), ABS(-26), (1 * 12 - 4);
----
6 26 8

statement ok
CREATE PROCEDURE sp_math_step_1771 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1771 @x = 26, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
6 2
