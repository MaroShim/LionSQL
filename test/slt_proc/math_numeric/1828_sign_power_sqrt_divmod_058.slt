# test/slt_proc/math_numeric/1828_sign_power_sqrt_divmod_058.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (58)

query IIIIII
SELECT SIGN(-58), SIGN(0), SIGN(58), CAST(SQRT(225) AS INT), CAST(POWER(5, 3) AS INT), (995 % 5);
----
-1 0 1 15 125 0

query III
SELECT (995 / 5), ABS(-995), (58 * 12 - 5);
----
199 995 691

statement ok
CREATE PROCEDURE sp_math_step_1828 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1828 @x = 995, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
199 0
