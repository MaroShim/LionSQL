# test/slt_proc/math_numeric/1802_sign_power_sqrt_divmod_032.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (32)

query IIIIII
SELECT SIGN(-32), SIGN(0), SIGN(32), CAST(SQRT(16) AS INT), CAST(POWER(4, 4) AS INT), (553 % 7);
----
-1 0 1 4 256 0

query III
SELECT (553 / 7), ABS(-553), (32 * 12 - 7);
----
79 553 377

statement ok
CREATE PROCEDURE sp_math_step_1802 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1802 @x = 553, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
79 0
