# test/slt_proc/math_numeric/067_numeric_and_bitwise_12.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (12)

query IIII
SELECT ABS(-163), SIGN(-163), CEILING(36.44), FLOOR(36.44);
----
163 -1 37 36

query RRR
SELECT POWER(4, 2), SQRT(144), ROUND(12.456, 2);
----
16.000 12.000 12.460

query III
SELECT 75 & 41, 75 | 41, 75 ^ 41;
----
9 107 98

statement ok
CREATE PROCEDURE sp_divmod_67 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_67 63, 14;
----
4 7 63
