# test/slt_proc/math_numeric/1867_sign_power_sqrt_divmod_097.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (97)

query IIIIII
SELECT SIGN(-97), SIGN(0), SIGN(97), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (1658 % 9);
----
-1 0 1 9 64 2

query III
SELECT (1658 / 9), ABS(-1658), (97 * 12 - 9);
----
184 1658 1155

statement ok
CREATE PROCEDURE sp_math_step_1867 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1867 @x = 1658, @y = 9, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
184 2
