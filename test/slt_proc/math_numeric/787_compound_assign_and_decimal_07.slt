# test/slt_proc/math_numeric/787_compound_assign_and_decimal_07.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (7)

statement ok
CREATE PROCEDURE sp_compound_math_787 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 26;
    SET @v *= 5;
    SET @v -= 14;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_787 70, @r OUTPUT;
SELECT @r;
----
466

query IIII
SELECT (64 & 31), (64 | 31), (64 ^ 31), ABS(-466);
----
0 95 95 466

statement ok
CREATE TABLE dec_t_787 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_787 VALUES (1, 70.25, 4), (2, 35.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_787 ORDER BY id;
----
1 281
2 71

statement ok
DROP TABLE dec_t_787;
