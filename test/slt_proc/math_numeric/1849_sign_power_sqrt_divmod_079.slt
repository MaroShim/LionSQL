# test/slt_proc/math_numeric/1849_sign_power_sqrt_divmod_079.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (79)

query IIIIII
SELECT SIGN(-79), SIGN(0), SIGN(79), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (1352 % 5);
----
-1 0 1 6 216 2

query III
SELECT (1352 / 5), ABS(-1352), (79 * 12 - 5);
----
270 1352 943

statement ok
CREATE PROCEDURE sp_math_step_1849 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1849 @x = 1352, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
270 2
