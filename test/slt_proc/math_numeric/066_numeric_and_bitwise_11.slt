# test/slt_proc/math_numeric/066_numeric_and_bitwise_11.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (11)

query IIII
SELECT ABS(-150), SIGN(-150), CEILING(33.34), FLOOR(33.34);
----
150 -1 34 33

query RRR
SELECT POWER(3, 4), SQRT(121), ROUND(11.456, 2);
----
81.000 11.000 11.460

query III
SELECT 69 & 38, 69 | 38, 69 ^ 38;
----
4 103 99

statement ok
CREATE PROCEDURE sp_divmod_66 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_66 58, 13;
----
4 6 58
