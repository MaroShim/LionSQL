# test/slt_proc/math_numeric/1852_sign_power_sqrt_divmod_082.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (82)

query IIIIII
SELECT SIGN(-82), SIGN(0), SIGN(82), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (1403 % 8);
----
-1 0 1 9 64 3

query III
SELECT (1403 / 8), ABS(-1403), (82 * 12 - 8);
----
175 1403 976

statement ok
CREATE PROCEDURE sp_math_step_1852 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1852 @x = 1403, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
175 3
