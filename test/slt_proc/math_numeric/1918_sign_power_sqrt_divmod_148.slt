# test/slt_proc/math_numeric/1918_sign_power_sqrt_divmod_148.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (148)

query IIIIII
SELECT SIGN(-148), SIGN(0), SIGN(148), CAST(SQRT(225) AS INT), CAST(POWER(5, 3) AS INT), (2525 % 4);
----
-1 0 1 15 125 1

query III
SELECT (2525 / 4), ABS(-2525), (148 * 12 - 4);
----
631 2525 1772

statement ok
CREATE PROCEDURE sp_math_step_1918 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1918 @x = 2525, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
631 1
