# test/slt_proc/math_numeric/1774_sign_power_sqrt_divmod_004.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (4)

query IIIIII
SELECT SIGN(-4), SIGN(0), SIGN(4), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (77 % 7);
----
-1 0 1 6 216 0

query III
SELECT (77 / 7), ABS(-77), (4 * 12 - 7);
----
11 77 41

statement ok
CREATE PROCEDURE sp_math_step_1774 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1774 @x = 77, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
11 0
