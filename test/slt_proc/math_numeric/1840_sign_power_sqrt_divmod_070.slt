# test/slt_proc/math_numeric/1840_sign_power_sqrt_divmod_070.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (70)

query IIIIII
SELECT SIGN(-70), SIGN(0), SIGN(70), CAST(SQRT(144) AS INT), CAST(POWER(2, 3) AS INT), (1199 % 3);
----
-1 0 1 12 8 2

query III
SELECT (1199 / 3), ABS(-1199), (70 * 12 - 3);
----
399 1199 837

statement ok
CREATE PROCEDURE sp_math_step_1840 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1840 @x = 1199, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
399 2
