# test/slt_proc/math_numeric/1777_sign_power_sqrt_divmod_007.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (7)

query IIIIII
SELECT SIGN(-7), SIGN(0), SIGN(7), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (128 % 3);
----
-1 0 1 9 64 2

query III
SELECT (128 / 3), ABS(-128), (7 * 12 - 3);
----
42 128 81

statement ok
CREATE PROCEDURE sp_math_step_1777 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1777 @x = 128, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
42 2
