# test/slt_proc/math_numeric/786_compound_assign_and_decimal_06.slt
# T-SQL compound assignment (+=, -=, *=), DECIMAL scale, and bitwise arithmetic (6)

statement ok
CREATE PROCEDURE sp_compound_math_786 @start INT, @res INT OUTPUT
AS
BEGIN
    DECLARE @v INT = @start;
    SET @v += 23;
    SET @v *= 4;
    SET @v -= 13;
    SET @res = @v;
END;

query I
DECLARE @r INT;
EXEC sp_compound_math_786 60, @r OUTPUT;
SELECT @r;
----
319

query IIII
SELECT (55 & 27), (55 | 27), (55 ^ 27), ABS(-319);
----
19 63 44 319

statement ok
CREATE TABLE dec_t_786 (id INT PRIMARY KEY, price DECIMAL(12, 2), qty INT);

statement ok
INSERT INTO dec_t_786 VALUES (1, 60.25, 4), (2, 30.50, 2);

query II
SELECT id, CAST(price * qty AS INT) FROM dec_t_786 ORDER BY id;
----
1 241
2 61

statement ok
DROP TABLE dec_t_786;
