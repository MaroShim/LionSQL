# test/slt_proc/math_numeric/1896_sign_power_sqrt_divmod_126.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (126)

query IIIIII
SELECT SIGN(-126), SIGN(0), SIGN(126), CAST(SQRT(64) AS INT), CAST(POWER(3, 2) AS INT), (2151 % 3);
----
-1 0 1 8 9 0

query III
SELECT (2151 / 3), ABS(-2151), (126 * 12 - 3);
----
717 2151 1509

statement ok
CREATE PROCEDURE sp_math_step_1896 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1896 @x = 2151, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
717 0
