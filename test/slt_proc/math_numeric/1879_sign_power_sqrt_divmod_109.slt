# test/slt_proc/math_numeric/1879_sign_power_sqrt_divmod_109.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (109)

query IIIIII
SELECT SIGN(-109), SIGN(0), SIGN(109), CAST(SQRT(36) AS INT), CAST(POWER(6, 3) AS INT), (1862 % 7);
----
-1 0 1 6 216 0

query III
SELECT (1862 / 7), ABS(-1862), (109 * 12 - 7);
----
266 1862 1301

statement ok
CREATE PROCEDURE sp_math_step_1879 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1879 @x = 1862, @y = 7, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
266 0
