# test/slt_proc/math_numeric/1910_sign_power_sqrt_divmod_140.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (140)

query IIIIII
SELECT SIGN(-140), SIGN(0), SIGN(140), CAST(SQRT(49) AS INT), CAST(POWER(2, 4) AS INT), (2389 % 3);
----
-1 0 1 7 16 1

query III
SELECT (2389 / 3), ABS(-2389), (140 * 12 - 3);
----
796 2389 1677

statement ok
CREATE PROCEDURE sp_math_step_1910 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1910 @x = 2389, @y = 3, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
796 1
