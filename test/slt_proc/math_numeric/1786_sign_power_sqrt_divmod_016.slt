# test/slt_proc/math_numeric/1786_sign_power_sqrt_divmod_016.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (16)

query IIIIII
SELECT SIGN(-16), SIGN(0), SIGN(16), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (281 % 5);
----
-1 0 1 3 27 1

query III
SELECT (281 / 5), ABS(-281), (16 * 12 - 5);
----
56 281 187

statement ok
CREATE PROCEDURE sp_math_step_1786 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1786 @x = 281, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
56 1
