# test/slt_proc/math_numeric/074_numeric_and_bitwise_19.slt
# T-SQL ABS/SIGN/CEILING/FLOOR/POWER/SQRT/ROUND and bitwise ops (19)

query IIII
SELECT ABS(-254), SIGN(-254), CEILING(57.24), FLOOR(57.24);
----
254 -1 58 57

query RRR
SELECT POWER(6, 3), SQRT(361), ROUND(19.456, 2);
----
216.000 19.000 19.460

query III
SELECT 117 & 62, 117 | 62, 117 ^ 62;
----
52 127 75

statement ok
CREATE PROCEDURE sp_divmod_74 @x INT, @y INT
AS
BEGIN
    SELECT @x / @y, @x % @y, (@x / @y) * @y + (@x % @y);
END;

query III
EXEC sp_divmod_74 98, 21;
----
4 14 98
