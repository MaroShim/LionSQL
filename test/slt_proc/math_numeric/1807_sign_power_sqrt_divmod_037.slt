# test/slt_proc/math_numeric/1807_sign_power_sqrt_divmod_037.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (37)

query IIIIII
SELECT SIGN(-37), SIGN(0), SIGN(37), CAST(SQRT(81) AS INT), CAST(POWER(4, 3) AS INT), (638 % 5);
----
-1 0 1 9 64 3

query III
SELECT (638 / 5), ABS(-638), (37 * 12 - 5);
----
127 638 439

statement ok
CREATE PROCEDURE sp_math_step_1807 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1807 @x = 638, @y = 5, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
127 3
