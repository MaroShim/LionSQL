# test/slt_proc/math_numeric/1841_sign_power_sqrt_divmod_071.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (71)

query IIIIII
SELECT SIGN(-71), SIGN(0), SIGN(71), CAST(SQRT(169) AS INT), CAST(POWER(3, 4) AS INT), (1216 % 4);
----
-1 0 1 13 81 0

query III
SELECT (1216 / 4), ABS(-1216), (71 * 12 - 4);
----
304 1216 848

statement ok
CREATE PROCEDURE sp_math_step_1841 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1841 @x = 1216, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
304 0
