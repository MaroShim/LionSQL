# test/slt_proc/math_numeric/1799_sign_power_sqrt_divmod_029.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (29)

query IIIIII
SELECT SIGN(-29), SIGN(0), SIGN(29), CAST(SQRT(256) AS INT), CAST(POWER(6, 4) AS INT), (502 % 4);
----
-1 0 1 16 1296 2

query III
SELECT (502 / 4), ABS(-502), (29 * 12 - 4);
----
125 502 344

statement ok
CREATE PROCEDURE sp_math_step_1799 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1799 @x = 502, @y = 4, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
125 2
