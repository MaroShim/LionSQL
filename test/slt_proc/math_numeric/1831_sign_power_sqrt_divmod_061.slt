# test/slt_proc/math_numeric/1831_sign_power_sqrt_divmod_061.slt
# T-SQL SIGN, POWER, SQRT, integer division/modulo, and compound proc math (61)

query IIIIII
SELECT SIGN(-61), SIGN(0), SIGN(61), CAST(SQRT(9) AS INT), CAST(POWER(3, 3) AS INT), (1046 % 8);
----
-1 0 1 3 27 6

query III
SELECT (1046 / 8), ABS(-1046), (61 * 12 - 8);
----
130 1046 724

statement ok
CREATE PROCEDURE sp_math_step_1831 @x INT, @y INT, @q INT OUTPUT, @r INT OUTPUT
AS
BEGIN
    SET @q = @x / @y;
    SET @r = @x % @y;
END;

query II
DECLARE @quo INT;
DECLARE @rem INT;
EXEC sp_math_step_1831 @x = 1046, @y = 8, @q = @quo OUTPUT, @r = @rem OUTPUT;
SELECT @quo, @rem;
----
130 6
