# test/slt_proc/26_offset_fetch_paging.slt
# ORDER BY ... OFFSET ... FETCH NEXT paging

statement ok
CREATE TABLE page_items (id INT PRIMARY KEY);

statement ok
INSERT INTO page_items VALUES (1), (2), (3), (4), (5), (6);

query I
SELECT id FROM page_items ORDER BY id OFFSET 2 ROWS FETCH NEXT 3 ROWS ONLY;
----
3
4
5

query I
SELECT id FROM page_items ORDER BY id OFFSET 4 ROWS;
----
5
6

statement ok
CREATE PROCEDURE sp_page @skip INT, @take INT
AS
BEGIN
    SELECT id FROM page_items ORDER BY id OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query I
EXEC sp_page 1, 3;
----
2
3
4

statement ok
DROP PROCEDURE sp_page;

statement ok
DROP TABLE page_items;
