statement ok
CREATE TABLE #calc_stage_892 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_892 VALUES (1, 175), (2, 35), (3, -14);

statement ok
CREATE PROCEDURE sp_calc_net_892
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_892 @gross = 175, @bonus = 35, @tax = 14, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
196 NET_196

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_892;
----
3 196

statement ok
DROP TABLE #calc_stage_892;

statement ok
CREATE PROCEDURE sp_guard_fmt_892 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_892 107, 'SKU_07';
----
50000 16 1 Item SKU_07 failed with code 107
