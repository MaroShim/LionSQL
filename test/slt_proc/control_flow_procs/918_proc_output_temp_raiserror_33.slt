# test/slt_proc/control_flow_procs/918_proc_output_temp_raiserror_33.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (33)

statement ok
CREATE TABLE #calc_stage_918 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_918 VALUES (1, 825), (2, 165), (3, -66);

statement ok
CREATE PROCEDURE sp_calc_net_918
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_918 @gross = 825, @bonus = 165, @tax = 66, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
924 NET_924

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_918;
----
3 924

statement ok
DROP TABLE #calc_stage_918;

statement ok
CREATE PROCEDURE sp_guard_fmt_918 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_918 133, 'SKU_33';
----
50000 16 1 Item SKU_33 failed with code 133
