# test/slt_proc/control_flow_procs/152_while_and_try_catch_02.slt
# T-SQL WHILE loop accumulation and TRY...CATCH THROW (2)

statement ok
CREATE PROCEDURE sp_loop_try_152 @n INT, @fail INT
AS
BEGIN
    BEGIN TRY
        IF @fail = 1
        BEGIN
            THROW 52002, 'guard_triggered_2', 1;
        END;
        DECLARE @i INT = 1;
        DECLARE @s INT = 0;
        WHILE @i <= @n
        BEGIN
            SET @s = @s + @i;
            SET @i = @i + 1;
        END;
        SELECT @s, 'OK';
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_MESSAGE();
    END CATCH
END;

query IT
EXEC sp_loop_try_152 6, 0;
----
21 OK

query IT
EXEC sp_loop_try_152 6, 1;
----
52002 guard_triggered_2
