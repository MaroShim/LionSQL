CREATE TABLE #calc_stage_911 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_911 VALUES (1, 650), (2, 130), (3, -52);

statement ok
CREATE PROCEDURE sp_calc_net_911
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_911 @gross = 650, @bonus = 130, @tax = 52, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
728 NET_728

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_911;
----
3 728

statement ok
DROP TABLE #calc_stage_911;

statement ok
CREATE PROCEDURE sp_guard_fmt_911 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_911 126, 'SKU_26';
----
50000 16 1 Item SKU_26 failed with code 126
