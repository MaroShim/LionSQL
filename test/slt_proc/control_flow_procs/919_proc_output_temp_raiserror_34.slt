# test/slt_proc/control_flow_procs/919_proc_output_temp_raiserror_34.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (34)

statement ok
CREATE TABLE #calc_stage_919 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_919 VALUES (1, 850), (2, 170), (3, -68);

statement ok
CREATE PROCEDURE sp_calc_net_919
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_919 @gross = 850, @bonus = 170, @tax = 68, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
952 NET_952

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_919;
----
3 952

statement ok
DROP TABLE #calc_stage_919;

statement ok
CREATE PROCEDURE sp_guard_fmt_919 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_919 134, 'SKU_34';
----
50000 16 1 Item SKU_34 failed with code 134
