statement ok
CREATE TABLE #calc_stage_915 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_915 VALUES (1, 750), (2, 150), (3, -60);

statement ok
CREATE PROCEDURE sp_calc_net_915
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_915 @gross = 750, @bonus = 150, @tax = 60, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
840 NET_840

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_915;
----
3 840

statement ok
DROP TABLE #calc_stage_915;

statement ok
CREATE PROCEDURE sp_guard_fmt_915 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_915 130, 'SKU_30';
----
50000 16 1 Item SKU_30 failed with code 130
