# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (18)

statement ok
CREATE TABLE #calc_stage_903 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_903 VALUES (1, 450), (2, 90), (3, -36);

statement ok
CREATE PROCEDURE sp_calc_net_903
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_903 @gross = 450, @bonus = 90, @tax = 36, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
504 NET_504

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_903;
----
3 504

statement ok
DROP TABLE #calc_stage_903;

statement ok
CREATE PROCEDURE sp_guard_fmt_903 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_903 118, 'SKU_18';
----
50000 16 1 Item SKU_18 failed with code 118
