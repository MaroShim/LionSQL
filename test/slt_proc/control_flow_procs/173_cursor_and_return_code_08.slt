# test/slt_proc/control_flow_procs/173_cursor_and_return_code_08.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (8)

statement ok
CREATE TABLE cur_t_173 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_173 VALUES (1, 80), (2, 160), (3, 240);

statement ok
CREATE PROCEDURE sp_cur_173
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_173 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 208;
END;

query I
EXEC sp_cur_173;
----
480

statement ok
CREATE PROCEDURE sp_call_cur_173
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_173;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_173;
----
208

statement ok
DROP TABLE cur_t_173;
