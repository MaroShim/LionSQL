# test/slt_proc/control_flow_procs/175_cursor_and_return_code_10.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (10)

statement ok
CREATE TABLE cur_t_175 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_175 VALUES (1, 100), (2, 200), (3, 300);

statement ok
CREATE PROCEDURE sp_cur_175
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_175 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 210;
END;

query I
EXEC sp_cur_175;
----
600

statement ok
CREATE PROCEDURE sp_call_cur_175
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_175;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_175;
----
210

statement ok
DROP TABLE cur_t_175;
