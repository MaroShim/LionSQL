CREATE TABLE #calc_stage_912 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_912 VALUES (1, 675), (2, 135), (3, -54);

statement ok
CREATE PROCEDURE sp_calc_net_912
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_912 @gross = 675, @bonus = 135, @tax = 54, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
756 NET_756

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_912;
----
3 756

statement ok
DROP TABLE #calc_stage_912;

statement ok
CREATE PROCEDURE sp_guard_fmt_912 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_912 127, 'SKU_27';
----
50000 16 1 Item SKU_27 failed with code 127
