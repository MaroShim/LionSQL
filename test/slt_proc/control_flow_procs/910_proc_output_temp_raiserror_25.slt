# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (25)

statement ok
CREATE TABLE #calc_stage_910 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_910 VALUES (1, 625), (2, 125), (3, -50);

statement ok
CREATE PROCEDURE sp_calc_net_910
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_910 @gross = 625, @bonus = 125, @tax = 50, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
700 NET_700

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_910;
----
3 700

statement ok
DROP TABLE #calc_stage_910;

statement ok
CREATE PROCEDURE sp_guard_fmt_910 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_910 125, 'SKU_25';
----
50000 16 1 Item SKU_25 failed with code 125
