# test/slt_proc/control_flow_procs/177_cursor_and_return_code_12.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (12)

statement ok
CREATE TABLE cur_t_177 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_177 VALUES (1, 120), (2, 240), (3, 360);

statement ok
CREATE PROCEDURE sp_cur_177
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_177 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 212;
END;

query I
EXEC sp_cur_177;
----
720

statement ok
CREATE PROCEDURE sp_call_cur_177
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_177;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_177;
----
212

statement ok
DROP TABLE cur_t_177;
