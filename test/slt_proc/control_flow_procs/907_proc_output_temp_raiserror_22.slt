# test/slt_proc/control_flow_procs/907_proc_output_temp_raiserror_22.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (22)

statement ok
CREATE TABLE #calc_stage_907 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_907 VALUES (1, 550), (2, 110), (3, -44);

statement ok
CREATE PROCEDURE sp_calc_net_907
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_907 @gross = 550, @bonus = 110, @tax = 44, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
616 NET_616

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_907;
----
3 616

statement ok
DROP TABLE #calc_stage_907;

statement ok
CREATE PROCEDURE sp_guard_fmt_907 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_907 122, 'SKU_22';
----
50000 16 1 Item SKU_22 failed with code 122
