# test/slt_proc/control_flow_procs/908_proc_output_temp_raiserror_23.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (23)

statement ok
CREATE TABLE #calc_stage_908 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_908 VALUES (1, 575), (2, 115), (3, -46);

statement ok
CREATE PROCEDURE sp_calc_net_908
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_908 @gross = 575, @bonus = 115, @tax = 46, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
644 NET_644

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_908;
----
3 644

statement ok
DROP TABLE #calc_stage_908;

statement ok
CREATE PROCEDURE sp_guard_fmt_908 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_908 123, 'SKU_23';
----
50000 16 1 Item SKU_23 failed with code 123
