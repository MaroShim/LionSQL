# test/slt_proc/control_flow_procs/169_cursor_and_return_code_04.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (4)

statement ok
CREATE TABLE cur_t_169 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_169 VALUES (1, 40), (2, 80), (3, 120);

statement ok
CREATE PROCEDURE sp_cur_169
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_169 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 204;
END;

query I
EXEC sp_cur_169;
----
240

statement ok
CREATE PROCEDURE sp_call_cur_169
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_169;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_169;
----
204

statement ok
DROP TABLE cur_t_169;
