# test/slt_proc/control_flow_procs/904_proc_output_temp_raiserror_19.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (19)

statement ok
CREATE TABLE #calc_stage_904 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_904 VALUES (1, 475), (2, 95), (3, -38);

statement ok
CREATE PROCEDURE sp_calc_net_904
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_904 @gross = 475, @bonus = 95, @tax = 38, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
532 NET_532

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_904;
----
3 532

statement ok
DROP TABLE #calc_stage_904;

statement ok
CREATE PROCEDURE sp_guard_fmt_904 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_904 119, 'SKU_19';
----
50000 16 1 Item SKU_19 failed with code 119
