# test/slt_proc/control_flow_procs/905_proc_output_temp_raiserror_20.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (20)

statement ok
CREATE TABLE #calc_stage_905 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_905 VALUES (1, 500), (2, 100), (3, -40);

statement ok
CREATE PROCEDURE sp_calc_net_905
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_905 @gross = 500, @bonus = 100, @tax = 40, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
560 NET_560

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_905;
----
3 560

statement ok
DROP TABLE #calc_stage_905;

statement ok
CREATE PROCEDURE sp_guard_fmt_905 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_905 120, 'SKU_20';
----
50000 16 1 Item SKU_20 failed with code 120
