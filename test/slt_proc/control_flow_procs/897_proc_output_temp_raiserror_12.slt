statement ok
CREATE TABLE #calc_stage_897 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_897 VALUES (1, 300), (2, 60), (3, -24);

statement ok
CREATE PROCEDURE sp_calc_net_897
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_897 @gross = 300, @bonus = 60, @tax = 24, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
336 NET_336

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_897;
----
3 336

statement ok
DROP TABLE #calc_stage_897;

statement ok
CREATE PROCEDURE sp_guard_fmt_897 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_897 112, 'SKU_12';
----
50000 16 1 Item SKU_12 failed with code 112
