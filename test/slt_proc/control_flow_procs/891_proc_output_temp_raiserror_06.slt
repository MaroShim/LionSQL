# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (6)

statement ok
CREATE TABLE #calc_stage_891 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_891 VALUES (1, 150), (2, 30), (3, -12);

statement ok
CREATE PROCEDURE sp_calc_net_891
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_891 @gross = 150, @bonus = 30, @tax = 12, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
168 NET_168

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_891;
----
3 168

statement ok
DROP TABLE #calc_stage_891;

statement ok
CREATE PROCEDURE sp_guard_fmt_891 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_891 106, 'SKU_06';
----
50000 16 1 Item SKU_06 failed with code 106
