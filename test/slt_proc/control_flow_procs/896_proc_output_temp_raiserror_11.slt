statement ok
CREATE TABLE #calc_stage_896 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_896 VALUES (1, 275), (2, 55), (3, -22);

statement ok
CREATE PROCEDURE sp_calc_net_896
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_896 @gross = 275, @bonus = 55, @tax = 22, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
308 NET_308

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_896;
----
3 308

statement ok
DROP TABLE #calc_stage_896;

statement ok
CREATE PROCEDURE sp_guard_fmt_896 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_896 111, 'SKU_11';
----
50000 16 1 Item SKU_11 failed with code 111
