# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (29)

statement ok
CREATE TABLE #calc_stage_914 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_914 VALUES (1, 725), (2, 145), (3, -58);

statement ok
CREATE PROCEDURE sp_calc_net_914
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_914 @gross = 725, @bonus = 145, @tax = 58, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
812 NET_812

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_914;
----
3 812

statement ok
DROP TABLE #calc_stage_914;

statement ok
CREATE PROCEDURE sp_guard_fmt_914 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_914 129, 'SKU_29';
----
50000 16 1 Item SKU_29 failed with code 129
