# test/slt_proc/control_flow_procs/917_proc_output_temp_raiserror_32.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (32)

statement ok
CREATE TABLE #calc_stage_917 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_917 VALUES (1, 800), (2, 160), (3, -64);

statement ok
CREATE PROCEDURE sp_calc_net_917
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_917 @gross = 800, @bonus = 160, @tax = 64, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
896 NET_896

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_917;
----
3 896

statement ok
DROP TABLE #calc_stage_917;

statement ok
CREATE PROCEDURE sp_guard_fmt_917 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_917 132, 'SKU_32';
----
50000 16 1 Item SKU_32 failed with code 132
