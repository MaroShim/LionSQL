# test/slt_proc/control_flow_procs/887_proc_output_temp_raiserror_02.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (2)

statement ok
CREATE TABLE #calc_stage_887 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_887 VALUES (1, 50), (2, 10), (3, -4);

statement ok
CREATE PROCEDURE sp_calc_net_887
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_887 @gross = 50, @bonus = 10, @tax = 4, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
56 NET_56

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_887;
----
3 56

statement ok
DROP TABLE #calc_stage_887;

statement ok
CREATE PROCEDURE sp_guard_fmt_887 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_887 102, 'SKU_02';
----
50000 16 1 Item SKU_02 failed with code 102
