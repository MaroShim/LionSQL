# test/slt_proc/control_flow_procs/888_proc_output_temp_raiserror_03.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (3)

statement ok
CREATE TABLE #calc_stage_888 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_888 VALUES (1, 75), (2, 15), (3, -6);

statement ok
CREATE PROCEDURE sp_calc_net_888
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_888 @gross = 75, @bonus = 15, @tax = 6, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
84 NET_84

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_888;
----
3 84

statement ok
DROP TABLE #calc_stage_888;

statement ok
CREATE PROCEDURE sp_guard_fmt_888 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_888 103, 'SKU_03';
----
50000 16 1 Item SKU_03 failed with code 103
