CREATE TABLE #calc_stage_898 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_898 VALUES (1, 325), (2, 65), (3, -26);

statement ok
CREATE PROCEDURE sp_calc_net_898
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_898 @gross = 325, @bonus = 65, @tax = 26, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
364 NET_364

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_898;
----
3 364

statement ok
DROP TABLE #calc_stage_898;

statement ok
CREATE PROCEDURE sp_guard_fmt_898 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_898 113, 'SKU_13';
----
50000 16 1 Item SKU_13 failed with code 113
