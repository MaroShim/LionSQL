# test/slt_proc/control_flow_procs/900_proc_output_temp_raiserror_15.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (15)

statement ok
CREATE TABLE #calc_stage_900 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_900 VALUES (1, 375), (2, 75), (3, -30);

statement ok
CREATE PROCEDURE sp_calc_net_900
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_900 @gross = 375, @bonus = 75, @tax = 30, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
420 NET_420

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_900;
----
3 420

statement ok
DROP TABLE #calc_stage_900;

statement ok
CREATE PROCEDURE sp_guard_fmt_900 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_900 115, 'SKU_15';
----
50000 16 1 Item SKU_15 failed with code 115
