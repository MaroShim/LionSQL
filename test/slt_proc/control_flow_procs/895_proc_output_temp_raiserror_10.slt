# test/slt_proc/control_flow_procs/895_proc_output_temp_raiserror_10.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (10)

statement ok
CREATE TABLE #calc_stage_895 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_895 VALUES (1, 250), (2, 50), (3, -20);

statement ok
CREATE PROCEDURE sp_calc_net_895
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_895 @gross = 250, @bonus = 50, @tax = 20, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
280 NET_280

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_895;
----
3 280

statement ok
DROP TABLE #calc_stage_895;

statement ok
CREATE PROCEDURE sp_guard_fmt_895 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_895 110, 'SKU_10';
----
50000 16 1 Item SKU_10 failed with code 110
