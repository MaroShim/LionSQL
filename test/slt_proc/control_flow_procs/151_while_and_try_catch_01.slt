# test/slt_proc/control_flow_procs/151_while_and_try_catch_01.slt
# T-SQL WHILE loop accumulation and TRY...CATCH THROW (1)

statement ok
CREATE PROCEDURE sp_loop_try_151 @n INT, @fail INT
AS
BEGIN
    BEGIN TRY
        IF @fail = 1
        BEGIN
            THROW 52001, 'guard_triggered_1', 1;
        END;
        DECLARE @i INT = 1;
        DECLARE @s INT = 0;
        WHILE @i <= @n
        BEGIN
            SET @s = @s + @i;
            SET @i = @i + 1;
        END;
        SELECT @s, 'OK';
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_MESSAGE();
    END CATCH
END;

query IT
EXEC sp_loop_try_151 5, 0;
----
15 OK

query IT
EXEC sp_loop_try_151 5, 1;
----
52001 guard_triggered_1
