# test/slt_proc/control_flow_procs/166_cursor_and_return_code_01.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (1)

statement ok
CREATE TABLE cur_t_166 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_166 VALUES (1, 10), (2, 20), (3, 30);

statement ok
CREATE PROCEDURE sp_cur_166
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_166 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 201;
END;

query I
EXEC sp_cur_166;
----
60

statement ok
CREATE PROCEDURE sp_call_cur_166
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_166;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_166;
----
201

statement ok
DROP TABLE cur_t_166;
