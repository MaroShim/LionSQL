# test/slt_proc/control_flow_procs/178_cursor_and_return_code_13.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (13)

statement ok
CREATE TABLE cur_t_178 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_178 VALUES (1, 130), (2, 260), (3, 390);

statement ok
CREATE PROCEDURE sp_cur_178
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_178 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 213;
END;

query I
EXEC sp_cur_178;
----
780

statement ok
CREATE PROCEDURE sp_call_cur_178
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_178;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_178;
----
213

statement ok
DROP TABLE cur_t_178;
