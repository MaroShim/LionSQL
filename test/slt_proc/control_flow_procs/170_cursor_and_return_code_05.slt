# test/slt_proc/control_flow_procs/170_cursor_and_return_code_05.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (5)

statement ok
CREATE TABLE cur_t_170 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_170 VALUES (1, 50), (2, 100), (3, 150);

statement ok
CREATE PROCEDURE sp_cur_170
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_170 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 205;
END;

query I
EXEC sp_cur_170;
----
300

statement ok
CREATE PROCEDURE sp_call_cur_170
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_170;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_170;
----
205

statement ok
DROP TABLE cur_t_170;
