statement ok
CREATE TABLE #calc_stage_894 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_894 VALUES (1, 225), (2, 45), (3, -18);

statement ok
CREATE PROCEDURE sp_calc_net_894
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_894 @gross = 225, @bonus = 45, @tax = 18, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
252 NET_252

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_894;
----
3 252

statement ok
DROP TABLE #calc_stage_894;

statement ok
CREATE PROCEDURE sp_guard_fmt_894 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_894 109, 'SKU_09';
----
50000 16 1 Item SKU_09 failed with code 109
