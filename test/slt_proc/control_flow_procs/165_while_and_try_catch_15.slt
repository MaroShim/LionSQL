# test/slt_proc/control_flow_procs/165_while_and_try_catch_15.slt
# T-SQL WHILE loop accumulation and TRY...CATCH THROW (15)

statement ok
CREATE PROCEDURE sp_loop_try_165 @n INT, @fail INT
AS
BEGIN
    BEGIN TRY
        IF @fail = 1
        BEGIN
            THROW 52015, 'guard_triggered_15', 1;
        END;
        DECLARE @i INT = 1;
        DECLARE @s INT = 0;
        WHILE @i <= @n
        BEGIN
            SET @s = @s + @i;
            SET @i = @i + 1;
        END;
        SELECT @s, 'OK';
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_MESSAGE();
    END CATCH
END;

query IT
EXEC sp_loop_try_165 9, 0;
----
45 OK

query IT
EXEC sp_loop_try_165 9, 1;
----
52015 guard_triggered_15
