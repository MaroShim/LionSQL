# test/slt_proc/control_flow_procs/890_proc_output_temp_raiserror_05.slt
# T-SQL Stored Procedure OUTPUT params, #temp table, @table_var, RAISERROR format (5)

statement ok
CREATE TABLE #calc_stage_890 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_890 VALUES (1, 125), (2, 25), (3, -10);

statement ok
CREATE PROCEDURE sp_calc_net_890
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_890 @gross = 125, @bonus = 25, @tax = 10, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
140 NET_140

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_890;
----
3 140

statement ok
DROP TABLE #calc_stage_890;

statement ok
CREATE PROCEDURE sp_guard_fmt_890 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_890 105, 'SKU_05';
----
50000 16 1 Item SKU_05 failed with code 105
