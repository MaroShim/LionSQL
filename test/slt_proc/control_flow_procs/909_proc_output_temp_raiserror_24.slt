statement ok
CREATE TABLE #calc_stage_909 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_909 VALUES (1, 600), (2, 120), (3, -48);

statement ok
CREATE PROCEDURE sp_calc_net_909
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_909 @gross = 600, @bonus = 120, @tax = 48, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
672 NET_672

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_909;
----
3 672

statement ok
DROP TABLE #calc_stage_909;

statement ok
CREATE PROCEDURE sp_guard_fmt_909 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_909 124, 'SKU_24';
----
50000 16 1 Item SKU_24 failed with code 124
