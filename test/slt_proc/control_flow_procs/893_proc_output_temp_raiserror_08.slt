statement ok
CREATE TABLE #calc_stage_893 (step INT PRIMARY KEY, val INT);

statement ok
INSERT INTO #calc_stage_893 VALUES (1, 200), (2, 40), (3, -16);

statement ok
CREATE PROCEDURE sp_calc_net_893
    @gross INT,
    @bonus INT,
    @tax INT,
    @net INT OUTPUT,
    @label VARCHAR(50) OUTPUT
AS
BEGIN
    SET @net = @gross + @bonus - @tax;
    SET @label = CONCAT('NET_', CAST(@net AS VARCHAR(20)));
END;

query IT
DECLARE @n INT;
DECLARE @lbl VARCHAR(50);
EXEC sp_calc_net_893 @gross = 200, @bonus = 40, @tax = 16, @net = @n OUTPUT, @label = @lbl OUTPUT;
SELECT @n, @lbl;
----
224 NET_224

query II
SELECT COUNT(*), SUM(val) FROM #calc_stage_893;
----
3 224

statement ok
DROP TABLE #calc_stage_893;

statement ok
CREATE PROCEDURE sp_guard_fmt_893 @code INT, @item VARCHAR(30)
AS
BEGIN
    BEGIN TRY
        RAISERROR('Item %s failed with code %d', 16, 1, @item, @code) WITH NOWAIT;
    END TRY
    BEGIN CATCH
        SELECT ERROR_NUMBER(), ERROR_SEVERITY(), ERROR_STATE(), ERROR_MESSAGE();
    END CATCH
END;

query IIIT
EXEC sp_guard_fmt_893 108, 'SKU_08';
----
50000 16 1 Item SKU_08 failed with code 108
