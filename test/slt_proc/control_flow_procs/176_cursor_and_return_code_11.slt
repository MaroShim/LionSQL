# test/slt_proc/control_flow_procs/176_cursor_and_return_code_11.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (11)

statement ok
CREATE TABLE cur_t_176 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_176 VALUES (1, 110), (2, 220), (3, 330);

statement ok
CREATE PROCEDURE sp_cur_176
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_176 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 211;
END;

query I
EXEC sp_cur_176;
----
660

statement ok
CREATE PROCEDURE sp_call_cur_176
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_176;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_176;
----
211

statement ok
DROP TABLE cur_t_176;
