# test/slt_proc/control_flow_procs/171_cursor_and_return_code_06.slt
# T-SQL Cursor iteration and nested EXEC @rc = proc (6)

statement ok
CREATE TABLE cur_t_171 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO cur_t_171 VALUES (1, 60), (2, 120), (3, 180);

statement ok
CREATE PROCEDURE sp_cur_171
AS
BEGIN
    DECLARE @id INT;
    DECLARE @v INT;
    DECLARE @acc INT = 0;
    DECLARE c CURSOR FOR SELECT id, v FROM cur_t_171 ORDER BY id;
    OPEN c;
    FETCH NEXT FROM c INTO @id, @v;
    WHILE @@FETCH_STATUS = 0
    BEGIN
        SET @acc = @acc + @v;
        FETCH NEXT FROM c INTO @id, @v;
    END;
    CLOSE c;
    DEALLOCATE c;
    SELECT @acc;
    RETURN 206;
END;

query I
EXEC sp_cur_171;
----
360

statement ok
CREATE PROCEDURE sp_call_cur_171
AS
BEGIN
    DECLARE @rc INT;
    EXEC @rc = sp_cur_171;
    SELECT @rc;
END;

query I
EXEC sp_call_cur_171;
----
206

statement ok
DROP TABLE cur_t_171;
