# test/slt_proc/json_xml_compress/2223_json_compress_roundtrip_148.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (148)

query IIT
SELECT ISJSON('{"node":"node_148","code":1483,"active":true}'), ISJSON('invalid_json_148'), JSON_VALUE('{"node":"node_148","code":1483,"active":true}', '$.node');
----
1 0 node_148

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_148","code":1483,"active":true}', '$.code', 14809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2223-Key-1483')) AS VARCHAR(200));
----
14809 LionSQL-Compressed-Block-2223-Key-1483

statement ok
CREATE TABLE jc_store_2223 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2223 VALUES (1, '{"node":"node_148","code":1483,"active":true}', JSON_MODIFY('{"node":"node_148","code":1483,"active":true}', '$.code', 14809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2223
WHERE ISJSON(j) = 1;
----
1 node_148 14809

statement ok
DROP TABLE jc_store_2223;
