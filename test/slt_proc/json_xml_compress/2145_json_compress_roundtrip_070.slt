# test/slt_proc/json_xml_compress/2145_json_compress_roundtrip_070.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (70)

query IIT
SELECT ISJSON('{"node":"node_070","code":703,"active":true}'), ISJSON('invalid_json_70'), JSON_VALUE('{"node":"node_070","code":703,"active":true}', '$.node');
----
1 0 node_070

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_070","code":703,"active":true}', '$.code', 7009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2145-Key-703')) AS VARCHAR(200));
----
7009 LionSQL-Compressed-Block-2145-Key-703

statement ok
CREATE TABLE jc_store_2145 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2145 VALUES (1, '{"node":"node_070","code":703,"active":true}', JSON_MODIFY('{"node":"node_070","code":703,"active":true}', '$.code', 7009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2145
WHERE ISJSON(j) = 1;
----
1 node_070 7009

statement ok
DROP TABLE jc_store_2145;
