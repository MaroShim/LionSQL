# test/slt_proc/json_xml_compress/2164_json_compress_roundtrip_089.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (89)

query IIT
SELECT ISJSON('{"node":"node_089","code":893,"active":true}'), ISJSON('invalid_json_89'), JSON_VALUE('{"node":"node_089","code":893,"active":true}', '$.node');
----
1 0 node_089

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_089","code":893,"active":true}', '$.code', 8909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2164-Key-893')) AS VARCHAR(200));
----
8909 LionSQL-Compressed-Block-2164-Key-893

statement ok
CREATE TABLE jc_store_2164 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2164 VALUES (1, '{"node":"node_089","code":893,"active":true}', JSON_MODIFY('{"node":"node_089","code":893,"active":true}', '$.code', 8909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2164
WHERE ISJSON(j) = 1;
----
1 node_089 8909

statement ok
DROP TABLE jc_store_2164;
