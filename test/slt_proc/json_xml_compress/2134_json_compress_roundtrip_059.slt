# test/slt_proc/json_xml_compress/2134_json_compress_roundtrip_059.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (59)

query IIT
SELECT ISJSON('{"node":"node_059","code":593,"active":true}'), ISJSON('invalid_json_59'), JSON_VALUE('{"node":"node_059","code":593,"active":true}', '$.node');
----
1 0 node_059

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_059","code":593,"active":true}', '$.code', 5909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2134-Key-593')) AS VARCHAR(200));
----
5909 LionSQL-Compressed-Block-2134-Key-593

statement ok
CREATE TABLE jc_store_2134 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2134 VALUES (1, '{"node":"node_059","code":593,"active":true}', JSON_MODIFY('{"node":"node_059","code":593,"active":true}', '$.code', 5909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2134
WHERE ISJSON(j) = 1;
----
1 node_059 5909

statement ok
DROP TABLE jc_store_2134;
