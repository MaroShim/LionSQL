# test/slt_proc/json_xml_compress/2125_json_compress_roundtrip_050.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (50)

query IIT
SELECT ISJSON('{"node":"node_050","code":503,"active":true}'), ISJSON('invalid_json_50'), JSON_VALUE('{"node":"node_050","code":503,"active":true}', '$.node');
----
1 0 node_050

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_050","code":503,"active":true}', '$.code', 5009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2125-Key-503')) AS VARCHAR(200));
----
5009 LionSQL-Compressed-Block-2125-Key-503

statement ok
CREATE TABLE jc_store_2125 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2125 VALUES (1, '{"node":"node_050","code":503,"active":true}', JSON_MODIFY('{"node":"node_050","code":503,"active":true}', '$.code', 5009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2125
WHERE ISJSON(j) = 1;
----
1 node_050 5009

statement ok
DROP TABLE jc_store_2125;
