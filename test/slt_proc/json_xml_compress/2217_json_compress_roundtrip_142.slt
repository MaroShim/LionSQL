# test/slt_proc/json_xml_compress/2217_json_compress_roundtrip_142.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (142)

query IIT
SELECT ISJSON('{"node":"node_142","code":1423,"active":true}'), ISJSON('invalid_json_142'), JSON_VALUE('{"node":"node_142","code":1423,"active":true}', '$.node');
----
1 0 node_142

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_142","code":1423,"active":true}', '$.code', 14209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2217-Key-1423')) AS VARCHAR(200));
----
14209 LionSQL-Compressed-Block-2217-Key-1423

statement ok
CREATE TABLE jc_store_2217 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2217 VALUES (1, '{"node":"node_142","code":1423,"active":true}', JSON_MODIFY('{"node":"node_142","code":1423,"active":true}', '$.code', 14209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2217
WHERE ISJSON(j) = 1;
----
1 node_142 14209

statement ok
DROP TABLE jc_store_2217;
