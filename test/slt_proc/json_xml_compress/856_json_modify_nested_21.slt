# test/slt_proc/json_xml_compress/856_json_modify_nested_21.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (21)

query TTT
SELECT JSON_VALUE('{"service":"svc_21","env":"stage","Version":210,"meta":{"region":"kr-1"}}', '$.service'), JSON_VALUE('{"service":"svc_21","env":"stage","Version":210,"meta":{"region":"kr-1"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_21","env":"stage","Version":210,"meta":{"region":"kr-1"}}', '$.Version', 2107), '$.Version');
----
svc_21 kr-1 2107

statement ok
CREATE TABLE j_cfg_856 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_856 VALUES
(1, '{"service":"svc_21","env":"stage","Version":210,"meta":{"region":"kr-1"}}'),
(2, JSON_MODIFY('{"service":"svc_21","env":"stage","Version":210,"meta":{"region":"kr-1"}}', '$.Version', 2107));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_856
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_21 210
2 svc_21 2107

statement ok
DROP TABLE j_cfg_856;
