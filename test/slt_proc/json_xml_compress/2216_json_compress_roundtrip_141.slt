# test/slt_proc/json_xml_compress/2216_json_compress_roundtrip_141.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (141)

query IIT
SELECT ISJSON('{"node":"node_141","code":1413,"active":true}'), ISJSON('invalid_json_141'), JSON_VALUE('{"node":"node_141","code":1413,"active":true}', '$.node');
----
1 0 node_141

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_141","code":1413,"active":true}', '$.code', 14109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2216-Key-1413')) AS VARCHAR(200));
----
14109 LionSQL-Compressed-Block-2216-Key-1413

statement ok
CREATE TABLE jc_store_2216 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2216 VALUES (1, '{"node":"node_141","code":1413,"active":true}', JSON_MODIFY('{"node":"node_141","code":1413,"active":true}', '$.code', 14109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2216
WHERE ISJSON(j) = 1;
----
1 node_141 14109

statement ok
DROP TABLE jc_store_2216;
