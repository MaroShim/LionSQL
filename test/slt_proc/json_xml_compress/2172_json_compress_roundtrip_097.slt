# test/slt_proc/json_xml_compress/2172_json_compress_roundtrip_097.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (97)

query IIT
SELECT ISJSON('{"node":"node_097","code":973,"active":true}'), ISJSON('invalid_json_97'), JSON_VALUE('{"node":"node_097","code":973,"active":true}', '$.node');
----
1 0 node_097

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_097","code":973,"active":true}', '$.code', 9709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2172-Key-973')) AS VARCHAR(200));
----
9709 LionSQL-Compressed-Block-2172-Key-973

statement ok
CREATE TABLE jc_store_2172 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2172 VALUES (1, '{"node":"node_097","code":973,"active":true}', JSON_MODIFY('{"node":"node_097","code":973,"active":true}', '$.code', 9709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2172
WHERE ISJSON(j) = 1;
----
1 node_097 9709

statement ok
DROP TABLE jc_store_2172;
