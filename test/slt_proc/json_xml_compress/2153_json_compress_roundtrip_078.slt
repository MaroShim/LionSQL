# test/slt_proc/json_xml_compress/2153_json_compress_roundtrip_078.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (78)

query IIT
SELECT ISJSON('{"node":"node_078","code":783,"active":true}'), ISJSON('invalid_json_78'), JSON_VALUE('{"node":"node_078","code":783,"active":true}', '$.node');
----
1 0 node_078

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_078","code":783,"active":true}', '$.code', 7809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2153-Key-783')) AS VARCHAR(200));
----
7809 LionSQL-Compressed-Block-2153-Key-783

statement ok
CREATE TABLE jc_store_2153 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2153 VALUES (1, '{"node":"node_078","code":783,"active":true}', JSON_MODIFY('{"node":"node_078","code":783,"active":true}', '$.code', 7809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2153
WHERE ISJSON(j) = 1;
----
1 node_078 7809

statement ok
DROP TABLE jc_store_2153;
