# test/slt_proc/json_xml_compress/2124_json_compress_roundtrip_049.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (49)

query IIT
SELECT ISJSON('{"node":"node_049","code":493,"active":true}'), ISJSON('invalid_json_49'), JSON_VALUE('{"node":"node_049","code":493,"active":true}', '$.node');
----
1 0 node_049

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_049","code":493,"active":true}', '$.code', 4909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2124-Key-493')) AS VARCHAR(200));
----
4909 LionSQL-Compressed-Block-2124-Key-493

statement ok
CREATE TABLE jc_store_2124 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2124 VALUES (1, '{"node":"node_049","code":493,"active":true}', JSON_MODIFY('{"node":"node_049","code":493,"active":true}', '$.code', 4909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2124
WHERE ISJSON(j) = 1;
----
1 node_049 4909

statement ok
DROP TABLE jc_store_2124;
