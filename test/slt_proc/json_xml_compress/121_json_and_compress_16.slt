# test/slt_proc/json_xml_compress/121_json_and_compress_16.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (16)

query II
SELECT ISJSON('{"id":16,"user":"user_16","role":"editor","score":1625}'), ISJSON('invalid_16');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":16,"user":"user_16","role":"editor","score":1625}', '$.user'), JSON_VALUE('{"id":16,"user":"user_16","role":"editor","score":1625}', '$.role'), JSON_VALUE('{"id":16,"user":"user_16","role":"editor","score":1625}', '$.score');
----
user_16 editor 1625

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-16-XYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-16-XYZXYZ 7 1
