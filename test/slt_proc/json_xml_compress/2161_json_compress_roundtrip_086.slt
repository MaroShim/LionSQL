# test/slt_proc/json_xml_compress/2161_json_compress_roundtrip_086.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (86)

query IIT
SELECT ISJSON('{"node":"node_086","code":863,"active":true}'), ISJSON('invalid_json_86'), JSON_VALUE('{"node":"node_086","code":863,"active":true}', '$.node');
----
1 0 node_086

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_086","code":863,"active":true}', '$.code', 8609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2161-Key-863')) AS VARCHAR(200));
----
8609 LionSQL-Compressed-Block-2161-Key-863

statement ok
CREATE TABLE jc_store_2161 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2161 VALUES (1, '{"node":"node_086","code":863,"active":true}', JSON_MODIFY('{"node":"node_086","code":863,"active":true}', '$.code', 8609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2161
WHERE ISJSON(j) = 1;
----
1 node_086 8609

statement ok
DROP TABLE jc_store_2161;
