# test/slt_proc/json_xml_compress/2099_json_compress_roundtrip_024.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (24)

query IIT
SELECT ISJSON('{"node":"node_024","code":243,"active":true}'), ISJSON('invalid_json_24'), JSON_VALUE('{"node":"node_024","code":243,"active":true}', '$.node');
----
1 0 node_024

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_024","code":243,"active":true}', '$.code', 2409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2099-Key-243')) AS VARCHAR(200));
----
2409 LionSQL-Compressed-Block-2099-Key-243

statement ok
CREATE TABLE jc_store_2099 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2099 VALUES (1, '{"node":"node_024","code":243,"active":true}', JSON_MODIFY('{"node":"node_024","code":243,"active":true}', '$.code', 2409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2099
WHERE ISJSON(j) = 1;
----
1 node_024 2409

statement ok
DROP TABLE jc_store_2099;
