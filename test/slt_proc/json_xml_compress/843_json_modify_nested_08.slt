# test/slt_proc/json_xml_compress/843_json_modify_nested_08.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (8)

query TTT
SELECT JSON_VALUE('{"service":"svc_08","env":"prod","Version":80,"meta":{"region":"kr-3"}}', '$.service'), JSON_VALUE('{"service":"svc_08","env":"prod","Version":80,"meta":{"region":"kr-3"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_08","env":"prod","Version":80,"meta":{"region":"kr-3"}}', '$.Version', 807), '$.Version');
----
svc_08 kr-3 807

statement ok
CREATE TABLE j_cfg_843 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_843 VALUES
(1, '{"service":"svc_08","env":"prod","Version":80,"meta":{"region":"kr-3"}}'),
(2, JSON_MODIFY('{"service":"svc_08","env":"prod","Version":80,"meta":{"region":"kr-3"}}', '$.Version', 807));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_843
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_08 80
2 svc_08 807

statement ok
DROP TABLE j_cfg_843;
