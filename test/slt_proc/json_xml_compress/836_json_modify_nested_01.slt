# test/slt_proc/json_xml_compress/836_json_modify_nested_01.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (1)

query TTT
SELECT JSON_VALUE('{"service":"svc_01","env":"stage","Version":10,"meta":{"region":"kr-2"}}', '$.service'), JSON_VALUE('{"service":"svc_01","env":"stage","Version":10,"meta":{"region":"kr-2"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_01","env":"stage","Version":10,"meta":{"region":"kr-2"}}', '$.Version', 107), '$.Version');
----
svc_01 kr-2 107

statement ok
CREATE TABLE j_cfg_836 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_836 VALUES
(1, '{"service":"svc_01","env":"stage","Version":10,"meta":{"region":"kr-2"}}'),
(2, JSON_MODIFY('{"service":"svc_01","env":"stage","Version":10,"meta":{"region":"kr-2"}}', '$.Version', 107));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_836
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_01 10
2 svc_01 107

statement ok
DROP TABLE j_cfg_836;
