# test/slt_proc/json_xml_compress/110_json_and_compress_05.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (5)

query II
SELECT ISJSON('{"id":5,"user":"user_05","role":"admin","score":525}'), ISJSON('invalid_5');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":5,"user":"user_05","role":"admin","score":525}', '$.user'), JSON_VALUE('{"id":5,"user":"user_05","role":"admin","score":525}', '$.role'), JSON_VALUE('{"id":5,"user":"user_05","role":"admin","score":525}', '$.score');
----
user_05 admin 525

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-05-XYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-05-XYZXYZXYZ 7 1
