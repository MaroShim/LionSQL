# test/slt_proc/json_xml_compress/854_json_modify_nested_19.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (19)

query TTT
SELECT JSON_VALUE('{"service":"svc_19","env":"qa","Version":190,"meta":{"region":"kr-2"}}', '$.service'), JSON_VALUE('{"service":"svc_19","env":"qa","Version":190,"meta":{"region":"kr-2"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_19","env":"qa","Version":190,"meta":{"region":"kr-2"}}', '$.Version', 1907), '$.Version');
----
svc_19 kr-2 1907

statement ok
CREATE TABLE j_cfg_854 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_854 VALUES
(1, '{"service":"svc_19","env":"qa","Version":190,"meta":{"region":"kr-2"}}'),
(2, JSON_MODIFY('{"service":"svc_19","env":"qa","Version":190,"meta":{"region":"kr-2"}}', '$.Version', 1907));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_854
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_19 190
2 svc_19 1907

statement ok
DROP TABLE j_cfg_854;
