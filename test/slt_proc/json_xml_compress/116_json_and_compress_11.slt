# test/slt_proc/json_xml_compress/116_json_and_compress_11.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (11)

query II
SELECT ISJSON('{"id":11,"user":"user_11","role":"editor","score":1125}'), ISJSON('invalid_11');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":11,"user":"user_11","role":"editor","score":1125}', '$.user'), JSON_VALUE('{"id":11,"user":"user_11","role":"editor","score":1125}', '$.role'), JSON_VALUE('{"id":11,"user":"user_11","role":"editor","score":1125}', '$.score');
----
user_11 editor 1125

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-11-XYZXYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-11-XYZXYZXYZXYZXYZ 7 1
