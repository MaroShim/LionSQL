# test/slt_proc/json_xml_compress/2157_json_compress_roundtrip_082.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (82)

query IIT
SELECT ISJSON('{"node":"node_082","code":823,"active":true}'), ISJSON('invalid_json_82'), JSON_VALUE('{"node":"node_082","code":823,"active":true}', '$.node');
----
1 0 node_082

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_082","code":823,"active":true}', '$.code', 8209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2157-Key-823')) AS VARCHAR(200));
----
8209 LionSQL-Compressed-Block-2157-Key-823

statement ok
CREATE TABLE jc_store_2157 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2157 VALUES (1, '{"node":"node_082","code":823,"active":true}', JSON_MODIFY('{"node":"node_082","code":823,"active":true}', '$.code', 8209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2157
WHERE ISJSON(j) = 1;
----
1 node_082 8209

statement ok
DROP TABLE jc_store_2157;
