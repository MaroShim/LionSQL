# test/slt_proc/json_xml_compress/2186_json_compress_roundtrip_111.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (111)

query IIT
SELECT ISJSON('{"node":"node_111","code":1113,"active":true}'), ISJSON('invalid_json_111'), JSON_VALUE('{"node":"node_111","code":1113,"active":true}', '$.node');
----
1 0 node_111

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_111","code":1113,"active":true}', '$.code', 11109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2186-Key-1113')) AS VARCHAR(200));
----
11109 LionSQL-Compressed-Block-2186-Key-1113

statement ok
CREATE TABLE jc_store_2186 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2186 VALUES (1, '{"node":"node_111","code":1113,"active":true}', JSON_MODIFY('{"node":"node_111","code":1113,"active":true}', '$.code', 11109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2186
WHERE ISJSON(j) = 1;
----
1 node_111 11109

statement ok
DROP TABLE jc_store_2186;
