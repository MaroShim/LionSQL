# test/slt_proc/json_xml_compress/2140_json_compress_roundtrip_065.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (65)

query IIT
SELECT ISJSON('{"node":"node_065","code":653,"active":true}'), ISJSON('invalid_json_65'), JSON_VALUE('{"node":"node_065","code":653,"active":true}', '$.node');
----
1 0 node_065

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_065","code":653,"active":true}', '$.code', 6509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2140-Key-653')) AS VARCHAR(200));
----
6509 LionSQL-Compressed-Block-2140-Key-653

statement ok
CREATE TABLE jc_store_2140 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2140 VALUES (1, '{"node":"node_065","code":653,"active":true}', JSON_MODIFY('{"node":"node_065","code":653,"active":true}', '$.code', 6509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2140
WHERE ISJSON(j) = 1;
----
1 node_065 6509

statement ok
DROP TABLE jc_store_2140;
