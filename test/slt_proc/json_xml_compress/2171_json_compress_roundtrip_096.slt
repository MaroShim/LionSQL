# test/slt_proc/json_xml_compress/2171_json_compress_roundtrip_096.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (96)

query IIT
SELECT ISJSON('{"node":"node_096","code":963,"active":true}'), ISJSON('invalid_json_96'), JSON_VALUE('{"node":"node_096","code":963,"active":true}', '$.node');
----
1 0 node_096

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_096","code":963,"active":true}', '$.code', 9609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2171-Key-963')) AS VARCHAR(200));
----
9609 LionSQL-Compressed-Block-2171-Key-963

statement ok
CREATE TABLE jc_store_2171 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2171 VALUES (1, '{"node":"node_096","code":963,"active":true}', JSON_MODIFY('{"node":"node_096","code":963,"active":true}', '$.code', 9609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2171
WHERE ISJSON(j) = 1;
----
1 node_096 9609

statement ok
DROP TABLE jc_store_2171;
