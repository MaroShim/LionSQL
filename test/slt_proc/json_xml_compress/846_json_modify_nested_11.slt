# test/slt_proc/json_xml_compress/846_json_modify_nested_11.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (11)

query TTT
SELECT JSON_VALUE('{"service":"svc_11","env":"qa","Version":110,"meta":{"region":"kr-3"}}', '$.service'), JSON_VALUE('{"service":"svc_11","env":"qa","Version":110,"meta":{"region":"kr-3"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_11","env":"qa","Version":110,"meta":{"region":"kr-3"}}', '$.Version', 1107), '$.Version');
----
svc_11 kr-3 1107

statement ok
CREATE TABLE j_cfg_846 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_846 VALUES
(1, '{"service":"svc_11","env":"qa","Version":110,"meta":{"region":"kr-3"}}'),
(2, JSON_MODIFY('{"service":"svc_11","env":"qa","Version":110,"meta":{"region":"kr-3"}}', '$.Version', 1107));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_846
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_11 110
2 svc_11 1107

statement ok
DROP TABLE j_cfg_846;
