# test/slt_proc/json_xml_compress/2137_json_compress_roundtrip_062.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (62)

query IIT
SELECT ISJSON('{"node":"node_062","code":623,"active":true}'), ISJSON('invalid_json_62'), JSON_VALUE('{"node":"node_062","code":623,"active":true}', '$.node');
----
1 0 node_062

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_062","code":623,"active":true}', '$.code', 6209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2137-Key-623')) AS VARCHAR(200));
----
6209 LionSQL-Compressed-Block-2137-Key-623

statement ok
CREATE TABLE jc_store_2137 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2137 VALUES (1, '{"node":"node_062","code":623,"active":true}', JSON_MODIFY('{"node":"node_062","code":623,"active":true}', '$.code', 6209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2137
WHERE ISJSON(j) = 1;
----
1 node_062 6209

statement ok
DROP TABLE jc_store_2137;
