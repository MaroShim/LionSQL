# test/slt_proc/json_xml_compress/2173_json_compress_roundtrip_098.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (98)

query IIT
SELECT ISJSON('{"node":"node_098","code":983,"active":true}'), ISJSON('invalid_json_98'), JSON_VALUE('{"node":"node_098","code":983,"active":true}', '$.node');
----
1 0 node_098

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_098","code":983,"active":true}', '$.code', 9809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2173-Key-983')) AS VARCHAR(200));
----
9809 LionSQL-Compressed-Block-2173-Key-983

statement ok
CREATE TABLE jc_store_2173 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2173 VALUES (1, '{"node":"node_098","code":983,"active":true}', JSON_MODIFY('{"node":"node_098","code":983,"active":true}', '$.code', 9809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2173
WHERE ISJSON(j) = 1;
----
1 node_098 9809

statement ok
DROP TABLE jc_store_2173;
