# test/slt_proc/json_xml_compress/2090_json_compress_roundtrip_015.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (15)

query IIT
SELECT ISJSON('{"node":"node_015","code":153,"active":true}'), ISJSON('invalid_json_15'), JSON_VALUE('{"node":"node_015","code":153,"active":true}', '$.node');
----
1 0 node_015

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_015","code":153,"active":true}', '$.code', 1509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2090-Key-153')) AS VARCHAR(200));
----
1509 LionSQL-Compressed-Block-2090-Key-153

statement ok
CREATE TABLE jc_store_2090 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2090 VALUES (1, '{"node":"node_015","code":153,"active":true}', JSON_MODIFY('{"node":"node_015","code":153,"active":true}', '$.code', 1509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2090
WHERE ISJSON(j) = 1;
----
1 node_015 1509

statement ok
DROP TABLE jc_store_2090;
