# test/slt_proc/json_xml_compress/119_json_and_compress_14.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (14)

query II
SELECT ISJSON('{"id":14,"user":"user_14","role":"operator","score":1425}'), ISJSON('invalid_14');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":14,"user":"user_14","role":"operator","score":1425}', '$.user'), JSON_VALUE('{"id":14,"user":"user_14","role":"operator","score":1425}', '$.role'), JSON_VALUE('{"id":14,"user":"user_14","role":"operator","score":1425}', '$.score');
----
user_14 operator 1425

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-14-XYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-14-XYZXYZXYZXYZ 7 1
