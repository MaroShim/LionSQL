# test/slt_proc/json_xml_compress/2114_json_compress_roundtrip_039.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (39)

query IIT
SELECT ISJSON('{"node":"node_039","code":393,"active":true}'), ISJSON('invalid_json_39'), JSON_VALUE('{"node":"node_039","code":393,"active":true}', '$.node');
----
1 0 node_039

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_039","code":393,"active":true}', '$.code', 3909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2114-Key-393')) AS VARCHAR(200));
----
3909 LionSQL-Compressed-Block-2114-Key-393

statement ok
CREATE TABLE jc_store_2114 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2114 VALUES (1, '{"node":"node_039","code":393,"active":true}', JSON_MODIFY('{"node":"node_039","code":393,"active":true}', '$.code', 3909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2114
WHERE ISJSON(j) = 1;
----
1 node_039 3909

statement ok
DROP TABLE jc_store_2114;
