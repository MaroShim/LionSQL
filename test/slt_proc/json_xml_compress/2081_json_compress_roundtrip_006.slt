# test/slt_proc/json_xml_compress/2081_json_compress_roundtrip_006.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (6)

query IIT
SELECT ISJSON('{"node":"node_006","code":63,"active":true}'), ISJSON('invalid_json_6'), JSON_VALUE('{"node":"node_006","code":63,"active":true}', '$.node');
----
1 0 node_006

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_006","code":63,"active":true}', '$.code', 609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2081-Key-63')) AS VARCHAR(200));
----
609 LionSQL-Compressed-Block-2081-Key-63

statement ok
CREATE TABLE jc_store_2081 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2081 VALUES (1, '{"node":"node_006","code":63,"active":true}', JSON_MODIFY('{"node":"node_006","code":63,"active":true}', '$.code', 609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2081
WHERE ISJSON(j) = 1;
----
1 node_006 609

statement ok
DROP TABLE jc_store_2081;
