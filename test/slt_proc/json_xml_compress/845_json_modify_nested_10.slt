# test/slt_proc/json_xml_compress/845_json_modify_nested_10.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (10)

query TTT
SELECT JSON_VALUE('{"service":"svc_10","env":"dev","Version":100,"meta":{"region":"kr-2"}}', '$.service'), JSON_VALUE('{"service":"svc_10","env":"dev","Version":100,"meta":{"region":"kr-2"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_10","env":"dev","Version":100,"meta":{"region":"kr-2"}}', '$.Version', 1007), '$.Version');
----
svc_10 kr-2 1007

statement ok
CREATE TABLE j_cfg_845 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_845 VALUES
(1, '{"service":"svc_10","env":"dev","Version":100,"meta":{"region":"kr-2"}}'),
(2, JSON_MODIFY('{"service":"svc_10","env":"dev","Version":100,"meta":{"region":"kr-2"}}', '$.Version', 1007));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_845
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_10 100
2 svc_10 1007

statement ok
DROP TABLE j_cfg_845;
