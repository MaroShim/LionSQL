# test/slt_proc/json_xml_compress/2082_json_compress_roundtrip_007.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (7)

query IIT
SELECT ISJSON('{"node":"node_007","code":73,"active":true}'), ISJSON('invalid_json_7'), JSON_VALUE('{"node":"node_007","code":73,"active":true}', '$.node');
----
1 0 node_007

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_007","code":73,"active":true}', '$.code', 709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2082-Key-73')) AS VARCHAR(200));
----
709 LionSQL-Compressed-Block-2082-Key-73

statement ok
CREATE TABLE jc_store_2082 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2082 VALUES (1, '{"node":"node_007","code":73,"active":true}', JSON_MODIFY('{"node":"node_007","code":73,"active":true}', '$.code', 709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2082
WHERE ISJSON(j) = 1;
----
1 node_007 709

statement ok
DROP TABLE jc_store_2082;
