# test/slt_proc/json_xml_compress/2079_json_compress_roundtrip_004.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (4)

query IIT
SELECT ISJSON('{"node":"node_004","code":43,"active":true}'), ISJSON('invalid_json_4'), JSON_VALUE('{"node":"node_004","code":43,"active":true}', '$.node');
----
1 0 node_004

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_004","code":43,"active":true}', '$.code', 409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2079-Key-43')) AS VARCHAR(200));
----
409 LionSQL-Compressed-Block-2079-Key-43

statement ok
CREATE TABLE jc_store_2079 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2079 VALUES (1, '{"node":"node_004","code":43,"active":true}', JSON_MODIFY('{"node":"node_004","code":43,"active":true}', '$.code', 409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2079
WHERE ISJSON(j) = 1;
----
1 node_004 409

statement ok
DROP TABLE jc_store_2079;
