# test/slt_proc/json_xml_compress/2130_json_compress_roundtrip_055.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (55)

query IIT
SELECT ISJSON('{"node":"node_055","code":553,"active":true}'), ISJSON('invalid_json_55'), JSON_VALUE('{"node":"node_055","code":553,"active":true}', '$.node');
----
1 0 node_055

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_055","code":553,"active":true}', '$.code', 5509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2130-Key-553')) AS VARCHAR(200));
----
5509 LionSQL-Compressed-Block-2130-Key-553

statement ok
CREATE TABLE jc_store_2130 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2130 VALUES (1, '{"node":"node_055","code":553,"active":true}', JSON_MODIFY('{"node":"node_055","code":553,"active":true}', '$.code', 5509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2130
WHERE ISJSON(j) = 1;
----
1 node_055 5509

statement ok
DROP TABLE jc_store_2130;
