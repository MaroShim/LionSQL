# test/slt_proc/json_xml_compress/837_json_modify_nested_02.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (2)

query TTT
SELECT JSON_VALUE('{"service":"svc_02","env":"dev","Version":20,"meta":{"region":"kr-3"}}', '$.service'), JSON_VALUE('{"service":"svc_02","env":"dev","Version":20,"meta":{"region":"kr-3"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_02","env":"dev","Version":20,"meta":{"region":"kr-3"}}', '$.Version', 207), '$.Version');
----
svc_02 kr-3 207

statement ok
CREATE TABLE j_cfg_837 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_837 VALUES
(1, '{"service":"svc_02","env":"dev","Version":20,"meta":{"region":"kr-3"}}'),
(2, JSON_MODIFY('{"service":"svc_02","env":"dev","Version":20,"meta":{"region":"kr-3"}}', '$.Version', 207));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_837
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_02 20
2 svc_02 207

statement ok
DROP TABLE j_cfg_837;
