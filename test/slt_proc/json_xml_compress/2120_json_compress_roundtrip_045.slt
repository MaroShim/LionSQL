# test/slt_proc/json_xml_compress/2120_json_compress_roundtrip_045.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (45)

query IIT
SELECT ISJSON('{"node":"node_045","code":453,"active":true}'), ISJSON('invalid_json_45'), JSON_VALUE('{"node":"node_045","code":453,"active":true}', '$.node');
----
1 0 node_045

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_045","code":453,"active":true}', '$.code', 4509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2120-Key-453')) AS VARCHAR(200));
----
4509 LionSQL-Compressed-Block-2120-Key-453

statement ok
CREATE TABLE jc_store_2120 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2120 VALUES (1, '{"node":"node_045","code":453,"active":true}', JSON_MODIFY('{"node":"node_045","code":453,"active":true}', '$.code', 4509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2120
WHERE ISJSON(j) = 1;
----
1 node_045 4509

statement ok
DROP TABLE jc_store_2120;
