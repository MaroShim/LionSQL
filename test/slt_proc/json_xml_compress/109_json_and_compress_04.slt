# test/slt_proc/json_xml_compress/109_json_and_compress_04.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (4)

query II
SELECT ISJSON('{"id":4,"user":"user_04","role":"operator","score":425}'), ISJSON('invalid_4');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":4,"user":"user_04","role":"operator","score":425}', '$.user'), JSON_VALUE('{"id":4,"user":"user_04","role":"operator","score":425}', '$.role'), JSON_VALUE('{"id":4,"user":"user_04","role":"operator","score":425}', '$.score');
----
user_04 operator 425

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-04-XYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-04-XYZXYZ 7 1
