# test/slt_proc/json_xml_compress/2155_json_compress_roundtrip_080.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (80)

query IIT
SELECT ISJSON('{"node":"node_080","code":803,"active":true}'), ISJSON('invalid_json_80'), JSON_VALUE('{"node":"node_080","code":803,"active":true}', '$.node');
----
1 0 node_080

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_080","code":803,"active":true}', '$.code', 8009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2155-Key-803')) AS VARCHAR(200));
----
8009 LionSQL-Compressed-Block-2155-Key-803

statement ok
CREATE TABLE jc_store_2155 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2155 VALUES (1, '{"node":"node_080","code":803,"active":true}', JSON_MODIFY('{"node":"node_080","code":803,"active":true}', '$.code', 8009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2155
WHERE ISJSON(j) = 1;
----
1 node_080 8009

statement ok
DROP TABLE jc_store_2155;
