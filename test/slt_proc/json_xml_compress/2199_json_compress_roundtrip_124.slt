# test/slt_proc/json_xml_compress/2199_json_compress_roundtrip_124.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (124)

query IIT
SELECT ISJSON('{"node":"node_124","code":1243,"active":true}'), ISJSON('invalid_json_124'), JSON_VALUE('{"node":"node_124","code":1243,"active":true}', '$.node');
----
1 0 node_124

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_124","code":1243,"active":true}', '$.code', 12409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2199-Key-1243')) AS VARCHAR(200));
----
12409 LionSQL-Compressed-Block-2199-Key-1243

statement ok
CREATE TABLE jc_store_2199 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2199 VALUES (1, '{"node":"node_124","code":1243,"active":true}', JSON_MODIFY('{"node":"node_124","code":1243,"active":true}', '$.code', 12409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2199
WHERE ISJSON(j) = 1;
----
1 node_124 12409

statement ok
DROP TABLE jc_store_2199;
