# test/slt_proc/json_xml_compress/2220_json_compress_roundtrip_145.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (145)

query IIT
SELECT ISJSON('{"node":"node_145","code":1453,"active":true}'), ISJSON('invalid_json_145'), JSON_VALUE('{"node":"node_145","code":1453,"active":true}', '$.node');
----
1 0 node_145

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_145","code":1453,"active":true}', '$.code', 14509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2220-Key-1453')) AS VARCHAR(200));
----
14509 LionSQL-Compressed-Block-2220-Key-1453

statement ok
CREATE TABLE jc_store_2220 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2220 VALUES (1, '{"node":"node_145","code":1453,"active":true}', JSON_MODIFY('{"node":"node_145","code":1453,"active":true}', '$.code', 14509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2220
WHERE ISJSON(j) = 1;
----
1 node_145 14509

statement ok
DROP TABLE jc_store_2220;
