# test/slt_proc/json_xml_compress/2115_json_compress_roundtrip_040.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (40)

query IIT
SELECT ISJSON('{"node":"node_040","code":403,"active":true}'), ISJSON('invalid_json_40'), JSON_VALUE('{"node":"node_040","code":403,"active":true}', '$.node');
----
1 0 node_040

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_040","code":403,"active":true}', '$.code', 4009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2115-Key-403')) AS VARCHAR(200));
----
4009 LionSQL-Compressed-Block-2115-Key-403

statement ok
CREATE TABLE jc_store_2115 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2115 VALUES (1, '{"node":"node_040","code":403,"active":true}', JSON_MODIFY('{"node":"node_040","code":403,"active":true}', '$.code', 4009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2115
WHERE ISJSON(j) = 1;
----
1 node_040 4009

statement ok
DROP TABLE jc_store_2115;
