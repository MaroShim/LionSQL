# test/slt_proc/json_xml_compress/2169_json_compress_roundtrip_094.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (94)

query IIT
SELECT ISJSON('{"node":"node_094","code":943,"active":true}'), ISJSON('invalid_json_94'), JSON_VALUE('{"node":"node_094","code":943,"active":true}', '$.node');
----
1 0 node_094

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_094","code":943,"active":true}', '$.code', 9409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2169-Key-943')) AS VARCHAR(200));
----
9409 LionSQL-Compressed-Block-2169-Key-943

statement ok
CREATE TABLE jc_store_2169 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2169 VALUES (1, '{"node":"node_094","code":943,"active":true}', JSON_MODIFY('{"node":"node_094","code":943,"active":true}', '$.code', 9409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2169
WHERE ISJSON(j) = 1;
----
1 node_094 9409

statement ok
DROP TABLE jc_store_2169;
