# test/slt_proc/json_xml_compress/2166_json_compress_roundtrip_091.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (91)

query IIT
SELECT ISJSON('{"node":"node_091","code":913,"active":true}'), ISJSON('invalid_json_91'), JSON_VALUE('{"node":"node_091","code":913,"active":true}', '$.node');
----
1 0 node_091

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_091","code":913,"active":true}', '$.code', 9109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2166-Key-913')) AS VARCHAR(200));
----
9109 LionSQL-Compressed-Block-2166-Key-913

statement ok
CREATE TABLE jc_store_2166 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2166 VALUES (1, '{"node":"node_091","code":913,"active":true}', JSON_MODIFY('{"node":"node_091","code":913,"active":true}', '$.code', 9109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2166
WHERE ISJSON(j) = 1;
----
1 node_091 9109

statement ok
DROP TABLE jc_store_2166;
