# test/slt_proc/json_xml_compress/840_json_modify_nested_05.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (5)

query TTT
SELECT JSON_VALUE('{"service":"svc_05","env":"stage","Version":50,"meta":{"region":"kr-3"}}', '$.service'), JSON_VALUE('{"service":"svc_05","env":"stage","Version":50,"meta":{"region":"kr-3"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_05","env":"stage","Version":50,"meta":{"region":"kr-3"}}', '$.Version', 507), '$.Version');
----
svc_05 kr-3 507

statement ok
CREATE TABLE j_cfg_840 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_840 VALUES
(1, '{"service":"svc_05","env":"stage","Version":50,"meta":{"region":"kr-3"}}'),
(2, JSON_MODIFY('{"service":"svc_05","env":"stage","Version":50,"meta":{"region":"kr-3"}}', '$.Version', 507));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_840
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_05 50
2 svc_05 507

statement ok
DROP TABLE j_cfg_840;
