# test/slt_proc/json_xml_compress/2196_json_compress_roundtrip_121.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (121)

query IIT
SELECT ISJSON('{"node":"node_121","code":1213,"active":true}'), ISJSON('invalid_json_121'), JSON_VALUE('{"node":"node_121","code":1213,"active":true}', '$.node');
----
1 0 node_121

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_121","code":1213,"active":true}', '$.code', 12109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2196-Key-1213')) AS VARCHAR(200));
----
12109 LionSQL-Compressed-Block-2196-Key-1213

statement ok
CREATE TABLE jc_store_2196 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2196 VALUES (1, '{"node":"node_121","code":1213,"active":true}', JSON_MODIFY('{"node":"node_121","code":1213,"active":true}', '$.code', 12109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2196
WHERE ISJSON(j) = 1;
----
1 node_121 12109

statement ok
DROP TABLE jc_store_2196;
