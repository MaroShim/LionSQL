# test/slt_proc/json_xml_compress/111_json_and_compress_06.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (6)

query II
SELECT ISJSON('{"id":6,"user":"user_06","role":"editor","score":625}'), ISJSON('invalid_6');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":6,"user":"user_06","role":"editor","score":625}', '$.user'), JSON_VALUE('{"id":6,"user":"user_06","role":"editor","score":625}', '$.role'), JSON_VALUE('{"id":6,"user":"user_06","role":"editor","score":625}', '$.score');
----
user_06 editor 625

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-06-XYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-06-XYZXYZXYZXYZ 7 1
