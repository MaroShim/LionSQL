# test/slt_proc/json_xml_compress/2206_json_compress_roundtrip_131.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (131)

query IIT
SELECT ISJSON('{"node":"node_131","code":1313,"active":true}'), ISJSON('invalid_json_131'), JSON_VALUE('{"node":"node_131","code":1313,"active":true}', '$.node');
----
1 0 node_131

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_131","code":1313,"active":true}', '$.code', 13109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2206-Key-1313')) AS VARCHAR(200));
----
13109 LionSQL-Compressed-Block-2206-Key-1313

statement ok
CREATE TABLE jc_store_2206 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2206 VALUES (1, '{"node":"node_131","code":1313,"active":true}', JSON_MODIFY('{"node":"node_131","code":1313,"active":true}', '$.code', 13109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2206
WHERE ISJSON(j) = 1;
----
1 node_131 13109

statement ok
DROP TABLE jc_store_2206;
