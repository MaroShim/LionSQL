# test/slt_proc/json_xml_compress/2147_json_compress_roundtrip_072.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (72)

query IIT
SELECT ISJSON('{"node":"node_072","code":723,"active":true}'), ISJSON('invalid_json_72'), JSON_VALUE('{"node":"node_072","code":723,"active":true}', '$.node');
----
1 0 node_072

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_072","code":723,"active":true}', '$.code', 7209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2147-Key-723')) AS VARCHAR(200));
----
7209 LionSQL-Compressed-Block-2147-Key-723

statement ok
CREATE TABLE jc_store_2147 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2147 VALUES (1, '{"node":"node_072","code":723,"active":true}', JSON_MODIFY('{"node":"node_072","code":723,"active":true}', '$.code', 7209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2147
WHERE ISJSON(j) = 1;
----
1 node_072 7209

statement ok
DROP TABLE jc_store_2147;
