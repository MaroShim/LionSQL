# test/slt_proc/json_xml_compress/2138_json_compress_roundtrip_063.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (63)

query IIT
SELECT ISJSON('{"node":"node_063","code":633,"active":true}'), ISJSON('invalid_json_63'), JSON_VALUE('{"node":"node_063","code":633,"active":true}', '$.node');
----
1 0 node_063

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_063","code":633,"active":true}', '$.code', 6309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2138-Key-633')) AS VARCHAR(200));
----
6309 LionSQL-Compressed-Block-2138-Key-633

statement ok
CREATE TABLE jc_store_2138 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2138 VALUES (1, '{"node":"node_063","code":633,"active":true}', JSON_MODIFY('{"node":"node_063","code":633,"active":true}', '$.code', 6309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2138
WHERE ISJSON(j) = 1;
----
1 node_063 6309

statement ok
DROP TABLE jc_store_2138;
