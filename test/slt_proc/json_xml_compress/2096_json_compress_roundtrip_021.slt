# test/slt_proc/json_xml_compress/2096_json_compress_roundtrip_021.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (21)

query IIT
SELECT ISJSON('{"node":"node_021","code":213,"active":true}'), ISJSON('invalid_json_21'), JSON_VALUE('{"node":"node_021","code":213,"active":true}', '$.node');
----
1 0 node_021

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_021","code":213,"active":true}', '$.code', 2109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2096-Key-213')) AS VARCHAR(200));
----
2109 LionSQL-Compressed-Block-2096-Key-213

statement ok
CREATE TABLE jc_store_2096 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2096 VALUES (1, '{"node":"node_021","code":213,"active":true}', JSON_MODIFY('{"node":"node_021","code":213,"active":true}', '$.code', 2109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2096
WHERE ISJSON(j) = 1;
----
1 node_021 2109

statement ok
DROP TABLE jc_store_2096;
