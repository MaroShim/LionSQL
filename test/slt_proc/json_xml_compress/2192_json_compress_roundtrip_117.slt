# test/slt_proc/json_xml_compress/2192_json_compress_roundtrip_117.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (117)

query IIT
SELECT ISJSON('{"node":"node_117","code":1173,"active":true}'), ISJSON('invalid_json_117'), JSON_VALUE('{"node":"node_117","code":1173,"active":true}', '$.node');
----
1 0 node_117

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_117","code":1173,"active":true}', '$.code', 11709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2192-Key-1173')) AS VARCHAR(200));
----
11709 LionSQL-Compressed-Block-2192-Key-1173

statement ok
CREATE TABLE jc_store_2192 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2192 VALUES (1, '{"node":"node_117","code":1173,"active":true}', JSON_MODIFY('{"node":"node_117","code":1173,"active":true}', '$.code', 11709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2192
WHERE ISJSON(j) = 1;
----
1 node_117 11709

statement ok
DROP TABLE jc_store_2192;
