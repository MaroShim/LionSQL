# test/slt_proc/json_xml_compress/2129_json_compress_roundtrip_054.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (54)

query IIT
SELECT ISJSON('{"node":"node_054","code":543,"active":true}'), ISJSON('invalid_json_54'), JSON_VALUE('{"node":"node_054","code":543,"active":true}', '$.node');
----
1 0 node_054

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_054","code":543,"active":true}', '$.code', 5409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2129-Key-543')) AS VARCHAR(200));
----
5409 LionSQL-Compressed-Block-2129-Key-543

statement ok
CREATE TABLE jc_store_2129 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2129 VALUES (1, '{"node":"node_054","code":543,"active":true}', JSON_MODIFY('{"node":"node_054","code":543,"active":true}', '$.code', 5409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2129
WHERE ISJSON(j) = 1;
----
1 node_054 5409

statement ok
DROP TABLE jc_store_2129;
