# test/slt_proc/json_xml_compress/2222_json_compress_roundtrip_147.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (147)

query IIT
SELECT ISJSON('{"node":"node_147","code":1473,"active":true}'), ISJSON('invalid_json_147'), JSON_VALUE('{"node":"node_147","code":1473,"active":true}', '$.node');
----
1 0 node_147

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_147","code":1473,"active":true}', '$.code', 14709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2222-Key-1473')) AS VARCHAR(200));
----
14709 LionSQL-Compressed-Block-2222-Key-1473

statement ok
CREATE TABLE jc_store_2222 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2222 VALUES (1, '{"node":"node_147","code":1473,"active":true}', JSON_MODIFY('{"node":"node_147","code":1473,"active":true}', '$.code', 14709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2222
WHERE ISJSON(j) = 1;
----
1 node_147 14709

statement ok
DROP TABLE jc_store_2222;
