# test/slt_proc/json_xml_compress/2132_json_compress_roundtrip_057.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (57)

query IIT
SELECT ISJSON('{"node":"node_057","code":573,"active":true}'), ISJSON('invalid_json_57'), JSON_VALUE('{"node":"node_057","code":573,"active":true}', '$.node');
----
1 0 node_057

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_057","code":573,"active":true}', '$.code', 5709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2132-Key-573')) AS VARCHAR(200));
----
5709 LionSQL-Compressed-Block-2132-Key-573

statement ok
CREATE TABLE jc_store_2132 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2132 VALUES (1, '{"node":"node_057","code":573,"active":true}', JSON_MODIFY('{"node":"node_057","code":573,"active":true}', '$.code', 5709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2132
WHERE ISJSON(j) = 1;
----
1 node_057 5709

statement ok
DROP TABLE jc_store_2132;
