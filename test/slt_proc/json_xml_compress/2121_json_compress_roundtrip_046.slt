# test/slt_proc/json_xml_compress/2121_json_compress_roundtrip_046.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (46)

query IIT
SELECT ISJSON('{"node":"node_046","code":463,"active":true}'), ISJSON('invalid_json_46'), JSON_VALUE('{"node":"node_046","code":463,"active":true}', '$.node');
----
1 0 node_046

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_046","code":463,"active":true}', '$.code', 4609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2121-Key-463')) AS VARCHAR(200));
----
4609 LionSQL-Compressed-Block-2121-Key-463

statement ok
CREATE TABLE jc_store_2121 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2121 VALUES (1, '{"node":"node_046","code":463,"active":true}', JSON_MODIFY('{"node":"node_046","code":463,"active":true}', '$.code', 4609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2121
WHERE ISJSON(j) = 1;
----
1 node_046 4609

statement ok
DROP TABLE jc_store_2121;
