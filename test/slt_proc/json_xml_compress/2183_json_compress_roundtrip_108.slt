# test/slt_proc/json_xml_compress/2183_json_compress_roundtrip_108.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (108)

query IIT
SELECT ISJSON('{"node":"node_108","code":1083,"active":true}'), ISJSON('invalid_json_108'), JSON_VALUE('{"node":"node_108","code":1083,"active":true}', '$.node');
----
1 0 node_108

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_108","code":1083,"active":true}', '$.code', 10809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2183-Key-1083')) AS VARCHAR(200));
----
10809 LionSQL-Compressed-Block-2183-Key-1083

statement ok
CREATE TABLE jc_store_2183 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2183 VALUES (1, '{"node":"node_108","code":1083,"active":true}', JSON_MODIFY('{"node":"node_108","code":1083,"active":true}', '$.code', 10809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2183
WHERE ISJSON(j) = 1;
----
1 node_108 10809

statement ok
DROP TABLE jc_store_2183;
