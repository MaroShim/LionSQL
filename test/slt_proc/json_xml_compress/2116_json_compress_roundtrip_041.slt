# test/slt_proc/json_xml_compress/2116_json_compress_roundtrip_041.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (41)

query IIT
SELECT ISJSON('{"node":"node_041","code":413,"active":true}'), ISJSON('invalid_json_41'), JSON_VALUE('{"node":"node_041","code":413,"active":true}', '$.node');
----
1 0 node_041

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_041","code":413,"active":true}', '$.code', 4109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2116-Key-413')) AS VARCHAR(200));
----
4109 LionSQL-Compressed-Block-2116-Key-413

statement ok
CREATE TABLE jc_store_2116 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2116 VALUES (1, '{"node":"node_041","code":413,"active":true}', JSON_MODIFY('{"node":"node_041","code":413,"active":true}', '$.code', 4109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2116
WHERE ISJSON(j) = 1;
----
1 node_041 4109

statement ok
DROP TABLE jc_store_2116;
