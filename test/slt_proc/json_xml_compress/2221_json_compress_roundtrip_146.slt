# test/slt_proc/json_xml_compress/2221_json_compress_roundtrip_146.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (146)

query IIT
SELECT ISJSON('{"node":"node_146","code":1463,"active":true}'), ISJSON('invalid_json_146'), JSON_VALUE('{"node":"node_146","code":1463,"active":true}', '$.node');
----
1 0 node_146

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_146","code":1463,"active":true}', '$.code', 14609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2221-Key-1463')) AS VARCHAR(200));
----
14609 LionSQL-Compressed-Block-2221-Key-1463

statement ok
CREATE TABLE jc_store_2221 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2221 VALUES (1, '{"node":"node_146","code":1463,"active":true}', JSON_MODIFY('{"node":"node_146","code":1463,"active":true}', '$.code', 14609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2221
WHERE ISJSON(j) = 1;
----
1 node_146 14609

statement ok
DROP TABLE jc_store_2221;
