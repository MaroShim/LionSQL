# test/slt_proc/json_xml_compress/2152_json_compress_roundtrip_077.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (77)

query IIT
SELECT ISJSON('{"node":"node_077","code":773,"active":true}'), ISJSON('invalid_json_77'), JSON_VALUE('{"node":"node_077","code":773,"active":true}', '$.node');
----
1 0 node_077

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_077","code":773,"active":true}', '$.code', 7709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2152-Key-773')) AS VARCHAR(200));
----
7709 LionSQL-Compressed-Block-2152-Key-773

statement ok
CREATE TABLE jc_store_2152 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2152 VALUES (1, '{"node":"node_077","code":773,"active":true}', JSON_MODIFY('{"node":"node_077","code":773,"active":true}', '$.code', 7709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2152
WHERE ISJSON(j) = 1;
----
1 node_077 7709

statement ok
DROP TABLE jc_store_2152;
