# test/slt_proc/json_xml_compress/2218_json_compress_roundtrip_143.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (143)

query IIT
SELECT ISJSON('{"node":"node_143","code":1433,"active":true}'), ISJSON('invalid_json_143'), JSON_VALUE('{"node":"node_143","code":1433,"active":true}', '$.node');
----
1 0 node_143

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_143","code":1433,"active":true}', '$.code', 14309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2218-Key-1433')) AS VARCHAR(200));
----
14309 LionSQL-Compressed-Block-2218-Key-1433

statement ok
CREATE TABLE jc_store_2218 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2218 VALUES (1, '{"node":"node_143","code":1433,"active":true}', JSON_MODIFY('{"node":"node_143","code":1433,"active":true}', '$.code', 14309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2218
WHERE ISJSON(j) = 1;
----
1 node_143 14309

statement ok
DROP TABLE jc_store_2218;
