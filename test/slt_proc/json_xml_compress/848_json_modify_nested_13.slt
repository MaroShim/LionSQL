# test/slt_proc/json_xml_compress/848_json_modify_nested_13.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (13)

query TTT
SELECT JSON_VALUE('{"service":"svc_13","env":"stage","Version":130,"meta":{"region":"kr-2"}}', '$.service'), JSON_VALUE('{"service":"svc_13","env":"stage","Version":130,"meta":{"region":"kr-2"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_13","env":"stage","Version":130,"meta":{"region":"kr-2"}}', '$.Version', 1307), '$.Version');
----
svc_13 kr-2 1307

statement ok
CREATE TABLE j_cfg_848 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_848 VALUES
(1, '{"service":"svc_13","env":"stage","Version":130,"meta":{"region":"kr-2"}}'),
(2, JSON_MODIFY('{"service":"svc_13","env":"stage","Version":130,"meta":{"region":"kr-2"}}', '$.Version', 1307));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_848
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_13 130
2 svc_13 1307

statement ok
DROP TABLE j_cfg_848;
