# test/slt_proc/json_xml_compress/2097_json_compress_roundtrip_022.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (22)

query IIT
SELECT ISJSON('{"node":"node_022","code":223,"active":true}'), ISJSON('invalid_json_22'), JSON_VALUE('{"node":"node_022","code":223,"active":true}', '$.node');
----
1 0 node_022

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_022","code":223,"active":true}', '$.code', 2209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2097-Key-223')) AS VARCHAR(200));
----
2209 LionSQL-Compressed-Block-2097-Key-223

statement ok
CREATE TABLE jc_store_2097 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2097 VALUES (1, '{"node":"node_022","code":223,"active":true}', JSON_MODIFY('{"node":"node_022","code":223,"active":true}', '$.code', 2209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2097
WHERE ISJSON(j) = 1;
----
1 node_022 2209

statement ok
DROP TABLE jc_store_2097;
