# test/slt_proc/json_xml_compress/2103_json_compress_roundtrip_028.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (28)

query IIT
SELECT ISJSON('{"node":"node_028","code":283,"active":true}'), ISJSON('invalid_json_28'), JSON_VALUE('{"node":"node_028","code":283,"active":true}', '$.node');
----
1 0 node_028

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_028","code":283,"active":true}', '$.code', 2809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2103-Key-283')) AS VARCHAR(200));
----
2809 LionSQL-Compressed-Block-2103-Key-283

statement ok
CREATE TABLE jc_store_2103 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2103 VALUES (1, '{"node":"node_028","code":283,"active":true}', JSON_MODIFY('{"node":"node_028","code":283,"active":true}', '$.code', 2809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2103
WHERE ISJSON(j) = 1;
----
1 node_028 2809

statement ok
DROP TABLE jc_store_2103;
