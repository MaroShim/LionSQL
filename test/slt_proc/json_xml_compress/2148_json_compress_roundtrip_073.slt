# test/slt_proc/json_xml_compress/2148_json_compress_roundtrip_073.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (73)

query IIT
SELECT ISJSON('{"node":"node_073","code":733,"active":true}'), ISJSON('invalid_json_73'), JSON_VALUE('{"node":"node_073","code":733,"active":true}', '$.node');
----
1 0 node_073

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_073","code":733,"active":true}', '$.code', 7309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2148-Key-733')) AS VARCHAR(200));
----
7309 LionSQL-Compressed-Block-2148-Key-733

statement ok
CREATE TABLE jc_store_2148 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2148 VALUES (1, '{"node":"node_073","code":733,"active":true}', JSON_MODIFY('{"node":"node_073","code":733,"active":true}', '$.code', 7309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2148
WHERE ISJSON(j) = 1;
----
1 node_073 7309

statement ok
DROP TABLE jc_store_2148;
