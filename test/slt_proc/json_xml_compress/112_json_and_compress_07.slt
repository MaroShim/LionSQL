# test/slt_proc/json_xml_compress/112_json_and_compress_07.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (7)

query II
SELECT ISJSON('{"id":7,"user":"user_07","role":"viewer","score":725}'), ISJSON('invalid_7');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":7,"user":"user_07","role":"viewer","score":725}', '$.user'), JSON_VALUE('{"id":7,"user":"user_07","role":"viewer","score":725}', '$.role'), JSON_VALUE('{"id":7,"user":"user_07","role":"viewer","score":725}', '$.score');
----
user_07 viewer 725

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-07-XYZXYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-07-XYZXYZXYZXYZXYZ 7 1
