# test/slt_proc/json_xml_compress/2118_json_compress_roundtrip_043.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (43)

query IIT
SELECT ISJSON('{"node":"node_043","code":433,"active":true}'), ISJSON('invalid_json_43'), JSON_VALUE('{"node":"node_043","code":433,"active":true}', '$.node');
----
1 0 node_043

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_043","code":433,"active":true}', '$.code', 4309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2118-Key-433')) AS VARCHAR(200));
----
4309 LionSQL-Compressed-Block-2118-Key-433

statement ok
CREATE TABLE jc_store_2118 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2118 VALUES (1, '{"node":"node_043","code":433,"active":true}', JSON_MODIFY('{"node":"node_043","code":433,"active":true}', '$.code', 4309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2118
WHERE ISJSON(j) = 1;
----
1 node_043 4309

statement ok
DROP TABLE jc_store_2118;
