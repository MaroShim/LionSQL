# test/slt_proc/json_xml_compress/2128_json_compress_roundtrip_053.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (53)

query IIT
SELECT ISJSON('{"node":"node_053","code":533,"active":true}'), ISJSON('invalid_json_53'), JSON_VALUE('{"node":"node_053","code":533,"active":true}', '$.node');
----
1 0 node_053

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_053","code":533,"active":true}', '$.code', 5309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2128-Key-533')) AS VARCHAR(200));
----
5309 LionSQL-Compressed-Block-2128-Key-533

statement ok
CREATE TABLE jc_store_2128 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2128 VALUES (1, '{"node":"node_053","code":533,"active":true}', JSON_MODIFY('{"node":"node_053","code":533,"active":true}', '$.code', 5309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2128
WHERE ISJSON(j) = 1;
----
1 node_053 5309

statement ok
DROP TABLE jc_store_2128;
