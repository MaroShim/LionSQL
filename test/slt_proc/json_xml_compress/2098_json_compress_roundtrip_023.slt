# test/slt_proc/json_xml_compress/2098_json_compress_roundtrip_023.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (23)

query IIT
SELECT ISJSON('{"node":"node_023","code":233,"active":true}'), ISJSON('invalid_json_23'), JSON_VALUE('{"node":"node_023","code":233,"active":true}', '$.node');
----
1 0 node_023

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_023","code":233,"active":true}', '$.code', 2309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2098-Key-233')) AS VARCHAR(200));
----
2309 LionSQL-Compressed-Block-2098-Key-233

statement ok
CREATE TABLE jc_store_2098 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2098 VALUES (1, '{"node":"node_023","code":233,"active":true}', JSON_MODIFY('{"node":"node_023","code":233,"active":true}', '$.code', 2309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2098
WHERE ISJSON(j) = 1;
----
1 node_023 2309

statement ok
DROP TABLE jc_store_2098;
