# test/slt_proc/json_xml_compress/2185_json_compress_roundtrip_110.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (110)

query IIT
SELECT ISJSON('{"node":"node_110","code":1103,"active":true}'), ISJSON('invalid_json_110'), JSON_VALUE('{"node":"node_110","code":1103,"active":true}', '$.node');
----
1 0 node_110

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_110","code":1103,"active":true}', '$.code', 11009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2185-Key-1103')) AS VARCHAR(200));
----
11009 LionSQL-Compressed-Block-2185-Key-1103

statement ok
CREATE TABLE jc_store_2185 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2185 VALUES (1, '{"node":"node_110","code":1103,"active":true}', JSON_MODIFY('{"node":"node_110","code":1103,"active":true}', '$.code', 11009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2185
WHERE ISJSON(j) = 1;
----
1 node_110 11009

statement ok
DROP TABLE jc_store_2185;
