# test/slt_proc/json_xml_compress/106_json_and_compress_01.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (1)

query II
SELECT ISJSON('{"id":1,"user":"user_01","role":"editor","score":125}'), ISJSON('invalid_1');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":1,"user":"user_01","role":"editor","score":125}', '$.user'), JSON_VALUE('{"id":1,"user":"user_01","role":"editor","score":125}', '$.role'), JSON_VALUE('{"id":1,"user":"user_01","role":"editor","score":125}', '$.score');
----
user_01 editor 125

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-01-XYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-01-XYZXYZXYZ 7 1
