# test/slt_proc/json_xml_compress/860_json_modify_nested_25.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (25)

query TTT
SELECT JSON_VALUE('{"service":"svc_25","env":"stage","Version":250,"meta":{"region":"kr-2"}}', '$.service'), JSON_VALUE('{"service":"svc_25","env":"stage","Version":250,"meta":{"region":"kr-2"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_25","env":"stage","Version":250,"meta":{"region":"kr-2"}}', '$.Version', 2507), '$.Version');
----
svc_25 kr-2 2507

statement ok
CREATE TABLE j_cfg_860 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_860 VALUES
(1, '{"service":"svc_25","env":"stage","Version":250,"meta":{"region":"kr-2"}}'),
(2, JSON_MODIFY('{"service":"svc_25","env":"stage","Version":250,"meta":{"region":"kr-2"}}', '$.Version', 2507));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_860
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_25 250
2 svc_25 2507

statement ok
DROP TABLE j_cfg_860;
