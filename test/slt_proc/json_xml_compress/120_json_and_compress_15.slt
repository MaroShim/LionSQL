# test/slt_proc/json_xml_compress/120_json_and_compress_15.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (15)

query II
SELECT ISJSON('{"id":15,"user":"user_15","role":"admin","score":1525}'), ISJSON('invalid_15');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":15,"user":"user_15","role":"admin","score":1525}', '$.user'), JSON_VALUE('{"id":15,"user":"user_15","role":"admin","score":1525}', '$.role'), JSON_VALUE('{"id":15,"user":"user_15","role":"admin","score":1525}', '$.score');
----
user_15 admin 1525

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-15-XYZXYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-15-XYZXYZXYZXYZXYZ 7 1
