# test/slt_proc/json_xml_compress/2091_json_compress_roundtrip_016.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (16)

query IIT
SELECT ISJSON('{"node":"node_016","code":163,"active":true}'), ISJSON('invalid_json_16'), JSON_VALUE('{"node":"node_016","code":163,"active":true}', '$.node');
----
1 0 node_016

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_016","code":163,"active":true}', '$.code', 1609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2091-Key-163')) AS VARCHAR(200));
----
1609 LionSQL-Compressed-Block-2091-Key-163

statement ok
CREATE TABLE jc_store_2091 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2091 VALUES (1, '{"node":"node_016","code":163,"active":true}', JSON_MODIFY('{"node":"node_016","code":163,"active":true}', '$.code', 1609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2091
WHERE ISJSON(j) = 1;
----
1 node_016 1609

statement ok
DROP TABLE jc_store_2091;
