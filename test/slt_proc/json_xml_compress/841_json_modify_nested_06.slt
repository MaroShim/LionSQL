# test/slt_proc/json_xml_compress/841_json_modify_nested_06.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (6)

query TTT
SELECT JSON_VALUE('{"service":"svc_06","env":"dev","Version":60,"meta":{"region":"kr-1"}}', '$.service'), JSON_VALUE('{"service":"svc_06","env":"dev","Version":60,"meta":{"region":"kr-1"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_06","env":"dev","Version":60,"meta":{"region":"kr-1"}}', '$.Version', 607), '$.Version');
----
svc_06 kr-1 607

statement ok
CREATE TABLE j_cfg_841 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_841 VALUES
(1, '{"service":"svc_06","env":"dev","Version":60,"meta":{"region":"kr-1"}}'),
(2, JSON_MODIFY('{"service":"svc_06","env":"dev","Version":60,"meta":{"region":"kr-1"}}', '$.Version', 607));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_841
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_06 60
2 svc_06 607

statement ok
DROP TABLE j_cfg_841;
