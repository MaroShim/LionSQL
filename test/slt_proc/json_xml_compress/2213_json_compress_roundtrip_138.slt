# test/slt_proc/json_xml_compress/2213_json_compress_roundtrip_138.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (138)

query IIT
SELECT ISJSON('{"node":"node_138","code":1383,"active":true}'), ISJSON('invalid_json_138'), JSON_VALUE('{"node":"node_138","code":1383,"active":true}', '$.node');
----
1 0 node_138

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_138","code":1383,"active":true}', '$.code', 13809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2213-Key-1383')) AS VARCHAR(200));
----
13809 LionSQL-Compressed-Block-2213-Key-1383

statement ok
CREATE TABLE jc_store_2213 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2213 VALUES (1, '{"node":"node_138","code":1383,"active":true}', JSON_MODIFY('{"node":"node_138","code":1383,"active":true}', '$.code', 13809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2213
WHERE ISJSON(j) = 1;
----
1 node_138 13809

statement ok
DROP TABLE jc_store_2213;
