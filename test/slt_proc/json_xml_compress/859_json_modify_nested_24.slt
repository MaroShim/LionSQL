# test/slt_proc/json_xml_compress/859_json_modify_nested_24.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (24)

query TTT
SELECT JSON_VALUE('{"service":"svc_24","env":"prod","Version":240,"meta":{"region":"kr-1"}}', '$.service'), JSON_VALUE('{"service":"svc_24","env":"prod","Version":240,"meta":{"region":"kr-1"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_24","env":"prod","Version":240,"meta":{"region":"kr-1"}}', '$.Version', 2407), '$.Version');
----
svc_24 kr-1 2407

statement ok
CREATE TABLE j_cfg_859 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_859 VALUES
(1, '{"service":"svc_24","env":"prod","Version":240,"meta":{"region":"kr-1"}}'),
(2, JSON_MODIFY('{"service":"svc_24","env":"prod","Version":240,"meta":{"region":"kr-1"}}', '$.Version', 2407));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_859
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_24 240
2 svc_24 2407

statement ok
DROP TABLE j_cfg_859;
