# test/slt_proc/json_xml_compress/2077_json_compress_roundtrip_002.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (2)

query IIT
SELECT ISJSON('{"node":"node_002","code":23,"active":true}'), ISJSON('invalid_json_2'), JSON_VALUE('{"node":"node_002","code":23,"active":true}', '$.node');
----
1 0 node_002

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_002","code":23,"active":true}', '$.code', 209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2077-Key-23')) AS VARCHAR(200));
----
209 LionSQL-Compressed-Block-2077-Key-23

statement ok
CREATE TABLE jc_store_2077 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2077 VALUES (1, '{"node":"node_002","code":23,"active":true}', JSON_MODIFY('{"node":"node_002","code":23,"active":true}', '$.code', 209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2077
WHERE ISJSON(j) = 1;
----
1 node_002 209

statement ok
DROP TABLE jc_store_2077;
