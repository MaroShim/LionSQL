# test/slt_proc/json_xml_compress/2119_json_compress_roundtrip_044.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (44)

query IIT
SELECT ISJSON('{"node":"node_044","code":443,"active":true}'), ISJSON('invalid_json_44'), JSON_VALUE('{"node":"node_044","code":443,"active":true}', '$.node');
----
1 0 node_044

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_044","code":443,"active":true}', '$.code', 4409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2119-Key-443')) AS VARCHAR(200));
----
4409 LionSQL-Compressed-Block-2119-Key-443

statement ok
CREATE TABLE jc_store_2119 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2119 VALUES (1, '{"node":"node_044","code":443,"active":true}', JSON_MODIFY('{"node":"node_044","code":443,"active":true}', '$.code', 4409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2119
WHERE ISJSON(j) = 1;
----
1 node_044 4409

statement ok
DROP TABLE jc_store_2119;
