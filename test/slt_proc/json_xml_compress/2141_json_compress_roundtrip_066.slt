# test/slt_proc/json_xml_compress/2141_json_compress_roundtrip_066.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (66)

query IIT
SELECT ISJSON('{"node":"node_066","code":663,"active":true}'), ISJSON('invalid_json_66'), JSON_VALUE('{"node":"node_066","code":663,"active":true}', '$.node');
----
1 0 node_066

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_066","code":663,"active":true}', '$.code', 6609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2141-Key-663')) AS VARCHAR(200));
----
6609 LionSQL-Compressed-Block-2141-Key-663

statement ok
CREATE TABLE jc_store_2141 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2141 VALUES (1, '{"node":"node_066","code":663,"active":true}', JSON_MODIFY('{"node":"node_066","code":663,"active":true}', '$.code', 6609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2141
WHERE ISJSON(j) = 1;
----
1 node_066 6609

statement ok
DROP TABLE jc_store_2141;
