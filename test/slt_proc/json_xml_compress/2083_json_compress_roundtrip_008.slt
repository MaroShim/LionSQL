# test/slt_proc/json_xml_compress/2083_json_compress_roundtrip_008.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (8)

query IIT
SELECT ISJSON('{"node":"node_008","code":83,"active":true}'), ISJSON('invalid_json_8'), JSON_VALUE('{"node":"node_008","code":83,"active":true}', '$.node');
----
1 0 node_008

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_008","code":83,"active":true}', '$.code', 809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2083-Key-83')) AS VARCHAR(200));
----
809 LionSQL-Compressed-Block-2083-Key-83

statement ok
CREATE TABLE jc_store_2083 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2083 VALUES (1, '{"node":"node_008","code":83,"active":true}', JSON_MODIFY('{"node":"node_008","code":83,"active":true}', '$.code', 809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2083
WHERE ISJSON(j) = 1;
----
1 node_008 809

statement ok
DROP TABLE jc_store_2083;
