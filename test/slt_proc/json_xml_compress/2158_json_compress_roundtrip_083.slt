# test/slt_proc/json_xml_compress/2158_json_compress_roundtrip_083.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (83)

query IIT
SELECT ISJSON('{"node":"node_083","code":833,"active":true}'), ISJSON('invalid_json_83'), JSON_VALUE('{"node":"node_083","code":833,"active":true}', '$.node');
----
1 0 node_083

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_083","code":833,"active":true}', '$.code', 8309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2158-Key-833')) AS VARCHAR(200));
----
8309 LionSQL-Compressed-Block-2158-Key-833

statement ok
CREATE TABLE jc_store_2158 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2158 VALUES (1, '{"node":"node_083","code":833,"active":true}', JSON_MODIFY('{"node":"node_083","code":833,"active":true}', '$.code', 8309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2158
WHERE ISJSON(j) = 1;
----
1 node_083 8309

statement ok
DROP TABLE jc_store_2158;
