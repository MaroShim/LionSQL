# test/slt_proc/json_xml_compress/853_json_modify_nested_18.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (18)

query TTT
SELECT JSON_VALUE('{"service":"svc_18","env":"dev","Version":180,"meta":{"region":"kr-1"}}', '$.service'), JSON_VALUE('{"service":"svc_18","env":"dev","Version":180,"meta":{"region":"kr-1"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_18","env":"dev","Version":180,"meta":{"region":"kr-1"}}', '$.Version', 1807), '$.Version');
----
svc_18 kr-1 1807

statement ok
CREATE TABLE j_cfg_853 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_853 VALUES
(1, '{"service":"svc_18","env":"dev","Version":180,"meta":{"region":"kr-1"}}'),
(2, JSON_MODIFY('{"service":"svc_18","env":"dev","Version":180,"meta":{"region":"kr-1"}}', '$.Version', 1807));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_853
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_18 180
2 svc_18 1807

statement ok
DROP TABLE j_cfg_853;
