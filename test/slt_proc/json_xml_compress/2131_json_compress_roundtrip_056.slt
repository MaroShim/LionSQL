# test/slt_proc/json_xml_compress/2131_json_compress_roundtrip_056.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (56)

query IIT
SELECT ISJSON('{"node":"node_056","code":563,"active":true}'), ISJSON('invalid_json_56'), JSON_VALUE('{"node":"node_056","code":563,"active":true}', '$.node');
----
1 0 node_056

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_056","code":563,"active":true}', '$.code', 5609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2131-Key-563')) AS VARCHAR(200));
----
5609 LionSQL-Compressed-Block-2131-Key-563

statement ok
CREATE TABLE jc_store_2131 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2131 VALUES (1, '{"node":"node_056","code":563,"active":true}', JSON_MODIFY('{"node":"node_056","code":563,"active":true}', '$.code', 5609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2131
WHERE ISJSON(j) = 1;
----
1 node_056 5609

statement ok
DROP TABLE jc_store_2131;
