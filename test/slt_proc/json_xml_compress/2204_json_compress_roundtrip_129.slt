# test/slt_proc/json_xml_compress/2204_json_compress_roundtrip_129.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (129)

query IIT
SELECT ISJSON('{"node":"node_129","code":1293,"active":true}'), ISJSON('invalid_json_129'), JSON_VALUE('{"node":"node_129","code":1293,"active":true}', '$.node');
----
1 0 node_129

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_129","code":1293,"active":true}', '$.code', 12909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2204-Key-1293')) AS VARCHAR(200));
----
12909 LionSQL-Compressed-Block-2204-Key-1293

statement ok
CREATE TABLE jc_store_2204 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2204 VALUES (1, '{"node":"node_129","code":1293,"active":true}', JSON_MODIFY('{"node":"node_129","code":1293,"active":true}', '$.code', 12909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2204
WHERE ISJSON(j) = 1;
----
1 node_129 12909

statement ok
DROP TABLE jc_store_2204;
