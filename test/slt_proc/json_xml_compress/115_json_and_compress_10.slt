# test/slt_proc/json_xml_compress/115_json_and_compress_10.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (10)

query II
SELECT ISJSON('{"id":10,"user":"user_10","role":"admin","score":1025}'), ISJSON('invalid_10');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":10,"user":"user_10","role":"admin","score":1025}', '$.user'), JSON_VALUE('{"id":10,"user":"user_10","role":"admin","score":1025}', '$.role'), JSON_VALUE('{"id":10,"user":"user_10","role":"admin","score":1025}', '$.score');
----
user_10 admin 1025

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-10-XYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-10-XYZXYZXYZXYZ 7 1
