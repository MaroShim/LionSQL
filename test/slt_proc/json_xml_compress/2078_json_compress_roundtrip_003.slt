# test/slt_proc/json_xml_compress/2078_json_compress_roundtrip_003.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (3)

query IIT
SELECT ISJSON('{"node":"node_003","code":33,"active":true}'), ISJSON('invalid_json_3'), JSON_VALUE('{"node":"node_003","code":33,"active":true}', '$.node');
----
1 0 node_003

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_003","code":33,"active":true}', '$.code', 309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2078-Key-33')) AS VARCHAR(200));
----
309 LionSQL-Compressed-Block-2078-Key-33

statement ok
CREATE TABLE jc_store_2078 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2078 VALUES (1, '{"node":"node_003","code":33,"active":true}', JSON_MODIFY('{"node":"node_003","code":33,"active":true}', '$.code', 309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2078
WHERE ISJSON(j) = 1;
----
1 node_003 309

statement ok
DROP TABLE jc_store_2078;
