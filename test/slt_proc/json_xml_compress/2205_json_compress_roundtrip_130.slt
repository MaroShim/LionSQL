# test/slt_proc/json_xml_compress/2205_json_compress_roundtrip_130.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (130)

query IIT
SELECT ISJSON('{"node":"node_130","code":1303,"active":true}'), ISJSON('invalid_json_130'), JSON_VALUE('{"node":"node_130","code":1303,"active":true}', '$.node');
----
1 0 node_130

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_130","code":1303,"active":true}', '$.code', 13009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2205-Key-1303')) AS VARCHAR(200));
----
13009 LionSQL-Compressed-Block-2205-Key-1303

statement ok
CREATE TABLE jc_store_2205 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2205 VALUES (1, '{"node":"node_130","code":1303,"active":true}', JSON_MODIFY('{"node":"node_130","code":1303,"active":true}', '$.code', 13009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2205
WHERE ISJSON(j) = 1;
----
1 node_130 13009

statement ok
DROP TABLE jc_store_2205;
