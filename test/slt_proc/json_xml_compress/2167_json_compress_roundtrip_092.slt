# test/slt_proc/json_xml_compress/2167_json_compress_roundtrip_092.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (92)

query IIT
SELECT ISJSON('{"node":"node_092","code":923,"active":true}'), ISJSON('invalid_json_92'), JSON_VALUE('{"node":"node_092","code":923,"active":true}', '$.node');
----
1 0 node_092

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_092","code":923,"active":true}', '$.code', 9209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2167-Key-923')) AS VARCHAR(200));
----
9209 LionSQL-Compressed-Block-2167-Key-923

statement ok
CREATE TABLE jc_store_2167 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2167 VALUES (1, '{"node":"node_092","code":923,"active":true}', JSON_MODIFY('{"node":"node_092","code":923,"active":true}', '$.code', 9209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2167
WHERE ISJSON(j) = 1;
----
1 node_092 9209

statement ok
DROP TABLE jc_store_2167;
