# test/slt_proc/json_xml_compress/2127_json_compress_roundtrip_052.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (52)

query IIT
SELECT ISJSON('{"node":"node_052","code":523,"active":true}'), ISJSON('invalid_json_52'), JSON_VALUE('{"node":"node_052","code":523,"active":true}', '$.node');
----
1 0 node_052

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_052","code":523,"active":true}', '$.code', 5209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2127-Key-523')) AS VARCHAR(200));
----
5209 LionSQL-Compressed-Block-2127-Key-523

statement ok
CREATE TABLE jc_store_2127 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2127 VALUES (1, '{"node":"node_052","code":523,"active":true}', JSON_MODIFY('{"node":"node_052","code":523,"active":true}', '$.code', 5209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2127
WHERE ISJSON(j) = 1;
----
1 node_052 5209

statement ok
DROP TABLE jc_store_2127;
