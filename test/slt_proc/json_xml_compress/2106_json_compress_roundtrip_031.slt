# test/slt_proc/json_xml_compress/2106_json_compress_roundtrip_031.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (31)

query IIT
SELECT ISJSON('{"node":"node_031","code":313,"active":true}'), ISJSON('invalid_json_31'), JSON_VALUE('{"node":"node_031","code":313,"active":true}', '$.node');
----
1 0 node_031

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_031","code":313,"active":true}', '$.code', 3109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2106-Key-313')) AS VARCHAR(200));
----
3109 LionSQL-Compressed-Block-2106-Key-313

statement ok
CREATE TABLE jc_store_2106 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2106 VALUES (1, '{"node":"node_031","code":313,"active":true}', JSON_MODIFY('{"node":"node_031","code":313,"active":true}', '$.code', 3109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2106
WHERE ISJSON(j) = 1;
----
1 node_031 3109

statement ok
DROP TABLE jc_store_2106;
