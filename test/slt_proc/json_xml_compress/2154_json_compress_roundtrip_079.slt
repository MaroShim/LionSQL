# test/slt_proc/json_xml_compress/2154_json_compress_roundtrip_079.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (79)

query IIT
SELECT ISJSON('{"node":"node_079","code":793,"active":true}'), ISJSON('invalid_json_79'), JSON_VALUE('{"node":"node_079","code":793,"active":true}', '$.node');
----
1 0 node_079

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_079","code":793,"active":true}', '$.code', 7909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2154-Key-793')) AS VARCHAR(200));
----
7909 LionSQL-Compressed-Block-2154-Key-793

statement ok
CREATE TABLE jc_store_2154 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2154 VALUES (1, '{"node":"node_079","code":793,"active":true}', JSON_MODIFY('{"node":"node_079","code":793,"active":true}', '$.code', 7909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2154
WHERE ISJSON(j) = 1;
----
1 node_079 7909

statement ok
DROP TABLE jc_store_2154;
