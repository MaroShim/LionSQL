# test/slt_proc/json_xml_compress/2210_json_compress_roundtrip_135.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (135)

query IIT
SELECT ISJSON('{"node":"node_135","code":1353,"active":true}'), ISJSON('invalid_json_135'), JSON_VALUE('{"node":"node_135","code":1353,"active":true}', '$.node');
----
1 0 node_135

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_135","code":1353,"active":true}', '$.code', 13509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2210-Key-1353')) AS VARCHAR(200));
----
13509 LionSQL-Compressed-Block-2210-Key-1353

statement ok
CREATE TABLE jc_store_2210 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2210 VALUES (1, '{"node":"node_135","code":1353,"active":true}', JSON_MODIFY('{"node":"node_135","code":1353,"active":true}', '$.code', 13509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2210
WHERE ISJSON(j) = 1;
----
1 node_135 13509

statement ok
DROP TABLE jc_store_2210;
