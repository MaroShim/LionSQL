# test/slt_proc/json_xml_compress/851_json_modify_nested_16.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (16)

query TTT
SELECT JSON_VALUE('{"service":"svc_16","env":"prod","Version":160,"meta":{"region":"kr-2"}}', '$.service'), JSON_VALUE('{"service":"svc_16","env":"prod","Version":160,"meta":{"region":"kr-2"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_16","env":"prod","Version":160,"meta":{"region":"kr-2"}}', '$.Version', 1607), '$.Version');
----
svc_16 kr-2 1607

statement ok
CREATE TABLE j_cfg_851 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_851 VALUES
(1, '{"service":"svc_16","env":"prod","Version":160,"meta":{"region":"kr-2"}}'),
(2, JSON_MODIFY('{"service":"svc_16","env":"prod","Version":160,"meta":{"region":"kr-2"}}', '$.Version', 1607));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_851
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_16 160
2 svc_16 1607

statement ok
DROP TABLE j_cfg_851;
