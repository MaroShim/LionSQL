# test/slt_proc/json_xml_compress/2165_json_compress_roundtrip_090.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (90)

query IIT
SELECT ISJSON('{"node":"node_090","code":903,"active":true}'), ISJSON('invalid_json_90'), JSON_VALUE('{"node":"node_090","code":903,"active":true}', '$.node');
----
1 0 node_090

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_090","code":903,"active":true}', '$.code', 9009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2165-Key-903')) AS VARCHAR(200));
----
9009 LionSQL-Compressed-Block-2165-Key-903

statement ok
CREATE TABLE jc_store_2165 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2165 VALUES (1, '{"node":"node_090","code":903,"active":true}', JSON_MODIFY('{"node":"node_090","code":903,"active":true}', '$.code', 9009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2165
WHERE ISJSON(j) = 1;
----
1 node_090 9009

statement ok
DROP TABLE jc_store_2165;
