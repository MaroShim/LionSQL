# test/slt_proc/json_xml_compress/2177_json_compress_roundtrip_102.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (102)

query IIT
SELECT ISJSON('{"node":"node_102","code":1023,"active":true}'), ISJSON('invalid_json_102'), JSON_VALUE('{"node":"node_102","code":1023,"active":true}', '$.node');
----
1 0 node_102

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_102","code":1023,"active":true}', '$.code', 10209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2177-Key-1023')) AS VARCHAR(200));
----
10209 LionSQL-Compressed-Block-2177-Key-1023

statement ok
CREATE TABLE jc_store_2177 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2177 VALUES (1, '{"node":"node_102","code":1023,"active":true}', JSON_MODIFY('{"node":"node_102","code":1023,"active":true}', '$.code', 10209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2177
WHERE ISJSON(j) = 1;
----
1 node_102 10209

statement ok
DROP TABLE jc_store_2177;
