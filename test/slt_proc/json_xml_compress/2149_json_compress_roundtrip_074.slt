# test/slt_proc/json_xml_compress/2149_json_compress_roundtrip_074.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (74)

query IIT
SELECT ISJSON('{"node":"node_074","code":743,"active":true}'), ISJSON('invalid_json_74'), JSON_VALUE('{"node":"node_074","code":743,"active":true}', '$.node');
----
1 0 node_074

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_074","code":743,"active":true}', '$.code', 7409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2149-Key-743')) AS VARCHAR(200));
----
7409 LionSQL-Compressed-Block-2149-Key-743

statement ok
CREATE TABLE jc_store_2149 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2149 VALUES (1, '{"node":"node_074","code":743,"active":true}', JSON_MODIFY('{"node":"node_074","code":743,"active":true}', '$.code', 7409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2149
WHERE ISJSON(j) = 1;
----
1 node_074 7409

statement ok
DROP TABLE jc_store_2149;
