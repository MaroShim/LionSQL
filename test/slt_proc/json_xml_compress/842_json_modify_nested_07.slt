# test/slt_proc/json_xml_compress/842_json_modify_nested_07.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (7)

query TTT
SELECT JSON_VALUE('{"service":"svc_07","env":"qa","Version":70,"meta":{"region":"kr-2"}}', '$.service'), JSON_VALUE('{"service":"svc_07","env":"qa","Version":70,"meta":{"region":"kr-2"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_07","env":"qa","Version":70,"meta":{"region":"kr-2"}}', '$.Version', 707), '$.Version');
----
svc_07 kr-2 707

statement ok
CREATE TABLE j_cfg_842 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_842 VALUES
(1, '{"service":"svc_07","env":"qa","Version":70,"meta":{"region":"kr-2"}}'),
(2, JSON_MODIFY('{"service":"svc_07","env":"qa","Version":70,"meta":{"region":"kr-2"}}', '$.Version', 707));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_842
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_07 70
2 svc_07 707

statement ok
DROP TABLE j_cfg_842;
