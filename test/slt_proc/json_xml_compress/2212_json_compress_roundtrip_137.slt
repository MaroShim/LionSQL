# test/slt_proc/json_xml_compress/2212_json_compress_roundtrip_137.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (137)

query IIT
SELECT ISJSON('{"node":"node_137","code":1373,"active":true}'), ISJSON('invalid_json_137'), JSON_VALUE('{"node":"node_137","code":1373,"active":true}', '$.node');
----
1 0 node_137

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_137","code":1373,"active":true}', '$.code', 13709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2212-Key-1373')) AS VARCHAR(200));
----
13709 LionSQL-Compressed-Block-2212-Key-1373

statement ok
CREATE TABLE jc_store_2212 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2212 VALUES (1, '{"node":"node_137","code":1373,"active":true}', JSON_MODIFY('{"node":"node_137","code":1373,"active":true}', '$.code', 13709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2212
WHERE ISJSON(j) = 1;
----
1 node_137 13709

statement ok
DROP TABLE jc_store_2212;
