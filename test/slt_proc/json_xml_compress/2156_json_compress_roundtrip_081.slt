# test/slt_proc/json_xml_compress/2156_json_compress_roundtrip_081.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (81)

query IIT
SELECT ISJSON('{"node":"node_081","code":813,"active":true}'), ISJSON('invalid_json_81'), JSON_VALUE('{"node":"node_081","code":813,"active":true}', '$.node');
----
1 0 node_081

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_081","code":813,"active":true}', '$.code', 8109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2156-Key-813')) AS VARCHAR(200));
----
8109 LionSQL-Compressed-Block-2156-Key-813

statement ok
CREATE TABLE jc_store_2156 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2156 VALUES (1, '{"node":"node_081","code":813,"active":true}', JSON_MODIFY('{"node":"node_081","code":813,"active":true}', '$.code', 8109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2156
WHERE ISJSON(j) = 1;
----
1 node_081 8109

statement ok
DROP TABLE jc_store_2156;
