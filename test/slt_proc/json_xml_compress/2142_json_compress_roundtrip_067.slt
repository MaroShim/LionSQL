# test/slt_proc/json_xml_compress/2142_json_compress_roundtrip_067.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (67)

query IIT
SELECT ISJSON('{"node":"node_067","code":673,"active":true}'), ISJSON('invalid_json_67'), JSON_VALUE('{"node":"node_067","code":673,"active":true}', '$.node');
----
1 0 node_067

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_067","code":673,"active":true}', '$.code', 6709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2142-Key-673')) AS VARCHAR(200));
----
6709 LionSQL-Compressed-Block-2142-Key-673

statement ok
CREATE TABLE jc_store_2142 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2142 VALUES (1, '{"node":"node_067","code":673,"active":true}', JSON_MODIFY('{"node":"node_067","code":673,"active":true}', '$.code', 6709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2142
WHERE ISJSON(j) = 1;
----
1 node_067 6709

statement ok
DROP TABLE jc_store_2142;
