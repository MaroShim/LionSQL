# test/slt_proc/json_xml_compress/2225_json_compress_roundtrip_150.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (150)

query IIT
SELECT ISJSON('{"node":"node_150","code":1503,"active":true}'), ISJSON('invalid_json_150'), JSON_VALUE('{"node":"node_150","code":1503,"active":true}', '$.node');
----
1 0 node_150

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_150","code":1503,"active":true}', '$.code', 15009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2225-Key-1503')) AS VARCHAR(200));
----
15009 LionSQL-Compressed-Block-2225-Key-1503

statement ok
CREATE TABLE jc_store_2225 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2225 VALUES (1, '{"node":"node_150","code":1503,"active":true}', JSON_MODIFY('{"node":"node_150","code":1503,"active":true}', '$.code', 15009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2225
WHERE ISJSON(j) = 1;
----
1 node_150 15009

statement ok
DROP TABLE jc_store_2225;
