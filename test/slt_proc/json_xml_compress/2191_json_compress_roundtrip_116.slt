# test/slt_proc/json_xml_compress/2191_json_compress_roundtrip_116.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (116)

query IIT
SELECT ISJSON('{"node":"node_116","code":1163,"active":true}'), ISJSON('invalid_json_116'), JSON_VALUE('{"node":"node_116","code":1163,"active":true}', '$.node');
----
1 0 node_116

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_116","code":1163,"active":true}', '$.code', 11609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2191-Key-1163')) AS VARCHAR(200));
----
11609 LionSQL-Compressed-Block-2191-Key-1163

statement ok
CREATE TABLE jc_store_2191 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2191 VALUES (1, '{"node":"node_116","code":1163,"active":true}', JSON_MODIFY('{"node":"node_116","code":1163,"active":true}', '$.code', 11609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2191
WHERE ISJSON(j) = 1;
----
1 node_116 11609

statement ok
DROP TABLE jc_store_2191;
