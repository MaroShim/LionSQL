# test/slt_proc/json_xml_compress/2110_json_compress_roundtrip_035.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (35)

query IIT
SELECT ISJSON('{"node":"node_035","code":353,"active":true}'), ISJSON('invalid_json_35'), JSON_VALUE('{"node":"node_035","code":353,"active":true}', '$.node');
----
1 0 node_035

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_035","code":353,"active":true}', '$.code', 3509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2110-Key-353')) AS VARCHAR(200));
----
3509 LionSQL-Compressed-Block-2110-Key-353

statement ok
CREATE TABLE jc_store_2110 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2110 VALUES (1, '{"node":"node_035","code":353,"active":true}', JSON_MODIFY('{"node":"node_035","code":353,"active":true}', '$.code', 3509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2110
WHERE ISJSON(j) = 1;
----
1 node_035 3509

statement ok
DROP TABLE jc_store_2110;
