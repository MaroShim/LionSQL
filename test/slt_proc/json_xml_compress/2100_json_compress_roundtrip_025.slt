# test/slt_proc/json_xml_compress/2100_json_compress_roundtrip_025.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (25)

query IIT
SELECT ISJSON('{"node":"node_025","code":253,"active":true}'), ISJSON('invalid_json_25'), JSON_VALUE('{"node":"node_025","code":253,"active":true}', '$.node');
----
1 0 node_025

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_025","code":253,"active":true}', '$.code', 2509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2100-Key-253')) AS VARCHAR(200));
----
2509 LionSQL-Compressed-Block-2100-Key-253

statement ok
CREATE TABLE jc_store_2100 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2100 VALUES (1, '{"node":"node_025","code":253,"active":true}', JSON_MODIFY('{"node":"node_025","code":253,"active":true}', '$.code', 2509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2100
WHERE ISJSON(j) = 1;
----
1 node_025 2509

statement ok
DROP TABLE jc_store_2100;
