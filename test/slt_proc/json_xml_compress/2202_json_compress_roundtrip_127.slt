# test/slt_proc/json_xml_compress/2202_json_compress_roundtrip_127.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (127)

query IIT
SELECT ISJSON('{"node":"node_127","code":1273,"active":true}'), ISJSON('invalid_json_127'), JSON_VALUE('{"node":"node_127","code":1273,"active":true}', '$.node');
----
1 0 node_127

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_127","code":1273,"active":true}', '$.code', 12709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2202-Key-1273')) AS VARCHAR(200));
----
12709 LionSQL-Compressed-Block-2202-Key-1273

statement ok
CREATE TABLE jc_store_2202 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2202 VALUES (1, '{"node":"node_127","code":1273,"active":true}', JSON_MODIFY('{"node":"node_127","code":1273,"active":true}', '$.code', 12709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2202
WHERE ISJSON(j) = 1;
----
1 node_127 12709

statement ok
DROP TABLE jc_store_2202;
