# test/slt_proc/json_xml_compress/849_json_modify_nested_14.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (14)

query TTT
SELECT JSON_VALUE('{"service":"svc_14","env":"dev","Version":140,"meta":{"region":"kr-3"}}', '$.service'), JSON_VALUE('{"service":"svc_14","env":"dev","Version":140,"meta":{"region":"kr-3"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_14","env":"dev","Version":140,"meta":{"region":"kr-3"}}', '$.Version', 1407), '$.Version');
----
svc_14 kr-3 1407

statement ok
CREATE TABLE j_cfg_849 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_849 VALUES
(1, '{"service":"svc_14","env":"dev","Version":140,"meta":{"region":"kr-3"}}'),
(2, JSON_MODIFY('{"service":"svc_14","env":"dev","Version":140,"meta":{"region":"kr-3"}}', '$.Version', 1407));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_849
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_14 140
2 svc_14 1407

statement ok
DROP TABLE j_cfg_849;
