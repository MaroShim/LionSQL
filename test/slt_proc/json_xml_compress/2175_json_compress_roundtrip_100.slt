# test/slt_proc/json_xml_compress/2175_json_compress_roundtrip_100.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (100)

query IIT
SELECT ISJSON('{"node":"node_100","code":1003,"active":true}'), ISJSON('invalid_json_100'), JSON_VALUE('{"node":"node_100","code":1003,"active":true}', '$.node');
----
1 0 node_100

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_100","code":1003,"active":true}', '$.code', 10009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2175-Key-1003')) AS VARCHAR(200));
----
10009 LionSQL-Compressed-Block-2175-Key-1003

statement ok
CREATE TABLE jc_store_2175 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2175 VALUES (1, '{"node":"node_100","code":1003,"active":true}', JSON_MODIFY('{"node":"node_100","code":1003,"active":true}', '$.code', 10009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2175
WHERE ISJSON(j) = 1;
----
1 node_100 10009

statement ok
DROP TABLE jc_store_2175;
