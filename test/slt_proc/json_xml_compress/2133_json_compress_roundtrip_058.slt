# test/slt_proc/json_xml_compress/2133_json_compress_roundtrip_058.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (58)

query IIT
SELECT ISJSON('{"node":"node_058","code":583,"active":true}'), ISJSON('invalid_json_58'), JSON_VALUE('{"node":"node_058","code":583,"active":true}', '$.node');
----
1 0 node_058

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_058","code":583,"active":true}', '$.code', 5809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2133-Key-583')) AS VARCHAR(200));
----
5809 LionSQL-Compressed-Block-2133-Key-583

statement ok
CREATE TABLE jc_store_2133 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2133 VALUES (1, '{"node":"node_058","code":583,"active":true}', JSON_MODIFY('{"node":"node_058","code":583,"active":true}', '$.code', 5809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2133
WHERE ISJSON(j) = 1;
----
1 node_058 5809

statement ok
DROP TABLE jc_store_2133;
