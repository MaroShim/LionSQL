# test/slt_proc/json_xml_compress/2088_json_compress_roundtrip_013.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (13)

query IIT
SELECT ISJSON('{"node":"node_013","code":133,"active":true}'), ISJSON('invalid_json_13'), JSON_VALUE('{"node":"node_013","code":133,"active":true}', '$.node');
----
1 0 node_013

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_013","code":133,"active":true}', '$.code', 1309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2088-Key-133')) AS VARCHAR(200));
----
1309 LionSQL-Compressed-Block-2088-Key-133

statement ok
CREATE TABLE jc_store_2088 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2088 VALUES (1, '{"node":"node_013","code":133,"active":true}', JSON_MODIFY('{"node":"node_013","code":133,"active":true}', '$.code', 1309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2088
WHERE ISJSON(j) = 1;
----
1 node_013 1309

statement ok
DROP TABLE jc_store_2088;
