# test/slt_proc/json_xml_compress/838_json_modify_nested_03.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (3)

query TTT
SELECT JSON_VALUE('{"service":"svc_03","env":"qa","Version":30,"meta":{"region":"kr-1"}}', '$.service'), JSON_VALUE('{"service":"svc_03","env":"qa","Version":30,"meta":{"region":"kr-1"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_03","env":"qa","Version":30,"meta":{"region":"kr-1"}}', '$.Version', 307), '$.Version');
----
svc_03 kr-1 307

statement ok
CREATE TABLE j_cfg_838 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_838 VALUES
(1, '{"service":"svc_03","env":"qa","Version":30,"meta":{"region":"kr-1"}}'),
(2, JSON_MODIFY('{"service":"svc_03","env":"qa","Version":30,"meta":{"region":"kr-1"}}', '$.Version', 307));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_838
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_03 30
2 svc_03 307

statement ok
DROP TABLE j_cfg_838;
