# test/slt_proc/json_xml_compress/2214_json_compress_roundtrip_139.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (139)

query IIT
SELECT ISJSON('{"node":"node_139","code":1393,"active":true}'), ISJSON('invalid_json_139'), JSON_VALUE('{"node":"node_139","code":1393,"active":true}', '$.node');
----
1 0 node_139

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_139","code":1393,"active":true}', '$.code', 13909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2214-Key-1393')) AS VARCHAR(200));
----
13909 LionSQL-Compressed-Block-2214-Key-1393

statement ok
CREATE TABLE jc_store_2214 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2214 VALUES (1, '{"node":"node_139","code":1393,"active":true}', JSON_MODIFY('{"node":"node_139","code":1393,"active":true}', '$.code', 13909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2214
WHERE ISJSON(j) = 1;
----
1 node_139 13909

statement ok
DROP TABLE jc_store_2214;
