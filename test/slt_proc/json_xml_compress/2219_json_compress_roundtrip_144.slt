# test/slt_proc/json_xml_compress/2219_json_compress_roundtrip_144.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (144)

query IIT
SELECT ISJSON('{"node":"node_144","code":1443,"active":true}'), ISJSON('invalid_json_144'), JSON_VALUE('{"node":"node_144","code":1443,"active":true}', '$.node');
----
1 0 node_144

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_144","code":1443,"active":true}', '$.code', 14409), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2219-Key-1443')) AS VARCHAR(200));
----
14409 LionSQL-Compressed-Block-2219-Key-1443

statement ok
CREATE TABLE jc_store_2219 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2219 VALUES (1, '{"node":"node_144","code":1443,"active":true}', JSON_MODIFY('{"node":"node_144","code":1443,"active":true}', '$.code', 14409));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2219
WHERE ISJSON(j) = 1;
----
1 node_144 14409

statement ok
DROP TABLE jc_store_2219;
