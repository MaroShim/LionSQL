# test/slt_proc/json_xml_compress/2178_json_compress_roundtrip_103.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (103)

query IIT
SELECT ISJSON('{"node":"node_103","code":1033,"active":true}'), ISJSON('invalid_json_103'), JSON_VALUE('{"node":"node_103","code":1033,"active":true}', '$.node');
----
1 0 node_103

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_103","code":1033,"active":true}', '$.code', 10309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2178-Key-1033')) AS VARCHAR(200));
----
10309 LionSQL-Compressed-Block-2178-Key-1033

statement ok
CREATE TABLE jc_store_2178 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2178 VALUES (1, '{"node":"node_103","code":1033,"active":true}', JSON_MODIFY('{"node":"node_103","code":1033,"active":true}', '$.code', 10309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2178
WHERE ISJSON(j) = 1;
----
1 node_103 10309

statement ok
DROP TABLE jc_store_2178;
