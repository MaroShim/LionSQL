# test/slt_proc/json_xml_compress/2105_json_compress_roundtrip_030.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (30)

query IIT
SELECT ISJSON('{"node":"node_030","code":303,"active":true}'), ISJSON('invalid_json_30'), JSON_VALUE('{"node":"node_030","code":303,"active":true}', '$.node');
----
1 0 node_030

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_030","code":303,"active":true}', '$.code', 3009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2105-Key-303')) AS VARCHAR(200));
----
3009 LionSQL-Compressed-Block-2105-Key-303

statement ok
CREATE TABLE jc_store_2105 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2105 VALUES (1, '{"node":"node_030","code":303,"active":true}', JSON_MODIFY('{"node":"node_030","code":303,"active":true}', '$.code', 3009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2105
WHERE ISJSON(j) = 1;
----
1 node_030 3009

statement ok
DROP TABLE jc_store_2105;
