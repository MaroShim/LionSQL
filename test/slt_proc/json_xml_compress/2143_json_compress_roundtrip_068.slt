# test/slt_proc/json_xml_compress/2143_json_compress_roundtrip_068.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (68)

query IIT
SELECT ISJSON('{"node":"node_068","code":683,"active":true}'), ISJSON('invalid_json_68'), JSON_VALUE('{"node":"node_068","code":683,"active":true}', '$.node');
----
1 0 node_068

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_068","code":683,"active":true}', '$.code', 6809), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2143-Key-683')) AS VARCHAR(200));
----
6809 LionSQL-Compressed-Block-2143-Key-683

statement ok
CREATE TABLE jc_store_2143 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2143 VALUES (1, '{"node":"node_068","code":683,"active":true}', JSON_MODIFY('{"node":"node_068","code":683,"active":true}', '$.code', 6809));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2143
WHERE ISJSON(j) = 1;
----
1 node_068 6809

statement ok
DROP TABLE jc_store_2143;
