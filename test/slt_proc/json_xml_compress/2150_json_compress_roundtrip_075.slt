# test/slt_proc/json_xml_compress/2150_json_compress_roundtrip_075.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (75)

query IIT
SELECT ISJSON('{"node":"node_075","code":753,"active":true}'), ISJSON('invalid_json_75'), JSON_VALUE('{"node":"node_075","code":753,"active":true}', '$.node');
----
1 0 node_075

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_075","code":753,"active":true}', '$.code', 7509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2150-Key-753')) AS VARCHAR(200));
----
7509 LionSQL-Compressed-Block-2150-Key-753

statement ok
CREATE TABLE jc_store_2150 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2150 VALUES (1, '{"node":"node_075","code":753,"active":true}', JSON_MODIFY('{"node":"node_075","code":753,"active":true}', '$.code', 7509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2150
WHERE ISJSON(j) = 1;
----
1 node_075 7509

statement ok
DROP TABLE jc_store_2150;
