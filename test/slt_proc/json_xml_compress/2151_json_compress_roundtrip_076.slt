# test/slt_proc/json_xml_compress/2151_json_compress_roundtrip_076.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (76)

query IIT
SELECT ISJSON('{"node":"node_076","code":763,"active":true}'), ISJSON('invalid_json_76'), JSON_VALUE('{"node":"node_076","code":763,"active":true}', '$.node');
----
1 0 node_076

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_076","code":763,"active":true}', '$.code', 7609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2151-Key-763')) AS VARCHAR(200));
----
7609 LionSQL-Compressed-Block-2151-Key-763

statement ok
CREATE TABLE jc_store_2151 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2151 VALUES (1, '{"node":"node_076","code":763,"active":true}', JSON_MODIFY('{"node":"node_076","code":763,"active":true}', '$.code', 7609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2151
WHERE ISJSON(j) = 1;
----
1 node_076 7609

statement ok
DROP TABLE jc_store_2151;
