# test/slt_proc/json_xml_compress/844_json_modify_nested_09.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (9)

query TTT
SELECT JSON_VALUE('{"service":"svc_09","env":"stage","Version":90,"meta":{"region":"kr-1"}}', '$.service'), JSON_VALUE('{"service":"svc_09","env":"stage","Version":90,"meta":{"region":"kr-1"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_09","env":"stage","Version":90,"meta":{"region":"kr-1"}}', '$.Version', 907), '$.Version');
----
svc_09 kr-1 907

statement ok
CREATE TABLE j_cfg_844 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_844 VALUES
(1, '{"service":"svc_09","env":"stage","Version":90,"meta":{"region":"kr-1"}}'),
(2, JSON_MODIFY('{"service":"svc_09","env":"stage","Version":90,"meta":{"region":"kr-1"}}', '$.Version', 907));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_844
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_09 90
2 svc_09 907

statement ok
DROP TABLE j_cfg_844;
