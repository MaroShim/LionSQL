# test/slt_proc/json_xml_compress/2076_json_compress_roundtrip_001.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (1)

query IIT
SELECT ISJSON('{"node":"node_001","code":13,"active":true}'), ISJSON('invalid_json_1'), JSON_VALUE('{"node":"node_001","code":13,"active":true}', '$.node');
----
1 0 node_001

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_001","code":13,"active":true}', '$.code', 109), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2076-Key-13')) AS VARCHAR(200));
----
109 LionSQL-Compressed-Block-2076-Key-13

statement ok
CREATE TABLE jc_store_2076 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2076 VALUES (1, '{"node":"node_001","code":13,"active":true}', JSON_MODIFY('{"node":"node_001","code":13,"active":true}', '$.code', 109));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2076
WHERE ISJSON(j) = 1;
----
1 node_001 109

statement ok
DROP TABLE jc_store_2076;
