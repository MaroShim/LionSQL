# test/slt_proc/json_xml_compress/2122_json_compress_roundtrip_047.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (47)

query IIT
SELECT ISJSON('{"node":"node_047","code":473,"active":true}'), ISJSON('invalid_json_47'), JSON_VALUE('{"node":"node_047","code":473,"active":true}', '$.node');
----
1 0 node_047

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_047","code":473,"active":true}', '$.code', 4709), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2122-Key-473')) AS VARCHAR(200));
----
4709 LionSQL-Compressed-Block-2122-Key-473

statement ok
CREATE TABLE jc_store_2122 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2122 VALUES (1, '{"node":"node_047","code":473,"active":true}', JSON_MODIFY('{"node":"node_047","code":473,"active":true}', '$.code', 4709));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2122
WHERE ISJSON(j) = 1;
----
1 node_047 4709

statement ok
DROP TABLE jc_store_2122;
