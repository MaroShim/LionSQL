# test/slt_proc/json_xml_compress/2104_json_compress_roundtrip_029.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (29)

query IIT
SELECT ISJSON('{"node":"node_029","code":293,"active":true}'), ISJSON('invalid_json_29'), JSON_VALUE('{"node":"node_029","code":293,"active":true}', '$.node');
----
1 0 node_029

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_029","code":293,"active":true}', '$.code', 2909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2104-Key-293')) AS VARCHAR(200));
----
2909 LionSQL-Compressed-Block-2104-Key-293

statement ok
CREATE TABLE jc_store_2104 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2104 VALUES (1, '{"node":"node_029","code":293,"active":true}', JSON_MODIFY('{"node":"node_029","code":293,"active":true}', '$.code', 2909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2104
WHERE ISJSON(j) = 1;
----
1 node_029 2909

statement ok
DROP TABLE jc_store_2104;
