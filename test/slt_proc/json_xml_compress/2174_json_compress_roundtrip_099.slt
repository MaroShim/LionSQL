# test/slt_proc/json_xml_compress/2174_json_compress_roundtrip_099.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (99)

query IIT
SELECT ISJSON('{"node":"node_099","code":993,"active":true}'), ISJSON('invalid_json_99'), JSON_VALUE('{"node":"node_099","code":993,"active":true}', '$.node');
----
1 0 node_099

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_099","code":993,"active":true}', '$.code', 9909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2174-Key-993')) AS VARCHAR(200));
----
9909 LionSQL-Compressed-Block-2174-Key-993

statement ok
CREATE TABLE jc_store_2174 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2174 VALUES (1, '{"node":"node_099","code":993,"active":true}', JSON_MODIFY('{"node":"node_099","code":993,"active":true}', '$.code', 9909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2174
WHERE ISJSON(j) = 1;
----
1 node_099 9909

statement ok
DROP TABLE jc_store_2174;
