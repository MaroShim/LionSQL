# test/slt_proc/json_xml_compress/2190_json_compress_roundtrip_115.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (115)

query IIT
SELECT ISJSON('{"node":"node_115","code":1153,"active":true}'), ISJSON('invalid_json_115'), JSON_VALUE('{"node":"node_115","code":1153,"active":true}', '$.node');
----
1 0 node_115

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_115","code":1153,"active":true}', '$.code', 11509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2190-Key-1153')) AS VARCHAR(200));
----
11509 LionSQL-Compressed-Block-2190-Key-1153

statement ok
CREATE TABLE jc_store_2190 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2190 VALUES (1, '{"node":"node_115","code":1153,"active":true}', JSON_MODIFY('{"node":"node_115","code":1153,"active":true}', '$.code', 11509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2190
WHERE ISJSON(j) = 1;
----
1 node_115 11509

statement ok
DROP TABLE jc_store_2190;
