# test/slt_proc/json_xml_compress/117_json_and_compress_12.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (12)

query II
SELECT ISJSON('{"id":12,"user":"user_12","role":"viewer","score":1225}'), ISJSON('invalid_12');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":12,"user":"user_12","role":"viewer","score":1225}', '$.user'), JSON_VALUE('{"id":12,"user":"user_12","role":"viewer","score":1225}', '$.role'), JSON_VALUE('{"id":12,"user":"user_12","role":"viewer","score":1225}', '$.score');
----
user_12 viewer 1225

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-12-XYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-12-XYZXYZ 7 1
