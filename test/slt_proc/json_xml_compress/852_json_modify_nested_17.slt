# test/slt_proc/json_xml_compress/852_json_modify_nested_17.slt
# T-SQL JSON_MODIFY, nested JSON_VALUE, and JSON table filtering (17)

query TTT
SELECT JSON_VALUE('{"service":"svc_17","env":"stage","Version":170,"meta":{"region":"kr-3"}}', '$.service'), JSON_VALUE('{"service":"svc_17","env":"stage","Version":170,"meta":{"region":"kr-3"}}', '$.meta.region'), JSON_VALUE(JSON_MODIFY('{"service":"svc_17","env":"stage","Version":170,"meta":{"region":"kr-3"}}', '$.Version', 1707), '$.Version');
----
svc_17 kr-3 1707

statement ok
CREATE TABLE j_cfg_852 (id INT PRIMARY KEY, doc VARCHAR(500));

statement ok
INSERT INTO j_cfg_852 VALUES
(1, '{"service":"svc_17","env":"stage","Version":170,"meta":{"region":"kr-3"}}'),
(2, JSON_MODIFY('{"service":"svc_17","env":"stage","Version":170,"meta":{"region":"kr-3"}}', '$.Version', 1707));

query ITI
SELECT id, JSON_VALUE(doc, '$.service'), CAST(JSON_VALUE(doc, '$.Version') AS INT)
FROM j_cfg_852
WHERE ISJSON(doc) = 1
ORDER BY id;
----
1 svc_17 170
2 svc_17 1707

statement ok
DROP TABLE j_cfg_852;
