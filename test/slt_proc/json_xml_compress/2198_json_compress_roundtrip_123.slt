# test/slt_proc/json_xml_compress/2198_json_compress_roundtrip_123.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (123)

query IIT
SELECT ISJSON('{"node":"node_123","code":1233,"active":true}'), ISJSON('invalid_json_123'), JSON_VALUE('{"node":"node_123","code":1233,"active":true}', '$.node');
----
1 0 node_123

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_123","code":1233,"active":true}', '$.code', 12309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2198-Key-1233')) AS VARCHAR(200));
----
12309 LionSQL-Compressed-Block-2198-Key-1233

statement ok
CREATE TABLE jc_store_2198 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2198 VALUES (1, '{"node":"node_123","code":1233,"active":true}', JSON_MODIFY('{"node":"node_123","code":1233,"active":true}', '$.code', 12309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2198
WHERE ISJSON(j) = 1;
----
1 node_123 12309

statement ok
DROP TABLE jc_store_2198;
