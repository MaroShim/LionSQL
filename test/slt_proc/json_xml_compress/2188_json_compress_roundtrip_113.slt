# test/slt_proc/json_xml_compress/2188_json_compress_roundtrip_113.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (113)

query IIT
SELECT ISJSON('{"node":"node_113","code":1133,"active":true}'), ISJSON('invalid_json_113'), JSON_VALUE('{"node":"node_113","code":1133,"active":true}', '$.node');
----
1 0 node_113

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_113","code":1133,"active":true}', '$.code', 11309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2188-Key-1133')) AS VARCHAR(200));
----
11309 LionSQL-Compressed-Block-2188-Key-1133

statement ok
CREATE TABLE jc_store_2188 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2188 VALUES (1, '{"node":"node_113","code":1133,"active":true}', JSON_MODIFY('{"node":"node_113","code":1133,"active":true}', '$.code', 11309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2188
WHERE ISJSON(j) = 1;
----
1 node_113 11309

statement ok
DROP TABLE jc_store_2188;
