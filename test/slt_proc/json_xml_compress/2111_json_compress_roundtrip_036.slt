# test/slt_proc/json_xml_compress/2111_json_compress_roundtrip_036.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (36)

query IIT
SELECT ISJSON('{"node":"node_036","code":363,"active":true}'), ISJSON('invalid_json_36'), JSON_VALUE('{"node":"node_036","code":363,"active":true}', '$.node');
----
1 0 node_036

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_036","code":363,"active":true}', '$.code', 3609), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2111-Key-363')) AS VARCHAR(200));
----
3609 LionSQL-Compressed-Block-2111-Key-363

statement ok
CREATE TABLE jc_store_2111 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2111 VALUES (1, '{"node":"node_036","code":363,"active":true}', JSON_MODIFY('{"node":"node_036","code":363,"active":true}', '$.code', 3609));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2111
WHERE ISJSON(j) = 1;
----
1 node_036 3609

statement ok
DROP TABLE jc_store_2111;
