# test/slt_proc/json_xml_compress/2108_json_compress_roundtrip_033.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (33)

query IIT
SELECT ISJSON('{"node":"node_033","code":333,"active":true}'), ISJSON('invalid_json_33'), JSON_VALUE('{"node":"node_033","code":333,"active":true}', '$.node');
----
1 0 node_033

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_033","code":333,"active":true}', '$.code', 3309), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2108-Key-333')) AS VARCHAR(200));
----
3309 LionSQL-Compressed-Block-2108-Key-333

statement ok
CREATE TABLE jc_store_2108 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2108 VALUES (1, '{"node":"node_033","code":333,"active":true}', JSON_MODIFY('{"node":"node_033","code":333,"active":true}', '$.code', 3309));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2108
WHERE ISJSON(j) = 1;
----
1 node_033 3309

statement ok
DROP TABLE jc_store_2108;
