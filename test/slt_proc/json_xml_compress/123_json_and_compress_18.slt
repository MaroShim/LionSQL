# test/slt_proc/json_xml_compress/123_json_and_compress_18.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (18)

query II
SELECT ISJSON('{"id":18,"user":"user_18","role":"auditor","score":1825}'), ISJSON('invalid_18');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":18,"user":"user_18","role":"auditor","score":1825}', '$.user'), JSON_VALUE('{"id":18,"user":"user_18","role":"auditor","score":1825}', '$.role'), JSON_VALUE('{"id":18,"user":"user_18","role":"auditor","score":1825}', '$.score');
----
user_18 auditor 1825

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-18-XYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-18-XYZXYZXYZXYZ 7 1
