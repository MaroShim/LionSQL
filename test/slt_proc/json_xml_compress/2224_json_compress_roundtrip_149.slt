# test/slt_proc/json_xml_compress/2224_json_compress_roundtrip_149.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (149)

query IIT
SELECT ISJSON('{"node":"node_149","code":1493,"active":true}'), ISJSON('invalid_json_149'), JSON_VALUE('{"node":"node_149","code":1493,"active":true}', '$.node');
----
1 0 node_149

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_149","code":1493,"active":true}', '$.code', 14909), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2224-Key-1493')) AS VARCHAR(200));
----
14909 LionSQL-Compressed-Block-2224-Key-1493

statement ok
CREATE TABLE jc_store_2224 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2224 VALUES (1, '{"node":"node_149","code":1493,"active":true}', JSON_MODIFY('{"node":"node_149","code":1493,"active":true}', '$.code', 14909));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2224
WHERE ISJSON(j) = 1;
----
1 node_149 14909

statement ok
DROP TABLE jc_store_2224;
