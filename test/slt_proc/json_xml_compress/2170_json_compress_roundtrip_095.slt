# test/slt_proc/json_xml_compress/2170_json_compress_roundtrip_095.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (95)

query IIT
SELECT ISJSON('{"node":"node_095","code":953,"active":true}'), ISJSON('invalid_json_95'), JSON_VALUE('{"node":"node_095","code":953,"active":true}', '$.node');
----
1 0 node_095

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_095","code":953,"active":true}', '$.code', 9509), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2170-Key-953')) AS VARCHAR(200));
----
9509 LionSQL-Compressed-Block-2170-Key-953

statement ok
CREATE TABLE jc_store_2170 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2170 VALUES (1, '{"node":"node_095","code":953,"active":true}', JSON_MODIFY('{"node":"node_095","code":953,"active":true}', '$.code', 9509));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2170
WHERE ISJSON(j) = 1;
----
1 node_095 9509

statement ok
DROP TABLE jc_store_2170;
