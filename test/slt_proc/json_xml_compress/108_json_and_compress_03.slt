# test/slt_proc/json_xml_compress/108_json_and_compress_03.slt
# T-SQL ISJSON, JSON_VALUE, COMPRESS/DECOMPRESS, system vars (3)

query II
SELECT ISJSON('{"id":3,"user":"user_03","role":"auditor","score":325}'), ISJSON('invalid_3');
----
1 0

query TTT
SELECT JSON_VALUE('{"id":3,"user":"user_03","role":"auditor","score":325}', '$.user'), JSON_VALUE('{"id":3,"user":"user_03","role":"auditor","score":325}', '$.role'), JSON_VALUE('{"id":3,"user":"user_03","role":"auditor","score":325}', '$.score');
----
user_03 auditor 325

query TII
SELECT CAST(DECOMPRESS(COMPRESS('LionSQL-Payload-03-XYZXYZXYZXYZXYZ')) AS VARCHAR(200)), @@DATEFIRST, IIF(@@DBTS IS NOT NULL, 1, 0);
----
LionSQL-Payload-03-XYZXYZXYZXYZXYZ 7 1
