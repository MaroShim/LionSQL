# test/slt_proc/json_xml_compress/2095_json_compress_roundtrip_020.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (20)

query IIT
SELECT ISJSON('{"node":"node_020","code":203,"active":true}'), ISJSON('invalid_json_20'), JSON_VALUE('{"node":"node_020","code":203,"active":true}', '$.node');
----
1 0 node_020

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_020","code":203,"active":true}', '$.code', 2009), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2095-Key-203')) AS VARCHAR(200));
----
2009 LionSQL-Compressed-Block-2095-Key-203

statement ok
CREATE TABLE jc_store_2095 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2095 VALUES (1, '{"node":"node_020","code":203,"active":true}', JSON_MODIFY('{"node":"node_020","code":203,"active":true}', '$.code', 2009));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2095
WHERE ISJSON(j) = 1;
----
1 node_020 2009

statement ok
DROP TABLE jc_store_2095;
