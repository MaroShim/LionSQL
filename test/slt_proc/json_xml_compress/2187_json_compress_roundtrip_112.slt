# test/slt_proc/json_xml_compress/2187_json_compress_roundtrip_112.slt
# T-SQL ISJSON, JSON_VALUE, JSON_MODIFY, COMPRESS & DECOMPRESS roundtrip (112)

query IIT
SELECT ISJSON('{"node":"node_112","code":1123,"active":true}'), ISJSON('invalid_json_112'), JSON_VALUE('{"node":"node_112","code":1123,"active":true}', '$.node');
----
1 0 node_112

query IT
SELECT CAST(JSON_VALUE(JSON_MODIFY('{"node":"node_112","code":1123,"active":true}', '$.code', 11209), '$.code') AS INT),
       CAST(DECOMPRESS(COMPRESS('LionSQL-Compressed-Block-2187-Key-1123')) AS VARCHAR(200));
----
11209 LionSQL-Compressed-Block-2187-Key-1123

statement ok
CREATE TABLE jc_store_2187 (id INT PRIMARY KEY, j VARCHAR(400), rev_j VARCHAR(400));

statement ok
INSERT INTO jc_store_2187 VALUES (1, '{"node":"node_112","code":1123,"active":true}', JSON_MODIFY('{"node":"node_112","code":1123,"active":true}', '$.code', 11209));

query ITI
SELECT id, JSON_VALUE(j, '$.node'), CAST(JSON_VALUE(rev_j, '$.code') AS INT)
FROM jc_store_2187
WHERE ISJSON(j) = 1;
----
1 node_112 11209

statement ok
DROP TABLE jc_store_2187;
