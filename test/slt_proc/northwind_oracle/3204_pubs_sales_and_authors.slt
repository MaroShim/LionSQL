# test/slt_proc/northwind_oracle/3204_pubs_sales_and_authors.slt
# Microsoft SQL Server Pubs Sample Database Authors and Book Sales Oracle Suite

statement ok
CREATE TABLE pubs_authors (
    au_id VARCHAR(11) PRIMARY KEY,
    au_lname VARCHAR(40) NOT NULL,
    au_fname VARCHAR(20) NOT NULL,
    city VARCHAR(20) NOT NULL,
    state CHAR(2) NOT NULL
);

statement ok
CREATE TABLE pubs_titles (
    title_id VARCHAR(6) PRIMARY KEY,
    title VARCHAR(80) NOT NULL,
    type VARCHAR(12) NOT NULL,
    price DECIMAL(10,2) NOT NULL,
    ytd_sales INT NOT NULL
);

statement ok
CREATE TABLE pubs_titleauthor (
    au_id VARCHAR(11) NOT NULL,
    title_id VARCHAR(6) NOT NULL,
    royaltyper INT NOT NULL,
    PRIMARY KEY (au_id, title_id)
);

