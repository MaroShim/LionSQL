# Query 1: Join Authors to Titles via titleauthor
query TTT
SELECT a.au_lname, t.title, t.type
FROM pubs_authors a
JOIN pubs_titleauthor ta ON a.au_id = ta.au_id
JOIN pubs_titles t ON ta.title_id = t.title_id
ORDER BY a.au_lname, t.title;
----
Green 'Cooking with Computers' business
Green 'Gourmet Microwave' mod_cook
White 'Executive Database Guide' business

# Query 2: Aggregate Sales Revenue by Type
query TIR
SELECT type, COUNT(title_id), SUM(price * ytd_sales)
FROM pubs_titles
GROUP BY type
ORDER BY type;
----
business 2 128177.250
mod_cook 1 6075.680

# Query 3: Multi-author filter
query TT
SELECT a.au_lname, a.city
FROM pubs_authors a
WHERE a.state = 'CA'
ORDER BY a.au_lname;
----
Carson Berkeley
Green Oakland
White 'Menlo Park'

