# test/slt_proc/cte_subquery_join/214_recursive_cte_and_joins_09.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (9)

query I
WITH seq(n) AS (
    SELECT 6
    UNION ALL
    SELECT n + 6 FROM seq WHERE n < 24
)
SELECT n FROM seq ORDER BY n;
----
6
12
18
24

statement ok
CREATE TABLE c_cust_214 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_214 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_214 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_214 VALUES (101, 1, 90), (102, 1, 180), (103, 2, 270);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_214 c
INNER JOIN c_ord_214 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 270
2 Bob 270

query IT
SELECT cid, cname FROM c_cust_214 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_214 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_214;

statement ok
DROP TABLE c_cust_214;
