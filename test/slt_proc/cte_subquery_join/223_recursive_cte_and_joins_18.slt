# test/slt_proc/cte_subquery_join/223_recursive_cte_and_joins_18.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (18)

query I
WITH seq(n) AS (
    SELECT 5
    UNION ALL
    SELECT n + 5 FROM seq WHERE n < 20
)
SELECT n FROM seq ORDER BY n;
----
5
10
15
20

statement ok
CREATE TABLE c_cust_223 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_223 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_223 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_223 VALUES (101, 1, 180), (102, 1, 360), (103, 2, 540);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_223 c
INNER JOIN c_ord_223 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 540
2 Bob 540

query IT
SELECT cid, cname FROM c_cust_223 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_223 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_223;

statement ok
DROP TABLE c_cust_223;
