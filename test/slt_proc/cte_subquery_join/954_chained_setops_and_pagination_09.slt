# test/slt_proc/cte_subquery_join/954_chained_setops_and_pagination_09.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (9)

query I
SELECT 9 AS v
UNION ALL
SELECT 19 AS v
UNION ALL
SELECT 29 AS v
UNION ALL
SELECT 39 AS v
ORDER BY v;
----
9
19
29
39

statement ok
CREATE TABLE set_a_954 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_954 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_954 VALUES (1, 9), (2, 19), (3, 29);

statement ok
INSERT INTO set_b_954 VALUES (1, 19), (2, 29), (3, 39);

query I
SELECT v FROM set_a_954
INTERSECT
SELECT v FROM set_b_954
ORDER BY v;
----
19
29

query I
SELECT v FROM set_a_954
EXCEPT
SELECT v FROM set_b_954
ORDER BY v;
----
9

statement ok
CREATE PROCEDURE sp_page_set_954 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_954
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_954 1, 2;
----
2 19
3 29

statement ok
DROP TABLE set_b_954;

statement ok
DROP TABLE set_a_954;
