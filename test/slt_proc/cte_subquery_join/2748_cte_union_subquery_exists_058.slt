# test/slt_proc/cte_subquery_join/2748_cte_union_subquery_exists_058.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (58)

statement ok
CREATE TABLE cj_emp_2748 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2748 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2748 VALUES (10, 'ENG_58'), (20, 'SALES_58'), (30, 'HR_58');

statement ok
INSERT INTO cj_emp_2748 VALUES
(1, 10, 174),
(2, 10, 348),
(3, 20, 522),
(4, 30, 696);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2748
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2748 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_58 522
20 SALES_58 522
30 HR_58 696

query II
SELECT id, salary
FROM cj_emp_2748
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2748 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2748 WHERE dept_id = 30
)
ORDER BY id;
----
1 174
2 348
4 696

statement ok
DROP TABLE cj_emp_2748;

statement ok
DROP TABLE cj_dept_2748;
