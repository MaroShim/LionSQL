# test/slt_proc/cte_subquery_join/2706_cte_union_subquery_exists_016.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (16)

statement ok
CREATE TABLE cj_emp_2706 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2706 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2706 VALUES (10, 'ENG_16'), (20, 'SALES_16'), (30, 'HR_16');

statement ok
INSERT INTO cj_emp_2706 VALUES
(1, 10, 48),
(2, 10, 96),
(3, 20, 144),
(4, 30, 192);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2706
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2706 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_16 144
20 SALES_16 144
30 HR_16 192

query II
SELECT id, salary
FROM cj_emp_2706
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2706 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2706 WHERE dept_id = 30
)
ORDER BY id;
----
1 48
2 96
4 192

statement ok
DROP TABLE cj_emp_2706;

statement ok
DROP TABLE cj_dept_2706;
