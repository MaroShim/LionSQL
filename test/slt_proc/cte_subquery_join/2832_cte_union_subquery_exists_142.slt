# test/slt_proc/cte_subquery_join/2832_cte_union_subquery_exists_142.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (142)

statement ok
CREATE TABLE cj_emp_2832 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2832 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2832 VALUES (10, 'ENG_142'), (20, 'SALES_142'), (30, 'HR_142');

statement ok
INSERT INTO cj_emp_2832 VALUES
(1, 10, 426),
(2, 10, 852),
(3, 20, 1278),
(4, 30, 1704);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2832
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2832 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_142 1278
20 SALES_142 1278
30 HR_142 1704

query II
SELECT id, salary
FROM cj_emp_2832
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2832 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2832 WHERE dept_id = 30
)
ORDER BY id;
----
1 426
2 852
4 1704

statement ok
DROP TABLE cj_emp_2832;

statement ok
DROP TABLE cj_dept_2832;
