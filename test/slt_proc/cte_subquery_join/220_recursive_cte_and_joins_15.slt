# test/slt_proc/cte_subquery_join/220_recursive_cte_and_joins_15.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (15)

query I
WITH seq(n) AS (
    SELECT 2
    UNION ALL
    SELECT n + 2 FROM seq WHERE n < 8
)
SELECT n FROM seq ORDER BY n;
----
2
4
6
8

statement ok
CREATE TABLE c_cust_220 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_220 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_220 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_220 VALUES (101, 1, 150), (102, 1, 300), (103, 2, 450);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_220 c
INNER JOIN c_ord_220 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 450
2 Bob 450

query IT
SELECT cid, cname FROM c_cust_220 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_220 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_220;

statement ok
DROP TABLE c_cust_220;
