# test/slt_proc/cte_subquery_join/2697_cte_union_subquery_exists_007.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (7)

statement ok
CREATE TABLE cj_emp_2697 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2697 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2697 VALUES (10, 'ENG_7'), (20, 'SALES_7'), (30, 'HR_7');

statement ok
INSERT INTO cj_emp_2697 VALUES
(1, 10, 21),
(2, 10, 42),
(3, 20, 63),
(4, 30, 84);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2697
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2697 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_7 63
20 SALES_7 63
30 HR_7 84

query II
SELECT id, salary
FROM cj_emp_2697
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2697 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2697 WHERE dept_id = 30
)
ORDER BY id;
----
1 21
2 42
4 84

statement ok
DROP TABLE cj_emp_2697;

statement ok
DROP TABLE cj_dept_2697;
