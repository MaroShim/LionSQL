# test/slt_proc/cte_subquery_join/2721_cte_union_subquery_exists_031.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (31)

statement ok
CREATE TABLE cj_emp_2721 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2721 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2721 VALUES (10, 'ENG_31'), (20, 'SALES_31'), (30, 'HR_31');

statement ok
INSERT INTO cj_emp_2721 VALUES
(1, 10, 93),
(2, 10, 186),
(3, 20, 279),
(4, 30, 372);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2721
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2721 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_31 279
20 SALES_31 279
30 HR_31 372

query II
SELECT id, salary
FROM cj_emp_2721
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2721 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2721 WHERE dept_id = 30
)
ORDER BY id;
----
1 93
2 186
4 372

statement ok
DROP TABLE cj_emp_2721;

statement ok
DROP TABLE cj_dept_2721;
