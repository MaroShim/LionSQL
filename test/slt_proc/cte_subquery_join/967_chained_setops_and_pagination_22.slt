# test/slt_proc/cte_subquery_join/967_chained_setops_and_pagination_22.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (22)

query I
SELECT 22 AS v
UNION ALL
SELECT 32 AS v
UNION ALL
SELECT 42 AS v
UNION ALL
SELECT 52 AS v
ORDER BY v;
----
22
32
42
52

statement ok
CREATE TABLE set_a_967 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_967 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_967 VALUES (1, 22), (2, 32), (3, 42);

statement ok
INSERT INTO set_b_967 VALUES (1, 32), (2, 42), (3, 52);

query I
SELECT v FROM set_a_967
INTERSECT
SELECT v FROM set_b_967
ORDER BY v;
----
32
42

query I
SELECT v FROM set_a_967
EXCEPT
SELECT v FROM set_b_967
ORDER BY v;
----
22

statement ok
CREATE PROCEDURE sp_page_set_967 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_967
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_967 1, 2;
----
2 32
3 42

statement ok
DROP TABLE set_b_967;

statement ok
DROP TABLE set_a_967;
