# test/slt_proc/cte_subquery_join/2729_cte_union_subquery_exists_039.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (39)

statement ok
CREATE TABLE cj_emp_2729 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2729 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2729 VALUES (10, 'ENG_39'), (20, 'SALES_39'), (30, 'HR_39');

statement ok
INSERT INTO cj_emp_2729 VALUES
(1, 10, 117),
(2, 10, 234),
(3, 20, 351),
(4, 30, 468);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2729
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2729 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_39 351
20 SALES_39 351
30 HR_39 468

query II
SELECT id, salary
FROM cj_emp_2729
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2729 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2729 WHERE dept_id = 30
)
ORDER BY id;
----
1 117
2 234
4 468

statement ok
DROP TABLE cj_emp_2729;

statement ok
DROP TABLE cj_dept_2729;
