# test/slt_proc/cte_subquery_join/212_recursive_cte_and_joins_07.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (7)

query I
WITH seq(n) AS (
    SELECT 4
    UNION ALL
    SELECT n + 4 FROM seq WHERE n < 16
)
SELECT n FROM seq ORDER BY n;
----
4
8
12
16

statement ok
CREATE TABLE c_cust_212 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_212 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_212 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_212 VALUES (101, 1, 70), (102, 1, 140), (103, 2, 210);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_212 c
INNER JOIN c_ord_212 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 210
2 Bob 210

query IT
SELECT cid, cname FROM c_cust_212 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_212 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_212;

statement ok
DROP TABLE c_cust_212;
