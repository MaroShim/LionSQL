# test/slt_proc/cte_subquery_join/2747_cte_union_subquery_exists_057.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (57)

statement ok
CREATE TABLE cj_emp_2747 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2747 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2747 VALUES (10, 'ENG_57'), (20, 'SALES_57'), (30, 'HR_57');

statement ok
INSERT INTO cj_emp_2747 VALUES
(1, 10, 171),
(2, 10, 342),
(3, 20, 513),
(4, 30, 684);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2747
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2747 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_57 513
20 SALES_57 513
30 HR_57 684

query II
SELECT id, salary
FROM cj_emp_2747
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2747 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2747 WHERE dept_id = 30
)
ORDER BY id;
----
1 171
2 342
4 684

statement ok
DROP TABLE cj_emp_2747;

statement ok
DROP TABLE cj_dept_2747;
