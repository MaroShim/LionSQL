# test/slt_proc/cte_subquery_join/2831_cte_union_subquery_exists_141.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (141)

statement ok
CREATE TABLE cj_emp_2831 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2831 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2831 VALUES (10, 'ENG_141'), (20, 'SALES_141'), (30, 'HR_141');

statement ok
INSERT INTO cj_emp_2831 VALUES
(1, 10, 423),
(2, 10, 846),
(3, 20, 1269),
(4, 30, 1692);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2831
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2831 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_141 1269
20 SALES_141 1269
30 HR_141 1692

query II
SELECT id, salary
FROM cj_emp_2831
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2831 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2831 WHERE dept_id = 30
)
ORDER BY id;
----
1 423
2 846
4 1692

statement ok
DROP TABLE cj_emp_2831;

statement ok
DROP TABLE cj_dept_2831;
