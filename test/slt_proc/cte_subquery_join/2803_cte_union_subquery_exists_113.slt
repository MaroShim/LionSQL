# test/slt_proc/cte_subquery_join/2803_cte_union_subquery_exists_113.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (113)

statement ok
CREATE TABLE cj_emp_2803 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2803 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2803 VALUES (10, 'ENG_113'), (20, 'SALES_113'), (30, 'HR_113');

statement ok
INSERT INTO cj_emp_2803 VALUES
(1, 10, 339),
(2, 10, 678),
(3, 20, 1017),
(4, 30, 1356);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2803
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2803 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_113 1017
20 SALES_113 1017
30 HR_113 1356

query II
SELECT id, salary
FROM cj_emp_2803
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2803 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2803 WHERE dept_id = 30
)
ORDER BY id;
----
1 339
2 678
4 1356

statement ok
DROP TABLE cj_emp_2803;

statement ok
DROP TABLE cj_dept_2803;
