# test/slt_proc/cte_subquery_join/2771_cte_union_subquery_exists_081.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (81)

statement ok
CREATE TABLE cj_emp_2771 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2771 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2771 VALUES (10, 'ENG_81'), (20, 'SALES_81'), (30, 'HR_81');

statement ok
INSERT INTO cj_emp_2771 VALUES
(1, 10, 243),
(2, 10, 486),
(3, 20, 729),
(4, 30, 972);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2771
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2771 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_81 729
20 SALES_81 729
30 HR_81 972

query II
SELECT id, salary
FROM cj_emp_2771
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2771 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2771 WHERE dept_id = 30
)
ORDER BY id;
----
1 243
2 486
4 972

statement ok
DROP TABLE cj_emp_2771;

statement ok
DROP TABLE cj_dept_2771;
