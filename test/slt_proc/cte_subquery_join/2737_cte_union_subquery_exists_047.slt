# test/slt_proc/cte_subquery_join/2737_cte_union_subquery_exists_047.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (47)

statement ok
CREATE TABLE cj_emp_2737 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2737 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2737 VALUES (10, 'ENG_47'), (20, 'SALES_47'), (30, 'HR_47');

statement ok
INSERT INTO cj_emp_2737 VALUES
(1, 10, 141),
(2, 10, 282),
(3, 20, 423),
(4, 30, 564);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2737
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2737 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_47 423
20 SALES_47 423
30 HR_47 564

query II
SELECT id, salary
FROM cj_emp_2737
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2737 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2737 WHERE dept_id = 30
)
ORDER BY id;
----
1 141
2 282
4 564

statement ok
DROP TABLE cj_emp_2737;

statement ok
DROP TABLE cj_dept_2737;
