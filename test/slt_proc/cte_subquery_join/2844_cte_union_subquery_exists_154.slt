# test/slt_proc/cte_subquery_join/2844_cte_union_subquery_exists_154.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (154)

statement ok
CREATE TABLE cj_emp_2844 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2844 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2844 VALUES (10, 'ENG_154'), (20, 'SALES_154'), (30, 'HR_154');

statement ok
INSERT INTO cj_emp_2844 VALUES
(1, 10, 462),
(2, 10, 924),
(3, 20, 1386),
(4, 30, 1848);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2844
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2844 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_154 1386
20 SALES_154 1386
30 HR_154 1848

query II
SELECT id, salary
FROM cj_emp_2844
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2844 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2844 WHERE dept_id = 30
)
ORDER BY id;
----
1 462
2 924
4 1848

statement ok
DROP TABLE cj_emp_2844;

statement ok
DROP TABLE cj_dept_2844;
