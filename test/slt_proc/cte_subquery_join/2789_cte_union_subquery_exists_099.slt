# test/slt_proc/cte_subquery_join/2789_cte_union_subquery_exists_099.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (99)

statement ok
CREATE TABLE cj_emp_2789 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2789 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2789 VALUES (10, 'ENG_99'), (20, 'SALES_99'), (30, 'HR_99');

statement ok
INSERT INTO cj_emp_2789 VALUES
(1, 10, 297),
(2, 10, 594),
(3, 20, 891),
(4, 30, 1188);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2789
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2789 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_99 891
20 SALES_99 891
30 HR_99 1188

query II
SELECT id, salary
FROM cj_emp_2789
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2789 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2789 WHERE dept_id = 30
)
ORDER BY id;
----
1 297
2 594
4 1188

statement ok
DROP TABLE cj_emp_2789;

statement ok
DROP TABLE cj_dept_2789;
