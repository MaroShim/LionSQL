# test/slt_proc/cte_subquery_join/2808_cte_union_subquery_exists_118.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (118)

statement ok
CREATE TABLE cj_emp_2808 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2808 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2808 VALUES (10, 'ENG_118'), (20, 'SALES_118'), (30, 'HR_118');

statement ok
INSERT INTO cj_emp_2808 VALUES
(1, 10, 354),
(2, 10, 708),
(3, 20, 1062),
(4, 30, 1416);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2808
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2808 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_118 1062
20 SALES_118 1062
30 HR_118 1416

query II
SELECT id, salary
FROM cj_emp_2808
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2808 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2808 WHERE dept_id = 30
)
ORDER BY id;
----
1 354
2 708
4 1416

statement ok
DROP TABLE cj_emp_2808;

statement ok
DROP TABLE cj_dept_2808;
