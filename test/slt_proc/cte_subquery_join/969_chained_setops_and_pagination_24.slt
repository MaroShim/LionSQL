# test/slt_proc/cte_subquery_join/969_chained_setops_and_pagination_24.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (24)

query I
SELECT 24 AS v
UNION ALL
SELECT 34 AS v
UNION ALL
SELECT 44 AS v
UNION ALL
SELECT 54 AS v
ORDER BY v;
----
24
34
44
54

statement ok
CREATE TABLE set_a_969 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_969 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_969 VALUES (1, 24), (2, 34), (3, 44);

statement ok
INSERT INTO set_b_969 VALUES (1, 34), (2, 44), (3, 54);

query I
SELECT v FROM set_a_969
INTERSECT
SELECT v FROM set_b_969
ORDER BY v;
----
34
44

query I
SELECT v FROM set_a_969
EXCEPT
SELECT v FROM set_b_969
ORDER BY v;
----
24

statement ok
CREATE PROCEDURE sp_page_set_969 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_969
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_969 1, 2;
----
2 34
3 44

statement ok
DROP TABLE set_b_969;

statement ok
DROP TABLE set_a_969;
