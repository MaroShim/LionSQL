# test/slt_proc/cte_subquery_join/2820_cte_union_subquery_exists_130.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (130)

statement ok
CREATE TABLE cj_emp_2820 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2820 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2820 VALUES (10, 'ENG_130'), (20, 'SALES_130'), (30, 'HR_130');

statement ok
INSERT INTO cj_emp_2820 VALUES
(1, 10, 390),
(2, 10, 780),
(3, 20, 1170),
(4, 30, 1560);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2820
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2820 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_130 1170
20 SALES_130 1170
30 HR_130 1560

query II
SELECT id, salary
FROM cj_emp_2820
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2820 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2820 WHERE dept_id = 30
)
ORDER BY id;
----
1 390
2 780
4 1560

statement ok
DROP TABLE cj_emp_2820;

statement ok
DROP TABLE cj_dept_2820;
