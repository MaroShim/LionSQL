# test/slt_proc/cte_subquery_join/2733_cte_union_subquery_exists_043.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (43)

statement ok
CREATE TABLE cj_emp_2733 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2733 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2733 VALUES (10, 'ENG_43'), (20, 'SALES_43'), (30, 'HR_43');

statement ok
INSERT INTO cj_emp_2733 VALUES
(1, 10, 129),
(2, 10, 258),
(3, 20, 387),
(4, 30, 516);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2733
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2733 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_43 387
20 SALES_43 387
30 HR_43 516

query II
SELECT id, salary
FROM cj_emp_2733
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2733 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2733 WHERE dept_id = 30
)
ORDER BY id;
----
1 129
2 258
4 516

statement ok
DROP TABLE cj_emp_2733;

statement ok
DROP TABLE cj_dept_2733;
