# test/slt_proc/cte_subquery_join/946_chained_setops_and_pagination_01.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (1)

query I
SELECT 1 AS v
UNION ALL
SELECT 11 AS v
UNION ALL
SELECT 21 AS v
UNION ALL
SELECT 31 AS v
ORDER BY v;
----
1
11
21
31

statement ok
CREATE TABLE set_a_946 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_946 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_946 VALUES (1, 1), (2, 11), (3, 21);

statement ok
INSERT INTO set_b_946 VALUES (1, 11), (2, 21), (3, 31);

query I
SELECT v FROM set_a_946
INTERSECT
SELECT v FROM set_b_946
ORDER BY v;
----
11
21

query I
SELECT v FROM set_a_946
EXCEPT
SELECT v FROM set_b_946
ORDER BY v;
----
1

statement ok
CREATE PROCEDURE sp_page_set_946 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_946
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_946 1, 2;
----
2 11
3 21

statement ok
DROP TABLE set_b_946;

statement ok
DROP TABLE set_a_946;
