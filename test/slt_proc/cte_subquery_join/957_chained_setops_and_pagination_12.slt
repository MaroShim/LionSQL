# test/slt_proc/cte_subquery_join/957_chained_setops_and_pagination_12.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (12)

query I
SELECT 12 AS v
UNION ALL
SELECT 22 AS v
UNION ALL
SELECT 32 AS v
UNION ALL
SELECT 42 AS v
ORDER BY v;
----
12
22
32
42

statement ok
CREATE TABLE set_a_957 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_957 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_957 VALUES (1, 12), (2, 22), (3, 32);

statement ok
INSERT INTO set_b_957 VALUES (1, 22), (2, 32), (3, 42);

query I
SELECT v FROM set_a_957
INTERSECT
SELECT v FROM set_b_957
ORDER BY v;
----
22
32

query I
SELECT v FROM set_a_957
EXCEPT
SELECT v FROM set_b_957
ORDER BY v;
----
12

statement ok
CREATE PROCEDURE sp_page_set_957 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_957
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_957 1, 2;
----
2 22
3 32

statement ok
DROP TABLE set_b_957;

statement ok
DROP TABLE set_a_957;
