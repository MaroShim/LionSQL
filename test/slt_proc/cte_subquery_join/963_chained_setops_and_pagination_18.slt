# test/slt_proc/cte_subquery_join/963_chained_setops_and_pagination_18.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (18)

query I
SELECT 18 AS v
UNION ALL
SELECT 28 AS v
UNION ALL
SELECT 38 AS v
UNION ALL
SELECT 48 AS v
ORDER BY v;
----
18
28
38
48

statement ok
CREATE TABLE set_a_963 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_963 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_963 VALUES (1, 18), (2, 28), (3, 38);

statement ok
INSERT INTO set_b_963 VALUES (1, 28), (2, 38), (3, 48);

query I
SELECT v FROM set_a_963
INTERSECT
SELECT v FROM set_b_963
ORDER BY v;
----
28
38

query I
SELECT v FROM set_a_963
EXCEPT
SELECT v FROM set_b_963
ORDER BY v;
----
18

statement ok
CREATE PROCEDURE sp_page_set_963 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_963
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_963 1, 2;
----
2 28
3 38

statement ok
DROP TABLE set_b_963;

statement ok
DROP TABLE set_a_963;
