# test/slt_proc/cte_subquery_join/221_recursive_cte_and_joins_16.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (16)

query I
WITH seq(n) AS (
    SELECT 3
    UNION ALL
    SELECT n + 3 FROM seq WHERE n < 12
)
SELECT n FROM seq ORDER BY n;
----
3
6
9
12

statement ok
CREATE TABLE c_cust_221 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_221 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_221 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_221 VALUES (101, 1, 160), (102, 1, 320), (103, 2, 480);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_221 c
INNER JOIN c_ord_221 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 480
2 Bob 480

query IT
SELECT cid, cname FROM c_cust_221 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_221 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_221;

statement ok
DROP TABLE c_cust_221;
