# test/slt_proc/cte_subquery_join/2845_cte_union_subquery_exists_155.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (155)

statement ok
CREATE TABLE cj_emp_2845 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2845 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2845 VALUES (10, 'ENG_155'), (20, 'SALES_155'), (30, 'HR_155');

statement ok
INSERT INTO cj_emp_2845 VALUES
(1, 10, 465),
(2, 10, 930),
(3, 20, 1395),
(4, 30, 1860);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2845
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2845 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_155 1395
20 SALES_155 1395
30 HR_155 1860

query II
SELECT id, salary
FROM cj_emp_2845
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2845 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2845 WHERE dept_id = 30
)
ORDER BY id;
----
1 465
2 930
4 1860

statement ok
DROP TABLE cj_emp_2845;

statement ok
DROP TABLE cj_dept_2845;
