# test/slt_proc/cte_subquery_join/973_chained_setops_and_pagination_28.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (28)

query I
SELECT 28 AS v
UNION ALL
SELECT 38 AS v
UNION ALL
SELECT 48 AS v
UNION ALL
SELECT 58 AS v
ORDER BY v;
----
28
38
48
58

statement ok
CREATE TABLE set_a_973 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_973 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_973 VALUES (1, 28), (2, 38), (3, 48);

statement ok
INSERT INTO set_b_973 VALUES (1, 38), (2, 48), (3, 58);

query I
SELECT v FROM set_a_973
INTERSECT
SELECT v FROM set_b_973
ORDER BY v;
----
38
48

query I
SELECT v FROM set_a_973
EXCEPT
SELECT v FROM set_b_973
ORDER BY v;
----
28

statement ok
CREATE PROCEDURE sp_page_set_973 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_973
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_973 1, 2;
----
2 38
3 48

statement ok
DROP TABLE set_b_973;

statement ok
DROP TABLE set_a_973;
