# test/slt_proc/cte_subquery_join/2712_cte_union_subquery_exists_022.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (22)

statement ok
CREATE TABLE cj_emp_2712 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2712 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2712 VALUES (10, 'ENG_22'), (20, 'SALES_22'), (30, 'HR_22');

statement ok
INSERT INTO cj_emp_2712 VALUES
(1, 10, 66),
(2, 10, 132),
(3, 20, 198),
(4, 30, 264);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2712
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2712 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_22 198
20 SALES_22 198
30 HR_22 264

query II
SELECT id, salary
FROM cj_emp_2712
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2712 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2712 WHERE dept_id = 30
)
ORDER BY id;
----
1 66
2 132
4 264

statement ok
DROP TABLE cj_emp_2712;

statement ok
DROP TABLE cj_dept_2712;
