# test/slt_proc/cte_subquery_join/2759_cte_union_subquery_exists_069.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (69)

statement ok
CREATE TABLE cj_emp_2759 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2759 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2759 VALUES (10, 'ENG_69'), (20, 'SALES_69'), (30, 'HR_69');

statement ok
INSERT INTO cj_emp_2759 VALUES
(1, 10, 207),
(2, 10, 414),
(3, 20, 621),
(4, 30, 828);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2759
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2759 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_69 621
20 SALES_69 621
30 HR_69 828

query II
SELECT id, salary
FROM cj_emp_2759
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2759 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2759 WHERE dept_id = 30
)
ORDER BY id;
----
1 207
2 414
4 828

statement ok
DROP TABLE cj_emp_2759;

statement ok
DROP TABLE cj_dept_2759;
