# test/slt_proc/cte_subquery_join/961_chained_setops_and_pagination_16.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (16)

query I
SELECT 16 AS v
UNION ALL
SELECT 26 AS v
UNION ALL
SELECT 36 AS v
UNION ALL
SELECT 46 AS v
ORDER BY v;
----
16
26
36
46

statement ok
CREATE TABLE set_a_961 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_961 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_961 VALUES (1, 16), (2, 26), (3, 36);

statement ok
INSERT INTO set_b_961 VALUES (1, 26), (2, 36), (3, 46);

query I
SELECT v FROM set_a_961
INTERSECT
SELECT v FROM set_b_961
ORDER BY v;
----
26
36

query I
SELECT v FROM set_a_961
EXCEPT
SELECT v FROM set_b_961
ORDER BY v;
----
16

statement ok
CREATE PROCEDURE sp_page_set_961 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_961
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_961 1, 2;
----
2 26
3 36

statement ok
DROP TABLE set_b_961;

statement ok
DROP TABLE set_a_961;
