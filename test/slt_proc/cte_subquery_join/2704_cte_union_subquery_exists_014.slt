# test/slt_proc/cte_subquery_join/2704_cte_union_subquery_exists_014.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (14)

statement ok
CREATE TABLE cj_emp_2704 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2704 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2704 VALUES (10, 'ENG_14'), (20, 'SALES_14'), (30, 'HR_14');

statement ok
INSERT INTO cj_emp_2704 VALUES
(1, 10, 42),
(2, 10, 84),
(3, 20, 126),
(4, 30, 168);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2704
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2704 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_14 126
20 SALES_14 126
30 HR_14 168

query II
SELECT id, salary
FROM cj_emp_2704
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2704 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2704 WHERE dept_id = 30
)
ORDER BY id;
----
1 42
2 84
4 168

statement ok
DROP TABLE cj_emp_2704;

statement ok
DROP TABLE cj_dept_2704;
