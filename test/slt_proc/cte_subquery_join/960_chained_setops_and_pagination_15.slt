# test/slt_proc/cte_subquery_join/960_chained_setops_and_pagination_15.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (15)

query I
SELECT 15 AS v
UNION ALL
SELECT 25 AS v
UNION ALL
SELECT 35 AS v
UNION ALL
SELECT 45 AS v
ORDER BY v;
----
15
25
35
45

statement ok
CREATE TABLE set_a_960 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_960 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_960 VALUES (1, 15), (2, 25), (3, 35);

statement ok
INSERT INTO set_b_960 VALUES (1, 25), (2, 35), (3, 45);

query I
SELECT v FROM set_a_960
INTERSECT
SELECT v FROM set_b_960
ORDER BY v;
----
25
35

query I
SELECT v FROM set_a_960
EXCEPT
SELECT v FROM set_b_960
ORDER BY v;
----
15

statement ok
CREATE PROCEDURE sp_page_set_960 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_960
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_960 1, 2;
----
2 25
3 35

statement ok
DROP TABLE set_b_960;

statement ok
DROP TABLE set_a_960;
