# test/slt_proc/cte_subquery_join/2778_cte_union_subquery_exists_088.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (88)

statement ok
CREATE TABLE cj_emp_2778 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2778 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2778 VALUES (10, 'ENG_88'), (20, 'SALES_88'), (30, 'HR_88');

statement ok
INSERT INTO cj_emp_2778 VALUES
(1, 10, 264),
(2, 10, 528),
(3, 20, 792),
(4, 30, 1056);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2778
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2778 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_88 792
20 SALES_88 792
30 HR_88 1056

query II
SELECT id, salary
FROM cj_emp_2778
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2778 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2778 WHERE dept_id = 30
)
ORDER BY id;
----
1 264
2 528
4 1056

statement ok
DROP TABLE cj_emp_2778;

statement ok
DROP TABLE cj_dept_2778;
