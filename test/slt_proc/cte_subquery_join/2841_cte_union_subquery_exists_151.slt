# test/slt_proc/cte_subquery_join/2841_cte_union_subquery_exists_151.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (151)

statement ok
CREATE TABLE cj_emp_2841 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2841 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2841 VALUES (10, 'ENG_151'), (20, 'SALES_151'), (30, 'HR_151');

statement ok
INSERT INTO cj_emp_2841 VALUES
(1, 10, 453),
(2, 10, 906),
(3, 20, 1359),
(4, 30, 1812);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2841
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2841 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_151 1359
20 SALES_151 1359
30 HR_151 1812

query II
SELECT id, salary
FROM cj_emp_2841
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2841 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2841 WHERE dept_id = 30
)
ORDER BY id;
----
1 453
2 906
4 1812

statement ok
DROP TABLE cj_emp_2841;

statement ok
DROP TABLE cj_dept_2841;
