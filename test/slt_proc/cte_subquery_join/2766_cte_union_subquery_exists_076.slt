# test/slt_proc/cte_subquery_join/2766_cte_union_subquery_exists_076.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (76)

statement ok
CREATE TABLE cj_emp_2766 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2766 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2766 VALUES (10, 'ENG_76'), (20, 'SALES_76'), (30, 'HR_76');

statement ok
INSERT INTO cj_emp_2766 VALUES
(1, 10, 228),
(2, 10, 456),
(3, 20, 684),
(4, 30, 912);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2766
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2766 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_76 684
20 SALES_76 684
30 HR_76 912

query II
SELECT id, salary
FROM cj_emp_2766
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2766 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2766 WHERE dept_id = 30
)
ORDER BY id;
----
1 228
2 456
4 912

statement ok
DROP TABLE cj_emp_2766;

statement ok
DROP TABLE cj_dept_2766;
