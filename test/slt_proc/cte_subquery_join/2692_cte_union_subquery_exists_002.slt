# test/slt_proc/cte_subquery_join/2692_cte_union_subquery_exists_002.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (2)

statement ok
CREATE TABLE cj_emp_2692 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2692 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2692 VALUES (10, 'ENG_2'), (20, 'SALES_2'), (30, 'HR_2');

statement ok
INSERT INTO cj_emp_2692 VALUES
(1, 10, 6),
(2, 10, 12),
(3, 20, 18),
(4, 30, 24);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2692
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2692 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_2 18
20 SALES_2 18
30 HR_2 24

query II
SELECT id, salary
FROM cj_emp_2692
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2692 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2692 WHERE dept_id = 30
)
ORDER BY id;
----
1 6
2 12
4 24

statement ok
DROP TABLE cj_emp_2692;

statement ok
DROP TABLE cj_dept_2692;
