# test/slt_proc/cte_subquery_join/2780_cte_union_subquery_exists_090.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (90)

statement ok
CREATE TABLE cj_emp_2780 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2780 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2780 VALUES (10, 'ENG_90'), (20, 'SALES_90'), (30, 'HR_90');

statement ok
INSERT INTO cj_emp_2780 VALUES
(1, 10, 270),
(2, 10, 540),
(3, 20, 810),
(4, 30, 1080);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2780
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2780 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_90 810
20 SALES_90 810
30 HR_90 1080

query II
SELECT id, salary
FROM cj_emp_2780
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2780 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2780 WHERE dept_id = 30
)
ORDER BY id;
----
1 270
2 540
4 1080

statement ok
DROP TABLE cj_emp_2780;

statement ok
DROP TABLE cj_dept_2780;
