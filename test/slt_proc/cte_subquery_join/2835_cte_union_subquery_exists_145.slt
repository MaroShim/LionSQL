# test/slt_proc/cte_subquery_join/2835_cte_union_subquery_exists_145.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (145)

statement ok
CREATE TABLE cj_emp_2835 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2835 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2835 VALUES (10, 'ENG_145'), (20, 'SALES_145'), (30, 'HR_145');

statement ok
INSERT INTO cj_emp_2835 VALUES
(1, 10, 435),
(2, 10, 870),
(3, 20, 1305),
(4, 30, 1740);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2835
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2835 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_145 1305
20 SALES_145 1305
30 HR_145 1740

query II
SELECT id, salary
FROM cj_emp_2835
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2835 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2835 WHERE dept_id = 30
)
ORDER BY id;
----
1 435
2 870
4 1740

statement ok
DROP TABLE cj_emp_2835;

statement ok
DROP TABLE cj_dept_2835;
