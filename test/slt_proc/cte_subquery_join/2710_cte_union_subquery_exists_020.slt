# test/slt_proc/cte_subquery_join/2710_cte_union_subquery_exists_020.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (20)

statement ok
CREATE TABLE cj_emp_2710 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2710 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2710 VALUES (10, 'ENG_20'), (20, 'SALES_20'), (30, 'HR_20');

statement ok
INSERT INTO cj_emp_2710 VALUES
(1, 10, 60),
(2, 10, 120),
(3, 20, 180),
(4, 30, 240);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2710
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2710 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_20 180
20 SALES_20 180
30 HR_20 240

query II
SELECT id, salary
FROM cj_emp_2710
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2710 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2710 WHERE dept_id = 30
)
ORDER BY id;
----
1 60
2 120
4 240

statement ok
DROP TABLE cj_emp_2710;

statement ok
DROP TABLE cj_dept_2710;
