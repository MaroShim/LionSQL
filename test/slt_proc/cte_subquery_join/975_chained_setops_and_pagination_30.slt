# test/slt_proc/cte_subquery_join/975_chained_setops_and_pagination_30.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (30)

query I
SELECT 30 AS v
UNION ALL
SELECT 40 AS v
UNION ALL
SELECT 50 AS v
UNION ALL
SELECT 60 AS v
ORDER BY v;
----
30
40
50
60

statement ok
CREATE TABLE set_a_975 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_975 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_975 VALUES (1, 30), (2, 40), (3, 50);

statement ok
INSERT INTO set_b_975 VALUES (1, 40), (2, 50), (3, 60);

query I
SELECT v FROM set_a_975
INTERSECT
SELECT v FROM set_b_975
ORDER BY v;
----
40
50

query I
SELECT v FROM set_a_975
EXCEPT
SELECT v FROM set_b_975
ORDER BY v;
----
30

statement ok
CREATE PROCEDURE sp_page_set_975 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_975
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_975 1, 2;
----
2 40
3 50

statement ok
DROP TABLE set_b_975;

statement ok
DROP TABLE set_a_975;
