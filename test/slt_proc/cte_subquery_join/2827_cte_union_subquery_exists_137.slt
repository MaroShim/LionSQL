# test/slt_proc/cte_subquery_join/2827_cte_union_subquery_exists_137.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (137)

statement ok
CREATE TABLE cj_emp_2827 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2827 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2827 VALUES (10, 'ENG_137'), (20, 'SALES_137'), (30, 'HR_137');

statement ok
INSERT INTO cj_emp_2827 VALUES
(1, 10, 411),
(2, 10, 822),
(3, 20, 1233),
(4, 30, 1644);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2827
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2827 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_137 1233
20 SALES_137 1233
30 HR_137 1644

query II
SELECT id, salary
FROM cj_emp_2827
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2827 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2827 WHERE dept_id = 30
)
ORDER BY id;
----
1 411
2 822
4 1644

statement ok
DROP TABLE cj_emp_2827;

statement ok
DROP TABLE cj_dept_2827;
