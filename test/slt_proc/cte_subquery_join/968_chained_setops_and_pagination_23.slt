# test/slt_proc/cte_subquery_join/968_chained_setops_and_pagination_23.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (23)

query I
SELECT 23 AS v
UNION ALL
SELECT 33 AS v
UNION ALL
SELECT 43 AS v
UNION ALL
SELECT 53 AS v
ORDER BY v;
----
23
33
43
53

statement ok
CREATE TABLE set_a_968 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_968 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_968 VALUES (1, 23), (2, 33), (3, 43);

statement ok
INSERT INTO set_b_968 VALUES (1, 33), (2, 43), (3, 53);

query I
SELECT v FROM set_a_968
INTERSECT
SELECT v FROM set_b_968
ORDER BY v;
----
33
43

query I
SELECT v FROM set_a_968
EXCEPT
SELECT v FROM set_b_968
ORDER BY v;
----
23

statement ok
CREATE PROCEDURE sp_page_set_968 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_968
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_968 1, 2;
----
2 33
3 43

statement ok
DROP TABLE set_b_968;

statement ok
DROP TABLE set_a_968;
