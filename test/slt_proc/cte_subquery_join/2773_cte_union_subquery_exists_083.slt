# test/slt_proc/cte_subquery_join/2773_cte_union_subquery_exists_083.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (83)

statement ok
CREATE TABLE cj_emp_2773 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2773 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2773 VALUES (10, 'ENG_83'), (20, 'SALES_83'), (30, 'HR_83');

statement ok
INSERT INTO cj_emp_2773 VALUES
(1, 10, 249),
(2, 10, 498),
(3, 20, 747),
(4, 30, 996);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2773
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2773 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_83 747
20 SALES_83 747
30 HR_83 996

query II
SELECT id, salary
FROM cj_emp_2773
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2773 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2773 WHERE dept_id = 30
)
ORDER BY id;
----
1 249
2 498
4 996

statement ok
DROP TABLE cj_emp_2773;

statement ok
DROP TABLE cj_dept_2773;
