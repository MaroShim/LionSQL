# test/slt_proc/cte_subquery_join/2756_cte_union_subquery_exists_066.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (66)

statement ok
CREATE TABLE cj_emp_2756 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2756 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2756 VALUES (10, 'ENG_66'), (20, 'SALES_66'), (30, 'HR_66');

statement ok
INSERT INTO cj_emp_2756 VALUES
(1, 10, 198),
(2, 10, 396),
(3, 20, 594),
(4, 30, 792);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2756
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2756 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_66 594
20 SALES_66 594
30 HR_66 792

query II
SELECT id, salary
FROM cj_emp_2756
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2756 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2756 WHERE dept_id = 30
)
ORDER BY id;
----
1 198
2 396
4 792

statement ok
DROP TABLE cj_emp_2756;

statement ok
DROP TABLE cj_dept_2756;
