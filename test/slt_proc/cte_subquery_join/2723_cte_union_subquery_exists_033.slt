# test/slt_proc/cte_subquery_join/2723_cte_union_subquery_exists_033.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (33)

statement ok
CREATE TABLE cj_emp_2723 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2723 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2723 VALUES (10, 'ENG_33'), (20, 'SALES_33'), (30, 'HR_33');

statement ok
INSERT INTO cj_emp_2723 VALUES
(1, 10, 99),
(2, 10, 198),
(3, 20, 297),
(4, 30, 396);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2723
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2723 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_33 297
20 SALES_33 297
30 HR_33 396

query II
SELECT id, salary
FROM cj_emp_2723
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2723 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2723 WHERE dept_id = 30
)
ORDER BY id;
----
1 99
2 198
4 396

statement ok
DROP TABLE cj_emp_2723;

statement ok
DROP TABLE cj_dept_2723;
