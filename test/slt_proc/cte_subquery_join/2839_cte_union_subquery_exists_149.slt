# test/slt_proc/cte_subquery_join/2839_cte_union_subquery_exists_149.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (149)

statement ok
CREATE TABLE cj_emp_2839 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2839 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2839 VALUES (10, 'ENG_149'), (20, 'SALES_149'), (30, 'HR_149');

statement ok
INSERT INTO cj_emp_2839 VALUES
(1, 10, 447),
(2, 10, 894),
(3, 20, 1341),
(4, 30, 1788);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2839
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2839 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_149 1341
20 SALES_149 1341
30 HR_149 1788

query II
SELECT id, salary
FROM cj_emp_2839
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2839 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2839 WHERE dept_id = 30
)
ORDER BY id;
----
1 447
2 894
4 1788

statement ok
DROP TABLE cj_emp_2839;

statement ok
DROP TABLE cj_dept_2839;
