# test/slt_proc/cte_subquery_join/2814_cte_union_subquery_exists_124.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (124)

statement ok
CREATE TABLE cj_emp_2814 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2814 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2814 VALUES (10, 'ENG_124'), (20, 'SALES_124'), (30, 'HR_124');

statement ok
INSERT INTO cj_emp_2814 VALUES
(1, 10, 372),
(2, 10, 744),
(3, 20, 1116),
(4, 30, 1488);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2814
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2814 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_124 1116
20 SALES_124 1116
30 HR_124 1488

query II
SELECT id, salary
FROM cj_emp_2814
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2814 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2814 WHERE dept_id = 30
)
ORDER BY id;
----
1 372
2 744
4 1488

statement ok
DROP TABLE cj_emp_2814;

statement ok
DROP TABLE cj_dept_2814;
