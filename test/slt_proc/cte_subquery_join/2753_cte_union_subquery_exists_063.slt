# test/slt_proc/cte_subquery_join/2753_cte_union_subquery_exists_063.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (63)

statement ok
CREATE TABLE cj_emp_2753 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2753 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2753 VALUES (10, 'ENG_63'), (20, 'SALES_63'), (30, 'HR_63');

statement ok
INSERT INTO cj_emp_2753 VALUES
(1, 10, 189),
(2, 10, 378),
(3, 20, 567),
(4, 30, 756);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2753
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2753 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_63 567
20 SALES_63 567
30 HR_63 756

query II
SELECT id, salary
FROM cj_emp_2753
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2753 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2753 WHERE dept_id = 30
)
ORDER BY id;
----
1 189
2 378
4 756

statement ok
DROP TABLE cj_emp_2753;

statement ok
DROP TABLE cj_dept_2753;
