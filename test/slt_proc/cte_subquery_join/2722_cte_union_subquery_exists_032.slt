# test/slt_proc/cte_subquery_join/2722_cte_union_subquery_exists_032.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (32)

statement ok
CREATE TABLE cj_emp_2722 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2722 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2722 VALUES (10, 'ENG_32'), (20, 'SALES_32'), (30, 'HR_32');

statement ok
INSERT INTO cj_emp_2722 VALUES
(1, 10, 96),
(2, 10, 192),
(3, 20, 288),
(4, 30, 384);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2722
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2722 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_32 288
20 SALES_32 288
30 HR_32 384

query II
SELECT id, salary
FROM cj_emp_2722
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2722 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2722 WHERE dept_id = 30
)
ORDER BY id;
----
1 96
2 192
4 384

statement ok
DROP TABLE cj_emp_2722;

statement ok
DROP TABLE cj_dept_2722;
