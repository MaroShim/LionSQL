# test/slt_proc/cte_subquery_join/2825_cte_union_subquery_exists_135.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (135)

statement ok
CREATE TABLE cj_emp_2825 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2825 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2825 VALUES (10, 'ENG_135'), (20, 'SALES_135'), (30, 'HR_135');

statement ok
INSERT INTO cj_emp_2825 VALUES
(1, 10, 405),
(2, 10, 810),
(3, 20, 1215),
(4, 30, 1620);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2825
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2825 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_135 1215
20 SALES_135 1215
30 HR_135 1620

query II
SELECT id, salary
FROM cj_emp_2825
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2825 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2825 WHERE dept_id = 30
)
ORDER BY id;
----
1 405
2 810
4 1620

statement ok
DROP TABLE cj_emp_2825;

statement ok
DROP TABLE cj_dept_2825;
