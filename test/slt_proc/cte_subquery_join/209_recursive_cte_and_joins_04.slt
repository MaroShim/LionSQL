# test/slt_proc/cte_subquery_join/209_recursive_cte_and_joins_04.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (4)

query I
WITH seq(n) AS (
    SELECT 6
    UNION ALL
    SELECT n + 6 FROM seq WHERE n < 24
)
SELECT n FROM seq ORDER BY n;
----
6
12
18
24

statement ok
CREATE TABLE c_cust_209 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_209 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_209 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_209 VALUES (101, 1, 40), (102, 1, 80), (103, 2, 120);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_209 c
INNER JOIN c_ord_209 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 120
2 Bob 120

query IT
SELECT cid, cname FROM c_cust_209 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_209 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_209;

statement ok
DROP TABLE c_cust_209;
