# test/slt_proc/cte_subquery_join/2815_cte_union_subquery_exists_125.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (125)

statement ok
CREATE TABLE cj_emp_2815 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2815 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2815 VALUES (10, 'ENG_125'), (20, 'SALES_125'), (30, 'HR_125');

statement ok
INSERT INTO cj_emp_2815 VALUES
(1, 10, 375),
(2, 10, 750),
(3, 20, 1125),
(4, 30, 1500);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2815
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2815 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_125 1125
20 SALES_125 1125
30 HR_125 1500

query II
SELECT id, salary
FROM cj_emp_2815
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2815 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2815 WHERE dept_id = 30
)
ORDER BY id;
----
1 375
2 750
4 1500

statement ok
DROP TABLE cj_emp_2815;

statement ok
DROP TABLE cj_dept_2815;
