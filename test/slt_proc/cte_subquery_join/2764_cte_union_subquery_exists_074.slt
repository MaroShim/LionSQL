# test/slt_proc/cte_subquery_join/2764_cte_union_subquery_exists_074.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (74)

statement ok
CREATE TABLE cj_emp_2764 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2764 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2764 VALUES (10, 'ENG_74'), (20, 'SALES_74'), (30, 'HR_74');

statement ok
INSERT INTO cj_emp_2764 VALUES
(1, 10, 222),
(2, 10, 444),
(3, 20, 666),
(4, 30, 888);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2764
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2764 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_74 666
20 SALES_74 666
30 HR_74 888

query II
SELECT id, salary
FROM cj_emp_2764
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2764 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2764 WHERE dept_id = 30
)
ORDER BY id;
----
1 222
2 444
4 888

statement ok
DROP TABLE cj_emp_2764;

statement ok
DROP TABLE cj_dept_2764;
