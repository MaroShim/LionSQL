# test/slt_proc/cte_subquery_join/2837_cte_union_subquery_exists_147.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (147)

statement ok
CREATE TABLE cj_emp_2837 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2837 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2837 VALUES (10, 'ENG_147'), (20, 'SALES_147'), (30, 'HR_147');

statement ok
INSERT INTO cj_emp_2837 VALUES
(1, 10, 441),
(2, 10, 882),
(3, 20, 1323),
(4, 30, 1764);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2837
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2837 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_147 1323
20 SALES_147 1323
30 HR_147 1764

query II
SELECT id, salary
FROM cj_emp_2837
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2837 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2837 WHERE dept_id = 30
)
ORDER BY id;
----
1 441
2 882
4 1764

statement ok
DROP TABLE cj_emp_2837;

statement ok
DROP TABLE cj_dept_2837;
