# test/slt_proc/cte_subquery_join/2791_cte_union_subquery_exists_101.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (101)

statement ok
CREATE TABLE cj_emp_2791 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2791 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2791 VALUES (10, 'ENG_101'), (20, 'SALES_101'), (30, 'HR_101');

statement ok
INSERT INTO cj_emp_2791 VALUES
(1, 10, 303),
(2, 10, 606),
(3, 20, 909),
(4, 30, 1212);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2791
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2791 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_101 909
20 SALES_101 909
30 HR_101 1212

query II
SELECT id, salary
FROM cj_emp_2791
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2791 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2791 WHERE dept_id = 30
)
ORDER BY id;
----
1 303
2 606
4 1212

statement ok
DROP TABLE cj_emp_2791;

statement ok
DROP TABLE cj_dept_2791;
