# test/slt_proc/cte_subquery_join/2758_cte_union_subquery_exists_068.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (68)

statement ok
CREATE TABLE cj_emp_2758 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2758 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2758 VALUES (10, 'ENG_68'), (20, 'SALES_68'), (30, 'HR_68');

statement ok
INSERT INTO cj_emp_2758 VALUES
(1, 10, 204),
(2, 10, 408),
(3, 20, 612),
(4, 30, 816);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2758
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2758 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_68 612
20 SALES_68 612
30 HR_68 816

query II
SELECT id, salary
FROM cj_emp_2758
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2758 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2758 WHERE dept_id = 30
)
ORDER BY id;
----
1 204
2 408
4 816

statement ok
DROP TABLE cj_emp_2758;

statement ok
DROP TABLE cj_dept_2758;
