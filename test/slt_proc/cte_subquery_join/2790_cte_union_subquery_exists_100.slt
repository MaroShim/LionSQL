# test/slt_proc/cte_subquery_join/2790_cte_union_subquery_exists_100.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (100)

statement ok
CREATE TABLE cj_emp_2790 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2790 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2790 VALUES (10, 'ENG_100'), (20, 'SALES_100'), (30, 'HR_100');

statement ok
INSERT INTO cj_emp_2790 VALUES
(1, 10, 300),
(2, 10, 600),
(3, 20, 900),
(4, 30, 1200);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2790
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2790 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_100 900
20 SALES_100 900
30 HR_100 1200

query II
SELECT id, salary
FROM cj_emp_2790
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2790 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2790 WHERE dept_id = 30
)
ORDER BY id;
----
1 300
2 600
4 1200

statement ok
DROP TABLE cj_emp_2790;

statement ok
DROP TABLE cj_dept_2790;
