# test/slt_proc/cte_subquery_join/2742_cte_union_subquery_exists_052.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (52)

statement ok
CREATE TABLE cj_emp_2742 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2742 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2742 VALUES (10, 'ENG_52'), (20, 'SALES_52'), (30, 'HR_52');

statement ok
INSERT INTO cj_emp_2742 VALUES
(1, 10, 156),
(2, 10, 312),
(3, 20, 468),
(4, 30, 624);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2742
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2742 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_52 468
20 SALES_52 468
30 HR_52 624

query II
SELECT id, salary
FROM cj_emp_2742
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2742 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2742 WHERE dept_id = 30
)
ORDER BY id;
----
1 156
2 312
4 624

statement ok
DROP TABLE cj_emp_2742;

statement ok
DROP TABLE cj_dept_2742;
