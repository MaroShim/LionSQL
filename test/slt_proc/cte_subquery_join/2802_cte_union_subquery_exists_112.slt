# test/slt_proc/cte_subquery_join/2802_cte_union_subquery_exists_112.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (112)

statement ok
CREATE TABLE cj_emp_2802 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2802 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2802 VALUES (10, 'ENG_112'), (20, 'SALES_112'), (30, 'HR_112');

statement ok
INSERT INTO cj_emp_2802 VALUES
(1, 10, 336),
(2, 10, 672),
(3, 20, 1008),
(4, 30, 1344);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2802
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2802 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_112 1008
20 SALES_112 1008
30 HR_112 1344

query II
SELECT id, salary
FROM cj_emp_2802
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2802 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2802 WHERE dept_id = 30
)
ORDER BY id;
----
1 336
2 672
4 1344

statement ok
DROP TABLE cj_emp_2802;

statement ok
DROP TABLE cj_dept_2802;
