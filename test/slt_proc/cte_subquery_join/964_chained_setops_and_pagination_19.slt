# test/slt_proc/cte_subquery_join/964_chained_setops_and_pagination_19.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (19)

query I
SELECT 19 AS v
UNION ALL
SELECT 29 AS v
UNION ALL
SELECT 39 AS v
UNION ALL
SELECT 49 AS v
ORDER BY v;
----
19
29
39
49

statement ok
CREATE TABLE set_a_964 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_964 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_964 VALUES (1, 19), (2, 29), (3, 39);

statement ok
INSERT INTO set_b_964 VALUES (1, 29), (2, 39), (3, 49);

query I
SELECT v FROM set_a_964
INTERSECT
SELECT v FROM set_b_964
ORDER BY v;
----
29
39

query I
SELECT v FROM set_a_964
EXCEPT
SELECT v FROM set_b_964
ORDER BY v;
----
19

statement ok
CREATE PROCEDURE sp_page_set_964 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_964
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_964 1, 2;
----
2 29
3 39

statement ok
DROP TABLE set_b_964;

statement ok
DROP TABLE set_a_964;
