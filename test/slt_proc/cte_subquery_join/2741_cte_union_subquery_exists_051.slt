# test/slt_proc/cte_subquery_join/2741_cte_union_subquery_exists_051.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (51)

statement ok
CREATE TABLE cj_emp_2741 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2741 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2741 VALUES (10, 'ENG_51'), (20, 'SALES_51'), (30, 'HR_51');

statement ok
INSERT INTO cj_emp_2741 VALUES
(1, 10, 153),
(2, 10, 306),
(3, 20, 459),
(4, 30, 612);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2741
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2741 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_51 459
20 SALES_51 459
30 HR_51 612

query II
SELECT id, salary
FROM cj_emp_2741
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2741 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2741 WHERE dept_id = 30
)
ORDER BY id;
----
1 153
2 306
4 612

statement ok
DROP TABLE cj_emp_2741;

statement ok
DROP TABLE cj_dept_2741;
