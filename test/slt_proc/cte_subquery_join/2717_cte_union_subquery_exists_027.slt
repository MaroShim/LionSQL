# test/slt_proc/cte_subquery_join/2717_cte_union_subquery_exists_027.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (27)

statement ok
CREATE TABLE cj_emp_2717 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2717 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2717 VALUES (10, 'ENG_27'), (20, 'SALES_27'), (30, 'HR_27');

statement ok
INSERT INTO cj_emp_2717 VALUES
(1, 10, 81),
(2, 10, 162),
(3, 20, 243),
(4, 30, 324);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2717
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2717 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_27 243
20 SALES_27 243
30 HR_27 324

query II
SELECT id, salary
FROM cj_emp_2717
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2717 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2717 WHERE dept_id = 30
)
ORDER BY id;
----
1 81
2 162
4 324

statement ok
DROP TABLE cj_emp_2717;

statement ok
DROP TABLE cj_dept_2717;
