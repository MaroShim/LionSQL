# test/slt_proc/cte_subquery_join/2694_cte_union_subquery_exists_004.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (4)

statement ok
CREATE TABLE cj_emp_2694 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2694 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2694 VALUES (10, 'ENG_4'), (20, 'SALES_4'), (30, 'HR_4');

statement ok
INSERT INTO cj_emp_2694 VALUES
(1, 10, 12),
(2, 10, 24),
(3, 20, 36),
(4, 30, 48);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2694
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2694 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_4 36
20 SALES_4 36
30 HR_4 48

query II
SELECT id, salary
FROM cj_emp_2694
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2694 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2694 WHERE dept_id = 30
)
ORDER BY id;
----
1 12
2 24
4 48

statement ok
DROP TABLE cj_emp_2694;

statement ok
DROP TABLE cj_dept_2694;
