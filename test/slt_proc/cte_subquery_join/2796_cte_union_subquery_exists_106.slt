# test/slt_proc/cte_subquery_join/2796_cte_union_subquery_exists_106.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (106)

statement ok
CREATE TABLE cj_emp_2796 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2796 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2796 VALUES (10, 'ENG_106'), (20, 'SALES_106'), (30, 'HR_106');

statement ok
INSERT INTO cj_emp_2796 VALUES
(1, 10, 318),
(2, 10, 636),
(3, 20, 954),
(4, 30, 1272);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2796
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2796 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_106 954
20 SALES_106 954
30 HR_106 1272

query II
SELECT id, salary
FROM cj_emp_2796
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2796 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2796 WHERE dept_id = 30
)
ORDER BY id;
----
1 318
2 636
4 1272

statement ok
DROP TABLE cj_emp_2796;

statement ok
DROP TABLE cj_dept_2796;
