# test/slt_proc/cte_subquery_join/958_chained_setops_and_pagination_13.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (13)

query I
SELECT 13 AS v
UNION ALL
SELECT 23 AS v
UNION ALL
SELECT 33 AS v
UNION ALL
SELECT 43 AS v
ORDER BY v;
----
13
23
33
43

statement ok
CREATE TABLE set_a_958 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_958 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_958 VALUES (1, 13), (2, 23), (3, 33);

statement ok
INSERT INTO set_b_958 VALUES (1, 23), (2, 33), (3, 43);

query I
SELECT v FROM set_a_958
INTERSECT
SELECT v FROM set_b_958
ORDER BY v;
----
23
33

query I
SELECT v FROM set_a_958
EXCEPT
SELECT v FROM set_b_958
ORDER BY v;
----
13

statement ok
CREATE PROCEDURE sp_page_set_958 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_958
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_958 1, 2;
----
2 23
3 33

statement ok
DROP TABLE set_b_958;

statement ok
DROP TABLE set_a_958;
