# test/slt_proc/cte_subquery_join/2761_cte_union_subquery_exists_071.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (71)

statement ok
CREATE TABLE cj_emp_2761 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2761 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2761 VALUES (10, 'ENG_71'), (20, 'SALES_71'), (30, 'HR_71');

statement ok
INSERT INTO cj_emp_2761 VALUES
(1, 10, 213),
(2, 10, 426),
(3, 20, 639),
(4, 30, 852);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2761
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2761 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_71 639
20 SALES_71 639
30 HR_71 852

query II
SELECT id, salary
FROM cj_emp_2761
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2761 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2761 WHERE dept_id = 30
)
ORDER BY id;
----
1 213
2 426
4 852

statement ok
DROP TABLE cj_emp_2761;

statement ok
DROP TABLE cj_dept_2761;
