# test/slt_proc/cte_subquery_join/213_recursive_cte_and_joins_08.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (8)

query I
WITH seq(n) AS (
    SELECT 5
    UNION ALL
    SELECT n + 5 FROM seq WHERE n < 20
)
SELECT n FROM seq ORDER BY n;
----
5
10
15
20

statement ok
CREATE TABLE c_cust_213 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_213 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_213 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_213 VALUES (101, 1, 80), (102, 1, 160), (103, 2, 240);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_213 c
INNER JOIN c_ord_213 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 240
2 Bob 240

query IT
SELECT cid, cname FROM c_cust_213 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_213 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_213;

statement ok
DROP TABLE c_cust_213;
