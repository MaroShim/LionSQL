# test/slt_proc/cte_subquery_join/2813_cte_union_subquery_exists_123.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (123)

statement ok
CREATE TABLE cj_emp_2813 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2813 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2813 VALUES (10, 'ENG_123'), (20, 'SALES_123'), (30, 'HR_123');

statement ok
INSERT INTO cj_emp_2813 VALUES
(1, 10, 369),
(2, 10, 738),
(3, 20, 1107),
(4, 30, 1476);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2813
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2813 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_123 1107
20 SALES_123 1107
30 HR_123 1476

query II
SELECT id, salary
FROM cj_emp_2813
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2813 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2813 WHERE dept_id = 30
)
ORDER BY id;
----
1 369
2 738
4 1476

statement ok
DROP TABLE cj_emp_2813;

statement ok
DROP TABLE cj_dept_2813;
