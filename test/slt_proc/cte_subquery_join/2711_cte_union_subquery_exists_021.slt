# test/slt_proc/cte_subquery_join/2711_cte_union_subquery_exists_021.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (21)

statement ok
CREATE TABLE cj_emp_2711 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2711 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2711 VALUES (10, 'ENG_21'), (20, 'SALES_21'), (30, 'HR_21');

statement ok
INSERT INTO cj_emp_2711 VALUES
(1, 10, 63),
(2, 10, 126),
(3, 20, 189),
(4, 30, 252);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2711
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2711 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_21 189
20 SALES_21 189
30 HR_21 252

query II
SELECT id, salary
FROM cj_emp_2711
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2711 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2711 WHERE dept_id = 30
)
ORDER BY id;
----
1 63
2 126
4 252

statement ok
DROP TABLE cj_emp_2711;

statement ok
DROP TABLE cj_dept_2711;
