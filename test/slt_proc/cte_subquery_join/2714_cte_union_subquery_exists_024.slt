# test/slt_proc/cte_subquery_join/2714_cte_union_subquery_exists_024.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (24)

statement ok
CREATE TABLE cj_emp_2714 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2714 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2714 VALUES (10, 'ENG_24'), (20, 'SALES_24'), (30, 'HR_24');

statement ok
INSERT INTO cj_emp_2714 VALUES
(1, 10, 72),
(2, 10, 144),
(3, 20, 216),
(4, 30, 288);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2714
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2714 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_24 216
20 SALES_24 216
30 HR_24 288

query II
SELECT id, salary
FROM cj_emp_2714
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2714 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2714 WHERE dept_id = 30
)
ORDER BY id;
----
1 72
2 144
4 288

statement ok
DROP TABLE cj_emp_2714;

statement ok
DROP TABLE cj_dept_2714;
