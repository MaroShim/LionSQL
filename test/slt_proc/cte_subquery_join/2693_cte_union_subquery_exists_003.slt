# test/slt_proc/cte_subquery_join/2693_cte_union_subquery_exists_003.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (3)

statement ok
CREATE TABLE cj_emp_2693 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2693 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2693 VALUES (10, 'ENG_3'), (20, 'SALES_3'), (30, 'HR_3');

statement ok
INSERT INTO cj_emp_2693 VALUES
(1, 10, 9),
(2, 10, 18),
(3, 20, 27),
(4, 30, 36);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2693
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2693 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_3 27
20 SALES_3 27
30 HR_3 36

query II
SELECT id, salary
FROM cj_emp_2693
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2693 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2693 WHERE dept_id = 30
)
ORDER BY id;
----
1 9
2 18
4 36

statement ok
DROP TABLE cj_emp_2693;

statement ok
DROP TABLE cj_dept_2693;
