# test/slt_proc/cte_subquery_join/2776_cte_union_subquery_exists_086.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (86)

statement ok
CREATE TABLE cj_emp_2776 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2776 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2776 VALUES (10, 'ENG_86'), (20, 'SALES_86'), (30, 'HR_86');

statement ok
INSERT INTO cj_emp_2776 VALUES
(1, 10, 258),
(2, 10, 516),
(3, 20, 774),
(4, 30, 1032);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2776
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2776 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_86 774
20 SALES_86 774
30 HR_86 1032

query II
SELECT id, salary
FROM cj_emp_2776
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2776 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2776 WHERE dept_id = 30
)
ORDER BY id;
----
1 258
2 516
4 1032

statement ok
DROP TABLE cj_emp_2776;

statement ok
DROP TABLE cj_dept_2776;
