# test/slt_proc/cte_subquery_join/2821_cte_union_subquery_exists_131.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (131)

statement ok
CREATE TABLE cj_emp_2821 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2821 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2821 VALUES (10, 'ENG_131'), (20, 'SALES_131'), (30, 'HR_131');

statement ok
INSERT INTO cj_emp_2821 VALUES
(1, 10, 393),
(2, 10, 786),
(3, 20, 1179),
(4, 30, 1572);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2821
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2821 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_131 1179
20 SALES_131 1179
30 HR_131 1572

query II
SELECT id, salary
FROM cj_emp_2821
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2821 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2821 WHERE dept_id = 30
)
ORDER BY id;
----
1 393
2 786
4 1572

statement ok
DROP TABLE cj_emp_2821;

statement ok
DROP TABLE cj_dept_2821;
