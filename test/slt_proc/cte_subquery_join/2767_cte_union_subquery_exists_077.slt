# test/slt_proc/cte_subquery_join/2767_cte_union_subquery_exists_077.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (77)

statement ok
CREATE TABLE cj_emp_2767 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2767 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2767 VALUES (10, 'ENG_77'), (20, 'SALES_77'), (30, 'HR_77');

statement ok
INSERT INTO cj_emp_2767 VALUES
(1, 10, 231),
(2, 10, 462),
(3, 20, 693),
(4, 30, 924);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2767
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2767 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_77 693
20 SALES_77 693
30 HR_77 924

query II
SELECT id, salary
FROM cj_emp_2767
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2767 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2767 WHERE dept_id = 30
)
ORDER BY id;
----
1 231
2 462
4 924

statement ok
DROP TABLE cj_emp_2767;

statement ok
DROP TABLE cj_dept_2767;
