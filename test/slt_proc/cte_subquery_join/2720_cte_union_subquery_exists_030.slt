# test/slt_proc/cte_subquery_join/2720_cte_union_subquery_exists_030.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (30)

statement ok
CREATE TABLE cj_emp_2720 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2720 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2720 VALUES (10, 'ENG_30'), (20, 'SALES_30'), (30, 'HR_30');

statement ok
INSERT INTO cj_emp_2720 VALUES
(1, 10, 90),
(2, 10, 180),
(3, 20, 270),
(4, 30, 360);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2720
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2720 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_30 270
20 SALES_30 270
30 HR_30 360

query II
SELECT id, salary
FROM cj_emp_2720
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2720 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2720 WHERE dept_id = 30
)
ORDER BY id;
----
1 90
2 180
4 360

statement ok
DROP TABLE cj_emp_2720;

statement ok
DROP TABLE cj_dept_2720;
