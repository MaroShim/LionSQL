# test/slt_proc/cte_subquery_join/974_chained_setops_and_pagination_29.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (29)

query I
SELECT 29 AS v
UNION ALL
SELECT 39 AS v
UNION ALL
SELECT 49 AS v
UNION ALL
SELECT 59 AS v
ORDER BY v;
----
29
39
49
59

statement ok
CREATE TABLE set_a_974 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_974 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_974 VALUES (1, 29), (2, 39), (3, 49);

statement ok
INSERT INTO set_b_974 VALUES (1, 39), (2, 49), (3, 59);

query I
SELECT v FROM set_a_974
INTERSECT
SELECT v FROM set_b_974
ORDER BY v;
----
39
49

query I
SELECT v FROM set_a_974
EXCEPT
SELECT v FROM set_b_974
ORDER BY v;
----
29

statement ok
CREATE PROCEDURE sp_page_set_974 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_974
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_974 1, 2;
----
2 39
3 49

statement ok
DROP TABLE set_b_974;

statement ok
DROP TABLE set_a_974;
