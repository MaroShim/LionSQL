# test/slt_proc/cte_subquery_join/947_chained_setops_and_pagination_02.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (2)

query I
SELECT 2 AS v
UNION ALL
SELECT 12 AS v
UNION ALL
SELECT 22 AS v
UNION ALL
SELECT 32 AS v
ORDER BY v;
----
2
12
22
32

statement ok
CREATE TABLE set_a_947 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_947 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_947 VALUES (1, 2), (2, 12), (3, 22);

statement ok
INSERT INTO set_b_947 VALUES (1, 12), (2, 22), (3, 32);

query I
SELECT v FROM set_a_947
INTERSECT
SELECT v FROM set_b_947
ORDER BY v;
----
12
22

query I
SELECT v FROM set_a_947
EXCEPT
SELECT v FROM set_b_947
ORDER BY v;
----
2

statement ok
CREATE PROCEDURE sp_page_set_947 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_947
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_947 1, 2;
----
2 12
3 22

statement ok
DROP TABLE set_b_947;

statement ok
DROP TABLE set_a_947;
