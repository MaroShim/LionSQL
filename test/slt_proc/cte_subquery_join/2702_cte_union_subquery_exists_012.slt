# test/slt_proc/cte_subquery_join/2702_cte_union_subquery_exists_012.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (12)

statement ok
CREATE TABLE cj_emp_2702 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2702 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2702 VALUES (10, 'ENG_12'), (20, 'SALES_12'), (30, 'HR_12');

statement ok
INSERT INTO cj_emp_2702 VALUES
(1, 10, 36),
(2, 10, 72),
(3, 20, 108),
(4, 30, 144);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2702
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2702 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_12 108
20 SALES_12 108
30 HR_12 144

query II
SELECT id, salary
FROM cj_emp_2702
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2702 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2702 WHERE dept_id = 30
)
ORDER BY id;
----
1 36
2 72
4 144

statement ok
DROP TABLE cj_emp_2702;

statement ok
DROP TABLE cj_dept_2702;
