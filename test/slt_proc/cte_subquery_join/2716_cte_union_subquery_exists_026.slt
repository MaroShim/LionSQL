# test/slt_proc/cte_subquery_join/2716_cte_union_subquery_exists_026.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (26)

statement ok
CREATE TABLE cj_emp_2716 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2716 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2716 VALUES (10, 'ENG_26'), (20, 'SALES_26'), (30, 'HR_26');

statement ok
INSERT INTO cj_emp_2716 VALUES
(1, 10, 78),
(2, 10, 156),
(3, 20, 234),
(4, 30, 312);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2716
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2716 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_26 234
20 SALES_26 234
30 HR_26 312

query II
SELECT id, salary
FROM cj_emp_2716
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2716 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2716 WHERE dept_id = 30
)
ORDER BY id;
----
1 78
2 156
4 312

statement ok
DROP TABLE cj_emp_2716;

statement ok
DROP TABLE cj_dept_2716;
