# test/slt_proc/cte_subquery_join/2703_cte_union_subquery_exists_013.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (13)

statement ok
CREATE TABLE cj_emp_2703 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2703 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2703 VALUES (10, 'ENG_13'), (20, 'SALES_13'), (30, 'HR_13');

statement ok
INSERT INTO cj_emp_2703 VALUES
(1, 10, 39),
(2, 10, 78),
(3, 20, 117),
(4, 30, 156);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2703
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2703 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_13 117
20 SALES_13 117
30 HR_13 156

query II
SELECT id, salary
FROM cj_emp_2703
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2703 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2703 WHERE dept_id = 30
)
ORDER BY id;
----
1 39
2 78
4 156

statement ok
DROP TABLE cj_emp_2703;

statement ok
DROP TABLE cj_dept_2703;
