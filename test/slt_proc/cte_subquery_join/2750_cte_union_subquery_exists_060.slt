# test/slt_proc/cte_subquery_join/2750_cte_union_subquery_exists_060.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (60)

statement ok
CREATE TABLE cj_emp_2750 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2750 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2750 VALUES (10, 'ENG_60'), (20, 'SALES_60'), (30, 'HR_60');

statement ok
INSERT INTO cj_emp_2750 VALUES
(1, 10, 180),
(2, 10, 360),
(3, 20, 540),
(4, 30, 720);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2750
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2750 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_60 540
20 SALES_60 540
30 HR_60 720

query II
SELECT id, salary
FROM cj_emp_2750
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2750 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2750 WHERE dept_id = 30
)
ORDER BY id;
----
1 180
2 360
4 720

statement ok
DROP TABLE cj_emp_2750;

statement ok
DROP TABLE cj_dept_2750;
