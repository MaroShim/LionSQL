# test/slt_proc/cte_subquery_join/2788_cte_union_subquery_exists_098.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (98)

statement ok
CREATE TABLE cj_emp_2788 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2788 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2788 VALUES (10, 'ENG_98'), (20, 'SALES_98'), (30, 'HR_98');

statement ok
INSERT INTO cj_emp_2788 VALUES
(1, 10, 294),
(2, 10, 588),
(3, 20, 882),
(4, 30, 1176);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2788
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2788 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_98 882
20 SALES_98 882
30 HR_98 1176

query II
SELECT id, salary
FROM cj_emp_2788
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2788 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2788 WHERE dept_id = 30
)
ORDER BY id;
----
1 294
2 588
4 1176

statement ok
DROP TABLE cj_emp_2788;

statement ok
DROP TABLE cj_dept_2788;
