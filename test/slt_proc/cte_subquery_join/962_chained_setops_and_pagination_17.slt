# test/slt_proc/cte_subquery_join/962_chained_setops_and_pagination_17.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (17)

query I
SELECT 17 AS v
UNION ALL
SELECT 27 AS v
UNION ALL
SELECT 37 AS v
UNION ALL
SELECT 47 AS v
ORDER BY v;
----
17
27
37
47

statement ok
CREATE TABLE set_a_962 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_962 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_962 VALUES (1, 17), (2, 27), (3, 37);

statement ok
INSERT INTO set_b_962 VALUES (1, 27), (2, 37), (3, 47);

query I
SELECT v FROM set_a_962
INTERSECT
SELECT v FROM set_b_962
ORDER BY v;
----
27
37

query I
SELECT v FROM set_a_962
EXCEPT
SELECT v FROM set_b_962
ORDER BY v;
----
17

statement ok
CREATE PROCEDURE sp_page_set_962 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_962
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_962 1, 2;
----
2 27
3 37

statement ok
DROP TABLE set_b_962;

statement ok
DROP TABLE set_a_962;
