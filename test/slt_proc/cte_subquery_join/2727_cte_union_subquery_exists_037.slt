# test/slt_proc/cte_subquery_join/2727_cte_union_subquery_exists_037.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (37)

statement ok
CREATE TABLE cj_emp_2727 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2727 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2727 VALUES (10, 'ENG_37'), (20, 'SALES_37'), (30, 'HR_37');

statement ok
INSERT INTO cj_emp_2727 VALUES
(1, 10, 111),
(2, 10, 222),
(3, 20, 333),
(4, 30, 444);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2727
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2727 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_37 333
20 SALES_37 333
30 HR_37 444

query II
SELECT id, salary
FROM cj_emp_2727
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2727 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2727 WHERE dept_id = 30
)
ORDER BY id;
----
1 111
2 222
4 444

statement ok
DROP TABLE cj_emp_2727;

statement ok
DROP TABLE cj_dept_2727;
