# test/slt_proc/cte_subquery_join/2830_cte_union_subquery_exists_140.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (140)

statement ok
CREATE TABLE cj_emp_2830 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2830 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2830 VALUES (10, 'ENG_140'), (20, 'SALES_140'), (30, 'HR_140');

statement ok
INSERT INTO cj_emp_2830 VALUES
(1, 10, 420),
(2, 10, 840),
(3, 20, 1260),
(4, 30, 1680);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2830
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2830 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_140 1260
20 SALES_140 1260
30 HR_140 1680

query II
SELECT id, salary
FROM cj_emp_2830
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2830 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2830 WHERE dept_id = 30
)
ORDER BY id;
----
1 420
2 840
4 1680

statement ok
DROP TABLE cj_emp_2830;

statement ok
DROP TABLE cj_dept_2830;
