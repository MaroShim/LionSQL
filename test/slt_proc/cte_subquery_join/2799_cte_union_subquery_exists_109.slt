# test/slt_proc/cte_subquery_join/2799_cte_union_subquery_exists_109.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (109)

statement ok
CREATE TABLE cj_emp_2799 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2799 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2799 VALUES (10, 'ENG_109'), (20, 'SALES_109'), (30, 'HR_109');

statement ok
INSERT INTO cj_emp_2799 VALUES
(1, 10, 327),
(2, 10, 654),
(3, 20, 981),
(4, 30, 1308);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2799
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2799 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_109 981
20 SALES_109 981
30 HR_109 1308

query II
SELECT id, salary
FROM cj_emp_2799
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2799 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2799 WHERE dept_id = 30
)
ORDER BY id;
----
1 327
2 654
4 1308

statement ok
DROP TABLE cj_emp_2799;

statement ok
DROP TABLE cj_dept_2799;
