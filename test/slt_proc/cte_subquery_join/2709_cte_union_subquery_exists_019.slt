# test/slt_proc/cte_subquery_join/2709_cte_union_subquery_exists_019.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (19)

statement ok
CREATE TABLE cj_emp_2709 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2709 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2709 VALUES (10, 'ENG_19'), (20, 'SALES_19'), (30, 'HR_19');

statement ok
INSERT INTO cj_emp_2709 VALUES
(1, 10, 57),
(2, 10, 114),
(3, 20, 171),
(4, 30, 228);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2709
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2709 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_19 171
20 SALES_19 171
30 HR_19 228

query II
SELECT id, salary
FROM cj_emp_2709
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2709 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2709 WHERE dept_id = 30
)
ORDER BY id;
----
1 57
2 114
4 228

statement ok
DROP TABLE cj_emp_2709;

statement ok
DROP TABLE cj_dept_2709;
