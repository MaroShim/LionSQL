# test/slt_proc/cte_subquery_join/948_chained_setops_and_pagination_03.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (3)

query I
SELECT 3 AS v
UNION ALL
SELECT 13 AS v
UNION ALL
SELECT 23 AS v
UNION ALL
SELECT 33 AS v
ORDER BY v;
----
3
13
23
33

statement ok
CREATE TABLE set_a_948 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_948 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_948 VALUES (1, 3), (2, 13), (3, 23);

statement ok
INSERT INTO set_b_948 VALUES (1, 13), (2, 23), (3, 33);

query I
SELECT v FROM set_a_948
INTERSECT
SELECT v FROM set_b_948
ORDER BY v;
----
13
23

query I
SELECT v FROM set_a_948
EXCEPT
SELECT v FROM set_b_948
ORDER BY v;
----
3

statement ok
CREATE PROCEDURE sp_page_set_948 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_948
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_948 1, 2;
----
2 13
3 23

statement ok
DROP TABLE set_b_948;

statement ok
DROP TABLE set_a_948;
