# test/slt_proc/cte_subquery_join/2746_cte_union_subquery_exists_056.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (56)

statement ok
CREATE TABLE cj_emp_2746 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2746 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2746 VALUES (10, 'ENG_56'), (20, 'SALES_56'), (30, 'HR_56');

statement ok
INSERT INTO cj_emp_2746 VALUES
(1, 10, 168),
(2, 10, 336),
(3, 20, 504),
(4, 30, 672);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2746
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2746 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_56 504
20 SALES_56 504
30 HR_56 672

query II
SELECT id, salary
FROM cj_emp_2746
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2746 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2746 WHERE dept_id = 30
)
ORDER BY id;
----
1 168
2 336
4 672

statement ok
DROP TABLE cj_emp_2746;

statement ok
DROP TABLE cj_dept_2746;
