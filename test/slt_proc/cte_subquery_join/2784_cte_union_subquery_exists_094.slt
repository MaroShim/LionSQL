# test/slt_proc/cte_subquery_join/2784_cte_union_subquery_exists_094.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (94)

statement ok
CREATE TABLE cj_emp_2784 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2784 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2784 VALUES (10, 'ENG_94'), (20, 'SALES_94'), (30, 'HR_94');

statement ok
INSERT INTO cj_emp_2784 VALUES
(1, 10, 282),
(2, 10, 564),
(3, 20, 846),
(4, 30, 1128);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2784
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2784 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_94 846
20 SALES_94 846
30 HR_94 1128

query II
SELECT id, salary
FROM cj_emp_2784
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2784 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2784 WHERE dept_id = 30
)
ORDER BY id;
----
1 282
2 564
4 1128

statement ok
DROP TABLE cj_emp_2784;

statement ok
DROP TABLE cj_dept_2784;
