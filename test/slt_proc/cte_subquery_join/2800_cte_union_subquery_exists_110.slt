# test/slt_proc/cte_subquery_join/2800_cte_union_subquery_exists_110.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (110)

statement ok
CREATE TABLE cj_emp_2800 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2800 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2800 VALUES (10, 'ENG_110'), (20, 'SALES_110'), (30, 'HR_110');

statement ok
INSERT INTO cj_emp_2800 VALUES
(1, 10, 330),
(2, 10, 660),
(3, 20, 990),
(4, 30, 1320);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2800
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2800 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_110 990
20 SALES_110 990
30 HR_110 1320

query II
SELECT id, salary
FROM cj_emp_2800
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2800 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2800 WHERE dept_id = 30
)
ORDER BY id;
----
1 330
2 660
4 1320

statement ok
DROP TABLE cj_emp_2800;

statement ok
DROP TABLE cj_dept_2800;
