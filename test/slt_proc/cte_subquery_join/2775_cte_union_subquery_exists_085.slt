# test/slt_proc/cte_subquery_join/2775_cte_union_subquery_exists_085.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (85)

statement ok
CREATE TABLE cj_emp_2775 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2775 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2775 VALUES (10, 'ENG_85'), (20, 'SALES_85'), (30, 'HR_85');

statement ok
INSERT INTO cj_emp_2775 VALUES
(1, 10, 255),
(2, 10, 510),
(3, 20, 765),
(4, 30, 1020);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2775
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2775 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_85 765
20 SALES_85 765
30 HR_85 1020

query II
SELECT id, salary
FROM cj_emp_2775
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2775 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2775 WHERE dept_id = 30
)
ORDER BY id;
----
1 255
2 510
4 1020

statement ok
DROP TABLE cj_emp_2775;

statement ok
DROP TABLE cj_dept_2775;
