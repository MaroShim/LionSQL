# test/slt_proc/cte_subquery_join/2836_cte_union_subquery_exists_146.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (146)

statement ok
CREATE TABLE cj_emp_2836 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2836 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2836 VALUES (10, 'ENG_146'), (20, 'SALES_146'), (30, 'HR_146');

statement ok
INSERT INTO cj_emp_2836 VALUES
(1, 10, 438),
(2, 10, 876),
(3, 20, 1314),
(4, 30, 1752);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2836
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2836 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_146 1314
20 SALES_146 1314
30 HR_146 1752

query II
SELECT id, salary
FROM cj_emp_2836
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2836 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2836 WHERE dept_id = 30
)
ORDER BY id;
----
1 438
2 876
4 1752

statement ok
DROP TABLE cj_emp_2836;

statement ok
DROP TABLE cj_dept_2836;
