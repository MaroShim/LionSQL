# test/slt_proc/cte_subquery_join/218_recursive_cte_and_joins_13.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (13)

query I
WITH seq(n) AS (
    SELECT 5
    UNION ALL
    SELECT n + 5 FROM seq WHERE n < 20
)
SELECT n FROM seq ORDER BY n;
----
5
10
15
20

statement ok
CREATE TABLE c_cust_218 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_218 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_218 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_218 VALUES (101, 1, 130), (102, 1, 260), (103, 2, 390);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_218 c
INNER JOIN c_ord_218 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 390
2 Bob 390

query IT
SELECT cid, cname FROM c_cust_218 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_218 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_218;

statement ok
DROP TABLE c_cust_218;
