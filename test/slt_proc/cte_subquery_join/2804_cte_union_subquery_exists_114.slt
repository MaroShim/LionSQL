# test/slt_proc/cte_subquery_join/2804_cte_union_subquery_exists_114.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (114)

statement ok
CREATE TABLE cj_emp_2804 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2804 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2804 VALUES (10, 'ENG_114'), (20, 'SALES_114'), (30, 'HR_114');

statement ok
INSERT INTO cj_emp_2804 VALUES
(1, 10, 342),
(2, 10, 684),
(3, 20, 1026),
(4, 30, 1368);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2804
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2804 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_114 1026
20 SALES_114 1026
30 HR_114 1368

query II
SELECT id, salary
FROM cj_emp_2804
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2804 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2804 WHERE dept_id = 30
)
ORDER BY id;
----
1 342
2 684
4 1368

statement ok
DROP TABLE cj_emp_2804;

statement ok
DROP TABLE cj_dept_2804;
