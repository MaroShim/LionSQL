# test/slt_proc/cte_subquery_join/2718_cte_union_subquery_exists_028.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (28)

statement ok
CREATE TABLE cj_emp_2718 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2718 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2718 VALUES (10, 'ENG_28'), (20, 'SALES_28'), (30, 'HR_28');

statement ok
INSERT INTO cj_emp_2718 VALUES
(1, 10, 84),
(2, 10, 168),
(3, 20, 252),
(4, 30, 336);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2718
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2718 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_28 252
20 SALES_28 252
30 HR_28 336

query II
SELECT id, salary
FROM cj_emp_2718
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2718 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2718 WHERE dept_id = 30
)
ORDER BY id;
----
1 84
2 168
4 336

statement ok
DROP TABLE cj_emp_2718;

statement ok
DROP TABLE cj_dept_2718;
