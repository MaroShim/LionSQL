# test/slt_proc/cte_subquery_join/2786_cte_union_subquery_exists_096.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (96)

statement ok
CREATE TABLE cj_emp_2786 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2786 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2786 VALUES (10, 'ENG_96'), (20, 'SALES_96'), (30, 'HR_96');

statement ok
INSERT INTO cj_emp_2786 VALUES
(1, 10, 288),
(2, 10, 576),
(3, 20, 864),
(4, 30, 1152);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2786
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2786 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_96 864
20 SALES_96 864
30 HR_96 1152

query II
SELECT id, salary
FROM cj_emp_2786
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2786 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2786 WHERE dept_id = 30
)
ORDER BY id;
----
1 288
2 576
4 1152

statement ok
DROP TABLE cj_emp_2786;

statement ok
DROP TABLE cj_dept_2786;
