# test/slt_proc/cte_subquery_join/2738_cte_union_subquery_exists_048.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (48)

statement ok
CREATE TABLE cj_emp_2738 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2738 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2738 VALUES (10, 'ENG_48'), (20, 'SALES_48'), (30, 'HR_48');

statement ok
INSERT INTO cj_emp_2738 VALUES
(1, 10, 144),
(2, 10, 288),
(3, 20, 432),
(4, 30, 576);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2738
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2738 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_48 432
20 SALES_48 432
30 HR_48 576

query II
SELECT id, salary
FROM cj_emp_2738
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2738 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2738 WHERE dept_id = 30
)
ORDER BY id;
----
1 144
2 288
4 576

statement ok
DROP TABLE cj_emp_2738;

statement ok
DROP TABLE cj_dept_2738;
