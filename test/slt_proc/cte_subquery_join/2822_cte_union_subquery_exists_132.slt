# test/slt_proc/cte_subquery_join/2822_cte_union_subquery_exists_132.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (132)

statement ok
CREATE TABLE cj_emp_2822 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2822 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2822 VALUES (10, 'ENG_132'), (20, 'SALES_132'), (30, 'HR_132');

statement ok
INSERT INTO cj_emp_2822 VALUES
(1, 10, 396),
(2, 10, 792),
(3, 20, 1188),
(4, 30, 1584);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2822
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2822 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_132 1188
20 SALES_132 1188
30 HR_132 1584

query II
SELECT id, salary
FROM cj_emp_2822
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2822 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2822 WHERE dept_id = 30
)
ORDER BY id;
----
1 396
2 792
4 1584

statement ok
DROP TABLE cj_emp_2822;

statement ok
DROP TABLE cj_dept_2822;
