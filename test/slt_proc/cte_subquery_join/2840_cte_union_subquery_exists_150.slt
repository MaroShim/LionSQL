# test/slt_proc/cte_subquery_join/2840_cte_union_subquery_exists_150.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (150)

statement ok
CREATE TABLE cj_emp_2840 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2840 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2840 VALUES (10, 'ENG_150'), (20, 'SALES_150'), (30, 'HR_150');

statement ok
INSERT INTO cj_emp_2840 VALUES
(1, 10, 450),
(2, 10, 900),
(3, 20, 1350),
(4, 30, 1800);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2840
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2840 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_150 1350
20 SALES_150 1350
30 HR_150 1800

query II
SELECT id, salary
FROM cj_emp_2840
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2840 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2840 WHERE dept_id = 30
)
ORDER BY id;
----
1 450
2 900
4 1800

statement ok
DROP TABLE cj_emp_2840;

statement ok
DROP TABLE cj_dept_2840;
