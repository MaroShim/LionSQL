# test/slt_proc/cte_subquery_join/2785_cte_union_subquery_exists_095.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (95)

statement ok
CREATE TABLE cj_emp_2785 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2785 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2785 VALUES (10, 'ENG_95'), (20, 'SALES_95'), (30, 'HR_95');

statement ok
INSERT INTO cj_emp_2785 VALUES
(1, 10, 285),
(2, 10, 570),
(3, 20, 855),
(4, 30, 1140);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2785
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2785 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_95 855
20 SALES_95 855
30 HR_95 1140

query II
SELECT id, salary
FROM cj_emp_2785
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2785 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2785 WHERE dept_id = 30
)
ORDER BY id;
----
1 285
2 570
4 1140

statement ok
DROP TABLE cj_emp_2785;

statement ok
DROP TABLE cj_dept_2785;
