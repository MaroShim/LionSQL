# test/slt_proc/cte_subquery_join/951_chained_setops_and_pagination_06.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (6)

query I
SELECT 6 AS v
UNION ALL
SELECT 16 AS v
UNION ALL
SELECT 26 AS v
UNION ALL
SELECT 36 AS v
ORDER BY v;
----
6
16
26
36

statement ok
CREATE TABLE set_a_951 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_951 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_951 VALUES (1, 6), (2, 16), (3, 26);

statement ok
INSERT INTO set_b_951 VALUES (1, 16), (2, 26), (3, 36);

query I
SELECT v FROM set_a_951
INTERSECT
SELECT v FROM set_b_951
ORDER BY v;
----
16
26

query I
SELECT v FROM set_a_951
EXCEPT
SELECT v FROM set_b_951
ORDER BY v;
----
6

statement ok
CREATE PROCEDURE sp_page_set_951 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_951
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_951 1, 2;
----
2 16
3 26

statement ok
DROP TABLE set_b_951;

statement ok
DROP TABLE set_a_951;
