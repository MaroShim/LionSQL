# test/slt_proc/cte_subquery_join/2699_cte_union_subquery_exists_009.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (9)

statement ok
CREATE TABLE cj_emp_2699 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2699 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2699 VALUES (10, 'ENG_9'), (20, 'SALES_9'), (30, 'HR_9');

statement ok
INSERT INTO cj_emp_2699 VALUES
(1, 10, 27),
(2, 10, 54),
(3, 20, 81),
(4, 30, 108);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2699
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2699 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_9 81
20 SALES_9 81
30 HR_9 108

query II
SELECT id, salary
FROM cj_emp_2699
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2699 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2699 WHERE dept_id = 30
)
ORDER BY id;
----
1 27
2 54
4 108

statement ok
DROP TABLE cj_emp_2699;

statement ok
DROP TABLE cj_dept_2699;
