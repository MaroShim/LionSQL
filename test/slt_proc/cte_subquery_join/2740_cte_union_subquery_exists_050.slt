# test/slt_proc/cte_subquery_join/2740_cte_union_subquery_exists_050.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (50)

statement ok
CREATE TABLE cj_emp_2740 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2740 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2740 VALUES (10, 'ENG_50'), (20, 'SALES_50'), (30, 'HR_50');

statement ok
INSERT INTO cj_emp_2740 VALUES
(1, 10, 150),
(2, 10, 300),
(3, 20, 450),
(4, 30, 600);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2740
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2740 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_50 450
20 SALES_50 450
30 HR_50 600

query II
SELECT id, salary
FROM cj_emp_2740
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2740 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2740 WHERE dept_id = 30
)
ORDER BY id;
----
1 150
2 300
4 600

statement ok
DROP TABLE cj_emp_2740;

statement ok
DROP TABLE cj_dept_2740;
