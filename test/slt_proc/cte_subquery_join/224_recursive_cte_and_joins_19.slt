# test/slt_proc/cte_subquery_join/224_recursive_cte_and_joins_19.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (19)

query I
WITH seq(n) AS (
    SELECT 6
    UNION ALL
    SELECT n + 6 FROM seq WHERE n < 24
)
SELECT n FROM seq ORDER BY n;
----
6
12
18
24

statement ok
CREATE TABLE c_cust_224 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_224 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_224 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_224 VALUES (101, 1, 190), (102, 1, 380), (103, 2, 570);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_224 c
INNER JOIN c_ord_224 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 570
2 Bob 570

query IT
SELECT cid, cname FROM c_cust_224 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_224 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_224;

statement ok
DROP TABLE c_cust_224;
