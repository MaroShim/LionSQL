# test/slt_proc/cte_subquery_join/2696_cte_union_subquery_exists_006.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (6)

statement ok
CREATE TABLE cj_emp_2696 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2696 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2696 VALUES (10, 'ENG_6'), (20, 'SALES_6'), (30, 'HR_6');

statement ok
INSERT INTO cj_emp_2696 VALUES
(1, 10, 18),
(2, 10, 36),
(3, 20, 54),
(4, 30, 72);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2696
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2696 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_6 54
20 SALES_6 54
30 HR_6 72

query II
SELECT id, salary
FROM cj_emp_2696
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2696 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2696 WHERE dept_id = 30
)
ORDER BY id;
----
1 18
2 36
4 72

statement ok
DROP TABLE cj_emp_2696;

statement ok
DROP TABLE cj_dept_2696;
