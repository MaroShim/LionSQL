# test/slt_proc/cte_subquery_join/211_recursive_cte_and_joins_06.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (6)

query I
WITH seq(n) AS (
    SELECT 3
    UNION ALL
    SELECT n + 3 FROM seq WHERE n < 12
)
SELECT n FROM seq ORDER BY n;
----
3
6
9
12

statement ok
CREATE TABLE c_cust_211 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_211 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_211 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_211 VALUES (101, 1, 60), (102, 1, 120), (103, 2, 180);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_211 c
INNER JOIN c_ord_211 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 180
2 Bob 180

query IT
SELECT cid, cname FROM c_cust_211 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_211 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_211;

statement ok
DROP TABLE c_cust_211;
