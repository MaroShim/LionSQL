# test/slt_proc/cte_subquery_join/2774_cte_union_subquery_exists_084.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (84)

statement ok
CREATE TABLE cj_emp_2774 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2774 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2774 VALUES (10, 'ENG_84'), (20, 'SALES_84'), (30, 'HR_84');

statement ok
INSERT INTO cj_emp_2774 VALUES
(1, 10, 252),
(2, 10, 504),
(3, 20, 756),
(4, 30, 1008);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2774
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2774 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_84 756
20 SALES_84 756
30 HR_84 1008

query II
SELECT id, salary
FROM cj_emp_2774
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2774 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2774 WHERE dept_id = 30
)
ORDER BY id;
----
1 252
2 504
4 1008

statement ok
DROP TABLE cj_emp_2774;

statement ok
DROP TABLE cj_dept_2774;
