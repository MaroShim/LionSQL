# test/slt_proc/cte_subquery_join/2763_cte_union_subquery_exists_073.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (73)

statement ok
CREATE TABLE cj_emp_2763 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2763 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2763 VALUES (10, 'ENG_73'), (20, 'SALES_73'), (30, 'HR_73');

statement ok
INSERT INTO cj_emp_2763 VALUES
(1, 10, 219),
(2, 10, 438),
(3, 20, 657),
(4, 30, 876);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2763
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2763 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_73 657
20 SALES_73 657
30 HR_73 876

query II
SELECT id, salary
FROM cj_emp_2763
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2763 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2763 WHERE dept_id = 30
)
ORDER BY id;
----
1 219
2 438
4 876

statement ok
DROP TABLE cj_emp_2763;

statement ok
DROP TABLE cj_dept_2763;
