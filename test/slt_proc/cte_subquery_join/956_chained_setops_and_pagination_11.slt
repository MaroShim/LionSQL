# test/slt_proc/cte_subquery_join/956_chained_setops_and_pagination_11.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (11)

query I
SELECT 11 AS v
UNION ALL
SELECT 21 AS v
UNION ALL
SELECT 31 AS v
UNION ALL
SELECT 41 AS v
ORDER BY v;
----
11
21
31
41

statement ok
CREATE TABLE set_a_956 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_956 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_956 VALUES (1, 11), (2, 21), (3, 31);

statement ok
INSERT INTO set_b_956 VALUES (1, 21), (2, 31), (3, 41);

query I
SELECT v FROM set_a_956
INTERSECT
SELECT v FROM set_b_956
ORDER BY v;
----
21
31

query I
SELECT v FROM set_a_956
EXCEPT
SELECT v FROM set_b_956
ORDER BY v;
----
11

statement ok
CREATE PROCEDURE sp_page_set_956 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_956
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_956 1, 2;
----
2 21
3 31

statement ok
DROP TABLE set_b_956;

statement ok
DROP TABLE set_a_956;
