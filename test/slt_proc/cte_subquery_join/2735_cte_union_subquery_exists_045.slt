# test/slt_proc/cte_subquery_join/2735_cte_union_subquery_exists_045.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (45)

statement ok
CREATE TABLE cj_emp_2735 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2735 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2735 VALUES (10, 'ENG_45'), (20, 'SALES_45'), (30, 'HR_45');

statement ok
INSERT INTO cj_emp_2735 VALUES
(1, 10, 135),
(2, 10, 270),
(3, 20, 405),
(4, 30, 540);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2735
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2735 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_45 405
20 SALES_45 405
30 HR_45 540

query II
SELECT id, salary
FROM cj_emp_2735
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2735 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2735 WHERE dept_id = 30
)
ORDER BY id;
----
1 135
2 270
4 540

statement ok
DROP TABLE cj_emp_2735;

statement ok
DROP TABLE cj_dept_2735;
