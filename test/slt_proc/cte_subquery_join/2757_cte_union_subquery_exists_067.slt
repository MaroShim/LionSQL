# test/slt_proc/cte_subquery_join/2757_cte_union_subquery_exists_067.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (67)

statement ok
CREATE TABLE cj_emp_2757 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2757 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2757 VALUES (10, 'ENG_67'), (20, 'SALES_67'), (30, 'HR_67');

statement ok
INSERT INTO cj_emp_2757 VALUES
(1, 10, 201),
(2, 10, 402),
(3, 20, 603),
(4, 30, 804);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2757
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2757 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_67 603
20 SALES_67 603
30 HR_67 804

query II
SELECT id, salary
FROM cj_emp_2757
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2757 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2757 WHERE dept_id = 30
)
ORDER BY id;
----
1 201
2 402
4 804

statement ok
DROP TABLE cj_emp_2757;

statement ok
DROP TABLE cj_dept_2757;
