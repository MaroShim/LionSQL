# test/slt_proc/cte_subquery_join/2777_cte_union_subquery_exists_087.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (87)

statement ok
CREATE TABLE cj_emp_2777 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2777 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2777 VALUES (10, 'ENG_87'), (20, 'SALES_87'), (30, 'HR_87');

statement ok
INSERT INTO cj_emp_2777 VALUES
(1, 10, 261),
(2, 10, 522),
(3, 20, 783),
(4, 30, 1044);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2777
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2777 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_87 783
20 SALES_87 783
30 HR_87 1044

query II
SELECT id, salary
FROM cj_emp_2777
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2777 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2777 WHERE dept_id = 30
)
ORDER BY id;
----
1 261
2 522
4 1044

statement ok
DROP TABLE cj_emp_2777;

statement ok
DROP TABLE cj_dept_2777;
