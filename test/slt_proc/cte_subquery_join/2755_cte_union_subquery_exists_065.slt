# test/slt_proc/cte_subquery_join/2755_cte_union_subquery_exists_065.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (65)

statement ok
CREATE TABLE cj_emp_2755 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2755 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2755 VALUES (10, 'ENG_65'), (20, 'SALES_65'), (30, 'HR_65');

statement ok
INSERT INTO cj_emp_2755 VALUES
(1, 10, 195),
(2, 10, 390),
(3, 20, 585),
(4, 30, 780);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2755
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2755 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_65 585
20 SALES_65 585
30 HR_65 780

query II
SELECT id, salary
FROM cj_emp_2755
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2755 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2755 WHERE dept_id = 30
)
ORDER BY id;
----
1 195
2 390
4 780

statement ok
DROP TABLE cj_emp_2755;

statement ok
DROP TABLE cj_dept_2755;
