# test/slt_proc/cte_subquery_join/2810_cte_union_subquery_exists_120.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (120)

statement ok
CREATE TABLE cj_emp_2810 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2810 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2810 VALUES (10, 'ENG_120'), (20, 'SALES_120'), (30, 'HR_120');

statement ok
INSERT INTO cj_emp_2810 VALUES
(1, 10, 360),
(2, 10, 720),
(3, 20, 1080),
(4, 30, 1440);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2810
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2810 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_120 1080
20 SALES_120 1080
30 HR_120 1440

query II
SELECT id, salary
FROM cj_emp_2810
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2810 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2810 WHERE dept_id = 30
)
ORDER BY id;
----
1 360
2 720
4 1440

statement ok
DROP TABLE cj_emp_2810;

statement ok
DROP TABLE cj_dept_2810;
