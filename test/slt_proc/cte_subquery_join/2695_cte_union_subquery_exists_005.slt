# test/slt_proc/cte_subquery_join/2695_cte_union_subquery_exists_005.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (5)

statement ok
CREATE TABLE cj_emp_2695 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2695 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2695 VALUES (10, 'ENG_5'), (20, 'SALES_5'), (30, 'HR_5');

statement ok
INSERT INTO cj_emp_2695 VALUES
(1, 10, 15),
(2, 10, 30),
(3, 20, 45),
(4, 30, 60);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2695
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2695 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_5 45
20 SALES_5 45
30 HR_5 60

query II
SELECT id, salary
FROM cj_emp_2695
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2695 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2695 WHERE dept_id = 30
)
ORDER BY id;
----
1 15
2 30
4 60

statement ok
DROP TABLE cj_emp_2695;

statement ok
DROP TABLE cj_dept_2695;
