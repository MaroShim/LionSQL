# test/slt_proc/cte_subquery_join/225_recursive_cte_and_joins_20.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (20)

query I
WITH seq(n) AS (
    SELECT 2
    UNION ALL
    SELECT n + 2 FROM seq WHERE n < 8
)
SELECT n FROM seq ORDER BY n;
----
2
4
6
8

statement ok
CREATE TABLE c_cust_225 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_225 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_225 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_225 VALUES (101, 1, 200), (102, 1, 400), (103, 2, 600);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_225 c
INNER JOIN c_ord_225 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 600
2 Bob 600

query IT
SELECT cid, cname FROM c_cust_225 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_225 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_225;

statement ok
DROP TABLE c_cust_225;
