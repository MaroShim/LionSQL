# test/slt_proc/cte_subquery_join/2751_cte_union_subquery_exists_061.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (61)

statement ok
CREATE TABLE cj_emp_2751 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2751 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2751 VALUES (10, 'ENG_61'), (20, 'SALES_61'), (30, 'HR_61');

statement ok
INSERT INTO cj_emp_2751 VALUES
(1, 10, 183),
(2, 10, 366),
(3, 20, 549),
(4, 30, 732);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2751
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2751 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_61 549
20 SALES_61 549
30 HR_61 732

query II
SELECT id, salary
FROM cj_emp_2751
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2751 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2751 WHERE dept_id = 30
)
ORDER BY id;
----
1 183
2 366
4 732

statement ok
DROP TABLE cj_emp_2751;

statement ok
DROP TABLE cj_dept_2751;
