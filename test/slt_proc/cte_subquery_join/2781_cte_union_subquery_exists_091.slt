# test/slt_proc/cte_subquery_join/2781_cte_union_subquery_exists_091.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (91)

statement ok
CREATE TABLE cj_emp_2781 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2781 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2781 VALUES (10, 'ENG_91'), (20, 'SALES_91'), (30, 'HR_91');

statement ok
INSERT INTO cj_emp_2781 VALUES
(1, 10, 273),
(2, 10, 546),
(3, 20, 819),
(4, 30, 1092);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2781
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2781 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_91 819
20 SALES_91 819
30 HR_91 1092

query II
SELECT id, salary
FROM cj_emp_2781
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2781 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2781 WHERE dept_id = 30
)
ORDER BY id;
----
1 273
2 546
4 1092

statement ok
DROP TABLE cj_emp_2781;

statement ok
DROP TABLE cj_dept_2781;
