# test/slt_proc/cte_subquery_join/955_chained_setops_and_pagination_10.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (10)

query I
SELECT 10 AS v
UNION ALL
SELECT 20 AS v
UNION ALL
SELECT 30 AS v
UNION ALL
SELECT 40 AS v
ORDER BY v;
----
10
20
30
40

statement ok
CREATE TABLE set_a_955 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_955 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_955 VALUES (1, 10), (2, 20), (3, 30);

statement ok
INSERT INTO set_b_955 VALUES (1, 20), (2, 30), (3, 40);

query I
SELECT v FROM set_a_955
INTERSECT
SELECT v FROM set_b_955
ORDER BY v;
----
20
30

query I
SELECT v FROM set_a_955
EXCEPT
SELECT v FROM set_b_955
ORDER BY v;
----
10

statement ok
CREATE PROCEDURE sp_page_set_955 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_955
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_955 1, 2;
----
2 20
3 30

statement ok
DROP TABLE set_b_955;

statement ok
DROP TABLE set_a_955;
