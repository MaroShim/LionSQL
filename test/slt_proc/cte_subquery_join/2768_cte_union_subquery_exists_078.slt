# test/slt_proc/cte_subquery_join/2768_cte_union_subquery_exists_078.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (78)

statement ok
CREATE TABLE cj_emp_2768 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2768 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2768 VALUES (10, 'ENG_78'), (20, 'SALES_78'), (30, 'HR_78');

statement ok
INSERT INTO cj_emp_2768 VALUES
(1, 10, 234),
(2, 10, 468),
(3, 20, 702),
(4, 30, 936);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2768
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2768 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_78 702
20 SALES_78 702
30 HR_78 936

query II
SELECT id, salary
FROM cj_emp_2768
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2768 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2768 WHERE dept_id = 30
)
ORDER BY id;
----
1 234
2 468
4 936

statement ok
DROP TABLE cj_emp_2768;

statement ok
DROP TABLE cj_dept_2768;
