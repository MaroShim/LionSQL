# test/slt_proc/cte_subquery_join/2739_cte_union_subquery_exists_049.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (49)

statement ok
CREATE TABLE cj_emp_2739 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2739 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2739 VALUES (10, 'ENG_49'), (20, 'SALES_49'), (30, 'HR_49');

statement ok
INSERT INTO cj_emp_2739 VALUES
(1, 10, 147),
(2, 10, 294),
(3, 20, 441),
(4, 30, 588);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2739
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2739 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_49 441
20 SALES_49 441
30 HR_49 588

query II
SELECT id, salary
FROM cj_emp_2739
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2739 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2739 WHERE dept_id = 30
)
ORDER BY id;
----
1 147
2 294
4 588

statement ok
DROP TABLE cj_emp_2739;

statement ok
DROP TABLE cj_dept_2739;
