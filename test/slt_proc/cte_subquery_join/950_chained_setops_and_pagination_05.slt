# test/slt_proc/cte_subquery_join/950_chained_setops_and_pagination_05.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (5)

query I
SELECT 5 AS v
UNION ALL
SELECT 15 AS v
UNION ALL
SELECT 25 AS v
UNION ALL
SELECT 35 AS v
ORDER BY v;
----
5
15
25
35

statement ok
CREATE TABLE set_a_950 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_950 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_950 VALUES (1, 5), (2, 15), (3, 25);

statement ok
INSERT INTO set_b_950 VALUES (1, 15), (2, 25), (3, 35);

query I
SELECT v FROM set_a_950
INTERSECT
SELECT v FROM set_b_950
ORDER BY v;
----
15
25

query I
SELECT v FROM set_a_950
EXCEPT
SELECT v FROM set_b_950
ORDER BY v;
----
5

statement ok
CREATE PROCEDURE sp_page_set_950 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_950
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_950 1, 2;
----
2 15
3 25

statement ok
DROP TABLE set_b_950;

statement ok
DROP TABLE set_a_950;
