# test/slt_proc/cte_subquery_join/2734_cte_union_subquery_exists_044.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (44)

statement ok
CREATE TABLE cj_emp_2734 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2734 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2734 VALUES (10, 'ENG_44'), (20, 'SALES_44'), (30, 'HR_44');

statement ok
INSERT INTO cj_emp_2734 VALUES
(1, 10, 132),
(2, 10, 264),
(3, 20, 396),
(4, 30, 528);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2734
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2734 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_44 396
20 SALES_44 396
30 HR_44 528

query II
SELECT id, salary
FROM cj_emp_2734
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2734 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2734 WHERE dept_id = 30
)
ORDER BY id;
----
1 132
2 264
4 528

statement ok
DROP TABLE cj_emp_2734;

statement ok
DROP TABLE cj_dept_2734;
