# test/slt_proc/cte_subquery_join/2754_cte_union_subquery_exists_064.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (64)

statement ok
CREATE TABLE cj_emp_2754 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2754 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2754 VALUES (10, 'ENG_64'), (20, 'SALES_64'), (30, 'HR_64');

statement ok
INSERT INTO cj_emp_2754 VALUES
(1, 10, 192),
(2, 10, 384),
(3, 20, 576),
(4, 30, 768);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2754
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2754 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_64 576
20 SALES_64 576
30 HR_64 768

query II
SELECT id, salary
FROM cj_emp_2754
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2754 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2754 WHERE dept_id = 30
)
ORDER BY id;
----
1 192
2 384
4 768

statement ok
DROP TABLE cj_emp_2754;

statement ok
DROP TABLE cj_dept_2754;
