# test/slt_proc/cte_subquery_join/2744_cte_union_subquery_exists_054.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (54)

statement ok
CREATE TABLE cj_emp_2744 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2744 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2744 VALUES (10, 'ENG_54'), (20, 'SALES_54'), (30, 'HR_54');

statement ok
INSERT INTO cj_emp_2744 VALUES
(1, 10, 162),
(2, 10, 324),
(3, 20, 486),
(4, 30, 648);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2744
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2744 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_54 486
20 SALES_54 486
30 HR_54 648

query II
SELECT id, salary
FROM cj_emp_2744
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2744 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2744 WHERE dept_id = 30
)
ORDER BY id;
----
1 162
2 324
4 648

statement ok
DROP TABLE cj_emp_2744;

statement ok
DROP TABLE cj_dept_2744;
