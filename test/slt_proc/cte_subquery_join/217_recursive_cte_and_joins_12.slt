# test/slt_proc/cte_subquery_join/217_recursive_cte_and_joins_12.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (12)

query I
WITH seq(n) AS (
    SELECT 4
    UNION ALL
    SELECT n + 4 FROM seq WHERE n < 16
)
SELECT n FROM seq ORDER BY n;
----
4
8
12
16

statement ok
CREATE TABLE c_cust_217 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_217 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_217 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_217 VALUES (101, 1, 120), (102, 1, 240), (103, 2, 360);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_217 c
INNER JOIN c_ord_217 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 360
2 Bob 360

query IT
SELECT cid, cname FROM c_cust_217 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_217 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_217;

statement ok
DROP TABLE c_cust_217;
