# test/slt_proc/cte_subquery_join/2838_cte_union_subquery_exists_148.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (148)

statement ok
CREATE TABLE cj_emp_2838 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2838 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2838 VALUES (10, 'ENG_148'), (20, 'SALES_148'), (30, 'HR_148');

statement ok
INSERT INTO cj_emp_2838 VALUES
(1, 10, 444),
(2, 10, 888),
(3, 20, 1332),
(4, 30, 1776);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2838
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2838 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_148 1332
20 SALES_148 1332
30 HR_148 1776

query II
SELECT id, salary
FROM cj_emp_2838
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2838 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2838 WHERE dept_id = 30
)
ORDER BY id;
----
1 444
2 888
4 1776

statement ok
DROP TABLE cj_emp_2838;

statement ok
DROP TABLE cj_dept_2838;
