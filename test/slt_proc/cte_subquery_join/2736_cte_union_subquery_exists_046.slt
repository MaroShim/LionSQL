# test/slt_proc/cte_subquery_join/2736_cte_union_subquery_exists_046.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (46)

statement ok
CREATE TABLE cj_emp_2736 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2736 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2736 VALUES (10, 'ENG_46'), (20, 'SALES_46'), (30, 'HR_46');

statement ok
INSERT INTO cj_emp_2736 VALUES
(1, 10, 138),
(2, 10, 276),
(3, 20, 414),
(4, 30, 552);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2736
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2736 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_46 414
20 SALES_46 414
30 HR_46 552

query II
SELECT id, salary
FROM cj_emp_2736
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2736 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2736 WHERE dept_id = 30
)
ORDER BY id;
----
1 138
2 276
4 552

statement ok
DROP TABLE cj_emp_2736;

statement ok
DROP TABLE cj_dept_2736;
