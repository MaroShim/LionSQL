# test/slt_proc/cte_subquery_join/2798_cte_union_subquery_exists_108.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (108)

statement ok
CREATE TABLE cj_emp_2798 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2798 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2798 VALUES (10, 'ENG_108'), (20, 'SALES_108'), (30, 'HR_108');

statement ok
INSERT INTO cj_emp_2798 VALUES
(1, 10, 324),
(2, 10, 648),
(3, 20, 972),
(4, 30, 1296);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2798
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2798 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_108 972
20 SALES_108 972
30 HR_108 1296

query II
SELECT id, salary
FROM cj_emp_2798
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2798 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2798 WHERE dept_id = 30
)
ORDER BY id;
----
1 324
2 648
4 1296

statement ok
DROP TABLE cj_emp_2798;

statement ok
DROP TABLE cj_dept_2798;
