# test/slt_proc/cte_subquery_join/966_chained_setops_and_pagination_21.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (21)

query I
SELECT 21 AS v
UNION ALL
SELECT 31 AS v
UNION ALL
SELECT 41 AS v
UNION ALL
SELECT 51 AS v
ORDER BY v;
----
21
31
41
51

statement ok
CREATE TABLE set_a_966 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_966 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_966 VALUES (1, 21), (2, 31), (3, 41);

statement ok
INSERT INTO set_b_966 VALUES (1, 31), (2, 41), (3, 51);

query I
SELECT v FROM set_a_966
INTERSECT
SELECT v FROM set_b_966
ORDER BY v;
----
31
41

query I
SELECT v FROM set_a_966
EXCEPT
SELECT v FROM set_b_966
ORDER BY v;
----
21

statement ok
CREATE PROCEDURE sp_page_set_966 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_966
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_966 1, 2;
----
2 31
3 41

statement ok
DROP TABLE set_b_966;

statement ok
DROP TABLE set_a_966;
