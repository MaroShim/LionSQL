# test/slt_proc/cte_subquery_join/2794_cte_union_subquery_exists_104.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (104)

statement ok
CREATE TABLE cj_emp_2794 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2794 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2794 VALUES (10, 'ENG_104'), (20, 'SALES_104'), (30, 'HR_104');

statement ok
INSERT INTO cj_emp_2794 VALUES
(1, 10, 312),
(2, 10, 624),
(3, 20, 936),
(4, 30, 1248);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2794
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2794 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_104 936
20 SALES_104 936
30 HR_104 1248

query II
SELECT id, salary
FROM cj_emp_2794
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2794 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2794 WHERE dept_id = 30
)
ORDER BY id;
----
1 312
2 624
4 1248

statement ok
DROP TABLE cj_emp_2794;

statement ok
DROP TABLE cj_dept_2794;
