# test/slt_proc/cte_subquery_join/2833_cte_union_subquery_exists_143.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (143)

statement ok
CREATE TABLE cj_emp_2833 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2833 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2833 VALUES (10, 'ENG_143'), (20, 'SALES_143'), (30, 'HR_143');

statement ok
INSERT INTO cj_emp_2833 VALUES
(1, 10, 429),
(2, 10, 858),
(3, 20, 1287),
(4, 30, 1716);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2833
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2833 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_143 1287
20 SALES_143 1287
30 HR_143 1716

query II
SELECT id, salary
FROM cj_emp_2833
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2833 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2833 WHERE dept_id = 30
)
ORDER BY id;
----
1 429
2 858
4 1716

statement ok
DROP TABLE cj_emp_2833;

statement ok
DROP TABLE cj_dept_2833;
