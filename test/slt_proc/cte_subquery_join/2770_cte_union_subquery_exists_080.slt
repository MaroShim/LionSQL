# test/slt_proc/cte_subquery_join/2770_cte_union_subquery_exists_080.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (80)

statement ok
CREATE TABLE cj_emp_2770 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2770 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2770 VALUES (10, 'ENG_80'), (20, 'SALES_80'), (30, 'HR_80');

statement ok
INSERT INTO cj_emp_2770 VALUES
(1, 10, 240),
(2, 10, 480),
(3, 20, 720),
(4, 30, 960);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2770
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2770 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_80 720
20 SALES_80 720
30 HR_80 960

query II
SELECT id, salary
FROM cj_emp_2770
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2770 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2770 WHERE dept_id = 30
)
ORDER BY id;
----
1 240
2 480
4 960

statement ok
DROP TABLE cj_emp_2770;

statement ok
DROP TABLE cj_dept_2770;
