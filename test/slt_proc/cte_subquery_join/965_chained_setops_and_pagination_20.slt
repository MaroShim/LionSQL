# test/slt_proc/cte_subquery_join/965_chained_setops_and_pagination_20.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (20)

query I
SELECT 20 AS v
UNION ALL
SELECT 30 AS v
UNION ALL
SELECT 40 AS v
UNION ALL
SELECT 50 AS v
ORDER BY v;
----
20
30
40
50

statement ok
CREATE TABLE set_a_965 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_965 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_965 VALUES (1, 20), (2, 30), (3, 40);

statement ok
INSERT INTO set_b_965 VALUES (1, 30), (2, 40), (3, 50);

query I
SELECT v FROM set_a_965
INTERSECT
SELECT v FROM set_b_965
ORDER BY v;
----
30
40

query I
SELECT v FROM set_a_965
EXCEPT
SELECT v FROM set_b_965
ORDER BY v;
----
20

statement ok
CREATE PROCEDURE sp_page_set_965 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_965
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_965 1, 2;
----
2 30
3 40

statement ok
DROP TABLE set_b_965;

statement ok
DROP TABLE set_a_965;
