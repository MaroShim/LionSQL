# test/slt_proc/cte_subquery_join/2725_cte_union_subquery_exists_035.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (35)

statement ok
CREATE TABLE cj_emp_2725 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2725 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2725 VALUES (10, 'ENG_35'), (20, 'SALES_35'), (30, 'HR_35');

statement ok
INSERT INTO cj_emp_2725 VALUES
(1, 10, 105),
(2, 10, 210),
(3, 20, 315),
(4, 30, 420);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2725
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2725 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_35 315
20 SALES_35 315
30 HR_35 420

query II
SELECT id, salary
FROM cj_emp_2725
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2725 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2725 WHERE dept_id = 30
)
ORDER BY id;
----
1 105
2 210
4 420

statement ok
DROP TABLE cj_emp_2725;

statement ok
DROP TABLE cj_dept_2725;
