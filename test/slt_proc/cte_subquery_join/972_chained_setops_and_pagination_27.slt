# test/slt_proc/cte_subquery_join/972_chained_setops_and_pagination_27.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (27)

query I
SELECT 27 AS v
UNION ALL
SELECT 37 AS v
UNION ALL
SELECT 47 AS v
UNION ALL
SELECT 57 AS v
ORDER BY v;
----
27
37
47
57

statement ok
CREATE TABLE set_a_972 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_972 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_972 VALUES (1, 27), (2, 37), (3, 47);

statement ok
INSERT INTO set_b_972 VALUES (1, 37), (2, 47), (3, 57);

query I
SELECT v FROM set_a_972
INTERSECT
SELECT v FROM set_b_972
ORDER BY v;
----
37
47

query I
SELECT v FROM set_a_972
EXCEPT
SELECT v FROM set_b_972
ORDER BY v;
----
27

statement ok
CREATE PROCEDURE sp_page_set_972 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_972
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_972 1, 2;
----
2 37
3 47

statement ok
DROP TABLE set_b_972;

statement ok
DROP TABLE set_a_972;
