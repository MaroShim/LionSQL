# test/slt_proc/cte_subquery_join/2743_cte_union_subquery_exists_053.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (53)

statement ok
CREATE TABLE cj_emp_2743 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2743 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2743 VALUES (10, 'ENG_53'), (20, 'SALES_53'), (30, 'HR_53');

statement ok
INSERT INTO cj_emp_2743 VALUES
(1, 10, 159),
(2, 10, 318),
(3, 20, 477),
(4, 30, 636);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2743
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2743 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_53 477
20 SALES_53 477
30 HR_53 636

query II
SELECT id, salary
FROM cj_emp_2743
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2743 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2743 WHERE dept_id = 30
)
ORDER BY id;
----
1 159
2 318
4 636

statement ok
DROP TABLE cj_emp_2743;

statement ok
DROP TABLE cj_dept_2743;
