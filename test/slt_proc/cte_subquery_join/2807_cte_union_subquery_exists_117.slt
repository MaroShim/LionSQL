# test/slt_proc/cte_subquery_join/2807_cte_union_subquery_exists_117.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (117)

statement ok
CREATE TABLE cj_emp_2807 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2807 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2807 VALUES (10, 'ENG_117'), (20, 'SALES_117'), (30, 'HR_117');

statement ok
INSERT INTO cj_emp_2807 VALUES
(1, 10, 351),
(2, 10, 702),
(3, 20, 1053),
(4, 30, 1404);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2807
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2807 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_117 1053
20 SALES_117 1053
30 HR_117 1404

query II
SELECT id, salary
FROM cj_emp_2807
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2807 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2807 WHERE dept_id = 30
)
ORDER BY id;
----
1 351
2 702
4 1404

statement ok
DROP TABLE cj_emp_2807;

statement ok
DROP TABLE cj_dept_2807;
