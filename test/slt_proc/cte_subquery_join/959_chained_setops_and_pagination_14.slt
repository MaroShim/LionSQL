# test/slt_proc/cte_subquery_join/959_chained_setops_and_pagination_14.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (14)

query I
SELECT 14 AS v
UNION ALL
SELECT 24 AS v
UNION ALL
SELECT 34 AS v
UNION ALL
SELECT 44 AS v
ORDER BY v;
----
14
24
34
44

statement ok
CREATE TABLE set_a_959 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_959 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_959 VALUES (1, 14), (2, 24), (3, 34);

statement ok
INSERT INTO set_b_959 VALUES (1, 24), (2, 34), (3, 44);

query I
SELECT v FROM set_a_959
INTERSECT
SELECT v FROM set_b_959
ORDER BY v;
----
24
34

query I
SELECT v FROM set_a_959
EXCEPT
SELECT v FROM set_b_959
ORDER BY v;
----
14

statement ok
CREATE PROCEDURE sp_page_set_959 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_959
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_959 1, 2;
----
2 24
3 34

statement ok
DROP TABLE set_b_959;

statement ok
DROP TABLE set_a_959;
