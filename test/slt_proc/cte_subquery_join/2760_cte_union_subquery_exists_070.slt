# test/slt_proc/cte_subquery_join/2760_cte_union_subquery_exists_070.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (70)

statement ok
CREATE TABLE cj_emp_2760 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2760 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2760 VALUES (10, 'ENG_70'), (20, 'SALES_70'), (30, 'HR_70');

statement ok
INSERT INTO cj_emp_2760 VALUES
(1, 10, 210),
(2, 10, 420),
(3, 20, 630),
(4, 30, 840);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2760
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2760 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_70 630
20 SALES_70 630
30 HR_70 840

query II
SELECT id, salary
FROM cj_emp_2760
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2760 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2760 WHERE dept_id = 30
)
ORDER BY id;
----
1 210
2 420
4 840

statement ok
DROP TABLE cj_emp_2760;

statement ok
DROP TABLE cj_dept_2760;
