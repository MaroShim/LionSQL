# test/slt_proc/cte_subquery_join/206_recursive_cte_and_joins_01.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (1)

query I
WITH seq(n) AS (
    SELECT 3
    UNION ALL
    SELECT n + 3 FROM seq WHERE n < 12
)
SELECT n FROM seq ORDER BY n;
----
3
6
9
12

statement ok
CREATE TABLE c_cust_206 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_206 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_206 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_206 VALUES (101, 1, 10), (102, 1, 20), (103, 2, 30);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_206 c
INNER JOIN c_ord_206 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 30
2 Bob 30

query IT
SELECT cid, cname FROM c_cust_206 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_206 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_206;

statement ok
DROP TABLE c_cust_206;
