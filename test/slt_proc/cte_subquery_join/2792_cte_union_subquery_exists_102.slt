# test/slt_proc/cte_subquery_join/2792_cte_union_subquery_exists_102.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (102)

statement ok
CREATE TABLE cj_emp_2792 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2792 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2792 VALUES (10, 'ENG_102'), (20, 'SALES_102'), (30, 'HR_102');

statement ok
INSERT INTO cj_emp_2792 VALUES
(1, 10, 306),
(2, 10, 612),
(3, 20, 918),
(4, 30, 1224);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2792
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2792 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_102 918
20 SALES_102 918
30 HR_102 1224

query II
SELECT id, salary
FROM cj_emp_2792
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2792 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2792 WHERE dept_id = 30
)
ORDER BY id;
----
1 306
2 612
4 1224

statement ok
DROP TABLE cj_emp_2792;

statement ok
DROP TABLE cj_dept_2792;
