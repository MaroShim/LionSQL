# test/slt_proc/cte_subquery_join/2719_cte_union_subquery_exists_029.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (29)

statement ok
CREATE TABLE cj_emp_2719 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2719 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2719 VALUES (10, 'ENG_29'), (20, 'SALES_29'), (30, 'HR_29');

statement ok
INSERT INTO cj_emp_2719 VALUES
(1, 10, 87),
(2, 10, 174),
(3, 20, 261),
(4, 30, 348);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2719
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2719 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_29 261
20 SALES_29 261
30 HR_29 348

query II
SELECT id, salary
FROM cj_emp_2719
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2719 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2719 WHERE dept_id = 30
)
ORDER BY id;
----
1 87
2 174
4 348

statement ok
DROP TABLE cj_emp_2719;

statement ok
DROP TABLE cj_dept_2719;
