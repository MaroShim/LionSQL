# test/slt_proc/cte_subquery_join/2795_cte_union_subquery_exists_105.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (105)

statement ok
CREATE TABLE cj_emp_2795 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2795 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2795 VALUES (10, 'ENG_105'), (20, 'SALES_105'), (30, 'HR_105');

statement ok
INSERT INTO cj_emp_2795 VALUES
(1, 10, 315),
(2, 10, 630),
(3, 20, 945),
(4, 30, 1260);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2795
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2795 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_105 945
20 SALES_105 945
30 HR_105 1260

query II
SELECT id, salary
FROM cj_emp_2795
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2795 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2795 WHERE dept_id = 30
)
ORDER BY id;
----
1 315
2 630
4 1260

statement ok
DROP TABLE cj_emp_2795;

statement ok
DROP TABLE cj_dept_2795;
