# test/slt_proc/cte_subquery_join/2769_cte_union_subquery_exists_079.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (79)

statement ok
CREATE TABLE cj_emp_2769 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2769 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2769 VALUES (10, 'ENG_79'), (20, 'SALES_79'), (30, 'HR_79');

statement ok
INSERT INTO cj_emp_2769 VALUES
(1, 10, 237),
(2, 10, 474),
(3, 20, 711),
(4, 30, 948);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2769
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2769 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_79 711
20 SALES_79 711
30 HR_79 948

query II
SELECT id, salary
FROM cj_emp_2769
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2769 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2769 WHERE dept_id = 30
)
ORDER BY id;
----
1 237
2 474
4 948

statement ok
DROP TABLE cj_emp_2769;

statement ok
DROP TABLE cj_dept_2769;
