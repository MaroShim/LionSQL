# test/slt_proc/cte_subquery_join/2816_cte_union_subquery_exists_126.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (126)

statement ok
CREATE TABLE cj_emp_2816 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2816 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2816 VALUES (10, 'ENG_126'), (20, 'SALES_126'), (30, 'HR_126');

statement ok
INSERT INTO cj_emp_2816 VALUES
(1, 10, 378),
(2, 10, 756),
(3, 20, 1134),
(4, 30, 1512);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2816
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2816 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_126 1134
20 SALES_126 1134
30 HR_126 1512

query II
SELECT id, salary
FROM cj_emp_2816
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2816 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2816 WHERE dept_id = 30
)
ORDER BY id;
----
1 378
2 756
4 1512

statement ok
DROP TABLE cj_emp_2816;

statement ok
DROP TABLE cj_dept_2816;
