# test/slt_proc/cte_subquery_join/216_recursive_cte_and_joins_11.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (11)

query I
WITH seq(n) AS (
    SELECT 3
    UNION ALL
    SELECT n + 3 FROM seq WHERE n < 12
)
SELECT n FROM seq ORDER BY n;
----
3
6
9
12

statement ok
CREATE TABLE c_cust_216 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_216 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_216 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_216 VALUES (101, 1, 110), (102, 1, 220), (103, 2, 330);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_216 c
INNER JOIN c_ord_216 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 330
2 Bob 330

query IT
SELECT cid, cname FROM c_cust_216 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_216 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_216;

statement ok
DROP TABLE c_cust_216;
