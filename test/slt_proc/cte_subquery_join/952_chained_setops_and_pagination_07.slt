# test/slt_proc/cte_subquery_join/952_chained_setops_and_pagination_07.slt
# T-SQL Chained UNION/UNION ALL/INTERSECT/EXCEPT and parameterized OFFSET/FETCH (7)

query I
SELECT 7 AS v
UNION ALL
SELECT 17 AS v
UNION ALL
SELECT 27 AS v
UNION ALL
SELECT 37 AS v
ORDER BY v;
----
7
17
27
37

statement ok
CREATE TABLE set_a_952 (id INT PRIMARY KEY, v INT);

statement ok
CREATE TABLE set_b_952 (id INT PRIMARY KEY, v INT);

statement ok
INSERT INTO set_a_952 VALUES (1, 7), (2, 17), (3, 27);

statement ok
INSERT INTO set_b_952 VALUES (1, 17), (2, 27), (3, 37);

query I
SELECT v FROM set_a_952
INTERSECT
SELECT v FROM set_b_952
ORDER BY v;
----
17
27

query I
SELECT v FROM set_a_952
EXCEPT
SELECT v FROM set_b_952
ORDER BY v;
----
7

statement ok
CREATE PROCEDURE sp_page_set_952 @skip INT, @take INT
AS
BEGIN
    SELECT id, v FROM set_a_952
    ORDER BY id
    OFFSET @skip ROWS FETCH NEXT @take ROWS ONLY;
END;

query II
EXEC sp_page_set_952 1, 2;
----
2 17
3 27

statement ok
DROP TABLE set_b_952;

statement ok
DROP TABLE set_a_952;
