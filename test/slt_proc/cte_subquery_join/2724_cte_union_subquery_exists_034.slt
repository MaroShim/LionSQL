# test/slt_proc/cte_subquery_join/2724_cte_union_subquery_exists_034.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (34)

statement ok
CREATE TABLE cj_emp_2724 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2724 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2724 VALUES (10, 'ENG_34'), (20, 'SALES_34'), (30, 'HR_34');

statement ok
INSERT INTO cj_emp_2724 VALUES
(1, 10, 102),
(2, 10, 204),
(3, 20, 306),
(4, 30, 408);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2724
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2724 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_34 306
20 SALES_34 306
30 HR_34 408

query II
SELECT id, salary
FROM cj_emp_2724
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2724 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2724 WHERE dept_id = 30
)
ORDER BY id;
----
1 102
2 204
4 408

statement ok
DROP TABLE cj_emp_2724;

statement ok
DROP TABLE cj_dept_2724;
