# test/slt_proc/cte_subquery_join/2801_cte_union_subquery_exists_111.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (111)

statement ok
CREATE TABLE cj_emp_2801 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2801 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2801 VALUES (10, 'ENG_111'), (20, 'SALES_111'), (30, 'HR_111');

statement ok
INSERT INTO cj_emp_2801 VALUES
(1, 10, 333),
(2, 10, 666),
(3, 20, 999),
(4, 30, 1332);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2801
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2801 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_111 999
20 SALES_111 999
30 HR_111 1332

query II
SELECT id, salary
FROM cj_emp_2801
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2801 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2801 WHERE dept_id = 30
)
ORDER BY id;
----
1 333
2 666
4 1332

statement ok
DROP TABLE cj_emp_2801;

statement ok
DROP TABLE cj_dept_2801;
