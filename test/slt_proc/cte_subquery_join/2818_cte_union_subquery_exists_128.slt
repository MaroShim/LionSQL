# test/slt_proc/cte_subquery_join/2818_cte_union_subquery_exists_128.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (128)

statement ok
CREATE TABLE cj_emp_2818 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2818 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2818 VALUES (10, 'ENG_128'), (20, 'SALES_128'), (30, 'HR_128');

statement ok
INSERT INTO cj_emp_2818 VALUES
(1, 10, 384),
(2, 10, 768),
(3, 20, 1152),
(4, 30, 1536);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2818
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2818 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_128 1152
20 SALES_128 1152
30 HR_128 1536

query II
SELECT id, salary
FROM cj_emp_2818
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2818 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2818 WHERE dept_id = 30
)
ORDER BY id;
----
1 384
2 768
4 1536

statement ok
DROP TABLE cj_emp_2818;

statement ok
DROP TABLE cj_dept_2818;
