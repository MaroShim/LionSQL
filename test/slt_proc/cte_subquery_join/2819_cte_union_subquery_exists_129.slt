# test/slt_proc/cte_subquery_join/2819_cte_union_subquery_exists_129.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (129)

statement ok
CREATE TABLE cj_emp_2819 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2819 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2819 VALUES (10, 'ENG_129'), (20, 'SALES_129'), (30, 'HR_129');

statement ok
INSERT INTO cj_emp_2819 VALUES
(1, 10, 387),
(2, 10, 774),
(3, 20, 1161),
(4, 30, 1548);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2819
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2819 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_129 1161
20 SALES_129 1161
30 HR_129 1548

query II
SELECT id, salary
FROM cj_emp_2819
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2819 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2819 WHERE dept_id = 30
)
ORDER BY id;
----
1 387
2 774
4 1548

statement ok
DROP TABLE cj_emp_2819;

statement ok
DROP TABLE cj_dept_2819;
