# test/slt_proc/cte_subquery_join/222_recursive_cte_and_joins_17.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (17)

query I
WITH seq(n) AS (
    SELECT 4
    UNION ALL
    SELECT n + 4 FROM seq WHERE n < 16
)
SELECT n FROM seq ORDER BY n;
----
4
8
12
16

statement ok
CREATE TABLE c_cust_222 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_222 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_222 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_222 VALUES (101, 1, 170), (102, 1, 340), (103, 2, 510);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_222 c
INNER JOIN c_ord_222 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 510
2 Bob 510

query IT
SELECT cid, cname FROM c_cust_222 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_222 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_222;

statement ok
DROP TABLE c_cust_222;
