# test/slt_proc/cte_subquery_join/2745_cte_union_subquery_exists_055.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (55)

statement ok
CREATE TABLE cj_emp_2745 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2745 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2745 VALUES (10, 'ENG_55'), (20, 'SALES_55'), (30, 'HR_55');

statement ok
INSERT INTO cj_emp_2745 VALUES
(1, 10, 165),
(2, 10, 330),
(3, 20, 495),
(4, 30, 660);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2745
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2745 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_55 495
20 SALES_55 495
30 HR_55 660

query II
SELECT id, salary
FROM cj_emp_2745
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2745 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2745 WHERE dept_id = 30
)
ORDER BY id;
----
1 165
2 330
4 660

statement ok
DROP TABLE cj_emp_2745;

statement ok
DROP TABLE cj_dept_2745;
