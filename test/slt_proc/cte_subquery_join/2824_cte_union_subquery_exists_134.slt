# test/slt_proc/cte_subquery_join/2824_cte_union_subquery_exists_134.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (134)

statement ok
CREATE TABLE cj_emp_2824 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2824 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2824 VALUES (10, 'ENG_134'), (20, 'SALES_134'), (30, 'HR_134');

statement ok
INSERT INTO cj_emp_2824 VALUES
(1, 10, 402),
(2, 10, 804),
(3, 20, 1206),
(4, 30, 1608);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2824
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2824 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_134 1206
20 SALES_134 1206
30 HR_134 1608

query II
SELECT id, salary
FROM cj_emp_2824
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2824 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2824 WHERE dept_id = 30
)
ORDER BY id;
----
1 402
2 804
4 1608

statement ok
DROP TABLE cj_emp_2824;

statement ok
DROP TABLE cj_dept_2824;
