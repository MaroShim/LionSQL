# test/slt_proc/cte_subquery_join/2708_cte_union_subquery_exists_018.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (18)

statement ok
CREATE TABLE cj_emp_2708 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2708 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2708 VALUES (10, 'ENG_18'), (20, 'SALES_18'), (30, 'HR_18');

statement ok
INSERT INTO cj_emp_2708 VALUES
(1, 10, 54),
(2, 10, 108),
(3, 20, 162),
(4, 30, 216);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2708
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2708 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_18 162
20 SALES_18 162
30 HR_18 216

query II
SELECT id, salary
FROM cj_emp_2708
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2708 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2708 WHERE dept_id = 30
)
ORDER BY id;
----
1 54
2 108
4 216

statement ok
DROP TABLE cj_emp_2708;

statement ok
DROP TABLE cj_dept_2708;
