# test/slt_proc/cte_subquery_join/2730_cte_union_subquery_exists_040.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (40)

statement ok
CREATE TABLE cj_emp_2730 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2730 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2730 VALUES (10, 'ENG_40'), (20, 'SALES_40'), (30, 'HR_40');

statement ok
INSERT INTO cj_emp_2730 VALUES
(1, 10, 120),
(2, 10, 240),
(3, 20, 360),
(4, 30, 480);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2730
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2730 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_40 360
20 SALES_40 360
30 HR_40 480

query II
SELECT id, salary
FROM cj_emp_2730
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2730 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2730 WHERE dept_id = 30
)
ORDER BY id;
----
1 120
2 240
4 480

statement ok
DROP TABLE cj_emp_2730;

statement ok
DROP TABLE cj_dept_2730;
