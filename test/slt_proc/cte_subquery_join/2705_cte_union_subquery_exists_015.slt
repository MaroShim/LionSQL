# test/slt_proc/cte_subquery_join/2705_cte_union_subquery_exists_015.slt
# T-SQL CTEs, IN (SELECT ... UNION ...), EXISTS decorrelation, and chained UNION ALL (15)

statement ok
CREATE TABLE cj_emp_2705 (id INT PRIMARY KEY, dept_id INT, salary INT);

statement ok
CREATE TABLE cj_dept_2705 (dept_id INT PRIMARY KEY, dname VARCHAR(20));

statement ok
INSERT INTO cj_dept_2705 VALUES (10, 'ENG_15'), (20, 'SALES_15'), (30, 'HR_15');

statement ok
INSERT INTO cj_emp_2705 VALUES
(1, 10, 45),
(2, 10, 90),
(3, 20, 135),
(4, 30, 180);

query ITI
WITH dept_totals AS (
    SELECT dept_id, SUM(salary) AS tot_sal
    FROM cj_emp_2705
    GROUP BY dept_id
)
SELECT d.dept_id, d.dname, dt.tot_sal
FROM cj_dept_2705 d
JOIN dept_totals dt ON d.dept_id = dt.dept_id
ORDER BY d.dept_id;
----
10 ENG_15 135
20 SALES_15 135
30 HR_15 180

query II
SELECT id, salary
FROM cj_emp_2705
WHERE dept_id IN (
    SELECT dept_id FROM cj_dept_2705 WHERE dept_id = 10
    UNION
    SELECT dept_id FROM cj_dept_2705 WHERE dept_id = 30
)
ORDER BY id;
----
1 45
2 90
4 180

statement ok
DROP TABLE cj_emp_2705;

statement ok
DROP TABLE cj_dept_2705;
