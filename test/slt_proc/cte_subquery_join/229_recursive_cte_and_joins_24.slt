# test/slt_proc/cte_subquery_join/229_recursive_cte_and_joins_24.slt
# T-SQL Recursive CTE, INNER JOIN, EXISTS, NOT EXISTS (24)

query I
WITH seq(n) AS (
    SELECT 6
    UNION ALL
    SELECT n + 6 FROM seq WHERE n < 24
)
SELECT n FROM seq ORDER BY n;
----
6
12
18
24

statement ok
CREATE TABLE c_cust_229 (cid INT PRIMARY KEY, cname VARCHAR(20));

statement ok
CREATE TABLE c_ord_229 (oid INT PRIMARY KEY, cid INT, amt INT);

statement ok
INSERT INTO c_cust_229 VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Charlie');

statement ok
INSERT INTO c_ord_229 VALUES (101, 1, 240), (102, 1, 480), (103, 2, 720);

query ITI
SELECT c.cid, c.cname, SUM(o.amt)
FROM c_cust_229 c
INNER JOIN c_ord_229 o ON c.cid = o.cid
GROUP BY c.cid, c.cname
ORDER BY c.cid;
----
1 Alice 720
2 Bob 720

query IT
SELECT cid, cname FROM c_cust_229 c
WHERE NOT EXISTS (SELECT 1 FROM c_ord_229 o WHERE o.cid = c.cid);
----
3 Charlie

statement ok
DROP TABLE c_ord_229;

statement ok
DROP TABLE c_cust_229;
