# Core IN and NOT IN Value List Predicates (Including Three-Valued NULL Logic)

statement ok
CREATE TABLE slt_in (id INT PRIMARY KEY, code INT, status VARCHAR);

statement ok
INSERT INTO slt_in VALUES (1, 100, 'OPEN');

statement ok
INSERT INTO slt_in VALUES (2, 200, 'PENDING');

statement ok
INSERT INTO slt_in VALUES (3, 300, 'CLOSED');

statement ok
INSERT INTO slt_in VALUES (4, 400, 'ARCHIVED');

statement ok
INSERT INTO slt_in VALUES (5, NULL, NULL);

# Numeric IN list
query II rowsort
SELECT id, code FROM slt_in WHERE code IN (100, 300, 999);
----
1 100
3 300

# Numeric NOT IN list (must exclude row 5 where code IS NULL)
query II rowsort
SELECT id, code FROM slt_in WHERE code NOT IN (100, 300);
----
2 200
4 400

# String IN list
query IT rowsort
SELECT id, status FROM slt_in WHERE status IN ('OPEN', 'ARCHIVED');
----
1 OPEN
4 ARCHIVED

# String NOT IN list (must exclude NULL status)
query IT rowsort
SELECT id, status FROM slt_in WHERE status NOT IN ('OPEN', 'PENDING', 'ARCHIVED');
----
3 CLOSED

# IN list containing NULL: matching non-null values still succeed
query I rowsort
SELECT id FROM slt_in WHERE code IN (100, NULL);
----
1

# NOT IN list containing NULL: 3VL evaluates x <> 100 AND x <> NULL to UNKNOWN (0 rows)
query I rowsort
SELECT id FROM slt_in WHERE code NOT IN (100, NULL);
----
