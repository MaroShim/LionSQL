# expr_stress.slt: Deep nested expressions, operator precedence, CASE, COALESCE, NULLIF, and 3VL stress

statement ok
CREATE TABLE slt_expr_stress (id INT PRIMARY KEY, a INT, b INT, c INT, label VARCHAR(32))

statement ok
INSERT INTO slt_expr_stress VALUES (1, 10, 20, 30, 'alpha')

statement ok
INSERT INTO slt_expr_stress VALUES (2, -5, 15, 0, 'beta')

statement ok
INSERT INTO slt_expr_stress VALUES (3, 100, NULL, 25, 'gamma')

statement ok
INSERT INTO slt_expr_stress VALUES (4, NULL, NULL, 50, NULL)

statement ok
INSERT INTO slt_expr_stress VALUES (5, 7, 3, 2, 'delta')

# 1. Nested arithmetic with parentheses, unary minus, division, and modulo
query II rowsort
SELECT id, (a + b) * c - (a / 2) + (b % 3) FROM slt_expr_stress WHERE a IS NOT NULL AND b IS NOT NULL
----
1 897
2 2
5 17

# 2. COALESCE + NULLIF + arithmetic combination
query II rowsort
SELECT id, COALESCE(a, 0) + COALESCE(NULLIF(b, 20), 100) - c FROM slt_expr_stress
----
1 80
2 10
3 175
4 50
5 8

# 3. Deep CASE WHEN with compound boolean conditions and arithmetic branches
query IIT rowsort
SELECT id,
  CASE
    WHEN a IS NULL AND b IS NULL THEN -999
    WHEN a IS NULL OR b IS NULL THEN COALESCE(a, b, 0) * 2
    WHEN a * b > 100 THEN a + b + c
    WHEN a < 0 AND b > 0 THEN (b - a) * 10
    ELSE a * b * c
  END AS calc,
  COALESCE(UPPER(label), 'MISSING')
FROM slt_expr_stress
----
1 60 ALPHA
2 200 BETA
3 200 GAMMA
4 -999 MISSING
5 42 DELTA

# 4. Complex WHERE filter mixing BETWEEN, IN, LIKE, NOT, and NULL checks
query IT rowsort
SELECT id, COALESCE(label, 'none')
FROM slt_expr_stress
WHERE (a BETWEEN -10 AND 20 OR c IN (25, 50))
  AND NOT (c = 0)
----
1 alpha
3 gamma
4 none
5 delta

# 5. Nested CASE inside arithmetic expression
query II rowsort
SELECT id,
  10 + (CASE WHEN a > 50 THEN 100 ELSE COALESCE(a, 1) END) * (CASE WHEN c >= 25 THEN 2 ELSE 1 END)
FROM slt_expr_stress
----
1 30
2 5
3 210
4 12
5 17

# 6. Multi-condition 3VL De Morgan equivalence check:
# NOT (a > 10 OR b > 10) vs (a <= 10 AND b <= 10)
query I rowsort
SELECT id FROM slt_expr_stress WHERE NOT (a > 10 OR b > 10)
----
5

query I rowsort
SELECT id FROM slt_expr_stress WHERE a <= 10 AND b <= 10
----
5

# 7. String functions combined with CASE and COALESCE
query IT rowsort
SELECT id, CONCAT(COALESCE(SUBSTRING(label, 1, 3), 'nil'), '-', CAST(c AS VARCHAR))
FROM slt_expr_stress
ORDER BY id ASC
----
1 alp-30
2 bet-0
3 gam-25
4 nil-50
5 del-2
