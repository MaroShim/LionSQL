# agg_stress.slt: Multi-group aggregation, HAVING, JOIN + GROUP BY, and subquery stress

statement ok
CREATE TABLE slt_sales_dept (dept_id INT PRIMARY KEY, dept_name VARCHAR(32), region VARCHAR(32))

