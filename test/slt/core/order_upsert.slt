# Core Multi-Column Sorting, TOP N, and ON CONFLICT Upsert Semantics

statement ok
CREATE TABLE slt_upsert (id INT PRIMARY KEY, category VARCHAR, priority INT, qty INT);

statement ok
INSERT INTO slt_upsert VALUES (1, 'A', 2, 10);

statement ok
INSERT INTO slt_upsert VALUES (2, 'A', 1, 20);

statement ok
INSERT INTO slt_upsert VALUES (3, 'B', 1, 30);

statement ok
INSERT INTO slt_upsert VALUES (4, 'B', 2, 40);

# Multi-column ORDER BY (category ASC, priority DESC)
query ITII nosort
SELECT id, category, priority, qty FROM slt_upsert ORDER BY category ASC, priority DESC;
----
1 A 2 10
2 A 1 20
4 B 2 40
3 B 1 30

# T-SQL SELECT TOP N with ORDER BY
query II nosort
SELECT TOP 2 id, qty FROM slt_upsert ORDER BY qty DESC;
----
4 40
3 30

# ON CONFLICT DO NOTHING (existing key id=1 unchanged, new key id=5 inserted)
statement ok
INSERT INTO slt_upsert (id, category, priority, qty) VALUES (1, 'Z', 9, 999) ON CONFLICT (id) DO NOTHING;

statement ok
INSERT INTO slt_upsert (id, category, priority, qty) VALUES (5, 'C', 1, 50) ON CONFLICT (id) DO NOTHING;

query ITII rowsort
SELECT id, category, priority, qty FROM slt_upsert;
----
1 A 2 10
2 A 1 20
3 B 1 30
4 B 2 40
5 C 1 50

# ON CONFLICT DO UPDATE
statement ok
INSERT INTO slt_upsert (id, category, priority, qty) VALUES (2, 'A', 1, 250) ON CONFLICT (id) DO UPDATE SET qty = 250;

query II rowsort
SELECT id, qty FROM slt_upsert WHERE id = 2;
----
2 250
